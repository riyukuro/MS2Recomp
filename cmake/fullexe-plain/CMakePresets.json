{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-noexe",
      "displayName": "No exe (Windows, MSVC v141 14.16, Ninja)",
      "description": "Compile every obj from data/fullexe/plain and link, without the original exe. Resources: the stand-in (standin/standin.rc), or set MS2_RESOURCES_RES to a .res taken from the exe.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/fullexe-plain",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "v141,host=x64", "strategy": "external" },
      "cacheVariables": {
        "MS2_PLAIN_COMPILE": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "windows-noexe", "configurePreset": "windows-noexe" }
  ]
}
