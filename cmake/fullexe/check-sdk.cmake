# Configure-time BYO-SDK check: every manifest row's file must exist under its root variable and hash to the pinned value.
# Input: MANIFEST, plus one variable per root (MS2_GAMEBRYO_ROOT, MS2_DXSDK_ROOT, MS2_PHYSX_ROOT, MS2_CEF_ROOT,
# MS2_PATHENGINE_ROOT). Names and hashes only; nothing of any SDK is read beyond the hashed files.
file(STRINGS "${MANIFEST}" _rows)
set(_bad "")
foreach(_row IN LISTS _rows)
  if(_row MATCHES "^#" OR _row STREQUAL "")
    continue()
  endif()
  string(REPLACE "\t" ";" _c "${_row}")
  list(GET _c 0 _sdk)
  list(GET _c 1 _var)
  list(GET _c 2 _rel)
  list(GET _c 3 _sha)
  list(GET _c 4 _opt)
  if("${${_var}}" STREQUAL "")
    if(_opt)
      continue()
    endif()
    list(APPEND _bad "${_var} is not set (needed for ${_sdk})")
    continue()
  endif()
  set(_f "${${_var}}/${_rel}")
  if(NOT EXISTS "${_f}")
    list(APPEND _bad "${_sdk}: ${_rel} missing under ${_var}")
    continue()
  endif()
  file(SHA256 "${_f}" _got)
  if(NOT _got STREQUAL _sha)
    list(APPEND _bad "${_sdk}: ${_rel} differs from the pinned hash")
  endif()
endforeach()
if(_bad)
  list(JOIN _bad "\n  " _msg)
  message(FATAL_ERROR "SDK check failed (see BUILDING.md):\n  ${_msg}")
endif()
message(STATUS "SDK check: ${MANIFEST} OK")
