33a
    // MS2: Nexon added wchar_t overloads of the three file functions. In the
    // game each wide overload directly follows its narrow one (slots 3/4,
    // 5/6, 7/8). MSVC groups overloads at the first declaration in reverse
    // order, so the wide overload must be declared first.
    virtual bool CanReadImageFile(const wchar_t* pwcFilename) const;
.
