//--------------------------------------------------------------------------------------------------
// MS2: Nexon's wchar_t overloads (game 0x141d6ed20/0x141d6f590/0x141d6f800).
// They split the path with NiFilenameW, narrow only the extension for the
// reader, and open the wide path with the wide efd::File::GetFile.
bool NiImageConverter::CanReadImageFile(const wchar_t* pwcFilename) const
{
    NiFilenameW kFileName(pwcFilename);
    efd::string kExt;
    try
    {
        kExt = ATL::CW2A(kFileName.GetExt());
    }
    catch (...)
    {
        return false;
    }
    if (kExt.empty())
        return false;

    if (m_kReader.CanReadFile(kExt.c_str()))
    {
        efd::File* kIst = efd::File::GetFile(pwcFilename, efd::File::READ_ONLY);
        if ((!kIst) || (!(*kIst)))
        {
            NiDelete kIst;
            return false;
        }

        NiDelete kIst;
        return true;
    }

    return false;
}

//--------------------------------------------------------------------------------------------------
bool NiImageConverter::ReadImageFileInfo(const wchar_t* pwcFilename,
    NiPixelFormat& kFmt, bool& bMipmap, unsigned int& uiWidth,
    unsigned int& uiHeight, unsigned int& uiNumFaces)
{
    NiFilenameW kFileName(pwcFilename);
    efd::string kExt;
    try
    {
        kExt = ATL::CW2A(kFileName.GetExt());
    }
    catch (...)
    {
        return false;
    }
    if (kExt.empty())
        return false;

    if (m_kReader.CanReadFile(kExt.c_str()))
    {
        efd::File* kIst = efd::File::GetFile(pwcFilename, efd::File::READ_ONLY);
        if ((!kIst) || (!(*kIst)))
        {
            NiDelete kIst;
            return false;
        }

        if (m_kReader.ReadHeader(*kIst, uiWidth, uiHeight, kFmt, bMipmap,
            uiNumFaces))
        {
            NiDelete kIst;
            return true;
        }

        NiDelete kIst;
    }

    return false;
}

