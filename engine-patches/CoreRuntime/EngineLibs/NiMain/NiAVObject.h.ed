    // MS2: v2525 (studio, names inferred): flag 0x400 marks NiPSParticleSystem objects
    inline void SetParticleSystemFlag(bool bSet) { SetBit(bSet, IS_PARTICLE_SYSTEM); }
    inline bool GetParticleSystemFlag() const { return GetBit(IS_PARTICLE_SYSTEM); }
    // MS2: non-virtual helper for the above (not in the game binary).
    bool MS2HasAnyFlag(unsigned short usMask) const
    {
        return (m_uFlags & usMask) != 0;
    }
    // MS2: accessors for the 4-byte Nexon member at +0xE0 (game 0x140d96630 / 0x1414d4c70). Bit 0x100 marks objects
    // the shadow visitors skip (set by 0x14150baf0).
    inline unsigned int GetMS2Flags() const { return m_uiMS2Unknown; }
    inline void SetMS2Flags(unsigned int uiFlags) { m_uiMS2Unknown = uiFlags; }
