{  // MS2: v2525
    NiMaterialFragmentNode* pkFrag = NiNew NiMaterialFragmentNode();  // MS2: v2525

    pkFrag->SetType("Vertex/Pixel");
    pkFrag->SetName("CalculateHeightFog");
    pkFrag->SetDescription("\n"
        "     HeightFog\n"
        "    ");
    // Insert an input resource
    {
        NiMaterialResource* pkRes = NiNew NiMaterialResource();

        pkRes->SetType("float4");
        pkRes->SetSemantic("Position");
        pkRes->SetLabel("World");
        pkRes->SetVariable("WorldPosition");

        pkFrag->AddInputResource(pkRes);
    }

    // Insert an input resource
    {
        NiMaterialResource* pkRes = NiNew NiMaterialResource();

        pkRes->SetType("float");
        pkRes->SetSemantic("UpperZ");
        pkRes->SetVariable("UpperZ");
        pkRes->SetDefaultValue("(0.0)");

        pkFrag->AddInputResource(pkRes);
    }

    // Insert an input resource
    {
        NiMaterialResource* pkRes = NiNew NiMaterialResource();

        pkRes->SetType("float");
        pkRes->SetSemantic("LowerZ");
        pkRes->SetVariable("LowerZ");
        pkRes->SetDefaultValue("(-500.0)");

        pkFrag->AddInputResource(pkRes);
    }

    // Insert an input resource
    {
        NiMaterialResource* pkRes = NiNew NiMaterialResource();

        pkRes->SetType("float");
        pkRes->SetSemantic("Weight");
        pkRes->SetVariable("Weight");
        pkRes->SetDefaultValue("(1.0)");

        pkFrag->AddInputResource(pkRes);
    }

    // Insert an output resource
    {
        NiMaterialResource* pkRes = NiNew NiMaterialResource();

        pkRes->SetType("float");
        pkRes->SetSemantic("Color");
        pkRes->SetLabel("HeightFogOut");
        pkRes->SetVariable("HeightFogOut");

        pkFrag->AddOutputResource(pkRes);
    }

    // Insert a code block
    {
        NiCodeBlock* pkBlock = NiNew NiCodeBlock();

        pkBlock->SetLanguage("hlsl/Cg");
        pkBlock->SetPlatform("D3D11/D3D10/DX9/Xenon/PS3");
        pkBlock->SetTarget("vs_1_1/ps_2_0/vs_4_0/ps_4_0/vs_5_0/ps_5_0");

        pkBlock->SetText("        \n"
             "        float z = WorldPosition.z;\n"
             "        if (z > UpperZ)\n"
             "            HeightFogOut = 1;\n"
             "        else if (z > LowerZ)\n"
             "            HeightFogOut = Weight * (z - LowerZ) / (UpperZ - LowerZ) + 1 - Weight;\n"
             "        else\n"
             "            HeightFogOut = 1.0f - Weight;\n"
             "    ");


        pkFrag->AddCodeBlock(pkBlock);
    }

    pkLib->AddNode(pkFrag);
}
