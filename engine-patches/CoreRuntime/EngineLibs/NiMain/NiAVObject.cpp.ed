// MS2: Nexon addition (game 0x141d14ed0).
NiAVObject* NiAVObject::GetObjectByNameExcluding(const NiFixedString& kName,
    unsigned int usExcludeFlags)
{
    if (MS2HasAnyFlag(usExcludeFlags))
        return 0;

    if (!kName.Exists())
        return 0;

    if (GetName() == kName)
        return this;

    return 0;
}

