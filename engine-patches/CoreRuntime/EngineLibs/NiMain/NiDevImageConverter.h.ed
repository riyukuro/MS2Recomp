    ~NiDevImageConverter(); static void MS2DisableNIFImageReader(); static bool ms_bMS2NIFImageReader; // MS2: game-called switch (0x141d38fa0) that drops the ctor's NiNIFImageReader

    // MS2: the game also overrides the wchar_t overloads added to
    // NiImageConverter, natively wide (game 0x141d34fd0, 0x141d3b840,
    // 0x141d3bd70): wide path and NiFilenameW, the extension narrowed with
    // CW2A for NiImageReader::CanReadFile.
    virtual bool CanReadImageFile(const wchar_t* pwcFilename) const;

    virtual bool ReadImageFileInfo(const wchar_t* pwcFilename,
        NiPixelFormat &kFmt, bool &bMipmap, unsigned int &uiWidth,
        unsigned int &uiHeight, unsigned int& uiFaces);

    virtual NiPixelData* ReadImageFile(const wchar_t* pwcFilename,
        NiPixelData* pkOptDest);
