// MS2: most libs see the bool-returning loaders; NiKFMTool (NiAnimation) was built against the
// SDK's void form and defines MS2_NISTREAMLOADBINARY_VOID before its includes.
#if defined(MS2_NISTREAMLOADBINARY_VOID)
#define MS2_NISLB_RESULT void
#define MS2_NISLB_RETURN
#else
