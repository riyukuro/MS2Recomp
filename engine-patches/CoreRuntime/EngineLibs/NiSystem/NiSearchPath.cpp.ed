NiSearchPath* NiSearchPath::DefaultCreate()
{
    return NiNew NiSearchPath;
}

//--------------------------------------------------------------------------------------------------
NiSearchPath* NiSearchPath::Create()
{
    return ms_pfnCreateFunc();
}

//--------------------------------------------------------------------------------------------------
void NiSearchPath::SetCreateFunc(CreateFunction pfnCreate)
{
    if (pfnCreate)
        ms_pfnCreateFunc = pfnCreate;
    else
        ms_pfnCreateFunc = DefaultCreate;
}

