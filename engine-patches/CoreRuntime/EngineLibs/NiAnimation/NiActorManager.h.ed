    // MS2: Nexon gave NiActorManager run-time type info and made Clone, Update and
    // CloneOnlyAnimation(NiAVObject*, bool) virtual. Exe primary vftable 0x143001978 (no RTTI
    // COL): 0 scalar deleting dtor 0x141c3e460, 1 NiRefObject::DeleteThis 0x141d16bf0,
    // 2 GetRTTI 0x141c42470 (-> ms_RTTI 0x143af8988, root RTTI "NiActorManager", initialised in
    // the engine .text$di at 0x140120a40), 3 Clone 0x141c3f950, 4 Update 0x141c45340,
    // 5 CloneOnlyAnimation 0x141c3ff70. MS2ActorManager (src/ms2/client/ms2/ms2actormanager.h)
    // overrides 0, 2, 3 and 5. sizeof 0x138 -> 0x158 (m_kMS2PendingSeqDataMap below).
    NiDeclareRTTI;

