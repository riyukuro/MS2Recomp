// MS2: fullscreen display mode switching (exe 0x1427cb2a0, 0x1427d5390) and the game's device-lost hold
// (exe 0x1427d5c10)
bool NiDX9Renderer::SetDisplayMode(unsigned int uiWidth, unsigned int uiHeight)
{
    unsigned int uiOldWidth = m_kMS2DisplayMode.dmPelsWidth;
    if (uiOldWidth == uiWidth && m_kMS2DisplayMode.dmPelsHeight == uiHeight)
        return true;

    unsigned int uiOldHeight = m_kMS2DisplayMode.dmPelsHeight;
    m_kMS2DisplayMode.dmPelsWidth = uiWidth;
    m_kMS2DisplayMode.dmPelsHeight = uiHeight;
    m_bMS2DisplayModeChanged = true;
    m_kMS2DisplayMode.dmBitsPerPel = 32;
    m_kMS2DisplayMode.dmFields = DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT;
    if (ChangeDisplaySettingsA(&m_kMS2DisplayMode, CDS_UPDATEREGISTRY) != DISP_CHANGE_SUCCESSFUL)
    {
        m_kMS2DisplayMode.dmPelsWidth = uiOldWidth;
        m_kMS2DisplayMode.dmPelsHeight = uiOldHeight;
        return false;
    }
    return true;
}

//------------------------------------------------------------------------------------------------
__declspec(noinline) void NiDX9Renderer::RestoreDisplayMode()   // MS2: called, not inlined, in the exe
{
    if (m_bMS2DisplayModeChanged)
    {
        if (m_kMS2DisplayMode.dmPelsWidth != m_kMS2OriginalMode.dmPelsWidth ||
            m_kMS2DisplayMode.dmPelsHeight != m_kMS2OriginalMode.dmPelsHeight)
        {
            SetDisplayMode(m_kMS2OriginalMode.dmPelsWidth, m_kMS2OriginalMode.dmPelsHeight);
        }
        m_bMS2DisplayModeChanged = false;
    }
}

//------------------------------------------------------------------------------------------------
void NiDX9Renderer::SetDeviceLostHeld(bool bHeld)
{
    m_bMS2DeviceLostHeld = bHeld;
    m_bDeviceLost = bHeld;
}

