        // MS2: collect the actor's convex/triangle meshes, detach the shape descs, release the actor and
        // then release every mesh nothing references any more.
        efd::list<NxConvexMesh*> kConvexMeshes;
        efd::list<NxTriangleMesh*> kTriangleMeshes;
        NxPhysicsSDK* pkSDK = efdPhysX::PhysXSDKManager::GetManager()->m_pPhysXSDK;
        NxConvexMesh* pkConvexMesh = 0;
        NxTriangleMesh* pkTriangleMesh = 0;
        NxU32 uiNumShapes = m_pkActor->getNbShapes();
        if (uiNumShapes > 0)
        {
            for (NxU32 ui = 0; ui < uiNumShapes; ui++)
            {
                NxShape* pkShape = m_pkActor->getShapes()[ui];
                if (pkShape->isConvexMesh())
                    pkConvexMesh = &pkShape->isConvexMesh()->getConvexMesh();
                else if (pkShape->isTriangleMesh())
                    pkTriangleMesh = &pkShape->isTriangleMesh()->getTriangleMesh();

                if (pkConvexMesh)
                {
                    kConvexMeshes.push_back(pkConvexMesh);
                    pkConvexMesh = 0;
                }
                if (pkTriangleMesh)
                {
                    kTriangleMeshes.push_back(pkTriangleMesh);
                    pkTriangleMesh = 0;
                }
            }
        }

