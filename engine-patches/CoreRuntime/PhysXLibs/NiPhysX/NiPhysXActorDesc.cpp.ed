                NxConvexMesh* pkMesh = pkConvexDesc->meshData;
                if (!pkMesh)
                    continue;

                NxU32 uiNumVertices = pkMesh->getCount(0, NX_ARRAY_VERTICES);
                NxU32 uiNumTriangles = pkMesh->getCount(0, NX_ARRAY_TRIANGLES);
                NxU32 uiPointStride = pkMesh->getStride(0, NX_ARRAY_VERTICES);
                NxU32 uiTriangleStride = pkMesh->getStride(0, NX_ARRAY_TRIANGLES);
                const void* pvPoints = pkMesh->getBase(0, NX_ARRAY_VERTICES);
                const void* pvTriangles = pkMesh->getBase(0, NX_ARRAY_TRIANGLES);

                NxConvexMeshDesc kMeshDesc;
                kMeshDesc.numVertices = uiNumVertices;
                kMeshDesc.numTriangles = uiNumTriangles;
                kMeshDesc.pointStrideBytes = uiPointStride;
