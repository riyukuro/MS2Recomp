            if (eType == NX_SHAPE_PLANE)
            {
                ((NxPlaneShapeDesc*)pkShapeDesc)->d *= fScale;
            }
            else if (eType == NX_SHAPE_SPHERE)
            {
                ((NxSphereShapeDesc*)pkShapeDesc)->radius *= fScale;
            }
            else if (eType == NX_SHAPE_CAPSULE)
            {
