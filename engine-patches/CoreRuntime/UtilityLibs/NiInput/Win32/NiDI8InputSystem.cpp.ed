    // MS2: Nexon also accepts the joystick the control panel marks as preferred
    if (memcmp((const void*)&GUID_Joystick,
        (const void*)&(pkDDI->guidInstance), sizeof(GUID)) == 0)
    {
        NILOG(NIMESSAGE_GENERAL_1, "Joystick FOUND.");
    }
    if (!bMS2SystemDevice)
    {
        DIJOYCONFIG kJoyConfig = {0};
        LPDIRECTINPUTJOYCONFIG8 pkJoyConfig = NULL;
        if (SUCCEEDED(pkDI8->QueryInterface(IID_IDirectInputJoyConfig8,
            (void**)&pkJoyConfig)))
        {
            kJoyConfig.dwSize = sizeof(kJoyConfig);
            pkJoyConfig->GetConfig(0, &kJoyConfig, DIJC_GUIDINSTANCE);
            if (memcmp((const void*)&kJoyConfig.guidInstance,
                (const void*)&(pkDDI->guidInstance), sizeof(GUID)) == 0)
            {
                NILOG(NIMESSAGE_GENERAL_1, "JOYSTICK FOUND.");
                MS2_INPUT_LOG("SYSTEM Joystick FOUND.");
                bValidDevice = true;
            }
            if (pkJoyConfig)
                pkJoyConfig->Release();
        }
