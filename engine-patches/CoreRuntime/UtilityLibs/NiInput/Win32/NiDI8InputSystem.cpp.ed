// MS2: Nexon forwards the input errors to the client's error-log hook (see efd/ServiceManager.cpp)
extern void (*DAT_143b03490)(short, unsigned char, const char*);
#define MS2_INPUT_LOG(...) \
    do { if (DAT_143b03490) DAT_143b03490(efd::kApp, efd::ILogger::kERR0, efd::LogHelper(__VA_ARGS__)); } while (0)
