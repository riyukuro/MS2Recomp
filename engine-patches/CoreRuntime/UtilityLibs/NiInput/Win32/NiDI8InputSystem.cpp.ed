// MS2: finds the device behind a gamepad's force-feedback driver
struct MS2FFDriverEnum
{
    NiInputDI8GamePad* pkGamePad;
    LPDIRECTINPUT8 pkDI8;
    GUID kGUIDFFDriver;
    LPDIRECTINPUTDEVICE8 pkDevice;
};

BOOL CALLBACK NiDI8InputSystem::DIEnumFFDriverCallback(
    LPCDIDEVICEINSTANCE pkDDI, LPVOID pvRef)
{
    if (IsXInputDevice(&pkDDI->guidProduct))
        return DIENUM_STOP;

    MS2FFDriverEnum* pkEnum = (MS2FFDriverEnum*)pvRef;
    if (!pkEnum->pkGamePad || !pkEnum->pkDI8)
        return DIENUM_STOP;
    if (pkDDI->guidFFDriver != pkEnum->kGUIDFFDriver)
        return DIENUM_STOP;

    LPDIRECTINPUTDEVICE8 pkDevice = NULL;
    if (FAILED(pkEnum->pkDI8->CreateDevice(pkDDI->guidInstance, &pkDevice,
        NULL)))
    {
        return DIENUM_STOP;
    }
    pkEnum->pkDevice = pkDevice;
    return DIENUM_CONTINUE;
}

