// MS2: the exe calls the copy ctor / copy assignment out of line (the game's /Od copies 0x140de8c90 / 0x1411d6ee0;
// MS2's operator= also strips a trailing ':' from m_urn) from the engine TUs that define EE_MS2_ASSETID_COPY_CALL
#if defined(EE_MS2_ASSETID_COPY_CALL)
#define EE_MS2_ASSETID_COPY_INLINE inline __declspec(noinline)
