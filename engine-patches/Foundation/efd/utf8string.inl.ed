// MS2: std::string::operator=(const char*) 0x140ae18c0 (game /Od copy): the exe calls it out of line from
// NiImageConverter's wchar_t overloads (kExt = ATL::CW2A(...)); that TU defines the switch
#if defined(EE_MS2_STR_ASSIGN_CSTR_CALL)
namespace std
{
template<> inline __declspec(noinline) efd::string& efd::string::operator=(const char* const _Ptr)
{
    return assign(_Ptr);
}
}
#endif

// MS2: std::string::append(const char*) 0x14114d9b0 (game /Od copy): the exe calls it out of line from
// utf8string::append(const char*) in NiTerrainSurfacePackageFileVersion1 (kBinaryFilename += ".tmpkgb"); that TU
// defines the switch
#if defined(EE_MS2_STR_APPEND_CSTR_CALL)
namespace std
{
template<> inline __declspec(noinline) efd::string& efd::string::append(const char* const _Ptr)
{
    return append(_Ptr, traits_type::length(_Ptr));
}
}
#endif

// MS2: utf8string(const utf8string&): ConfigManager::FindValue 0x1420b4b20 (return m_root.FindValue(strName)) inlines
// the copy down through the basic_string copy ctor and _Construct_lv_contents, where cl 19.16 calls each level out of
// line; that TU defines the switch
#if defined(EE_MS2_UTF8_COPY_FORCE)
namespace std
{
template<> __forceinline void efd::string::_Construct_lv_contents(const basic_string& _Right)
{
    auto& _My_data = this->_Get_data();
    auto& _Right_data = _Right._Get_data();
    const size_type _Right_size = _Right_data._Mysize;
    const char* const _Right_ptr = _Right_data._Myptr();
    if (_Right_size < this->_BUF_SIZE)
    {
        traits_type::copy(_My_data._Bx._Buf, _Right_ptr, this->_BUF_SIZE);
        _My_data._Mysize = _Right_size;
        _My_data._Myres = this->_BUF_SIZE - 1;
        return;
    }

    auto& _Al = this->_Getal();
    const size_type _New_capacity = _Min_value(_Right_size | this->_ALLOC_MASK, max_size());
    const pointer _New_array = _Al.allocate(_New_capacity + 1);
    _Alty_traits::construct(_Al, _STD addressof(_My_data._Bx._Ptr), _New_array);
    traits_type::copy(_Unfancy(_New_array), _Right_ptr, _Right_size + 1);
    _My_data._Mysize = _Right_size;
    _My_data._Myres = _New_capacity;
}

template<> __forceinline basic_string<char, char_traits<char>, efd::CustomAllocator<char> >::basic_string(const basic_string& _Right)
    : _Mybase(_Alty_traits::select_on_container_copy_construction(_Right._Getal()))
{
    _Construct_lv_contents(_Right);
}
}
#define EE_MS2_UTF8_COPY_INLINE __forceinline
#else
#define EE_MS2_UTF8_COPY_INLINE inline
#endif

// MS2: std::string::assign(const char*, size_t): XMLUtils::GetAttribute 0x142116a00 (o_result = attrib->Value())
// inlines it with its _Reallocate_for growth path, where cl 19.16 calls it out of line; that TU defines the switch
// MS2: EE_MS2_STR_COPY_ASSIGN_FORCE = TUs whose exe setters inline utf8string = utf8string down to assign(ptr, n)
#if (defined(EE_MS2_STR_COPY_ASSIGN_FORCE) || defined(EE_MS2_UTF8_CHAR_CTOR_FORCE)) && !defined(EE_MS2_STR_ASSIGN_PTR_FORCE)
#define EE_MS2_STR_ASSIGN_PTR_FORCE
#endif
#if defined(EE_MS2_STR_ASSIGN_PTR_FORCE)
namespace std
{
template<> __forceinline efd::string& efd::string::assign(const char* const _Ptr, const size_type _Count)
{
    auto& _My_data = this->_Get_data();
    if (_Count <= _My_data._Myres)
    {
        char* const _Old_ptr = _My_data._Myptr();
        _My_data._Mysize = _Count;
        traits_type::move(_Old_ptr, _Ptr, _Count);
        traits_type::assign(_Old_ptr[_Count], char());
        return (*this);
    }

    // _Reallocate_for(_Count, <copy lambda>, _Ptr), written out: the exe inlines it too
    if (_Count > max_size())
    {
        _Xlen();
    }

    const size_type _Old_capacity = _My_data._Myres;
    const size_type _New_capacity = _Calculate_growth(_Count);
    auto& _Al = this->_Getal();
    const pointer _New_ptr = _Al.allocate(_New_capacity + 1);
    _My_data._Orphan_all();
    _My_data._Mysize = _Count;
    _My_data._Myres = _New_capacity;
    traits_type::copy(_Unfancy(_New_ptr), _Ptr, _Count);
    traits_type::assign(_Unfancy(_New_ptr)[_Count], char());
    if (this->_BUF_SIZE <= _Old_capacity)
    {
        _Al.deallocate(_My_data._Bx._Ptr, _Old_capacity + 1);
        _My_data._Bx._Ptr = _New_ptr;
    }
    else
    {
        _Alty_traits::construct(_Al, _STD addressof(_My_data._Bx._Ptr), _New_ptr);
    }

    return (*this);
}

template<> __forceinline efd::string& efd::string::assign(const char* const _Ptr)
{
    return (assign(_Ptr, _Convert_size<size_type>(traits_type::length(_Ptr))));
}

template<> __forceinline efd::string& efd::string::operator=(const char* const _Ptr)
{
    return (assign(_Ptr));
}
#if defined(EE_MS2_STR_COPY_ASSIGN_FORCE)
template<> __forceinline efd::string& efd::string::operator=(const efd::string& _Right)
{
    if (this != _STD addressof(_Right))
    {
        this->_Copy_alloc(_Right._Getal());
        auto& _Right_data = _Right._Get_data();
        assign(_Right_data._Myptr(), _Right_data._Mysize);
    }
    return (*this);
}
#endif
// MS2: EE_MS2_UTF8_CHAR_CTOR_FORCE = TUs whose exe inlines utf8string(const char*) down to assign(ptr, n)
#if defined(EE_MS2_UTF8_CHAR_CTOR_FORCE)
template<> __forceinline basic_string<char, char_traits<char>, efd::string::allocator_type>::basic_string(const char* const _Ptr)
    : _Mybase()
{
    _Tidy_init();
    assign(_Ptr);
}
#endif
}
