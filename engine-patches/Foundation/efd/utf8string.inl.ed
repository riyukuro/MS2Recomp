// MS2: std::string::append(const string&) 0x1409a2d10 (game /Od copy): the exe calls it out of line from
// utf8string::append(const utf8string&) in some engine TUs (EntityLua DumpProperty); those define the switch
#if defined(EE_MS2_UTF8_APPEND_STR_CALL)
namespace std
{
typedef efd::utf8string::internal_string ms2_utf8_internal_string;
template<> inline __declspec(noinline) ms2_utf8_internal_string& ms2_utf8_internal_string::append(
    const ms2_utf8_internal_string& _Right)
{
    return append(_Right.c_str(), _Right.size());
}
}
