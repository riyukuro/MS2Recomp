    // MS2: release the services one by one and print the private bytes each one frees
    SIZE_T uiMS2Before = 0;
    SIZE_T uiMS2After = 0;
    for (SystemServiceMap::iterator iter = m_SysSerMap.begin(); iter != m_SysSerMap.end(); ++iter)
    {
        PROCESS_MEMORY_COUNTERS_EX kPmc;
        memset(&kPmc, 0, sizeof(kPmc));
        kPmc.cb = sizeof(kPmc);
        if (GetProcessMemoryInfo(GetCurrentProcess(), (PROCESS_MEMORY_COUNTERS*)&kPmc, sizeof(kPmc)))
            uiMS2Before = kPmc.PrivateUsage;
        efd::string kName = iter->second->m_spSysSer->GetDisplayName();
        iter->second = NULL;
        kPmc.cb = sizeof(kPmc);
        if (GetProcessMemoryInfo(GetCurrentProcess(), (PROCESS_MEMORY_COUNTERS*)&kPmc, sizeof(kPmc)))
        {
            uiMS2After = kPmc.PrivateUsage;
            if (uiMS2After > uiMS2Before)
                uiMS2After = uiMS2Before;
        }
        efd::string kKB = BytesToCommaString((uiMS2Before - uiMS2After) >> 10);
        char acText[256];
        sprintf_s(acText, sizeof(acText), "~ServiceManager [%s KB][%s]\n", kKB.c_str(), kName.c_str());
        OutputDebugStringA(acText);
