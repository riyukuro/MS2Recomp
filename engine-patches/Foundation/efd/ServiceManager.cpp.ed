#include <psapi.h>   // MS2: GetProcessMemoryInfo for the shutdown memory prints

// MS2: the client's error-log hook (game: scenestategame.cpp); Nexon forwards the critical service failures to it
extern void (*DAT_143b03490)(short, unsigned char, const char*);

namespace efd
{
// MS2: post WM_QUIT once when the ServiceManager main loop completes
static bool s_bMS2PostQuitOnComplete = true;

//------------------------------------------------------------------------------------------------
// MS2: "1234567" -> "1,234,567" for the OnShutdown / ~ServiceManager memory prints
static efd::string BytesToCommaString(efd::UInt64 uiValue)
{
    char acBuffer[64];
    sprintf_s(acBuffer, "%I64u", uiValue);
    efd::string kResult;
    efd::string kDigits(acBuffer);
    size_t uiGroup = 0;
    for (size_t ui = kDigits.length(); ui > 0; )
    {
        kResult = kDigits[ui - 1] + kResult;
        ++uiGroup;
        if (--ui > 0 && uiGroup == 3)
        {
            kResult = "," + kResult;
            uiGroup = 0;
        }
    }
    return kResult;
}
} // namespace efd









