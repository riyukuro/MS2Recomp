    void* pvMem = EE_EXTERNAL_ALIGNED_REALLOC(pvMemory, stSizeInBytes, stAlignment);
    if (pvMem == NULL)  // MS2: the exe throws on failure (0x141807ad0)
        throw std::bad_alloc();
    return pvMem;
