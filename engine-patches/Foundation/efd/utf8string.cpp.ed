812,824c
    // MS2: formats into an alloca buffer (malloc when alloca yields null, 0 when neither) instead of a temp internal_string
    bool heapBuf = false;
    size_t bytesBuf = efd::Vscprintf(format_sz, args) + 1;
    char* pBuf = (char*)alloca(bytesBuf);
    if (!pBuf)
    {
        pBuf = (char*)malloc(bytesBuf);
        if (!pBuf) return 0;
        heapBuf = true;
    }
    int bytesUsed = ::vsprintf(pBuf, format_sz, args);
    pBuf[bytesUsed] = 0;
    m_string += pBuf; if (heapBuf) free(pBuf);
.
