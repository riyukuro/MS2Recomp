#if defined(EE_MS2_ISYSTEMSERVICE_SCI_FORCEINLINE)
#define SetupClassInfo __forceinline SetupClassInfo
    EE_BEGIN_DECLARE_INTERFACE(ISystemService, efd::kCLASSID_ISystemService);
#undef SetupClassInfo
        EE_INCLUDE_INTERFACE(efd::IBase);
    EE_END_DECLARE_INTERFACE();
#else
