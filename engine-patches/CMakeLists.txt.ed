# Generated by tools/vcproj2cmake.py -- Gamebryo LightSpeed 3.2.0.661, Windows x64 static libraries.
# Configure (from repo root):
#   PATH="$PWD/.venv/bin:$PATH" cmake -S engine/gamebryo -B build/gamebryo -G Ninja -DCMAKE_BUILD_TYPE=Release \
#        -DCMAKE_TOOLCHAIN_FILE=$PWD/cmake/toolchain-clangcl-x64.cmake
cmake_minimum_required(VERSION 3.20)
project(Gamebryo32 C CXX)

if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "This tree is configured for the x64 port only")
endif()

set(GB_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
get_filename_component(MS2_ROOT "${GB_ROOT}/../.." ABSOLUTE)
# MS2: the exe was compiled against PhysX 2.8.4 (NxGetCookingLib(0x2080400)); -DGB_PHYSX_VERSION=283 falls back to 2.8.3.
set(GB_PHYSX_VERSION "284" CACHE STRING "PhysX SDK version: 284 (default, matches the exe) or 283")
if(GB_PHYSX_VERSION STREQUAL "283")
    set(_gb_physx_default "${MS2_ROOT}/third_party/physx283/PFiles/NVIDIA Corporation/NVIDIA PhysX SDK/v2.8.3")
else()
    set(_gb_physx_default "${MS2_ROOT}/third_party/physx284/PFiles/NVIDIA Corporation/NVIDIA PhysX SDK/v2.8.4_win")
endif()
set(GB_PHYSX_DIR "${_gb_physx_default}" CACHE PATH "PhysX SDK root (PHYSXINSTALLPATH); NOTE: cached, change it together with GB_PHYSX_VERSION")
set(GB_DXSDK_DIR "${MS2_ROOT}/third_party/dxsdk/DXSDK" CACHE PATH "DirectX SDK (June 2010) root")
set(GB_SWIG "${MS2_ROOT}/tools/swig-wine.sh" CACHE STRING "SWIG 1.3.34 command (shipped swig.exe under wine)")
option(GB_RTTI "Compile with /GR (the game's engine has MSVC RTTI; shipped projects use /GR-)" ON)

if(NOT EXISTS "${GB_DXSDK_DIR}/Include/d3dx9.h")
    message(FATAL_ERROR "DirectX SDK headers not found in ${GB_DXSDK_DIR}/Include")
endif()

# --- global x64 settings (deviations from the VC90 property sheets are documented in NOTES.md) ---------
add_compile_definitions(EE_USE_NATIVE_STL)        # STLPort replaced by the MSVC 14.16 STL
add_compile_definitions(MS2_ENTITY_PROPERTY_CACHE) # MS2: egf::Entity's property cache (egf/Entity.h; the game code keeps its own view)
add_compile_options(/Z7)                          # CodeView in objects -> PDB at link time
# Optimisation comes from each project's configuration (gb_set_optimization), not CMake's defaults.
foreach(lang C CXX)
    foreach(cfg RELEASE RELWITHDEBINFO MINSIZEREL DEBUG)
        string(REGEX REPLACE "(^| )[/-](O[12dx]|Ob[0-3]|Zi|RTC1)( |$)" " " CMAKE_${lang}_FLAGS_${cfg} "${CMAKE_${lang}_FLAGS_${cfg}}")
        string(REGEX REPLACE "(^| )[/-](O[12dx]|Ob[0-3]|Zi|RTC1)( |$)" " " CMAKE_${lang}_FLAGS_${cfg} "${CMAKE_${lang}_FLAGS_${cfg}}")
    endforeach()
endforeach()
set(GB_OPT_ALL "" CACHE STRING
    "If set, optimisation flags for every Gamebryo library (overrides the per-library GB_OPT_<lib>)")
if(GB_RTTI)
    add_compile_options(/GR)
else()
    add_compile_options(/GR-)
endif()
# DirectX SDK (June 2010). Its d3d9/d3d10/d3d11/dxgi/d3dcompiler headers also exist (newer) in the Windows SDK,
# which must win; MSVC searches /I dirs before INCLUDE, so the SDK dir cannot simply be added. Instead an
# overlay of symlinks to only the DXSDK headers that the Windows SDK lacks (d3dx*, dxerr, xaudio2, ...) is
# made in the binary dir, under both the original and the lower-case name (sources use either). Works for
# clang-cl and cl.exe-under-wine alike; the extracted SDK itself stays untouched.
set(GB_WINSDK_INCLUDE "${MS2_ROOT}/third_party/msvc/Windows Kits/10/Include/10.0.19041.0" CACHE PATH
    "Windows SDK include root used to decide which DXSDK headers are shadowed")
set(GB_DXSDK_OVERLAY "${CMAKE_BINARY_DIR}/dxsdk-overlay-include")
file(MAKE_DIRECTORY "${GB_DXSDK_OVERLAY}")
file(GLOB _winsdk_h "${GB_WINSDK_INCLUDE}/um/*" "${GB_WINSDK_INCLUDE}/shared/*")
set(_winsdk_lc)
foreach(h ${_winsdk_h})
    get_filename_component(n "${h}" NAME)
    string(TOLOWER "${n}" n)
    list(APPEND _winsdk_lc "${n}")
endforeach()
file(GLOB _dxh RELATIVE "${GB_DXSDK_DIR}/Include" "${GB_DXSDK_DIR}/Include/*")
set(GB_DXSDK_SHADOWED)
foreach(h ${_dxh})
    string(TOLOWER "${h}" hl)
    if(hl IN_LIST _winsdk_lc)
        list(APPEND GB_DXSDK_SHADOWED "${h}")
        continue()
    endif()
    foreach(n "${h}" "${hl}")
        if(NOT EXISTS "${GB_DXSDK_OVERLAY}/${n}")
            file(CREATE_LINK "${GB_DXSDK_DIR}/Include/${h}" "${GB_DXSDK_OVERLAY}/${n}" SYMBOLIC)
        endif()
    endforeach()
endforeach()
message(STATUS "DXSDK headers taken from the Windows SDK instead: ${GB_DXSDK_SHADOWED}")
include_directories(AFTER SYSTEM "${GB_DXSDK_OVERLAY}")
# Exceptions where the DXSDK version must win: xinput.h (the game loads xinput1_3.dll and uses
# XInputGetKeystroke/BatteryInformation, which the Windows SDK header hides below _WIN32_WINNT_WIN8).
set(GB_DXSDK_PREFERRED_DIR "${CMAKE_BINARY_DIR}/dxsdk-preferred-include")
file(MAKE_DIRECTORY "${GB_DXSDK_PREFERRED_DIR}")
foreach(h XInput.h)
    string(TOLOWER "${h}" hl)
    foreach(n "${h}" "${hl}")
        if(NOT EXISTS "${GB_DXSDK_PREFERRED_DIR}/${n}")
            file(CREATE_LINK "${GB_DXSDK_DIR}/Include/${h}" "${GB_DXSDK_PREFERRED_DIR}/${n}" SYMBOLIC)
        endif()
    endforeach()
endforeach()
include_directories(BEFORE "${GB_DXSDK_PREFERRED_DIR}")

if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    # clang noise on 2010-era MSVC code that is irrelevant for the port.
    add_compile_options(-Wno-microsoft -Wno-unused-private-field -Wno-unused-value
        -Wno-inconsistent-missing-override -Wno-missing-braces -Wno-unused-local-typedef
        -Wno-deprecated-declarations -Wno-overloaded-virtual -Wno-delete-non-abstract-non-virtual-dtor
        -Wno-switch -Wno-parentheses -Wno-logical-op-parentheses -Wno-tautological-compare
        -Wno-unused-function -Wno-unused-variable -Wno-unknown-pragmas -Wno-dangling-else -Wno-reorder-ctor
        -Wno-pragma-pack -Wno-ignored-attributes)
    # MSVC accepts narrowing in case labels / braced initialisers (HRESULT constants in switches on
    # unsigned values etc.); clang makes it an error. Same semantics as cl.exe.
    add_compile_options(-Wno-c++11-narrowing)
    # xnamath.h (June 2010) treats __m128 as MSVC's union (m128_f32 members, operator overloads);
    # clang's __m128 is a builtin vector type. Use xnamath's portable no-intrinsics path instead
    # (only ecrD3D11Renderer uses xnamath; no XMVECTOR appears in Win32 class layouts).
    add_compile_definitions(_XM_NO_INTRINSICS_)
endif()

