# Forwarding header for a precompiled-header include that is not on the include path (see pch_header()).
function(gb_pch_forwarder tgt header)
    get_filename_component(name "${header}" NAME)
    set(dir "${CMAKE_BINARY_DIR}/pch-forward/${tgt}")
    file(RELATIVE_PATH rel "${dir}" "${header}")
    file(CONFIGURE OUTPUT "${dir}/${name}" CONTENT "#include \"${rel}\"\n" @ONLY)
    target_include_directories(${tgt} PRIVATE "${dir}")
endfunction()

# Per-library optimisation flags: cache variable GB_OPT_<lib>, defaulting to the vcproj configuration's
# settings (e.g. -DGB_OPT_NiMain="/Od" to match an unoptimised library in the game).
function(gb_set_optimization tgt default)
    set(GB_OPT_${tgt} "${default}" CACHE STRING "Optimisation flags for ${tgt} (default: vcproj configuration)")
    set(flags "${GB_OPT_${tgt}}")
    if(GB_OPT_ALL)
        set(flags "${GB_OPT_ALL}")
    endif()
    separate_arguments(flags UNIX_COMMAND "${flags}")
    target_compile_options(${tgt} PRIVATE ${flags})
endfunction()

function(gb_configure_library tgt)
    set_target_properties(${tgt} PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
endfunction()

