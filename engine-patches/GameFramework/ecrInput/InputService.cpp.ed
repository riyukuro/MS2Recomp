// MS2: every log in this TU goes to the client's error-log hook instead of the efd logger
// (see efd/ServiceManager.cpp, NiDI8InputSystem.cpp)
extern void (*DAT_143b03490)(short, unsigned char, const char*);
#undef EE_LOG
#define EE_LOG(module, level, args) \
    do { if (DAT_143b03490) DAT_143b03490(module, level, efd::LogHelper args); } while (0)

