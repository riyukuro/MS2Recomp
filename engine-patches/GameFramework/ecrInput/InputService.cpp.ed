    if (!m_pMessageService)   // MS2: message service null check first (exe 0x14203be60)
        return false;

.
344,349c
    // MS2: no early failure without an input system; after the first failed update following a good one the
    // keyboard's key states are cleared (exe 0x14203ca40, flag at 0x143a03960)
    static bool s_bUpdateOK = false;
    if (m_spInput)
    {
        // Update input
        NiInputErr eErr = m_spInput->UpdateAllDevices();
        if (eErr != NIIERR_OK)
        {
            if (eErr == NIIERR_DEVICELOST)
                m_spInput->HandleDeviceChanges();
            if (s_bUpdateOK)
            {
                m_spInput->ResetKeyboardStates();
                s_bUpdateOK = false;
            }
        }
        else
        {
            s_bUpdateOK = true;
        }
    }
.
