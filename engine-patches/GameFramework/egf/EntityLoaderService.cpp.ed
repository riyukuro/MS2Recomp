// MS2: map::operator[](key_type&&) as the exe's inliner expands it (14.16 _Try_emplace body)
template<class _Map>
static __forceinline typename _Map::mapped_type& MS2MapIndex(_Map& map, typename _Map::key_type&& key)
{
    typename _Map::iterator where = map.lower_bound(key);
    if (where == map.end() || map.key_comp()(key, where->first))
    {
        where = map.emplace_hint(where, std::piecewise_construct,
            std::forward_as_tuple(std::move(key)), std::tuple<>());
    }
    return where->second;
}

