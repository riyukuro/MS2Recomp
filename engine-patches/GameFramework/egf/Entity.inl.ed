//------------------------------------------------------------------------------------------------
// MS2: saves the old value of propID once while caching is on (0x1421c8b00 for SInt8). The
// copies come from the global operator new (MemObject types too).
template<typename T>
void Entity::CachePropertyValue(PropertyID propID, const T& data)
{
    if (MS2_ENTITY_CACHING)
    {
        if (MS2_ENTITY_CACHE.find(propID) == MS2_ENTITY_CACHE.end())
        {
            T old;
            GetPropertyValueUnsafe(propID, &old, efd::GetClassIDFromType<T>());
            MS2_ENTITY_CACHE[propID] = PropertyCacheEntry(propID, ::new T(old), efd::GetClassIDFromType<T>());
        }
    }
}

//------------------------------------------------------------------------------------------------
// MS2: the keyed variant (0x1421c8bd0 for SInt8).
template<typename T>
void Entity::CachePropertyValue(PropertyID propID, const efd::utf8string& key, const T& data)
{
    if (MS2_ENTITY_CACHING)
    {
        KeyedPropertyCacheMap::iterator it = MS2_ENTITY_KEYED_CACHE.find(propID);
        if (it == MS2_ENTITY_KEYED_CACHE.end())
        {
            T old;
            GetPropertyValueUnsafe(propID, key, &old, efd::GetClassIDFromType<T>());
            MS2_ENTITY_KEYED_CACHE[propID][key] =
                PropertyCacheEntry(propID, ::new T(old), efd::GetClassIDFromType<T>());
        }
        else
        {
            KeyedPropertyCacheEntries::iterator itKey = it->second.find(key);
            if (itKey == it->second.end())
            {
                T old;
                GetPropertyValueUnsafe(propID, key, &old, efd::GetClassIDFromType<T>());
                it->second[key] = PropertyCacheEntry(propID, ::new T(old), efd::GetClassIDFromType<T>());
            }
        }
    }
.
156a
    CachePropertyValue(propID, key, data);  // MS2
.
146a
    CachePropertyValue(propID, data);   // MS2: 0x1428d03a0 (SetPropertyValue<unsigned> by name)
.
132a
    CachePropertyValue(propID, data);   // MS2
.
