1863a
public:
    // MS2: a property cache (the exe Entity is 0xf0 bytes). While caching is on, the first
    // SetPropertyValue<T> of a property (or property key) saves a heap copy of its old value; the
    // client writes the saved values back and frees them (scenestategame.cpp). Names invented, as in
    // the game's src/ms2/placeholder/propertycache.h view. Engine builds define
    // MS2_ENTITY_PROPERTY_CACHE and get the members. The game code keeps the stock 0xc8-byte layout
    // for its egf::Entity subclass views, but its SetPropertyValue<T> instances cache too (every exe
    // instance does, 0x140a38a50 for Point3): they reach the members at the exe offsets
    // (MS2_ENTITY_CACHING etc. below).
    struct PropertyCacheEntry
    {
        PropertyCacheEntry() : m_id(0), m_pValue(NULL), m_type(0) {}
        PropertyCacheEntry(PropertyID id, void* pValue, efd::ClassID type)
            : m_id(id), m_pValue(pValue), m_type(type) {}

        PropertyID m_id;
        void* m_pValue;
        efd::ClassID m_type;
    };
    typedef efd::map<PropertyID, PropertyCacheEntry> PropertyCacheMap;
    typedef efd::map<efd::utf8string, PropertyCacheEntry> KeyedPropertyCacheEntries;
    typedef efd::map<PropertyID, KeyedPropertyCacheEntries> KeyedPropertyCacheMap;

#if defined(MS2_ENTITY_PROPERTY_CACHE)
    /// MS2: frees the saved values without writing them back (0x1421294a0).
    void ClearPropertyCache();
#endif

protected:
    template<typename T>
    void CachePropertyValue(PropertyID propID, const T& data);
    template<typename T>
    void CachePropertyValue(PropertyID propID, const efd::utf8string& key, const T& data);

#if defined(MS2_ENTITY_PROPERTY_CACHE)
    bool m_bCaching;                                // +0xc8
    PropertyCacheMap m_mapCache;                    // +0xd0
    KeyedPropertyCacheMap m_mapKeyedCache;          // +0xe0
#define MS2_ENTITY_CACHING m_bCaching
#define MS2_ENTITY_CACHE m_mapCache
#define MS2_ENTITY_KEYED_CACHE m_mapKeyedCache
#else
#define MS2_ENTITY_CACHING (*reinterpret_cast<bool*>(reinterpret_cast<char*>(this) + 0xc8))
#define MS2_ENTITY_CACHE (*reinterpret_cast<PropertyCacheMap*>(reinterpret_cast<char*>(this) + 0xd0))
#define MS2_ENTITY_KEYED_CACHE (*reinterpret_cast<KeyedPropertyCacheMap*>(reinterpret_cast<char*>(this) + 0xe0))
#endif
.
