#!/bin/sh
# Pins the project Wine prefix: ninja runs compilers long after cmake configured, without its ENV{WINEPREFIX}.
R=$(cd "$(dirname "$0")/../.." && pwd)
export WINEPREFIX="${MS2_WINEPREFIX:-${MS2_MSVC_WINEPREFIX:-$R/work/wineprefix-msvc}}" WINEDEBUG="${WINEDEBUG:--all}"
# Wine cannot spawn a process whose command line exceeds 32767 characters (and wine-msvc.sh then hangs on its FIFOs). The
# dinput8.dll link passes ~1100 object paths (~70 KB): move the relative *.obj arguments into a response file in the cwd.
len=0; for a in "$@"; do len=$((len + ${#a} + 1)); done
if [ "$len" -gt 16000 ]; then
    rsp=$(mktemp ./.link-objs.XXXXXX.rsp) || exit 1
    trap 'rm -f "$rsp"' EXIT
    for a in "$@"; do
        case "$a" in
            [-/]*|@*) set -- "$@" "$a" ;;
            *.obj|*.res|*.lib) printf '"%s"\n' "$a" >>"$rsp" ;;
            *) set -- "$@" "$a" ;;
        esac
        shift
    done
    set -- "$@" "@$rsp"
fi
"${MS2_THIRD_PARTY:-$R/third_party}/msvc/bin/x64/link" "$@"
