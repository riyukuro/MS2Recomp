file Xml/Table/na/mapleSurvivalSkinInfo.xml gms:Xml/table/maplesurvivalskininfo.xml 83320470d72a8185
unset skinInfo feature
# The other survival tables (season, levels, level and pass rewards), whole from the global client, without the
# feature switch like the skin table. The one season's end moves from 2018 to 2028, so the windows show an open
# season period.
file Xml/Table/na/mapleSurvivalOpenPeriod.xml gms:Xml/table/na/maplesurvivalopenperiod.xml e350a76d77dce725
unset period feature
set period[id=1] endTime "2028-10-01-15-00"
