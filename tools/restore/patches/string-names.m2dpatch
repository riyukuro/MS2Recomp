# KR-only quests (feature QuestKR) that no pack has in English: our own English for the 810 quests' titles,
# journal texts and objectives (events and KR missions), with each row's own format fields and line breaks. The
# one test quest is left out.
file Xml/string/kr/questdescription_final.xml kms:Xml/string/kr/questdescription_final.xml 157fd88e98c59ac6
set quest[questID=10001391] name "Qualified for an Audience"
set quest[questID=10001391] desc "$npc:11000076$'s letter of recommendation!\nIt was as good as a certificate \
    granting entry to $map:02000025$ and the right to have an audience with $npc:11000075$. \nGo to \
    $map:02000001$, show the letter to $npc:11000119$, and get permission to enter $map:02000025$."
set quest[questID=10001391] manual "Get $item:30000060$ from $npc:11000076$"
set quest[questID=10001391] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10001392] name "To the Tria Royal Palace!"
set quest[questID=10001392] desc "Will I finally get to meet $npc:11000075$? My heart is pounding.\nHurry into \
    $map:02000025$!"
set quest[questID=10001392] manual "Get $item:30000060$ back from $npc:11000119$"
set quest[questID=10001392] complete "Meet $npc:11000075$ in $map:02000025$"
set quest[questID=10001393] name "Light of Blue Hope"
set quest[questID=10001393] desc "The road I took, leaving $map:63000001$ and coming to Victoria Island with one \
    thought, to meet $npc:11000075$... and the news of the cancelled audience that made it all feel so empty... \
    Standing face to face with $npc:11000075$ now, the past days flash before my eyes and I am filled with \
    emotion. \n\nI don't think I will ever forget $npc:11000075$'s words.\n'Please lend even more of your strength \
    to this world. I ask it in the name of the Empress.'"
set quest[questID=10001393] complete "Meet $npc:11000601$ in $map:02000025$"
set quest[questID=10002220] name "Beings of Darkness"
set quest[questID=10002220] desc "Word has come that somewhere in $map:02000146$ lies the entrance to \
    $map:02000213$, a sort of summoning ground where $npc:23000007$ endlessly calls forth Shadow Legion soldiers \
    and empowers them with the power of darkness."
set quest[questID=10002220] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=10002221] name "The Truth of the Darkness"
set quest[questID=10002221] desc "$npc:11000076$ believes the mysterious door found by a Guardian scout is the \
    entrance to $map:02000213$, and tells you to go ahead and scout the situation while the elite troops prepare."
set quest[questID=10002221] manual "Explore the Shadow Legion summoning ground found in $map:02000146$"
set quest[questID=10002221] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=80000001] name "Open the Lucky Box!"
set quest[questID=80000001] desc "The $item:20300133$ you can get each day you log in can be opened with a \
    $item:30000512$. If you are short on $item:30000512$, $npc:11001484$ hinted that defeating elite monsters in \
    the fields will help. She has also prepared a special gift for anyone who has opened $item:20300133$ 50 times. \
    So go open some boxes!"
set quest[questID=80000001] manual "Open $item:20300133$ with $item:30000512$"
set quest[questID=80000002] name "Delicious Chocolate"
set quest[questID=80000002] desc "To celebrate Valentine's Day, $npc:11000508$ has prepared sweet chocolate. Go \
    find $npc:11000508$."
set quest[questID=80000002] manual "Find $npc:11000508$"
set quest[questID=80000002] complete "Find $npc:11000508$"
set quest[questID=80000003] name "Open the Five-Color Pouches"
set quest[questID=80000003] desc "Collect Five-Color Pouches and use 30 of them. You get 3 pouches every day you \
    log in, and extra ones from quests during the Lunar New Year holidays."
set quest[questID=80000003] manual "Use $item:20300144$"
set quest[questID=80000004] name "Paying Respects"
set quest[questID=80000004] desc "For the Lunar New Year holidays, go find $npc:11000001$ and pay your respects."
set quest[questID=80000004] manual "Find $npc:11000001$"
set quest[questID=80000004] complete "Find $npc:11000001$"
set quest[questID=80000005] name "Find the Spirit of Spring!"
set quest[questID=80000005] desc "Evil beings who envy the warm spring are said to be stealing $item:30000525$. \
    Defeat the elite monsters that appear around the fields, collect 10 $item:30000525$, and bring them to \
    $npc:11001484$."
set quest[questID=80000005] manual "Collect 10 $item:30000525$"
set quest[questID=80000006] name "Kind Hero"
set quest[questID=80000006] desc "$npc:11001484$ has prepared a gift for kind heroes with hearts as beautiful as a \
    warm spring breeze. To prove you are a kind hero, collect 6 $item:30000526$ and bring them to \
    $npcName:11001484$.\nYou get $item:30000526$ by helping another adventurer who struggles with Challenge/Chaos \
    mode dungeons and clearing the dungeon together."
set quest[questID=80000006] manual "Collect 6 $item:30000526$"
set quest[questID=80000010] name "Take Care of the Puppy"
set quest[questID=80000010] desc "The Queen's Animal Love Association is running an animal love campaign to \
    prevent pet abandonment and adopt stray dogs, so that animals and people can become precious friends. They say \
    they are holding an event giving out cute pets to adventurers who love animals... Go find $npc:11001002$ in \
    $map:02000064$."
set quest[questID=80000010] manual "Collect 10 $item:30000535$"
set quest[questID=80000020] name "A Walk with the Puppy"
set quest[questID=80000020] desc "Puppies are lively animals that love walks. \nStrong stamina is a must for a fun \
    walk together! \nAs $npc:11001002$ says, let's breathe in nature and run happily."
set quest[questID=80000020] manual "Run 300m"
set quest[questID=80000021] name "Swimming with the Puppy"
set quest[questID=80000021] desc "Dogs are good swimmers, but puppies are sometimes afraid of water. They say if \
    the owner shows off some great swimming, the puppy will learn to swim easily... \nAs $npc:11001002$ says, jump \
    into the water and swim."
set quest[questID=80000021] manual "Swim 200m"
set quest[questID=80000022] name "Hopping with the Puppy"
set quest[questID=80000022] desc "$npc:11001002$ says that to show off a puppy's cute pink paws and charm people, \
    nothing beats hopping and jumping together. \nAs she suggests, jump and hop with a light heart."
set quest[questID=80000022] manual "Jump 50 times"
set quest[questID=80000023] name "How to Bond with Animals"
set quest[questID=80000023] desc "If you're not sure how to get close to animals, it helps to meet a well-trained \
    animal that is friendly with people. Visit the cat Kali living in the $item:50400004$ placed in your home or \
    someone else's, and play and bond with her."
set quest[questID=80000024] name "How to Play with Animals"
set quest[questID=80000024] desc "If you're not sure how to play with animals, it helps to meet an animal that \
    plays well with people. Play and bond with the monkey happily riding the $item:50400118$ placed in your home \
    or someone else's."
set quest[questID=80000024] manual "Ride the $item:50400118$ with the monkey"
set quest[questID=80000025] name "Training for Crowded Places"
set quest[questID=80000025] desc "Puppies sometimes can't adjust and have a hard time in crowded places. The more \
    so, they need to be helped to get used to it slowly... \nThe crowd at MC $npc:11000787$'s event venue would be \
    good for adjustment training, but some say it may be too much for a young puppy.\nVisit one of $map:61000001$, \
    $map:61000002$, $map:61000007$, $map:61000006$, $map:61000004$, $map:61000003$, $map:61000008$ and check \
    whether it's alright to do the puppy's adjustment training."
set quest[questID=80000026] name "Puppies Love the Sea"
set quest[questID=80000026] desc "These days puppies love $map:51000003$ very much, though nobody knows why... \
    \nGo there yourself and satisfy $npc:11001002$'s curiosity."
set quest[questID=80000026] manual "Play one game in $map:51000003$"
set quest[questID=80000027] name "Puppies Love the Farm"
set quest[questID=80000027] desc "These days puppies love $map:51000001$ very much, though nobody knows why... \
    \nGo there yourself and satisfy $npc:11001002$'s curiosity."
set quest[questID=80000027] manual "Play one game in $map:51000001$"
set quest[questID=80000028] name "Fishing Is Better Together"
set quest[questID=80000028] desc "People from the Queen's Animal Love Association go fishing with their puppies. \
    Not only can they spend time and play together, they can also gather food for the other animals at the \
    shelter... \nIt's a worthy cause, so it would be nice to join in. Go fishing."
set quest[questID=80000028] manual "Catch a fish by fishing"
set quest[questID=80000029] name "Healing Melody for Animals"
set quest[questID=80000029] desc "They say animals love music just as people do. Perhaps because music transcends \
    language and has the power to heal every living thing? \nPlay beautiful music for the animals."
set quest[questID=80000030] name "The Great Battle"
set quest[questID=80000030] desc "An emergency alert has gone off in $map:02000146$.\nMonsters are said to be \
    pouring out of the land of darkness faster on the tide of dark energy... \nDefeat the monsters of \
    $map:02000146$!"
set quest[questID=80000030] manual "Defeat monsters throughout $map:02000146$"
set quest[questID=80000031] name "Paradise of the Fairies"
set quest[questID=80000031] desc "A beautiful garden once called the paradise of the $map:02000023$ fairies...\nA \
    message came from $npcName:11000033$, asking for help because something unusual is happening there.\nHead to \
    $map:02000180$."
set quest[questID=80000032] name "Whirlwind Vortex"
set quest[questID=80000032] desc "$npc:22000007$ is behind the whirlwind vortex sweeping through \
    $map:02000180$!!\nDefeat it and calm the gale!"
set quest[questID=80000033] name "The Road Home"
set quest[questID=80000033] desc "Word came that $npc:11000119$ is urgently looking for you in $map:02000001$. \
    What could it be? \nReturn to $map:02000001$."
set quest[questID=80000034] name "Distress Signal"
set quest[questID=80000034] desc "Phew... I'm swamped... \nThey say an emergency distress signal came in from \
    $map:02000231$... \nI'd like you to go find out what's going on and sort it out."
set quest[questID=80000035] name "Fantasy Rampage"
set quest[questID=80000035] desc "A band is in trouble because monsters are rampaging around the stage just before \
    a concert promised to their audience!\nDefeat the monsters of $map:02000231$ so the audience can enjoy the \
    show safely!"
set quest[questID=80000035] manual "Defeat monsters in $map:02000231$"
set quest[questID=80000036] name "Mission Complete"
set quest[questID=80000036] desc "Word came to return quickly from $map:02000153$.\nGo back to $map:02000153$ and \
    meet $npc:11000215$."
set quest[questID=80000037] name "Vanishing Time"
set quest[questID=80000037] desc "A report came in that there are creatures in $map:02000262$ gobbling up \
    time.\nGo to $map:02000262$ and find out what is going on."
set quest[questID=80000038] name "Slurp Time"
set quest[questID=80000038] desc "$npcName:11000783$ in $map:02000262$ says the monsters living here have eaten \
    time, so his girlfriend Corin and he are stuck as children and can't grow up. He asked you to defeat the \
    monsters so the stopped time can flow again."
set quest[questID=80000039] name "Time to Go Back"
set quest[questID=80000039] desc "Return to $map:02000076$ and report the situation in $map:02000262$ to \
    $npc:11000015$."
set quest[questID=80000040] name "Royal Grandeur"
set quest[questID=80000040] desc "Bobby's 'I Want to Go There' event! \nVisit $map:02000001$, the city of blessing \
    and glory."
set quest[questID=80000040] complete "Talk to $npc:11001003$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000041] name "The Green Hood Hideout"
set quest[questID=80000041] desc "Bobby's 'I Want to Go There' event! \nVisit $map:02000076$, the village of \
    beautiful archers."
set quest[questID=80000041] complete "Talk to $npc:11001003$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000042] name "Behind the Glittering City"
set quest[questID=80000042] desc "Bobby's 'I Want to Go There' event! \nVisit $map:02000100$, a glittering city \
    with a secret side."
set quest[questID=80000042] complete "Talk to $npc:11001003$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000043] name "City of Green Fairies"
set quest[questID=80000043] desc "Bobby's 'I Want to Go There' event! \nVisit $map:02000023$, the city of green \
