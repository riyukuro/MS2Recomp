set key[id=22201038] tooltipDescription "A coin with Ducky drawn on it. Use it to buy items at the coin shop that \
    sells the skin capsule contents. The coin shop only accepts coins of the same round."
set key[id=22201038] guideDescription "$item:22201038$ can be obtained by dismantling items from \
    $item:22001038$.\\nDouble-click the item in your inventory to open the coin shop."
set key[id=22201039] tooltipDescription "A coin with Ducky drawn on it. Use it to buy items at the coin shop that \
    sells the skin capsule contents. The coin shop only accepts coins of the same round."
set key[id=22201039] guideDescription "$item:22201039$ can be obtained by dismantling items from \
    $item:22001039$.\\nDouble-click the item in your inventory to open the coin shop."
