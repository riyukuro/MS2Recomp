set key[id=70800014] mainDescription "Triggers the buddy effect"
set key[id=70800014] tooltipDescription "A badge whose effect appears when you stand within 1.5m of the character \
    you share badges with."
set key[id=70800014] guideDescription "The buddy effect only works between characters who share badges with each \
    other. Once triggered, the effect lasts while you stay still, and fades after 5 seconds if you move. If the \
    name of a character sharing the badge was changed with a Character Name Change Ticket and the item info does \
    not show it, try wearing the badge again while the other player is online.\n"
