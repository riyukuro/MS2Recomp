set key[id=50610021] tooltipDescription "A white calf that gives off a sacred aura."
set key[id=50610021] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion."
set key[id=50620006] mainDescription "Can run very fast."
set key[id=50620006] tooltipDescription "A cart that two people can ride. The sheep pulling it while chewing grass \
    and the chicken sitting on its head are friends."
set key[id=50620006] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620007] mainDescription "Can run very fast."
set key[id=50620007] tooltipDescription "A wedding carriage that two people can ride. Decorated with small flowers \
    and balloons, it feels bright and cheerful."
set key[id=50620007] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620008] mainDescription "Can run very fast."
set key[id=50620008] tooltipDescription "A scooter that two people can ride. Its stable three wheels and long seat \
    let the passenger in back ride comfortably too."
set key[id=50620008] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620009] mainDescription "Can run very fast."
set key[id=50620009] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620010] mainDescription "Can run very fast."
set key[id=50620010] tooltipDescription "A jet ski that two people can ride to cheerfully cut through the waves. \
    Oddly enough, they say the water splashes even when there is no water."
set key[id=50620010] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620011] mainDescription "Can run very fast."
set key[id=50620011] tooltipDescription "A flower swing from the fairy forest that two people can ride. It has \
    beautiful petals, and two people can ride cozily as it scatters light while moving."
set key[id=50620011] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620012] mainDescription "Can run very fast."
set key[id=50620012] tooltipDescription "A scrap robot that two people can ride. Unlike its shabby looks, it is \
    quite useful. The code name G4-2H5 is written on one corner of the robot."
set key[id=50620012] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620014] mainDescription "Can run very fast."
set key[id=50620014] tooltipDescription "A bicycle carriage with a classic design that looks like it came out of \
    an old movie."
set key[id=50620014] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620015] mainDescription "Can run very fast."
set key[id=50620015] tooltipDescription "You caught and tamed the $npc:21000199$ that roams the land of darkness. \
    It runs dynamically, so be careful not to fall off."
set key[id=50620015] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion."
set key[id=50620016] mainDescription "Can run very fast."
set key[id=50620016] tooltipDescription "A carriage pulled by reindeer that give off a brilliant glow. "
set key[id=50620016] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620017] mainDescription "Can run very fast."
set key[id=50620017] tooltipDescription "A duck boat that two people can ride. Oddly enough, they say you can ride \
    it on dry land with no water."
set key[id=50620017] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50620237] mainDescription "Can run very fast."
set key[id=50620237] tooltipDescription "A swing elegantly decorated with white cloth and flowers. When you run \
    fast it sways back and forth, so you really get the feeling of riding a swing."
set key[id=50620237] guideDescription "Double-click it in your inventory or register it in a quick slot to get on \
    and off. After mounting, hold the basic attack key, or move while holding it, to use a special motion. Can \
    carry another adventurer."
set key[id=50770011] tooltipDescription "A special keepsake only those who challenged $npc:23000401$ can get."
set key[id=59200356] tooltipDescription "A package containing the Majestic Wing look."
set key[id=59200356] guideDescription "Double-click the package item in your inventory to get items that fit your \
    character's gender. Wearing the whole Majestic Wing set makes your character strike a special pose."
set key[id=59200369] tooltipDescription "An outfit package with a funky neon cat concept. All sockets on the \
    outfits in this package are open and special options are applied, so you get the option effects by wearing the \
    items in the outfit tab."
set key[id=59200369] guideDescription "Double-click the package item in your inventory to get items that fit your \
    character's gender. \\n\\n<font color='#FFFFFF'>Funky Neon Option Look Details\\n[Base Options]\\n  - Eye \
    Accessory: Accuracy 2\\n  - Hat: Critical Evasion 10\\n  - Overall: STR/DEX/INT/LUK 2\\n  - Gloves: Damage vs. \
    elite monsters +2%\\n  - Shoes: Movement speed +1%\\n  - Cape: Status effect duration -2%\\n\\n[Set \
    Options]\\n  - 3 pieces: Damage vs. elite monsters +2%\\n                Damage vs. boss monsters +2%\\n  - 6 \
    pieces: Physical attack +2\\n                Magic attack +2\\n                Defense penetration \
    +2%\\n                Accuracy +2</font>"
set key[id=59200374] tooltipDescription "Use the coupon to get an outfit package that can be traded once. Using \
    the package you get gives you the outfit set for your own gender."
set key[id=59200374] guideDescription "An outfit item you can wear together with game items.\\n<font \
    color=\"#FF5F5F\">* You must use the exchange coupon to get the outfit package that can be traded once."
