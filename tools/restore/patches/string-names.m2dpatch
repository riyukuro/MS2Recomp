set key[id=128233222003542] name "$MyPCName$, did you see the flowers blooming along the road today?"
set key[id=131180314003894] name "Welcome, $MyPCName$!\nWith White Day coming up, I've prepared a really fun \
    game.\nA game of tag to find $MyPCName$'s partner! What do you think?\nFind today's partner and come to me, \
    and I'll give you <font color=\"#ffd200\">$item:20001302$</font>."
set key[id=131180314003895] name "Now, here is your mission for finding today's partner!\nLook for a <font \
    color=\"#ffd200\">friend of the opposite sex</font> wearing the <font color=\"#ffd200\">'Lovely Heart \
    Ribbon'</font> at level 10 or higher~\nThey're sure to be somewhere in Maple World."
set key[id=131180314003896] name "A <font color=\"#ffd200\">friend of the opposite sex</font> wearing the <font \
    color=\"#ffd200\">'Lovely Heart Ribbon'</font> at level 10 or higher!\nShall we go find them?"
set key[id=131180314003897] name "You managed to find your partner, $MyPCName$!\nHere is the <font \
    color=\"#ffd200\">$item:20001302$</font> I promised.\nI hope you have a day full of love and happiness."
set key[id=131180314003898] name "Welcome, $MyPCName$!\nWith White Day coming up, I've prepared a really fun \
