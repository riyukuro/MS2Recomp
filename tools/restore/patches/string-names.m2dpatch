set key[id=31001966] tooltipDescription "A scroll with a mystic power that opens sockets in an item."
set key[id=31001966] guideDescription "Double-click it to use the scroll.\\n\\n<font color=\"#FFFFFF\">The \
    accessory then has 2 open sockets. Only for level 70 Epic earrings, necklaces and rings whose sockets are all \
    locked or that have 1 socket opened. \\nNote: an item with opened sockets can no longer be traded, and this \
    does not add sockets on top: the number of opened sockets becomes 2.</font>"
set key[id=31001967] tooltipDescription "A bonus re-roller that gives an item new stats."
set key[id=31001967] guideDescription "Double-click it to use the bonus re-roller.\\n\\n<font \
    color=\"#FFFFFF\">Only for level 71 Exceptional capes, belts, earrings, necklaces and rings. It changes only \
    the bonus values.</font>\\n\\n<font color=\"#FF5F5F\">Changing bonuses with a bonus re-roller does not add to \
    the bonus change count.\\nIt cannot be used on items with no bonuses or no bonus change count shown.\\nA bonus \
    re-roller can roll the same value again.</font>"
set key[id=31001998] tooltipDescription "A bonus re-roller that gives an item new stats."
set key[id=31001998] guideDescription "Double-click it to use the bonus re-roller.\\n\\n<font \
