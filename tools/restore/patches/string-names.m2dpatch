set key[id=902202014001181] name "Hello, $MyPCName$! I'm the event helper $npcName:11001003[gender:0]$.\nDuring \
    the Harvest Festival, you eat so much that your stomach feels heavy and you feel like you're gaining \
    weight...\nSo here's $npcName:11001003[gender:0]$'s recommended Harvest Festival diet method!"
set key[id=902202014001182] name "When it comes to dieting, <font color=\"#ffd200\">jumping</font> is the best! \
    \n<font color=\"#ffd200\">Jump</font>! <font color=\"#ffd200\">Jump</font>! Jump until you reach the \
    moon!\nYour heavy stomach will settle, you'll get exercise, and you'll feel great!"
set key[id=902202014001183] name "When it comes to dieting, <font color=\"#ffd200\">jumping</font> is the best! \
    \n<font color=\"#ffd200\">Jump</font>! <font color=\"#ffd200\">Jump</font>! Jump until you reach the \
    moon!\nYour heavy stomach will settle, you'll get exercise, and you'll feel great!"
set key[id=902202014001184] name "Good work.\nDon't your body and mind feel healthier now?"
