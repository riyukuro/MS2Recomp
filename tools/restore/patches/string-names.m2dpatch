set key[id=201205222003543] name "They say $npcName:11004846[gender:1]$ lost the glass shoe again. They formally \
    asked our guild for help."
set key[id=201205222003544] name "The fairy probably didn't want to ask a human for help... Maybe it's because of \
    your friendship with $MyPCName$? "
set key[id=201205222003545] name "A fairy's shoe is hard to recognize at a glance, so bring me $item:30001102$ and \
    I'll appraise it for you."
set key[id=201205222003546] name "I don't think that's enough yet. Please bring me more $item:30001102$."
set key[id=201205222003547] name "Could this be the glass shoe $npcName:11004846[gender:1]$ was looking for? \
    $npcName:11004846[gender:1]$ is waiting, so hurry and take it over!"
set key[id=207142514003922] name "Hello, $MyPCName$!\nCollect the letters <font \
    color=\"#ffd200\">'$item:30001309$', '$item:30001310$', '$item:30001311$'</font>!\nI'll give you a piece item \
    for making a pretty enamel stripe ribbon as a gift."
set key[id=207142514003923] name "$npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
    $npcName:23000019[gender:0]$, $npcName:23000054$, $npcName:23000020[gender:1]$, $npcName:23000035$, \
    \n$npcName:23000099$, $npcName:23000017$, $npcName:23000047$, $npcName:23000024[gender:1]$, \
    $npcName:23000034$, $npcName:23000045$,\n$npcName:23000057[gender:1]$, $npcName:23000026[gender:1]$, \
    $npcName:23000012$, $npcName:23000009[gender:0]$, $npcName:23000029$. \n\nThere are this many bosses that drop \
    the letters <font color=\"#ffd200\">'$item:30001309$', '$item:30001310$', '$item:30001311$'</font>. \
    \nCollecting letters isn't hard, is it?"
set key[id=207142514003924] name "Now then, shall we head out to the field?\nThe bosses I mentioned have the \
    letters <font color=\"#ffd200\">'$item:30001309$', '$item:30001310$', '$item:30001311$'</font> showing above \
    their heads.\nYou'll spot them right away. "
set key[id=207142514003925] name "Here is the gift I promised.\nI really love ribbons! I'm sure you'll love it \
    too, $MyPCName$.\nTo complete the pretty enamel stripe ribbon, you need 14 pieces in total.\nCollect all 14 \
    pieces and become the owner of the ribbon!"
set key[id=207142514003926] name "Hello, $MyPCName$!\nCollect the letters <font \
    color=\"#ffd200\">'$item:30001312$', '$item:30001312$', '$item:30001314$'</font>! You need two of the same \
    <font color=\"#ffd200\">'$item:30001312$'</font>.\nOnce you collect them all, I'll give you a piece item for \
    making a pretty enamel stripe ribbon as a gift."
set key[id=207142514003927] name "$npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
