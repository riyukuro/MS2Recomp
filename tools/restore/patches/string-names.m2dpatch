set mail[id=50000020] subject "[Payback Event] Your payback reward for month {0} has been delivered."
set mail[id=50000020] content "Your payback reward for month {0} of {1} merets has been delivered.\n\n[Details]\n- \
    Total payback achievement rate: {2}%\n- Adventure level gained during the period: level {3}\n- Total merets \
    spent on the Orange Mushroom's Power-Up Capsule: {4} merets"
set mail[id=50001006] subject "[Exceptional Weapon Support] Level 30 Weapon Package Arrived"
set mail[id=50001006] content "Congratulations.\nYour level 30 weapon box and design item have arrived.\n\nDuring \
    the event, we are providing an Exceptional weapon package and a design item every 5 levels from level 1 to \
    level 30. \nUse these items \nto enjoy MapleStory 2 even more!\n\nDouble-click the Exceptional weapon package \
    attached to this mail, \nand you will receive an Exceptional weapon you can use right away.\nExceptional \
    weapons you receive remain usable after the event ends.\n\n(Note) Items attached to this mail will be deleted \
    along with the mail if you do not move them to your inventory within 30 days, so please collect them \
    quickly.\nExceptional weapon boxes and the items inside them cannot be moved between characters."
set mail[id=51000002] sender "Rabbit Girl Myowol"
set mail[id=51000002] subject "[Harvest Festival Event] Bunny Bunny Candy Arrived!"
set mail[id=51000002] content "Hello! This is Myowol, the rabbit girl!\n\nBring the Bunny Bunny Candy I just sent \
    you, and you can join the Harvest Festival event in Queens Town.\nThis year I have prepared a Lucky Spin full \
    of wonderful items.\n\nDuring the Harvest Festival event, you can receive up to 3 Bunny Bunny Candies per day \
    depending on your login time. They cannot be used after the event ends, so don't hold back and give it a \
    try!\n\nOh, and if you want to give some to another character, you can leave them in the vault and move them, \
    so there is nothing to worry about~\n\nI'll be waiting for you in Queens Town!\nThe event ends after the \
    maintenance on October 8, 2015, so be sure to come before it ends~\n"
set mail[id=51000003] sender "Bunny Gal Happy"
set mail[id=51000003] subject "[100 Days Event] 100 Days Commemorative Cake Arrived!"
set mail[id=51000003] content "Hello! This is Happy, the bunny girl!\n\nBring the 100 Days Commemorative Cake I \
    just sent you, and you can join the event in Queens Town.\nTo celebrate 100 days, I have prepared a Lucky Spin \
    full of wonderful items.\n\nDuring the event, you can receive up to 9 Commemorative Cakes per day depending on \
    your login time, and 1 more from the attendance check. The Lucky Spin cannot be used after the event ends, so \
    don't hold back and give it a try!\n\nOh, and if you want to give some to another character, you can leave \
    them in the vault and move them, so there is nothing to worry about~\n\nI'll be waiting for you in Queens \
    Town!\nThe event ends after the maintenance on October 29, 2015, so be sure to come before it ends~\n"
set mail[id=51000004] sender "Papa Santa"
set mail[id=51000004] subject "[Christmas Event] Christmas Cookies Arrived!"
set mail[id=51000004] content "Ho ho ho!! Greetings, adventurers. \n\nEvery 30 minutes, I, Papa Santa, will send \
    you 5 piping hot cookies I baked myself. Gather the cookies and visit my dear friend 'Santa Rudolph' in Queens \
    Town.\nI hear Rudolph has prepared all sorts of Christmas items, so go and have a look. Ho ho ho!!\nYou can \
    also find Christmas cookies in the 'Christmas Tree' bonus map, so don't miss it when you see the red bonus \
    hat!\n\nChristmas cookies can only be used until the maintenance on December 31, so be careful!\nMerry \
    Christmas!"
set mail[id=51000005] sender "Dangdang"
set mail[id=51000005] subject "[New Continent Event] Karkar Commemorative Coin Arrived!"
set mail[id=51000005] content "Greetings, human! \nI am Dangdang, a merchant who collects Karkar Commemorative \
    Coins!\n\nI like humans! I will give you gifts!\nFrom December 31 to January 28, to everyone who logs in every \
    day, \nI will give 4 Karkar Commemorative Coins every 30 minutes! \nGather the coins and come to me, and I \
    will trade them for all sorts of items!\nUntil January 3, play for 2 hours and I will give you a special gift! \
    It holds many good things, so be sure to take it!\n\nBesides the coins I send you for your login time, \nyou \
    can also get extra Karkar Coins by doing various activities in the Karkar region!\nGather more coins in the \
    Karkar region and bring them to me!\n\nI will be waiting in Queens Town or Ludeli City!\n\n"
set mail[id=51000006] subject "Long-Time Maple Box Arrived!"
set mail[id=51000006] content "Hello!\nThank you for playing MapleStory 2.\nWe have prepared a small gift for \
    adventurers who play for a long time.\n\nFrom April 14 until the maintenance on May 12, we will give you 1 \
    'Long-Time Maple Box' \nevery hour, up to 3 times a day.\n\nThe boxes hold items that should help you on your \
    adventures, so come and collect your gift every day.\nHave a happy day today as well."
