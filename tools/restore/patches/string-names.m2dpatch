# Field and dungeon messages that no pack has in English: our own English for the 184 stringtrigger rows still
# in Korean, with each row's own format fields and line breaks. The npc and type labels stay as they are.
file Xml/string/kr/stringtrigger.xml kms:Xml/string/kr/stringtrigger.xml e1f2577d3aac488a
set key[id=61000035_ME__ENTER__0] name "Keep your distance and take the enemy down in one hit."
set key[id=61000035_ME__ENTER__1] name "The doll with the highest score wins."
set key[id=61000035_ME__ENTER__2] name "Don't be fooled by the fake dolls. They will cost you points."
set key[id=61000035_ME__ENTER__3] name "Starting now!"
set key[id=61000035_ME__PVPEND__0] name "The match is over."
set key[id=61000035_ME__MAIN__0] name "Not enough players have entered to start the game.\\nBetter luck next \
    time."
set key[id=02000535_BF__GAMELOGIC_9002__0] name "Preparing the security override code."
set key[id=02000535_BF__GAMELOGIC_9002__1] name "Enter the security override code."
set key[id=02000535_BF__GAMELOGIC_9002__2] name "Security override successful"
set key[id=02000535_BF__GAMELOGIC_9002__3] name "Security override failed"
set key[id=02000535_BF__GAMELOGIC_9002__4] name "Preparing security override code (2/3)"
set key[id=02000535_BF__GAMELOGIC_9002__5] name "Enter the security override code. (2/3)"
set key[id=02000535_BF__GAMELOGIC_9002__6] name "Security override successful"
set key[id=02000535_BF__GAMELOGIC_9002__7] name "Security override failed"
set key[id=02000535_BF__GAMELOGIC_9002__8] name "Preparing security override code (3/3)"
set key[id=02000535_BF__GAMELOGIC_9002__9] name "Enter the security override code. (3/3)"
set key[id=02000535_BF__GAMELOGIC_9002__10] name "Security override successful"
set key[id=02000535_BF__GAMELOGIC_9002__11] name "Security override failed"
set key[id=02000535_BF__MAIN__36] name "Let's keep moving forward until we find the entrance to \
    $map:02000536$.\\nFollow the path."
set key[id=02000535_BF__MAIN__37] name "[Showdown with the Black Star Society members]\\nProve your ability in \
    $map:02000555$.\\nWin the showdown with the Black Star Society to earn a reward."
set key[id=02000535_BF__MAIN__38] name "We found the entrance to $map:02000536$.\\nActivate the security device \
    next to the door to unlock it."
set key[id=02000535_BF__MAIN__39] name "[Showdown with the Security System]\\nLet's quickly enter the numbers that \
    appear from now on.\\nIf you fail 3 times, the security system will punish you."
set key[id=02000535_BF__MAIN__40] name "[Success]\\nYou entered it correctly.\\nThe entrance to $map:02000536$ is \
    opening."
set key[id=02000535_BF__MAIN__41] name "[Failure]\\nThe security system dislikes you.\\nThe lock is activating."
set key[id=02000535_BF__MAIN__42] name "Argh! I failed..."
set key[id=02000535_BF__MAIN__43] name "[Showdown with Patience]\\nOh well. Just force it open."
set key[id=02000535_BF__MAIN__44] name "What, the door opened? Then... it's my turn to step up!"
set key[id=02000535_BF__MAIN__45] name "I found the entrance."
set key[id=02000536_BF__MAIN__0] name "[Showdown with the Black Star Society Executive]"
set key[id=02000536_BF__MAIN__2] name "Heh heh. You got all the way in here? Impressive!"
set key[id=02000536_BF__MAIN__3] name "Whether you challenge me is up to you, but whether you win or lose is up to \
    me~\\nNow, come at me!"
set key[id=02000536_BF__MAIN__4] name "Defeat the Black Star Society executive, $npcName:11004704$!"
set key[id=02000536_BF__MAIN__5] name "Not bad! No wonder you came in here alone~ I'll give you credit."
set key[id=02000536_BF__MAIN__6] name "This is getting boring. Shall we start playing for real now?"
set key[id=02000536_BF__MAIN__8] name "You're pretty good! I have to admit it!"
set key[id=02000537_BF__MAIN__0] name "You must go down along the towering fortress.\\nBeware of the darkness \
    closing in."
set key[id=02000537_BF__MAIN__1] name "A human? It's been so long since I smelled that scent. How fragrant. Come \
    on down into the darkness, nice and slow."
set key[id=02000537_BF__MAIN__2] name "Poor human.... The Spring is already watching you. The darkness will chase \
    you."
set key[id=02000537_BF__MAIN__3] name "The darkness spring has noticed you.\\nBlack arrows that crave life are \
    chasing you."
set key[id=02000537_BF__MAIN__4] name "The Spring that slept for hundreds of years has awoken. The Spring wants \
    souls."
set key[id=02000537_BF__MAIN__5] name "Spiders.... I hate spiders... They are the ones who ensnare souls..."
set key[id=02000537_BF__MAIN__6] name "The Spring watches everything through the spiders' eyes. You'd better be \
    careful."
set key[id=02000537_BF__MAIN__7] name "How much longer do I have to wait? Hurry up and come down here."
set key[id=02000537_BF__MAIN__8] name "Poor soul. Now that you're in here, it will be hard to leave."
set key[id=02000537_BF__MAIN__9] name "The Spring will bind your soul."
set key[id=02000537_BF__MAIN__10] name "Yes, just like us...."
set key[id=02000537_BF__MAIN__11] name "There you go! You finally made it here. Your soul will be offered to the \
    Spring too!"
set key[id=02000537_BF__MAIN__12] name "Where will you end up?.... We can't tell. This is a twisted, unknown \
    place. Everything is at the Spring's will...."
set key[id=02000538_BF__MAIN__0] name "You must push down through the endless darkness."
set key[id=02000538_BF__MAIN__1] name "Don't worry too much. We'll show you the way. "
set key[id=02000538_BF__MAIN__2] name "A path where neither what you see nor what you can't see can be \
    trusted...."
set key[id=02000538_BF__MAIN__3] name "No matter what happens, don't be too startled."
set key[id=02000538_BF__MAIN__4] name "You'll be fine until you meet the Spring."
set key[id=02000538_BF__MAIN__5] name "No living being can enter this place. The Spring keeps pulling you further \
    down."
set key[id=02000538_BF__MAIN__6] name "Don't get bound here like us. I hope at least you can leave this place."
set key[id=02000538_BF__MAIN__7] name "Just because you can't see anything doesn't mean there's no path. The path \
    lies where you can't see."
set key[id=02000538_BF__MAIN__8] name "It's scary, I know, but trust me. I'll open it for you."
set key[id=02000539_BF__MAIN__0] name "This is a place of darkness. No living being can cross it. I'll open it for \
    you."
set key[id=02000539_BF__MAIN__1] name "The bridge here broke long ago. If you enter here, you'll be trapped with \
    nowhere to go."
set key[id=02000539_BF__MAIN__2] name "There's no path above. Quietly come down."
set key[id=02000539_BF__MAIN__3] name "I'll build you a bridge with the strength I have left. Follow me."
set key[id=02000539_BF__MAIN__4] name "Don't worry about us. We're fine."
set key[id=02000539_BF__MAIN__5] name "A rather noisy fellow guards the path here. Can you get past without him \
    noticing?"
set key[id=02000539_BF__MAIN__6] name "He may already be watching. He has a good nose."
set key[id=02000539_BF__MAIN__7] name "This time it's above. Come up."
set key[id=02000539_BF__MAIN__8] name "I wonder whether building the bridge is the right thing. Maybe it hurts \
    less never to meet the Spring."
set key[id=02000539_BF__MAIN__9] name "I can hear his voice. He will greet you."
set key[id=02000539_BF__MAIN__10] name "The door leading down has opened. Let's hurry before the darkness \
    notices."
set key[id=02000539_BF__TALK__0] name "The scent of a living human..."
set key[id=02000539_BF__TALK__1] name "I hear a strange sound from down here... You'd better be careful..."
set key[id=02000539_BF__TALK__2] name "Do you know where this is?"
set key[id=02000539_BF__TALK__3] name "The darkness is seeping in from above..."
set key[id=02000539_BF__TALK__4] name "You have to cross the central bridge..."
set key[id=02000540_BF__MAIN__0] name "Take the portal to the temple."
set key[id=02000540_BF__MAIN__1] name "I smell a human."
set key[id=02000540_BF__MAIN__2] name "A hunk of meat, at long last..."
set key[id=02000540_BF__MAIN__3] name "There's a delicious smell..."
set key[id=02000540_BF__MAIN__4] name "When the temple regains its light, you'll see the entrance leading down."
set key[id=02000540_BF__MAIN__5] name "Light the fires of the temple."
set key[id=02000540_BF__MAIN__6] name "The first fire is lit."
set key[id=02000540_BF__MAIN__7] name "That's not enough. I think you need to light all 4 lanterns."
set key[id=02000540_BF__MAIN__8] name "Do you dare go down there? Just give in and be our meal here."
set key[id=02000540_BF__MAIN__9] name "Light the fires of the temple."
set key[id=02000540_BF__MAIN__10] name "The second fire is lit."
set key[id=02000540_BF__MAIN__11] name "If you light all the fires of the temple, you can go down below."
set key[id=02000540_BF__MAIN__12] name "Foolish creatures, daring to enter here."
set key[id=02000540_BF__MAIN__13] name "Light the fires of the temple."
set key[id=02000540_BF__MAIN__14] name "The third fire is lit."
set key[id=02000540_BF__MAIN__15] name "There's a delicious smell."
set key[id=02000540_BF__MAIN__16] name "Light the fires of the temple."
set key[id=02000540_BF__MAIN__17] name "All the temple fires are lit.\\nFind the portal leading down to the \
    center."
set key[id=02000540_BF__MAIN__18] name "I don't know how long this light will last, but it feels nostalgic."
set key[id=02000540_BF__MAIN__19] name "Someone is coming."
set key[id=02000540_BF__MAIN__20] name "I smell the Spring down below."
set key[id=02000542_BF__MAIN__0] name "Open the prison door and move on."
set key[id=02000542_BF__MAIN__1] name "So you made it here."
set key[id=02000542_BF__MAIN__2] name "Souls caught by the Spring gather here."
set key[id=02000542_BF__MAIN__3] name "I was imprisoned here too."
set key[id=02000542_BF__MAIN__4] name "The one who guards this place is very cunning."
set key[id=02000542_BF__MAIN__5] name "Open the prison door and head to the ladder."
set key[id=02000542_BF__MAIN__6] name "Go now..."
set key[id=02000542_BF__MAIN__7] name "If you're even a little late, you'll end up trapped like us."
set key[id=02000542_BF__MAIN__8] name "Human.... I smell a human...."
set key[id=02000542_BF__MAIN__9] name "Run away from here...."
set key[id=02000542_BF__MAIN__10] name "Go back to where you came from, quickly!"
set key[id=02000542_BF__MAIN__11] name "I want to get out of here."
set key[id=02000542_BF__MAIN__12] name "I want to get out of the prison...."
set key[id=02000542_BF__MAIN__13] name "Here.... I want to get out of this prison...."
set key[id=02000542_BF__MAIN__14] name "Run before you get trapped like us."
set key[id=02000542_BF__MAIN__15] name "That one is coming."
set key[id=02000542_BF__MAIN__16] name "It's that one."
set key[id=02000542_BF__MAIN__17] name "Run."
set key[id=02000542_BF__MAIN__18] name "The scent of the one who locked us up here."
set key[id=02000542_BF__MAIN__19] name "That one is coming. The one who locked us up here."
set key[id=02000542_BF__MAIN__20] name "Leave before the darkness closes in."
set key[id=02000542_BF__MAIN__21] name "There's something even darker and scarier below. Be careful."
set key[id=02000543_BF__GAUGE__0] name "Offering a Sacrifice"
set key[id=02000543_BF__MAIN__0] name "There is a door here... that only opens with a life offered."
set key[id=02000543_BF__MAIN__1] name "Do you see that door? The Spring's power dwelling in it.... wants your \
    life."
set key[id=02000543_BF__MAIN__2] name "We need a soul."
set key[id=02000543_BF__MAIN__3] name "The intruder's soul.... Bring me that soul."
set key[id=02000543_BF__MAIN__4] name "The Spring has summoned a minion. It slept for so long... it can't muster \
    its full strength yet."
set key[id=02000543_BF__MAIN__5] name "Offer that one's soul to me!"
set key[id=02000543_BF__MAIN__6] name "You hear a sound from the right door."
set key[id=02000543_BF__MAIN__7] name "You hear a sound from the left door."
set key[id=02000543_BF__MAIN__8] name "That soul looks tastier than I expected. I will surely offer your soul to \
    Him."
set key[id=02000543_BF__MAIN__9] name "You hear a sound from both doors."
set key[id=02000543_BF__MAIN__10] name "Not bad. Failure is not tolerated among us. Go, my minions."
set key[id=02000543_BF__MAIN__11] name "You sense an unknown force.\\nYou can't move your body."
set key[id=02000543_BF__MAIN__12] name "Goddess of Darkness. Please calm your wrath and give me one more chance."
set key[id=02000543_BF__MAIN__13] name "P... please..... Aaaargh!"
set key[id=02000543_BF__MAIN__14] name "The minion's soul fades away, stirring up a great wind."
set key[id=02000543_BF__MAIN__15] name "The sweet taste of a soul."
set key[id=02000543_BF__MAIN__16] name "I'm full. I think I can stop eating now."
set key[id=02000543_BF__MAIN__17] name "Luckily, the door opened at the cost of the minion's life."
set key[id=02000545_BF__EGG__0] name "Come out. My children..."
set key[id=02000545_BF__EGG2__0] name "Come out. My children..."
set key[id=02000545_BF__MAIN__0] name "You finally made it here. This is where the Spring sleeps."
set key[id=02000545_BF__MAIN__1] name "Another fool who dared to come close to the Spring. Do you want to be \
    trapped here too?"
set key[id=02000545_BF__MAIN__2] name "Well, you can't escape either. The Spring has noticed you. It's going to \
    attack."
set key[id=02000545_BF__MAIN__3] name "The Spring is about to move."
set key[id=02000545_BF__MAIN__4] name "It's calling the darkness."
set key[id=02000545_BF__MAIN__5] name "If the darkness catches you, it's over."
set key[id=02000545_BF__MAIN__6] name "The scent of warm life. Bring that one's life to me."
set key[id=02000545_BF__MAIN__7] name "The darkness spring summons monsters from underground."
set key[id=02000545_BF__MAIN__8] name "Aaaaargh! They're coming again!"
set key[id=02000545_BF__MAIN__9] name "Finally cleaned that up. It will try everything to get rid of the intruder. \
    Don't let your guard down!"
set key[id=02000545_BF__MAIN__10] name "The darkness spring summons a powerful being from underground."
set key[id=02000545_BF__MAIN__11] name "Scarf. He's just like us. But he was tainted by the darkness, bewitched by \
    the Spring's voice."
set key[id=02000545_BF__MAIN__12] name "You're stronger than I thought! Maybe you could lift my curse! Find out \
    what curse the Spring put on me!"
set key[id=02000545_BF__MAIN__13] name "If it's you, you could get me out... What is this tremor?"
set key[id=02000545_BF__MAIN__14] name "I'll lend you my power. Little spider...."
set key[id=02000545_BF__MAIN__15] name "Offer that little life to me...."
set key[id=02000545_BF__MAIN__16] name "Heh heh heh.... What a delicious smell."
set key[id=02000545_BF__MAIN__17] name "Aaaargh! All the darkness spring's power was absorbed by the spider! I can \
    feel a huge power!"
set key[id=02000545_BF__MAIN__18] name "Poor thing. I'll eat you slowly."
set key[id=02000545_BF__MAIN__19] name "My mouth is watering. Make it more fun for me."
set key[id=02000545_BF__MAIN__20] name "Enough games. Shall we enjoy the feast?"
set key[id=02000545_BF__MAIN__21] name "The Spring's power hasn't vanished completely, but it seems to be asleep. \
    Though that rabbit has no choice but to stay with us...."
set key[id=02000545_BF__MAIN__22] name "You can get out."
set key[id=02000545_BF__MAIN__23] name "Take care on your way out!"
set key[id=02000545_BF__MAIN__24] name "Thank you for putting the Spring to sleep, even for a while."
set key[id=02000545_BF__MAIN__25] name "Wait. Did you not lift my curse? No! "
set key[id=02000551_BF__BOSSSPAWN__0] name "Welcome to my playground, friend! Now let's have some fun~"
set key[id=52000192_QD__52000192__6] name "Oh dear... These are the ones I used to spot now and then. They crawl \
    out to escape the fire."
set key[id=52000193_QD__52000193__0] name "At that moment... Empress Ereb"
set key[id=52000193_QD__52000193__1] name "The Empress's Bedchamber"
set key[id=52000194_QD__52000194__0] name "The Cracked Bedchamber of the Empress"
set key[id=52000194_QD__52000194__1] name "A Rift in Time and Space"
set key[id=52000195_QD__52000195__0] name "Last night, in Ereb's dream"
set key[id=52000195_QD__52000195__1] name "Where... am I?"
set key[id=52000195_QD__52000195__2] name "The dark substances that appeared in Tria are here too...!"
set key[id=52000195_QD__52000195__3] name "It seems to continue up ahead."
set key[id=52000195_QD__52000195__4] name "I will take the Empress to the land of darkness.\\nIf you object, I'll \
    take her by force."
set key[id=52000195_QD__52000195__5] name "Are you serious...?\\nI will never allow this!"
set key[id=52000195_QD__52000195__6] name "To think you'd be tainted by darkness and put the Empress in \
    danger...\\nYou must have lost your mind."
set key[id=52000195_QD__52000195__7] name "I'm going to Empress Ereb right now."
set key[id=52000195_QD__52000195__8] name "!!!\\nStop it this instant!!!"
set key[id=52000195_QD__52000195__9] name "What... is this?"
set key[id=52000195_QD__52000195__11] name "The world...!"
set key[id=52000200_QD__52000200__31] name "Good. I'll collect the promised item after that."
set key[id=52000202_QD__52000202__3] name "Why on earth did a place like this appear?"
set key[id=52000202_QD__52000202__5] name "I sense some powerful force...!"
set key[id=51000006_DG__51000006_MAIN__4] name "I won't lose to you!"
