# Item descriptions (feature-tagged items, locale KR or none) still in Korean whose item a drop, shop, quest, set or
# another item refers to: our own English for the 317 items' Korean tooltip, guide and main lines (no pack has
# English for them), with each row's own format fields and line breaks.
file Xml/string/kr/koritemdescription.xml kms:Xml/string/kr/koritemdescription.xml 669a7f4ea48c36b2
set key[id=11310001] tooltipDescription "Adorable white cat ears."
set key[id=11600545] tooltipDescription "Gloves made for warriors who fight fiercely on the battlefield."
set key[id=11600545] guideDescription "Additional skill effects do not apply in battlefields and arenas."
set key[id=11700567] tooltipDescription "Shoes made for warriors who fight fiercely on the battlefield."
set key[id=11700567] guideDescription "Additional skill effects do not apply in battlefields and arenas."
set key[id=14000258] tooltipDescription "<font color='#ff8ae5' size='14'>[Body Reinforcement]\\nWhen you strike, \
    there is a 10% chance to increase attack speed by 10% for 24 sec. This effect is only active when used \
    together with Frontier Light Hall.\\n\\n[Specialization B]\\nIn Madracan Spire, the Body Reinforcement effect \
    is tripled.\\n\\nThis effect does not apply in battlefields and arenas.</font>"
set key[id=14000258] guideDescription "\\n<font color='#7A7A7A'>An armament set ordered as standard-issue gear for \
    the Frontier Foundation. It was originally planned to be issued to the Foundation guards, the survey team, and \
    every participating adventurer, but the whole shipment was ambushed and lost on its way to the Foundation. \
    Since the price was far above that of ordinary standard-issue gear, no replacement was ever produced. Rumor \
    has it the enormous price comes from anti-dragon metal, a special metal made for fighting dragons.</font>"
set key[id=15500090] tooltipDescription "Knuckles made for warriors who fight fiercely on the battlefield."
set key[id=15500090] guideDescription "Additional skill effects do not apply in battlefields and arenas."
set key[id=15500208] guideDescription "A skin weapon item that can be used with knuckles."
