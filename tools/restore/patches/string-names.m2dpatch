set key[id=211134614002076] name "Welcome, $MyPCName$!\nStrong! Excited! Healthy!! Today too! You know the drill, \
    right?"
set key[id=211134614002077] name "In that spirit, shall we <font color=\"#ffd200\">run</font> around \
    happily?\nDon't think it's an obvious mission! Running is the basis of everything!"
set key[id=211134614002078] name "In that spirit, shall we <font color=\"#ffd200\">run</font> around \
    happily?\nDon't think it's an obvious mission! Running is the basis of everything!"
set key[id=211134614002079] name "How was it? You feel a lot better now, don't you?"
set key[id=211134614002080] name "Welcome, $MyPCName$!\nStrong! Excited! Healthy!! Today too! You know the drill, \
    right?"
set key[id=211134614002081] name "In that spirit, shall we <font color=\"#ffd200\">jump</font> around \
