set key[id=63100502] tooltipDescription "<font color='#ffffff'>Capturable Pets\\n - Pets of required level 50 or \
    higher can be captured \\n - High chance for Normal pets\\n - Average chance for Rare pets\\n - Very low \
    chance for Elite and Exceptional pets</font>\\n\\n'A newly developed monster capture device. Throw it at a \
    hungry monster to create a powerful electric field and capture it.</font>'"
set key[id=63100502] guideDescription "<font color='#9FC93C'>Using the item throws it at a hungry or tame monster, \
    and a hit gets you a pet card.\\nAlso, Lapis Capsules are only used up when you capture a pet, so you can use \
    it without worry.</font>\\nUse the item on a hungry monster to get a pet."
set key[id=63100502] mainDescription "<font color='#ffffff'>Pet Capture Tool\\n</font><font color='#909090'>For \
    capturing monsters</font>"
set key[id=70100008] tooltipDescription "While worn, it keeps producing in mining, gathering, ranching, and \
    farming until there is no chance left."
set key[id=70100008] guideDescription "Drag a badge from your inventory to the Badge tab of the character info \
    window, or right-click it to equip it. Then auto-production works when you interact with mining, gathering, \
    ranching, and farming objects."
set key[id=70100008] mainDescription "Auto-production available"
set key[id=70150002] tooltipDescription "<font color='#ffffff'>Fully Evolved Meta Badge\\n</font>"
set key[id=70150002] guideDescription "\\nHow to get $item:20302626$<font color='#FFFFFF'>\\n- Obtained by chance \
    while defeating monsters / playing instruments / fishing\\n- Up to 60 can be obtained per day</font>"
set key[id=70150002] mainDescription "<font size='14'>Effect Activates When Worn</font>\\n<font \
    size='24'>Physical/Magic Attack increased by 2%</font>"
set key[id=70150020] tooltipDescription "<font color='#ffffff'>Evolvable Meta Badge\\n - Combine with 400 Meta \
    Cores to evolve into a Silver Badge that increases Physical/Magic Attack by 3%\\n - Combine with 700 Meta \
    Cores to evolve into a Gold Badge that increases Physical/Magic Attack by 5%\\n</font>"
set key[id=70150020] guideDescription "\\nHow to get $item:20303139$<font color='#FFFFFF'>\\n- Obtained by chance \
    while defeating monsters / playing instruments / fishing\\n- Up to 100 can be obtained per day</font>"
set key[id=70150020] mainDescription "<font size='14'>A Meta Badge that has no effect yet</font>"
set key[id=70300111] tooltipDescription "A functional fashion badge that makes your character's name stand out."
set key[id=70300111] mainDescription "Decorate character name"
set key[id=70300125] tooltipDescription "A functional fashion badge that makes your character's name stand out."
set key[id=70300125] mainDescription "Decorate character name"
set key[id=70601019] tooltipDescription "A functional badge that decorates your swim tube."
set key[id=70601019] guideDescription "Drag a badge from your inventory to the Badge tab of the character info \
    window, or right-click it to equip it, and you can decorate your character's swim tube. Only one swim tube \
    badge can be equipped."
set key[id=70601019] mainDescription "Decorate swim tube"
set key[id=70711019] tooltipDescription "A functional badge that decorates your fishing rod and fishing chair."
set key[id=70711019] guideDescription "Drag a badge from your inventory to the Badge tab of the character info \
    window, or right-click it to equip it. Only one fishing badge can be equipped."
set key[id=70711019] mainDescription "Decorate fishing rod and fishing chair"
set key[id=70711020] tooltipDescription "A functional badge that decorates your fishing rod and fishing chair."
set key[id=70711020] guideDescription "Drag a badge from your inventory to the Badge tab of the character info \
    window, or right-click it to equip it. Only one fishing badge can be equipped."
set key[id=70711020] mainDescription "Decorate fishing rod and fishing chair"
