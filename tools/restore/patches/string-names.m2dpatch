set quest[questID=80000062] name "In Search of Miss Valentine"
set quest[questID=80000062] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \
    \n$npc:22000022$, ruler of $map:02000117$, was voted the woman adventurers most want chocolate from. She is \
    gentle, but is her beastly instinct hidden away, or is she rampaging? Go and see."
set quest[questID=80000062] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000063] name "In Search of Mr. White"
set quest[questID=80000063] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \nGo to \
    $map:02000118$ and meet $npc:11000617$, a man with an appealing poker face who was once voted the man \
    adventurers most want candy from."
set quest[questID=80000063] manual "Find $npc:11000617$ in $map:02000118$"
set quest[questID=80000063] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
