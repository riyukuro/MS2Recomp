set key[id=20301604] tooltipDescription "A reward box received when a Burning character reaches Level 60. It \
    contains a weapon, armor and shared accessories for your class. However, beginners receive a weapon or armor \
    for the class by a set chance, and the armor cannot be worn."
set key[id=20301604] guideDescription "Double-click the item in your inventory to get its contents."
set key[id=20301750] tooltipDescription "A reward box received as a Guide reward for reaching Level 60. It \
    contains a weapon, armor and shared accessories for your class."
set key[id=20301750] guideDescription "Double-click the item in your inventory to get an item. The item you get is \
    bound to the character and cannot be disassembled."
set key[id=20301892] tooltipDescription "A mugwort songpyeon whose fragrant mugwort scent lifts your mood. Thanks \
    to the full moon mill's secret, they say you can get a special gift when you open it."
set key[id=20301892] guideDescription "Double-click it in your inventory to get one of the items below. "
set key[id=20301893] tooltipDescription "A songpyeon filled with plenty of sweet honey. Thanks to the full moon \
    mill's secret, they say you can get a special gift when you open it."
set key[id=20301893] guideDescription "Double-click it in your inventory to get one of the items below. "
set key[id=20301894] mainDescription "<font size='14'>15 Sec Cooldown</font>\\n<font size='20'>Restores 1700 HP, \
    30 SP</font>"
set key[id=20301894] tooltipDescription "Songpyeon made from the full moon mill's secret recipe. Chewy texture and \
    a pretty shape, and delicious too."
set key[id=20301894] guideDescription "Eating it restores 1700 HP and 30 SP.\\nAfter eating, you can eat again \
    after 15 sec.\\nHowever, it cannot be used when HP is full."
set key[id=20301902] mainDescription "<font size='14'>15 Sec Cooldown</font>\\n<font size='20'>Restores 1700 HP, \
    30 SP</font>"
set key[id=20301902] tooltipDescription "Songpyeon made from the full moon mill's secret recipe. Chewy texture and \
    a pretty shape, and delicious too."
set key[id=20301902] guideDescription "Eating it restores 1700 HP and 30 SP.\\nAfter eating, you can eat again \
    after 15 sec.\\nHowever, it cannot be used when HP is full."
set key[id=20301961] tooltipDescription "A box that lets you choose and get the pet you want."
set key[id=20301961] guideDescription "Double-click it in your inventory to choose 1 of the items inside."
set key[id=20302124] tooltipDescription "A special package for users who took part in the security event. You can \
    get a name tag badge, a speech bubble badge and a title."
set key[id=20302149] mainDescription "2,000 merets"
set key[id=20302149] tooltipDescription "A pouch filled with merets."
set key[id=20302149] guideDescription "Double-click it in your inventory to receive merets."
set key[id=20302165] tooltipDescription "A magic bundle holding Christmas presents. You need a <font \
    color='#00aaef'>Christmas Magic Key</font> to open it."
set key[id=20302165] guideDescription "\\nHow to get the magic gift<font color='#FFFFFF'>\\n- Keep the Christmas \
    Magic Bundle until Christmas arrives.\\n- On Christmas, complete the quest Ruby gives you.\\n- Ruby gives you \
    a magic key as the quest reward, which opens the bundle.\\n<font color=\"#FFFFFF\">* The item becomes \
    character-bound when opened, so use it with care.</font>"
set key[id=20302166] tooltipDescription "A magic key needed to open the Christmas Magic Bundle you got on \
    Christmas Eve."
set key[id=20302166] guideDescription "\\nHow to get the magic gift<font color='#FFFFFF'>\\n- With this key, you \
    can open the Christmas Magic Bundle you received on Christmas Eve. \\n- After Christmas the magic wears off \
    and the bundle and key disappear, so be sure to get them on Christmas."
set key[id=20302273] tooltipDescription "A box holding a special gift that GM Laura prepared with excitement for \
    the GM Day just before the new year."
set key[id=20302273] guideDescription "Double-click it in your inventory to receive its contents."
set key[id=20302339] tooltipDescription "A special gift box for customers who joined the Crazy Arcade M \
    promotion."
set key[id=20302408] tooltipDescription "A box that gives you $item:20000004$ and $item:20000040$."
set key[id=20302410] tooltipDescription "A box that lets you choose the type of Tier 1 Lumistone (account-bound) \
    you want."
set key[id=20302410] guideDescription "Double-click it in your inventory to choose 1 of the items inside. "
set key[id=20302412] tooltipDescription "A box containing $item:20301332$, $item:20301874$, and $item:20302407$, \
    which give you a title and a mark right away. You cannot receive a title you already own, so choose \
    carefully."
set key[id=20302412] guideDescription "Double-click it in your inventory to choose 1 of the items inside."
set key[id=20302416] tooltipDescription "A box that lets you choose and get the pet you want."
set key[id=20302416] guideDescription "Double-click it in your inventory to choose 1 of the items inside.<font \
    color='#FF5F5F'>\\n\\n* The pet you receive is account-bound and cannot be repacked with \
    $item:20301160$.</font>"
set key[id=20302419] tooltipDescription "A supply box given out once each time you take part in a Legion Battle \
    during the event, up to 3 times a day."
set key[id=20302420] tooltipDescription "A piece of an enamel stripe ribbon. "
set key[id=20302420] guideDescription "Double-click it to use it. Spend 14 to make an enamel stripe ribbon."
set key[id=20302424] tooltipDescription "A ticket for playing a rock-paper-scissors match. 1 is used up when a \
    match is completed."
set key[id=20302424] guideDescription "Create a match ad yourself from the Rock-Paper-Scissors event menu in the \
    Adventure tab, or walk up to another adventurer's match ad and challenge them to play."
set key[id=20302442] tooltipDescription "A box of cute school-supply weapons."
set key[id=20302442] guideDescription "Double-click it in your inventory to receive a weapon skin for your class."
set key[id=20302443] tooltipDescription "A box containing cute Pink Bean items."
set key[id=20302443] guideDescription "Double-click it in your inventory to receive the items.<font \
    color='#FF5F5F'>\\n\\n* Can only be obtained from $item:20301206$ until the maintenance on April 11, \
    2019.</font>"
set key[id=20302550] tooltipDescription "A box that lets you choose the swim tube badge you want."
set key[id=20302550] guideDescription "Double-click it in your inventory to choose 1 of the items inside.<font \
    color='#FF5F5F'>\\n\\n* Swim tube badges become character-bound when equipped.</font>"
set key[id=20302594] tooltipDescription "A box that gives you all 12 beauty coupons for your gender. \\nIf you got \
    this box, you are one of the luckiest players in MapleStory 2 history."
set key[id=20302594] guideDescription "Double-click it in your inventory to receive the items.\\n\\n<font \
    color=\"#FF5F5F\">* The items inside the box cannot be traded, and the box can be traded once, so think \
    carefully before opening it.</font>"
set key[id=20302595] tooltipDescription "A box that gives you 1 billion mesos. \\nIf you got this box, you are one \
    of the luckiest players in MapleStory 2 history."
set key[id=20302595] guideDescription "Double-click it in your inventory to receive the items.\\n\\n<font \
    color=\"#FF5F5F\">* The items inside the box cannot be traded, and the box can be traded once, so think \
    carefully before opening it.</font>"
set key[id=20302596] tooltipDescription "A box that gives you a whopping 100 Luxury Style Keys. \\nIf you got this \
    box, you are one of the luckiest players in MapleStory 2 history."
set key[id=20302596] guideDescription "Double-click it in your inventory to receive the items.\\n\\n<font \
    color=\"#FF5F5F\">* The items inside the box cannot be traded, and the box can be traded once, so think \
    carefully before opening it.</font>"
set key[id=20302597] tooltipDescription "A box holding a chance to turn your Maple 2 life around. It can only be \
    opened on Saturdays and Sundays during the event period."
set key[id=20302597] guideDescription "\\nWhat is $item:20301856$?<font color='#FFFFFF'>\\n- It is sent by mail \
    every 30 minutes while you are logged in on Saturday and Sunday.\\n- With luck, you can get a 'Jackpot! Beauty \
    Fortune Box'.\\n- Even without luck, everyone gets one of a variety of items.\\n\\n* The main items listed \
    below are only some of the items you can get. Many more items are included.<font color='#FFFFFF'></font>"
set key[id=20302598] tooltipDescription "A box holding a chance to turn your Maple 2 life around. It can only be \
    opened on Saturdays and Sundays during the event period."
