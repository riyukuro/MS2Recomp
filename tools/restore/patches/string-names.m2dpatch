set quest[questID=80000550] name "A Fragrant Secret"
set quest[questID=80000550] desc "For the harvest festival, the Moon Rabbit Mill had been at its busiest making \
    songpyeon rice cakes. Then, one day, more and more moon rabbits abandoned their posts until the mill could no \
    longer run. The foreman's daughter $npc:11004248$, bedridden with grief, has come down to Maple World and is \
    racking her brain for a way to supply songpyeon to adventurers...\n$npc:11001003$ says that if you trim the \
    $item:30001195$ found by examining the flower balloons scattered across Maple World, it might give off a scent \
    like the Moon Rabbit Mill's mugwort songpyeon. Nothing ventured, nothing gained! For the sake of the \
    downhearted moon rabbits, collect 10 $item:30001195$ and bring them to $npc:11004248$ in $map:02000064$."
set quest[questID=80000550] manual "Examine flower balloons to get $item:30001195$"
set quest[questID=80000550] complete "Deliver $item:30001195$ to $npc:11004248$ in $map:02000064$"
set quest[questID=80000551] name "In Search of the Moon Rabbits"
set quest[questID=80000551] desc "$npc:11001002$ says the moon rabbits who suddenly left the mill have been \
    tainted by a strange energy and are appearing all over Maple World, and that the energy seems to come from a \
    secret space behind the full moon. Could the moon rabbits' change have something to do with that suspicious \
    place? Use $item:20301895$ to enter $map:80000016$, see what is going on there, and report to $npc:11004248$ \
    in $map:02000064$."
set quest[questID=80000551] manual "Enter $map:80000016$ and see what is going on"
set quest[questID=80000551] complete "Talk to $npc:11004248$ in $map:02000064$"
set quest[questID=80000552] name "Moon Rabbits Tainted by Darkness"
set quest[questID=80000552] desc "$npc:11004248$ says she has heard about the strange, huge rabbits appearing all \
    over Maple World, and that they seem to be the companions who left the Full Moon Mill. According to the moon \
    rabbit tribe's legend that her mother once told her, long ago some moon rabbits were tainted by a strange \
    energy and tore the mill apart. Only after they were subdued and drained of that energy did some of them come \
    to their senses. $npc:11004248$ sadly wishes to give her companions rest, even if it must be this way. In \
    place of the grieving girl, subdue the $npc:27000034$ that appears in $map:02000043$ and report the result to \
    $npc:11004248$.\n\n$npc:27000034$ appears in $map:02000043$ at 8:30 AM and at 2:30 PM, 7:30 PM, 8:30 PM, 9:30 \
    PM and 10:30 PM."
set quest[questID=80000552] manual "Subdue the $npc:27000034$ that appears in $map:02000043$"
set quest[questID=80000552] complete "Talk to $npc:11004248$ in $map:02000064$"
set quest[questID=80000553] name "Please Raise Pumpky!"
set quest[questID=80000553] desc "Raise the cute pumpkin demon Pumpky and get presents!"
set quest[questID=80000553] manual "Hear how to raise Pumpky"
set quest[questID=80000553] complete "Hear how to raise Pumpky"
set quest[questID=80000554] name "Make a Home for Pumpky"
set quest[questID=80000554] desc "Let's place $item:50400309$ in your home!\nYou can find $item:50400309$ by \
    pressing the 'Pumpkin Demon Pumpky' tab on the left of the 'Start Building' menu.\nIf you have already placed \
    one, remove it and place it again."
set quest[questID=80000554] manual "Place $item:50400309$ in your home"
set quest[questID=80000554] complete "Place $item:50400309$ in your home"
set quest[questID=80000555] name "Attack of the Giant Turkey"
set quest[questID=80000555] desc "Turkeys, doomed to end up on adventurers' tables every Thanksgiving, could take \
    no more and have attacked Maple World to ruin the holiday! Defeat the $npc:27000051$ that appeared in \
    $map:02000092$ and protect the people of Maple World!"
set quest[questID=80000555] manual "Defeat $npc:27000051$ in $map:02000092$"
set quest[questID=80000555] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000556] name "Shall We Roast a Tasty Turkey?"
set quest[questID=80000556] desc "Rumor has it that cooking $npc:27000051$ makes a delicacy beyond compare with \
    any ordinary turkey. $npc:11001002$ wants to serve a dish made from $npc:27000051$ to guests during \
    Thanksgiving. If you catch $npc:27000051$ for ten days and bring them to $npc:11001002$, there should be \
    enough to serve plenty of guests."
set quest[questID=80000556] manual "Complete the quest $quest:80000555$ 10 times"
set quest[questID=80000556] complete "Complete the quest $quest:80000555$ 10 times"
set quest[questID=80000560] name "Help the Lucky Piglets"
set quest[questID=80000560] desc "2019 is the Year of the Pig! Excited about the Year of the Pig, which comes only \
    once every 12 years, the lucky piglets bounced into Maple World, dreaming of a party. But the clueless little \
    piglets have come out where monsters are everywhere...!\nFree their tied-down feet and send them flying so \
    these frightened piglets can welcome the new year safely!"
set quest[questID=80000560] manual "Free the frightened lucky piglets all over Maple World and send them flying"
set quest[questID=80000560] complete "Talk to $npc:11001002$ in $map:02000064$"
