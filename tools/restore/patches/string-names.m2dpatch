set key[id=20001033] tooltipDescription "A poisonous mushroom grown by Mushking. It has a pretty color, but looks \
    dangerous somehow. It doesn't seem to affect your stats."
set key[id=20001033] guideDescription "Double-click it to use it. You will feel dizzy and be unable to move for a \
    moment."
set key[id=20001033] mainDescription "<font size='14'>20 Sec Cooldown</font>\\n<font size='24'>Eat Mushking's \
    Poison Mushroom</font>"
set key[id=20001694] tooltipDescription "An ancient potion said to have been drunk by the great warriors of \
    $map:02000051$. These days it is also made by alchemy from a mix of herbs. Drinking it <font \
    color='#00aaef'>increases Physical Attack by 4% for 60 min</font>. A special ingredient is added, so <font \
    color='#00aaef'>the effect does not wear off when you die.</font>"
set key[id=20001694] mainDescription "<font size='14'>1 Min Cooldown | Duration 60 Min</font>\\n<font \
    size='24'>Physical Attack Up</font>"
set key[id=20001695] tooltipDescription "A potion made by the mages of $map:02000023$ from refined herbs. These \
    days it is also made by alchemy from a mix of herbs. Drinking it <font color='#00aaef'>increases Magic Attack \
    by 4% for 60 min</font>. A special ingredient is added, so <font color='#00aaef'>the effect does not wear off \
    when you die.</font>"
set key[id=20001695] mainDescription "<font size='14'>1 Min Cooldown | Duration 60 Min</font>\\n<font \
    size='24'>Magic Attack Up</font>"
set key[id=20001759] tooltipDescription "A powerful potion made with new technology. You can drink it in one gulp, \
    so it works well. Drinking it <font color='#00aaef'>restores HP by 1600 instantly</font>. After one drink you \
    feel full, so you can drink again after 5 sec."
set key[id=20001759] mainDescription "<font size='14'>5 Sec Cooldown</font>\\n<font size='24'>Restores 1600 \
    HP</font>"
