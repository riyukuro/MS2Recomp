set key[id=1005215514001321] name "Hello, $MyPCName$!\nHave you ever run while listening to maple leaves rustling \
    in the wind?"
set key[id=1005215514001322] name "Feel the cool autumn wind and the crimson maple leaves, and <font \
    color=\"#ffd200\">run to your heart's content!</font>\nIt doesn't get better than this!"
set key[id=1005215514001323] name "Feel the cool autumn wind and the crimson maple leaves, and <font \
    color=\"#ffd200\">run to your heart's content!</font>\nIt doesn't get better than this!"
set key[id=1005215514001324] name "How was it?\nDon't your body and mind feel healthier?"
set key[id=1005215514001325] name "Hello, $MyPCName$!\nHere's one more way to enjoy the Maple Leaf Festival! "
set key[id=1005215514001326] name "<font color=\"#ffd200\">Jump</font> up toward that blue sky.\nIt'll feel so \
    refreshing, like your chest has been opened wide!"
set key[id=1005215514001327] name "<font color=\"#ffd200\">Jump</font> up toward that blue sky.\nIt'll feel so \
    refreshing, like your chest has been opened wide!"
set key[id=1005215514001328] name "How was it?\nDon't your body and mind feel healthier?"
set key[id=1005215514001329] name "Hello, $MyPCName$!\nThe Maple World has become even more beautiful for the \
    Maple Leaf Festival!"
set key[id=1005215514001330] name "Hop on a <font color=\"#ffd200\">mount</font> and go sightseeing around the \
    Maple World.\nThe beautiful scenery will lift your mood even more!"
set key[id=1005215514001331] name "Hop on a <font color=\"#ffd200\">mount</font> and go sightseeing around the \
    Maple World.\nThe beautiful scenery will lift your mood even more!"
set key[id=1005215514001332] name "How was it?\nWasn't it beautiful?"
set key[id=1005215514001333] name "Hello, $MyPCName$!\nHere's one more way to enjoy the Maple Leaf Festival! "
set key[id=1005215514001334] name "<font color=\"#ffd200\">Float up</font> toward that blue sky!\nIt'll feel so \
    refreshing, like your chest has been opened wide!"
set key[id=1005215514001335] name "<font color=\"#ffd200\">Float up</font> toward that blue sky!\nIt'll feel so \
    refreshing, like your chest has been opened wide!"
set key[id=1005215514001336] name "How was it?\nWasn't it refreshing?"
set key[id=1005215514001337] name "Hello, $MyPCName$!\nWhen autumn comes, don't you somehow want to dive right \
    into the blue sky?"
set key[id=1005215514001338] name "Ruby's recommended way to dive into the blue sky!\nSplash around and <font \
    color=\"#ffd200\">swim</font> in water as blue as the sky!"
set key[id=1005215514001339] name "Ruby's recommended way to dive into the blue sky!\nSplash around and <font \
    color=\"#ffd200\">swim</font> in water as blue as the sky!"
set key[id=1005215514001340] name "How was it?\nDon't your body and mind feel refreshed?"
set key[id=1018153214001345] name "Happy Halloween, $MyPCName$!\nHalloween pumpkins have come to the Maple World, \
    too!\nYou can find grinning Halloween pumpkins all over the Maple World.\n$MyPCName$, go and <font \
    color=\"#ffd200\">examine a Halloween pumpkin</font>, too!"
set key[id=1018153214001346] name "Happy Halloween, $MyPCName$!\nHalloween pumpkins have come to the Maple World, \
    too!\nYou can find grinning Halloween pumpkins all over the Maple World.\n$MyPCName$, go and <font \
    color=\"#ffd200\">examine a Halloween pumpkin</font>, too!"
set key[id=1018153214001347] name "Happy Halloween!\nHere's a Halloween gift I prepared for you, $MyPCName$."
set key[id=1031144214002886] name "$MyPCName$, have you ever seen the <font color=\"#ffd200\">Human Meret</font> \
    with the cute blue mushroom hair? \nWe're playing hide-and-seek, but I can't find where they're hiding at \
    all."
set key[id=1031144214002887] name "Please find the <font color=\"#ffd200\">Human Merets</font> hiding all over the \
    fields~\nThey're so small that they're hard to spot among the monsters, \nbut I'm sure you'll be good at \
    hide-and-seek too, $MyPCName$~"
set key[id=1031144214002888] name "Please find the <font color=\"#ffd200\">Human Merets</font> hiding all over the \
    fields~\nThey're so small that they're hard to spot among the monsters, \nbut I'm sure you'll be good at \
    hide-and-seek too, $MyPCName$~"
set key[id=1031144214002889] name "You found the Human Merets!\nOf course, there's nothing you can't do, \
    $MyPCName$~\nHere's a reward for finding the Human Merets! Make good use of it~"
set key[id=1102205414001348] name "Hello, $MyPCName$.\nHave you heard the news about the new changes coming to the \
    Maple World?"
set key[id=1102205414001349] name "(Say yes.)"
set key[id=1102205414001350] name "<font color=\"#ffd200\">Aliyar</font>, who leads the Allicari Merchant Society, \
    wanted to help adventurers one more time\nas they prepare for a new start, so he sent <font \
    color=\"#ffd200\">$item:20300544$</font>."
set key[id=1102205414001351] name "If you want the Allicari Merchant Society's <font color=\"#ffd200\">powerful \
    weapon</font>, talk to my twin brother, <font color=\"#ffd200\">$npcName:11001003[gender:0]$</font>."
set key[id=1102205414001352] name "If you want the Allicari Merchant Society's <font color=\"#ffd200\">powerful \
    weapon</font>, talk to my twin brother, <font color=\"#ffd200\">$npcName:11001003[gender:0]$</font>."
set key[id=1102205414001353] name "Welcome, $MyPCName$!"
set key[id=1102205414001354] name "I'm here to pick up the gift from the Allicari Merchant Society."
set key[id=1102205414001355] name "So you're here for the <font color=\"#ffd200\">Allicari Merchant Society's \
    gift</font>.\nTo get it, you once again have to answer <font color=\"#ffd200\">a question from the Allicari \
    Merchant Society</font>.\nHere comes the question!"
set key[id=1102205414001356] name "There's a black-market merchant named <font \
    color=\"#ffd200\">$npc:11001212[gender:0]$</font> who stowed away on an Allicari Merchant Society ship and ran \
    off.\nEven though it was his own fault, he often goes around badmouthing the Allicari Merchant Society.\nNow, \
    here's the question!\nWhich of these is <font color=\"#ffd200\">the place where the black-market merchant \
    Judaku is</font>?"
set key[id=1102205414001361] name "Yes, <font color=\"#ffd200\">$map:03000014$</font> is the correct answer!\nIf \
    you ever pass through $map:03000014$,\n$npc:11001179[gender:0]$ asked that you please speak kindly with \
    $npc:11001212[gender:0]$.\nHere's the gift the Allicari Merchant Society prepared!"
set key[id=1102205414001362] name "Sorry, wrong! That's not the answer!\nYou can easily find \
    $npc:11001212[gender:0]$'s location by searching for $npc:11001212[gender:0]$ on the world map or in \
    Mayview.\nWould you like to try again?"
set key[id=1102205414001363] name "(Say yes.)"
set key[id=1103175514001364] name "Hello, I'm $npc:11001002[gender:1]$!\nI've prepared a special event to help you \
    level up in a fantastic way!\nJust complete a few missions with me, Ruby, and the gifts will come pouring \
    in!\nIf you're ready, shall we begin?"
set key[id=1103175514001366] name "Today's Fantastic Warm-Up Mission is <font \
    color=\"#ffd200\">Running</font>.\nLimber up with a light run, then move on to the next mission!"
set key[id=1103175514001367] name "Today's Fantastic Warm-Up Mission is <font \
    color=\"#ffd200\">Running</font>.\nLimber up with a light run, then move on to the next mission!"
set key[id=1103175514001368] name "How was it? Your body feels a lot more relaxed, doesn't it?"
set key[id=1103175514001369] name "Hello, I'm $npc:11001002[gender:1]$!\nI've prepared a special event to help you \
    level up in a fantastic way!\nJust complete a few missions with me, Ruby, and the gifts will come pouring \
    in!\nIf you're ready, shall we begin?"
set key[id=1103175514001370] name "Today's Fantastic Warm-Up Mission is <font \
    color=\"#ffd200\">Jumping</font>.\nLimber up with a few light jumps, then move on to the next mission!"
set key[id=1103175514001371] name "Today's Fantastic Warm-Up Mission is <font \
    color=\"#ffd200\">Jumping</font>.\nLimber up with a few light jumps, then move on to the next mission!"
set key[id=1103175514001372] name "How was it? Your body feels a lot lighter, doesn't it?"
set key[id=1103175514001373] name "Hello, I'm $npc:11001002[gender:1]$!\nI've prepared a special event to help you \
    level up in a fantastic way!\nJust complete a few missions with me, Ruby, and the gifts will come pouring \
    in!\nIf you're ready, shall we begin?"
set key[id=1103175514001374] name "Today's Fantastic Warm-Up Mission is <font color=\"#ffd200\">Using the \
    $item:50400096$</font>.\nLimber up on the treadmill, then move on to the next mission!\nIf you don't have a \
    $item:50400096$, visit another adventurer's home!\nIt'd be nice to leave a thank-you message after your visit, \
    too, right?"
set key[id=1103175514001375] name "Today's Fantastic Warm-Up Mission is <font color=\"#ffd200\">Using the \
    $item:50400096$</font>.\nLimber up on the treadmill, then move on to the next mission!\nIf you don't have a \
    $item:50400096$, visit another adventurer's home!\nIt'd be nice to leave a thank-you message after your visit, \
    too, right?"
set key[id=1103175514001376] name "How was it? You feel a lot better now, don't you?"
set key[id=1103175514001377] name "The warm-up is over, so shall we start the real missions?"
set key[id=1103175514001378] name "Here's today's Fantastic Mission!\nTake on the various <font \
    color=\"#ffd200\">solo dungeons</font> around Maple World!"
set key[id=1103175514001379] name "Here's today's Fantastic Mission!\nTake on the various <font \
    color=\"#ffd200\">solo dungeons</font> around Maple World!"
set key[id=1103175514001380] name "I knew you could do it, $MyPCName$!\nCongratulations on clearing the Fantastic \
    Mission!"
set key[id=1103175514001381] name "The warm-up is over, so shall we start the real missions?"
set key[id=1103175514001382] name "Here's today's Fantastic Mission!\nJoin in the <font color=\"#ffd200\">various \
    events MC Kay has prepared</font>!"
set key[id=1103175514001383] name "Here's today's Fantastic Mission!\nJoin in the <font color=\"#ffd200\">various \
    events MC Kay has prepared</font>!"
set key[id=1103175514001384] name "I knew you could do it, $MyPCName$!\nCongratulations on clearing the Fantastic \
    Mission!"
set key[id=1103175514001385] name "The warm-up is over, so shall we start the real missions?"
set key[id=1103175514001386] name "Here's today's Fantastic Mission!\nTake on the <font color=\"#ffd200\">field \
    bosses of Maple World</font>!"
set key[id=1103175514001387] name "The field bosses of Maple World are\n<font \
    color=\"#ffd200\">$npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
    $npcName:23000019[gender:0]$, $npcName:23000054$, $npcName:23000020[gender:1]$, $npcName:23000035$, \
    \n$npcName:23000099$, $npcName:23000017$, $npcName:23000047$, $npcName:23000024[gender:1]$, \
    $npcName:23000034$, $npcName:23000045$,\n$npcName:23000057[gender:1]$, $npcName:23000026[gender:1]$, \
    $npcName:23000012$, $npcName:23000009[gender:0]$, $npcName:23000029$</font>!"
set key[id=1103175514001388] name "Here's today's Fantastic Mission!\nTake on the <font color=\"#ffd200\">field \
    bosses of Maple World</font>!"
set key[id=1103175514001389] name "I knew you could do it, $MyPCName$!\nCongratulations on clearing the Fantastic \
    Mission!"
set key[id=1103175514001390] name "A mission prepared for adventurers who cleared the Fantastic Missions with \
    flying colors!\nThis one won't be easy at all.\nBut I've prepared a special gift to match the dangerous \
    challenge, so give it a try!"
set key[id=1103175514001391] name "There are powerful dungeons all over Maple World.\nAmong them, the Chaos \
    Dungeons have a terrible reputation among adventurers!"
set key[id=1103175514001392] name "This is the final Fantastic Mission.\nSucceed against the strengthened bosses \
    of the <font color=\"#ffd200\">Chaos Dungeons</font>! \nThe Chaos Dungeons are in the Shadow Legion Altar, the \
    Moonlight Captain's Fortress, and the Ludibrium Clock Tower."
set key[id=1103175514001393] name "This is the final Fantastic Mission.\nSucceed against the bosses of the <font \
    color=\"#ffd200\">Chaos Dungeons</font>! \nThe Chaos Dungeons are in <font color=\"#ffd200\">the Shadow Legion \
    Altar, the Moonlight Captain's Fortress, and the Ludibrium Clock Tower</font>."
set key[id=1103175514001394] name "You even cleared the Fantastic Special Mission!\nYou really are the best, \
    $MyPCName$!"
set key[id=1108174312002113] name "Hmm... if you're that confident... give it a try!\nI'll set up a spot for you \
    to play here...\nBut first! There's a job I'd like you to do."
set key[id=1108174312002114] name "I'd like you to dig up <font color=\"#ffd200\">$item:33000001$</font> back here \
    and make <font color=\"#ffd200\">$item:33000063$</font>. \nI'm trying to make a new fishing rod, but I'm short \
    on materials.\nWill you help?"
set key[id=1108174312002115] name "Hahaha. I didn't mean to test you on purpose, but... \nshowing that much effort \
    is enough. I understand how you feel."
set key[id=1108174312002116] name "Now, find a comfortable spot and play for us.\nIf you can, play something that \
    really makes the fish gather, drunk on the music."
set key[id=1108174312002117] name "Now, find a comfortable spot and play for us.\nIf you can, play something that \
    really makes the fish gather, drunk on the music."
set key[id=1108174312002118] name "Aah... I've known nothing but fishing all my life and never cared about \
    music... \nBut your music... is truly beautiful! "
set key[id=1108174312002119] name "Just as you said, it seems more fish have gathered, drunk on your music.\nWhy \
    not enjoy a little fishing here yourself and relax for a while?"
set key[id=1108174312002120] name "If you don't have a fishing rod, buy one at my shop."
set key[id=1108174312002121] name "Hoho~ Let's see... did you catch a lot...\nGoodness~ I thought you were only \
    good at playing, but your fishing is first-rate too! Hohoho."
set key[id=1108174312002122] name "Roar! Roar!! \nI'm so mad, so mad!"
set key[id=1108174312002123] name "Roar! Roar!! \nI'm so mad, so mad!"
set key[id=1108174312002124] name "Roar! Roar! Dodging around and teasing me like that... \nI'm going to catch \
    every single fish in $map:02000001$ today!"
set key[id=1108174312002125] name "Hm? $MyPCName$! How long have you been here?"
set key[id=1108174312002126] name "When I succeed in making my new bait, I'll share some with you! \nSo hurry home \
    and look after your cluck-cluck chickens."
set key[id=1108174312002127] name "Huh? What's this, $MyPCName$! Coming now, of all times?\nYou took so long that \
    I just did it all myself. Tch.\nWell... since you're here, take the baits I don't need anymore. Ahahaha."
set key[id=1108174312002128] name "Well, since I gave it to you, I'll say it... \nthat thing... I think it's \
    useless bait that fish won't even eat when you hand it to them.\nI couldn't catch a single one!!"
set key[id=1108174312002129] name "If you catch even one fish at $map:02000001$ with that bait, then I'm not a \
    tiger,\nI'm a cat! Roar~!"
set key[id=1108174312002130] name "Wh... what... \nDid you really... catch all of them here?"
set key[id=1108174312002131] name "Tch... Hey... $MyPCName$!"
set key[id=1108174312002132] name "Did you set up $item:50200010$ in your house?\nNot yet? \nDo it quick~ Quick~"
set key[id=1108174312002133] name "Huh? You set up $item:50200010$ in your house? \nHeh heh heh~ I'll come visit \
    soon~ Heh heh~"
set key[id=1108174312002134] name "Aigo~ They say a festival will open at $map:02000064$ in a little while, and my \
    heart's already\npounding so much I can't sleep, ye know~\nOnce the festival starts, let's go see it together \
    at $map:02000064$~"
set key[id=1108174312002135] name "Aigo~ They say a festival will open at $map:02000064$ in a little while, and my \
    heart's already\npounding so much I can't sleep, ye know~\nOnce the festival starts, let's go see it together \
    at $map:02000064$~"
set key[id=1108174312002136] name "Welcome~ I'm Bunny-bunny Bunny Gal $npcName:11000711[gender:1]$~\nYou know a \
    festival is opening at $map:02000064$ soon, right? \nOur Bunny Gals are performing too, so don't miss it and \
    be sure to come watch!"
set key[id=1108174312002137] name "Hmm... but... what should I do... "
set key[id=1108174312002138] name "We need to decorate the performance stage, and I need quite a lot of \
    $item:30000002$ for materials.\nCould you help me out? Just having you with me would make me happy."
set key[id=1108174312002139] name "Wow~ I didn't think you'd help this hard.\nThanks to you, our Bunny Gals will \
    have even more strength preparing for the show!"
set key[id=1108174312002140] name "Um... by any chance...\ndo you know how to make <font \
    color=\"#ffd200\">$item:33000064$</font>?"
set key[id=1108174312002141] name "Could you make just one <font color=\"#ffd200\">$item:33000064$</font> for our \
    Bunny-bunny troupe?"
set key[id=1108174312002142] name "Thank you! I'll carve <font color=\"#ffd200\">$MyPCName$</font>'s name on it \
    and use it to decorate the stage!\nOh, and... this is a gift! Hehe. It comes from my heart!"
set key[id=1108174312002143] name "Well? Do you like the gift I gave you?\nIt's an instrument our Bunny-bunny \
    members use when practicing... I'll lend it to you for a few days! "
set key[id=1108174312002144] name "Are you using the Bunny-bunny practice instrument I lent you?\nTry playing it \
    whenever you're bored or have nothing to do."
set key[id=1108174312002145] name "<font color=\"#909090\">(Clapping so fast her arms nearly cramp)</font> Wow! \
    $MyPCName$! \nI think your playing is way better than our Bunny-bunny members'!"
set key[id=1108174312002146] name "$MyPCName$, with your skill, you could really perform on this stage\nlike \
    us!\n$MyPCName$, are your friends all this good at playing, too?"
set key[id=1108174312002147] name "Get together with other people and play.\nIt'll be a lot more fun."
set key[id=1108174312002148] name "Wonderful, wonderful! \n$MyPCName$, you and your friends are all just amazing!"
set key[id=1118030012002157] name "(Ask what's going on.)"
set key[id=1118030012002158] name "I'm trying to make a new fishing rod. Would you dig up some <font \
    color=\"#ffd200\">$item:33000001$</font> back here?\nOh, I'm not saying you must bring it... well, I only get \
    moved when you show some sincerity... \nWill you help?"
set key[id=1118030012002159] name "Drop by here from time to time, fish a bit, and play for us.\nSomehow, on a \
    clear day like today, I think I'll miss you."
set key[id=1118030012002160] name "Drop by here from time to time, fish a bit, and play for us.\nSomehow, on a \
    clear day like today, I think I'll miss you."
set key[id=1118030012002161] name "Ah, did you go and play at the $map:02000002$ fishing spot?"
set key[id=1118030012002162] name "(Nod.)"
set key[id=1118030012002163] name "Did you? How was it?\nDid people react well?"
set key[id=1118030012002164] name "Yes. I feel a lot more confident now."
set key[id=1118030012002165] name "Haha, that's wonderful.\nNext time, I hope you'll play in front of even more \
    people."
set key[id=1118030012002166] name "<font color=\"#909090\">(Open my mouth to explain why.)</font>"
set key[id=1118030012002167] name "Ah, never mind!\n$MyPCName$, do you happen to raise <font \
    color=\"#ffd200\">chickens</font> at home?"
set key[id=1118030012002168] name "I do raise chickens."
set key[id=1118030012002169] name "I don't raise any."
set key[id=1118030012002170] name "Really? Great! \nGo home and bring me some $item:33000026$ that your chickens \
    dropped, okay? "
set key[id=1118030012002171] name "What do you need it for?"
set key[id=1118030012002172] name "What?... Why aren't you raising even a single chicken in a perfectly good \
    house?\nTake this chance to get a few, raise them, and get some $item:33000026$ for me. \nLet me lean on a \
    friend who has a house...!!"
set key[id=1118030012002173] name "What are you going to use $item:33000026$ for?"
set key[id=1118030012002174] name "<font color=\"#ffd200\">Bait</font>!!\nI'm going to make a brand-new bait \
    nobody has ever seen before! \nOne that can sweep up all the fish in $map:02000001$ at once...!!"
set key[id=1118030012002175] name "It's not the bait. You just aren't good at fishing."
set key[id=1118030012002176] name "What? Hey! What did you just say?\nWhat's wrong with my fishing skills!! \nAnd \
    what about you? How good are you?"
set key[id=1118030012002177] name "If you catch even one fish at $map:02000001$, then I'm not a tiger,\nI'm a cat! \
    Meow~!"
set key[id=1118030012002178] name "(Nod and tease him, telling him to go on and say <font \
    color=\"#ffd200\">meow</font>.)"
set key[id=1118030012002179] name "Tch... No!! Hmph! Eat this and get lost!\nGo be a fishmonger or something!!"
set key[id=1118030012002180] name "Why did you call me?"
set key[id=1118030012002181] name "Are you going to spread the rumor...?"
set key[id=1118030012002182] name "<font color=\"#909090\">(Stare at him with a look that says I don't know what \
    you mean.)</font>"
set key[id=1118030012002183] name "About how I couldn't catch any fish... and said I'd be a cat... that... "
set key[id=1118030012002184] name "<font color=\"#909090\">(With a grin)</font> I won't tell anyone."
set key[id=1118030012002185] name "Really? You promise? Heh heh heh... Thanks... \nActually, that <font \
    color=\"#ffd200\">$item:50200010$</font> I gave you earlier... I really treasured it.\nPut it where you can \
    see it best in your house. So you'll always think of me. Roar-heh-heh."
set key[id=1118030012002186] name "That's a bit of a problem."
set key[id=1118030012002187] name "Sure."
set key[id=1118030012002188] name "Wh... why??? Are you ignoring my sincerity, or what?\nFriends don't do that! Is \
    that all our friendship is worth?\nIf you don't like it after setting it up, just take it out again. Tch! Are \
    you really going to be like this? "
set key[id=1118030012002189] name "Heh heh. Really?\nI'll come over to your place soon and check~ Heh heh heh~"
set key[id=1118030012002190] name "Is something bothering you?"
set key[id=1118030012002191] name "We need to decorate the performance stage, and I need quite a lot of \
    $item:30000002$ for materials.\nCould you help me out? Just having you with me would make me happy."
set key[id=1118030012002192] name "I do know how to make one."
set key[id=1118030012002193] name "Oh! Really? \nThen could you make just one for our Bunny-bunny troupe?"
set key[id=1118030012002194] name "Try playing it once in a while when you're bored.\nSomehow I feel like you'd be \
    good at playing, $MyPCName$. Hehehe."
set key[id=1118030012002195] name "(Say yes.)"
set key[id=1118030012002196] name "I don't have any friends."
set key[id=1118030012002197] name "Wow, then get together with some friends and play together.\nIt's way more fun \
    than playing alone! If you like, I'll lend you our stage, too!"
set key[id=1118030012002198] name "You... don't... have any? \nSob... that's such a sad story... Just a moment... \
    sob sob... \n<font color=\"#909090\">(She hangs her head low and seems to be crying.)</font>"
set key[id=1118030012002199] name "<font color=\"#909090\">(Lifting her sniffling face with sparkling \
    eyes)</font>\nBut! Music will make friends for you!\nGo up to people nearby who are holding instruments and \
    casually ask if they'd like to play together.\nTalk to them."
set key[id=1118030012002200] name "I bet nobody will say no!\nPlay together and friendship will bloom, love will \
    bloom... and loneliness runs far away!"
set key[id=1118030012002201] name "If you like, I'll lend you our stage, so play with other people and\nmake some \
    friends."
set key[id=1207231214001710] name "Welcome, $MyPCName$!\nTo celebrate the RESTART update, I've prepared a +12 \
    enchanted weapon for \nadventurers!"
set key[id=1207231214001711] name "I asked $npcName:11000508[gender:1]$ and $npcName:11000510[gender:1]$ for help \
    and somehow managed to make a +12 enchanted weapon, \nbut I rushed it, so it breaks and becomes useless after \
    30 days.\nIt's an unfinished weapon with a 30-day limit, but I'd be happy to \ngive it to you if you need it."
set key[id=1207231214001712] name "The Mystic Power Box can be moved to your other characters,\nbut the Mystic \
    weapon you get from the box becomes bound to that character. \n<font color=\"#ffd200\">It's a 30-day weapon, \
    but if you want the $item:20300589$ that holds a +12 enchanted weapon,\ntalk to me again!</font>"
set key[id=1207231214001713] name "The Mystic Power Box can be moved to your other characters,\nbut the Mystic \
    weapon you get from the box becomes bound to that character. \n<font color=\"#ffd200\">It's a 30-day weapon, \
    but if you want the $item:20300589$ that holds a +12 enchanted weapon,\ntalk to me again!</font>"
set key[id=1207231214001714] name "I'm so glad you want the $item:20300589$!\nI worked really hard on it.\nAnd my \
    twin brother $npcName:11001003[gender:0]$ says he has something prepared too, so don't be too disappointed!"
set key[id=1207231214001775] name "The biggest change in the RESTART update! \nNow you can learn various <font \
    color=\"#ffd200\">life skills</font> in Maple World, too! "
set key[id=1207231214001776] name "Try reaching <font color=\"#ffd200\">level 4 in both Jewelcrafting and \
    Smithing</font> among the life skills!\nI've prepared a sturdy ox, $item:50600155$, and \n$item:30000613$ as \
    rewards to keep you company in your life ahead, $MyPCName$!"
set key[id=1207231214001777] name "Try reaching <font color=\"#ffd200\">level 4 in both Jewelcrafting and \
    Smithing</font> among the life skills!\nI've prepared a sturdy ox, $item:50600155$, and \n$item:30000613$ as \
    rewards to keep you company in your life ahead, $MyPCName$!"
set key[id=1207231214001778] name "Congratulations on becoming a novice jewelcrafter and a novice \
    blacksmith!\nHere's the gift I promised!"
set key[id=1207231214001779] name "Hello, $MyPCName$!\nWelcome to Maple World, which has a fresh start with the \
    RESTART update!"
set key[id=1207231214001780] name "I've been converting the timed weapons my twin sister \
    $npcName:11001002[gender:1]$ prepared into permanent ones,\nbut I'm running very short on <font \
    color=\"#ffd200\">protection stones</font>, which preserve timed items permanently."
set key[id=1207231214001781] name "Please collect all three kinds, <font color=\"#ffd200\">$item:30000611$, \
    $item:30000612$, and $item:30000613$</font>, and bring them to me.\nYou can get $item:30000611$ through the \
    Mysterious Protection Stone pre-attendance check,\n$item:30000612$ by completing the 'A Brief Reflection on \
    Dungeons' quest,\nand $item:30000613$ by reaching level 4 in Jewelcrafting and Smithing."
set key[id=1207231214001782] name "Please collect all three kinds, <font color=\"#ffd200\">$item:30000611$, \
    $item:30000612$, and $item:30000613$</font>, and bring them to me.\nYou can get $item:30000611$ through the \
    Mysterious Protection Stone pre-attendance check,\n$item:30000612$ by completing the 'A Brief Reflection on \
    Dungeons' quest,\nand $item:30000613$ by reaching level 4 in Jewelcrafting and Smithing."
set key[id=1207231214001783] name "Wow! You collected them all!\nThis is the <font \
    color=\"#ffd200\">$item:20300590$</font> I made.\nThe <font color=\"#ffd200\">$item:20300590$</font> can also \
    be moved to your other characters,\nbut the Miracle weapon you get from the box becomes bound to that \
    character, so use it carefully."
set key[id=1208135514001784] name "A brief reflection on dungeons, with $npc:11001003[gender:0]$!\n\nWelcome, \
    $MyPCName$!\nThe RESTART update brought lots of changes to the dungeons, too."
set key[id=1208135514001785] name "Take on $map:02000380$ or one of the other level 50 adventure dungeons.\nThey \
    are tough dungeons, it's true,\nbut I believe that with a little effort, you can clear one, $MyPCName$!"
set key[id=1208135514001786] name "Take on $map:02000380$ or one of the other level 50 adventure dungeons.\nThey \
    are tough dungeons, it's true,\nbut I believe that with a little effort, you can clear one, $MyPCName$!"
set key[id=1208135514001787] name "That's you, $MyPCName$. You cleared it very cleanly!"
set key[id=1214182514001864] name "Welcome, $MyPCName$!\nI'm giving out a gift Santa Peachy prepared for \
    adventurers who clear an adventure dungeon \nduring the event: the $item:20300598$."
set key[id=1214182514001865] name "When you're ready, <font color=\"#ffd200\">take on $map:02000380$ or one of the \
    other level 50 adventure dungeons</font>.\nIf you also accept the 'A Brief Reflection on Dungeons' quest from \
    my brother \n$npcName:11001003[gender:0]$ next to me, that's killing two birds with one stone!\nGood luck!"
set key[id=1214182514001866] name "When you're ready, <font color=\"#ffd200\">take on $map:02000380$ or one of the \
    other level 50 adventure dungeons</font>.\nIf you also accept the 'A Brief Reflection on Dungeons' quest from \
    my brother \n$npcName:11001003[gender:0]$ next to me, that's killing two birds with one stone!\nGood luck!"
set key[id=1214182514001867] name "I knew you could do it, $MyPCName$! \nHere's the $item:20300598$.\nWhich gift \
    will you choose, $MyPCName$?"
set key[id=1219144014002898] name "Merry Christmas, $MyPCName$!\nFor the merry Christmas season, they say Papa \
    Santa has planted a special \nChristmas tree somewhere in Maple World."
set key[id=1219144014002899] name "Where can I find the special Christmas tree?"
set key[id=1219144014002900] name "Open the <font color=\"#ffd200\">Meret Market</font> and go to the <font \
    color=\"#ffd200\">Special Sale</font> tab, and you can buy <font color=\"#ffd200\">Papa Santa's Christmas \
    Tree</font> for free.\nUse that item and you can enter the place where <font \
    color=\"#ffd200\">$map:80000011$</font> is!"
set key[id=1219144014002901] name "Oops... In the <font color=\"#ffd200\">Special Sale</font> tab, you can buy the \
    <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> up to 3 times a day per account.\nAnd when other \
    friends use their <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> to move to where <font \
    color=\"#ffd200\">$map:80000011$</font> is, you can come along with them too."
set key[id=1219144014002902] name "Now enjoy a merry and happy Christmas season \nwith Papa Santa's special \
    Christmas tree!"
set key[id=1219144014002903] name "Open the <font color=\"#ffd200\">Meret Market</font> and go to the <font \
    color=\"#ffd200\">Special Sale</font> tab, and you can buy <font color=\"#ffd200\">Papa Santa's Christmas \
    Tree</font> for free.\nUse that item and you can enter the place where <font \
    color=\"#ffd200\">$map:80000011$</font> is!"
set key[id=1219144014002904] name "Oops... In the <font color=\"#ffd200\">Special Sale</font> tab, you can buy the \
    <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> up to 3 times a day per account.\nAnd when other \
    friends use their <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> to move to where <font \
    color=\"#ffd200\">$map:80000011$</font> is, you can come along with them too."
set key[id=1219144014002905] name "You found Papa Santa's special Christmas tree!\nUntil the Christmas season \
    ends, diligently collect $item:20301210$ and get special Christmas gifts!"
set key[id=12863304868290363479] name "Haven't you changed jobs yet? You don't even know what a <font \
    color=\"#ffd200\">Lapenshard</font> is, do you?"
set key[id=12863304868290363480] name "Haven't you changed jobs yet? You don't even know what a <font \
    color=\"#ffd200\">Lapenshard</font> is, do you?"
set key[id=12863304868290363481] name "You'll learn about <font color=\"#ffd200\">Lapenshards</font> from Lanemone \
    at the Frontier Foundation after your 2nd job advancement. For now, let me give you a Lapenshard so you can \
    use it."

# Quest dialogue of the no-feature chapters 8129-10002 quests that no pack has in English (no feature tag): our own
# English for the 1026 scriptquest rows of locale KR (or no locale) whose quest a player can get (124 quests), with
# each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=106040402004810] name "Hah... I was waiting for you."
set key[id=106040402004811] name "Hmm... first of all, $npcName:11000735[gender:1]$ needs to regain her \
    strength.\n$MyPCName$, I'd like you to go to the Empress, report the situation, and find out if there's any \
    way to \nheal $npcName:11000735[gender:1]$."
set key[id=106040402004812] name "Ah, $MyPCName$.\nI was just about to contact you... Not long ago, an \
    unprecedented strong aura of light \nbegan to be felt from the direction of the <font color=\"#ffd200\">Nazkar \
    Temple</font>.\nSo I checked through $npcTitle:11000076[gender:0]$, and <font \
    color=\"#ffd200\">$map:52010007$</font> had opened."
set key[id=106040402004813] name "Has $npcName:11000735[gender:1]$ recovered a bit?\nIt seems \
    $npcName:11000735[gender:1]$ and the Dragon Knights should go to the Nazkar Temple themselves and \
    \ninvestigate $map:52010007$ together... "
set key[id=106040402004814] name "$MyPCName$. \nGo straight to $npcName:11001216[gender:0]$ and tell them to bring \
    $npcName:11000735[gender:1]$ to <font color=\"#ffd200\">$map:52010007$</font> in <font \
    color=\"#ffd200\">$map:02010034$</font>.\nI'll head there right away too."
set key[id=106040402004815] name "Are you coming from the embassy?\nDid you see the Empress?"
set key[id=106040402004816] name "You said the entrance to <font color=\"#ffd200\">$map:52010007$</font> is in \
    <font color=\"#ffd200\">$map:02010034$</font>, right?\nI'll go straight there, taking \
    $npcName:11000735[gender:1]$ along with $npcName:11001217[gender:0]$ and $npcName:11001218[gender:1]$.\nYou'll \
    come there too, right?"
set key[id=106040402004817] name "You said the entrance to <font color=\"#ffd200\">$map:52010007$</font> is in \
    <font color=\"#ffd200\">$map:02010034$</font>, right?\nI'll go straight there, taking \
    $npcName:11000735[gender:1]$ along with $npcName:11001217[gender:0]$ and $npcName:11001218[gender:1]$.\nYou'll \
    come there too, right?"
set key[id=106040402004818] name "You've come. $npcName:11000735[gender:1]$ and the Dragon Knights arrived one \
    step ahead.\n$npcName:11000735[gender:1]$ isn't recovering her strength easily... "
set key[id=106040402004819] name "As I told you before coming here, <font color=\"#ffd200\">$map:52010007$</font> \
    suddenly opened because the power of light hidden \ndeep within the Nazkar Temple reacted to something.\nIf my \
    hunch is right... the <font color=\"#ffd200\">Lamestone</font> that $npcName:11000735[gender:1]$ lost... and \
    the sanctuary of light, <font color=\"#ffd200\">Lubelisk</font>... \nthose two powers of light must have \
    harmonized."
set key[id=106040402004820] name "The monsters occupying the Nazkar Temple together with the deep darkness... \
    \nIt's most likely that one of them has the Nazkar map."
set key[id=106040402004821] name "You're back!\nDid you find the map...?"
set key[id=106040402004822] name "If $npcName:11001216[gender:0]$, $npcName:11001217[gender:0]$ and \
    $npcName:11001218[gender:1]$ could find the rest of the torn map... \nif only they could... we'd be able to \
    find <font color=\"#ffd200\">$map:02010055$</font>... "
set key[id=106040402004823] name "If $npcName:11001216[gender:0]$, $npcName:11001217[gender:0]$ and \
    $npcName:11001218[gender:1]$ could find the rest of the torn map... \nif only they could... we'd be able to \
    find <font color=\"#ffd200\">$map:02010055$</font>... "
set key[id=106040402004824] name "Oh la la... who... who are you again, mi?"
set key[id=106040402004825] name "Something super scary seems to be happening in there, though I don't know what, \
    mi... \nIt's scary, mi... they zoomed right in before I could even stop them...\nAre they your friends, \
    miyung?"
set key[id=106040402004826] name "You have to help your friends, mi... \nYou can't run away and abandon them just \
    because it's scary, miyung... "
set key[id=106040402004827] name "You came back alive, mi!! I was worried, miyung... sob... Did you meet your \
    friends?\nYour friends came out earlier and dashed off to the front again, miyung... "
set key[id=106040402004828] name "Do you know where your friends went, miyung?\nThe chubby friend said they had to \
    go to the Empress, mi... Hurry and go see, miyung... "
set key[id=106040402004829] name "Do you know where your friends went, miyung?\nThe chubby friend said they had to \
    go to the Empress, mi... Hurry and go see, miyung... "
set key[id=106040402004830] name "Now that $npcName:11000735[gender:1]$ has recovered the <font \
    color=\"#ffd200\">Lamestone</font>, the Shadow Poison will gradually be purified by the power of light.\nOnce \
    $npcName:11000735[gender:1]$ recovers her body and regains the power of light she originally had, with \
    $npcName:11000735[gender:1]$'s strength\nshe should be able to open the <font color=\"#ffd200\">Sanctuary of \
    Light</font> again."
set key[id=106040402004831] name "Hmm... hmm... my grandfather... has been having nightmares every day lately.\nHe \
    must have gotten so weak... sob... "
set key[id=106040402004832] name "It's so scary... and unsettling... I feel like I'll start having nightmares \
    too... \n$MyPCName$, could you find out whether something has really \nhappened inside that temple?"
set key[id=106040402004833] name "Aaah... it's really scary here, mi... \nHow did you get all the way to the deep, \
    dark part of the temple, miyung...?"
set key[id=106040402004834] name "Actually... that door you see in front here, mi... \nit seems to lead \
    somewhere... but I have a bad feeling, miyung... \nI've been watching here the whole time... and it seems \
    there's something inside, miyung... \nIf you have the courage... will you go in and find out, miyung?"
set key[id=106040402004835] name "Actually... that door you see in front here, mi... \nit seems to lead \
    somewhere... but I have a bad feeling, miyung... \nI've been watching here the whole time... and it seems \
    there's something inside, miyung... \nIf you have the courage... will you go in and find out, miyung?"
set key[id=106040402004836] name "Eek! So glad to see you, miyung!\nYou got out safely, miyung! Did you see what \
    happened... inside?"
set key[id=107032902004837] name "(Ask how $npc:11000735[gender:1]$ is doing.)"
set key[id=107032902004838] name "Hmm... not good.\nWhen she came out of $map:52010006$, she didn't look badly \
    hurt or ill... \nbut as time passes, her strength keeps getting weaker.\nI think she's been poisoned by the \
    Shadow Poison."
set key[id=107032902004839] name "On top of that... the <font color=\"#ffd200\">Lamestone</font> is gone too... \
    \nIt must have been when she went to $map:52010006$... $npcName:11001224[gender:0]$... that guy seems to have \
    taken it \nwhile $npcName:11000735[gender:1]$ was bound."
set key[id=107032902004840] name "(Ask what to do now.)"
set key[id=107032902004841] name "Hmm... first of all, $npcName:11000735[gender:1]$ needs to regain her \
    strength.\n$MyPCName$, I'd like you to go to the Empress, report the situation, and find out if there's any \
    way to \nheal $npcName:11000735[gender:1]$."
set key[id=107032902004842] name "(Ask what $map:52010007$ is.)"
set key[id=107032902004843] name "I heard it was where the ancient Lumieragons fully realized their innate power \
    of light \nand performed the sacred ritual to be reborn as true <font color=\"#ffd200\">Heirs of \
    Light</font>.\nAfter the Lumieragons vanished, even the entrance of <font \
    color=\"#ffd200\">$map:52010007$</font> could not be found... \nbut we found that entrance in <font \
    color=\"#ffd200\">$map:02010034$</font>."
set key[id=107032902004844] name "That <font color=\"#ffd200\">$map:52010007$</font> has opened again must mean \
    that the power of light hidden in darkness \nreacted to something... It seems some change has taken place \
    inside the Nazkar Temple."
set key[id=107032902004845] name "(Tell about $npcName:11000735[gender:1]$ and the Lamestone.)"
set key[id=107032902004846] name "What? $npcName:11000735[gender:1]$ is...? \nAhh... it must be because the Shadow \
    Poison is spreading faster without the <font color=\"#ffd200\">Lamestone</font>.\nIt's not complete yet, but \
    what sustains $npcName:11000735[gender:1]$ is the power of light... \nand now that power is fading away."
set key[id=107032902004847] name "To let $npcName:11000735[gender:1]$ keep the remaining power of light until we \
    recover the <font color=\"#ffd200\">Lamestone</font>,\nwe should take $npcName:11000735[gender:1]$ straight to \
    <font color=\"#ffd200\">$map:52010007$</font>.\nIt's only a stopgap... but right now there's nowhere the power \
    of light remains as strong \nas there."
set key[id=107032902004848] name "$MyPCName$. \nGo straight to $npcName:11001216[gender:0]$ and tell them to bring \
    $npcName:11000735[gender:1]$ to <font color=\"#ffd200\">$map:52010007$</font> in <font \
    color=\"#ffd200\">$map:02010034$</font>.\nI'll head there right away too."
set key[id=107032902004849] name "(Pass on $npc:11000075[gender:1]$'s words.)"
set key[id=107032902004850] name "<font color=\"#ffd200\">$map:52010007$</font>?\nHmm... right... I think I heard \
    of it once. That it would open... "
set key[id=107032902004851] name "(Ask what $map:02010055$ is.)"
set key[id=107032902004852] name "It's a sanctuary of light where the elders of the ancient Lumieragons gathered \
    to harmonize light.\nLike <font color=\"#ffd200\">$map:52010007$</font>, <font \
    color=\"#ffd200\">$map:02010055$</font> is said to have been buried in the abyss of deep darkness \nwhen the \
    Lumieragons vanished."
set key[id=107032902004853] name "Before the Lumieragons left for Drakenheim in the past, they left these words. \
    \n<font color=\"#ffd200\">Light and light call to each other, and a brighter light will illuminate the \
    darkness of the world...</font>\nIn the thick darkness enveloping the whole Nazkar Temple, <font \
    color=\"#ffd200\">$map:02010055$</font>, the <font color=\"#ffd200\">Lamestone</font>, and\n<font \
    color=\"#ffd200\">$map:52010007$</font> each did not shine brightly enough to pierce the darkness while \
    apart... \nbut meeting one another, they become a greater light and find yet another light."
set key[id=107032902004854] name "The <font color=\"#ffd200\">Lamestone</font> must be inside <font \
    color=\"#ffd200\">$map:02010055$</font>, somewhere in the Nazkar Temple.\nWhat worries me... is that the power \
    of light illuminating the temple right now is very unstable.\nA light of chaos and confusion... that means \
    some strong being \nis threatening the power of light that remains here."
set key[id=107032902004855] name "Right now, recovering the <font color=\"#ffd200\">Lamestone</font> is the most \
    urgent matter for the Lumieragons, of course,\nand for $npcName:11000735[gender:1]$ and for us. \nThe Dragon \
    Knights went to look for the Nazkar Temple map to find the location of <font \
    color=\"#ffd200\">$map:02010055$</font>, \nwhere the <font color=\"#ffd200\">Lamestone</font> is. $MyPCName$, \
    please lend your strength too."
set key[id=107032902004856] name "(Ask where to find the Nazkar Temple map.)"
set key[id=107032902004857] name "The monsters occupying the Nazkar Temple together with the deep darkness... \
    \nIt's most likely that one of them has this map."
set key[id=107032902004858] name "(Hand over $item:30000513$.)"
set key[id=107032902004859] name "Oh no... it's torn... \nI wonder if we can find <font \
    color=\"#ffd200\">$map:02010055$</font> with this... "
set key[id=107032902004860] name "(Ask if $npcName:11001216[gender:0]$, $npcName:11001217[gender:0]$ and \
    $npcName:11001218[gender:1]$ were seen nearby.)"
set key[id=107032902004861] name "Ah... I saw them, mi!!\nThey went through the door right in front like \
    lightning, miyung! I thought they were ghosts, mi!"
set key[id=107032902004862] name "(Say yes.)"
set key[id=107032902004863] name "Then... you have to help your friends, mi... \nYou can't run away and abandon \
    them just because it's scary, miyung... "
set key[id=107032902004864] name "And... if the fate of light is guiding $npcName:11000735[gender:1]$... \nI hope \
    that just like the ancient Lumieragons, she too can be reborn as a true <font color=\"#ffd200\">Heir of \
    Light</font> \nin <font color=\"#ffd200\">$map:52010007$</font>... "
set key[id=107032902004865] name "Let's wait for the day $npcName:11000735[gender:1]$ regains her strength and the \
    power of light as soon as possible.\nMay the light of the Lumieragons watch over her...!"
set key[id=107032902004866] name "(Ask what nightmares he has.)"
set key[id=107032902004867] name "Um... they say the Nazkar Temple crumbles down with a rumble... crash... and in \
    its place \na huge black whirlwind rages... \nand inside it, a huge black dragon spreads its wings wide... "
set key[id=107032902004868] name "The Nazkar Temple was a sacred temple of the golden dragons ages and ages \
    ago...\nSurely something terrible like in my grandfather's dream won't really happen, right?\nNo... but what \
    if a black dragon really is opening its eyes deep in that temple?"
set key[id=107032902004870] name "It's so scary... and unsettling... I feel like I'll start having nightmares \
    too... \n$MyPCName$, could you find out whether something has really \nhappened inside that temple?"
set key[id=107032902004871] name "(Tell $npcName:11001215[gender:1]$'s story.)"
set key[id=107032902004872] name "Aaah... that dream... seems half right, and half not... \nI don't know, \
    miyung... "
set key[id=107032902004873] name "(Tell him that Kargon of the darkness is after the Lamestone.)"
set key[id=107032902004874] name "The <font color=\"#ffd200\">Lamestone</font>? The stone of light... I think I've \
    heard of it, miyung! \nThose guys called Kargon are after it, miyung? Uwaaah... \nThat's urgent information, \
    miyung!! I have to tell my comrades the moment they come looking for me, miyung!"
set key[id=107032902004875] name "The Moropapa Tribe has to know too, miyung! \nOne of our scouts will pass it on \
    to $npcName:11001215[gender:1]$ as well, miyung...!"
set key[id=115110302004876] name "$MyPCName$! News just came in from $npcName:11001216[gender:0]$'s \
    group.\n$npcName:11000735[gender:1]$ woke up and is heading to <font color=\"#ffd200\">$map:52010017$</font> \
    to find the ancient Lumieragon holy stones,\nand says she'll come to $map:52010007$ as soon as she finds \
    them.\n"
set key[id=115110302004877] name "Ah, they say the entrance leading to <font \
    color=\"#ffd200\">$map:52010017$</font> is also near the $map:02010055$ entrance in \n<font \
    color=\"#ffd200\">$map:02010029$</font>. Hurry there and look around carefully!"
set key[id=115110302004878] name "Oh! $MyPCName$!\nDid the Empress send you?"
set key[id=115110302004879] name "The strength that the Dragon Knights and I have might not be enough.\nHelp us \
    too!"
set key[id=115110302004880] name "The strength that the Dragon Knights and I have might not be enough.\nHelp us \
    too!"
set key[id=115110302004881] name "$MyPCName$!\nWhy did you come back alone? What about \
    $npcName:11000735[gender:1]$ and her friends...?"
set key[id=115110302004882] name "Wait here with me... Ah! There they are now!"
set key[id=115110302004883] name "Wait here with me... Ah! There they are now!"
set key[id=115110302004884] name "<font color=\"#ffd200\">Before the path guided by the Successor of Light, your \
    existence too shall become light...</font>\nI... think I understand now. The meaning of these words \
    $npcName:11001216[gender:0]$ and my friends always recited out of habit... \nAnd now I think I can do it. \nMy \
    fate as the Successor of Light, who must sweep away the darkness... "
set key[id=115110302004885] name "Thank you so much for helping me get this far.\nYou... the Empress... and my \
    friends... $npcName:11001216[gender:0]$, $npcName:11001217[gender:0]$, $npcName:11001218[gender:1]$...!\nNow I \
    have to go back to <font color=\"#ffd200\">Drakenheim</font>, wake my mother, and save the Lumieragons."
set key[id=115110302004886] name "Someday, when a star shining huge and bright rises in that sky... I'll come \
    back.\nThe day Drakenheim shines brightly! Wait for me."
set key[id=115110302004887] name "Long ago... the day $npcName:11000735[gender:1]$'s mother Leila left for \
    Drakenheim with Lamestone\ncomes back to me... \nThe back of $npcName:11000735[gender:1]$ as she turns and \
    walks away looks so much like Leila that day.\nAfter so many hardships, a true <font color=\"#ffd200\">Heir of \
    Light</font> has been born... I believe the darkness of Drakenheim \nand Lumieragon will soon vanish too."
set key[id=120234902004888] name "I'll deliver the news to the Empress, so you should follow \
    $npcName:11000735[gender:1]$'s group and help \n$npcName:11000735[gender:1]$ and her friends recover the \
    ancient Lumieragon holy stones safely.\nEven if $npcName:23000068[gender:0]$ has vanished... \n$map:02010055$ \
    and the secret passages leading there still have Kargon's henchmen, so \ndanger must still lurk."
set key[id=120234902004889] name "Ah, they say the entrance leading to <font \
    color=\"#ffd200\">$map:52010017$</font> is also near the $map:02010055$ entrance in \n<font \
    color=\"#ffd200\">$map:02010029$</font>. Hurry there and look around carefully!"
set key[id=120234902004890] name "(Say you heard the news from $npcName:11000076[gender:0]$.)"
set key[id=120234902004891] name "Oh, so that's how it was!\nWhen I was dazed from the Shadow Poison, I heard my \
    mother's voice.\nShe told me to find the ancient Lumieragon holy stone sealed in <font \
    color=\"#ffd200\">$map:02010055$</font>... the <font color=\"#ffd200\">Shard of Light</font>... \nand that it \
    would open the way to finding my destiny!"
set key[id=120234902004892] name "I haven't fully recovered my power of light yet.\nI have to find the <font \
    color=\"#ffd200\">Shard of Light</font> and get out before the vanished $npcName:23000068[gender:0]$ comes \
    back! "
set key[id=120234902004893] name "(Say all you remember is $npcName:11000735[gender:1]$ saying she'd open the path \
    of light.)"
set key[id=120234902004894] name "$npcName:11000735[gender:1]$ opened the path of light...?\nThen that means they \
    found all the ancient Lumieragon holy stones! Right?"
set key[id=120234902004895] name "(Say yes.)"
set key[id=120234902004896] name "Ahh~ what a relief.\nIt seems $npcName:11000735[gender:1]$ opened the path of \
    light before she could fully control \nthe power dwelling in the holy stones. \nBecause of that, the paths of \
    light seem to have led each of you to different places... "
set key[id=120234902004897] name "Seeing you return safely like this, $MyPCName$, $npcName:11000735[gender:1]$ and \
    her friends \nmust be fine too."
set key[id=120234902004898] name "What I must do as an Heir of Light, the path I must walk... \nIt's all become \
    clear to me at last!"
set key[id=120234902004899] name "I'll help."
set key[id=120234902004900] name "(Say goodbye.)"
set key[id=120234902004901] name "No... your help ends here...! From now on, I have to do it myself. \nOnly a \
    Lumieragon can sweep away the darkness covering the Lumieragons.\nWith the power of light I hold, I'll restore \
    Drakenheim to what it was."
set key[id=120234902004902] name "(Ask if you won't see her again.)"
set key[id=120234902004903] name "Someday, when a star shining huge and bright rises in that sky... I'll come \
    back.\nThe day Drakenheim shines brightly! Wait for me."
set key[id=120234902004904] name "Ah... um... I thought you'd be at least a little sad, though... \nI... I'm \
    flustered... \nOh well... this isn't the last time! No need to cry and make a cliched fuss... "
set key[id=120234902004905] name "When Drakenheim has regained its bright light, I'll come back.\nThen let's eat \
    and play at $map:02010053$ until our bellies burst! Okay?"
set key[id=120234902004906] name "You, $MyPCName$, and the Dragon Knights... everyone worked so hard.\nSomeday... \
    may the bright light of the Lumieragons sweep away even the darkness of the Shadow World...!"
set key[id=304143915000070] name "$MyPCName$, you look just like a magician.\nI couldn't just walk past you, so I \
    called you over!"
set key[id=304143915000071] name "Poof! Ta-da! Appearing and vanishing,\na wonderful magician like that is, I \
    think,\nonly a matter of time from becoming a star of Maple World!"
set key[id=304143915000072] name "If you debut as a magician, $MyPCName$,\nCodea will definitely come to watch, so \
    please give me the chance to be a magician's \nwonderful assistant!"
set key[id=304143915000073] name "It looks like you're still a li~~ttle short of completing the Illusionist skin \
    set!"
set key[id=304143915000074] name "I prepared this because I thought\ntime must be very precious to you, \
    $MyPCName$, a future magician!"
set key[id=316160602005006] name "Over the~re, $npc:11001309[gender:0]$ was looking for you!"
set key[id=316160602005007] name "Over the~re, $npc:11001309[gender:0]$ was looking for you!"
set key[id=316160602005008] name "Ah!! Right on time!"
set key[id=316160602005021] name "$npcTitle:11000076[gender:0]$ is looking for you.\nPlease head to the embassy."
set key[id=316160602005022] name "$npcTitle:11000076[gender:0]$ is looking for you.\nPlease head to the embassy."
set key[id=316160602005023] name "You're here."
set key[id=417214414003171] name "Hey, $MyPCName$, this weekend is your last chance to see <font \
    color=\"#ffd200\">Mushking</font>. \nYou've kind of grown fond of him by now, haven't you? Feeling a little \
    sad? \nSure, <font color=\"#ffd200\">Mushking</font> is fat and greedy and has a rotten temper, but... "
set key[id=417214414003172] name "I have a mission for you this weekend!\nIt's your very last one at \
    $map:02000423$. \nYou're going to jump and stomp so hard that $map:02000423$ nearly caves in. \nJust enough to \
    give <font color=\"#ffd200\">Mushking</font> a real fright."
set key[id=417214414003173] name "If <font color=\"#ffd200\">Mushking</font> gets startled and falls on his back, \
    do you think the palanquin bearers will help him up?\nPoor bearers... I hope <font \
    color=\"#ffd200\">Mushking</font> comes to his senses and treats the other mushrooms a little better.\nJump 15 \
    times at $map:02000423$ and come back, and I'll give you a gift."
set key[id=417214414003174] name "You look a bit tired. Breathing in mushroom spores and jumping at $map:02000423$ \
    must have worn you out.\nYou did great. Please accept my gift."
set key[id=501054114003197] name "$MyPCName$, thank you so much for coming to help defeat <font \
    color=\"#ffd200\">Mushking</font>!\nBy any chance, are you running low on <font \
    color=\"#00a2ed\">$item:20301428$</font>?\nIf you do a few favors for me... I'll give you some."
set key[id=501054114003198] name "I worked hard to get this <font color=\"#00a2ed\">$item:20301428$</font>, so \
    just handing it over... feels a little wasteful."
set key[id=501054114003199] name "Wow~ You did all my favors!!\nHere, your <font \
    color=\"#00a2ed\">$item:20301428$</font>.\nIt's not much, but I'll also give you the <font \
    color=\"#ffd200\">$item:30001124$</font> I've been collecting.\nPlease keep helping us defeat <font \
    color=\"#ffd200\">Mushking</font>!"
set key[id=501054114003200] name "$MyPCName$, have you heard of $map:02000423$?\n$map:02000423$ is the closest \
    place to $map:82000012$, where <font color=\"#ffd200\">Mushking</font> rules.\nThat's why it keeps getting \
    raided by Mushking.\n<font color=\"#ffd200\">Mushking</font> is a scary fellow who takes adventurers away and \
    makes them fight each other.\n"
set key[id=501054114003201] name "His <font color=\"#00a2ed\">spores</font> are so powerful that you can't even \
    get near him \nwithout a special cream called <font color=\"#00a2ed\">Spore Block Cream</font>.\nOn top of \
    that, even if you defeat him once, he comes back to life! Even stronger than before!\nMy request may be \
    unreasonable, but... \nplease help us defeat <font color=\"#ffd200\">Mushking</font> for the peace of Maple \
    World!"
set key[id=501054114003202] name "Even a tiny bit of damage to <font color=\"#ffd200\">Mushking</font> would be a \
    huge help.\nI'll say it once more: when he raids, before you go down the stairs, \nmake SURE!!!! you've put on \
    <font color=\"#00a2ed\">Spore Block Cream</font>.\nIf you take <font color=\"#ffd200\">Mushking</font>'s <font \
    color=\"#00a2ed\">spores</font> lightly, you'll learn the hard way."
set key[id=501054114003203] name "As thanks, I'll reward you with <font \
    color=\"#00a2ed\">$item:20301428$</font>.\nIf you bring me <font color=\"#ffd200\">$item:30001124$</font>,\nI \
    can also <font color=\"#ffd200\">exchange</font> it for other useful things."
set key[id=503202214003204] name "Wow~ $MyPCName$! Have you heard of the Rainbow Slime?\nIt's different from a \
    regular slime! It looks similar, but rainbow colors shimmer across its body, it has wings, and... anyway, it's \
    very different~"
set key[id=503202214003205] name "Oh my, why am I suddenly talking about Rainbow Slimes, you ask?\nI found an \
    adorable Rainbow Slime not long ago, and I thought I'd leave it with someone who's interested! Hehehe.\nA \
    Rainbow Slime is one color when it's young, but as it grows it changes into beautiful rainbow colors~ Of \
    course, not as beautiful as me~ Hehehehe."
set key[id=503202214003206] name "Don't forget, Rainbow Slimes are picky eaters and only eat special \
    food~\nDepending on your time in Maple World, you can get up to 4 servings of food a day, and if you visit \
    other homes and play with their Rainbow Slimes, you'll get up to 2 extra servings a day, so food shouldn't be \
    hard to find!\n"
set key[id=503202214003207] name "Set up a Rainbow Slime nest in your home and raise your Rainbow Slime~\nDon't \
    get so lost thinking about me that you forget to feed it~! Hehehe."
set key[id=516194314003224] name "Set up the $item:50400282$ I gave you in your home~\nIt's still green, but with \
    $MyPCName$'s love, it'll grow up big and turn a beautiful rainbow color~!"
set key[id=516194314003225] name "Please set up the $item:50400282$ in your home.\nYou'll see how cute and pretty \
    $npc:50400282$ is!"
set key[id=516194314003226] name "Here, I'll give you $item:20301497$. Don't just keep staring at me because I'm \
    pretty. Hurry and feed hungry $npc:50400282$~! Hehehe."
set key[id=523134314003227] name "Hello, $MyPCName$!\nCollect the letters <font \
    color=\"#ffd200\">'$item:30001136$', '$item:30001137$', '$item:30001138$', '$item:30001139$'</font>!\nI'll \
    exchange them for <font color=\"#ffd200\">$item:30001135$</font>, which you can use to buy special goods from \
    Bobby~"
set key[id=523134314003228] name "$npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
    $npcName:23000019[gender:0]$, $npcName:23000054$, $npcName:23000020[gender:1]$, $npcName:23000035$, \
    \n$npcName:23000099$, $npcName:23000017$, $npcName:23000047$, $npcName:23000024[gender:1]$, \
    $npcName:23000034$, $npcName:23000045$,\n$npcName:23000057[gender:1]$, $npcName:23000026[gender:1]$, \
    $npcName:23000012$, $npcName:23000009[gender:0]$, $npcName:23000029$. \n\nThere are this many bosses that drop \
    the letters <font color=\"#ffd200\">'$item:30001136$', '$item:30001137$', '$item:30001138$', \
    '$item:30001139$'</font>.\nCollecting letters isn't hard, right? "
set key[id=523134314003229] name "Now then, shall we head out to the field?\nThe bosses I mentioned have the \
    letters <font color=\"#ffd200\">'$item:30001136$', '$item:30001137$', '$item:30001138$', \
    '$item:30001139$'</font> floating over their heads.\nYou'll spot them right away. "
set key[id=523134314003230] name "Here's the $item:30001135$ I promised~\nWhat would you like to buy, \
    $MyPCName$?\nThe goods Bobby has prepared at the Rainbow Coin Shop are so pretty.\nGo take a look right away. \
    You'll be amazed!"
set key[id=523134314003231] name "Hello, $MyPCName$!\nCollect the letters <font \
    color=\"#ffd200\">'$item:30001140$', '$item:30001141$', '$item:30001142$', '$item:30001143$'</font>!\nI'll \
    exchange them for <font color=\"#ffd200\">$item:30001135$</font>, which you can use to buy special goods from \
    Bobby~"
set key[id=523134314003232] name "$npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
    $npcName:23000019[gender:0]$, $npcName:23000054$, $npcName:23000020[gender:1]$, $npcName:23000035$, \
    \n$npcName:23000099$, $npcName:23000017$, $npcName:23000047$, $npcName:23000024[gender:1]$, \
