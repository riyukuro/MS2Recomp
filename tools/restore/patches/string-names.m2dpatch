set key[id=1209155414004472] name "Join the <font color=\"#ffd200\">$map:61000022$</font> hosted by \
    $npcName:11001899[gender:0]$!\nTake part just <font color=\"#ffd200\">10 times</font> before the dance party \
    ends and I'll give you a special gift I've prepared!"
set key[id=1209155414004473] name "Join the <font color=\"#ffd200\">$map:61000022$</font>!\nTake part just <font \
    color=\"#ffd200\">10 times</font> before the dance party ends and I'll give you a special gift I've prepared!"
set key[id=1209155414004474] name "$MyPCName$, you really are Maple World's famous dancer!\nHere, a gift I \
    prepared for you!!"
set key[id=1211182214004475] name "I hope only good things happen in the new year of 2020!\nHave you had your rice \
    cake soup? \nAt Ruby's house, the whole family gathers on January 1st to eat rice cake soup."
set key[id=1211182214004476] name "You need 3 ingredients to make rice cake soup.\nThey are <font \
    color=\"#ffd200\">'$item:30001500$', '$item:30001501$', '$item:30001502$'</font>.\n\nYou can get them by \
    defeating $npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
    $npcName:23000019[gender:0]$, $npcName:23000054$, $npcName:23000020[gender:1]$, $npcName:23000035$, \
    \n$npcName:23000099$, $npcName:23000017$, $npcName:23000047$, $npcName:23000024[gender:1]$, \
    $npcName:23000034$, $npcName:23000045$,\n$npcName:23000057[gender:1]$, $npcName:23000026[gender:1]$, \
    $npcName:23000012$, $npcName:23000009[gender:0]$, $npcName:23000029$ and so on."
set key[id=1211182214004477] name "Try defeating the boss monsters I'm about to tell you \
    about.\n$npcName:23000013[gender:0]$, $npcName:23000018$, $npcName:23000001[gender:0]$, \
    $npcName:23000019[gender:0]$, $npcName:23000054$, $npcName:23000020[gender:1]$, $npcName:23000035$, \
    \n$npcName:23000099$, $npcName:23000017$, $npcName:23000047$, $npcName:23000024[gender:1]$, \
    $npcName:23000034$, $npcName:23000045$,\n$npcName:23000057[gender:1]$, $npcName:23000026[gender:1]$, \
    $npcName:23000012$, $npcName:23000009[gender:0]$, $npcName:23000029$. \n\nYou can get the rice cake soup \
    ingredients <font color=\"#ffd200\">'$item:30001500$', '$item:30001501$', '$item:30001502$'</font> from them."
set key[id=1211182214004478] name "Rice cake soup isn't hard, you know?!\nStir-fry the meat, pour in water and \
    boil for a good while, add the rice cakes and boil a bit more, then top it with garnish and you're done. \
    \nSince you've gathered all the ingredients, here's <font color=\"#ffd200\">'$item:30001503$'</font> for you. \
    \nMake <font color=\"#ffd200\">'$item:30001503$'</font> successfully 10 times and I'll give you a special \
    gift.\n"
set key[id=1211182214004479] name "How many times have you made <font color=\"#ffd200\">'$item:30001503$'</font> \
    successfully?\nI'm planning a rice cake soup feast, and I need 10 bowls."
set key[id=1211182214004480] name "If you ever collect 10 bowls of <font \
    color=\"#ffd200\">'$item:30001503$'</font>, be sure to tell me.\nI have a special gift prepared."
set key[id=1211182214004481] name "Remember, 10 bowls of <font color=\"#ffd200\">'$item:30001503$'</font>.\nBring \
    them to me and I'll give you a gift!"
set key[id=1211182214004482] name "10 bowls of <font color=\"#ffd200\">'$item:30001503$'</font> is plenty for a \
    feast.\nHere, I'll give you the gift I prepared. \nThank you. "
set key[id=1229140214004551] name "$MyPCName$, I've been so worried lately."
set key[id=1229140214004552] name "Monsters popping up everywhere are ruining beautiful Maple World.\nI can't even \
    sleep at night because of the monsters howling.\n"
set key[id=1229140214004553] name "Would you show those monsters what's what, $MyPCName$?\nDefeat about 200 of \
    them and they'll surely get scared!"
set key[id=1229140214004554] name "Show those monsters what's what!"
set key[id=1229140214004555] name "Phew, do you think things have gotten a bit better?\nThanks to you, $MyPCName$, \
    Maple World seems to be slowly getting back to normal!"
set key[id=1229140214004556] name "$MyPCName$, did you hear?\nThey say a giant machine is shaking the Kritias \
    continent!"
set key[id=1229140214004557] name "What was its name...?\nOh right, $npcName:23001006$! They say it goes around \
    drilling holes everywhere with a giant drill."
set key[id=1229140214004558] name "Would you defeat it, $MyPCName$?\nThe people of Kritias are trembling in fear."
set key[id=1229140214004559] name " Please defeat $npcName:23001006$!"
set key[id=1229140214004560] name "It won't show up again, will it?\nThanks to you, $MyPCName$, Maple World seems \
    to be slowly regaining its peace!"
set key[id=1229140214004561] name "$MyPCName$, I hear MC Kay is having a really hard time lately."
set key[id=1229140214004562] name "Fewer and fewer adventurers are joining events lately...\nShe says she might \
    even lose her job at this rate."
set key[id=1229140214004563] name "Could you help MC Kay a little, $MyPCName$?\nProtecting Maple World is great, \
    but having some fun once in a while isn't bad either!"
set key[id=1229140214004564] name "Join an event and have a blast!"
set key[id=1229140214004565] name "How was it? Did you have fun?\nThanks to you, $MyPCName$, MC Kay says she can \
    breathe easy for now."

# Quest dialogue of the SoulBinder quests (feature SoulBinder) that no pack has in English: our own
# English for the 450 scriptquest rows of locale KR (or no locale) whose quest a player can get (36 quests),
# with each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=701161202005633] name "Hmm... what's going on... again... \nRumor has it that a secret gathering was \
    held in $map:02000001$.\nGo find out what's going on."
set key[id=701161202005634] name "Rumor has it that a secret gathering was held in $map:02000001$.\nGo find out \
    what's going on."
set key[id=701161202005635] name "Haa... is something big about to happen again... "
set key[id=701161202005636] name "So, what brings you here?"
set key[id=701161202005637] name "They say the entrance to the temple of <font \
    color=\"#ffd200\">$npc:23000078$</font>, who sleeps guarding the Runicta,\nis somewhere in <font \
    color=\"#ffd200\">$map:02000112$</font>."
set key[id=701161202005638] name "You found the temple entrance that $npcName:11000119[gender:0]$ told you \
    about.\nYou can feel some unknown powerful force. What could be happening inside...?"
set key[id=712143202005655] name "(Ask what big thing is happening.)"
set key[id=712143202005656] name "Ah...! You... how long have you been here...\nShowing up without a sound... \
    phew... you startled me."
set key[id=712143202005657] name "(Ask about the secret gathering.)"
set key[id=712143202005658] name "Ah~ that... \nIt seems there's some trouble inside the <font \
    color=\"#ffd200\">Rune Blader</font> order."
set key[id=712143202005659] name "(Say I'd like to hear the details.)"
set key[id=712143202005660] name "It seems there was a traitor in the Rune Blader order called <font \
    color=\"#ffd200\">$npcName:11001231[gender:0]$</font>.\nThe Rune Blades chased the one who killed their leader \
    and vanished, all the way here,\nand what that <font color=\"#ffd200\">$npcName:11001231[gender:0]$</font> was \
    after was the <font color=\"#ffd200\">Runicta</font> hidden by the ancient rune sorcerers...? "
set key[id=712143202005661] name "Anyway, they asked the Guardians to join the <font color=\"#ffd200\">Starlight \
    Expedition</font> to protect\nthe <font color=\"#ffd200\">Runicta</font> from <font \
    color=\"#ffd200\">$npcName:11001231[gender:0]$</font> and lend a hand.\nWell... not everyone present welcomed \
    it with open arms, but in the end everyone\ndecided together to take part in the <font \
    color=\"#ffd200\">Starlight Expedition</font>."
set key[id=712143202005662] name "Phew... well, with everyone lending a hand, things moved along quite fast.\nWe \
    found out where <font color=\"#ffd200\">$npcName:11001231[gender:0]$</font> went chasing the <font \
    color=\"#ffd200\">Runicta</font>."
set key[id=712143202005663] name "(Ask where that is.)"
set key[id=712143202005664] name "They say the entrance to the temple of <font \
    color=\"#ffd200\">$npc:23000078$</font>, who sleeps guarding the Runicta,\nis somewhere in <font \
    color=\"#ffd200\">$map:02000112$</font>.\nWill you go and see it?"
set key[id=802233102005683] name "What I'm curious about is <font color=\"#ffd200\">why the audience ceremony was \
    canceled</font>.\nThe earthquake was days ago, so why cancel the ceremony all of a sudden now?\nDoes that make \
    sense? Ugh!! The more I think about it, the angrier I get."
set key[id=802233102005684] name "There's definitely something fishy going on. I can smell it!\nI'm going to find \
    out what they're hiding."
set key[id=802233102005685] name "From now on I'll be asking around everywhere, so I'm going to be super busy.\nSo \
    you ask around too, and if you find anything out,\nyou'd better tell me. Got it? Huh?"
set key[id=802233102005686] name "(Ask who I should ask.)"
set key[id=802233102005687] name "Huh? W-why are you asking me that?!\nIf you really don't know, start close \
    by!\nGo grab that $npcTitle:11000169[gender:0]$ over there and ask."
set key[id=802233102005688] name "They said I could meet $npc:11000492[gender:0]$ here, but the door is firmly \
    locked.\nThere's no sign of anyone, so it seems nobody is inside the city hall.\nLet's ask the people around \
    if anyone saw $npc:11000492[gender:0]$ leave the city hall. "
set key[id=803181311003925] name "The <font color=\"#ffd200\">eagle beastfolk</font> and the <font \
    color=\"#ffd200\">reindeer beastfolk</font> went up that road to the right\ninto a <font \
    color=\"#ffd200\">cute wooden house</font>.\nIf you're looking for them, follow the road on my right all the \
    way up."
set key[id=803181311003926] name "The <font color=\"#ffd200\">eagle beastfolk</font> and the <font \
    color=\"#ffd200\">reindeer beastfolk</font> went up that road to the right\ninto a <font \
    color=\"#ffd200\">cute wooden house</font>.\nIf you're looking for them, follow the road on my right all the \
    way up."
set key[id=803181311003927] name "Ah...! $MyPCName$, you came!\nAre you all right?"
set key[id=803181311003928] name "(Ask if $npc:11001716[gender:0]$ collapsed.)"
set key[id=803181311003929] name "Yeah. As you can see, he looks pretty bad.\nEven if he used up a lot of energy, \
    come on, what is this?\nHe's the chief disciple, is this okay? He needs to snap out of it quick.... "
set key[id=803181311003930] name "(Ask what happened.)"
set key[id=803181311003931] name "Quite a lot of people were chasing the cloud you rode, so while their attention \
    was split,\nSenior Brother $npcName:11001716[gender:0]$ flew off carrying me dangling. Of course I was \
    struggling to keep my stealth up, too.\nAnyway, you found us well! I thought you'd have a hard time."
set key[id=803181311003932] name "(Say $npc:11001677[gender:0]$ told me.)"
set key[id=803181311003933] name "I see. They say $map:02000001$ has the Royal Guard, so even if there's a sudden \
    intrusion\nor commotion, it's relatively safe. Plus, all kinds of\npeople gather here, so nobody finds \
    beastfolk like us strange or is shocked.	"
set key[id=803181311003934] name "And... it's also a place where <font color=\"#ffd200\">a lot of varied \
    information</font> gathers.\nNow then, shall we get to work? "
set key[id=803181311003935] name "Work...? "
set key[id=803181311003936] name "After I explained everything... did you forget? Did you hit your head when you \
    fell?\nThat <font color=\"#ffd200\">$npc:23000082[gender:0]$</font> who raided Neoulbit Mountain tried to \
    take\nGuidance's sacred treasure. We have to stop that from happening. "
set key[id=803181311003937] name "First, we should stay here and quietly start <font color=\"#ffd200\">asking \
    around</font>.\nOf course, Senior Brother's recovery comes first, though.... "
set key[id=803181311003938] name "First we need to gather as much information as we can here.\nI think we should \
    start by checking whether there are any traces that the old relic from Neoulbit Mountain was kept here.\nWill \
    you take care of <font color=\"#ffd200\">gathering information</font>?"
set key[id=803181311003939] name "(Ask what $npc:11001707[gender:1]$ will do.)"
set key[id=803181311003940] name "I'll stay here and <font color=\"#ffd200\">nurse</font> <font \
    color=\"#ffd200\">Senior Brother $npcName:11001716[gender:0]$</font>.\nBut if you'd like to make eye contact \
    with Senior Brother $npcName:11001716[gender:0]$, put a hand on his forehead,\nand brush his feathers, you can \
    take over nursing him."
set key[id=803181311003941] name "(...Say I'll leave the nursing to $npcName:11001707[gender:1]$.)"
set key[id=803181311003942] name "Yeah, yeah. Good choice.\nAlso, don't shy away from doing favors for humans or \
    looking into their incidents.\nAnything we learn becomes our information.\nOf course, Senior Brother \
    $npcName:11001716[gender:0]$ won't be thrilled about it."
set key[id=803181311003943] name "On my way here I saw someone dressed like a <font color=\"#ffd200\">guide</font> \
    near the palace.\nI think we should start by asking her. Okay, I'm counting on you!"
set key[id=803181311003944] name "On my way here I saw someone dressed like a <font color=\"#ffd200\">guide</font> \
    near the palace.\nI think we should start by asking her. Okay, I'm counting on you!"
set key[id=803181311003945] name "Hello. Is there something you'd like to know?"
set key[id=803181311003946] name "(Say I have a few questions.)"
set key[id=803181311003947] name "I'll tell you anything I know.\nGo ahead."
set key[id=803181311003948] name "Is this your first time in $map:02000001$? You seem like someone I haven't \
    met.\nTell me what you'd like to ask."
set key[id=803181311003949] name "(Ask if she's really never seen me.)"
set key[id=803181311003950] name "What? Have we met before?\nSo many people are coming and going these days \
    because of the <font color=\"#ffd200\">audience ceremony</font>\nthat even I can't remember everyone, ha ha \
    ha. "
set key[id=803181311003951] name "(Say I'm asking because I can't remember either.)"
set key[id=803181311003952] name "Um... are you feeling unwell? Do you forget things a lot...\nLike forgetfulness? \
    Or... <font color=\"#ffd200\">amnesia?</font>\nA lot of people are like that lately. Heartbroken over the \
    <font color=\"#ffd200\">canceled audience ceremony</font>, denying reality...."
set key[id=803181311003953] name "(Say I've lost my memories of recent times.)"
set key[id=803181311003954] name "Oh my. I'm sorry. I said that like a <font color=\"#ffd200\">joke</font>, but \
    you're <font color=\"#ffd200\">actually</font>...\nBut I don't think you and I, $MyPCName$, have met \
    before.\nI'm sorry I couldn't help. Is there anything else you'd like to know?"
set key[id=803181311003955] name "(Ask where relics are mostly kept.)"
set key[id=803181311003956] name "The $map:02000001$ palace, where the Empress is, of course.\nBut there are so \
    many that if you just say relics, it'll be harder to find them.\nCould you be more specific?"
set key[id=803181311003957] name "(Say it probably has something to do with the <font \
    color=\"#ffd200\">beastfolk</font>.)"
set key[id=803181311003958] name "Hmm... I wonder. For a special relic like that, it'd be best to ask\nthe people \
    who manage the palace's belongings. But right now, with the <font color=\"#ffd200\">canceled audience \
    ceremony</font>,\neveryone's in a frenzy, so there probably isn't anyone who can answer."
set key[id=803181311003959] name "<font color=\"#909090\">(All she talks about is the canceled audience \
    ceremony...)</font>"
set key[id=803181311003960] name "Besides the royal staff, someone who might know about beastfolk relics... \
    hmm...\nOh! <font color=\"#ffd200\">$npc:11000003[gender:0]$</font>, who complains a lot but is so curious he \
    tries to find out everything,\nmight know what you're wondering about, $MyPCName$.\nHe can't stand not knowing \
    and just charges in... they say he's quietly a great source of information. "
set key[id=803181311003961] name "<font color=\"#ffd200\">$npc:11000003[gender:0]$</font> is down those stairs, so \
    go meet him.\nOh, but he seems to be in a bad mood right now, so keep that in mind."
set key[id=803181311003962] name "<font color=\"#ffd200\">$npc:11000003[gender:0]$</font> is down those stairs, so \
    go meet him.\nOh, but he seems to be in a bad mood right now, so keep that in mind."
set key[id=803181311003963] name "What? And who are you? \nUgh... I'm already fuming and all sorts of weird humans \
    keep showing up... "
set key[id=803181311003964] name "(Ask if he's heard about beastfolk relics in $map:02000001$.)"
set key[id=803181311003965] name "(Greet him cheerfully.)"
set key[id=803181311003966] name "This $map:02000001$ is a palace. You think there's just one or two \
    treasures?\nAnd besides, the greatest treasure of $map:02000001$ is Empress $npcName:11000075[gender:1]$.\nI \
    came here all excited to see her at the audience ceremony... and what is this? Ugh!"
set key[id=803181311003967] name "<font color=\"#909090\">(He doesn't seem to know anything. It's better to just \
    leave.)</font>"
set key[id=803181311003968] name "What? What a silly one... must be nice to be in such a good mood.\nSo you've got \
    something to ask? Go on, say it."
set key[id=803181311003969] name "(Ask if he knows anything about the beastfolk's treasure.)"
set key[id=803181311003970] name "Hold on. Didn't you want to know something?\nIf you <font color=\"#ffd200\">find \
    out what I'm curious about</font>, I'll tell you what I know.\nI can't remember right now, but who knows? If \
    I'm in a better mood, it might come back."
set key[id=803181311003971] name "<font color=\"#909090\">(It's best to do the favor first and get \
    information.)</font>"
set key[id=803181311003972] name "What? Are you going to do it or not?\nIf I get any angrier here I won't be able \
    to think of anything, so answer quick!\nAh, forget it! If you don't want to, scram! Go away! "
set key[id=803181311003973] name "(Say I'll find out what he's curious about.)"
set key[id=803181311003974] name "Yeah, good thinking."
set key[id=803181311003975] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311003976] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311003977] name "You're here! I've been waiting."
set key[id=803181311003978] name "How was seeing the sights of $map:02000001$? Did you have fun?\nDid you gather \
    any information here?"
set key[id=803181311003979] name "(Say there's nothing helpful yet.)"
set key[id=803181311003980] name "Aw~ I knew there wouldn't be any progress until I stepped in,\nso you should've \
    just enjoyed $map:02000001$. You really did just gather information.\nBeing this boring, you two are exactly \
    alike, exactly. <font color=\"#ffd200\">soulmates</font>~"
set key[id=803181311003981] name "(Ask who I'm a soulmate with.)"
set key[id=803181311003982] name "You really don't know? <font color=\"#ffd200\">Senior Brother \
    $npcName:11001716[gender:0]$, the training maniac</font> and <font color=\"#ffd200\">the one whose hobby is \
    fainting, you!</font>\nShort on words, no fun~ you're exactly the same. Heh.\nOh, and Senior Brother's \
    condition has improved a lot. He just lay there mumbling for a while,\nbut now he gets up and walks around, \
    and has even started saying he's going to train."
set key[id=803181311003983] name "So now it's finally time for me to step in.\nI should use my informant who's \
    settled here. Actually, he's also the owner of this house,\nbut I haven't seen him in ages! A <font \
    color=\"#ffd200\">sturdy, agile body</font> and a <font color=\"#ffd200\">great, big-hearted guy</font>, he \
    was~"
set key[id=803181311003984] name "(Ask what she means, the owner of this house...)"
set key[id=803181311003985] name "Oh, this house belongs to <font color=\"#ffd200\">Taig Furian</font>. He was a \
    <font color=\"#ffd200\">tiger</font> beastfolk who trained with us at Guidance in the past.\nHe didn't get \
    along well with Senior Brother $npcName:11001716[gender:0]$, so he said he'd train in the city and left.\nAnd \
    not long ago he sent me a letter after ages,\nsaying he'd set up a small training ground in <font \
    color=\"#ffd200\">$map:02000001$</font>."
set key[id=803181311003986] name "He had a pretty great plan: to train the city way here and also watch the \
    audience ceremony.\nI remember reading the letter and thinking how admirable he was~\nSo I came here to see \
    him too. I wonder if he's doing well~"
set key[id=803181311003987] name "(Say that means she's occupying someone else's house without permission.)"
set key[id=803181311003988] name "Oh come on~ under the name of Guidance we're all brothers.\nIs visiting a <font \
    color=\"#ffd200\">brother's house</font> called trespassing?\nHe'd definitely think so too! <font \
    color=\"#ffd200\">What's good is good~</font>"
set key[id=803181311003989] name "(Say we should meet him and apologize...)"
set key[id=803181311003990] name "Not apologize, you should ask a <font color=\"#ffd200\">favor</font>. Ask him to \
    gather information with us.\nHe respected $npc:11001661[gender:0]$, so he'll surely help.\nSo... shall we go \
    <font color=\"#ffd200\">find him</font>? "
set key[id=803181311003991] name "(Tell her to hurry and go.)"
set key[id=803181311003992] name "Huh? Me? You're joking, right?\nSenior Brother <font \
    color=\"#ffd200\">$npcName:11001716[gender:0]$</font> is still not in good shape and someone has to stay with \
    him...\nOf course, if you stay beside him giving massages and singing songs, then I'll go."
set key[id=803181311003993] name "(Say I'll go...)"
set key[id=803181311003994] name "Heh heh. Then have a good trip~\nTaig Furian is a tiger beastfolk. He's agile \
    and big-hearted,\nso if you see a <font color=\"#ffd200\">tiger</font> beastfolk, ask if they know <font \
    color=\"#ffd200\">Taig Furian</font>~ They'll know right away! "
set key[id=803181311003995] name "Heh heh. Then have a good trip~\nTaig Furian is a tiger beastfolk. He's agile \
    and big-hearted,\nso if you see a <font color=\"#ffd200\">tiger</font> beastfolk, ask if they know <font \
    color=\"#ffd200\">Taig Furian</font>~ They'll know right away! "
set key[id=803181311003996] name "What, you? \nDid you find out why the audience ceremony was canceled? "
set key[id=803181311003997] name "(Ask if he knows who Taig Furian is.)"
set key[id=803181311003998] name "...What did you just say? Was that the name I heard?\nDon't tell me... where are \
    you from? Who told you that name?"
set key[id=803181311003999] name "(Say $npcName:11001707[gender:1]$ from Neoulbit Mountain told me.)"
set key[id=803181311004000] name "......\n<font color=\"#909090\">(Roary stands there unable to say a \
    word.)</font>"
set key[id=803181311004001] name "(Say if he doesn't know, I'll go ask someone else.)"
set key[id=803181311004002] name "W-wait. You came to the right place.\nThat's <font color=\"#ffd200\">my \
    name</font>."
set key[id=803181311004003] name "What's your relationship with <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font>?\nDid you two come here alone? Where's \
    $npc:11001707[gender:1]$ now?"
set key[id=803181311004004] name "(Say she's nursing $npcName:11001716[gender:0]$ at $map:52000041$.)"
set key[id=803181311004005] name "Wh-what? <font color=\"#ffd200\">$npcName:11001716[gender:0]$</font>? What's he \
    doing again?\nThat guy should be <font color=\"#ffd200\">busy training</font> holed up in the mountains, so \
    who is he with and doing what here?\nD-did the Master kick him out? What on earth happened?"
set key[id=803181311004006] name "<font color=\"#909090\">(They said he had a sturdy build and a big-hearted \
    personality... I'm not sure this is the same guy.)</font> "
set key[id=803181311004007] name "Ugh, this is frustrating! $MyPCName$, say something!\nWhat on earth \
    happened?!\nAnd is the <font color=\"#ffd200\">Master</font> doing well?"
set key[id=803181311004008] name "(Briefly tell him what has happened so far.)"
set key[id=803181311004009] name "Such things happened... I'll help however I can. Leave it to me.\nBefore that, I \
    need to go <font color=\"#ffd200\">home</font> and see <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font>.\nIt's been so long... she must still be smart, pretty, and \
    lovely, hehe."
set key[id=803181311004010] name "(Ask if it's okay since $npcName:11001707[gender:1]$ basically barged into his \
    house without a word.)"
set key[id=803181311004011] name "If it's <font color=\"#ffd200\">$npc:11001707[gender:1]$</font>, of course it's \
    fine. It was worth saving up all those mesos\nto get a place in $map:02000001$. Eheheh.\nI'll comb my fur and \
    be there, so see you at <font color=\"#ffd200\">$map:52000041$</font>. "
set key[id=803181311004012] name "I'll comb my fur and be there, so see you at <font \
    color=\"#ffd200\">$map:52000041$</font>.\n$npc:11001707[gender:1]$... wait for me...!"
set key[id=803181311004013] name "Did you see what happens when you <font color=\"#ffd200\">slack on your \
    training</font>?\nIt's not just the body that changes. The mind has gone slack too.\nStorming out like that, \
    <font color=\"#ffd200\">so easily worked up</font>... tsk."
set key[id=803181311004014] name "(Ask if training can control being easily worked up.)"
set key[id=803181311004015] name "Of course. A <font color=\"#ffd200\">practitioner</font> can circulate their \
    energy through training\nand temper body and mind. If you slack off, the energy scatters, and like that \
    guy,\n<font color=\"#ffd200\">changes occur in both body and mind</font>. So you should be careful too."
set key[id=803181311004016] name "(Say I understand why <font color=\"#ffd200\">Senior Brother \
    $npcName:11001716[gender:0]$</font> needs <font color=\"#ffd200\">training</font>.)"
set key[id=803181311004017] name "Training is <font color=\"#ffd200\">something everyone needs</font>.\nIf \
    anything, you're the one who needs it more...?\nSearching for information on the sacred treasure is important, \
    but don't neglect your training."
set key[id=803181311004018] name "(Say I'm not easily worked up like Senior Brother \
    $npcName:11001716[gender:0]$.)"
set key[id=803181311004019] name "Y-you...!\n<font color=\"#909090\">(Senior Brother $npcName:11001716[gender:0]$ \
    seems quite worked up but is holding it in well. Is that <font color=\"#ffd200\">the effect of \
    training</font>...) </font>"
set key[id=803181311004020] name "Heh heh. $MyPCName$, you really got <font color=\"#ffd200\">Senior Brother \
    $npcName:11001716[gender:0]$</font> good.\nStill, he's calmed down a lot compared to before, so go easy on \
    him.\nHe knows he's strict and worries about it a lot.\nTaig Furian also bolted because he rebelled against \
    Senior Brother's way of teaching...."
set key[id=803181311004021] name "Still, I support Senior Brother. Is there anyone else who tries that hard?\nThis \
    time there was no brawling either... how gentlemanly. Right? "
set key[id=803181311004022] name "(...Ask what we should do now.)"
set key[id=803181311004023] name "Oh, I forgot to tell Taig Furian to <font color=\"#ffd200\">gather information \
    together</font> with us.\nThe most important part and I forgot, silly me! Heh heh heh.\nI'd like to go tell \
    him myself... but I can't. You'd better go."
set key[id=803181311004024] name "(Ask why she can't go herself.)"
set key[id=803181311004025] name "Don't you see Senior Brother $npcName:11001716[gender:0]$'s wings fluttering \
    right now?\nI think <font color=\"#ffd200\">what you just said to Senior Brother \
    $npcName:11001716[gender:0]$</font> was quite a shock to him.\nI think it's better if I stay by his side. \
    Or... do you want to stay?"
set key[id=803181311004026] name "(Say I'll go...)"
set key[id=803181311004027] name "You're so smart. Have a good trip~\nWhile you're there, gather a bit more <font \
    color=\"#ffd200\">information</font> too~!"
set key[id=803181311004028] name "If <font color=\"#ffd200\">Taig Furian</font> helps us, it'll be a big boost to \
    gathering information.\nSmart $MyPCName$, go to Taig Furian and\nask him nicely for me!"
set key[id=803181311004029] name "<font color=\"#ffd200\">$npcName:11001716[gender:0]$...</font> I heard that name \
    and still went there...\nI was such a fool... I showed my pathetic side in front of <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font> again...!"
set key[id=803181311004030] name "(Call him Taig Furian.)"
set key[id=803181311004031] name "Don't call me that. I'm just going to live as the <font \
    color=\"#ffd200\">friendly $npc:11000003[gender:0]$</font>.\nI'll work hard making potions, cleaning... and \
    saving up lots of mesos\nto live as the <font color=\"#ffd200\">cold city's \
    $npcName:11000003[gender:0]$</font> who's curious about nothing. "
set key[id=803181311004032] name "And then I'll appear before you looking cool, $npc:11001707[gender:1]$.\nI'll \
    buy you lots of the books you like, go pick flowers together..."
set key[id=803181311004033] name "(Say not to forget gathering information about <font \
    color=\"#ffd200\">Guidance's sacred treasure</font>.)"
set key[id=803181311004034] name "...$MyPCName$. Could you not ruin the mood?\nCan't you see I'm <font \
    color=\"#ffd200\">very sad right now</font>? Huh? Don't talk to me."
set key[id=803181311004035] name "(Ask if he's heard a rumor that the sacred treasure is in $map:02000001$.)"
set key[id=803181311004036] name "Saying only what you want to say no matter what the other person says is just \
    like that $npcName:11001716[gender:0]$...\nHey, $MyPCName$. I'm not in the mood to talk with you right \
    now.\nLooking at you makes me <font color=\"#ffd200\">keep thinking of $npcName:11001716[gender:0]$</font> and \
    I get even sadder."
set key[id=803181311004037] name "As for a sacred treasure, it's a rare treasure, so wouldn't it be <font \
    color=\"#ffd200\">somewhere in the royal palace</font>?\n<font \
    color=\"#ffd200\">$npcName:11000492[gender:0]$</font> manages the royal household, so go to <font \
    color=\"#ffd200\">$map:02000140$</font> and meet him. "
set key[id=803181311004038] name "He was someone who could have told me about the royal family and the sacred \
    treasure, and even the whole story of the armory theft...\nbut it seems I won't hear anything from him \
    anymore.\n<font color=\"#ffd200\">Let's look around $npc:11000492[gender:0]$ to see if there's any \
    clue.</font>"
set key[id=803181311004039] name "He was someone who could have told me about the royal family and the sacred \
    treasure, and even the whole story of the armory theft...\nbut it seems I won't hear anything from him \
    anymore.\n<font color=\"#ffd200\">Let's look around $npc:11000492[gender:0]$ to see if there's any \
    clue.</font>"
set key[id=803181311004040] name "$MyPCName$!!\nJust before the Royal Guard investigation began, \
    $npc:11000492[gender:0]$, no, $npc:11000492[gender:0]$ disappeared,\nand it's been chaos. Where have you been \
    all this time?"
set key[id=803181311004041] name "(Tell him what happened at $map:52000037$.)"
set key[id=803181311004042] name "What? $npc:11000492[gender:0]$... that person is dead?\nAnd strange people \
    showed up there too and you ran away?\n...Haa. I'm glad you made it back safely. Are you all right? "
set key[id=803181311004043] name "(Say I'm fine and have a favor to ask.)"
set key[id=803181311004044] name "Ah... yes. Go ahead.\nI don't know if I can help, though. "
set key[id=803181311004045] name "(Say I'm wondering whether the royal family keeps any items related to \
    beastfolk.)"
set key[id=803181311004046] name "I'm just a regular guard, so it's hard for me to know such things.\nBut <font \
    color=\"#ffd200\">$npc:11000119[gender:0]$</font>... he knows $npc:11000074[gender:0]$ too,\nso he might be \
    able to ask for you. "
set key[id=803181311004047] name "Why don't you report what you've investigated so far, $MyPCName$, directly to \
    <font color=\"#ffd200\">$npc:11000119[gender:0]$</font>\nand ask him to look into what you're curious about?"
set key[id=803181311004048] name "Please tell <font color=\"#ffd200\">$npc:11000119[gender:0]$</font> in detail \
    about the investigation so far\nand <font color=\"#ffd200\">the notebook you found</font> yourself, \
    $MyPCName$.\nPlease."
set key[id=803181311004049] name "Did you leave something behind?"
set key[id=803181311004050] name "(Say I left $item:30000023$ behind.)"
set key[id=803181311004051] name "(Say I forgot what I was asked to do.)"
set key[id=803181311004052] name "Ah, right. Here you go."
set key[id=803181311004053] name "You looked like you were putting it in your bag just now...\nPlease check your \
    bag again."
set key[id=803181311004054] name "Your bag looks too heavy...\nWhy don't you tidy it up a bit?"
set key[id=803181311004055] name "Please tell $npc:11000119[gender:0]$ in detail about the investigation so \
    far\nand the notebook you found."
set key[id=803181311004056] name "$MyPCName$?\nAh, so you're the one who investigated the armory theft\nat \
    $npc:11000169[gender:0]$'s request."
set key[id=803181311004057] name "We started investigating $npc:11000492[gender:0]$ right after \
    $npc:11000169[gender:0]$'s tip,\nbut his whereabouts are unknown. He left nothing behind."
set key[id=803181311004058] name "Let me tell you what's happened since."
set key[id=803181311004059] name "What? Is that true? $npc:11000492[gender:0]$ is dead...\nBefore we could even \
    uncover the truth of the armory theft... it never rains but it pours.\nWith no clues at all, this is \
    troublesome...  "
set key[id=803181311004060] name "(Hand over the notebook found in $npc:11000492[gender:0]$'s bag.)"
set key[id=803181311004061] name "What's this...?\nHm? Wait... this looks like the notebook used by Barota Company \
    peddlers...\nWhere did you find it?"
set key[id=803181311004062] name "(Say I found it among the clothes in $npc:11000492[gender:0]$'s bag.)"
set key[id=803181311004063] name "Wait... clothes in $npc:11000492[gender:0]$'s luggage bag... hmm...\nWe found no \
    sign at all of $npc:11000492[gender:0]$ packing his things at his home or city hall.\nEverything was left as \
    it was.\nYet there were clothes in the bag found beside the dead $npc:11000492[gender:0]$... and this \
    notebook... "
set key[id=803181311004064] name "Perhaps that bag belonged to someone other than $npc:11000492[gender:0]$.\nWe \
    can say there's still more to investigate....\n$MyPCName$, could you help investigate further? "
set key[id=803181311004065] name "(Say I have something to ask first.)"
set key[id=803181311004066] name "<font color=\"#ffd200\">A favor?</font> Of course, you helped us, so I'll help \
    if I can.\nWhat is it?"
set key[id=803181311004067] name "(Say I'm wondering whether the royal family keeps any items related to \
    beastfolk.)"
set key[id=803181311004068] name "Hmm... items related to beastfolk...\nThe prime minister once told me that to \
    overcome the crisis facing the world,\n<font color=\"#ffd200\">various factions</font> gathered around the \
    Empress placed <font color=\"#ffd200\">their symbolic figures</font>\nin $map:02000001$ to pool their strength \
    and strengthen the alliance. "
set key[id=803181311004069] name "The item you're talking about might be related to that.\nBut the prime minister \
    said <font color=\"#ffd200\">the symbols of each faction should have\nmostly returned to their original places \
    by now...</font>"
set key[id=803181311004070] name "(Ask if he's ever heard the name <font color=\"#ffd200\">Guidance</font>.)"
set key[id=803181311004071] name "<font color=\"#ffd200\">Guidance</font>... I'm not sure. I've never heard of \
    it.\nIn any case, I've heard what you want to know,\nand if I get any information about it, I'll tell you \
    right away."
set key[id=803181311004072] name "(Say I'll cooperate with your work too, so ask me anytime.)"
set key[id=803181311004073] name "Really? That would be good for both of us.\nThank you, $MyPCName$."
set key[id=803181311004074] name "$MyPCName$! This is a message from <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font>.\nShe says she has something to tell you and wants to meet \
    at <font color=\"#ffd200\">$map:52000041$</font>.\nAnd... P.S. <font color=\"#ffd200\">if you don't want to \
    face Senior Brother $npcName:11001716[gender:0]$'s wrath</font>, run over quick?"
set key[id=803181311004075] name "I don't know the details, but she seems urgent...\nYou should head over to <font \
    color=\"#ffd200\">$map:52000041$</font>."
set key[id=803181311004076] name "I don't know the details, but she seems quite urgent...\nYou should head over to \
    <font color=\"#ffd200\">$map:52000041$</font>."
set key[id=803181311004077] name "$MyPCName$! You came, you came.\nSenior Brother $npcName:11001716[gender:0]$ is \
    waiting. Go talk to him."
set key[id=803181311004078] name "$MyPCName$. I heard you've been gathering <font color=\"#ffd200\">information on \
    the sacred treasure</font>.\nHave you found out anything so far?"
set key[id=803181311004079] name "(Say I've inquired with the royal family and am waiting for a reply.)"
set key[id=803181311004080] name "Only an inquiry? And you spent all this <font color=\"#ffd200\">long time</font> \
    on that?\nYou received <font color=\"#ffd200\">the Master's Animar</font>, so while moving around here\nyou \
    should have sensed some energy or sign... was there nothing at all?"
set key[id=803181311004081] name "(Say there was nothing like that.)"
set key[id=803181311004082] name "...How disappointing. I believed that investigating here would bring light\nto \
    both your abilities and your lost memories... it seems that's still far off.\nOr... is it that you don't want \
    to tell me?"
set key[id=803181311004084] name "Enough. $MyPCName$, I suppose you have your own thoughts.\nJust don't neglect \
    your <font color=\"#ffd200\">training</font>, and I hope you'll often ask <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font> for her opinion."
set key[id=803181311004085] name "Enough. $MyPCName$, I suppose you have your own thoughts.\nJust don't neglect \
    your <font color=\"#ffd200\">training</font>, and I hope you'll often ask <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font> for her opinion."
set key[id=803181311004086] name "You're having a hard time in an unfamiliar place, $MyPCName$.\nI heard you \
    talking to Senior Brother. Inquiring with the royal family, that's pretty good!\nThe royal family is more \
    conservative than you'd think, so it's not easy to get connections."
set key[id=803181311004087] name "(Tell her what happened at $map:52000037$.)"
set key[id=803181311004088] name "A person died, and someone showed up at the scene and hurried away...\nThe dead \
    person was a royal official linked to the armory theft?\n...Wow. What on earth is going on. The human world is \
    complicated~"
set key[id=803181311004089] name "So that's why you didn't tell Senior Brother $npcName:11001716[gender:0]$ the \
    details.\n<font color=\"#ffd200\">Getting caught up in humans' incidents is one of the things Senior Brother \
    $npcName:11001716[gender:0]$ hates most</font>.\n...Yeah, I get it. But you did your best in your situation."
set key[id=803181311004090] name "In that case, Senior Brother $npcName:11001716[gender:0]$ will understand \
    too,\nso from now on I think you should tell him without hesitating.\nSenior Brother may be prickly with \
    humans, but it's not like he can't understand."
set key[id=803181311004091] name "And I'm going to start searching for information on the sacred treasure in \
    earnest.\nSenior Brother has regained some energy, so I'm going with the informants\nto investigate a wider \
    area, even beyond $map:02000001$."
set key[id=803181311004092] name "$MyPCName$, you keep investigating matters connected to the royal family\nand \
    check whether anything unusual turns up. If I find something, I'll contact you!"
set key[id=803181311004093] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311004094] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311004095] name "You came, $MyPCName$!\nI've been waiting."
set key[id=803181311004096] name "Did the Royal Guard captain tell you anything?\nI mean that royal guard person \
    you're helping with the investigation."
set key[id=803181311004097] name "(Say there was nothing special.)"
set key[id=803181311004098] name "Hmm... I see.\nBut don't be disappointed. I found out a few things!"
set key[id=803181311004099] name "There were a few interesting facts from the investigation with the \
    informants.\nTwo things stood out, and I was just wondering which to check first,\nbut this is perfect. \
    $MyPCName$, you and I can each go to one place."
set key[id=803181311004100] name "(Ask where to go.)"
set key[id=803181311004101] name "<font color=\"#ffd200\">$map:02000216$.</font> A black market where all sorts of \
    goods gather.\nBut aren't you curious what the information is? You ask where first.\nYou're quietly impatient. \
    Heh heh."
set key[id=803181311004102] name "According to word from $npc:11001730[gender:1]$, the Black Star Society that \
    runs $map:02000216$\nlets especially good customers preview and buy goods in a <font \
    color=\"#ffd200\">separate space</font>\nthey prepared, treating them as <font color=\"#ffd200\">VIP</font>s. \
    Naturally,\nthere'd be records of those secret deals too."
set key[id=803181311004103] name "These days there's a big-spending customer they're going out to make <font \
    color=\"#ffd200\">house-call sales</font> to,\nso that special space is often empty and security is lax.\nI \
    think we can take this chance to collect some clue there. "
set key[id=803181311004104] name "Go meet <font color=\"#ffd200\">$npc:11001730[gender:1]$</font> at <font \
    color=\"#ffd200\">$map:02000216$</font>.\nOh, and $npc:11001730[gender:1]$ likes this, so be sure to bring it \
    along!"
set key[id=803181311004105] name "What, is there a problem?"
set key[id=803181311004106] name "(Say I lost <font color=\"#ffd200\">$item:30000563$</font>.)"
set key[id=803181311004107] name "(Ask what she's thinking about.)"
set key[id=803181311004108] name "Geez! Where is your head at? You left it here.\nHere you go. Keep good track of \
    it this time~ "
set key[id=803181311004109] name "Geez, $MyPCName$! Look in your bag, <font color=\"#ffd200\">you have \
    it!</font>\nThat's enough, so hurry on your way~ "
set key[id=803181311004110] name "If you walk around with your bag full, you can't carry anything.\nI'm lucky it's \
    me, but if Senior Brother Junta catches you, you'll be in big trouble.\nTidy up your bag first and come back~ \
    "
set key[id=803181311004111] name "I'm thinking about what to eat tonight, why~\nI have things to do too, so hurry \
    up and go."
set key[id=803181311004112] name "Who goes there, mi? Say the password, yung!"
set key[id=803181311004113] name "(Hand over $item:30000563$.)"
set key[id=803181311004114] name "$MyPCName$...? I got word from $npc:11001707[gender:1]$, mi!\nI've been waiting \
    for you, yung~"
set key[id=803181311004115] name "Perfect timing, human! <font color=\"#ffd200\">$map:52000042$</font> is totally \
    empty right now!\nThe staff all went out on a sales trip, and \nthe one guard left behind went to the \
    restroom, you see! "
set key[id=803181311004116] name "I broke the restroom door, so he won't be coming out anytime soon!\nThis is your \
    chance to go investigate $map:52000042$~\nA special human with the power of Animar... \nYou'll find clues \
    easily, right? I'm counting on you!"
set key[id=803181311004117] name "Okay! Hurry into $map:52000042$ and bring back some clues!\nThe <font \
    color=\"#ffd200\">entrance is on the first floor of the white building</font> just below here! Go on, get in \
    there!\nIf you find anything, bring it straight to me and we'll look at it together!"
set key[id=803181311004118] name "Okay! Hurry into $map:52000042$ and bring back some clues!\nThe <font \
    color=\"#ffd200\">entrance is on the first floor of the white building</font> just below here! Go on, get in \
    there!\nIf you find anything, bring it straight to me and we'll look at it together!"
set key[id=803181311004119] name "$MyPCName$! That was close~ \nThe guard just smashed the restroom door and came \
    out! \nDid you find anything?"
set key[id=803181311004120] name "(Hand over $item:30000562$.)"
set key[id=803181311004121] name "Ohh...? What's this...? \nLet me see that...."
set key[id=803181311004122] name "Was that really the only thing that stood out in there...? \nNothing that \
    reacted to Animar or anything like that? "
set key[id=803181311004123] name "There was nothing like that."
set key[id=803181311004124] name "Hmph... Then, human, take this back... \nI can't read this continent's letters, \
    so I have no idea \nwhat it says here... Mewhuhu...!"
set key[id=803181311004125] name "I'll read it out, so let's go over it together."
set key[id=803181311004126] name "Oho~ Smart human, aren't you? Then read it out loud.\nI'll listen carefully and \
    tell you everything I know right away!"
set key[id=803181311004127] name "(Read the contents out loud.)"
set key[id=803181311004128] name "Hmm... Just as I expected, <font \
    color=\"#ffd200\">$npc:11000354[gender:0]$</font> was the biggest customer~\nBought loads of everything, no \
    matter the kind. \n<font color=\"#ffd200\">$npc:11000244[gender:1]$</font>... is famous for just looking at \
    goods and never buying, right?\nHehehe~ I knew it. Famous for being quite the miser~"
set key[id=803181311004129] name "The name on the last page... did you say <font color=\"#ffd200\">Beyond \
    Link</font>? \nHmm... Beyond Link is a <font color=\"#ffd200\">humanoid engineering research \
    institute</font>.\nThey say they're based near <font color=\"#ffd200\">$map:02000270$</font>."
set key[id=803181311004130] name "<font color=\"#909090\">(Beyond... Link...)</font>"
set key[id=803181311004131] name "They get lots of investment from all over, but... I can't tell \nwhy they \
    collect relics. And only junk, too. That's strange...!"
set key[id=803181311004132] name "<font color=\"#909090\">(It feels familiar... I don't know why, but I feel \
    uneasy.)</font>"
set key[id=803181311004133] name "You'd better take this and look it over carefully <font \
    color=\"#ffd200\">together with $npc:11001707[gender:1]$</font>.\nGood work, human!"
set key[id=803181311004134] name "What is it?"
set key[id=803181311004135] name "I lost <font color=\"#ffd200\">$item:30000562$</font>."
set key[id=803181311004136] name "Don't you want to see your friends?"
set key[id=803181311004137] name "I thought you were smart, human, but I'm disappointed. You dropped it \
    here!\nHere, take it, and keep it safe~ "
set key[id=803181311004138] name "Geez, $MyPCName$! Look in your bag, <font color=\"#ffd200\">you already have \
    it!</font>\nOne is enough, so off you go~ "
set key[id=803181311004139] name "If your bag is stuffed full, you can't take anything.\nSee? Human greed never \
    ends, and you keep repeating the same mistake!\nMeerkats <font color=\"#ffd200\">empty their bags</font> at \
    times like this. You should do the same."
set key[id=803181311004140] name "Think I'll get homesick, being on a business trip this far away?\nAll meerkats \
    have <font color=\"#ffd200\">a professional spirit</font>, so no such thing!\nDon't underestimate our meerkat \
    scouts!"
set key[id=803181311004141] name "$MyPCName$. Where have you been?"
set key[id=803181311004142] name "I went and investigated the place $npc:11001707[gender:1]$ told me about."
set key[id=803181311004143] name "I see. Did you <font color=\"#ffd200\">find</font> anything?"
set key[id=803181311004144] name "(Hand over $item:30000562$.)"
set key[id=803181311004145] name "$item:30000562$... Hmm. It records the people who bought up many relics in \
    $map:02000216$\nin great detail. I once heard about this place from <font \
    color=\"#ffd200\">$npc:11001707[gender:1]$</font>.\nDid you read all of this? Did anyone in it stand out?"
set key[id=803181311004146] name "I'm not sure."
set key[id=803181311004147] name "Investigating the incidents here is your job, yet you're not well-informed about \
    rumors. \nHmm... This page was added recently. <font color=\"#ffd200\">Beyond Link</font>, is it..."
set key[id=803181311004148] name "<font color=\"#909090\">(For some strange reason, that name feels \
    familiar...)</font>"
set key[id=803181311004149] name "Have you heard of this place? \nWhat did the informant you met say about \
    it?\n<font color=\"#909090\">($npcName:11001716[gender:0]$'s gaze is sharp. I don't feel like talking at \
    length.)</font>"
set key[id=803181311004150] name "I haven't heard anything."
set key[id=803181311004151] name "...Is that so? \n<font color=\"#909090\">(I'd better investigate a bit more and \
    sort out my thoughts before I talk with my senior brothers.)</font>"
set key[id=803181311004152] name "I'm not sure."
set key[id=803181311004153] name "...Understood. \nGood work, $MyPCName$."
set key[id=803181311004154] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311004155] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311004156] name "$MyPCName$! \nCome in, I've been waiting for you."
set key[id=803181311004157] name "I got it from Senior $npcName:11001716[gender:0]$, the <font \
    color=\"#ffd200\">$item:30000562$</font> you went and found.\nWhile checking what was written there against \
    the recent flow of goods, \nI found <font color=\"#ffd200\">two suspicious points</font>. "
set key[id=803181311004158] name "First, <font color=\"#ffd200\">$npc:11000252[gender:0]$</font>, who bought the \
    most goods, is smuggling the relics \nhe bought off somewhere. Right after buying, he always shows them off at \
    $map:02000189$ or\nsomewhere crowded, and soon after he locks them away, saying \nhe won't show them to \
    anyone. That's suspicious."
set key[id=803181311004159] name "Second, an institution called <font color=\"#ffd200\">Beyond Link</font> is \
    collecting a huge number of relics, \nnot only from the Black Star Society but through other routes too. They \
    say it's an <font color=\"#ffd200\">institution that researches engineering</font>,\nbut what they buy has \
    nothing to do with their field, and it's far too large-scale. \nThey keep receiving investment too... This \
    doesn't add up."
set key[id=803181311004160] name "I'm keeping a close eye on $npc:11000252[gender:0]$, partly because of the sheer \
    volume.\nSo I'd like you, $MyPCName$, to take on investigating <font color=\"#ffd200\">Beyond Link</font>. \
    \nThink you can do it?"
set key[id=803181311004161] name "No problem."
set key[id=803181311004162] name "You answered faster than usual?\nGood, I'm counting on you then."
set key[id=803181311004163] name "<font color=\"#909090\">(Beyond Link... There's a lot I want to know about them \
    too.)</font>"
set key[id=803181311004164] name "Now then, go meet $npc:11001731[gender:0]$ at \
    $map:03000145$.\n$npc:11001731[gender:0]$ is a prickly guy, but give him this bread and he'll be in a better \
    mood."
set key[id=803181311004165] name "What, is there a problem?"
set key[id=803181311004166] name "(Say I lost <font color=\"#ffd200\">$item:30000563$</font>.)"
set key[id=803181311004167] name "(Ask what she's thinking about.)"
set key[id=803181311004168] name "Geez! Where is your head at? You left it here.\nHere you go. Keep good track of \
    it this time~ "
set key[id=803181311004169] name "Geez, $MyPCName$! Look in your bag, <font color=\"#ffd200\">you have \
    it!</font>\nThat's enough, so hurry on your way~ "
set key[id=803181311004170] name "If you walk around with your bag full, you can't carry anything.\nI'm lucky it's \
    me, but if Senior Brother Junta catches you, you'll be in big trouble.\nTidy up your bag first and come back~ \
    "
set key[id=803181311004171] name "I'm thinking about what to eat tonight, why~\nI have things to do too, so hurry \
    up and go."
set key[id=803181311004172] name "......\n<font color=\"#909090\">(He's hiding in the dark, pretending he can't \
    speak human.)</font>"
set key[id=803181311004173] name "(Hand over $item:30000563$.)"
set key[id=803181311004174] name "Sniff... sniff. A human who brought $item:30000563$... \nI've been waiting for \
    you. <font color=\"#ffd200\">$MyPCName$.</font> "
set key[id=803181311004175] name "I heard from $npc:11001707[gender:1]$. You came to investigate <font \
    color=\"#ffd200\">Beyond Link</font>, right? \nThe entrance to the building I've been watching is up there. \
    \nUnfortunately, I haven't been able to get in yet."
set key[id=803181311004176] name "I can enter anywhere using camouflage. So I've investigated every place \
    connected to <font color=\"#ffd200\">Beyond Link</font>,\nbut that one place, there was just no way in. \
    \nThere are no guards and it looks empty, but\nit's protected by a really powerful <font \
    color=\"#ffd200\">unmanned security system</font>."
set key[id=803181311004177] name "I tried slipping in during the brief gap when someone with clearance went \
    through,\nbut I <font color=\"#ffd200\">failed</font> spectacularly. The <font color=\"#ffd200\">powerful \
    electromagnetic waves</font> around it \nnearly roasted me golden brown."
set key[id=803181311004178] name "But <font color=\"#ffd200\">$npc:11001707[gender:1]$</font> said you're a bit \
    special.\nShe said you'd be different, having inherited a powerful <font color=\"#ffd200\">Animar</font>... \
    \nWell, let's see if that's true."
set key[id=803181311004179] name "Go inside, <font color=\"#ffd200\">go as far as you can and investigate \
    everything in as much detail as possible</font>.\nThat is, <font color=\"#ffd200\">if you manage to get \
    in</font>."
set key[id=803181311004180] name "Go inside, <font color=\"#ffd200\">go as far as you can and investigate \
    everything in as much detail as possible</font>.\nThat is, <font color=\"#ffd200\">if you manage to get \
    in</font>."
set key[id=803181311004181] name "Checking access rights to the Beyond Link database. \nMove your face close to \
    the screen to begin <font color=\"#ffd200\">iris recognition</font>. "
set key[id=803181311004182] name "(Bring my face close.)"
set key[id=803181311004183] name "<font color=\"#ffd200\">Access confirmed: Lost Child</font>\nYou may view the \
    <font color=\"#ffd200\">secret files</font>."
set key[id=803181311004184] name "Select the information to view."
set key[id=803181311004185] name "Secret File 0077. Munakra "
set key[id=803181311004186] name "<font color=\"#ffd200\">Secret File 8824. Frozen Lava</font>"
set key[id=803181311004187] name "Secret File 1411. $map:02000001$ Royal Storehouse"
set key[id=803181311004188] name "Head of Guidance, the one who inherits the spirit of the great Spirit One.\n15th \
    Munakra: <font color=\"#00a2ed\">$npc:11001556[gender:0]$</font>\n<font \
    color=\"#909090\">($npc:11001556[gender:0]$'s name... is here.)</font>"
set key[id=803181311004189] name "Return to the file list"
set key[id=803181311004190] name "Below the volcano is a great cavity of lava, near where animals with the power \
    of fire live.\nAmong the red cracks of the volcano, there is said to be <font color=\"#ffd200\">a fissure \
    where a cold wind blows</font>.\nIf you go near and peer in, the hot steam will hurt your eyes."
set key[id=803181311004191] name "Rumors of this place grew one after another, and many made reckless \
    attempts,\nbut no one solved the secret tied to it.\nThey say only Baba the dog, who first found it, still \
    uses it as a treasure vault\nfor burying the shiny things he finds."
set key[id=803181311004192] name "Though he digs every day at a crack in a rock wall no tool could break,\nBaba's \
    nose is said to remain moist and soft, without a single scratch."
set key[id=803181311004193] name "<font color=\"#ffd200\">Secret File X. Code Zero, Code One, Code Two</font>"
set key[id=803181311004194] name "Go back to the file list"
set key[id=803181311004195] name "The $map:02000001$ Royal Storehouse keeps rare items from all over,\nstrictly \
    guarded by the Royal Guard.\nBut while $npc:11000074[gender:0]$ and $npc:11000119[gender:0]$ were away,\nsome \
    relics were reportedly stolen by a <font color=\"#ffd200\">phantom thief</font>."
set key[id=803181311004196] name "The royal family has made no statement about this,\nbut tried to dismiss the \
    rumor by publicly showing some major relics at an exhibition.\nOf course, the stored relics are so vast that \
    the truth cannot be known."
set key[id=803181311004197] name "Return to the file list"
set key[id=803181311004198] name "Select the information to view."
set key[id=803181311004199] name "Secret File 0014. Munakra "
set key[id=803181311004200] name "<font color=\"#ffd200\">Secret File 8824. Frozen Lava</font>"
set key[id=803181311004201] name "Secret File 8417. $map:02000001$ Royal Storehouse"
set key[id=803181311004202] name "Code Zero\nHand Project: Summoning system organized, pocket-dimension \
    implementation in progress"
set key[id=803181311004203] name "View Code One"
set key[id=803181311004204] name "Code One\nMantra Project: Narvashan refinement rate normal.\nChanges in mind and \
    body detected during injection."
set key[id=803181311004205] name "Next page"
set key[id=803181311004206] name "Large amount of sample data required -\nOf the 100 subjects procured from \
    Katramus through the Red Cloak,\nhalf can transition to Phase 2.\nTransition to Phase 3 requires restoring the \
    missing prototype."
set key[id=803181311004207] name "View Code Two"
set key[id=803181311004208] name "Code Two\nKatramus Project: No need to link with data from $map:03000145$.\nCode \
    One is top priority."
set key[id=803181311004209] name "Next page"
set key[id=803181311004210] name "Code Two may be discarded to support Code One.\n<font color=\"#ffd200\">A new \
    project to improve the condition of the preserved prototype is also under consideration.</font>"
set key[id=803181311004211] name "Next page"
set key[id=803181311004212] name "Further information cannot be viewed. Transmitting all information viewed so \
    far.\nRecipient: <font color=\"#ffd200\">Lost Child</font>"
set key[id=803181311004213] name "<font color=\"#909090\">(Don't tell me... this is...)</font>"
set key[id=803181311004214] name "Sending additional video data to awaken the target. \nData sent: <font \
    color=\"#ffd200\">Mantra Project Laboratory Video Record #17510</font>\nRecipient: <font \
    color=\"#ffd200\">Lost Child</font>"
set key[id=803181311004215] name "System error. Data cannot be resent. \nPlease confirm access rights again \
    through the <font color=\"#ffd200\">door</font>."
set key[id=803181311004216] name "Access system. Checking access rights.\nMove your face close to the screen to \
    begin iris recognition. "
set key[id=803181311004217] name "(Bring my face close.)"
set key[id=803181311004218] name "<font color=\"#ffd200\">Target confirmed: Lost Child</font>\nSystem command: \
    <font color=\"#ffd200\">Absorbing</font> the target's energy."
set key[id=803181311004219] name "We meet again. \nI hoped a moment like this would never come... "
set key[id=803181311004220] name "Where is this place? Who are you?"
set key[id=803181311004221] name "...No. Don't try to learn anything more.\nGo far away. And... forget everything. \
    "
set key[id=803181311004222] name "Beyond Link... Do I really know this place?"
set key[id=803181311004223] name "Don't cling to that. Just leave on your own.\nThe most important thing is... to \
    survive."
set key[id=803181311004224] name "Tell me what you know about the video I saw before I came here."
set key[id=803181311004225] name "Even if I knew, I couldn't tell you.\nIt's all... useless."
set key[id=803181311004226] name "Does this have something to do with the Mantra Project, the experiment that \
    makes clones?"
set key[id=803181311004227] name "Forget that. You have to forget!!"
set key[id=803181311004228] name "The Lost Child... Do you mean me?"
set key[id=803181311004229] name "I hoped it wasn't so... Looks like your memories are starting to return. \nThe \
    memories of <font color=\"#ffd200\">that day</font>, before you were rescued at Neoulbit Mountain..."
set key[id=803181311004230] name "Go, go far away...!"
set key[id=803181311004231] name "We meet again. \nThis time, don't run. We want you to tell us."
set key[id=803181311004232] name "You've crossed paths with us at the <font color=\"#ffd200\">cave where venom \
    flows</font>, haven't you?"
set key[id=803181311004233] name "Yes, I admit it. But that has nothing to do with me, so don't get the wrong \
    idea."
set key[id=803181311004234] name "What is <font color=\"#ffd200\">your identity</font>?"
set key[id=803181311004235] name "I'm a practitioner of a group called Guidance."
set key[id=803181311004236] name "Fine. What is your <font color=\"#ffd200\">purpose</font> in coming here? "
set key[id=803181311004237] name "Like you, I came here looking for information."
set key[id=803181311004238] name "Do you know what the beings in the video we just watched are?"
set key[id=803181311004239] name "They're clones made by Beyond Link. "
set key[id=803181311004240] name "They look a lot like you. Are you one of them too? \nWhy are they making things \
    like that? "
set key[id=803181311004241] name "I don't know exactly myself, so I can't answer that."
set key[id=803181311004242] name "What do you mean you don't know exactly?\n<font color=\"#909090\">(They're also \
    tracing information, so the conversation keeps getting longer.)</font>"
set key[id=803181311004243] name "I lost my memory, and I'm trying to recover it."
set key[id=803181311004244] name "You lost your memory... Yet you came here, so you must be connected to Beyond \
    Link. \nDid you learn anything by investigating this place? \n<font \
    color=\"#909090\">($npcName:11001723[gender:0]$ said someone was chasing me... I should cut this short and get \
    out of here.)</font>"
set key[id=803181311004245] name "I'm being chased, so it's hard to explain in detail."
set key[id=803181311004246] name "...I see. But we need <font color=\"#ffd200\">more detailed information</font> \
    about this place. \nAnd I can't be sure your words can be trusted, either. "
set key[id=803181311004247] name "Use the hub computer to view the information on Code Zero, One and Two. "
set key[id=803181311004248] name "I see... Thank you for sharing the information. \nIt seems the misunderstanding \
    is cleared up. You may go on your way."
set key[id=803181311004249] name "I see... Thank you for sharing the information. \nIt seems the misunderstanding \
    is cleared up. You may go on your way."
set key[id=803181311004250] name "You're back, $MyPCName$.\nYou look quite worn out. Do you have something to tell \
    me?"
set key[id=803181311004251] name "I'll tell you what I found at Beyond Link."
set key[id=803181311004252] name "Right. I'll hear the details together with $npc:11001707[gender:1]$.\nGood work. \
    "
set key[id=803181311004253] name "$MyPCName$, you're here. Good work.\n$npc:11001731[gender:0]$ sent word that you \
    got into that building under <font color=\"#ffd200\">Beyond Link</font> \nsafely. Did you look around inside \
    carefully?"
set key[id=803181311004254] name "I didn't see any collected relics, but I saw the information they've gathered."
set key[id=803181311004255] name "I haven't found a single thing on $npc:11000252[gender:0]$'s side, \nbut I'm \
    glad $MyPCName$ seems to have found something! \nSo, what kind of information did you see?"
set key[id=803181311004256] name "I'll tell you what the secret files said."
set key[id=803181311004257] name "Frozen lava... the rumor of the royal storehouse theft... and then the \
    Master.\nIf <font color=\"#ffd200\">Beyond Link</font> buying up relics means that what they're after \
    is\nGuidance's Divine Relic, then..."
set key[id=803181311004258] name "<font color=\"#909090\">($npc:11001707[gender:1]$'s face turns grave. She seems \
    lost in thought.)</font>"
set key[id=803181311004259] name "The scale and nature of the relics and information they've collected clearly \
    point in <font color=\"#ffd200\">one direction</font>.\nAnd... even the same information \nvaries in value and \
    use depending on who holds it.... "
set key[id=803181311004260] name "What should I do next?"
set key[id=803181311004261] name "From now on I'll focus on <font color=\"#ffd200\">analyzing the clues</font>. \
    \nI'll call you if I find anything, and if something comes to mind, \ntell <font color=\"#ffd200\">Senior \
    $npcName:11001716[gender:0]$ instead of me</font>."
set key[id=803181311004262] name "From now on I'll focus on <font color=\"#ffd200\">analyzing the clues</font>. \
    \nI'll call you if I find anything, and if something comes to mind, \ntell <font color=\"#ffd200\">Senior \
    $npcName:11001716[gender:0]$ instead of me</font>."
set key[id=803181311004263] name "You've found a lot of clues at <font color=\"#ffd200\">Beyond Link</font>. \nI \
    suppose $npc:11001707[gender:1]$ guesses it too, but... to me as well, their aim\ndoesn't look like mere relic \
    collecting. It feels like everything is aimed at\nour <font color=\"#ffd200\">Guidance</font>. "
set key[id=803181311004264] name "<font color=\"#ffd200\">$npc:23000081[gender:0]$</font> who attacked Neoulbit \
    Mountain...\nIf that one and <font color=\"#ffd200\">Beyond Link</font> are no different... if they're after \
    the same thing....\n<font color=\"#909090\">($npcName:11001716[gender:0]$'s face darkens.)</font>"
set key[id=803181311004265] name "$MyPCName$. By any chance... \nwas there anything in the files you saw other \
    than the relics?"
set key[id=803181311004266] name "<font color=\"#909090\">(Lost Child... the name Beyond Link's system called \
    me...)</font>"
set key[id=803181311004267] name "...If you can't recall, you may tell me next time.\nBut, $MyPCName$... \nthere \
    is something I want to <font color=\"#ffd200\">ask</font> of you."
set key[id=803181311004268] name "It's true that I'm not fond of you.\nBut we trained together under <font \
    color=\"#ffd200\">$npc:11001661[gender:0]$</font>, and \nas your <font \
    color=\"#ffd200\">$npcTitle:11001716[gender:0]$</font>, I believe I have a <font color=\"#ffd200\">duty</font> \
    to look after and protect you."
set key[id=803181311004269] name "If something happens to you... if it's hard to get through alone...\n<font \
    color=\"#ffd200\">I want you to trust me, or $npc:11001707[gender:1]$, and tell us.</font>\nNo... I believe \
    you must. Do not forget it."
set key[id=803181311004270] name "I will surely uncover the truth hidden beyond.\nUntil then, I hope you'll stay \
    with us. Please... "
set key[id=803181311004271] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311004272] name "$MyPCName$! This is a message from someone called $npc:11001707[gender:1]$.\nShe \
    says she has something to tell you and wants to meet at $map:52000041$."
set key[id=803181311004273] name "It seems I've finally finished deciphering the clues. \nThe clues you brought \
    from <font color=\"#ffd200\">Beyond Link</font>. "
set key[id=803181311004274] name "<font color=\"#ffd200\">Frozen lava...!</font> Harmony within discord... there's \
    something inside that space. \nOf course they couldn't find it, but we're different. \nWith the <font \
    color=\"#ffd200\">power of Animar</font>, we can find that place and go inside."
set key[id=803181311004275] name "Please explain in detail."
set key[id=803181311004276] name "The first to discover that place was <font color=\"#ffd200\">an animal, not a \
    human</font>. \nBut whenever humans tried to approach, hot steam came out and made it impossible. \nThat's a \
    <font color=\"#ffd200\">safeguard</font> so humans can't get near by force."
set key[id=803181311004277] name "And <font color=\"#ffd200\">two opposing energies coexist</font> there, ice and \
    lava. \nHarmony within discord, the ultimate solution found by facing adversity... \nI once heard that \
    creating <font color=\"#ffd200\">true harmony</font> is both Guidance's teaching and \nthe power the Divine \
    Relic holds."
set key[id=803181311004278] name "If you look closely at the records, it says this. \n<font \
    color=\"#ffd200\">Below the volcano is a great cavity of lava, near where animals with the power of fire \
    live.</font>\nI think it means <font color=\"#ffd200\">$map:02000039$</font>, where $map:02000052$ is."
set key[id=803181311004279] name "Go to $map:02000039$, find the blocked entrance and break through with the power \
    of Animar,\nand you should be able to reach the hidden sacred space. "
set key[id=803181311004280] name "Then let's leave right away."
set key[id=803181311004281] name "Oh, before you go, <font color=\"#ffd200\">Senior \
    $npcName:11001716[gender:0]$</font> has something to tell you.\nGo see him first."
set key[id=803181311004282] name "I was able to confirm it through the informants. \n$npc:23000081[gender:0]$... \
    that one is indeed connected to <font color=\"#ffd200\">Beyond Link</font>.\nBeyond Link is an organization he \
    leads, and everything that goes on there \nis said to be <font color=\"#ffd200\">carried out entirely at his \
    will</font>."
set key[id=803181311004283] name "Then, as I thought... our guess back then was not wrong. \nAnd perhaps we are \
    <font color=\"#ffd200\">very close to our goal</font>. \n...Have you learned anything more since then?"
set key[id=803181311004284] name "<font color=\"#909090\">(...Senior $npcName:11001716[gender:0]$ is looking at me \
    with a sharp gaze.)</font>"
set key[id=803181311004285] name "Or... has anything come to mind or been found since then? \nDo you have nothing \
    to tell me?"
set key[id=803181311004286] name "...Nothing."
set key[id=803181311004287] name "...I see. Then make your preparations and come to the place \
    $npcName:11001707[gender:1]$ mentioned.\nWe'll meet there."
set key[id=803181311004288] name "...I see. Then make your preparations and come to the place \
    $npcName:11001707[gender:1]$ mentioned.\nWe'll meet there."
set key[id=803181311004289] name "$MyPCName$! You found your way. \nThis is truly a <font \
    color=\"#ffd200\">mysterious place</font>. A thin layer of sleet covers the lava. Just like the record \
    said..."
set key[id=803181311004290] name "Looking at this reminds me of $map:63000025$... It makes me nostalgic. \nAnd... \
    I'm sure of it. There must be something here."
set key[id=803181311004291] name "Then let's investigate. First, go over there and start.\nTo save time, it'd be \
    best to check area by area. \n<font color=\"#ffd200\">Come on, this way...!</font> Follow me."
set key[id=803181311004292] name "Then let's investigate. First, go over there and start.\nTo save time, it'd be \
    best to check area by area. \n<font color=\"#ffd200\">Come on, this way...!</font> Follow me."
set key[id=803181311004293] name "You found something! \nWell done, $MyPCName$! "
set key[id=803181311004294] name "Hmm... This... I've seen it before. That censer is called the <font \
    color=\"#ffd200\">Light of Munakra</font>.\n$npc:11001661[gender:0]$ said it's <font color=\"#ffd200\">what \
    guides you when you must find the light</font>.\nLike the Divine Relic, it's said to be passed down to the \
    Munakra."
set key[id=803181311004295] name "With $npcTitle:11001661[gender:0]$ gone now... I can't tell how the <font \
    color=\"#ffd200\">Light of Munakra</font> came to be here,\nbut it seems an important clue for finding the \
    Divine Relic. \nLet's light the <font color=\"#ffd200\">Light of Munakra</font> using $item:30000564$."
set key[id=803181311004296] name "Is that possible without $npcTitle:11001661[gender:0]$?"
set key[id=803181311004297] name "You have $npcTitle:11001661[gender:0]$'s Animar, <font \
    color=\"#ffd200\">$MyPCName$.</font> You're right here.\nNow, go and light the <font color=\"#ffd200\">Light \
    of Munakra</font>."
set key[id=803181311004298] name "You have $npcTitle:11001661[gender:0]$'s Animar, <font \
    color=\"#ffd200\">$MyPCName$.</font> You're right here.\nNow, go and light the <font color=\"#ffd200\">Light \
    of Munakra</font>."
set key[id=803181311004299] name "Explain yourself. \nYou don't look like someone who knows nothing."
set key[id=803181311004300] name "I ask as a fellow disciple who trained together under $npc:11001661[gender:0]$. \
    \nThat word, <font color=\"#ffd200\">return</font>, that word, <font color=\"#ffd200\">Lost Child</font>... \
    are they meant for you?"
set key[id=803181311004301] name "...I think so."
set key[id=803181311004302] name "If so, then it is; if not, then it isn't.\nWhat do you mean, you think so!"
set key[id=803181311004304] name "I see, so you won't speak for now. \nFine. Let's go back to our quarters and \
    talk slowly."
set key[id=803181311004305] name "Senior is... sharp. Don't mind it too much for now. \nHe did say to go back to \
    $map:52000041$ and talk, right?"
set key[id=803181311004307] name "$MyPCName$~ Snap out of it! Are you going to faint again?\nTake the <font \
    color=\"#ffd200\">Light of Munakra</font> and go back to $map:52000041$, and let's think it over slowly."
set key[id=803181311004308] name "$MyPCName$~ Snap out of it! Are you going to faint again?\nTake the <font \
    color=\"#ffd200\">Light of Munakra</font> and go back to $map:52000041$, and let's think it over slowly."
set key[id=803181311004309] name "...You're here, $MyPCName$.\nYou're pretty confused by <font \
    color=\"#ffd200\">Senior $npcName:11001716[gender:0]$'s words</font>, aren't you? \nYou must be, but Senior \
    must also have a lot to think about. "
set key[id=803181311004310] name "(Nod.)"
set key[id=803181311004311] name "As you heard, Senior... has a hard time accepting you."
set key[id=803181311004312] name "Don't you doubt me, $npc:11001707[gender:1]$?"
set key[id=803181311004313] name "I'd be lying if I said no. I'm confused too. \nBut... the <font \
    color=\"#ffd200\">Master</font> told us that even if the truth is one, \nit can look different to each person \
    depending on how they see it."
set key[id=803181311004314] name "Rather than being swayed by something else, I want to believe <font \
    color=\"#ffd200\">the truth I think is right</font>. \nSo... I won't turn my back on anyone, $MyPCName$.\nTo \
    reach my own conclusion, I'll start my own investigation. "
set key[id=803181311004315] name "If you're confused too... and feel you need to find something out, \nstart <font \
    color=\"#ffd200\">your own investigation</font>. \nDon't waver... and don't forget <font color=\"#ffd200\">the \
    Master's teachings</font>. "
set key[id=803181311004316] name "Even if only one path appears before you, \nif your heart says it's not right, \
    <font color=\"#ffd200\">listen to that voice to the end.</font> \nBecause <font color=\"#ffd200\">another path \
    you hadn't noticed</font> may appear... "
set key[id=803181311004317] name "Cheer up, $MyPCName$. You've worked hard so far.\nIf you need my help, come find \
    me. I'll look for you too."
set key[id=804000611004318] name "Either give a <font color=\"#ffd200\">convincing explanation</font>, or give us \
    <font color=\"#ffd200\">information valuable enough</font> that it isn't needed...\nYou must do one of the \
    two."
set key[id=809131203002455] name "Sigh... what on earth is going on... "
set key[id=809131203002456] name "(Ask if something's bothering them.)"
set key[id=809131203002460] name "Ugh... something has been really bugging me lately.\nIt's so frustrating... just \
    hear me out."
set key[id=809131203002461] name "My girlfriend $npc:11000106[gender:1]$ hasn't been in touch at all \
    lately...\n<font color=\"#ffd200\">'What are you doing.'</font>\n<font color=\"#ffd200\">'Why.'</font>\nShe \
    used to send me at least texts like these regularly... "
set key[id=809131203002462] name "Do you know I can't even sleep well lately?\nI can't go on like this!"
set key[id=809131203002463] name "Could you go to <font color=\"#ffd200\">$map:02000162$</font> and get <font \
    color=\"#ffd200\">$item:30000035$</font> from the monsters?\nI'm going to <font color=\"#ffd200\">hack</font> \
    $npc:11000106[gender:1]$'s <font color=\"#ffd200\">text history</font> with it!"
set key[id=809131203002464] name "Once you've collected <font color=\"#ffd200\">$item:30000035$</font>, bring them \
    to Dr. <font color=\"#ffd200\">$npc:11000594[gender:0]$</font> there,\nand he'll tell you what to do!"
set key[id=809151402005719] name "Oh! It's you, right? That person... don't you remember me?\nWe met in \
    $map:63000001$... "
set key[id=809151402005720] name "(Ask whether they know me.)"
set key[id=809151402005721] name "What? You don't recognize me?\nIt's me, $npcName:11000097[gender:0]$! Surely on \
    Maple Island, we...\n<font color=\"#909090\">($npcName:11000097[gender:0]$ stared at my face for a moment, \
    then froze, and finally let out a big sigh.)</font>"
set key[id=809151402005722] name "Haa... I must have mistaken you for someone else.\nYou're clearly a different \
    person, so what made me think I knew you...\nSorry about that. It's nothing, please don't mind it."
set key[id=809151402005723] name "I'd like to invite you in and talk more, but as you can see, I've got \
    another\nunwelcome visitor at the moment and I'm in a bit of a bind...\nBy the way, what brings you here?"
set key[id=809151402005724] name "(Hand over the notebook and ask whose it is.)"
set key[id=809151402005725] name "Ah... this is <font color=\"#ffd200\">issued only to merchants of the Barota \
    Company</font>, but...\nI need to look at it more closely. Please give me some time."
set key[id=809151402005726] name "Hm? You... who are you?\nDid you perhaps come looking for me?"
set key[id=809151402005727] name "I see... can you tell me how you found your way here?"
set key[id=809151402005728] name "(Say I'm chasing $npc:11000064[gender:0]$.)"
set key[id=809151402005729] name "$npc:11000064[gender:0]$?\nYou, after $npc:11000064[gender:0]$...? Why...?"
set key[id=809151402005730] name "(Tell him everything $npc:11000064[gender:0]$ is suspected of.)"
set key[id=809151402005731] name "Oh dear... kidnapping...\nSo that's why $npc:11000064[gender:0]$, in a body that \
    isn't even healed, went to rescue\n$npc:11000069[gender:1]$ who was dragged off to the Land of Darkness...!!"
set key[id=809151402005732] name "(Ask him to explain what happened.)"
set key[id=809151402005733] name "My first meeting with $npc:11000064[gender:0]$ was...\nnear $map:02000238$ at \
    the end of the cliff at $map:02000117$."
set key[id=809151402005734] name "He was covered in blood and lying unconscious, looking as if he'd die any \
    moment.\nI couldn't just leave him like that...\n<font color=\"#909090\">(It's just like when Master and \
    Senior Brother $npcName:11001557[gender:0]$ rescued me...)</font>"
set key[id=809151402005735] name "For days on end... $npc:11000064[gender:0]$ didn't wake up.\nI don't know how \
    much time passed... but eventually he came to... heh heh...\nI still can't forget the first words that fellow \
    spoke."
set key[id=809151402005736] name "(Ask what he said.)"
set key[id=809151402005737] name "<font color=\"#ffd200\">I can't die like this... I won't die...</font>\nI could \
    tell right away that he was someone who had to survive,\nsomeone with something he had to do while alive."
set key[id=809151402005738] name "(Ask what $npc:11000064[gender:0]$ had to do.)"
set key[id=809151402005739] name "<font color=\"#ffd200\">Clear his name and reveal the truth...!</font>\nHe said \
    he couldn't say more than that.\nHe said that if I knew the whole truth, even I could be in danger... "
set key[id=809151402005740] name "(Ask what happened to $npc:11000069[gender:1]$.)"
set key[id=809151402005741] name "$npc:11000064[gender:0]$ said he had to let $npc:11000069[gender:1]$, at least, \
    know that he was innocent.\nBut as a fugitive he couldn't just go and find $npc:11000069[gender:1]$...\nSo the \
    idea he came up with... was to hide notes inside the books of $map:02000221$\nthat the two had visited \
    together since childhood, and trade them that way."
set key[id=809151402005742] name "Then $npc:11000069[gender:1]$ let him know that they wanted to help \
    $npc:11000064[gender:0]$ in person...\nAfter all sorts of twists the two met again, and while they were \
    looking\nfor evidence to clear his name at $map:02000229$...\nthe ones who had chased $npc:11000064[gender:0]$ \
    from the Shadow World... sigh...\nHe was lucky to survive, but it seems those fellows took \
    $npc:11000069[gender:1]$ away."
set key[id=809151402005743] name "Last night, $npc:11000064[gender:0]$ left this one letter,\nasking me to pass it \
    to a friend called $npc:11000529[gender:0]$, and then he went off.\nI never thought he'd recklessly go \
    alone...\nHe'll need people who trust him and can back him up."
set key[id=809151402005744] name "I'll look for other ways to help him, so could you deliver\nthis $item:30000340$ \
    to the friend called $npc:11000529[gender:0]$?"
set key[id=809151402005745] name "Hm... $MyPCName$, it's you.\nGood timing, there's some news I wanted to \
    confirm.\nHave you met $npcName:11000064[gender:0]$ recently...?\nI've heard a <font color=\"#ffd200\">strange \
    rumor</font>..."
set key[id=809151402005746] name "(Ask what the rumor is.)"
set key[id=809151402005747] name "Some time ago I met a wanderer who'd been to the Land of Darkness. He said...\na \
    young man who looks like <font color=\"#ffd200\">$npcName:11000064[gender:0]$</font> was going around looking \
    for <font color=\"#ffd200\">$npcName:11000044[gender:0]$</font> in $map:3000103$.\nJust in case, I sent \
    someone to $map:2000228$ to find out how $npcName:11000064[gender:0]$ is doing... "
set key[id=809151402005748] name "They said $npcName:11000064[gender:0]$ had stepped out, saying he had somewhere \
    to go for a bit.\nI've got an <font color=\"#ffd200\">ominous feeling</font> about it...\nCould you go to \
    <font color=\"#ffd200\">$map:3000103$</font> in the Land of Darkness and find out whether what that wanderer \
    said is true?"

# Quest dialogue of the Striker quests (feature Striker) that no pack has in English: our own
# English for the 178 scriptquest rows of locale KR (or no locale) whose quest a player can get (26 quests),
# with each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=701161202005627] name "Hmm... Fewer customers have been visiting the Black Market lately... \nThe back \
    alleys feel unsettled, and something seems off, so I sent my people to look into it, and\nthey say the leaders \
    of each faction held a secret meeting at $map:02000001$."
set key[id=701161202005628] name "Go meet him at $map:02000001$ and find out why they held a secret meeting.\nIt \
    might have something to do with our business, you know?"
set key[id=701161202005629] name "Haah... What a pain... Bothering people over nothing... tch.\nHm? Who are you... \
    I'm extremely tired right now, so just go away... "
set key[id=701161202005630] name "Ugh, seriously, enough!! I told you to just go away, why do you keep... \nHm? \
    Wait, hold on! You're... the <font color=\"#ffd200\">Ash Wolf</font>?"
set key[id=701161202005631] name "They say somewhere in <font color=\"#ffd200\">$map:02000112$</font> is the \
    entrance\nto the temple of <font color=\"#ffd200\">$npc:23000078$</font>, who sleeps guarding Runicta.\nGoing \
    along with an expedition clearly doesn't suit you... \nIf you're that curious, go find it on your own. "
set key[id=701161202005632] name "You found the temple entrance $npcName:11000050[gender:0]$ told you about.\nYou \
    sense some powerful, unidentifiable force. What could be going on in there...?"
set key[id=701211002005639] name "Welcome.\nHeh, no need to act awkward as if we've just met.\nEveryone here knows \
    you work for me."
set key[id=701211002005640] name "I'm not working for you, so don't get the wrong idea."
set key[id=701211002005641] name "That spirit isn't dead yet, I see... Haha!!"
set key[id=701211005001487] name "For the residents here, this was a chance to see Empress \
    $npcName:11000075[gender:1]$ in person...\nI hear disappointed voices here and there since the audience \
    ceremony was canceled."
set key[id=701211005001488] name "But the Boss smiled when he heard the audience ceremony would be canceled.\nHe \
    quickly found <font color=\"#ffd200\">someone friendly with $npcName:11000492[gender:0]$</font>, the \
    royal-side official, and made arrangements."
set key[id=701211005001489] name "To <font color=\"#ffd200\">buy cheaply or siphon off</font> the goods that were \
    going to be used\nfor the audience ceremony and became useless."
set key[id=701211005001490] name "He's... a more astonishing person the more you know him."
set key[id=701211005001491] name "First, the Boss handed the money meant as a bribe\nto the one friendly with the \
    royal-side official."
set key[id=701211005001492] name "Whether that money was actually delivered, I don't know. Heh."
set key[id=701211005001493] name "You should now keep watch on $npcName:11000492[gender:0]$ and see if there's \
    anything to hold against him.\nBefore you look for $npcName:11000492[gender:0]$, go talk with the people \
    here.\nYou might get some unexpected information about $npcName:11000492[gender:0]$..."
set key[id=701211005001494] name "If you're unsure who to meet, start with <font \
    color=\"#ffd200\">$npcName:11000003[gender:0]$</font> at $map:02000001$.\nI ran into him on the way here, and \
    he seemed to have a lot of complaints about the audience cancellation.\nPeople with lots of complaints will \
    talk about anything."
set key[id=701211005001495] name "They say you can know the depth of ten fathoms of water but not the depth of a \
    person's heart.\nTo think a guy like $npcName:11000492[gender:0]$ fooled everyone...\nWhat nerve, how did he \
    think of cleaning out the armory!"
set key[id=701211005001496] name "And did you hear? \nThe warehouse in $map:02000064$ was also leased in the royal \
    family's name by $npcName:11000492[gender:0]$ without telling them.\nHe'd even prepared a warehouse in advance \
    to secretly siphon off royal weapons!"
set key[id=701211005001497] name "When you think about it, that $npcName:11000492[gender:0]$ bastard is worse than \
    us!\nWith things like this,\nthe Boss's plan to siphon off the audience goods through \
    $npcName:11000492[gender:0]$ has gone up in smoke..."
set key[id=701211005001498] name "Hey, $npcName:11001674[gender:0]$! Did you report to headquarters?"
set key[id=701211005001499] name "They say people are scarier than tigers..."
set key[id=701211005001500] name "Damn, how am I supposed to report in this situation?\nThe plan fell apart. You \
    think the Boss is going to praise us for the effort?"
set key[id=701211005001501] name "All right... let's think about this..."
set key[id=701211005001502] name "If we catch $npcName:11000492[gender:0]$ and make him kneel before the \
    Boss,\nwouldn't the arrows meant for us go to him instead?"
set key[id=701211005001503] name "It's because $npcName:11000492[gender:0]$ beat us to it that things got \
    tangled.\nWhat do you think? Ash Wolf!"
set key[id=701211005001504] name "I don't care whether the Black Star Society's plan fell apart or not."
set key[id=701211005001505] name "Tch, $npcName:11001674[gender:0]$! What do you think?"
set key[id=701211005001506] name "Ugh, what a headache."
set key[id=701211005001507] name "What else can we do? Let's try that at least.\nAsh Wolf! Hurry and go find \
    $npcName:11000492[gender:0]$."
set key[id=701211005001508] name "Why are you hesitating? Speak up."
set key[id=701211005001509] name "I've been investigating the distribution of banned goods."
set key[id=701211005001510] name "And?"
set key[id=701211005001511] name "I found that the Black Star Society is deeply involved."
set key[id=701211005001512] name "<font color=\"#909090\">(Nodding)</font> Right, our Black Star Society is \
    involved in that... \nSo?"
set key[id=701211005001513] name "I passed the findings on to $npcName:11000044[gender:0]$ as well."
set key[id=701211005001514] name "It won't be surprising or new information for Dark Wind either, will it?\nBefore \
    the Black Star Society, other organizations also distributed $item:20000046$ and $item:20000015$.\nNow it's \
    the Black Star Society's monopoly, that's all."
set key[id=701211005001515] name "$map:02000100$ is just that kind of place. Everyone knows and pretends not \
    to!\nOnly Dark Wind picks a fight over every little thing...\nPests like mosquitoes! Nobodies who are just a \
    nuisance!"
set key[id=701211005001516] name "Don't you agree, $npcName:11001674[gender:0]$?"
set key[id=701211005001517] name "Ugh, those mosquito-like pests!"
set key[id=701211005001518] name "Why even ask?\nBy the way, it seems you've gotten friendly with the Dark Wind \
    side too, huh?\nYou didn't say anything else useless besides the $item:20000015$ stuff, did you?"
set key[id=701211005001519] name "Don't worry, I won't make trouble for you."
set key[id=701211005001520] name "Hey, I'm saying this for your sake.\nIf you slip up and tell them you're working \
    with us,\nthose guys won't leave you alone."
set key[id=701211005001521] name "Even inside the Black Star Society, few people know you're working with us.\nThe \
    Boss was just being considerate, in case your position gets awkward later\nbecause of working with us."
set key[id=701211005001522] name "Hey, Ash Wolf!\nFrom now on, you act as our spy."
set key[id=701211005001523] name "Dark Wind keeps trying to mess with us lately, so\nkeep going in and out of \
    $map:02000153$ like you've been doing,\nand if they act suspicious, report to us right away!"
set key[id=701211005001524] name "Being a spy doesn't suit my personality."
set key[id=701211005001525] name "You think I work with that idiot $npcName:11001682[gender:0]$ because it suits \
    my personality?\nI do it because I'm told to! You and I both have to listen to the Boss!\nThis job is the \
    Boss's order too!\nSo don't talk back with this and that, just do it!"
set key[id=701211005001526] name "You're a tiring type too."
set key[id=701211005001527] name "Hey, $npcName:11001674[gender:0]$! Why's my name suddenly coming up?\nYou think \
    I work with you because I want to?"
set key[id=701211005001528] name "Ash Wolf! Don't listen to a guy like that!"
set key[id=701211005001529] name "It's the Boss's order. Can I just ignore it?"
set key[id=701211005001530] name "Ah, right. Damn.\nGo quickly and find out what Dark Wind is up to!"
set key[id=701211005001531] name "<font color=\"#909090\">(Picks up the notebook lying on the desk.)</font>\nMy \
    boys brought me this.\nOpen it and see what's written."
set key[id=701211005001532] name "What's wrong?"
set key[id=701211005001533] name "Even if it got out that you work for the Black Star Society, no harm would come \
    to me.\nBut your position would get awkward. Heh."
set key[id=701211005001534] name "You'd better watch your step."
set key[id=701211005001535] name "Ash Wolf!\nWhat a long time since I last called that name!"
set key[id=701211005001536] name "Your name vanished from around Kerning City long ago...\nLooks like nobody \
    misses you. Heh heh!"
set key[id=701211005001537] name "Don't be hurt. Heh."
set key[id=701211005001538] name "Nice to see you here.\nIs a place like this unfamiliar to someone from the back \
    alleys like you?\nDon't be nervous. This is just a market where goods are bought and sold."
set key[id=701211005001539] name "I heard the rumor that you investigated because Dark Wind\nnamed the Humples as \
    the culprits behind the audience goods theft."
set key[id=701211005001540] name "So what was the conclusion?\nWere the Humples, or rather \
    $npcName:11000006[gender:0]$, the culprit?"
set key[id=701211005001541] name "I think someone tried to frame the Humples."
set key[id=701211005001542] name "I don't think the Humples did it either.\nNot unless they're idiots."
set key[id=701211005001543] name "The Humples aren't an organization big enough to handle trouble when it \
    comes.\nThey're not worth worrying about for the Black Star Society either. Hehehe!"
set key[id=701211005001544] name "If they know their place, there's no way the Humples would have done it."
set key[id=701211005001545] name "Except... $npcName:11000006[gender:0]$. That one is an exception.\nHe's \
    extraordinary in many ways."
set key[id=701211005001546] name "$npcName:11000044[gender:0]$ said they got a tip that the Humples were behind \
    the theft, right?\nI don't know who gave such a tip, but it probably wasn't aimed at the Humples.\nIt must \
    have been aimed at $npcName:11000006[gender:0]$."
set key[id=701211005001547] name "Who could it have been? The one who framed $npcName:11000006[gender:0]$.\nHeh, \
    if you ask $npcName:11000044[gender:0]$, would he tell you?"
set key[id=701211005001548] name "Oh, since you've come all this way, why not look around $map:02000216$?\nTalk to \
    the traders and they'll show you what you can buy.\nIf you have something to sell... ask the traders as well."
set key[id=701211005001549] name "Hey, you, hold on...!\n<font color=\"#909090\">(Frowning deeply, glances back \
    and forth between the photo in hand and the Ash Wolf.)</font>"
set key[id=701211005001550] name "Ash Wolf... it's you? I didn't recognize you at all.\nYou should've told me \
    earlier. You confuse people... tch!"
set key[id=701211005001551] name "These are the Boss's orders, so listen up!"
set key[id=701211005001552] name "There's a research institute called Beyond Link based in the $map:02000270$ \
    area,\nand apparently a building managed by Beyond Link was found near here or something."
set key[id=701211005001553] name "I don't know why, but the order is to investigate that \
    building!\n$npcName:11001678[gender:0]$ and one other guy... who was it? Elizabeth?\nAnyway, those two went \
    there, so hurry over there too."
set key[id=701211005001554] name "Those two are all talk and rumored to be terrible fighters.\nI don't know how \
    dangerous the place is, but they'll need your help."
set key[id=701211005001555] name "Why are you still standing here?"
set key[id=701211005001556] name "Phew, I was just about to smash those guys with my kicks...\nYou beat me by half \
    a beat."
set key[id=701211005001557] name "Anyway, thanks to you I saved my strength... Thanks."
set key[id=701211005001558] name "Why does an abandoned warehouse with no caretaker have a security system?\nDamn, \
    I let my guard down and made a fool of myself."
set key[id=701211005001559] name "Hey, doesn't something smell fishy here?\nA security system like this in a dusty \
    warehouse... suspicious?\nLet's search some more."
set key[id=701211005001560] name "Search every place that looks suspicious."
set key[id=701211005001561] name "Found anything?"
set key[id=701211005001562] name "I couldn't find any useful information."
set key[id=701211005001563] name "You looked like you were working hard, but not much to show for it!\nLet's keep \
    searching."
set key[id=701211005001564] name "The guys who attacked us earlier, I picked up an electronic chip from the \
    wreckage...\nLet's see what's written on it...\nTch! They wrote it in such tiny print."
set key[id=701211005001565] name "Wait... Beyond Link database hub infrastructure core and blah blah...\nWhy'd \
    they write so much in such hard words. Damn."
set key[id=701211005001566] name "...Huh? Hey, found it! This is it. <font color=\"#ffd200\">$map:03000145$</font> \
    data hub...\nData hub? Hmm... what does that mean?"
set key[id=701211005001567] name "I don't understand a thing."
set key[id=701211005001568] name "Ah, whatever it means, it's connected to \
    $map:03000145$.\n$npcName:11001678[gender:0]$, let's head to $map:03000145$."
set key[id=701211005001569] name "Ash Wolf!\nWe'll contact you again later through $npcName:11000610[gender:0]$, \
    so wait."
set key[id=701211005001570] name "$npcName:11001679[gender:0]$ and one other guy... ah, I can't remember his name \
    again. Eli? $npcName:11001687[gender:0]$?\nAnyway, those two went to $map:52000039$ in $map:03000145$."
set key[id=701211005001571] name "You've been ordered to join them too, so hurry over to them.\nThey might be \
    panicking in danger!"
set key[id=701211005001572] name "Hurry over there."
set key[id=701211005001573] name "Why are you only getting here now?\nWell, at least you're here now, thank \
    goodness!!!"
set key[id=701211005001574] name "$npcName:11001679[gender:0]$ was dragged off by a monster.\nWe have to find him \
    quickly."
set key[id=701211005001575] name "We don't have time to talk like this.\nHurry and follow me."
set key[id=701211005001576] name "We have to find $npcName:11001679[gender:0]$ fast!"
set key[id=701211005001577] name "Huff huff...\nA-Ash Wolf... I'm fine... I'm fine..."
set key[id=701211005001578] name "Um, can you check on $npcName:11001687[gender:0]$ over there? How's that guy \
    doing?"
set key[id=701211005001579] name "I-I'm fine too! Thanks, <font color=\"#ffd200\">$MyPCName$</font>!\nNo wonder \
    they call you the <font color=\"#ffd200\">Ash Wolf</font>."
set key[id=701211005001580] name "This is no time to be lounging around.\nNow that we've saved \
    $npcName:11001679[gender:0]$, let's investigate this place quickly!"
set key[id=701211005001581] name "Let's hurry!"
set key[id=701211005001582] name "Isn't this too big a job for us to investigate?\nTo find out what Beyond Link \
    really is, we'd have to infiltrate or storm\nthe Beyond Link Center, it seems."
set key[id=701211005001583] name "I think we should stop investigating here\nand report everything so far to the \
    Boss."
set key[id=701211005001584] name "Ash Wolf, let's wrap up the investigation here for now."
set key[id=701211005001585] name "Didn't $npcName:11001674[gender:0]$ or $npcName:11001682[gender:0]$ contact \
    you?\nThe Boss is looking for you.\nGo to $map:02000156$ and meet the Boss."
set key[id=701211005001586] name "Go to $map:02000156$."
set key[id=701211005001587] name "I've heard everything about what happened at $map:03000145$."
set key[id=701211005001588] name "I'll investigate the Beyond Link headquarters."
set key[id=701211005001589] name "Whether Beyond Link makes robots or clones is none of my business.\nWhat matters \
    is how much profit they make to fill my pockets."
set key[id=701211005001590] name "Countless companies and individuals put money into Beyond Link.\nIn other words, \
    their interests are woven together like a tight net."
set key[id=701211005001591] name "Touch it carelessly, and who knows where the sparks will fly.\nDo you think I'd \
    allow you something that could end up hurting me?"
set key[id=701211005001592] name "You're the one who ordered me to investigate Beyond Link in the first place."
set key[id=701211005001593] name "Right, the investigation ends here."
set key[id=701211005001594] name "Did you find out what you wanted to know?"
set key[id=701211005001595] name "I never allowed questions!"
set key[id=701211005001596] name "Hmm...\n<font color=\"#909090\">(He seems lost in thought.)</font>"
set key[id=701211005001597] name "I heard a person called the Red Cloak seems to be connected to Beyond \
    Link.\nAccording to my information, the Royal Guard will pursue the Red Cloak,\nso first, help the Royal Guard \
    and catch that person."
set key[id=702140505001598] name "Captain $npcName:11000044[gender:0]$ is looking for you.\nPlease go in."
set key[id=702140505001599] name "Captain $npcName:11000044[gender:0]$ is looking for you.\nPlease go in."
set key[id=702140505001600] name "Ah, you're here!"
set key[id=702152105001601] name "Captain $npcName:11000044[gender:0]$ is looking for you.\nPlease go in."
set key[id=702152105001602] name "Captain $npcName:11000044[gender:0]$ is looking for you.\nPlease go in."
set key[id=702152105001603] name "Ah, you're here!"
set key[id=704170602005642] name "They say <font color=\"#ffd200\">$npcName:11000050[gender:0]$</font>, a thief \
    quite famous in these back alleys, attended too.\nGo meet him at $map:02000001$ and find out why they held a \
    secret meeting.\nIt might have something to do with our business, you know?"
set key[id=704170602005643] name "<font color=\"#909090\">(Raise one hand to cover my face)</font>"
set key[id=704170602005644] name "Heh. Covering up like that won't hide you. \nYou act like you'd kill time in the \
    back alleys forever, so what brings you here?"
set key[id=704170602005645] name "I ask about the secret gathering held on the Empress's orders."
set key[id=704170602005646] name "Oh, that? Tch... it's nothing much. \nThey gathered us to drag us into the <font \
    color=\"#ffd200\">Rune Blader</font> family feud.\nIt has nothing to do with us, so why did Jonathan get \
    involved... sigh... \nIt's Jonathan, so I listen. Tch."
set key[id=704170602005647] name "(Say I'd like to hear the details.)"
set key[id=704170602005648] name "Well, apparently there was a traitor inside the Rune Bladers, <font \
    color=\"#ffd200\">$npcName:11001231[gender:0]$</font>.\nThe Rune Bladers chased him all the way here after he \
    killed their leader and vanished,\nand what <font color=\"#ffd200\">$npcName:11001231[gender:0]$</font> was \
    after was supposedly the <font color=\"#ffd200\">Runicta</font> hidden by ancient rune sorcerers...? "
set key[id=704170602005649] name "Anyway, they asked us to join the <font color=\"#ffd200\">Starlight \
    Expedition</font> and help stop <font color=\"#ffd200\">$npcName:11001231[gender:0]$</font> \nfrom seizing \
    <font color=\"#ffd200\">Runicta</font>.\nPersonally I'd rather quit getting dragged into someone else's family \
    feud... \nbut <font color=\"#ffd200\">Jonathan</font>, who leads us thieves, told us to cooperate with the \
    Rune Bladers... \nWell... Jonathan must have his own reasons... \n"
set key[id=704170602005650] name "Phew... well, with everyone lending a hand, things moved along quite fast.\nWe \
    found out where <font color=\"#ffd200\">$npcName:11001231[gender:0]$</font> went chasing the <font \
    color=\"#ffd200\">Runicta</font>."
set key[id=704170602005651] name "(Ask where that is.)"
set key[id=704170602005652] name "Hm? What? <font color=\"#ffd200\">Ash Wolf</font>... you're going to take a look \
    too?\nI guess... you're no slouch when it comes to competitiveness. You might be curious how strong \n<font \
    color=\"#ffd200\">$npcName:11001231[gender:0]$</font> is."
set key[id=704170602005653] name "They say somewhere in <font color=\"#ffd200\">$map:02000112$</font> is the \
    entrance\nto the temple of <font color=\"#ffd200\">$npc:23000078$</font>, who sleeps guarding Runicta.\nGoing \
    along with an expedition clearly doesn't suit you... \nIf you're that curious, go find it on your own. "
set key[id=704200202005654] name "The doors of the government office are firmly locked, and there's no sign of \
    anyone.\nSomeone may have seen $npc:11000492[gender:0]$ lock the doors and leave.\nLet's ask the residents \
    around the office."
set key[id=705124505001604] name "While the interior of that building was being renovated, the noise and \
    dust\nmade guard duty really hard.\nMy ears are still ringing and my throat is still tight."
set key[id=705124505001605] name "I don't know why the construction stopped,\nbut I hope it doesn't resume before \
    I get reassigned."
set key[id=705124505001606] name "If you happen to meet anyone connected to the construction, tell them to delay \
    it a bit longer. Haha.\nThe building where the construction took place is down there, below the Royal Guard \
    statue."
set key[id=705124505001607] name "Go to the house below the Royal Guard statue."
set key[id=705124505001608] name "Welcome. You found the place well."
set key[id=705202805001609] name "Let's look around $npc:11000492[gender:0]$ for anything that could be a clue."
set key[id=705202805001610] name "Let's look around $npc:11000492[gender:0]$ for anything that could be a clue."
set key[id=705202805001611] name "$MyPCName$!!\nJust before the Royal Guard investigation started, \
    $npc:11000492[gender:0]$ -- no, $npc:11000492[gender:0]$\ndisappeared, and everything's in an uproar. \nWhere \
    have you been all this time?"
set key[id=705202805001612] name "(Tell him what happened at $map:52000037$.)"
set key[id=705202805001613] name "What? $npc:11000492[gender:0]$... that person is dead? Haah... Oh no... \nWe \
    can't stay here like this. We have to tell $npc:11000119[gender:0]$ quickly."
set key[id=705202805001614] name "Please tell $npc:11000119[gender:0]$ in person, $MyPCName$, everything about \
    your investigation so far\nand that notebook you've just found, in detail.\nPlease."
set key[id=705202805001615] name "Did you leave something behind?"
set key[id=705202805001616] name "(Say I left $item:30000023$ behind.)"
set key[id=705202805001617] name "(Say I forgot what I was asked to do.)"
set key[id=705202805001618] name "Ah, right. Here you go."
set key[id=705202805001619] name "You looked like you were putting it in your bag just now...\nPlease check your \
    bag again."
set key[id=705202805001620] name "Your bag looks too heavy...\nWhy don't you tidy it up a bit?"
set key[id=705202805001621] name "Please tell $npc:11000119[gender:0]$ in detail about the investigation so \
    far\nand the notebook you found."
set key[id=705202805001622] name "$MyPCName$?\nAh, so you're the one who investigated the armory theft\nat \
    $npc:11000169[gender:0]$'s request."
set key[id=705202805001623] name "We started investigating $npc:11000492[gender:0]$ right after \
    $npc:11000169[gender:0]$'s tip,\nbut his whereabouts are unknown. He left nothing behind."
set key[id=705202805001624] name "Let me tell you what's happened since."
set key[id=705202805001625] name "What? Is that true? $npc:11000492[gender:0]$ is dead...\nBefore we could even \
    uncover the truth of the armory theft... it never rains but it pours.\nWith no clues at all, this is \
    troublesome...  "
set key[id=705202805001626] name "(Hand over the notebook found in $npc:11000492[gender:0]$'s bag.)"
set key[id=705202805001627] name "What's this...?\nHm? Wait... this looks like the notebook used by Barota Company \
    peddlers...\nWhere did you find it?"
set key[id=705202805001628] name "(Say I found it among the clothes in $npc:11000492[gender:0]$'s bag.)"
set key[id=705202805001629] name "Wait... clothes in $npc:11000492[gender:0]$'s luggage bag... hmm...\nWe found no \
    sign at all of $npc:11000492[gender:0]$ packing his things at his home or city hall.\nEverything was left as \
    it was.\nYet there were clothes in the bag found beside the dead $npc:11000492[gender:0]$... and this \
    notebook... "
set key[id=705202805001630] name "Maybe that bag belongs to someone other than $npc:11000492[gender:0]$.\nThere's \
    still room for investigation!"
set key[id=706133405001631] name "I dropped $item:39000050$."
set key[id=706133405001632] name "I just wanted to talk."
set key[id=706133405001633] name "To drop what I handed you...\nConsider it an honor that I personally bent down \
    to pick it up. Heh."
set key[id=706133405001634] name "You're out of it. I saw you stuff it into your bag earlier."
set key[id=706133405001635] name "I personally bent down to pick it up, yet...\nYour bag is full, so I can't hand \
    it over."
set key[id=706133405001636] name "Right, now hurry and see what's written!"
set key[id=713154405001637] name "Ash Wolf!\nCome talk with us too."
set key[id=713154405001638] name "Ugh, how could this happen?"
set key[id=713154405001639] name "Listen to me!\nHow could something like this happen?"
set key[id=713154405001640] name "Ash Wolf!\nI called you because I wanted to see your face after so long."
set key[id=713154405001641] name "It's not like we can't see each other."
set key[id=713154405001642] name "I didn't call you because I have anything to say.\nCall it a courtesy meeting? \
    Heh heh.\nHm? You're the one who looks like you have something to say."

# Quest dialogue of the KarkarIsland quests (feature KarkarIsland) that no pack has in English: our own
# English for the 160 scriptquest rows of locale KR (or no locale) whose quest a player can get (9 quests),
# with each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=129210511002859] name "Hello, $MyPCName$. \nYou came at just the right time. I had something to tell \
    you...!"
set key[id=129210511002860] name "Ask if it's about <font color=\"#ffd200\">$npcName:11001392[gender:1]$</font>."
set key[id=129210511002861] name "After what happened with <font \
    color=\"#ffd200\">$npcName:11001392[gender:1]$</font>, I thought it over for a long time and then went to see \
    <font color=\"#ffd200\">$npcName:11001397[gender:0]$</font>.\nI told him everything that happened and asked \
    what on earth went wrong.\nAnd then $npcName:11001397[gender:0]$ shouted at me."
set key[id=129210511002862] name "Ask what he means, he shouted?"
set key[id=129210511002863] name "He said the medicine I mixed was made for <font color=\"#ffd200\">a healthy \
    adult man</font>. \nHe asked if I was out of my mind to use it on a child patient whose body had grown so \
    weak,\nand said that for medicine to work, <font color=\"#ffd200\">the patient's condition</font> has to \
    support it."
set key[id=129210511002864] name "Ask if that's right."
set key[id=129210511002865] name "Yes, he has a point. Even doctors check <font color=\"#ffd200\">the patient's \
    condition</font> first when using medicine.\nI overlooked it. I was so happy to think I could keep my promise \
    that I just... \nAnd because of me, $npcName:11001392[gender:1]$... sob... "
set key[id=129210511002866] name "Comfort $npcName:11001396[gender:1]$."
set key[id=129210511002867] name "...But it's true that my mistake caused $npcName:11001392[gender:1]$ pain.\nSo \
    this time I really want to be <font color=\"#ffd200\">careful</font>. Even if only for \
    $npcName:11001392[gender:1]$'s sake. \nHere, please take this. "
set key[id=129210511002868] name "Accept the <font color=\"#ffd200\">small vial</font> \
    $npcName:11001396[gender:1]$ takes out."
set key[id=129210511002869] name "I got a detailed explanation from $npcName:11001397[gender:0]$, improved on it a \
    bit, and we made this together.\nIt's a <font color=\"#ffd200\">gentle medicine</font> for a weakened <font \
    color=\"#ffd200\">young patient</font> like $npcName:11001392[gender:1]$.\nBut before giving this to \
    $npcName:11001392[gender:1]$... I think it needs to be <font color=\"#ffd200\">checked</font>."
set key[id=129210511002870] name "Ask how it will be checked."
set key[id=129210511002871] name "Could you take this medicine to <font \
    color=\"#ffd200\">$npc:11001443[gender:0]$</font> at <font color=\"#ffd200\">$map:02010063$</font>? \nHe's had \
    a lot of experience and was recently treating the patients of $map:02010005$,\nso I think he can examine it \
    best. If you ask him, he'll surely help. "
set key[id=129210511002872] name "What's wrong, $MyPCName$?"
set key[id=129210511002873] name "Say I lost the <font color=\"#ffd200\">$item:30000520$</font>."
set key[id=129210511002874] name "Ask if she's calmed down a bit."
set key[id=129210511002875] name "Here, I'll give you the one I kept for research.\nIt's a medicine that could be \
    hope for $npcName:11001392[gender:1]$ and the people in $map:02010005$,\nso please handle it with care this \
    time. "
set key[id=129210511002876] name "$MyPCName$... look in your bag. <font color=\"#ffd200\">I think you have \
    it.</font>\nTake it to $npc:11001443[gender:0]$. That should be enough."
set key[id=129210511002877] name "Please clear out your bag first. \nIf it's that full, there won't be room for \
    the medicine."
set key[id=129210511002878] name "I can't just sit here worrying forever.\nI'll find a way, verify it properly, \
    and make sure $npcName:11001392[gender:1]$ gets better.\nSo that such pain never happens again...! "
set key[id=129210511002879] name "Oh, you...? \nAren't you <font color=\"#ffd200\">$MyPCName$</font>? What brings \
    you here?"
set key[id=129210511002880] name "Hold out $item:30000520$ and relay <font \
    color=\"#ffd200\">$npcName:11001396[gender:1]$'s request</font>."
set key[id=129210511002881] name "Ah... so that's what happened. \nLet's take a look, shall we? "
set key[id=129210511002882] name "I looked over the medicine you brought. It has no particular color or taste, \
    \nbut it gives off a peculiar, bittersweet smell. I think it contains <font color=\"#ffd200\">moromoro \
    herb</font>. \nIt's the cure-all herb of the Moropapa tribe, great for calming and regenerating the body. \
    \nAnd so far there have been no known <font color=\"#ffd200\">side effects</font>, <font \
    color=\"#ffd200\">none at all.</font> "
set key[id=129210511002883] name "I don't know how the earlier medicine turned out, but I don't think you need to \
    worry about side effects with <font color=\"#ffd200\">this one</font>. \nIn fact, the patients in \
    $map:02010005$ \ntold me they feel nothing wrong apart from their skin changing color and itching."
set key[id=129210511002884] name "(Ask why the villagers are so wary of the patients, then.)"
set key[id=129210511002885] name "Honestly... I don't know either. It's a plain skin disease, and it isn't \
    contagious at all.\nThis talk of a curse... there were no such stories before.\nBecause of <font \
    color=\"#ffd200\">baseless, ominous rumors</font> like that, more and more people are <font \
    color=\"#ffd200\">leaving the desert</font>. \nThat's why, as a doctor, I feel responsible and want to treat \
    the patients, but... "
set key[id=129210511002886] name "Some of the more sensitive villagers see me heading toward the huts \nand get \
    furious and try to stop me. They say the healthy ones have to live too.\nSo it's been a hard situation for \
    me... but to think there are <font color=\"#ffd200\">people making such an effort</font>,\nI'm truly grateful. \
    I'd like to try this medicine on $npcName:11001392[gender:1]$."
set key[id=129210511002887] name "However... the child patient who suffered the side effects, and the sibling who \
    watched it happen, \n<font color=\"#ffd200\">won't take the medicine or let it be given.</font> They'll be \
    terrified\nthat awful thing will happen again. And their strength is failing too..."
set key[id=129210511002888] name "(Suggest mixing the medicine into their food.)"
set key[id=129210511002889] name "That's a good idea. This medicine happens to have no color or taste and only a \
    faint smell.\nWhy not talk it over with <font color=\"#ffd200\">$npcName:11001388[gender:1]$</font>, the best \
    cook in the village?\nShe's a warm-hearted person and has often worried about the patients in $map:02010005$."
set key[id=129210511002890] name "(Ask where <font color=\"#ffd200\">$npcName:11001388[gender:1]$</font> is.)"
set key[id=129210511002891] name "The blue-roofed house near the exit toward $map:02010036$ is \
    $npcName:11001388[gender:1]$'s home. \nYou should be able to meet her in front of it. Here, take this medicine \
    with you."
set key[id=129210511002892] name "Hm...? Is something the matter?"
set key[id=129210511002893] name "Say I lost the <font color=\"#ffd200\">$item:30000520$</font>."
set key[id=129210511002894] name "(Ask how the mood in the village has been lately.)"
set key[id=129210511002895] name "I thought I saw you drop something, and sure enough. \nHere you go. Carry it \
    carefully."
set key[id=129210511002896] name "You're not very careful, are you? It looks like it's right there in your \
    bag.\nCome now, hurry and go consult <font color=\"#ffd200\">$npcName:11001388[gender:1]$</font>, \nthe best \
    cook in our village."
set key[id=129210511002897] name "Please tidy up your bag first. \nIf it's that full, there won't be room for the \
    medicine."
set key[id=129210511002898] name "Nothing has changed much. \nNo one has caught that disease except the people \
    isolated in $map:02010005$.\nAt least, no villager has come to me saying they might have the symptoms."
set key[id=129210511002899] name "Oh my? Did you come looking for me? "
set key[id=129210511002900] name "(Explain what has happened so far and ask for help.)"
set key[id=129210511002901] name "Goodness, to think such a thing happened...! \nWell then, if there's anything I \
    can do, I'll surely help. "
set key[id=129210511002902] name "Waited long, did you? Here, take this. I packed some snakehead soup and a few \
    rice balls.\nSnakehead soup is the best food for people recovering their strength.\nI'm sure <font \
    color=\"#ffd200\">those children</font> will feel warm and get their strength back if they eat it."
set key[id=129210511002903] name "Oh my, honestly... the more I think about it, the sadder it is. \nThe people of \
    this village were never so cold-hearted.\nFor days there was only daytime with no night, then monsters \
    suddenly multiplied \nand a drought hit... and with the <font color=\"#ffd200\">development rumors</font> too, \
    kindness dried up here."
set key[id=129210511002904] name "So the doctor had his reasons too... I didn't know, and \nI'd been thinking \
    educated folk were cold.\nActually, I heard patients were isolated in $map:02010005$ and went to see them a \
    few times.\nThere were only two children there, and I wondered what their story was, and felt sorry for \
    them..."
set key[id=129210511002905] name "Tell those children I'll come to visit them again soon.\nThey must be lonely and \
    having a hard time, and I'd like to be a family to them, even if it's only me.\nFamily isn't only blood. If \
    hearts are joined, that's family. "
set key[id=129210511002906] name "Still, $MyPCName$, I'm glad there are good people like you.\nI hope your \
    kindness reaches them and <font color=\"#ffd200\">the children get better</font>. Please take care of it for \
    me. "
set key[id=129210511002907] name "What is it, is something wrong?"
set key[id=129210511002908] name "(Say you lost <font color=\"#ffd200\">$item:30000521$</font>.)"
set key[id=129210511002909] name "(Say she seems like a truly good person and thank her.)"
set key[id=129210511002910] name "Honestly, you're so careless! You left it right here. \nHere you go. Keep good \
    hold of it this time, all right? "
set key[id=129210511002911] name "Hohoho, you silly thing. Look at your bag. <font color=\"#ffd200\">You already \
    have it!</font>\nThat's plenty, so hurry on to the children. "
set key[id=129210511002912] name "Carrying such a load, you can't take a lunchbox with you.\nTidy up your bag and \
    come back. "
set key[id=129210511002913] name "Oh, not at all. \nI can't compare to you, $MyPCName$, rolling up your sleeves to \
    help like this.\nI do hope those children eat well and recover, body and heart. \nI'm counting on you. "
set key[id=129210511002914] name "I'm cold... I'm hungry... \n$npcName:11001392[gender:1]$... I'm sorry, big \
    brother couldn't protect you...."
set key[id=129210511002915] name "(Call out to $npcName:11001391[gender:0]$, who is muttering with half-closed \
    eyes.)"
set key[id=129210511002916] name "Oh, it's you...\nWhat did you bring this time? What are you trying to do to my \
    $npcName:11001392[gender:1]$?"
set key[id=129210511002917] name "(Say $npcName:11001388[gender:1]$ made it, and hand over $item:30000521$.)"
set key[id=129210511002918] name "$npcName:11001388[gender:1]$... You mean... \nThat lady... made this for us? "
set key[id=129210511002919] name "<font color=\"#909090\">(The anger on $npcName:11001391[gender:0]$'s face seems \
    to ease.)</font>"
set key[id=129210511002920] name "Are you sure? That $npcName:11001388[gender:1]$ made this...\nThen... I'll try \
    it first... and then give some to $npcName:11001392[gender:1]$...\nI have to check that it's safe to eat..."
set key[id=129210511002921] name "<font color=\"#909090\">(Tears well up in $npcName:11001391[gender:0]$'s eyes as \
    he tries the $item:30000521$.)</font>"
set key[id=129210511002922] name "$npcName:11001392[gender:1]$... This seems fine. Let's eat.\nIt really must be \
    what $npcName:11001388[gender:1]$ made... it's delicious."
set key[id=129210511002923] name "<font color=\"#909090\">($npcName:11001391[gender:0]$ is feeding $item:30000521$ \
    to $npcName:11001392[gender:1]$.)</font>"
set key[id=129210511002924] name "$npcName:11001392[gender:1]$, it's good, isn't it? Do you feel any stronger? \
    \n<font color=\"#909090\">($npcName:11001392[gender:1]$ nods, then coughs a little. She seems to shiver \
    slightly.)</font>"
set key[id=129210511002925] name "(Help $npcName:11001391[gender:0]$ rub $npcName:11001392[gender:1]$'s body to \
    warm it.)"
set key[id=129210511002926] name "Huh...? Her body seems warmer...\n$npcName:11001392[gender:1]$... are you all \
    right?"
set key[id=129210511002927] name "(You hear a voice say, 'Brother...' It's $npcName:11001392[gender:1]$'s voice.)"
set key[id=129210511002928] name "$npcName:11001392[gender:1]$! Your voice is back! You can talk!\nOh...! Thank \
    goodness...! "
set key[id=129210511002929] name "$MyPCName$...!"
set key[id=129210511002930] name "(Say you're glad she got her voice back.)"
set key[id=129210511002931] name "Thank you, $MyPCName$. \nThe lunchbox... it was really delicious. "
set key[id=129210511002932] name "(Tell her that $npcName:11001388[gender:1]$ made it.)"
set key[id=129210511002933] name "Yes, I remember that lady... She's such a kind person.\nIt's strange... I feel \
    stronger and stronger. I don't itch as much, either.\nI want to go take a bath. Hehe..."
set key[id=129210511002934] name "(Ask if anything else hurts.)"
set key[id=129210511002935] name "No, I actually feel a bit lighter.\nAs if I'd taken some medicine...! "
set key[id=129210511002936] name "(Tell her the medicine <font \
    color=\"#ffd200\">$npcName:11001396[gender:1]$</font> gave us was mixed into the food.)"
set key[id=129210511002937] name "Really...? Big sister $npcName:11001396[gender:1]$ did...! \nSo she <font \
    color=\"#ffd200\">kept her promise</font> after all... \nI... I trusted her. I believed she would help me...!"
set key[id=129210511002938] name "(Ask if she's really all right, since losing her voice came from the first \
    medicine $npcName:11001396[gender:1]$ gave her.)"
set key[id=129210511002939] name "Of course. I'm fine...! Look, I can talk again now.\nIt's thanks to everyone who \
    worried and tried to help...!\nI want to get well soon and pay them back. Big sister \
    $npcName:11001396[gender:1]$, and Auntie $npcName:11001388[gender:1]$ too..."
set key[id=129210511002940] name "(Tell her $npcName:11001396[gender:1]$ has been suffering a lot.)"
set key[id=129210511002941] name "Big sister $npcName:11001396[gender:1]$ looks smart and cool, but her heart is \
    soft.\nBut... please tell her she doesn't need to suffer anymore.\nTell her I kept believing in her, and that \
    I'm truly all right now...!"
set key[id=129210511002942] name "She told me this was a secret... but she said she does her research alone in a \
    place with no people \nbecause she doesn't want others to see her weak side.\nPlease tell her for me that I'm \
    really fine...! "
set key[id=129210511002943] name "$MyPCName$...!\nHow did it go? Is $npcName:11001392[gender:1]$... is \
    $npcName:11001392[gender:1]$ any better? "
set key[id=129210511002944] name "(Tell her the girl could talk again and her body seemed to be getting better.)"
set key[id=129210511002945] name "Oh, thank goodness...! \nReally... what a relief. "
set key[id=129210511002946] name "(Pass on what $npcName:11001392[gender:1]$ asked you to tell her.)"
set key[id=129210511002947] name "$npcName:11001392[gender:1]$.... \nI'm... so grateful... and so sorry... and so \
    ashamed. \nThat little child is far more mature than I am. She was trusting me all along..."
set key[id=129210511002948] name "<font color=\"#909090\">($npcName:11001396[gender:1]$'s eyes seem a little \
    moist.)</font>"
set key[id=129210511002949] name "I'll keep researching so that $npcName:11001392[gender:1]$ and \
    $npcName:11001391[gender:0]$, and everyone, don't have to suffer anymore.\nAnd from now on, I will never be \
    arrogant or rush things. \nI'll approach carefully... and double-check everything. "
set key[id=129210511002950] name "(Cheer her on.)"
set key[id=129210511002951] name "Yes. I'll do my best with the research, and I'll ask $npc:11001443[gender:0]$ \
    and <font color=\"#ffd200\">Auntie $npcName:11001388[gender:1]$ as well</font> to help me persuade the \
    villagers \nso the patients can be cared for properly. \nThank you so much, $MyPCName$. "
set key[id=1219214611001923] name "Excuse me, just a moment, $MyPCName$...! \nIf you're going to $map:02010026$, \
    could you help me out? "
set key[id=1219214611001924] name "Ask what kind of help they need."
set key[id=1219214611001925] name "Tell them I'm very busy and they should ask someone else."
set key[id=1219214611001926] name "Oh, thank you so much!\nActually, I'm looking for someone. She's <font \
    color=\"#ffd200\">a girl about my age</font>,\na bit taller than me, with long hair... Her name is <font \
    color=\"#ffd200\">$npcName:24001807$</font>."
set key[id=1219214611001929] name "You're going into $map:02010026$ anyway, right? I can tell from your weapon. \
    \nLately strange monsters and demons of unknown origin have been showing up in $map:02010026$, \nand they say \
    nobody but <font color=\"#ffd200\">skilled adventurers</font> comes near here."
set key[id=1219214611001930] name "What I'm asking is very simple. \nJust keep an eye out as you pass through for \
    <font color=\"#ffd200\">a girl my age</font>.\nA bit taller than me, long hair... Her name is <font \
    color=\"#ffd200\">Kana</font>."
set key[id=1219214611001931] name "Ask how they know the girl."
set key[id=1219214611001932] name "Haha... actually, we've only met once. \nBut when I was nearly killed in a \
    sandstorm in the desert, she shared her water with me\nand helped me shelter somewhere safe until the storm \
    passed. \nShe's someone I'm so grateful to... my <font color=\"#ffd200\">lifesaver</font>. "
set key[id=1219214611001933] name "I asked her to come back to town with me, but she only said she <font \
    color=\"#ffd200\">had to guard</font> something \nand disappeared into $map:02010026$. Honestly, she barely \
    spoke. \nShe wouldn't even tell me her name, so I said I'd <font color=\"#ffd200\">call her 'Kana'</font>, \
    \nand the smile she gave as she nodded at that name... I keep thinking about it, and my chest aches."
set key[id=1219214611001934] name "I heard monsters and demons had appeared, so I rushed here worried about her... \
    $npcName:24001807$, \nbut just walking around $map:02010026$ was too much for me. \nThere was a place that \
    gave me a <font color=\"#ffd200\">strangely nostalgic feeling</font>, but I couldn't even go in."
set key[id=1219214611001935] name "Ask where that is."
set key[id=1219214611001936] name "Go in through the entrance and turn to the side, and you'll reach a big \
    passage. \nClimb the stairs and look carefully to the side, and there's a <font color=\"#ffd200\">door with a \
    cold wind flowing out</font>. \nIf <font color=\"#ffd200\">$npcName:24001807$</font> is in there, please bring \
    her out. \nIf it's hard to bring her alone, ask <font color=\"#ffd200\">Mr. \
    $npcName:11001434[gender:0]$</font> for help."
set key[id=1219214611001937] name "<font color=\"#ffd200\">Mr. $npcName:11001434[gender:0]$</font> is an \
    archaeologist who does research inside $map:02010026$.\nEven if $npcName:24001807$ isn't inside the <font \
    color=\"#ffd200\">door with the cold wind</font>, \nif you investigate inside and tell <font \
    color=\"#ffd200\">Mr. $npcName:11001434[gender:0]$</font> the results, \nhe might say something helpful. \
    Please, I'm counting on you."
set key[id=1219214611001938] name "Who are you...? Do you know me? \nNo, wait. More importantly, are you all \
    right? \nYour lips are white, like someone who's been in an <font color=\"#ffd200\">extremely cold \
    place</font>..."
set key[id=1219214611001939] name "Say I went to $map:02010052$ at the request of $npcName:11001433[gender:0]$."
set key[id=1219214611001940] name "$map:02010052$, you say...? \nHuh, then did you by any chance see something \
    like a <font color=\"#ffd200\">blue orb</font>? \nOr <font color=\"#ffd200\">someone with a strange \
    aura</font>... or a divine beast... "
set key[id=1219214611001941] name "Tell about the girl $npcName:24001807$ in $map:02010052$."
set key[id=1219214611001942] name "I thought so. It did seem odd that a young, weak boy like \
    $npcName:11001433[gender:0]$ would come in here\nrisking his life to look for someone. So that's the story. \
    \nThe priestess of the <font color=\"#ffd200\">snow leopard tribe</font> being his <font \
    color=\"#ffd200\">first love</font>... the poor boy."
set key[id=1219214611001943] name "Ask what a priestess of the snow leopard tribe is supposed to mean."
set key[id=1219214611001944] name "If she dropped <font color=\"#ffd200\">$item:30000478$</font>, it's almost \
    certain.\nShe must be a young priestess who tends to sick or wounded divine beasts.\nAs they grow, the <font \
    color=\"#ffd200\">snow leopard tribe</font> gradually forget human speech and memories \nand gain sacred \
    power. But they say <font color=\"#ffd200\">growth slows if they stay close to humans.</font> "
set key[id=1219214611001945] name "For that reason, the snow leopard tribe keeps its distance from humans. They're \
    very hard to study.\nThe only clues are things like this <font color=\"#ffd200\">$item:30000478$</font> left \
    where they stayed... \nbut the light within it fades quickly. That makes it even harder. "
set key[id=1219214611001946] name "Say I don't know what to tell $npcName:11001433[gender:0]$."
set key[id=1219214611001947] name "Tell $npcName:11001433[gender:0]$ that you <font color=\"#ffd200\">saw \
    nothing</font>. Ignorance is bliss.\n...Oh, would you give the <font color=\"#ffd200\">$item:30000478$</font> \
    to me? I truly need it for my research. \nI'll give you a reward. "
set key[id=1219214611001948] name "No matter how I think about it, your story, $MyPCName$, is really... \
    remarkable.\nShe was called $npcName:24001807$, wasn't she? That snow leopard priestess saved the human child \
    $npcName:11001433[gender:0]$ from danger \nand remembers the name the child gave her. "
set key[id=1219214611001949] name "A snow leopard priestess with power enough to freeze an entire space \nstill \
    holding memories of a human... I have never seen it in any record. \nIf it's a <font \
    color=\"#ffd200\">$item:30000478$</font> dropped by such a priestess,\nit is <font color=\"#ffd200\">truly \
    important material</font> for me, as I research their growth and awakening. "
set key[id=1219214611001951] name "$MyPCName$, would you bring me the $item:30000478$ from $map:02010052$? \nI \
    will certainly show my gratitude. "
set key[id=1219214611001952] name "The <font color=\"#ffd200\">$item:30000478$</font> left by that young \
    priestess, <font color=\"#ffd200\">$npcName:24001807$</font>,\nis undoubtedly fascinating research material. \
    \nPlease bring me the $item:30000478$ from $map:02010052$."
set key[id=1219214611001953] name "You brought <font color=\"#ffd200\">$item:30000478$</font>...!\nThis cold \
    light... it's still vividly alive. Thank you so much. "
set key[id=1220045311001954] name "Ask how they know the girl."
set key[id=1220105411001955] name "Um.... $MyPCName$! You look free, so help me out for a bit, mi.\nIt's a re~ally \
    simple and easy job, mi. I'll thank you for it, yung."
set key[id=1220105411001956] name "Ask what this re~ally simple and easy job is."
set key[id=1220105411001957] name "<font color=\"#909090\">(Whisper whisper)</font> Please tell our <font \
    color=\"#ffd200\">captain</font> up here, mi.\n<font color=\"#ffd200\">'The investigation by \
    $npcName:11001084[gender:1]$ and $npcName:11001355[gender:1]$ is accurate, mi!'</font> Just like that, \
    yung.\nHow about it, yung? Really easy, isn't it, mi! So hurry, hurry!"
set key[id=1220105411001958] name "Say the captain will only believe it if you explain exactly what this is \
    about."
set key[id=1220105411001959] name "Oho, human! You're more thorough than you look, mi~ I like that, yung!\nAll \
    right, mi. I'll give you a rough explanation of what we investigated, mi.\nRecently, re~ally strange things \
    often happen in this <font color=\"#ffd200\">$map:02010047$</font>, mi.\nIt's a re~ally <font \
    color=\"#ffd200\">long night</font>, mi. Darkness covers the sun, yung."
set key[id=1220105411001960] name "The <font color=\"#ffd200\">captain</font>, <font color=\"#ffd200\">I</font>, \
    and <font color=\"#ffd200\">$npcName:11001355[gender:1]$</font> wanted to find the cause of this phenomenon, \
    mi.\nThe three of us investigated hard, separately and together, and the long night \nhappens on <font \
    color=\"#ffd200\">days with a crescent moon</font> or days with a <font color=\"#ffd200\">lunar \
    eclipse</font>, mi.\nBut that's not all, mi. There's something that always appears when the long night begins, \
    yung."
set key[id=1220105411001961] name "An <font color=\"#ffd200\">enormous shadow</font> appears fluttering over \
    there, from those ruins, mi. It looks just like a bird, yung. \nAnd then, in some record, I found that very \
    long ago there was a sorcerer who looked like a <font color=\"#ffd200\">crow</font>, \nthey say, mi. He could \
    handle <font color=\"#ffd200\">the flow of power at will</font>, they say!!"
set key[id=1220105411001962] name "Say we should just investigate those ruins then."
set key[id=1220105411001963] name "But we can't, mi. That's the problem, yung...\nThe <font \
    color=\"#ffd200\">captain</font> keeps dodging, saying 'we must be careful'!\nWe could look up other materials \
    after investigating those ruins, but he won't, yung..."
set key[id=1220105411001964] name "Ask why they didn't persuade him."
set key[id=1220105411001965] name "Human... why else would I be asking a human, mi!\n<font \
    color=\"#ffd200\">$npcName:11001355[gender:1]$</font> and I both tried to persuade the captain, but it was no \
    use, mi...\nSo pretend to be a scholar and tell him <font color=\"#ffd200\">we're right</font>, yung!"
set key[id=1220105411001966] name "Human... you haven't told our captain yet, mi?\nPretend to be a scholar and \
    tell him <font color=\"#ffd200\">we're right</font>, yung!\nWhat we investigated must be right... I'm so \
    frustrated, mi~ "
set key[id=1220105411001967] name "Human...? What's the matter, mi? "
set key[id=1220105411001968] name "Tell him I'm a scholar passing by and an ancient sorcerer lives in those \
    ruins."
set key[id=1220105411001969] name "...Don't tell me <font color=\"#ffd200\">$npc:11001084[gender:1]$ and \
    $npcName:11001355[gender:1]$</font> asked you, mi?\nHuman, you don't look like a scholar at all, mi.... Don't \
    <font color=\"#ffd200\">overact</font>, yung."
set key[id=1220105411001970] name "<font color=\"#909090\">(What, how did he know!)</font> "
set key[id=1220105411001971] name "A real scholar would surely know that those ruins are called <font \
    color=\"#ffd200\">$map:02010054$</font>, mi. \nThey're <font color=\"#ffd200\">the home of \
    $npcName:24002005$</font>, yung.\n...Ugh. I wish it weren't so, but the more I investigate, the more certain I \
    become, mi. "
set key[id=1220105411001972] name "Human, <font color=\"#ffd200\">$npc:24002005$</font> is a really frightening \
    being, mi.\nWhat if we rush in to investigate and get hit by his sorcery, mi?\nWe're good at <font \
    color=\"#ffd200\">scouting</font> but not at <font color=\"#ffd200\">fighting</font>, mi. We can't just rush \
    in, yung."
set key[id=1220105411001973] name "Ask why $npc:24002005$ is so frightening."
set key[id=1220105411001974] name "$npcName:24002005$ is a sorcerer in very ancient records, mi.\nHe was a wise \
    crow who lived a long time, and he <font color=\"#ffd200\">admired dragons</font>, they say, mi.\nTheir size \
    and strength, of course, but also their beauty and noble conduct....\nBut no matter how hard he tried, <font \
    color=\"#ffd200\">a crow could never become a dragon, yung.</font> "
set key[id=1220105411001975] name "$npc:24002005$ felt his own <font color=\"#ffd200\">limits</font> and decided \
    to find another way, mi.\nSo he studied <font color=\"#ffd200\">black sorcery</font> and gained <font \
    color=\"#ffd200\">the ability to control the flow of power</font>, yung.\nHe meant to draw in the abilities \
    dragons have and make them his own, mi. "
set key[id=1220105411001976] name "But the <font color=\"#ffd200\">dragons went to war</font>, split into forces \
    of light and darkness,\nand while their powers clashed fiercely he couldn't interfere with the flow, mi.\nOf \
    course, he couldn't draw others' power in to make it his own, either, and \n$npcName:24002005$ chose a <font \
    color=\"#ffd200\">long sleep</font>, yung."
set key[id=1220105411001977] name "But now the dragons are gone from this land, mi. No more clashes of great \
    power, yung.\nSo it seems <font color=\"#ffd200\">$npc:24002005$</font> is about to rise again, mi.\nHe wants \
    the glory of a dragon in a world without dragons, yung."
set key[id=1220105411001978] name "Human, you can fight well, can't you, yung? Please investigate <font \
    color=\"#ffd200\">$map:02010054$</font>, mi.\nWe must stop $npc:24002005$ from rising again, mi.\nIf he starts \
    drawing in power, the world will be buried in chaos, yung!"
set key[id=1220105411001979] name "Human, you look like you can fight well, but I'll warn you, mi.\nDon't go \
    alone, mi. $npc:24002005$ controls the flow of power, so\nhe'd be <font color=\"#ffd200\">too much to face \
    alone</font>, mi.\nBe sure to go together with other humans, holding hands tight, yung."
set key[id=1220105411001980] name "Human, did you see <font color=\"#ffd200\">$npc:24002005$</font>, mi? \nWas he \
    really inside <font color=\"#ffd200\">$map:02010054$</font>, mi? What was it like, mi?"
set key[id=1220105411001981] name "Say I defeated $npc:24002005$."
set key[id=1220105411001982] name "No wonder...! Not long after the human went into $map:02010054$, \n<font \
    color=\"#ffd200\">black smoke</font> rose up, mi. It matches the records in the ruins, too, mi. \nHmm, then... \
    it's not over yet, mi...."
set key[id=1220105411001983] name "Ask what that means."
set key[id=1220105411001984] name "They say $npc:24002005$ changes form and flees at the moment of crisis, \
    mi.\nEven if a human defeats $npc:24002005$, it's only for a moment,\nhe flees and soon appears again, yung."
set key[id=1220105411001985] name "Ask if there's no way to stop him then."
set key[id=1220105411001990] name "It showed up even though it's not a crescent moon... something's off, mi.\nWhat \
    stubborn, stubborn life force, mi. How in the world did this happen, yung...?"
set key[id=1220105411001991] name "Ask if he means $npcName:24002005$."
set key[id=1220105411001992] name "Right, mi. I saw a black shadow flickering again at <font \
    color=\"#ffd200\">$map:02010054$</font>, mi.\nHuman, could you keep an eye on <font \
    color=\"#ffd200\">$npc:24002005$</font>'s movements again, mi?\nThe stronger his power gets, the greater the \
    danger, mi. \nI'm counting on you, yung!"
set key[id=1220105411001993] name "Human, I said it last time too, but I'll warn you, mi.\nDon't go alone, mi. \
    $npc:24002005$ controls the flow of power, so\nhe'd be <font color=\"#ffd200\">too much to face alone</font>, \
    mi.\nBe sure to go together with other humans, holding hands tight, yung."
set key[id=1220105411001994] name "Human, you worked hard fighting <font color=\"#ffd200\">$npc:24002005$</font>, \
    mi. \nHere, it's small, but it's my thanks, so please take it, yung! "
set key[id=1223031611001995] name "Not so, mi. Changing form and fleeing uses a great deal of power, mi.\nIf we \
    keep creating moments of crisis and make him keep using that power, \nsomeday his <font \
    color=\"#ffd200\">power will run out and he will fall into a long sleep again</font>, yung."
set key[id=1223031611001996] name "Human, good work, mi. \nIt's small, but it's my thanks, so please take it, \
    yung! "

# Quest dialogue of the Season1 quests (feature Season1) that no pack has in English: our own
# English for the 148 scriptquest rows of locale KR (or no locale) whose quest a player can get (12 quests),
# with each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=324122711002970] name "Oh dear, this is bad. That woman's look is no joke...\nAnd my \
    $npc:11000167[gender:0]$ is wrapped around his wife's finger, so no way... \n...Hm? You're... <font \
    color=\"#ffd200\">$MyPCName$</font>? The adventurer with the good reputation, right? "
set key[id=324122711002971] name "(Ask what's going on.)"
set key[id=324122711002972] name "Yes, there is! There is! I'm in a real bind. \nA while ago I went to the \
    merchants' association meeting in $map:02000036$ and \nbragged a bit about <font color=\"#ffd200\">my little \
    brother</font>. About <font color=\"#ffd200\">$npc:11000167[gender:0]$</font>~ he runs a shop in \
    $map:02000285$ now, \nbut in his day he was a truly skilled <font color=\"#ffd200\">hunter</font>. Bang! and \
    the monster goes squawk! Just like that! "
set key[id=324122711002973] name "Then suddenly <font color=\"#ffd200\">some woman</font> came up and asked if I \
    was close to my brother.\nSo I answered that he's so kind he'd do anything I ask.\nAnd she said, <font \
    color=\"#ffd200\">please ask him to defeat the monsters in $map:02000006$</font>. "
set key[id=324122711002974] name "(Ask why not just ask him, if his hunting skills are good.)"
set key[id=324122711002975] name "So I went to ask him... and my sister-in-law scolded me.\nShe said how many \
    times he got hurt in his hunter days, and how dare I bring back a hunting request...\nHow silly of me, I plain \
    forgot. \nThat my sister-in-law had banned him from hunting for his health and safety..."
set key[id=324122711002976] name "So... I was going to tell the woman who asked that it's off, but \nthat frowning \
    face keeps coming to mind... I keep remembering her desperate expression, \nand I can't bring myself to say it \
    to her face... "
set key[id=324122711002977] name "I hear you have a good reputation and are good at persuading, $MyPCName$. \
    \nCould you go to that woman in my place and ask her to <font color=\"#ffd200\">call it off</font>? \nShe's \
    <font color=\"#ffd200\">$npc:11000270[gender:1]$</font>, and she sells gardening goods at $map:02000286$ in \
    $map:02000036$."
set key[id=324122711002978] name "I hear you have a good reputation and are good at persuading, $MyPCName$. \
    \nCould you go to that woman in my place and ask her to <font color=\"#ffd200\">call it off</font>? \nShe's \
    <font color=\"#ffd200\">$npc:11000270[gender:1]$</font>, and she sells gardening goods at $map:02000286$ in \
    $map:02000036$."
set key[id=324122711002979] name "<font color=\"#909090\">(She has the frowning look $npc:11001536[gender:1]$ \
    described. She looks stubborn.)</font>\nThe goods are all good. Don't touch them if you're not buying. "
set key[id=324122711002980] name "(Explain $npc:11001536[gender:1]$'s situation on her behalf and ask her to call \
    it off.)"
set key[id=324122711002981] name "Ah... I see. That lady, after talking so big... \nWhat a mess. Looks like I \
    won't get proper sleep today either... "
set key[id=324122711002982] name "Honestly... my daughter can't sleep because of the <font \
    color=\"#ffd200\">monster noises at night</font>.\nShe wakes up every night crying that she's scared... and we \
    can't afford to move, so it's really a bind.\nI just wish she could get one good night's sleep, so I asked for \
    help, but still... "
set key[id=324122711002983] name "$MyPCName$, if you have some time, could you scare off the <font \
    color=\"#ffd200\">$map:02000006$ monsters</font> for me?\nAbout <font color=\"#ffd200\">20 of them</font> \
    should quiet things down...\nThere's a gift I was going to give that lady once she helped out,\nso if you \
    defeat them, I'll give it to you instead."
set key[id=324122711002984] name "$MyPCName$, if you have some time, could you scare off the <font \
    color=\"#ffd200\">$map:02000006$ monsters</font> for me?\nAbout <font color=\"#ffd200\">20 of them</font> \
    should quiet things down...\nThere's a gift I was going to give that lady once she helped out,\nso if you \
    defeat them, I'll give it to you instead."
set key[id=324122711002985] name "Great. Now my daughter and I might finally get some sleep tonight.\nThank you so \
    much."
set key[id=324122711002986] name "$MyPCName$, if you have a little time, could you help me out?\nIt's really \
    important to me... but I'm only a part-timer, so I have no way to do it myself.\nIt might be able to cure \
    <font color=\"#ffd200\">my sibling's illness</font>..."
set key[id=324122711002987] name "Tell me what's going on."
set key[id=324122711002988] name "I heard a strange story from some customers who came to the shop recently.\nNext \
    door, somewhere in <font color=\"#ffd200\">$map:02000006$</font>, there's a place called <font \
    color=\"#ffd200\">$map:02000074$</font>,\nand they say an <font color=\"#ffd200\">herb that cures every \
    illness</font> grows there. "
set key[id=324122711002989] name "It's a small cave that an eccentric wizard who studies herbs visits now and \
    then.\nHe seems to be growing something there, but he won't tell anyone what it is.\nIf there really is a \
    miraculous herb there... maybe my sibling could get better..."
set key[id=324122711002990] name "My sibling has an incurable <font color=\"#ffd200\">illness</font> that's rare \
    and no one knows the cause...\nIf there's even a small hope, I want to take the chance.\nCould you look for an \
    <font color=\"#ffd200\">herb</font> or something like it in <font color=\"#ffd200\">$map:02000074$</font>? "
set key[id=324122711002991] name "Could you look for an <font color=\"#ffd200\">herb</font> or something like it \
    in <font color=\"#ffd200\">$map:02000074$</font>?\nIf there's even a small hope of curing my sibling's \
    illness, I want to take the chance...."
set key[id=324122711002992] name "Oh, $MyPCName$! You're back!\nSo? Did you find anything?"
set key[id=324122711002993] name "(Hand over $item:30000534$.)"
set key[id=324122711002994] name "Th... this is all there was?\nI heard that wizard hasn't been seen lately... did \
    everything he was growing wither away...?\nStill... I should at least take it to a doctor. Thanks for trying \
    so hard. "
set key[id=1216171211001402] name "$MyPCName$! Have you seen a little child by any chance? \nBlond hair, about as \
    tall as my waist... His name is <font color=\"#ffd200\">$npc:11001166[gender:0]$</font>. \nHe's my little \
    brother... and I can't find him anywhere."
set key[id=1216171211001403] name "He seemed to be gathering his friends... I'm worried \nthey all went into <font \
    color=\"#ffd200\">$map:02000331$</font> together. \nI told him so firmly never to go in, and not even to try \
    finding where it is...!"
set key[id=1216171211001404] name "(Ask what kind of place <font color=\"#ffd200\">$map:02000331$</font> is that \
    she's so worried.)"
set key[id=1216171211001405] name "It's a very pretty forest path with lots of colorful flowering trees. \nBut \
    it's also dangerous, so the adults blocked off the entrance and said no one should go in.\nA very prickly mage \
    lives there, and they say he attacks anyone who enters the forest."
set key[id=1216171211001406] name "(Ask why she thinks her brother went there.)"
set key[id=1216171211001407] name "<font color=\"#ffd200\">$npc:11001166[gender:0]$</font> is a curious, lively \
    child. \nHe has lots of friends and they all run around playing together in a crowd."
set key[id=1216171211001408] name "A few days ago he asked me <font color=\"#ffd200\">if I knew where \
    $map:02000331$ is</font>.\nIt sounded like he wanted to go in, so I scolded him hard and told him absolutely \
    not. \nMaybe that's why he vanished without a word... I have to find that rascal <font \
    color=\"#ffd200\">$npc:11001166[gender:0]$</font> fast."
set key[id=1216171211001409] name "(Ask how you can help.)"
set key[id=1216171211001410] name "(Scold her for not being stricter with him.)"
set key[id=1216171211001411] name "I'll follow this road and search the north side of the village. \n$MyPCName$, \
    could you search <font color=\"#ffd200\">the south side of the village</font>? \nHis friends are probably with \
    him too... please talk them around and bring them somewhere safe. Please. "
set key[id=1216171211001412] name "He's still young and doesn't know any better, so please understand. I'll talk \
    to him properly once I find him. \n$MyPCName$, could you search <font color=\"#ffd200\">the south side of the \
    village</font>? I'll go north.\nHis friends are probably with him too... please, I'm begging you. "
set key[id=1216171211001413] name "$MyPCName$, if you see $npcName:11001166[gender:0]$, please bring him somewhere \
    safe. \nI'll search the north side of the village, so please look around <font color=\"#ffd200\">the south \
    side</font>. Please."
set key[id=1216171211001414] name "Oh... yes. That's right, I'm <font \
    color=\"#ffd200\">$npcName:11001166[gender:0]$</font>. \nHow did you know?"
set key[id=1216171211001415] name "What? My big brother is looking for me? \nReally? "
set key[id=1216171211001416] name "(Tell him he has to go back somewhere safe.)"
set key[id=1216171211001417] name "No, I can't, I can't!\nMy <font color=\"#ffd200\">friends</font> are still \
    inside... waaah..."
set key[id=1216171211001418] name "(Soothe him and tell him not to cry and to explain slowly.)"
set key[id=1216171211001419] name "We were just about to start <font color=\"#ffd200\">hide-and-seek</font> in \
    <font color=\"#ffd200\">$map:02000331$</font> with my friends... sniff. \nThere was a loud noise like things \
    popping and exploding, \nand it sounded like someone was moving around too...!"
set key[id=1216171211001420] name "I thought the <font color=\"#ffd200\">prickly mage</font> that big brother \
    $npc:11001167[gender:0]$ told us about\nhad seen us and was coming to catch us, and I got scared...!\nI just \
    ran out. Waaah...!  "
set key[id=1216171211001421] name "(Ask if his friends are still in the forest.)"
set key[id=1216171211001422] name "Yes, that's right...! They must be hiding somewhere... \n$MyPCName$, please go \
    into $map:02000331$ with me and save my friends...!\nYou can beat that scary mage, right, $MyPCName$? Please? \
    "
set key[id=1216171211001423] name "$MyPCName$, to get to $map:02000331$, \njust go in through this entrance. See \
    you inside $map:02000331$!"
set key[id=1216171211001424] name "Thanks to you, $MyPCName$, we all got out safely.\nMy friends say thank you \
    too! You'll be blessed for this! "
set key[id=1216171211001425] name "Wow! It's $MyPCName$!!\nCould you help me? Pleeease~!"
set key[id=1216171211001426] name "The... the <font color=\"#ffd200\">prickly mage</font> caught us again! \
    \nPlease go into <font color=\"#ffd200\">$map:02000331$</font> with me and help my friends...!\nWaaah... I \
    don't know what to do... "
set key[id=1216171211001427] name "(Scold him for going into such a dangerous place again.)"
set key[id=1216171211001428] name "$map:02000331$ has lots of pretty flowering trees and nobody's around, \nso \
    it's great for <font color=\"#ffd200\">hide-and-seek</font>.\nAll we have to do is not get caught by that \
    <font color=\"#ffd200\">mage</font>... why does he only show up when I'm 'it'...!"
set key[id=1216171211001429] name "<font color=\"#909090\">(I don't think that's the real problem here...)</font>"
set key[id=1216171211001430] name "You're strong, $MyPCName$. So please help just one more time.  \nI'm begging \
    you, okay? Pleeease~"
set key[id=1216171211001431] name "You really are the best, $MyPCName$~! You'll help me again!!\nSee you inside \
    $map:02000331$!"
set key[id=1216171211001432] name "$MyPCName$, you were really, truly amazing this time too! \nThanks to you, \
    everyone got out safely. Thank you so much!"
set key[id=1216171211001433] name "Hello. \nAre you with <font color=\"#ffd200\">Maple TV</font> by any chance? "
set key[id=1216171211001434] name "(Say yes.)"
set key[id=1216171211001435] name "(Say no.)"
set key[id=1216171211001436] name "Oh? I don't think I've seen you before... Are you a <font color=\"#ffd200\">new \
    hire</font>? \nThen I need you to do <font color=\"#ffd200\">something I ask</font> from now on, junior. "
set key[id=1216171211001437] name "(Honestly say you're not actually with Maple TV.)"
set key[id=1216171211001438] name "(Say you'll do whatever she needs.)"
set key[id=1216171211001439] name "Well, true... At this busiest hour, I must be the only one out here.\nI'm \
    worried, but I can't go looking myself...\nI was so frustrated I stepped out to clear my head for a moment. I \
    have to go back soon, though."
set key[id=1216171211001440] name "(Ask if something is worrying her.)"
set key[id=1216171211001441] name "My name is <font color=\"#ffd200\">$npc:11001191[gender:1]$</font>. We're \
    preparing a documentary about abnormal ecosystem phenomena, \nbut <font color=\"#ffd200\">our staff who went \
    to the filming sites</font> haven't come back.\nThey're people working so hard with too few hands and too \
    little time... \nI'm worried <font color=\"#ffd200\">something might have happened to them</font>."
set key[id=1216171211001442] name "The filming sites are <font color=\"#ffd200\">$map:2000045$, $map:2000003$, \
    $map:2000010$,\n$map:2000255$ and $map:2000007$</font>. Five places in all. \nThe director wants to see \
    footage, but we have far too little.\nAll we need is for even one person to <font color=\"#ffd200\">retrieve \
    the cameras we set up</font>... "
set key[id=1216171211001443] name "The pros like <font color=\"#ffd200\">$npc:11001193[gender:1]$ and \
    $npc:11001194[gender:0]$</font> are probably fine, but... \nI'm a bit uneasy about the scatterbrained <font \
    color=\"#ffd200\">$npc:11001192[gender:0]$</font> and the can't-be-bothered <font \
    color=\"#ffd200\">$npc:11001196[gender:0]$</font>. "
set key[id=1216171211001444] name "Especially <font color=\"#ffd200\">$npc:11001195[gender:0]$</font>. He isn't \
    even on our team, but\nhe heard we were short-handed and offered to help, and left for <font \
    color=\"#ffd200\">$map:2000045$</font>\na few days ago. There's still been no word from him at all. "
set key[id=1216171211001445] name "(Say you'll help.)"
set key[id=1216171211001446] name "Thank you so much. \nThen please go to <font \
    color=\"#ffd200\">$map:2000045$</font> and meet <font color=\"#ffd200\">$npc:11001195[gender:0]$</font>.\nI \
    need to know whether something has happened to him. "
set key[id=1216171211001447] name "Actually, it's not just $npcName:11001195[gender:0]$ I'm worried about. The \
    others too.\n<font color=\"#ffd200\">The five filming sites</font> are all spread out, so they can't help one \
    another...\nAnd on top of that, <font color=\"#ffd200\">the director</font> keeps pressing me about when he \
    can see the footage. \nWhat a mess."
set key[id=1216171211001448] name "<font color=\"#ffd200\">$npc:11001195[gender:0]$</font>...? That's me. Why are \
    you looking for me? \nAre you <font color=\"#ffd200\">from the station</font>?"
set key[id=1216171211001449] name "(Tell him <font color=\"#ffd200\">$npc:11001191[gender:1]$</font> is looking \
    for him.)"
set key[id=1216171211001450] name "What! Oh dear. I've gone and worried my Dodo, <font \
    color=\"#ffd200\">$npcName:11001191[gender:1]$</font>! \nAs you can see, my body is more or less fine. \nIt's \
    just my heart, my soul, that's crying~"
set key[id=1216171211001451] name "Still, I'm worried. I doubt it's only this place that's in an uproar....\nThe \
    people at <font color=\"#ffd200\">the other filming sites</font> probably need some <font \
    color=\"#ffd200\">h.e.l.p.</font> too! \nMy <font color=\"#ffd200\">exceptional intuition</font> tells me so!"
set key[id=1216171211001452] name "Hey there, honey! You, gorgeous~ \nSince you're here anyway, lend me a hand, \
    would you?"
set key[id=1216171211001453] name "(Say that if he's going to talk like that, you're leaving.)"
set key[id=1216171211001454] name "Oh my, darling! Don't misunderstand my sincerity! \nI'm only asking for <font \
    color=\"#ffd200\">help</font> with a pure heart! \nPlease understand, it's so hot and dry here that my skin~ \
    and my tone~ have gotten prickly.\nHonestly, this is an occupational hazard. Or 'occ-haz' for short!"
set key[id=1216171211001455] name "<font color=\"#909090\">(He must really be hurting inside. Let's bear with \
    him.)</font>"
set key[id=1216171211001456] name "Mmm, the thing is. Could you <font color=\"#ffd200\">retrieve the filming \
    tape</font> from in there?\nMy Dodo's team's camera is in there. When I tried to take the tape out,\nof all \
    things, a <font color=\"#ffd200\">house-sized red lump</font> came wobbling out and threatened me!\nEek, what \
    a scare. My poor heart. "
set key[id=1216171211001457] name "Come to think of it, I think that was a <font \
    color=\"#ffd200\">$npc:21000068$</font>. The monster that lives in dry places.\nBut it was red and huge. All \
    that wiggling looked like it was dancing...\nHonestly, though, why would anyone film something like that? What \
    a waste of film. \nIsn't there anything more fun, more unusual?"
set key[id=1216171211001458] name "(Say that if its color and size are different from an ordinary Plaka, it does \
    sound strange.)"
set key[id=1216171211001459] name "Darling, are you kidding me!\nJust because it's a different color, does a <font \
    color=\"#ffd200\">$npc:21000068$</font> become <font color=\"#ffd200\">plankton</font>? A <font \
    color=\"#ffd200\">$npc:21000068$</font> is a <font color=\"#ffd200\">$npc:21000068$</font>!\nUnbelievable, \
    really!"
set key[id=1216171211001460] name "(Say you'll help, so calm down.)"
set key[id=1216171211001461] name "Sob, I'm actually a gentle man, but the world won't leave me alone. \nSorry, \
    darling. Then I'm counting on you."
set key[id=1216171211001462] name "What are you doing, darling? Hurry in there and retrieve the filming \
    tape.\nThat <font color=\"#ffd200\">red lump</font> means there's just no way I can go. \nI've been standing \
    here for days because I can't face my lovely Dodo... sigh...!"
set key[id=1216171211001463] name "Oh my. <font color=\"#ffd200\">$item:30000414$</font>...! Yes, this is it! \
    \nThanks to you I'm safe, but I do worry about the others. \nEspecially <font \
    color=\"#ffd200\">$npcName:11001194[gender:0]$</font>, who went to <font \
    color=\"#ffd200\">$map:2000003$</font>. That boy is far too nice.\nAnyway, my Dodo will finally rest easy once \
    she gets this tape."
set key[id=1216171211001464] name "(Ask if by 'Dodo' he means $npc:11001191[gender:1]$.)"
set key[id=1216171211001465] name "That's right. My beautiful muse brims with <font color=\"#ffd200\">dodo-like \
    charm</font>. So, <font color=\"#ffd200\">Dodo</font>!\nAnyway, darling, thank you sooo much! You're the <font \
    color=\"#ffd200\">savior of the Culture Department</font>!"
set key[id=1216171211001466] name "Oh, who are you? I don't think we've met...\nAre you here from <font \
    color=\"#ffd200\">Maple TV</font> as <font color=\"#ffd200\">field support</font>? "
set key[id=1216171211001467] name "(Ask if he's on <font color=\"#ffd200\">$npc:11001191[gender:1]$</font>'s \
    team.)"
set key[id=1216171211001468] name "Yes, that's right. My name is <font \
    color=\"#ffd200\">$npc:11001194[gender:0]$</font>. \nOr maybe soon I'll be jobless \
    $npcName:11001194[gender:0]$. \nThe <font color=\"#ffd200\">deadline</font> is right around the corner and I \
    couldn't even retrieve the <font color=\"#ffd200\">filming tape</font>... this is the worst...!"
set key[id=1216171211001469] name "(Ask what happened at the site.)"
set key[id=1216171211001470] name "The water here at <font color=\"#ffd200\">$map:2000003$</font> is hardening \
    into ludibrium.\nThe exact cause hasn't been found, but we got tips that some strange noise\nhas been coming \
    from somewhere here lately.\nSo we decided to <font color=\"#ffd200\">set up a camera</font> inside that cave \
    and observe."
set key[id=1216171211001471] name "And today... when I came to retrieve the tape, with a rattling sound\na <font \
    color=\"#ffd200\">giant block golem</font> appeared.\nI only realized after I ran out that I hadn't brought \
    the <font color=\"#ffd200\">filming tape</font> with me...."
set key[id=1216171211001472] name "(Comfort $npcName:11001194[gender:0]$, saying a monster like that must have \
    been dangerous.)"
set key[id=1216171211001473] name "So, I'm sorry to ask, but could you <font color=\"#ffd200\">retrieve the \
    filming tape</font> for me? \nCameras are all I know how to handle... I'm no match for monsters.\nActually I \
    have an appointment with my <font color=\"#ffd200\">fiancee</font> today, and I can't <font \
    color=\"#ffd200\">break my promise</font> even today. "
set key[id=1216171211001474] name "I can only <font color=\"#ffd200\">leave work</font> once I <font \
    color=\"#ffd200\">retrieve the filming tape</font> and bring it to the PD....\nIf I break the promise again \
    today, I won't be able to face her...!\nI've been so busy that my <font color=\"#ffd200\">fiancee</font> is \
    doing almost all the wedding preparations. \nI can't make her buy the furniture alone, too. We'll have to get \
    a big TV."
set key[id=1216171211001475] name "Oh...! $MyPCName$, you're back! \nAt last I can leave on time like <font \
    color=\"#ffd200\">$npc:11001196[gender:0]$</font>. \nThough he seems to be out at <font \
    color=\"#ffd200\">$map:2000010$</font> right now..."
set key[id=1216171211001476] name "(Hand over <font color=\"#ffd200\">$item:30000415$</font>.)"
set key[id=1216171211001477] name "<font color=\"#ffd200\">$item:30000415$</font>... yes, that's it!  \nThank you \
    so much, $MyPCName$!  "
set key[id=1216171211001478] name "Hm...? Aren't you... $MyPCName$...? \nWhat brings you out to a place like \
    this?"
set key[id=1216171211001479] name "(Ask how he knew your name.)"
set key[id=1216171211001480] name "Hohoho, no need to be so surprised. $MyPCName$, your name has been spreading as \
    a <font color=\"#ffd200\">capable adventurer</font>. \nI hear you've been helping many people? \nCould you \
    perhaps <font color=\"#ffd200\">help me too</font>?"
set key[id=1216171211001481] name "Tell me what's going on."
set key[id=1216171211001482] name "I belong to the <font color=\"#ffd200\">Maple TV support team</font>. Which \
    means I have absolutely no reason to be out in the field. \nBut the <font color=\"#ffd200\">powerful \
    director</font> and the <font color=\"#ffd200\">merciless PD</font> pushed me out \nhere, and I'm standing \
    here bitterly, clutching my aching back... "
set key[id=1216171211001483] name "(Ask why he didn't just say he was too sick to come.)"
set key[id=1216171211001484] name "Hohoho, you're still young and don't know the truths of the world. \nVery well, \
    let me explain kindly. Think about it.\nWhen you work at a company, there are many times <font \
    color=\"#ffd200\">your body hurts</font>.\nWhen your body hurts, you go to the hospital for treatment, right? \
    "
set key[id=1216171211001485] name "And for that you need <font color=\"#ffd200\">treatment money</font>. Mesos, \
    that is.\nBut mesos don't appear by themselves. \nSo what should you do to <font color=\"#ffd200\">earn \
    mesos</font>?"
set key[id=1216171211001486] name "(Answer that you hunt to earn mesos.)"
set key[id=1216171211001487] name "(Answer that you go to the company to earn mesos.)"
set key[id=1216171211001488] name "Tsk! You mustn't tease your elders!\nDo you have any idea how painful a slipped \
    disc is, to joke like that? \nSince you <font color=\"#ffd200\">teased your elder</font>, you'll pay for it! \
    \n<font color=\"#ffd200\">Retrieve the filming tape</font> from the camera in that cave and bring it to me!"
set key[id=1216171211001489] name "That's right, exactly. So even when it hurts, even when it's miserable, you go \
    to the company. \nSo please help me, who has no choice but to follow <font color=\"#ffd200\">the company's \
    orders</font>.\n<font color=\"#ffd200\">Retrieve the filming tape</font> from the camera set up in that cave \
    and bring it to me."
set key[id=1216171211001490] name "What are you doing...? \nThere's only one camera in that cave. \nIt's a simple \
    job: inspect it and just <font color=\"#ffd200\">retrieve the filming tape</font>.\nBring it quickly, I'm so \
    dizzy I can hardly stand...! "
set key[id=1216171211001491] name "<font color=\"#ffd200\">$item:30000416$</font>... yes, yes, that's it! \
    \n$MyPCName$, you're a truly thoughtful and wonderful young person! \nYou're nothing like that dim <font \
    color=\"#ffd200\">Culture Department $npc:11001192[gender:0]$</font>. "
set key[id=1216171211001492] name "That fellow is probably tearing up somewhere in <font \
    color=\"#ffd200\">$map:2000255$</font> about now.... Heh heh. \nAnyway, good work. Keep it up from now on, \
    too! "
set key[id=1216171211001493] name "Who are you? \nAren't you looking at me with far too much pity? "
set key[id=1216171211001494] name "(Say no.)"
set key[id=1216171211001495] name "(Honestly say he looks exhausted.)"
set key[id=1216171211001496] name "No? You're right, I am pitiful. I feel like a <font \
    color=\"#ffd200\">slave</font>. \nMenial chores... errands... and at home I'm a <font \
    color=\"#ffd200\">prince</font>, you know...! \nSigh... it's miserable. Maybe I should <font \
    color=\"#ffd200\">quit the company before it's too late...</font> "
set key[id=1216171211001497] name "(Comfort him, saying since he started it, he should hang in there.)"
set key[id=1216171211001498] name "(Egg him on to just quit.)"
set key[id=1216171211001499] name "Right. However much I dress up, the dark circles under my eyes make me look \
    like a <font color=\"#ffd200\">wreck</font>.\nThey keep telling me to come up with <font color=\"#ffd200\">new \
    ideas</font> while piling on menial chores... and errands... \nSigh... it's miserable. Maybe I should <font \
    color=\"#ffd200\">quit the company before it's too late...</font> "
set key[id=1216171211001500] name "(Comfort him, saying since he started it, he should hang in there.)"
set key[id=1216171211001501] name "(Egg him on to just quit.)"
set key[id=1216171211001502] name "Yes, you're right. I should. If I hang in there, things might change.\nBut... \
    beating that horrible monster is impossible for me.\nAnd at a time like this, with <font \
    color=\"#ffd200\">only a week until the deadline</font>..."
set key[id=1216171211001503] name "(Ask if a monster appeared at the filming site.)"
set key[id=1216171211001504] name "I know, right. The more I think about it, the more unfair it feels. \nWhy can't \
    I go home on time but have to come in every single day? \nIs there any point grinding away my youth for a \
    handful of mesos?\nAnd meeting such a <font color=\"#ffd200\">horrible monster</font> on top of it!! "
set key[id=1216171211001505] name "(Ask if a monster appeared at the filming site.)"
set key[id=1216171211001506] name "Yes. We got a tip that there's a <font color=\"#ffd200\">strange space that \
    gives people a big scare</font> in these back alleys,\nso we set up an observation camera a few days ago. \nI \
    came to retrieve it today, and scare? No... it was a <font color=\"#ffd200\">horrible experience</font>."
set key[id=1216171211001507] name "When we set up the camera it was a dark empty lot,\nbut today I found <font \
    color=\"#ffd200\">gift boxes</font> sitting among pretty toys.\nI was scared but gritted my teeth and \
    approached... and suddenly a <font color=\"#ffd200\">monster</font> jumped out! \nUgh, it was so scary. I \
    don't even want to think about it again."
set key[id=1216171211001508] name "If I can't bring back the filming tape, my seniors will chew me out...\nI \
    really don't have the guts to go back in there. It's too scary. \n$MyPCName$, could you retrieve the <font \
    color=\"#ffd200\">filming tape</font> for me? \nIf a few adventurers go together, it would be over in no \
    time..."
set key[id=1216171211001509] name "Don't tell me... you're scared too, $MyPCName$? \nThen <font \
    color=\"#ffd200\">recruiting party members</font> to go together is one way.\nAs for me... I still couldn't \
    go, though. "
set key[id=1216171211001510] name "Oh, $MyPCName$! I dozed off a bit while waiting. Haha....\nI dreamed I became a \
    wonderful broadcaster like <font color=\"#ffd200\">Senior $npc:11001193[gender:1]$</font>.\nI hear she went to \
    <font color=\"#ffd200\">$map:2000007$</font> to retrieve a camera, \nso I should try contacting her to see if \
    she's still there. "
set key[id=1216171211001511] name "(Hand over the filming tape and ask him to check it.)"
set key[id=1216171211001512] name "<font color=\"#ffd200\">$item:30000417$</font>... yes, this is it!\n$MyPCName$, \
    thank you so much! Thank you, thank you! "
set key[id=1216171211001513] name "Oh my? Coming to such a remote place... \nAre you an adventurer? "
set key[id=1216171211001514] name "(Ask if she knows <font color=\"#ffd200\">$npc:11001191[gender:1]$</font>.)"
set key[id=1216171211001515] name "Yes. $npc:11001191[gender:1]$ and I joined the company together. We're \
    preparing a program together. \nOh, is <font color=\"#ffd200\">$npcName:11001191[gender:1]$ looking for \
    me?</font> "
set key[id=1216171211001516] name "(Tell her someone has been wondering if something happened.)"
set key[id=1216171211001517] name "Oh dear, I thought so.  \nYes, I almost got a tour of hell trying to <font \
    color=\"#ffd200\">retrieve the filming camera</font>. Hohoho.\nWell, <font color=\"#ffd200\">this morning was \
    hell too</font>, pretending to laugh sincerely at the director's jokes."
set key[id=1216171211001518] name "What? Do I sound too sarcastic? \nBut if I don't comfort myself like this, I'm \
    too sad to go on living. \nIn this world where everything goes up except my grades and my pay~ wow~ \
    b.e.a.u.t.i.f.u.l~"
set key[id=1216171211001519] name "<font color=\"#909090\">(She's definitely smiling, but she doesn't look the \
    least bit happy.)</font>"
set key[id=1216171211001520] name "If I'd been paid mesos for every hour I've worked, I'd have bought a <font \
    color=\"#ffd200\">house in Tria</font> by now.\nBut the reality is I'm a <font color=\"#ffd200\">Woodbury \
    cram-room resident</font>! That's how it is. Hohoho... \n...Oh, I got a bit worked up. Sorry. Back to the \
    point."
set key[id=1216171211001521] name "$MyPCName$, could you retrieve the <font color=\"#ffd200\">filming \
    tape</font>\nfrom the camera set up in there? I couldn't get it because of a <font color=\"#ffd200\">violent \
    creature</font>. \nBut $npcName:11001191[gender:1]$ is probably still waiting anxiously for me...."
set key[id=1216171211001522] name "$MyPCName$, the monster that appears here is rather... loud and violent. \nIt \
    might be safer to <font color=\"#ffd200\">recruit party members</font> and go together."
set key[id=1216171211001523] name "<font color=\"#ffd200\">$item:30000418$</font>... perfect! Exactly right. \nSo \
    the rumor that you're <font color=\"#ffd200\">our neighborhood fixer</font>, $MyPCName$, was true!"
set key[id=1216171211001524] name "I'd better take this to <font \
    color=\"#ffd200\">$npcName:11001191[gender:1]$</font> quickly and tell her we can start the edit.\nThanks to \
    you, $MyPCName$, my colleague will get some strength back. Thank you! "

# Quest dialogue of the DoubleImpactStory quests (feature DoubleImpactStory) that no pack has in English: our own
# English for the 130 scriptquest rows of locale KR (or no locale) whose quest a player can get (20 quests),
# with each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=728172802005665] name "It's been a while, $MyPCName$.\nI have something important to tell you... meet \
    me separately at $map:52000044$ in $map:02000100$.\nThere are a lot of eyes around, so move carefully."
set key[id=728172802005666] name "It's been a while, $MyPCName$.\nI have something important to tell you... meet \
    me separately at $map:52000044$ in $map:02000100$.\nThere are a lot of eyes around, so move carefully."
set key[id=728172802005667] name "Why are you so late?\nNobody followed you here, right?"
set key[id=728172802005668] name "Don't get excited, and listen carefully to what I say."
set key[id=728172802005669] name "Hm? \nShh!! Wait, what was that noise?"
set key[id=728172802005670] name "$MyPCName$! Are you all right?\nIt seems someone was secretly tailing you. "
set key[id=728172802005671] name "The members will be swarming back soon. We have to get out of here \
    quickly.\nI've prepared a hiding place near $map:02000138$ where no one will notice you.\nTake this car and go \
    there!"
set key[id=728172802005672] name "What are they to you, that you'd risk your life like this... sigh... \nThere's a \
    secret room beneath the Black Star Society headquarters.\nI once heard that the people you're looking for are \
    locked up there."
set key[id=728172802005673] name "$MyPCName$, how are you feeling?\nAre you all right? Do you... remember?"
set key[id=728172802005677] name "There's no need for long words between us now... \n<font color=\"#ffd200\">Gray \
    Wolf</font>... let this life end quietly here."
set key[id=728172802005678] name "Well, they're people I have nothing to do with anyway... live or die, it's none \
    of my business.\n<font color=\"#ffd200\">Gray Wolf</font>... unlike you... heh heh heh... "
set key[id=728172802005680] name "What happened? Are you hurt anywhere?"
set key[id=728172802005681] name "There's no sender's name... but it must be that person, right?\nThe one who \
    saved you at $map:52000045$... \nShall we go find <font color=\"#ffd200\">$map:63000038$</font> right now?"
set key[id=728172802005682] name "A mysterious, unidentified presence can be felt.\nCould the sender of the note \
    have left it behind...?"
set key[id=809112302005689] name "<font color=\"#ffd200\">$MyPCName$</font>!! It's been a while. \nSo, how are you \
    holding up these days?"
set key[id=809112302005690] name "<font color=\"#ffd200\">$MyPCName$</font>!! It's been a while. \nSo, how are you \
    holding up these days?"
set key[id=809112302005691] name "$npcName:11001558[gender:1]$ quietly passed on news of you...\nAs for \
    $npcName:11001557[gender:0]$, that guy's temper... sigh... he's hopeless. That's just how he is, by \
    nature.\nAhem... it doesn't really suit me to say this, but... \nhold your head high! Don't lose heart...! "
set key[id=809112302005692] name "Agonizing alone like that won't solve anything.\nIt's obvious who you need \
    answers from! They even told you to come back, didn't they?"
set key[id=809112302005693] name "That place that threw you into confusion... <font color=\"#ffd200\">Beyond \
    Link</font>.\nThere must be a way out of your confusion there!"
set key[id=809112302005694] name "This place feels familiar... it's $map:02000138$!!\nI definitely went into \
    $map:52000039$... did <font color=\"#ffd200\">that guy</font> bring me here...?"
set key[id=809112302005695] name "<font color=\"#ffd200\">That guy</font>... must know something. \nWhatever the \
    cost... I'll find out who I am... and what the secret of the\n<font color=\"#ffd200\">Lost Child</font> is!"
set key[id=809112302005696] name "<font color=\"#ffd200\">That guy</font>... must know something. \nWhatever the \
    cost... I'll find out who I am... and what the secret of the\n<font color=\"#ffd200\">Lost Child</font> is!"
set key[id=809112302005697] name "The Master, who vanished into the capsule... \nCould the secret I'm looking for \
    be inside?"
set key[id=809112302005698] name "Let's step into the capsule and try to travel."
set key[id=809112302005699] name "Let's step into the capsule and try to travel."
set key[id=809112302005700] name "Are you all right...?"
set key[id=809112302005701] name "First, come back with me to our new dwelling.\nFollow me."
set key[id=809112302005702] name "First, come back with me to our new dwelling.\nFollow me."
set key[id=809112302005703] name "Let me see. \nAre you hurt anywhere? Arms and legs fine? Eyes... nose... \
    mouth... "
set key[id=809112302005704] name "It's a bit... lacking compared to our old home at $map:52000041$, isn't it?\nHeh \
    heh heh... but it's livable enough.\nYou'll get used to it soon."
set key[id=809112302005705] name "It's a bit... lacking compared to our old home at $map:52000041$, isn't it?\nHeh \
    heh heh... but it's livable enough.\nYou'll get used to it soon."
set key[id=809112302005706] name "$map:02000192$... first, we should go there."
set key[id=809112302005707] name "$MyPCName$, will you come with us?"
set key[id=809112302005708] name "$MyPCName$! \nWhat are you spacing out thinking about now?\nShake off all other \
    idle thoughts and think only of the <font color=\"#ffd200\">Divine Relic</font>...! Only the Divine \
    Relic.\nCome, there's no time to dawdle. Let's go!"
set key[id=809112302005709] name "You found the entrance to the final destination of the Munakra pilgrimage."
set key[id=809112302005710] name "It sounds like $npcName:11001557[gender:0]$ and $npcName:11001558[gender:1]$ are \
    talking inside.\nLet's go in."
set key[id=809112302005711] name "It sounds like $npcName:11001557[gender:0]$ and $npcName:11001558[gender:1]$ are \
    talking inside.\nLet's go in."
set key[id=809112302005712] name "Oh no... in the end...!!\n$npcName:11001557[gender:0]$ and \
    $npcName:11001558[gender:1]$ have used up all their strength... \n$MyPCName$, are you all right...?"
set key[id=809112302005713] name "$MyPCName$, listen carefully to me.\nI'll send you to $map:52000050$ together \
    with $npcName:11001557[gender:0]$ and $npcName:11001558[gender:1]$, so rest there first and\nrecover your \
    strength."
set key[id=809112302005714] name "Once you've recovered a bit, look for the <font color=\"#ffd200\">glowing \
    stone</font> inside the training ground and examine it.\nYou'll learn what you need to do."
set key[id=809112302005715] name "The dark memories shaking my heart... only I can cut this darkness out... \nI \
    can't put Guidance in danger because of me any longer..."
set key[id=809112302005716] name "The <font color=\"#ffd200\">revelation</font>... the people being dragged away \
    in it... \nthey were the people I saw in the secret room with that guy. The ones he said would share my \
    fate... \nI <font color=\"#ffd200\">have to tell</font> the <font color=\"#ffd200\">person</font> I met \
    there..."
set key[id=809112302005717] name "The <font color=\"#ffd200\">revelation</font>... the people being dragged away \
    in it... \nthey were the people I saw in the secret room with that guy. The ones he said would share my \
    fate... \nI <font color=\"#ffd200\">have to tell</font> the <font color=\"#ffd200\">person</font> I met \
    there..."
set key[id=809112302005718] name "I can sense an Animar stronger than ever before...\nIs it the Master's \
    presence...? Or the power radiating from the <font color=\"#ffd200\">Divine Relic</font>...?"
set key[id=812174702005749] name "Tell me what's going on."
set key[id=812174702005750] name "$npcName:11000251[gender:0]$... that person is trying to get rid of you."
set key[id=812174702005751] name "What are you talking about, all of a sudden?"
set key[id=812174702005752] name "Well... I don't know why he suddenly changed his mind and wants to harm you \
    either.\nI only happened to learn that Black Star Society members are secretly planning to hurt you\nand are \
    on your trail... "
set key[id=812174702005753] name "Why are you risking so much to tell me this?"
set key[id=812174702005754] name "Ahem... well... that's... \nThe truth is, I... you... "
set key[id=812174702005755] name "Hm? \nShh!! Wait, what was that noise?"
set key[id=812174702005756] name "But first, I have to rescue the people from the back alleys that the Black Star \
    Society took."
set key[id=812174702005757] name "Your life is about to end, and you're worried about other people?\nJust go. Get \
    out of here, hurry!"
set key[id=812174702005758] name "I need to find where the back-alley people are being held."
set key[id=812174702005759] name "What are they to you, that you'd risk your life like this... sigh... \nThere's a \
    secret room beneath the Black Star Society headquarters.\nI once heard that the people you're looking for are \
    locked up there."
set key[id=812174702005760] name "What happened?"
set key[id=812174702005761] name "After I sent you off, I explained the situation to $npcName:11001545[gender:0]$ \
    and $npcName:11001546[gender:0]$ and\nasked them to help you. We've spent time together, after all... \nThey \
    say that when they reached the underground secret room, <font color=\"#ffd200\">that person</font> they once \
    ran into at <font color=\"#ffd200\">Beyond Link</font> \nwas there, holding you up as you lay unconscious."
set key[id=812174702005762] name "That's all we know too. Before they could even ask what was going on, that \
    person...\nsaid only to look after you, and vanished like the wind."
set key[id=816135802005770] name "Where did you spirit the back-alley people away to?"
set key[id=816135802005771] name "Heh heh... your own life is hanging by a thread, and you worry about others? \nI \
    suppose you got this far because you're that foolish... \nThe people you're looking for, I didn't spirit them \
    away. <font color=\"#ffd200\">Shadow monsters</font> swooped in\nand they all vanished... "
set key[id=816135802005772] name "Well, they're people I have nothing to do with anyway... live or die, it's none \
    of my business.\n<font color=\"#ffd200\">Gray Wolf</font>... unlike you... heh heh heh... "
set key[id=816135802005773] name "(Tell her what happened at $map:63000016$.)"
set key[id=816135802005774] name "Oh... I see.\n$npcName:11001740[gender:0]$'s competitive streak saved your life, \
    then.\nSo, what will you do now? You're not planning to charge in recklessly again, are you?"
set key[id=816135802005775] name "I'm thinking about it."
set key[id=816135802005776] name "Stop with the pointless thoughts.\nWhether it's fate or a trap, I can't tell... \
    but while you were away, a bird flew in through the window\nand dropped a note. This is what it said."
set key[id=816135802005777] name "'Gray Wolf... the people you're looking for are probably held in the grip of \
    <font color=\"#ffd200\">$npcName:11001559[gender:0]$</font>. \nLook for <font \
    color=\"#ffd200\">$map:63000038$</font> in <font color=\"#ffd200\">$map:02000275$</font>.\nHurry, before they \
    become $npcName:11001559[gender:0]$'s sacrifices.'"
set key[id=816135802005778] name "There's no sender's name... but it must be that person, right?\nThe one who \
    saved you at $map:52000045$... \nShall we go find <font color=\"#ffd200\">$map:63000038$</font> right now?"
set key[id=817105702005779] name "I'm so confused I don't know what to do."
set key[id=817105702005780] name "You... sigh... you're in worse shape than I thought... \nSnap out of it, \
    $MyPCName$!!\nEven if I left Guidance and am now nothing but a fatso, as someone who once followed the \
    Master\nand as an old schoolmate, let me give you some advice... "
set key[id=817105702005781] name "Nothing about your past or what happened is certain yet.\nDon't let yourself be \
    tossed around over something even you aren't sure of. \nRight and wrong in this world?\nNo one, human or \
    beastkin, will ever know for certain~!"
set key[id=817105702005782] name "You rolled around in Guidance once, and now look at you, wrapped up in hopeless \
    worries and drooping around... \nI'm disappointed, you punk!"
set key[id=817105702005783] name "I'm afraid of learning the truth."
set key[id=817105702005784] name "So you'll just keep suffering inside for the rest of your life?\nA wound you \
    cover up so it can't be seen will fester and burst in the end. \nYou have to look at it straight, drain the \
    pus and cut away the rot before new flesh can grow, right?"
set key[id=817105702005785] name "Even if it's painful and hard to face, it's something you have to go through \
    once anyway. \nGo find those guys, open your eyes wide and look squarely at your past and present.\nOnly then \
    can you decide your own future. "
set key[id=817105702005786] name "That place that threw you into confusion... <font color=\"#ffd200\">Beyond \
    Link</font>.\nThere must be a way out of your confusion there!"
set key[id=817105702005787] name "(Nod.)"
set key[id=817105702005788] name "Good... that's a relief... "
set key[id=817105702005789] name "<font color=\"#909090\">(Full of self-blame)</font> It was all my fault."
set key[id=817105702005790] name "Whether it was your will or not, bear the guilt of what your actions caused by \
    yourself.\nIf you feel you owe us a debt of the heart, repay it by recovering the stolen Relic."
set key[id=817105702005791] name "As a <font color=\"#ffd200\">member of Guidance</font>!"
set key[id=818143502005792] name "Wooow... you're all fine... sob sob... \nI missed you, $MyPCName$! What on earth \
    happened?"
set key[id=818143502005793] name "Let me tell you what's happened since."
set key[id=818143502005794] name "I see... \nYou must have been very upset with us...? Letting you leave all alone \
    like that weighed on my heart... sigh... \nSenior $npcName:11001557[gender:0]$ didn't show it,\nbut he kept \
    watching over you from afar, worried something might happen to you."
set key[id=818143502005795] name "Anyway, I'm so glad you're back. \nI'm so happy!!"
set key[id=818143502005796] name "Where is this place?"
set key[id=818143502005797] name "Ah~ this place... it's a training ground where the Munakra have trained for \
    generations.\nWe were following the Munakra training path in search of traces of the <font \
    color=\"#ffd200\">Divine Relic</font>, and we've been staying here."
set key[id=818143502005798] name "I'd do anything if it could ease my debt of the heart even a little."
set key[id=818143502005799] name "All right... \nBut keep your wits about you so you don't make mistakes out of \
    haste.\nYou haven't forgotten what the Master always told you on Mt. Neoulbit, have you?"
set key[id=818143502005800] name "<font color=\"#909090\">(Recalling $npcName:11001556[gender:0]$ as I saw him at \
    Beyond Link)</font> Master... "
set key[id=818143502005801] name "$MyPCName$! \nWhat are you spacing out thinking about now?\nShake off all other \
    idle thoughts and think only of the <font color=\"#ffd200\">Divine Relic</font>...! Only the Divine \
    Relic.\nCome, there's no time to dawdle. Let's go!"
set key[id=818143502005802] name "<font color=\"#909090\">(Nodding)</font> What happened?"
set key[id=818143502005803] name "We'll talk about that in detail later. \nWhat matters is that we've met again \
    here and now, isn't it?\nI'm grateful, and proud of you all, for holding on and making it this far... "
set key[id=818143502005804] name "But still... $npcName:11001559[gender:0]$!! \nIn the end, the <font \
    color=\"#ffd200\">Divine Relic</font> has fallen into that fiend's hands."
set key[id=818143502005805] name "Once you've recovered a bit, look for the <font color=\"#ffd200\">glowing \
    stone</font> inside the training ground and examine it.\nYou'll learn what you need to do."
set key[id=822144305001643] name "There's a mark, so this must be the place.\nLet's hurry inside."
set key[id=822144305001644] name "Let's hurry inside."
set key[id=822144305001645] name "Phew... you managed to find this place."
set key[id=822144305001646] name "The people you're looking for...\nyou'll find them if you go down to \
    $map:63000039$."
set key[id=822144305001647] name "Hurry."
set key[id=822144305001648] name "Be quick."
set key[id=822144305001649] name "I heard all the back-alley people came back safely.\nYou went through quite a \
    commotion to save them."
set key[id=822144305001650] name "I still can't understand the obsession you showed while searching for them.\nIt \
    doesn't seem like you did it just to play the champion of justice."
set key[id=822144305001651] name "That's none of your business."
set key[id=822144305001652] name "An answer I expected, so I'm not even surprised.\nOh, right, the people you \
    helped came looking for me.\nThey asked me to get a pair of knuckles for you."
set key[id=822144305001653] name "The powerful energy radiating from the mark feels like it's pulling at my \
    body.\nLet's hurry inside."
set key[id=822144305001654] name "Let's hurry inside."
set key[id=822144305001655] name "Huff... huff... why... did you have to come here at that moment?\nIf it weren't \
    for you, I could have brought him down."
set key[id=822144305001656] name "Ugh... I have to take that thing down..."
set key[id=822144305001657] name "Let me pour my energy into you to heal your wounds."
set key[id=822144305001658] name "Ugh..."
set key[id=822144305001659] name "If you stay still for a while, the wound will close."
set key[id=822144305001660] name "Got it... hold out until I get there!"
set key[id=822144305001661] name "Don't let him beat you until I get there!"
set key[id=822144305001662] name "Hmm..."
set key[id=822144305001663] name "I think I failed."
set key[id=822144305001664] name "He's definitely alive.\nWe haven't recovered the Divine Relic,\nbut for the \
    Relic to shine, it needs a noble Animar."
set key[id=822144305001665] name "A guy who abandoned Guidance and bowed to the darkness can't possibly have that \
    ability,\nso the Relic must have lost its light again."
set key[id=822144305001666] name "There's something you need to see.\nPut your worries about the Relic aside for a \
    moment and come with me."
set key[id=822144305001667] name "Let's go."
set key[id=822144305001668] name "I found out about this by chance while investigating here.\nIt seems you weren't \
    the only one who disappeared from this place."
set key[id=822144305001669] name "<font color=\"#909090\">(Biting my lip)</font> I knew."
set key[id=822144305001670] name "Stop suffering alone and share your pain!\nYou have people beside you as close \
    as family."
set key[id=822144305001671] name "(Look at him in bewilderment.)"
set key[id=822144305001672] name "Look at us right in front of you.\nDamn it, do I really have to say it out loud \
    for you to get it?"
set key[id=822144305001673] name "You are... a disciple of Guidance.\nEven if we don't share blood, we are \
    family."
set key[id=831204405001674] name "And you knew who that person was?"
set key[id=831204405001675] name "It seems he was someone very close to me."
set key[id=831204405001676] name "Someone very close, huh...\nSo you've been hurting this whole time over not \
    being with him?"
set key[id=831210405001677] name "You dazed fool!\n<font color=\"#909090\">(Looks at you silently.)</font>"
set key[id=831210905001678] name "It's a gift with their hearts in it, so don't refuse. Take it."

# Quest dialogue of the EpicApocalypse quests that no pack has in English (feature EpicApocalypse01,
# EpicApocalypse02, EpicApocalypse03, EpicApocalypse04): our own English for the 287 scriptquest rows of locale KR
# (or no locale) whose quest a player can get (37 quests), with each row's own format fields, font tags and line
# breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=107110822004167] name "Oh, you're here?"
set key[id=107110822004168] name "What do you mean the rift's power has grown stronger?"
set key[id=107110822004169] name "That's... ugh, that rift.\nIt won't even give us time to talk."
set key[id=107110822004170] name "You'd better hear it from $npcName:11004783[gender:1]$ next to me."
set key[id=107110822004171] name "What is this..."
set key[id=107110822004172] name "$MyPCName$. \nYou may have caught a bit of it from $npcName:11004793$, \
    but...\nthe <font color=\"#ffd200\">power of the rift</font> has grown stronger."
set key[id=107110822004173] name "And... I can feel a <font color=\"#ffd200\">different power</font> inside the \
    rift than before.\nSomething unusual seems to have happened."
set key[id=107110822004174] name "Something unusual seems to have happened."
set key[id=107110822004175] name "Recently, the rift suddenly started shaking unstably\nand grew slightly in \
    scale."
set key[id=107110822004176] name "After that, <font color=\"#ffd200\">strange laughter</font> could be heard,\nand \
    an <font color=\"#ffd200\">unidentified orb</font> popped out too."
set key[id=107110822004177] name "An unidentified... orb?"
set key[id=107110822004178] name "Yes.\nIt was a dangerous-looking orb.\nWhile $npcName:11004793$ and I were \
    deliberating... we sent it to <font color=\"#ffd200\">'that person'</font> at the Frontier Foundation.\nWe had \
    no time to worry about it beyond that."
set key[id=107110822004179] name "That person?\n...Who is that?"
set key[id=107110822004180] name "Who else?!\n<font size='40'>It's none other than the great \
    $npcName:11004828[gender:0]$!</font>"
set key[id=107110822004182] name "Hmm~ why so startled?\nDid you do something bad?"
set key[id=107110822004183] name "How long have you been there?!"
set key[id=107110822004184] name "More importantly, now's not the time for that.\nThe great \
    $npcName:11004828[gender:0]$ has been analyzing that orb."
set key[id=107110822004185] name "!!!\nAmazing.\nWhat kind of object was it?"
set key[id=107110822004186] name "I took it to the lab and ran all sorts of studies...\nit's definitely not a \
    material from our world.\nWhat I did find out is that it's made of something similar to <font \
    color=\"#ffd200\">'Prism Stone'</font>."
set key[id=107110822004187] name "But the amazing part is yet to come. \nA researcher accidentally smashed that \
    orb,\nand I nearly fainted."
set key[id=107110822004188] name "<font size='40'>Who would have guessed there'd be <font color=\"#ffd200\">new \
    gear</font> inside?!</font>"
set key[id=107110822004189] name "Who would have guessed there'd be new gear inside?!"
set key[id=107110822004190] name "New... gear?"
set key[id=107110822004191] name "Yes.\nThe fact that it's scattering these things all over the \
    outside,\nsomething inside must be <font color=\"#ffd200\">luring</font> us in."
set key[id=107110822004192] name "I think we really do need to check inside.\nTo see what's going on."
set key[id=107110822004193] name "That's a piece of cake, but...\nI only need to take a look and come back, \
    right?"
set key[id=107110822004194] name "That's our $MyPCName$! \nSo brave!"
set key[id=107110822004195] name "Hm? This place is..."
set key[id=107110822004196] name "It's definitely different from before.\nDid a new space form?"
set key[id=107110822004197] name "I feel strange somehow..."
set key[id=107110822004198] name "Hee hee hee..."
set key[id=107110822004200] name "Hee hee hee..."
set key[id=107110822004201] name "Hee hee..."
set key[id=107110822004202] name "!!!\nWho's there!!!"
set key[id=107110822004203] name "It's me, me~ $npcName:11004831$!\nYou look really funny!"
set key[id=107110822004204] name "Black... what?"
set key[id=107110822004205] name "Yeah, yeah. $npcName:11004831$!\nA human I've never seen? I saw the white bear \
    and the lady outside the rift... hee hee.\nFunny, so funny!!!"
set key[id=107110822004206] name "...I don't know whether you're $npcName:11004831$ or Blue Bean,\nbut stop \
    stirring things up inside the rift."
set key[id=107110822004207] name "Heh heh heh. You really do look fun.\nYou! If you play with me, I'll give you \
    <font color=\"#ffd200\">something good</font>."
set key[id=107110822004208] name "?!\nDon't say weird things!\nDon't make the rift unstable..."
set key[id=107110822004209] name "I definitely told you!!!\n<font size='40'>Byeee~!!!</font>"
set key[id=107110822004210] name "...What.\nHe just says his piece and leaves?"
set key[id=107110822004211] name "Well... first.\nI'd better go see $npcName:11004816[gender:0]$."
set key[id=107110822004212] name "Hm? You're back sooner than I expected?\nWhat happened..."
set key[id=107110822004213] name "Something did happen, didn't it?"
set key[id=107110822004214] name "I met a strange black lump.\nIt said its name is... $npcName:11004831$."
set key[id=107110822004215] name "$npcName:11004831$...? That's a pretty cute name."
set key[id=107110822004216] name "So, what did that black bean tell you?"
set key[id=107110822004217] name "It said if I play with it, it'll give me <font color=\"#ffd200\">something \
    good</font>, and then vanished.\nWith a strange laugh."
set key[id=107110822004218] name "Something good? It said it would give you something good?!"
set key[id=107110822004219] name "Hoh......"
set key[id=107110822004220] name "All right.\nI've decided."
set key[id=107110822004221] name "At times like this, it's only human to do what's asked.\n$MyPCName$! You."
set key[id=107110822004222] name "Sigh... why are you like this too?"
set key[id=107110822004223] name "It's only human to do what's asked.\n$MyPCName$! You.\n<font size='40'>Play with \
    that $npcName:11004831$ regularly.</font>"
set key[id=107110822004224] name "You fool! It's all for your sake!\nIsn't it obvious what the good thing is?"
set key[id=107110822004225] name "<font size='40'>Something that can make you stronger.</font>"
set key[id=107110822004226] name "It's the guy who scatters new gear all over the place.\nHe's bound to have even \
    better stuff."
set key[id=107110822004227] name "Heh heh heh...!\nIt'll make great new research material."
set key[id=107110822004228] name "<font color=\"#909090\">Something that can make me... stronger.</font>"
set key[id=107110822004229] name "<font color=\"#909090\">...</font>\n<font color=\"#909090\">To protect Empress \
    $npcName:11004820$ and $map:02000001$, I need power.</font>"
set key[id=107110822004230] name "<font color=\"#909090\">In that case...</font>"
set key[id=107110822004231] name "All right.\nI'll go hang out with that black bean."
set key[id=107110822004232] name "I knew you'd say that!\nHeh."
set key[id=107110822004233] name "When you get something, give me a quiet heads-up.\nI'll head back to the \
    lab.\nSee you again soon!"
set key[id=107110822004234] name "$npcName:11001812[gender:0]$.\nWhy did you tell that youngster the whole truth?"
set key[id=107110822004235] name "$npcName:11001812[gender:0]$.\nWhy did you tell that youngster the whole truth?"
set key[id=107110822004236] name "$npcName:11001812[gender:0]$.\nWhy did you tell that youngster the whole truth?"
set key[id=107110822004237] name "Heh heh heh...\nAll of this was foretold by Him."
set key[id=107110822004238] name "Sealing the Empress... everything is His will.\nFor the plan to be complete, \
    that youngster's complacency will be the final ingredient."
set key[id=107110822004239] name "The unease that will take root as the Empress falls.\nThe seed of that unease \
    will sprout before long, too."
set key[id=107110822004240] name "How is the work of <font color=\"#ffd200\">scattering</font> the <font \
    color=\"#ffd200\">dark matter</font> going?"
set key[id=107110822004241] name "...Soon all of Maple World will be your domain.\n$npcName:11001812[gender:0]$."
set key[id=107110822004242] name "Welcome news indeed."
set key[id=107110822004243] name "Make your preparations.\nThe time will come soon."
set key[id=107110822004244] name "From now on... things are going to get very interesting."
set key[id=107141222004245] name "Then have a good trip!\nI won't go far~"
set key[id=107141422004246] name "When you're ready, go in just ahead."
set key[id=107142422004247] name "<font size='40'>From now on, play with that $npcName:11004831$ \
    regularly.</font>"
set key[id=107145422004248] name "You've come.\nMy old friend."
set key[id=107145422004249] name "Soon everyone in this land will come to fear the Empress..."
set key[id=107151122004250] name "...If that is His will... and yours, I will gladly follow."
set key[id=107151122004251] name "I only hope the path is one I can accept."
set key[id=107151122004252] name "No need to worry about that."
set key[id=108094322004253] name "<font color=\"#909090\">Wh-what?! This black lump is...!</font>"
set key[id=1209134222003780] name "...Well, I was wondering if I should meet the boss, but I don't think I \
    should.\nI think it should be fine to tell you my concerns, if it's you, $MyPCName$."
set key[id=1209134222003826] name "<font color=\"#909090\">While the black energy was fluctuating, a blue light \
    was seen intermittently. This energy... is not unfamiliar.</font>\n<font color=\"#909090\">A familiar... \
    energy.</font>"
set key[id=1209134222003996] name "$npcName:11000074[gender:0]$ is the one who guarded the royal family in my \
    place and protected the Alliance whenever I was in danger. Since this could overturn what he has said for so \
    many years and the foundation on which he has protected the world, we need evidence. For you, and for me. "
set key[id=1209134222004001] name "You're back, $MyPCName$.\nThe thing I asked for... is ready, I see. "
set key[id=1209134222004002] name "<font size=\"40\">...!!</font>\nYou? Why are you here?"
set key[id=1209134222004003] name "Your Majesty, this situation was created by my indecision in failing to cut off \
    the seed of treachery at once. I apologize for that. \nBut please, do not waver. My choice has always been \
    you, Your Majesty."
set key[id=1209134222004004] name "$npcName:11000074[gender:0]$... you said the same thing when you reported \
    $MyPCName$'s treason to me.\nI arranged this meeting because I do not want to doubt your loyalty."
set key[id=1209134222004005] name "There is only one thing I want: the <font color=\"#ffd200\">truth</font>."
set key[id=1209134222004006] name "$npcName:11000074[gender:0]$. It has been a long time since you and \
    $npc:11004744[gender:0]$ last met, hasn't it? \nExchange greetings."
set key[id=1209134222004007] name "It's been a while, $npcName:11000074[gender:0]$."
set key[id=1209134222004008] name "...Why are you here? \n$MyPCName$... you must have been bewitched by that man \
    and gone completely mad!\nHow dare you bring a man who tried to harm Her Majesty into Her Majesty's \
    bedchamber?"
set key[id=1209134222004009] name "Are you saying I bewitched that man? \nThat sounds more like your own story, \
    $npcName:11000074[gender:0]$."
set key[id=1209134222004010] name "You are before Her Majesty. Show some courtesy.\nStop blaming each other and \
    answer what Her Majesty wishes to know."
set key[id=1209134222004011] name "$npcName:11000074[gender:0]$, this is how I remember the day of the Lapenta \
    sealing.\nI was ill, and you told me to focus on recovering because you would let me know at once if anything \
    happened. I trusted you and left with the priests as you said."
set key[id=1209134222004012] name "When I returned a few days later, you told me that $npc:11001812[gender:0]$ had \
    given his life to complete the Lapenta sealing. And that $npcName:11004744[gender:0]$, tainted by darkness, \
    had come to the royal family and tried to harm me.\nBut $npcName:11004744[gender:0]$ said that visit that day \
    was to borrow my power. \nAnd that it was you, $npcName:11000074[gender:0]$, who blocked it."
set key[id=1209134222004013] name "Do you have anything to say to me about this, $npcName:11000074[gender:0]$?\nIf \
    there is anything you could not or did not tell me, I want you to say it all."
set key[id=1209134222004014] name "I have done my best for the royal family all along.\nMy heart has always been \
    true, and there were no lies."
set key[id=1209134222004015] name "Do not call what you have made up and want to believe the truth.\nDon't try to \
    cover the sky with the palm of your hand!"
set key[id=1209134222004016] name "Coward. You survived alone thanks to $npc:11001812[gender:0]$'s sacrifice, and \
    now you twist the truth.\nYour Majesty, do not be swayed by that man's slander. I..."
set key[id=1209134222004017] name "$npc:11000074[gender:0]$. Must I read aloud what was just found in your house \
    myself? \n$MyPCName$ found it with their own hands and brought it here."
set key[id=1209134222004018] name "$npc:11000074[gender:0]$. Must I read aloud what was just found in your house \
    myself? \n$MyPCName$ found it with their own hands and brought it here."
set key[id=1209134222004020] name "Even after seeing this, do you intend to keep claiming your innocence?\nUnless \
    you want me to doubt even your loyalty...\nspeak the truth now. I will not bear it any longer."
set key[id=1209134222004021] name "...$npc:11001812[gender:0]$ was a great hero.\nI never doubted that he could \
    have found a way somehow.\nThen there was no reason to put Your Majesty in danger, was there?"
set key[id=1209134222004022] name "...Did you really ignore $npc:11001812[gender:0]$'s request for help?\nAnd you \
    have hidden that all this time? How could you...!"
set key[id=1209134222004023] name "It was a <font color=\"#ffd200\">choice for the greater good</font>.\nSo that \
    Your Majesty would be safe, and this land could stay safe too..."
set key[id=1209134222004024] name "Look at what that choice has produced!\nIs this really what you wanted? "
set key[id=1209134222004025] name "There was always only one thing that mattered to me.\nProtecting the \
    $map:02000001$ royal family. "
set key[id=1209134222004026] name "Only if the royal family is protected can the world be protected.\nThreats have \
    always existed, but thanks to the royal family and Her Majesty remaining strong, haven't we always overcome \
    them?\nNo one can condemn my choice. They must not...!"
set key[id=1209134222004027] name "...Is that what I am?"
set key[id=1209134222004028] name "...Is that what I am?"
set key[id=1209134222004029] name "...Creating sacrifices for someone and putting them in danger in the name of my \
    safety.\nAnd new dangers arising from the army of darkness born of that."
set key[id=1209134222004030] name "Your Majesty...!"
set key[id=1209134222004031] name "So at the root of all this danger, I was there.\nAn ignorant me who knew \
    nothing of the countless tragedies caused by a truth hidden one layer behind."
set key[id=1209134222004032] name "Unable to know what other pain and tragedy I will cause, unable even to foresee \
    and prepare for it.\nAm I that kind of helpless, useless being?"
set key[id=1209134222004033] name "<font size=\"40\">If that is truly so, is there any reason for me to \
    exist?</font>"
set key[id=1209134222004036] name "(A huge rift has appeared in $map:52000197$.\nIt's as if space itself is \
    twisted... everything is warped and shaking.)"
set key[id=1209134222004037] name "(A strange and chilling aura...\nUnidentifiable laughter, wailing...)"
set key[id=1209134222004038] name "What... is this?"
set key[id=1209134222004042] name "...There is a way, $npcName:11004789[gender:0]$.\nEven if spacetime is \
    scrambled, as long as the flow within the path stretched out stays constant, it should be possible to keep the \
    way back open.\nIf you can hold on over here, purifying the power so the path can be maintained."
set key[id=1211180122004109] name "Heh heh, I haven't told you something important. It's $map:02000487$. \nSince a \
    completely new substance has appeared, we should entrust it to the place best able to investigate it."
set key[id=1211180122004110] name "Heh heh, I haven't told you something important. It's $map:02000487$. \nSince a \
    completely new substance has appeared, we should entrust it to the place best able to investigate it."
set key[id=1211180122004111] name "You said the amount we sent might not be enough...\nHow convenient. This \
    substance came from beyond the rift, so we could bring more if needed."
set key[id=1211180122004112] name "This substance may become the key to the rift... and to getting the fallen \
    Empress back on her feet."
set key[id=1211180122004113] name "$MyPCName$, I know it's hard, but I'm counting on you. \nWe'll stay here and \
    keep the passage to the rift open."
set key[id=1211180122004114] name "Go see $npc:11003883[gender:0]$ at $map:02000487$.\nHe should be able to tell \
    you more."
set key[id=4540107025480155145] name "I've been waiting for you, my other half.\nThe reason I called you here is \
    the rift in spacetime."
set key[id=4559708775182761993] name "Ahem...!\nYou haven't forgotten already, have you?\nGo up the stairs on the \
    right to reach $map:52000196$."
set key[id=4559708775182761994] name "Since the last time the rift shook, the Frontier Foundation has kept \
    investigating this phenomenon.\nRecently we discovered some suspicious movements."
set key[id=4559708775182761995] name "Suspicious movements?"
set key[id=4559708775182761996] name "Yes, a link to the dark matter found in $map:02000001$."
set key[id=4559708775182761997] name "At a glance, the spacetime rift and the dark matter don't seem closely \
    related...\nbut research results suggest the dark matter may speed up the rift's disruption of space."
set key[id=4559708775182761998] name "By now the survey data should be somewhat complete.\nWould you like to meet \
    $npcName:11004032[gender:0]$ at $map:52000196$?"
set key[id=4559708775182761999] name "Hm? Research data?\nOh, the dark matter research data?"
set key[id=4559708775182762000] name "You mean $npcName:11004032[gender:0]$'s research data, right?\nIf it's the \
    dark matter survey, it should be here or on that shelf over there. One moment."
set key[id=4559708775182762001] name "Ask that guy over there about the dark matter survey data.\nSee the details \
    for yourself."
set key[id=4559708775182762002] name "The dark matter is just as we expected.\nIt was full of shadow energy."
set key[id=4559708775182762003] name "But here's the unusual part.\nWe could faintly sense the power of Blue \
    Lapenta."
set key[id=4559708775182762005] name "For the research data on the dark matter, why not look through that pile of \
    books over there?\nOh, and please don't touch that bookshelf. I only just finished sorting it yesterday."
set key[id=4559708775182762008] name "For the research data on the dark matter, why not look through that pile of \
    books over there?\nOh, and please don't touch that bookshelf. I only just finished sorting it yesterday."
set key[id=4559708775182762009] name "Did you check the research data?\nThere are still many questions, but our \
    hypothesis is that the stronger Illusion monsters appearing, unlike at first, are related to this."
set key[id=4559708775182762010] name "And one more thing: we believe someone is artificially combining the power \
    of Blue Lapenta with the power of shadow to accelerate the rift's chaos."
set key[id=4559708775182762011] name "$MyPCName$, if it's all right, would you pass this on to the two guarding \
    the rift now?\nIt will help us find a clue to the rift."
set key[id=4559708775182762012] name "Would you pass this on to the two guarding the rift right away?\nThis will \
    help us find a clue to the rift."
set key[id=4559708775182762013] name "Thank you for letting us know.\nArtificial Blue Lapenta power, huh...."
set key[id=4559708775182762014] name "Who on earth is doing this?"
set key[id=4559708775182762015] name "Who on earth is doing this?\nIf it's the power of Blue Lapenta, then \
    already...."
set key[id=4559708775182762016] name "Come to think of it, there is a place I suspect."
set key[id=4559708775182762017] name "Ah, could it be...!"
set key[id=4559708775182762018] name "That's right. You may have heard a story long ago that the power of Blue \
    Lapenta was inherited."
set key[id=4559708775182762019] name "A place where the power of Blue Lapenta remains... I see.\nThat makes \
    perfect sense."
set key[id=4559708775182762020] name "But as you know, the exact place where that power was inherited isn't \
    known.\nEveryone is only guessing."
set key[id=4559708775182762021] name "My other half, are you ready?"
set key[id=4559708775182762022] name "Do you know there used to be a place called the Fortress of Souls?\nIt's \
    deep within $map:02000192$ on Victoria Island."
set key[id=4559708775182762023] name "You must have heard of $map:02000192$ on Victoria Island.\nThe energy at the \
    place once called the Fortress of Souls has been unusual lately, so we've been keeping an eye on it."
set key[id=4559708775182762024] name "....\n(The dark matter is here too. Why is it here...?)"
set key[id=4559708775182762025] name "I see. \nA guardian golem already running amok... the situation may be more \
    serious than I thought."
set key[id=4559708775182762027] name "That's right. As expected, there's unusual energy there, which is why we've \
    been watching it.\nPlease find out whether there's anything suspicious about that place."
set key[id=4559708775182762031] name "$MyPCName$! You came at just the right time! The rift's power is getting \
    stronger."
set key[id=4559708775182762032] name "The rift's power is getting stronger?"
set key[id=4559708775182762033] name "That's right. It's not only growing stronger, the distortion is getting \
    worse too."
set key[id=4576139967142559833] name "Oh, come to think of it, there is a suspicious location that was reported \
    recently."
set key[id=4576139967142559835] name "....\n(I can feel powerful energy behind the door. Let's go in and \
    investigate.)"
set key[id=4576139967142559836] name "....\n(I can feel powerful energy behind the door. Let's investigate the \
    suspicious space.)"
set key[id=4576139967142559837] name "A guardian golem already running amok... the situation may be more serious \
    than I thought.\nWould you let the two holding back the rift know about this too?"
set key[id=4576139967142559838] name "Oh, and $MyPCName$, would you let the two holding back the rift know about \
    this too?"
set key[id=8039079133340237833] name "I've been waiting for you, my servant.\nThere is something important I'd \
    like to entrust to you."
set key[id=8039079133340237834] name "The reason I called you this time is..."
set key[id=8320447105235681289] name "Is it the rift in spacetime again?"
set key[id=8320447105235681290] name "No, it's the <font color=\"#ffd200\">concert</font>."
set key[id=8320447105235681291] name "...What?"
set key[id=8320447105235681292] name "You may wonder what kind of concert at a time like this, \nbut at times like \
    this, people need comfort even more. \nMusic is an art that soothes anxious hearts better than anything."
set key[id=8320447105235681293] name "The Foundation will soon begin a concert it is hosting. Please help prepare \
    for it.\n$npcName:11003884[gender:0]$ will give you the details."
set key[id=8320447105235681294] name "Ask $npcName:11003884[gender:0]$ about anything concert-related."
set key[id=8320447105235681295] name "Did the young lady explain everything to you?\nThis seems to be your first \
    time doing this, so I have my doubts about whether you can manage."
set key[id=8320447105235681306] name "Still not gone? Hurry to the meeting room."
set key[id=8320447105235681315] name "(There's no one in the meeting room, only <font color=\"#ffd200\">dark \
    matter</font>!)"
set key[id=8320447105235681316] name "Then let me tell you about preparing the Frontier Foundation's <font \
    color=\"#ffd200\">Maple World Concert</font>."
set key[id=8320447105235681317] name "The orchestra is in its final rehearsal at $map:52100400$ right \
    now.\nThey're artists, so they're all quite sensitive."
set key[id=8320447105235681318] name "Go and check whether the members need anything,\ncheck the humidity, \
    temperature, lighting and so on,\nwhether they want meals or tea, when to serve it, what kind, and so \
    forth..."
set key[id=8320447105235681319] name "($npcName:11003884[gender:0]$'s instructions went on for nearly thirty \
    minutes...)"
set key[id=8320447105235681320] name "...When rehearsal prep is done, please lead everyone to the stage here.\nAre \
    you dozing off by any chance?"
set key[id=8320447105235681321] name "N-no. But what does $npcName:11003884[gender:0]$ do?"
set key[id=8320447105235681322] name "I do the most important job. Assisting the young lady.\nAny more questions?"
set key[id=8320447105235681324] name "If there are no questions, please head to $map:52100400$ right away.\n<font \
    color=\"#ffd200\">(Accepting the quest will take you to $map:52100400$.)</font>"
set key[id=8320447105235681326] name "(In the blood-red darkness, music and a woman's aria can faintly be \
    heard.\nAre the orchestra members inside? Let's investigate the aria's space.)\n \n<font size='35'>Accepting \
    the quest will take you to $map:52100401$.<font size='35'>"
set key[id=8320447105235681327] name "(In the blood-red darkness, music and a woman's aria can faintly be \
    heard.\nAre the orchestra members inside? Let's investigate the aria's space.)"
set key[id=8320447105235681328] name "Why did you come alone? Where are the orchestra members?"
set key[id=8320447105235681329] name "What's going on? Where are the members? The concert is about to begin."
set key[id=8320447105235681330] name "(Report the situation in the meeting room.)"
set key[id=8320447105235681331] name "What? <font color=\"#ffd200\">Dark matter</font> in the middle of the \
    Foundation!\nAnd you say the members were sucked into the spacetime rift and turned into monsters?\nWe have to \
    get to the bottom of this quickly!"
set key[id=8320447105235681332] name "$MyPCName$, please go right now to $npcName:11004802[gender:0]$ at \
    $map:52000196$ and tell him about this. \nWe'll keep checking whether the members are anywhere else."
set key[id=8320447105235681333] name "Please hurry to $map:52000196$. We'll keep searching for the members."
set key[id=8320447105235681334] name "What did you say? Dark matter showed up right where the great \
    $npcName:11004802[gender:0]$ is?!"
set key[id=8320447105235681335] name "Well, well! The lamp's shadow is darkest underneath. How dare they make a \
    fool of me! \nI'll go investigate right now. Did blue light leak out again, like last time?"
set key[id=8320447105235681336] name "(Say that this time a red glow was floating around.)"
set key[id=8320447105235681337] name "A red glow...? Don't tell me... the aura of <font color=\"#ffd200\">Red \
    Lapenta</font>?!"
set key[id=8320447105235681338] name "I must hurry to the meeting room. First I'll grab my research \
    equipment.\nHey, ask $npcName:11003883[gender:0]$ to seal off the meeting room first!"
set key[id=8320447105235681340] name "This, this... and this too...\nHm? What are you doing, why aren't you going? \
    Every minute counts!"
set key[id=8320447105235681341] name "My servant, this is serious!"
set key[id=8320447105235681342] name "Reports have come in that orchestra members have vanished elsewhere \
    too.\nLeave the meeting room incident to $npcName:11004802[gender:0]$ for now and go meet \
    $npcName:11004876[gender:0]$ at $map:52100404$.\nThe situation is urgent, so I'll send you right away.\n<font \
    color=\"#ffd200\">(Accepting the quest will take you to $map:52100404$.)</font>"
set key[id=8320447105235681343] name "There's no time. Hurry and meet $npcName:11004876[gender:0]$."
set key[id=8320447105235681344] name "Are you from the Foundation?\nAh... I don't know how this happened.\nPlease, \
    save our members!"
set key[id=8320447105235681345] name "Please seal off this place and keep people out. I'll report the situation to \
    the Foundation."
set key[id=8320447105235681356] name "Please! Contact the Foundation and be sure to save our members!"
set key[id=8320447105235681357] name "How are things at $map:52100404$?"
set key[id=8320447105235681358] name "I see. So every performer in Maple World is a target.\nDella Rosa... I know \
    that prima donna well.\nTo think the woman we all thought dead is behind this..."
set key[id=8320447105235681359] name "On top of that, $npcName:11004802[gender:0]$ analyzed the dark matter and \
    says\nthe energy of the <font color=\"#ffd200\">Red Lapenta</font> can be sensed inside it.\nThere is no doubt \
    that the <font color=\"#ffd200\">Legion of Darkness</font> is behind this."
set key[id=8320447105235681360] name "Nobody but the Seven Heroes' $npcName:11000001[gender:0]$ knows where the \
    Red Lapenta is hidden.\n$npcName:11000001[gender:0]$ is unconscious right now, so how did they find out and \
    plan all this?"
set key[id=8320447105235681361] name "I'll go to $map:52100402$."
set key[id=8320447105235681362] name "Please do. When you come back, report straight to \
    $npcName:11004802[gender:0]$.\n<font color=\"#ffd200\">(If you accept this quest, you will be moved to \
    $map:52100402$.)</font>"
set key[id=8320447105235681363] name "If you find a clue, report it to $npcName:11004802[gender:0]$."
set key[id=8320447105235681364] name "...So you came. "
set key[id=8320447105235681365] name "What brings you here?"
set key[id=8320447105235681366] name "It seems you came for the same reason as I did.\nI felt that someone was \
    trying to approach the <font color=\"#ffd200\">Red Lapenta</font>."
set key[id=8320447105235681367] name "That you made it this far is the will of the Red Lapenta... There is no need \
    to hide it any longer.\nI am, in truth, a guardian of the Red Lapenta. Strictly speaking, a <font \
    color=\"#ffd200\">temporary guardian."
set key[id=8320447105235681368] name "Before <font color=\"#ffd200\">Clark</font>, the guardian before me, passed \
    away,\nhe asked me to take his place."
set key[id=8320447105235681369] name "Who is Clark?"
set key[id=8320447105235681370] name "The wife of Henesys Elder $npcName:11000001[gender:0]$... and the mother of \
    $npcName:11004873[gender:0]$.\nUntil she left this world under unavoidable circumstances, she was <font \
    color=\"#ffd200\">the one who lived guarding the Red Lapenta</font>."
set key[id=8320447105235681371] name "The world believes the Seven Heroes' $npcName:11000001[gender:0]$ guarded \
    the Red Lapenta,\nbut grief over losing his wife kept him from taking up that duty.\nClark foresaw it and \
    entrusted the guardian's duty to me."
set key[id=8320447105235681372] name "Search the room. See if there is a sheet of music or anything like that."
set key[id=8320447105235681374] name "Is there anything unusual in the room? Please look around a bit more."
set key[id=8320447105235681375] name "Would you let me see it? Let's see...\nThis is a letter Clark left for \
    $npcName:11004873[gender:0]$."
set key[id=8320447105235681384] name "I'll read it. 'To my beloved son, I'm leaving a few lines before it's too \
    late. \nPlease understand why I was so harsh with you. It was all my fault. \nI wanted to make you the \
    guardian of Lapenta who would follow me.'"
set key[id=8320447105235681385] name "'I believe that one day you will be worthy. \nUntil then, Oscar will serve \
    as guardian in your place. \nIn return, I'm passing on to you the score of the <font color=\"#ffd200\">Aria of \
    Light and Darkness</font>.'"
set key[id=8320447105235681386] name "'When the music of the score and a voice wishing to protect the world ring \
    out together, \nthe hidden Lapenta of time will reveal itself.\nPlease carry on my mission. I'm counting on \
    you.\nAnd please protect your father. Mom...'"
set key[id=8320447105235681387] name "...That's all of it.\nSo $npcName:11004873[gender:0]$ has the score after \
    all.\nIf the aria was heard in the rift and the energy of darkness and the Red Lapenta were found \
    together,\nthe score has surely fallen into the hands of the <font color=\"#ffd200\">Legion of \
    Darkness</font>."
set key[id=8320447105235681388] name "What exactly is that score?"
set key[id=8320447105235681389] name "The score... the <font color=\"#ffd200\">Aria for Light and Darkness</font> \
    is...\nthe key to finding the Red Lapenta that Clark hid."
set key[id=8320447105235681390] name "(A long explanation of the score's role followed.)"
set key[id=8320447105235681391] name "I think that's all I can tell you. \nHurry to $map:52000196$ and let \
    $npcName:11004032[gender:0]$ know about this."
set key[id=8320447105235681392] name "Oh, you're here? Luckily, the member who turned into a monster is back to \
    normal.\nThough it took some rather violent methods.\nThe dark matter vanished before long, too."
set key[id=8320447105235681393] name "By the way, how did it go at $map:52100402$?"
set key[id=8320447105235681394] name "(Tell them what Oscar told me about the score and the Red Lapenta.)"
set key[id=8320447105235681395] name "Hmm, so to sum up,\nthe Red Lapenta is hidden in the axis of time running \
    through past, present and future,\nand to make it exist in the present again,\nthe song on that score has to \
    be performed."
set key[id=8320447105235681396] name "Wow, that's something. Clark, being a time mage, hid the Red Lapenta inside \
    time itself. No wonder nobody could find it. What a perfect safeguard!"
set key[id=8320447105235681397] name "But since the Red Lapenta's energy is so faint,\nthe score must not be \
    getting performed properly.\nStill, if that aria is combined with darkness and sung inside the rift,\nit will \
    twist the axis of time along with space, and the rift will speed up."
set key[id=8320447105235681398] name "Hurry and report to $npcName:11003883[gender:0]$!\nI'm going to dig into \
    this principle a bit more and trace the space of the aria."
set key[id=8320447105235681399] name "A particular wave of music reaching the axis of time... heh heh... this is \
    getting interesting.\nHuh, why are you still here?"
set key[id=8320447105235681400] name "My other half, have you found a lead?"
set key[id=8320447105235681401] name "(Tell them everything I heard so far from $npcName:11004872[gender:1]$ and \
    $npcName:11004802[gender:0]$.)"
set key[id=8320447105235681402] name "I see. This is no longer just a matter of missing orchestra members. It \
    concerns citizens' safety,\nthe rift in time and space, and the Red Lapenta. This is a grave situation."
set key[id=8320447105235681403] name "We will look after the safety of the performers who love music.\n$MyPCName$, \
    please stop the prima donna's performance from going ahead."
set key[id=8320447105235681404] name "Please take this."
set key[id=8320447105235681405] name "What's this instrument for?"
set key[id=8320447105235681406] name "They say members who play instruments get abducted to that space,\nso if you \
    play, you'll be able to get close to her easily, $MyPCName$."
set key[id=8320447105235681407] name "You'll need good playing skills to be abducted, so practice hard."
set key[id=8320447105235681408] name "Do your best. My follower."
set key[id=8320447105235681410] name "(No matter how much I practice, I don't think I'll ever improve, so I \
    returned the instrument...\nI'll have to find another way to approach the prima donna...)"
set key[id=8562174148191715337] name "You must know that when the rift shook last time, a being called \
    $npcName:11004831$ appeared.\nAfter that, it shook in a similar way about once more and grew slightly in \
    scale."
set key[id=8562174148191715338] name "Right, that wasn't a big problem.\nIt was more like $npcName:11004831$ \
    calling in a friend."
set key[id=8562174148191715339] name "We were outside the rift so we couldn't go in, but the pattern was similar \
    to last time.\nBut recently the rift has started shaking in a different way."
set key[id=8562174148191715340] name "To be precise, the distortion of the rift has gotten worse.\nAs if someone \
    were shaking the rift artificially...."
set key[id=8562174148191715341] name "And just then, word came from the Frontier Foundation.\nThat the traces of \
    Blue Lapenta seem to be affected...."
set key[id=8562174148191715342] name "Is there anything else that could be a clue?"
set key[id=8562174148191715343] name "$MyPCName$, have you heard about Red Lapenta?"
set key[id=8562174148191715344] name "To shake the power of spacetime this much, the power of Blue Lapenta, the \
    Lapenta of space, wouldn't be enough. The power of Red Lapenta, the Lapenta of time, would be needed."
set key[id=8562174148191715345] name "But for now, I can't think of any clue about Red Lapenta."
set key[id=8630889815291723785] name "I was hoping the Prism Shard and Stone research might progress further, but \
    no such luck.\nWhat a pity, what a pity."
set key[id=8632753985717010441] name "Ask that guy over there about the dark matter survey data.\nSee the details \
    for yourself."
set key[id=8632753985717010445] name "Even so, it isn't as hard to hold as before.\nWould you hear the details \
    from Luanna?"
set key[id=8632753985717010446] name "$MyPCName$, for now keep dealing with the monsters coming out of the \
    Illusion space as you have been.\nAnd if you notice any abnormal weather, tell me right away."
set key[id=8947151523134046217] name "But they said that space could not be found...."
set key[id=8947151523134046218] name "Is that so?\nAnd I think the Frontier Foundation might have found \
    something."
set key[id=8947151523134046219] name "Of course, there's no guarantee that it's the place.\nIt could be scattered \
    across several places.\nBut right now we have to explore every possibility, so it's worth investigating."
set key[id=8947151523134046220] name "$MyPCName$, talk to me again when you're ready."
set key[id=8947151523134046221] name "Oh, and a detailed investigation isn't what we want right now.\nJust confirm \
    what the situation is,\nand if you notice any danger signs, come straight back."
set key[id=8947151523134046304] name "$MyPCName$, would you let the two holding back the rift know about this \
    too?"
set key[id=8947151523134046306] name "Hmm.... Give me a moment to think."
set key[id=8947151523134046307] name "Oh, and the forgotten space, ah, did you say it's already covered in blue \
    flames?\nIf you can spare the strength, go there and calm the enraged golem too."
set key[id=8947151523134046308] name "That place had better be called $map:02200001$."
set key[id=8967741987193094153] name "$MyPCName$, I know it's a bother, but could you go to the Frontier \
    Foundation and pass this on?\nIt's hard for us to move, so we'd like you to deliver it for us."
set key[id=8967741987193094154] name "$MyPCName$, my other half.\nA detailed investigation isn't what we want \
    right now.\nJust confirm what the situation is,\nand if you notice any danger signs, come straight back."
set key[id=9993880579822583817] name "Understood. Maple World is full of performers who love music.\nPlease keep \
    them safe, along with our members!"
set key[id=10540667729495457883] name "(Ask for details.)"
set key[id=10540667729495457884] name "It's just as I said. We were practicing with the members...\nwhen that dark \
    matter suddenly appeared and all the members disappeared into it!"
set key[id=10540667729495457886] name "(Ask whether you can hear a woman's aria inside that red darkness.)"
set key[id=10540667729495457887] name "Y-yes! That voice... was definitely that of the prima donna <font \
    color=\"#ffd200\">Della Rosa</font>!"
set key[id=10540667729495457888] name "(<font color=\"#ffd200\">Della Rosa</font>?)"
set key[id=10540667729495457889] name "Yes, she was once the greatest prima donna in Maple World.\nEveryone loved \
    and praised her, and she enjoyed it too.\nShe was so absorbed in her fans' reactions that she performed every \
    day."
set key[id=10540667729495457890] name "But she strained her voice too much, and in the end it was ruined.\nOnce \
    she became a has-been singer no one sought out, she...\nburned down her Red Rose Theater and died along with \
    it."
set key[id=10540667729495457891] name "Yet, her voice is coming from the dark matter that swallowed the \
    members...\nIt's just like the Phantom of the Opera... \nDid the dead woman really take our members...?"
set key[id=11326111565968572503] name "...That's everything I know.\nPlease pass this on to the Foundation so they \
    can come up with countermeasures."

# Quest dialogue of the Kritias_2018_12 quests that no pack has in English (feature Kritias_2018_12): our own
# English for the 54 scriptquest rows of locale KR (or no locale) whose quest a player can get (7 quests), with each
# row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=116183821029360] name "With the giant mechanical beast <font \
    color=\"#ffd200\">$npcName:23001006$</font> causing earthquakes and destruction all over, \nthe number of \
    injured expedition members keeps growing, and so does the damaged \nSky Fortress equipment from the \
    vibrations. It's a serious situation."
set key[id=116183821029366] name "$MyPCName$! I've been waiting for you!"
set key[id=130145621029615] name "Not only are expedition members getting hurt in the earthquakes, the Sky \
    Fortress equipment is being damaged too.\nForget collecting $npcName:23001006$'s combat data, the whole \
    Kritias expedition is about to be in trouble."
set key[id=130145621029621] name "If we can work out what patterns it acts by, I think we can counter it.\nLike a \
    weather forecast."
set key[id=130145621029622] name "But it's so elusive and hard to predict.\nFirst of all, we have far too little \
    data on it."
set key[id=130145621029623] name "I know this is a hard and dangerous request, but...\nI can't think of anyone but \
    you, $MyPCName$, who could finish this mission safely."
set key[id=130145621029624] name "Please!\nFight <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020051$</font> and gather as many behavior patterns as you can!"
set key[id=130145621029679] name "Welcome, $MyPCName$.\nI compared the combat patterns of $npcName:23001006$ you \
    sent last time with its recent ones, and found changes in many places."
set key[id=130145621029680] name "(Ask if the last combat data wasn't enough.)"
set key[id=130145621029681] name "The earlier combat data wasn't lacking.\nWe expect $npcName:23001006$ is adding \
    combat patterns on its own to suit each opponent as it fights."
set key[id=130145621029682] name "Please!\nAfter fighting <font color=\"#ffd200\">$npcName:23001006$</font> in \
    <font color=\"#ffd200\">$map:02020051$</font>, gather as much combat data as you can."
set key[id=130145621029683] name "Great work, truly!\nThis will help a lot in understanding $npcName:23001006$'s \
    behavior!"
set key[id=130145621029716] name "The analysis showed that its combat patterns change so randomly and so often \
    that predicting them is difficult."
set key[id=130145621029717] name "But don't be too discouraged.\nWe'll find the answer. We always have!"
set key[id=130145621029718] name "The research team suggests finding an internal access vulnerability in <font \
    color=\"#ffd200\">$npcName:23001006$</font> and hacking the AI itself."
set key[id=130145621029722] name "We analyzed the combat data of $npcName:23001006$ you brought earlier, \
    but...\nwe never found a weak point that can be accessed from the outside."
set key[id=130145621029723] name "It turns out to be a far more meticulously built mechanical beast than \
    expected.\nBut the Green Hood is not about to give up!\nWe'll dig and dig until we find its flaw and turn it \
    into a heap of scrap!"
set key[id=130145621029724] name "And from the last combat data we learned that $npcName:23001006$'s outer \
    skeleton is made of a special metal, so the last fight wasn't for nothing!"
set key[id=130145621029725] name "If we analyze this special metal, we could fire the Sky Fortress's atomic \
    vibration cannon from the sky where $npcName:23001006$'s attacks can't reach, and crack the metal."
set key[id=1220183321028012] name "You're here, $MyPCName$.\nI think this mission is going to be quite a tough \
    one."
set key[id=1220183321028013] name "On top of that, it's spreading pollutants at every new settlement, and the \
    settlements are badly hit too.\nIf we leave it alone, the damage will become impossible to undo."
set key[id=1220183321028014] name "Please go to <font color=\"#ffd200\">$map:02020051$</font>, the lair of <font \
    color=\"#ffd200\">$npcName:23001006$</font>, and take that thing down."
set key[id=1220183321028015] name " Please go to <font color=\"#ffd200\">$map:02020051$</font> and take down <font \
    color=\"#ffd200\">$npcName:23001006$</font>."
set key[id=1220183321028016] name "Thank you! \nNow the settlers and the members can finally breathe easy!"
set key[id=1220183321028036] name "<font color=\"#ffd200\">$npcName:23001006$</font> has set off such powerful \
    earthquakes that expedition members are hurt and even Sky Fortress equipment is wrecked. The damage is \
    enormous."
set key[id=1220183321028037] name "On top of that, it's spreading pollutants into the settlements where people \
    live, and people are falling ill. Big problems are cropping up everywhere.\nIf we leave it alone, the damage \
    will get truly serious."
set key[id=1220183321028038] name "Please go to <font color=\"#ffd200\">$map:02020051$</font>, the lair of <font \
    color=\"#ffd200\">$npcName:23001006$</font>, and take that thing down."
set key[id=1220183321028039] name " Please go to <font color=\"#ffd200\">$map:02020051$</font> and take down <font \
    color=\"#ffd200\">$npcName:23001006$</font>."
set key[id=1220183321028040] name "\nGreat work, $MyPCName$!\nThanks to you, we can finally breathe easy."
set key[id=1220183321028095] name "$MyPCName$! This is terrible!\nLately big and small earthquakes keep happening, \
    and members are getting injured and equipment is breaking down one after another!"
set key[id=1220183321028096] name "The cause was <font color=\"#ffd200\">$npcName:23001006$</font>!\nIt's been \
    digging tunnels under our expedition camps and key outposts, and that's what's causing the earthquakes!"
set key[id=1220183321028097] name "If we leave it alone, the damage will get truly serious.\nPlease go to <font \
    color=\"#ffd200\">$map:02020051$</font>, the lair of <font color=\"#ffd200\">$npcName:23001006$</font>, and \
    take that thing down."
set key[id=1220183321028098] name " Please go to <font color=\"#ffd200\">$map:02020051$</font> and take down <font \
    color=\"#ffd200\">$npcName:23001006$</font>."
set key[id=1220183321028099] name "Thanks to you, $MyPCName$, $npcName:23001006$'s mischief should quiet down for \
    a while, right?\nThe expedition members are sending messages of thanks, too!"
set key[id=1220183321028115] name "Welcome, $MyPCName$.\nDid you know $npcName:23001006$ has been getting more \
    active lately?"
set key[id=1220183321028116] name "The Green Hood has figured out whose purpose <font \
    color=\"#ffd200\">$npcName:23001006$</font> is moving for, and how."
set key[id=1220183321028117] name "The only way to gather data is to run into it head-on!\nFighting it should be \
    the best way to get data on what patterns it moves in!"
set key[id=1220183321028118] name "Fight <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020051$</font> and gather as many behavior patterns as you can!"
set key[id=1220183321028119] name "Wow! What an enormous amount of data!\nThis will be a big help in researching \
    <font color=\"#ffd200\">$npcName:23001006$</font>."
set key[id=1220183321028169] name "It seems its neural circuitry is more complex than we thought."
set key[id=1220183321028170] name "The research team believes that if we gather more of $npcName:23001006$'s \
    attack patterns, Kate Seed could predict its next attack pattern."
set key[id=1220183321028171] name "However I think about it, you are the only Sky Fortress member suited for this, \
    $MyPCName$. "
set key[id=1220183321028172] name "After fighting <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020051$</font>, gather as much combat data as you can."
set key[id=1220183321028173] name "Wow! What incredible data!\nFar more than last time.\nAnalyzing this will mean \
    running Kate Seed at full power for days, won't it?"
set key[id=1220183321028200] name "Welcome, $MyPCName$.\nThe analysis of the combat data from $npcName:23001006$ \
    is complete!"
set key[id=1220183321028201] name "The research team's view was that any machine must have some way to be accessed \
    from outside.\nTo find it, we need to fight $npcName:23001006$ more and look for its weak points."
set key[id=1220183321028202] name "Fight <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020051$</font> and gather as much data as you can.\nWe'll use the combat data to look \
    for an opening from the outside!"
set key[id=1220183321028203] name "Fight <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020051$</font> and gather as much data as you can.\nWe'll use the combat data to look \
    for an opening from the outside!"
set key[id=1220183321028204] name "Thank you so much! \nThis much data should be enough to find \
    $npcName:23001006$'s weak points."
set key[id=1220183321028212] name "Welcome, $MyPCName$!\nI was just looking for you!"
set key[id=1220183321028213] name "To find out what special metal makes up its outer skeleton, \nthe research team \
    thinks the best way is \nto fight it directly and analyze the impact sound waves of the metal."
set key[id=1220183321028214] name "$MyPCName$.\nFight <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020037$</font> and collect the impact sound waves of the special metal!"
set key[id=1220183321028215] name "Fight <font color=\"#ffd200\">$npcName:23001006$</font> in <font \
    color=\"#ffd200\">$map:02020037$</font> and collect the impact sound waves of the special metal!"
set key[id=1220183321028216] name "Good work!\nThe Green Hood research team will start analyzing the materials you \
    delivered."

# Quest dialogue of the FameContents quests that no pack has in English (feature FameContents): our own English for
# the 50 scriptquest rows of locale KR (or no locale) whose quest a player can get (16 quests), with each row's own
# format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=1122231920008145] name "$MyPCName$, come to $map:02000153$."
set key[id=1122231920008146] name "$MyPCName$, come to $map:02000153$."
set key[id=1122231920008147] name "You came, $MyPCName$."
set key[id=1122231920008156] name "Cutie! I have a favor to ask.\nAn enormous number of <font \
    color=\"#ffd200\">$npcName:21000015$</font> have shown up all over $map:02000147$ \nand taken over the roads \
    and buildings!"
set key[id=1122231920008157] name "The city's functions are completely paralyzed, and the residents have \nbeen \
    evacuated.\nIf we leave it like this any longer, even we might not be able to do anything."
set key[id=1122231920008158] name "We need our reliable cutie to step up!\nYou know what I mean, right?? Count on \
    you!"
set key[id=1122231920008159] name "An enormous number of <font color=\"#ffd200\">$npcName:21000015$</font> have \
    shown up all over $map:02000147$ \nand taken over the roads and buildings! We need you to step up!"
set key[id=1122231920008160] name "There are still some $npcName:21000015$ stragglers left, but thanks to my \
    darling, \ntheir numbers have dropped a lot! Let's be happy with that for now, and when we meet again, \nI'll \
    dote on you plenty~ See you next time, my cutie!"
set key[id=1122231920008167] name "You're here? My cutie? Let's give today's mission our best again, shall we? \
    \nToday's mission is about the sudden surge of <font color=\"#ffd200\">$npcName:21000015$</font>."
set key[id=1122231920008168] name "When these guys get angry, their snorts are so powerful they even blow out the \
    fires on the oil drilling towers, you know?"
set key[id=1122231920008169] name "$npcName:21000015$ keep blowing out the oil drilling towers' fires, \nso \
    drilling has stopped and it's chaos. \nLet's help drive off the $npcName:21000015$, my cutie~ okay?"
set key[id=1122231920008170] name "Let's help drive off the $npcName:21000015$~ okay?"
set key[id=1122231920008171] name "My cutie! You really get the job done!"
set key[id=1122231920008185] name "Hi~ You look full of energy again today!\nThis mission is a little... messy, \
    but I trust you'll do it well."
set key[id=1122231920008186] name "<font color=\"#ffd200\">$npcName:21000024$</font> have flocked to \
    $map:02000138$ and are burying stinky mines \nall over the place.\nIf there were only a few, it wouldn't be a \
    big problem, but there are way too many."
set key[id=1122231920008187] name "More residents are getting hurt slipping on them, and the smell \nattracts \
    bugs... On top of that, the whole town's hygiene \nis a mess."
set key[id=1122231920008188] name "Let's help clear <font color=\"#ffd200\">$npcName:21000024$</font> out of \
    $map:02000138$ \nso the town can be clean again!"
set key[id=1122231920008189] name "You really do get the job done, don't you? \nHey~ ever thought of joining my \
    organization? I'll treat you well~"
set key[id=1122231920008220] name "Hi! Cutie! I have a mission for you to take care of!\nA huge number of slimes \
    in $map:02000084$ ate contaminated \ntoxic waste and spread out to other areas,"
set key[id=1122231920008221] name "and now they're scattering toxic waste everywhere  \nI mean, really... why \
    would they eat it? "
set key[id=1122231920008222] name "Anyway.\nSlimes that ate the toxic waste mutate and turn ferocious."
set key[id=1122231920008223] name "To stop the damage from spreading any further, defeat <font \
    color=\"#ffd200\">$npcName:21000387$</font> and \n<font color=\"#ffd200\">$npcName:21000388$</font>!"
set key[id=1122231920008224] name "Thanks, cutie, the numbers of $npcName:21000387$ and $npcName:21000388$ \
    \ndropped a lot because of you! Good work!"
set key[id=1122231920008251] name "Hi! Cutie! A new mission needs taking care of!\nSince the air raid on Tria, the \
    $npcName:21000340$ seem to have been \naffected by the power of darkness."
set key[id=1122231920008252] name "On top of that, they've been spreading malignant spores all around \
    $map:02000135$, \nso even the $npcName:21000081$ and $npcName:21000082$ got infected with the spores and \
    turned \nsavage."
set key[id=1122231920008253] name "We can't let the damage from the malignant spores keep growing! \nLet's cut \
    down the harm by defeating the <font color=\"#ffd200\">$npcName:21000340$</font> and the <font \
    color=\"#ffd200\">$npcName:21000081$</font> \nand <font color=\"#ffd200\">$npcName:21000082$</font> that were \
    infected by the spores and turned violent!"
set key[id=1122231920008254] name "Well done! That should keep things quiet for a while, right? \nGood work!"
set key[id=1122231920008448] name "$npcName:21000027$ are grinding their horns against the pillars of \
    $map:02000044$ to sharpen them, causing a disaster as the canyon's pillars collapse.\n\nReduce the number of \
    $npcName:21000027$ to protect $map:02000044$ from collapsing."
set key[id=1122231920008449] name "Completion script (temporary)"
set key[id=1122231920008450] name "The $npcName:21000066$ and $npcName:21000064$ that were tamed and used in \
    battle escaped in large numbers after the air raid on Tria and are attacking adventurers visiting \
    $map:02000171$.\n\nDrive out the $npcName:21000066$ and $npcName:21000064$ so the development of \
    $map:02000171$ can continue."
set key[id=1122231920008451] name "Completion script (temporary)"
set key[id=1122231920008452] name "A man called $npcName:21000312$ appeared in $map:02000093$ and started picking \
    fights with the residents, and before long the $npcName:21000311$ and $npcName:21000310$ multiplied and took \
    over $map:02000093$.\n\nThey plan to extend their influence over all of Perion, and to expand further they are \
    plundering the residents of $map:02000093$ and driving out adventurers.\n\nDefeat $npcName:21000312$ and stop \
    the Red Dragon Jaw Fist Gang's attempt to expand."
set key[id=1122231920008453] name "Completion script (temporary)"
set key[id=1122231920008456] name "It has been quite a while since $npcName:21000066$, which used to scavenge \
    through trash and eat corpses, began attacking adventurers, but the cause is unknown.\n\nIntelligence has \
    revealed that $npcName:21000334$ recently tamed $npcName:21000066$ to be vicious and attack settlers in order \
    to hinder the development of the region.\n\nSubdue the $npcName:21000334$ at $map:02000169$ and drive them \
    out."
set key[id=1122231920008457] name "Completion script (temporary)"
set key[id=1122231920008458] name "$map:02000061$ is a clean source of drinking water and could become the center \
    of Perion's development.\n\n$npcName:21000369$ uses hypnosis to make animals less intelligent than itself turn \
    ferocious, hindering the region's development.\n\nSubdue $npcName:21000369$, the culprit hindering the \
    development of $map:02000061$."
set key[id=1122231920008459] name "Completion script (temporary)"
set key[id=1122231920008460] name "$npcName:21000301$ has been steadily growing in number, holding the upper hand \
    over other animals with its strong, sharp teeth.\n\nBecause of the growing numbers of $npcName:21000301$, \
    adventurers are increasingly ambushed and fatally wounded.\n\nIn particular, $map:02000133$, Perion's holy \
    ground, is visited by many adventurers and residents, so the number of people ambushed by $npcName:21000301$ \
    is growing by the day.\n\nSubdue $npcName:21000301$ at $map:02000133$ to reduce the damage."
set key[id=1122231920008461] name "Completion script (temporary)"
set key[id=1122231920008462] name "A continuing dry season across Perion has been shrinking the water \
    supply.\n\nIn this situation, the greedy $npcName:21000069$, which stores water in its body, has multiplied in \
    large numbers and is sucking up even the groundwater of $map:02000049$ and storing it in its body.\n\nWhen \
    developing a region, drinking water that can be supplied on the spot is the top priority.\n\nSubdue the \
    $npcName:21000069$ that are monopolizing the water and stop the water shortage from getting worse."
set key[id=1122231920008463] name "Completion script (temporary)"
set key[id=1122231920008464] name "At $map:02000094$, $npcName:21000334$ approached the Jaw Fist Gang members who \
    were studying martial arts and training their bodies and minds, corrupted their minds, and made them attack \
    good people. Drive it out of $map:02000094$ and stop the damage from spreading any further."
set key[id=1122231920008465] name "Completion script (temporary)"
set key[id=1122231920008468] name "The bone bridges set up for the development of Perion kept getting broken, and \
    on investigation it turned out that when the $npcName:21000267$ gets an itch on its hard body, it rolls \
    against the bone bridges \nand they collapse.\n\nSubdue the $npcName:21000267$ that are disrupting \
    construction at $map:02000045$."
set key[id=1122231920008469] name "Completion script (temporary)"
set key[id=1122231920008470] name "$map:02000046$, where extremely hot lava erupts, has a steady lava temperature, \
    making it an ideal place to extract lava energy.\n\nTo develop the area for lava energy extraction, subduing \
    the $npcName:21000299$ that hold the area through sheer numbers is essential.\n\nSubdue the $npcName:21000299$ \
    so a lava energy extraction facility can be built at $map:02000046$. "
set key[id=1122231920008471] name "Completion script (temporary)"
set key[id=1127194820008681] name "Let's help clear <font color=\"#ffd200\">$npcName:21000024$</font> out of \
    $map:02000138$ so the town \ncan be clean again!"
set key[id=1127194820008688] name "To stop the damage from spreading any further, defeat <font \
    color=\"#ffd200\">$npcName:21000387$</font> and \n<font color=\"#ffd200\">$npcName:21000388$</font>!"
set key[id=1127194820008694] name "Let's cut down the harm by defeating the <font \
    color=\"#ffd200\">$npcName:21000081$</font> \nand <font color=\"#ffd200\">$npcName:21000082$</font> that were \
    infected by the spores of <font color=\"#ffd200\">$npcName:21000340$</font> and turned violent!"

# Quest dialogue of the UnlimitedEnchant quests that no pack has in English (feature UnlimitedEnchant): our own
# English for the 45 scriptquest rows of locale KR (or no locale) whose quest a player can get (4 quests), with each
# row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=1211180122004115] name "$MyPCName$...!\nIt's been a while, my other half.\nHave you been well all this \
    time?"
set key[id=1211180122004116] name "Honestly, I'd like to keep you here and talk on and on... \nbut I know there's \
    no time for that right now.\nI received a message from $npc:11004784[gender:1]$."
set key[id=1211180122004117] name "It seems it's time to talk about the newly discovered material.\nI'll see you \
    at $map:02000487$. "
set key[id=1211180122004118] name "It seems it's time to talk about the newly discovered material.\nI'll see you \
    at $map:02000487$. "
set key[id=1211180122004119] name "To research the newly discovered material, our Frontier Foundation intends to \
    do everything it can.\nAs part of that, we built a laboratory inside the mansion and invited a research \
    expert."
set key[id=1211180122004120] name "...Research... expert?"
set key[id=1211180122004121] name "Yes, I think you may already know this person.\nIt's \
    $npcName:11004802[gender:0]$."
set key[id=1211180122004122] name "Ah, there is so much I'd like to say, but...\nfor the sake of your precious \
    time, $MyPCName$, busy with research and investigation, I'll keep it short."
set key[id=1211180122004123] name "Go up the right-hand stairs of $map:52000196$, and you can enter through the \
    door you see by the space where the mages are.\nMeet $npcName:11004802[gender:0]$ there."
set key[id=1211180122004124] name "Go up the right-hand stairs of $map:52000196$, and you can enter through the \
    door you see by the space where the mages are.\nMeet $npcName:11004802[gender:0]$ there."
set key[id=1211180122004125] name "Oh, who's this?\nGreat, the person I was waiting for has finally arrived!"
set key[id=1211180122004126] name "The <font color=\"#ffd200\">$item:40100055$</font> you brought is far purer and \
    more intense than the first one I got!\nWith this I can do the <font color=\"#ffd200\">final \
    experiment</font>... I just need to verify one more thing."
set key[id=1211180122004127] name "You. Go back there one more time.\n<font \
    color=\"#ffd200\">$item:40100055$</font> - I need to find out just how far it can amplify power."
set key[id=1211180122004128] name "What are you standing around for?\nGet to <font \
    color=\"#ffd200\">$map:02000554$</font> and come back <font color=\"#ffd200\">soaked in its energy</font>!"
set key[id=1211180122004130] name "What are you standing around for?\nGet to <font \
    color=\"#ffd200\">$map:02000554$</font> and come back <font color=\"#ffd200\">soaked in its energy</font>!"
set key[id=1211180122004131] name "Mmm~ This strange, unstable feeling. Perfect. Absolutely perfect. \nAll right, \
    let's have a look."
set key[id=1211180122004133] name "What was in the space connected to $map:02000554$ was, to be precise, an \
    illusion.\nNot something real, but a kind of mirage made when energy reflects endlessly in warped space and \
    time. That's why the beings you've met so far appear there too."
set key[id=1211180122004134] name "Got it? That should be plenty of explanation, right?"
set key[id=1211180122004135] name "Good, now it's time to act."
set key[id=1211180122004136] name "Good, now it's time to act."
set key[id=1211180122004137] name "Here, a <font color=\"#ffd200\">gift</font> I prepared to cheer on your growth \
    from now on.\nKeep taking on the <font color=\"#ffd200\">Dungeon of Illusions</font> and run toward limitless \
    power!"
set key[id=1211201322004139] name "Now then, shall we hear more about that place where the new material was \
    found?"
set key[id=1211201322004140] name "Hmm~ hmmm~"
set key[id=1211201322004141] name "($npc:11004802[gender:0]$'s eyes kept sparkling as I told the story of what I \
    went through at $map:02000554$. Maybe it's my imagination, but the corners of the mouth kept rising until I \
    thought they'd reach the ears.)"
set key[id=1211201322004142] name "Perfect. Great, every one of my hypotheses was right.\nHa, at first I thought \
    it was just something like $item:40100026$ and almost threw it away.\nI'd have beaten myself up with regret if \
    I had."
set key[id=1211201322004143] name "What do you mean by that?"
set key[id=1211201322004144] name "If you run into monsters, the best thing is to fight them.\nIf you can't, \
    then... well, soak yourself in it from head to toe so you take in plenty of energy.\nI need to see what gets \
    stronger from this power, and by how much!"
set key[id=1211201322004146] name "Yes. Just as I expected.\n$item:40100055$ is the real thing. It's the engine of \
    endless growth!"
set key[id=1211201322004147] name "What is it that has you so excited?"
set key[id=1211201322004148] name "Now, the reason we call this substance $item:40100055$ is that it came out of \
    the rift, and endless energy pours out of light refracted at countless angles. \nBut do you know what's even \
    more amazing? \nThis energy looks like light, but it's actually full of the power of darkness! "
set key[id=1211201322004149] name "In other words, two opposite natures exist side by side, constantly clashing \
    and expanding. That is the very essence of the rift's power!\nPut simply, it means <font \
    color=\"#ffd200\">endless growth is possible</font>."
set key[id=1211201322004150] name "Surprised? Yeah~ I was too. Everything has the potential to grow, but there's \
    always a limit. With <font color=\"#ffd200\">$item:40100055$</font> as the medium, forces of opposite natures \
    at the two extremes keep pushing and pulling at each other and stretching the boundary. "
set key[id=1211201322004151] name "Now, here's the question you should be asking. If it keeps expanding like this, \
    will it hold up?\nWon't it crack apart? Won't it burst with a bang?"
set key[id=1211201322004152] name "The answer is yes! And no at the same time!\nTo withstand the expanding force \
    of $item:40100055$, you need a highly durable material that holds both extremes of power in the same way. \nIn \
    other words, it won't work unless the equipment came from <font color=\"#ffd200\">a being born of the \
    rift</font>. That's what I'm saying."
set key[id=1211201322004153] name "...Hm, I've been talking to myself so much that you look lost.\nStill, this is \
    important, so listen carefully."
set key[id=1211201322004154] name "The stronger you get, the stronger the illusions get, but while you fight them, \
    you can obtain even greater power, the key to endless growth. \nThat's <font \
    color=\"#ffd200\">$item:40100055$</font> and <font color=\"#ffd200\">$item:40100056$</font>."
set key[id=1211201322004155] name "But what you use them on has to be something that came from the rift too. Only \
    then can it withstand that power. \nSo you need to keep fighting <font color=\"#ffd200\">the illusions in the \
    place connected to the rift</font>.\nUse the <font color=\"#ffd200\">materials</font> and <font \
    color=\"#ffd200\">equipment</font> you get there and you can get in-cred-i-bly strong."
set key[id=1211201322004156] name "...Can you sum that up in 3 lines?"
set key[id=1211201322004158] name "...Make it easy to follow. Sum it up for me... "
set key[id=1211201322004159] name "Honestly, adventurers these days have no manners.\nImagine just gulping down \
    what someone else worked so hard to figure out..."
set key[id=1211201322004160] name "<font color=\"#909090\">What is this? This familiar feeling... It's just like \
    $npcName:11003534[gender:0]$, my boss...?</font>"
set key[id=1211201322004161] name "Well, 3 lines is hard, but I can boil it down to 3 points. Listen well.\nFirst. \
    The <font color=\"#ffd200\">$item:40100055$</font> you can collect in the <font color=\"#ffd200\">Dungeon of \
    Illusions</font> connected to $map:02000554$.\nUsing it lets you <font color=\"#ffd200\">break through the \
    limits</font> of a material.\nThat means drawing out even stronger power than regular enchanting and achieving \
    great growth.\n"
set key[id=1211201322004162] name "Second. \nOnly equipment you collect in the <font color=\"#ffd200\">Dungeon of \
    Illusions</font>,\nthe weapons we call <font color=\"#ffd200\">Fire Prisms</font>, can have its limits \
    broken.\nIt needs strong durability, so it has to be enchanted to <font color=\"#ffd200\">level 15 or \
    higher</font>."
set key[id=1211201322004163] name "Third. \nTo gather Fire Prism equipment, $item:40100055$, and $item:40100056$, \
    you have to take on the <font color=\"#ffd200\">Dungeon of Illusions</font> connected to \
    $map:02000554$.\nThey're illusions of monsters you've already met, but they're as strong as you've become."
set key[id=1211201322004164] name "Understood."

# Quest dialogue of the ContentsGuide quests that no pack has in English (feature ContentsGuide01, ContentsGuide02):
# our own English for the 63 scriptquest rows of locale KR (or no locale) whose quest a player can get (15 quests),
# with each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=223175804001247] name "Now it's time to tend to them with care. \nYou get hungry when it's time, right? \
    These plants are the same. \nYou have to remember to give them fertilizer regularly so they grow strong."
set key[id=223175804001248] name "Now it's time to tend to them with care. \nYou get hungry when it's time, right? \
    These plants are the same. \nYou have to remember to give them fertilizer regularly so they grow strong."
set key[id=223175804001249] name "Your touch is more delicate than it looks.\nEvery time your hands touch them, it \
    feels like each and every leaf comes back to life."
set key[id=223175804001253] name "$MyPCName$, why not grow even more rice with your delicate touch?\nThe more you \
    connect with the rice, the deeper our friendship will grow. "
set key[id=223175804001254] name "$MyPCName$, why not grow even more rice with your delicate touch?\nThe more you \
    connect with the rice, the deeper our friendship will grow. "
set key[id=223175804001255] name "$MyPCName$... \nTo commune with plants that can't say a word and care for them \
    so sincerely... \nWith a warm heart like yours... I think we can truly be good friends."
set key[id=308172604001266] name "The roots were in bad shape, so I worried whether I could grow anything from \
    them... \nBut they're growing exactly as our ancestors described in their books. I'm so happy... ha ha \
    ha.\nNow all that's left is to harvest these flower herbs and check whether their effects are the same."
set key[id=308172604001267] name "Since you're here, $MyPCName$, could you help me with the harvest?\nThese rare \
    flower herbs only grow here, so think of it as a nice experience~ heh heh."
set key[id=308172604001268] name "I'm one of those alchemists. Heh heh."
set key[id=308172604001269] name "You startled me! \nHmm... you're an alchemist? Hmm... I've never seen you \
    before...?"
set key[id=308172604001270] name "You must be a fairy who's short on information. \nI'm <font \
    color=\"#ffd200\">$npc:11003143[gender:0]$</font>, a scientific alchemist doing research at \
    $map:02000146$.\nWhether you know me or not doesn't matter.\nAll I need is to get some flower herbs."
set key[id=308172604001271] name "Ahem. That's a rather rude way to introduce yourself to someone you've just met. \
    \nWell... then I'll cut to the chase as well... what flower herbs do you need?"
set key[id=308172604001272] name "<font color=\"#ffd200\">$item:33000166$</font>. \nI need quite a lot... hm~ \
    looking around, there seems to be plenty.\nI'll pay a generous price, so hand it all over to me... "
set key[id=308172604001273] name "Wait! The flower herbs from our garden are not sold for any price. \nHowever... \
    you must first tell us what purpose and what alchemy you'll use the herbs for.\nAlchemy\nis a double-edged \
    sword, after all... "
set key[id=308172604001274] name "Heh. Short on information, yet as meticulous as you'd expect from a strategist \
    the $map:02000023$ Archmage cherishes.\nYou needn't worry about what the herbs are for. \nI'll use them to \
    make medicine for our guardians, who are fighting the darkness at $map:02000146$\nand hovering between life \
    and death.\n\n"
set key[id=308172604001275] name "If you put your mind to it, you can quickly check whether I'm telling the \
    truth... \nI'll come back in three days.\nBy then, have as much $item:33000166$ ready as I need.\nWell, until \
    then... \n"
set key[id=308172604001276] name "A $npc:11003143[gender:0]$ from $map:02000146$... \nSpeaking so boldly, it \
    doesn't seem to be a lie... but I should still verify it, right?\nAnyway, gathering the amount that person \
    mentioned will be tight on time."
set key[id=308172604001277] name "$MyPCName$! Could you help me again this time?\nPlease harvest the <font \
    color=\"#ffd200\">$item:33000166$</font> that has grown ready for picking."
set key[id=308172604001278] name "$MyPCName$. \nOn the way up the garden hill, you'll find some <font \
    color=\"#ffd200\">ripe sweet persimmon trees</font>. \nPick a few <font \
    color=\"#ffd200\">$item:33000169$</font> and bring them to Auntie $npcName:11003141[gender:1]$.\nShe'll make \
    delicious $item:20000444$ out of them for you."
set key[id=308172604001279] name "(Hold out the $item:33000169$ and pass on $npcName:11003140[gender:0]$'s \
    request.)"
set key[id=308172604001280] name "Oh... you want me to make $item:20000444$?\nHa ha ha ha... true, the sweet \
    persimmons grown in this garden make you strong,\nso they say the fairies who gather flower herbs here feel a \
    surge of strength when they eat it."
set key[id=308172604001281] name "I made it myself."
set key[id=308172604001282] name "Oh... impressive!\nYour skill is no ordinary one."
set key[id=308172604001283] name "Try gathering after eating $item:20000444$ and you'll know for sure. \nYour body \
    feels light and nimble, so you can gather more flower herbs in the same amount of time.\nSee it for yourself."
set key[id=308172604001284] name "Anyway, you did a great job today. Thank you for helping me like this every \
    time. \nMay a fairy's luck always be with you... "
set key[id=308172604001290] name "Is it all right if I visit you every now and then?\nI want to tell you about \
    myself and the star where I used to live."
set key[id=308172604001292] name "$item:50400192$. \nOn the star where I lived, we would give $item:33000120$ \nto \
    friends we wanted to share our hearts with."
set key[id=308172604001293] name "But there are no fully grown $item:33000120$ here... \nWith your touch, I think \
    you could grow $item:33000120$ big and strong.\nYou'll take good care of it, right?"
set key[id=308172604001295] name "By the way... I saw a stranger in front of your house. \nThe feeling was just a \
    bit... \nOh...!!"
set key[id=308172604001296] name "Why so startled?\nI think we passed each other in front of the house earlier."
set key[id=308172604001297] name "Hm? $MyPCName$?\nThe name sounds familiar... have we met before?\nWell... that's \
    not important, so let's move on... "
set key[id=308172604001300] name "You two seem awfully curious about why I'm here... \nNo need to be nervous. I \
    won't hurt you... "
set key[id=308172604001301] name "I'm $npc:11003143[gender:0]$!\nThese days I'm making new medicines using flower \
    herbs as alchemy ingredients. \nI hear this golden-haired youngster beside you has a walking house\nwhere \
    various plants are grown in fields."
set key[id=308172604001302] name "I happened to have just developed a new alchemy recipe that helps people who \
    farm at home.\nI came to find out\nhow effective a medicine made from that recipe is.\nWell? If I teach you \
    the alchemy recipe, will you help me?"
set key[id=308172604001306] name "$MyPCName$, are you really going to drink that?\nShouldn't you at least be \
    suspicious? What if it's dangerous... "
set key[id=308172604001307] name "Don't worry. The efficacy of the $item:33000099$ herb used as the ingredient has \
    already been verified... \nIf anything happens, I'll take responsibility."
set key[id=308172604001308] name "If anything happens to my friend... I won't forgive you.\n$MyPCName$. Be \
    careful. "
set key[id=308172604001310] name "Heh. What did I tell you? \nI said nothing would go wrong. \nAnyway, how is it? \
    Can you feel the medicine working?"
set key[id=308172604001313] name "You see how much alchemy can help in our daily lives, don't you?\nNow that I've \
    confirmed there's no problem, I can safely spread the recipe\nto other people too. Thanks for the help."
set key[id=308172604001314] name "You're going to visit my other friends too?\nHmm... I can't trust you. I won't \
    tolerate my friends getting hurt. \nI'll need to keep an eye on you to make sure nothing happens..."
set key[id=308172604001315] name "$MyPCName$, I have to follow that person before I lose him. \nWe'll be apart for \
    a little while, but the fact that we're friends\nwon't change. I'll be back."
set key[id=308172604001322] name "And... $MyPCName$. Don't just trust anyone. I worry about you.\nWhen we meet \
    again, let's both be healthy and looking great. Promise."
set key[id=1023200804000942] name "But all you've hooked so far are <font color=\"#ffd200\">Chorang fish</font>, \
    huh.\nThis is... something I treasure... <font color=\"#ffd200\">$item:20000342$</font>... \nWith this, you \
    can catch a <font color=\"#ffd200\">Starcandy Crab</font>!"
set key[id=1023200804000943] name "What's wrong? Fish not biting?"
set key[id=1023200804000944] name "The <font color=\"#ffd200\">Starcandy Crab</font> is a really rare one... heh \
    heh heh. \nFor some reason it clamps right on whenever it sees <font \
    color=\"#ffd200\">$item:20000342$</font>... Amazing."
set key[id=1023200804000945] name "Oh, <font color=\"#ffd200\">$MyPCName$</font>! You came at just the right time. \
    \nThe fish are really biting right now. \nCome on, grab a spot and fill up a whole bucket!"
set key[id=1023200804000946] name "What's wrong? Fish not biting?"
set key[id=1023200804000947] name "Mm~ you've gotten quite used to fishing by now. \nYou must have good hands!"
set key[id=1023200804000948] name "You've got a good feel for it, great focus... you've got the makings of a \
    natural angler.\nBut it seems your rod can't keep up with your skill. \nI'll give you a new rod, so try it \
    out. You'll notice the fish bite the float much faster! "
set key[id=1023200804000949] name "What's wrong? Fish not biting?"
set key[id=1023200804000950] name "Well? It's clearly different from your old rod, isn't it? Heh heh heh... \nFrom \
    now on, stop by the fishing shop now and then and buy a rod that suits your level."
set key[id=1023200804001035] name "Hurry up and feed it... \nIt gets edgy when it's hungry..."
set key[id=1023200804001036] name "Hurry up and feed it... \nIt gets edgy when it's hungry..."
set key[id=1023200804001037] name "Looks like it's finally full. \nHeh heh... now that it's eaten well, you'll \
    soon feel how worthwhile that hearty meal was!"
set key[id=1115231204001095] name "Hm? Is that so? \nI don't dig money out of the ground either, so I can't give \
    them away for free again... \nIf you need more, buy them from me at cost. Ha ha ha."
set key[id=1115231204001096] name "Ah, I see. \nWell, there's no view quite like this one. Take your time and \
    relax. Ha ha ha."
set key[id=1115231204001099] name "Hm? Is that so? \nI don't dig money out of the ground either, so I can't give \
    them away for free again... \nIf you need more, buy them from me at cost. Ha ha ha."
set key[id=1115231204001100] name "Ah, I see. \nWell, there's no view quite like this one. Take your time and \
    relax. Ha ha ha."
set key[id=1115231204001103] name "Hm? Is that so? \nI don't dig money out of the ground either, so I can't give \
    them away for free again... \nIf you need more, buy them from me at cost. Ha ha ha."
set key[id=1115231204001104] name "Ah, I see. \nWell, there's no view quite like this one. Take your time and \
    relax. Ha ha ha."
set key[id=1121210204001206] name "$item:33000026$ is widely used as a material for making cloth.\nBut people who \
    are clumsy at it often hurt the chickens when pulling out the $item:33000026$, or ruin the \
    $item:33000026$.\nThat happens quite a bit.\nSo the only way is to keep practicing until you get the hang of \
    it."
set key[id=1121210204001207] name "$item:33000026$ is widely used as a material for making cloth.\nBut people who \
    are clumsy at it often hurt the chickens when pulling out the $item:33000026$, or ruin the \
    $item:33000026$.\nThat happens quite a bit.\nSo the only way is to keep practicing until you get the hang of \
    it."
set key[id=1121210204001208] name "So, how is it? You've got a bit of a knack for gathering $item:33000026$ now, \
    right?\nNext, let's try something else!"

# Quest dialogue of the ShadowExpedition quests that no pack has in English (feature ShadowExpedition): our own
# English for the 20 scriptquest rows of locale KR (or no locale) whose quest a player can get (3 quests), with each
# row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=714004211003240] name "<font color=\"#ffd200\">$MyPCName$!</font>\n$npc:11000119[gender:0]$ is looking \
    for you. There's something to tell you.\nPlease hurry over."
set key[id=714004211003241] name "<font color=\"#ffd200\">$MyPCName$!</font>\n$npc:11000119[gender:0]$ is looking \
    for you. There's something to tell you.\nPlease hurry over."
set key[id=714004211003242] name "<font color=\"#ffd200\">$MyPCName$!</font>\nYou came. I've been waiting."
set key[id=714004211003243] name "$MyPCName$, on your way through $map:02000118$,\ndid you see a <font \
    color=\"#ffd200\">suspicious door</font> rise up from the broken ground?\nI called you here to ask you to \
    investigate it. "
set key[id=714004211003244] name "The first to find that door that suddenly appeared was one of our Royal Guard \
    soldiers.\nThat suspicious door is a <font color=\"#ffd200\">twisted passage of darkness leading who knows \
    where</font>,\nand they say powerful monsters poisoned by the deep shadow's darkness dwell inside. "
set key[id=714004211003245] name "So the Royal Guard has sent sentries there to protect the public.\nIt's \
    fortunate that not just anyone can get close,\nbut such a thing appearing right outside $map:02000001$ is \
    certainly a great threat."
set key[id=714004211003246] name "We still know far too little about that place,\nso we're asking <font \
    color=\"#ffd200\">skilled adventurers</font> who can push through that thick shadow\nto take on the challenge, \
    investigate it in more detail, and weaken the overflowing power of darkness.\nUnder the name <font \
    color=\"#ffd200\">Shadow Expedition</font>.\n"
set key[id=714004211003247] name "I trust you won't fear a new challenge, but it will surely be hard....\nTake a \
    moment to think, and if you decide to set out there,\ncome talk to me again. "
set key[id=714004211003248] name "I trust you won't fear a new challenge, but it will surely be hard....\nTake a \
    moment to think, and if you decide to set out and take it on,\ncome talk to me again. "
set key[id=714004211003249] name "From what I've seen of you so far, $MyPCName$, you've done admirably.\nI believe \
    you're qualified, so I'd like to ask you to <font color=\"#ffd200\">join the Shadow Expedition</font>.\nCan \
    you lend us your strength? "
set key[id=714004211003250] name "Of course I can."
set key[id=714004211003251] name "Good. That's the answer I was waiting for.\nBrave $MyPCName$, I hereby give you \
    the mission of the <font color=\"#ffd200\">Shadow Expedition</font>."
set key[id=714004211003252] name "Now, would you go to the site and make a name for yourself with the <font \
    color=\"#ffd200\">Shadow Expedition</font>?\nGo to the broken ground at $map:02000118$ and hear the \
    explanation from <font color=\"#ffd200\">$npc:11001700[gender:0]$</font>.\nYou can go straight there through \
    the path that opened behind me."
set key[id=714004211003253] name "Now, would you go to the site and make a name for yourself with the <font \
    color=\"#ffd200\">Shadow Expedition</font>?\nGo to the broken ground at $map:02000118$ and hear the \
    explanation from <font color=\"#ffd200\">$npc:11001700[gender:0]$</font>.\nYou can go straight there through \
    the path that opened behind me."
set key[id=714004211003254] name "Welcome. I heard from $npc:11000119[gender:0]$.\nYou've agreed to <font \
    color=\"#ffd200\">join the Shadow Expedition</font>, I hear.\nIt isn't much, but $npcName:11000119[gender:0]$ \
    ordered me to tell $MyPCName$\n<font color=\"#ffd200\">what we've learned about this place so far</font>."
set key[id=714004211003255] name "This door is a twisted space. Once you go in, there's no telling where you'll \
    end up.\nHowever, one unusual thing is that this place is like a training ground waiting for challengers,\nso \
    you must choose <font color=\"#ffd200\">how deep a level of darkness</font> and <font color=\"#ffd200\">how \
    many will enter</font>."
set key[id=714004211003256] name "Perhaps it's a rule set by the master of this passage, but the strength of the \
    enemies here\nchanges depending on the <font color=\"#ffd200\">level</font> and the <font \
    color=\"#ffd200\">number of challengers</font> you choose.\nHowever, to challenge a deeper level of darkness, \
    you must have chosen to <font color=\"#ffd200\">enter the previous level\nalone</font> and <font \
    color=\"#ffd200\">succeeded</font> at that challenge. "
set key[id=714004211003257] name "As you explore this darkness, you can get <font \
    color=\"#ffd200\">$item:90000018$</font>,\nwhich is used to grow <font color=\"#ffd200\">expedition-only \
    traits</font> that can only be used here.\n<font color=\"#ffd200\">Expedition-only traits</font> are \
    mysterious powers that work only inside the space of darkness\nconnected to this passage. They're a special \
    ability\nfor those who have challenged more and deeper darkness."
set key[id=714004211003258] name "Collect $item:90000018$ and learn the expedition-only traits,\nthen <font \
    color=\"#ffd200\">activate</font> them when you enter, and you'll be able to use those abilities.\nAlso, if \
    you use $item:90000018$ to <font color=\"#ffd200\">upgrade</font> the expedition-only traits,\nyou can make \
    that power even stronger."
set key[id=714004211003259] name "Now only the real thing is left, $MyPCName$.\nUnder the name of the Shadow \
    Expedition, show us <font color=\"#ffd200\">your abilities</font>! "

# Quest dialogue of the ItemMergeLV70_2 quests that no pack has in English (feature ItemMergeLV70_2): our own
# English for the 18 scriptquest rows of locale KR (or no locale) whose quest a player can get (2 quests), with each
# row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=1230215803002200] name "Hey, $MyPCName$! Heard the news?\n$npcName:11003416[gender:0]$ found a material \
    for making stronger gear and is looking for adventurers, but I'm busy, so if you're curious, go ask him \
    yourself!"
set key[id=1230215803002201] name "(Ask why he told me.)"
set key[id=1230215803002202] name "W-well... it's because... you looked like you might be interested...\nIf you're \
    not, forget it!"
set key[id=1230215803002203] name "What? You still haven't gone?"
set key[id=1230215803002204] name "Welcome! Did you hear about the newly discovered Meradium ore?\nI succeeded in \
    drawing out even stronger transcendence power with this ore."
set key[id=1230215803002205] name "I found out that if you use Meradium ore as a material when making a \
    transcendence crystal, \nyou can get a transcendence crystal with more power than before."
set key[id=1230215803002206] name "And it's not like you need a new method. It's the same as before, \nyou just \
    add this Meradium ore."
set key[id=1230215803002207] name "So can I get stronger transcendence crystals easily now?"
set key[id=1230215803002208] name "Unfortunately, not yet. Meradium ore itself is a bit hard to come by.\nBut I \
    found out that you can gather fragments of the ore instead and use them as materials \nto get the same \
    effect."
set key[id=1230215803002209] name "Where do I get Meradium ore fragments?"
set key[id=1230215803002210] name "I hear $item:20001881$ is sometimes found on the 4th floor of the Abandoned \
    Mine.\nThere aren't many, but just finding some is quite a haul."
set key[id=1230215803002211] name "You need a special key to go to the 4th floor of the Abandoned Mine, \nand I \
    left $item:30001025$ with $npcName:11000327[gender:1]$ last time, so pick it up and have it appraised.\nI \
    already told $npcName:11000327[gender:1]$, so just say I sent you and they'll know right away."
set key[id=1230215803002212] name "$npcName:11000327[gender:1]$ is right next to $map:52000117$, so you'll find \
    them easily.\nIf we gather more of the Meradium ore's power, I think we could draw out even more, \nbut I'll \
    need to research it more."
set key[id=1230215803002213] name "Did you hear the rumors too, $MyPCName$?\nOh, you heard from \
    $npcName:11003416[gender:0]$, I see."
set key[id=1230215803002214] name "(Ask about the 4th floor of the Abandoned Mine and $item:20001881$.)"
set key[id=1230215803002215] name "That's right. Where Meradium ore is mined still isn't properly known,\nbut I \
    hear $item:20001881$ can sometimes be obtained in $map:80000015$.\nThanks to that, suddenly a lot more people \
    are getting keys appraised."
set key[id=1230215803002216] name "Just as $npcName:11003416[gender:0]$ said, you can collect $item:20001881$ even \
    without the ore,\nso lots of people are flocking there.\nAnd even if you don't use the fragments, you can sell \
    them to others.\nIf you're interested, $MyPCName$, give it a try."
set key[id=1230215803002217] name "Oh, and here's the key $npcName:11003416[gender:0]$ left with me.\nTell me if \
    you want to have the key appraised right away."

# Quest dialogue of the LapentaFrontierQuest quests that no pack has in English (feature LapentaFrontierQuest): our
# own English for the 13 scriptquest rows of locale KR (or no locale) whose quest a player can get (2 quests), with
# each row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=605145903006942] name "Quest link dummy."
set key[id=605145903006943] name "Quest link dummy."
set key[id=605145903006944] name "Quest link dummy."
set key[id=625204011010855] name "Wait, $MyPCName$, look over there! Something's coming!"
set key[id=625204011010856] name "(Say it looks like Madria's army is coming.)"
set key[id=625204011010857] name "Now that the space has evened out, \nit seems they can see us too!"
set key[id=625204011010858] name "Wh-what do we do? $MyPCName$?\nThe two of us alone can't possibly stand against \
    an army..."
set key[id=625204011010859] name "(Say you can't just leave Madria's army alone, though.)"
set key[id=625204011010860] name "You're right about that...\nIf that army marches on the nearby towns and cities \
    right now..."
set key[id=625204011010861] name "(Say we have to hold them back as much as we can.)"
set key[id=625204011010862] name "All right, let's do all we can.\nWhat's the big deal? I didn't become a mage for \
    nothing, you know!"
set key[id=625204011010863] name "All right, let's do all we can.\nWhat's the big deal? I didn't become a mage for \
    nothing, you know!"
set key[id=625204011010864] name "Huff... huff...\nThere's no end to these troops...!"

# Quest dialogue of the CharacterAbility quests that no pack has in English (feature CharacterAbility): our own
# English for the 5 scriptquest rows of locale KR (or no locale) whose quest a player can get (1 quests), with each
# row's own format fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=621020511003032] name "Now that the power of <font color=\"#ffd200\">traits</font> has opened up, \
    you'll have more <font color=\"#ffd200\">choices</font> as you train\nand grow.\nAnd to know what path you \
    truly want\nand choose it well, varied experience matters more than anything. "
set key[id=621020511003033] name "So go and gain as much experience as you can.\nIf you're not sure what to do, \
    try the <font color=\"#ffd200\">Maple Guide</font>.\nIt tells you what's worth doing at your current level."
set key[id=621020511003034] name "Don't forget that upgrading your skills lets you fight far more \
    efficiently.\nOh, and talk to me once more before you leave for training."
set key[id=621020511003035] name "Don't forget that upgrading your skills lets you fight far more \
    efficiently.\nOh, and talk to me once more before you leave for training."
set key[id=621020511003036] name "Here, take this. You'll need <font color=\"#ffd200\">$item:40100022$</font> to \
    upgrade skills to a higher level. \nI picked it up on my way here, so don't make a fuss about thanking me. \
    Just train hard."

# Quest dialogue of the 22_04 quests that no pack has in English (feature 22_04): our own English for the 5
# scriptquest rows of locale KR (or no locale) whose quest a player can get (1 quests), with each row's own format
# fields, font tags and line breaks; the player's lines are first-person choices.
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=1026153614004511] name "Ugh, what on earth has Black Bean done this time?\nThe biggest troublemaker in \
    Maple World these days is Black Bean.\nHe made balloons that look just like him and scattered them all over \
    Maple World!"
set key[id=1026153614004512] name "Plenty of people are frowning at the sight of them.\nThey've completely ruined \
    the beautiful scenery of Maple World."
set key[id=1026153614004513] name "Could you clear those balloons away for me, $MyPCName$?\nYou think Black Bean \
    might feel hurt?\nHe's busy dreaming up his next prank. He won't care about a few balloons."
set key[id=1026153614004514] name "Please get rid of the Black Bean lookalike balloons."
set key[id=1026153614004515] name "There are so many, I clear them and clear them and there's no end.\nStill, \
    thanks to you, $MyPCName$, Maple World is starting to look like itself again."

# System mails the server sends (first login, returning player, world raid, nurturing): our own English for the
# 6 such mails that are still in Korean, with each row's own format fields, links and line breaks.
file Xml/string/kr/systemmailcontentkr.xml kms:Xml/string/kr/systemmailcontentkr.xml de7a6c87e4d434b5
set mail[id=160331001] subject "(Important) How to grow fast~!"
set mail[id=160331001] content "Hello! This is MapleStory 2. \n\nWelcome, adventurer!\nIs this your first time in \
    MapleStory 2!? \n\nWhat jobs are there in Maple World?\nWhat kind of place is Maple World? \nWhere can you get \
    what gear?\nWhat should you do right now? \n\nCurious about all of it?? \n\nRather than learning bit by \
    bit!\n\nRight now! Right away!! ASAP!!!\nWe put this together for adventurers who want to know it all. \
    \n\nFind the answers to your many questions \
    here.\n\n$externalWeb:[Link],http://maplestory2.nexon.com/guidebook/beginner,1e90ff$\n\n\nThe more you know \
    before you start, the faster you grow!\nRead up first, then set out on your adventure.\n\nGOOD LUCK!\n\nThank \
    you."
set mail[id=170531001] subject "A gift for our returning adventurer has arrived!"
set mail[id=170531001] content "Hello, this is MapleStory 2.\nIt's been a while, adventurer!\n\nWe're so glad \
    you're back that\nwe've prepared a [Returning Adventurer Welcome Box] for you.\n\nWe're sure it will help you \
    on your adventures in Maple World~\n\nSee you around in MapleStory 2~!\n\nThank you."
set mail[id=170531002] subject "[GM] All the ways to play, in one place."
set mail[id=170531002] content "Hi! Back in Maple World after a long time? \nGood to see you. I'm Vanilla. You \
    haven't forgotten me, have you? ^^\n\nYou must be wondering what has changed while you were away, \nand which \
    content to try first. \nIf so, click the link below.\n\n$maview:[Go to the Play Guide! \
    Click!],http://maview.nexon.com/News/ListSub?page=1&tp=guide,1e90ff$\n\nThe Play Guide board is full of useful \
    play tips.\n\nSo whenever you have a question, \nfeel free to check the Play Guide board. \nI'll always keep \
    it up to date! ^^\n\nSee you again, okay? Bye!"
set mail[id=180510006] subject "[World Raid] Your Mushking defeat reward has arrived."
set mail[id=180510006] content "Hello, this is MapleStory 2.\n\nYour reward for defeating Mushking has \
    arrived.\n\n'Gold Mushking Coins' can be exchanged for a variety of items.\nVisit the 'Mushking Coin Shop' run \
    by 'Guard Mim'.\n\n(Note) The attached items are deleted along with this mail if you do not\nmove them to your \
    inventory within 30 days, so please collect them soon.\n\nThank you so much for helping defeat Mushking!"
set mail[id=180510007] subject "[World Raid] Your Mushking defeat reward has arrived."
set mail[id=180510007] content "Hello, this is MapleStory 2.\n\nYour reward for defeating Mushking has \
    arrived.\n\n'5th Anniversary Mushking Coins' can be exchanged for a variety of items.\nDouble-click a coin or \
    visit the 'Mushking Coin Shop' run by 'Ruby' to use the shop.\n\n(Note) The attached items are deleted along \
    with this mail if you do not\nmove them to your inventory within 30 days, so please collect them \
    soon.\n\nThank you for stopping Mushking's counterattack."
set mail[id=180524005] subject "['Raise a Rainbow Slime?'] My Rainbow Slime grew!"
set mail[id=180524005] content "A friend played with my Rainbow Slime, and it grew!\nTo celebrate, here are 2 \
    Rainbow Coins as a gift.\n\nNotes)\n* You can play with the same Rainbow Slime once a day.\n* You can play \
    with up to 2 Rainbow Slimes a day.\n* Any number of friends can play with your Rainbow Slime, but the growth \
    it gets from friends playing with it is capped at 30 a day."

