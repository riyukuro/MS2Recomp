set key[id=213004414002588] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002589] name "I heard someone called <font color=\"#ffd200\">GM Chunbae</font> crying out loud \
    the other day that\n<font color=\"#ffd200\">his real name wasn't Chunbae</font>. My brother says he's a \
    pitiful man...\nIf you want to know his story, he says to see someone called <font \
    color=\"#ffd200\">$npc:11000456[gender:0]$</font>.\nWould you go to <font \
    color=\"#ffd200\">$map:02000070$</font> in <font color=\"#ffd200\">$map:02000062$</font> and find out what \
    happened?"
set key[id=213004414002590] name "I heard someone called <font color=\"#ffd200\">GM Chunbae</font> sniffling the \
    other day that\n<font color=\"#ffd200\">his real name wasn't Chunbae</font>. My brother says he's a pitiful \
    man...\nIf you want to know his story, he says to see someone called <font \
    color=\"#ffd200\">$npc:11000456[gender:0]$</font>.\nWould you go to <font \
    color=\"#ffd200\">$map:02000070$</font> in <font color=\"#ffd200\">$map:02000062$</font> and find out what \
    happened?"
set key[id=213004414002591] name "You're here, $MyPCName$!\nDid that person called <font \
    color=\"#ffd200\">$npc:11000456[gender:0]$</font> tell you what happened?"
set key[id=213004414002592] name "It was a story that's so Chunbae."
set key[id=213004414002593] name "It was a story about everyone finding their own place."
set key[id=213004414002594] name "A <font color=\"#ffd200\">story that's so Chunbae</font>...?\nI don't know what \
    you mean, but somehow I feel like I understand...."
set key[id=213004414002595] name "What on earth...? My brother and you, $MyPCName$, both say such strange things. \
    \nI'll have to go ask in person next time. "
