set key[id=20320047] tooltipDescription "A raffle ticket that gives you a chance to win a Red Bella figure."
set key[id=20320047] guideDescription "\\nHow to get a Red Bella figure<font color='#FFFFFF'>\\n- Keep this raffle \
    ticket until March 18, 2021.\\n- Watch for the raffle announcement on the official website.\\n- If you are \
    chosen as a winner, you will go through a shipping address collection step and then receive the Red Bella \
    figure.</font>"
