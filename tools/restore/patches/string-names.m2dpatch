set key[id=202205914001991] name "You collected all the chocolate ingredients!\nHere's the $item:20300637$ I \
    promised.\nPut your whole heart into it and give it to someone precious to you, $MyPCName$!"
set key[id=202205914001992] name "You chose the $item:20300638$!\nTell <font \
    color=\"#ffd200\">$npc:11000406[gender:0]$</font> how you feel, $MyPCName$.\n<font \
    color=\"#ffd200\">$npc:11000406[gender:0]$</font> should be in $map:02000137$."
set key[id=202205914001993] name "You chose the $item:20300638$!\nTell <font \
    color=\"#ffd200\">$npc:11000406[gender:0]$</font> how you feel, $MyPCName$.\n<font \
    color=\"#ffd200\">$npc:11000406[gender:0]$</font> should be in $map:02000137$."
set key[id=202205914001994] name "Oh my, oh my... Did you run all this way to give me chocolate too?\nSigh, this \
    popularity of mine...\nSo this popularity vote really was for me!"
set key[id=202205914001995] name "You chose the $item:20300639$!\nTell <font \
    color=\"#ffd200\">$npc:11001430[gender:0]$</font> how you feel, $MyPCName$.\n<font \
    color=\"#ffd200\">$npc:11001430[gender:0]$</font> should be in $map:02010047$."
set key[id=202205914001996] name "You chose the $item:20300639$!\nTell <font \
    color=\"#ffd200\">$npc:11001430[gender:0]$</font> how you feel, $MyPCName$.\n<font \
    color=\"#ffd200\">$npc:11001430[gender:0]$</font> should be in $map:02010047$."
set key[id=202205914001997] name "Colorful chocolate...\nI want to believe your feelings.\nMaybe I've gotten used \
    to you..."
set key[id=202205914001998] name "You chose the $item:20300640$!\nTell $npc:11001216[gender:0]$ how you feel, \
    $MyPCName$.\n$npc:11001216[gender:0]$ is away for a while, so\n<font color=\"#ffd200\">please give it to \
    $npc:11000012[gender:0]$ in $map:02000001$.</font>"
set key[id=202205914001999] name "You chose the $item:20300640$!\nTell $npc:11001216[gender:0]$ how you feel, \
    $MyPCName$.\n$npc:11001216[gender:0]$ is away for a while, so\n<font color=\"#ffd200\">please give it to \
    $npc:11000012[gender:0]$ in $map:02000001$.</font>"
set key[id=202205914002000] name "This is chocolate for $npc:11001216[gender:0]$!\nStartz left a message before \
    leaving.\n'Egg prices have gone way up. I'm heading out for a while to get fresh eggs.\nWhen I get back, I'll \
    make an omelet just for you. I'll gladly accept the chocolate.'"
set key[id=202205914002001] name "You chose the $item:20300641$!\nTell $npc:11001229[gender:0]$ how you feel, \
    $MyPCName$.\n<font color=\"#ffd200\">Please give the chocolate for $npc:11001229[gender:0]$ to \
    $npc:11000012[gender:0]$ in $map:02000001$.</font>"
set key[id=202205914002002] name "You chose the $item:20300641$!\nTell $npc:11001229[gender:0]$ how you feel, \
    $MyPCName$.\n<font color=\"#ffd200\">Please give the chocolate for $npc:11001229[gender:0]$ to \
    $npc:11000012[gender:0]$ in $map:02000001$.</font>"
set key[id=202205914002003] name "This is chocolate for $npc:11001229[gender:0]$!\nI'll make sure it gets there, \
    along with your feelings, $MyPCName$.\n$npc:11001229[gender:0]$ must miss you a lot too, $MyPCName$."
set key[id=202205914002004] name "You chose the $item:20300642$!\nTell <font \
    color=\"#ffd200\">$npc:11000252[gender:0]$</font> how you feel, $MyPCName$.\n<font \
    color=\"#ffd200\">$npc:11000252[gender:0]$</font> should be in $map:02000158$ in $map:02000100$."
set key[id=202205914002005] name "You chose the $item:20300642$!\nTell <font \
    color=\"#ffd200\">$npc:11000252[gender:0]$</font> how you feel, $MyPCName$.\n<font \
    color=\"#ffd200\">$npc:11000252[gender:0]$</font> should be in $map:02000158$ in $map:02000100$."
set key[id=202205914002006] name "Hmm... Chocolate for me?! Now that's a rare, outstanding talent!\nIt reminds me \
    of my youth.\nDon't live your life going Gol~ Gol~ Goldus~ and grumbling. Just for today, live for a powerful \
    love!\nCome on, repeat after me!"
set key[id=202205914002007] name "Hello, $MyPCName$!\nJoin the 'Greater Hero' event made just for you, \
    $MyPCName$,\nand get a $item:20300646$!"
set key[id=202205914002008] name "If you defeat a dungeon boss in a level 50 or higher adventure dungeon, you can \
    get \n<font color=\"#ffd200\">$item:30000731$</font>!\nBring me 3 <font \
    color=\"#ffd200\">$item:30000731$</font> and I'll exchange them for a $item:20300646$! \nGood luck!"
set key[id=202205914002009] name "If you defeat a dungeon boss in a level 50 or higher adventure dungeon, you can \
    get \n<font color=\"#ffd200\">$item:30000731$</font>!\nBring me 3 <font \
    color=\"#ffd200\">$item:30000731$</font> and I'll exchange them for a $item:20300646$! \nGood luck!"
set key[id=202205914002010] name "You've already done it! \nA great hero indeed, $MyPCName$!"
set key[id=202205914002011] name "Perfect timing, $MyPCName$!\nWith egg prices skyrocketing in Maple World, it's \
    gotten hard to get \nfresh, smooth eggs.\nAnd you really need them to get Mendel's chocolate."
set key[id=202205914002012] name "Defeat <font color=\"#ffd200\">adventure dungeon bosses</font>, $MyPCName$, \
    \nand show everyone you're worthy of fresh, smooth eggs!"
set key[id=202205914002013] name "Defeat <font color=\"#ffd200\">adventure dungeon bosses</font>, $MyPCName$, \
    \nand show everyone you're worthy of fresh, smooth eggs!"
set key[id=202205914002014] name "Your powerful display, $MyPCName$, got us fresh, smooth eggs, $MyPCName$!\nYou \
    really are the best!"
set key[id=205133414002018] name "Hello, $MyPCName$!\nWelcome to Maple World! $npc:11001003[gender:0]$ has \
    prepared tasty candy to celebrate your visit.\nTalk to <font color=\"#ffd200\">$npc:11001003[gender:0]$</font> \
    and take some tasty candy."
set key[id=205133414002019] name "Hello, $MyPCName$!\nWelcome to Maple World! $npc:11001003[gender:0]$ has \
    prepared tasty candy to celebrate your visit.\nTalk to <font color=\"#ffd200\">$npc:11001003[gender:0]$</font> \
    and take some tasty candy."
set key[id=205133414002020] name "Hello, $MyPCName$!\nI've been counting the days until I could meet you, \
    $MyPCName$, making candy all the while.\nI can't promise how it tastes, but it gives you a special power, so \
    give it a try."
set key[id=211134614002024] name "Welcome, $MyPCName$!\nMaple World is full of all kinds of exciting adventure \
    dungeons! You know that, right?"
set key[id=211134614002025] name "Take on <font color=\"#ffd200\">one of the adventure dungeons of level 50 or \
    higher</font>.\nAs a reward, I'll give you a Maple Town commemorative coin that's useful in \
    \n$map:63000049$.\nGood luck!"
set key[id=211134614002026] name "Take on <font color=\"#ffd200\">one of the adventure dungeons of level 50 or \
    higher</font>.\nAs a reward, I'll give you a Maple Town commemorative coin that's useful in \
    \n$map:63000049$.\nGood luck!"
set key[id=211134614002027] name "You've already done it!\nThat's you, $MyPCName$!"
set key[id=211134614002028] name "Welcome, $MyPCName$!\nYou should have a refreshing day today too, right?"
set key[id=211134614002029] name "In that spirit, shall we take a nice, clean bath?\nEnjoy a half bath with the \
    <font color=\"#ffd200\">$item:50400091$</font>!"
set key[id=211134614002030] name "In that spirit, shall we take a nice, clean bath?\nEnjoy a half bath with the \
    <font color=\"#ffd200\">$item:50400091$</font>!"
set key[id=211134614002031] name "Your skin feels so smooth now!\nI'd better hurry home today and have a half bath \
    too!"
set key[id=211134614002032] name "Welcome, $MyPCName$!\nYou should have a healthy, energetic day today too, \
    right?"
set key[id=211134614002033] name "In that spirit, why not start the day on the treadmill?\nHow about a run on the \
    <font color=\"#ffd200\">$item:50400096$</font>?"
set key[id=211134614002034] name "In that spirit, why not start the day on the treadmill?\nHow about a run on the \
    <font color=\"#ffd200\">$item:50400096$</font>?"
set key[id=211134614002035] name "Wow, $MyPCName$!\nYour color is better and you look so healthy! "
set key[id=211134614002036] name "Welcome, $MyPCName$!\nThe Year of the Rooster has begun! Let's have a great \
    2017!"
set key[id=211134614002037] name "Raise chickens at the chicken coop and get <font \
    color=\"#ffd200\">$item:33000026$</font>.\nWith all that lucky chicken energy, it's sure to be a happy day!"
set key[id=211134614002038] name "Raise chickens at the chicken coop and get <font \
    color=\"#ffd200\">$item:33000026$</font>.\nWith all that lucky chicken energy, it's sure to be a happy day!"
set key[id=211134614002039] name "Welcome back!\nMaybe it's my imagination, but you seem to be glowing, \
    $MyPCName$!"
set key[id=211134614002040] name "Welcome, $MyPCName$!\nYou look a little stiff today. Is stress building up?"
set key[id=211134614002041] name "Bang bang! Mining might help relieve your stress.\nMine <font \
    color=\"#ffd200\">$item:33000001$</font> from a copper vein.\nYou'll feel refreshed in body and mind!"
set key[id=211134614002042] name "Bang bang! Mining might help relieve your stress.\nMine <font \
    color=\"#ffd200\">$item:33000001$</font> from a copper vein.\nYou'll feel refreshed in body and mind!"
set key[id=211134614002043] name "Welcome back!\nI can feel how refreshed you look, $MyPCName$!"
set key[id=211134614002044] name "Welcome, $MyPCName$!\nHave you gotten close to the people of Maple World?"
