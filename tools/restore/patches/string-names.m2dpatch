# Flash UI strings (options, menu popups) the Korean table has only in Korean and no English table has: our
# own English; the count words after numbers are empty, as in the English table.
file Xml/string/kr/korflash.xml kms:Xml/string/kr/korflash.xml 5a0c445adf501b2f
set key[id=$s_gameoption_singleriding] value "Ride two-seat mounts alone"
set key[id=$s_gameoption_charSoundStep] value "Character voice"
set key[id=$s_gameoption_optimizer_show_physx] value "Hair physics on other characters"
set key[id=$s_gameoption_agreement_personal_info] value "Personal data transfer abroad"
set key[id=$s_gameoption_agreement_radio_agree] value "Allow"
set key[id=$s_gameoption_agreement_radio_deny] value "Decline"
set key[id=$s_gameoption_agreement_btn_detail] value "Details"
set key[id=$s_gameoption_agreement_summary] value "Game logs may go, anonymized and encrypted, to the developer."
set key[id=$s_gamemenu_popup_longtermattendgift] value "Golden\\nDuckyball"
set key[id=$s_tooltip_gameoption_agreement] value "<FONT color='#FFD200' size='15' >Personal Data</FONT>\\n<FONT \
    size='3'> </FONT>\\nPersonal data settings."
set key[id=$s_msgbox_cnt] value ""
set key[id=$s_smart_recommend_billing_price_num] value ""
set key[id=$s_massiveevent_moviecounter_count] value ""
set key[id=$s_bluemarble_tag_trap] value "Jail"
# Enchant window (Ophelia) texts: the meso fee for missing Crystal Fragments and the unlimited-enchant cost are
# Korean only in every table, so they get our own English; the enchant scroll's no-break line, which the Korean
# table lacks, takes the English row of the same pack.
file Xml/string/kr/stringcommon.xml kms:Xml/string/kr/stringcommon.xml 1caa91b5294d03ed
need kms:Xml/string/en/stringcommon.xml 6ff9ab3c0a059a75
set key[id=s_itemenchant_fee] value "Crystal Fragment substitute cost {0}<Img Src='export_common_icon_meso' \
    vspace='-4'></Img>"
set key[id=s_unlimited_enchant_fee] value "Cost {0}<Img Src='export_common_icon_meso' vspace='-4'></Img>"
copy-row key[id=s_enchantscroll_desc_disable_break] kms:Xml/string/en/stringcommon.xml
# Default guild rank names: on a KR client a rank name may have at most 7 characters, and the guild window checks
# every rank a master changes, rights included. The English defaults are longer, so they get short English names.
# Each passes the client's name rule and none is in the pack's ban or reserved name lists.
set key[id=s_guild_grade_default_master] value "Leader"
set key[id=s_guild_grade_default_group1] value "Officer"
set key[id=s_guild_grade_default_group2] value "Member"
set key[id=s_guild_grade_default_group3] value "Novice"
set key[id=s_guild_grade_default_group4] value "Member2"
set key[id=s_guild_grade_default_group5] value "Novice2"
# KR-only event system mails with no English row in any pack (the elite weapon support level packages, 50000100-
# 50000111 and 50001000-50001005, and the bingo play-time gifts 190411001-190411002): our own English for the
# subject and text; the item links are the ones the rows have.
file Xml/string/kr/systemmailcontentkr.xml kms:Xml/string/kr/systemmailcontentkr.xml de7a6c87e4d434b5
row mail[id=50000100] <mail id="50000100" sender="MapleStory 2 Team" subject="[Elite Weapon Support] Job Change \
    Gift: Lv. 10 Weapon Package" content="Congratulations on your job change!&#10;Here is the Lv. 10 weapon package \
    for your new job.&#10;&#10;During the event, you get an Elite Weapon Package for your job every 5 levels from \
    Lv. 1 to Lv. 50, even after a job change.&#10;We hope these weapons make your adventures in MapleStory 2 more \
    fun.&#10;&#10;Double-click the Elite Weapon Package attached to this mail to get an Elite Weapon you can use \
    right away.&#10;The Elite Weapons stay usable after the event ends.&#10;&#10;(Note) Attached items are deleted \
    with the mail if you do not move them to your inventory within 30 days, so claim them soon.&#10;The Elite Weapon \
    Package and the items in it cannot be moved between characters." />
row mail[id=50000101] <mail id="50000101" sender="MapleStory 2 Team" subject="[Elite Weapon Support] Lv. 1 Weapon \
    Package" content="Welcome to MapleStory 2!&#10;We have sent you a Lv. 1 weapon package with an Elite Weapon in \
    it.&#10;We hope this weapon makes MapleStory 2 more fun.&#10;&#10;During the event, you get an Elite Weapon \
    Package every 5 levels from Lv. 1 to Lv. 50, so keep leveling up!&#10;&#10;Double-click the Elite Weapon Package \
    attached to this mail to get an Elite Weapon you can use right away.&#10;The Elite Weapons stay usable after the \
    event ends.&#10;&#10;(Note) Attached items are deleted with the mail if you do not move them to your inventory \
    within 30 days, so claim them soon.&#10;The Elite Weapon Package and the items in it cannot be moved between \
    characters." />
row mail[id=50000102] <mail id="50000102" sender="MapleStory 2 Team" subject="[Elite Weapon Support] Lv. 5 Weapon \
    Package" content="Congratulations!&#10;Your Lv. 5 weapon package has arrived.&#10;&#10;During the event, you get \
    an Elite Weapon Package every 5 levels from Lv. 1 to Lv. 50.&#10;Enjoy MapleStory 2 with your new \
    weapon!&#10;&#10;Double-click the Elite Weapon Package attached to this mail to get an Elite Weapon you can use \
    right away.&#10;The Elite Weapons stay usable after the event ends.&#10;&#10;(Note) Attached items are deleted \
    with the mail if you do not move them to your inventory within 30 days, so claim them soon.&#10;The Elite Weapon \
    Package and the items in it cannot be moved between characters." />
row mail[id=50000103] <mail id="50000103" sender="MapleStory 2 Team" subject="[Elite Weapon Support] Lv. 10 Weapon \
    Package" content="Congratulations!&#10;Your Lv. 10 weapon package has arrived.&#10;&#10;During the event, you \
    get an Elite Weapon Package every 5 levels from Lv. 1 to Lv. 50.&#10;Enjoy MapleStory 2 with your new \
    weapon!&#10;&#10;Double-click the Elite Weapon Package attached to this mail to get an Elite Weapon you can use \
    right away.&#10;The Elite Weapons stay usable after the event ends.&#10;&#10;(Note) Attached items are deleted \
