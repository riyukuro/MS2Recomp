row mail[id=190411001] <mail id="190411001" sender="MapleStory 2 Team" subject="[Check-Check Bingo] 30-Minute Login \
    Gift: $item:20302533$" content="Your 30-minute login gift, [$item:20302533$], has arrived.&#10;&#10;Use \
    $item:20302533$ to check off today's bingo number!&#10;You get one $item:20302533$ for 30 minutes online from \
    Monday to Thursday,&#10;and one each for 30 and 60 minutes online on Friday, Saturday and Sunday.&#10;&#10;Want \
    to check off a number of your choice?&#10;Try [$item:20302534$].&#10;You can also get $item:20302534$ from bingo \
    rewards and the Meret Market.&#10;&#10;Every bingo line you complete brings a spring reward, so don't miss \
    out!&#10;&#10;* [$item:20302533$] can be used until the maintenance on Thursday, May 16. Be sure to use it \
    before then.&#10;&#10;Thank you." />
row mail[id=190411002] <mail id="190411002" sender="MapleStory 2 Team" subject="[Check-Check Bingo] 60-Minute Login \
    Gift: $item:20302533$" content="Your 60-minute login gift, [$item:20302533$], has arrived.&#10;&#10;Use \
    $item:20302533$ to check off today's bingo number!&#10;You get one $item:20302533$ for 30 minutes online from \
    Monday to Thursday,&#10;and one each for 30 and 60 minutes online on Friday, Saturday and Sunday.&#10;&#10;Want \
    to check off a number of your choice?&#10;Try [$item:20302534$].&#10;You can also get $item:20302534$ from bingo \
    rewards and the Meret Market.&#10;&#10;Every bingo line you complete brings a spring reward, so don't miss \
    out!&#10;&#10;* [$item:20302533$] can be used until the maintenance on Thursday, May 16. Be sure to use it \
    before then.&#10;&#10;Thank you." />
# KR-only texts players meet that no pack has in English (only placeholder keys): our own English for the epic
# quests 10001270 and 10003062 (journal name, description, objective and completion text, and their dialogue
# lines), title 10000867 and item 20001786 (name, plural, tooltip). Format fields and item links are the rows' own;
# the particle fields ($pp) are Korean grammar and are left out. The dialogue table does not turn \n into a
# line break, so the dialogue lines have none; the text box wraps them.
file Xml/string/kr/questdescription_final.xml kms:Xml/string/kr/questdescription_final.xml 157fd88e98c59ac6
set quest[questID=10001270] name "Unbreakable Will"
set quest[questID=10001270] desc "Construction plans are vital to building Rockefeller Tower, the tallest skyscraper \
    in Maple World. Defeat the monsters that raided $map:02000136$ and bring back the $item:30000043$."
set quest[questID=10001270] manual "Defeat monsters in $map:02000136$ and find the $item:30000043$"
set quest[questID=10001270] complete "Meet $npc:11000220$ in $map:02000136$"
set quest[questID=10003062] name "Dealings in the Dark"
set quest[questID=10003062] desc "$npc:11000623$, who runs a shop in $map:02000203$, says the trade in stolen goods \
    running wild lately is ruining the market, and asked you to go to $dungeonTitle:21005001$, where stolen goods \
    are said to change hands openly, and find out whether the rumor is true."
set quest[questID=10003062] manual "Enter the $dungeonTitle:21005001$ dungeon and clear it up to floor 5"
set quest[questID=10003062] complete "Talk to $npc:11000623$ in $map:02000203$"
file Xml/string/kr/scriptquest.xml kms:Xml/string/kr/scriptquest.xml 032f90f7273bbe7d
set key[id=831174302000654] name "No, it was right here, I'm sure of it... Where on earth did it go?! Did those \
    creatures do it again...?"
set key[id=831174302000655] name "Ask what happened."
set key[id=831174302000656] name "Ah, well... Part of the <font color=\"#ffd200\">$item:30000043$</font> has gone \
    missing again. The <font color=\"#ffd200\">Rockefeller Tower</font> we're building is huge and complex, so its \
    plans run to hundreds of sheets. If even one is missing, the work can't go on..."
set key[id=831174302000657] name "Monsters stormed the site once before, made a mess and even stole the <font \
    color=\"#ffd200\">$item:30000043$</font>. We barely got it back... This has to be their doing again."
set key[id=831174302000658] name "Will you <font color=\"#ffd200\">get the missing $item:30000043$ back from the \
    monsters around here</font>?"
set key[id=831174302000659] name "Will you <font color=\"#ffd200\">get the missing $item:30000043$ back from the \
    monsters around here</font>?"
set key[id=831174302000660] name "Ah, you found them! Thank you. The <font color=\"#ffd200\">Rockefeller \
    Tower</font> will be the sturdiest and tallest building in Maple World. Just finishing these plans took... \
    phew..."
set key[id=831174302000661] name "I'll build the <font color=\"#ffd200\">Rockefeller Tower</font> exactly to these \
    perfect plans. Just you watch!"
set key[id=1005151102005812] name "Hmm... These days fences are running wild, and the equipment trade is dying \
    because of it. They say stolen goods change hands openly in $dungeonTitle:21005001$ in $map:02000083$. Will you \
    go and look into it?"
set key[id=1005151102005813] name "Hmm... These days fences are running wild, and the equipment trade is dying \
    because of it. They say stolen goods change hands openly in $dungeonTitle:21005001$ in $map:02000083$. Will you \
    go and look into it?"
set key[id=1005151102005814] name "Oh, <font color=\"#ffd200\">$MyPCName$</font>! You're back sooner than I thought. \
    So, are stolen goods really changing hands in <font color=\"#ffd200\">$dungeonTitle:21005001$</font>, like the \
    rumors say?"
set key[id=1111143102005853] name "Say you saw no trading, but <font \
    color=\"#ffd200\">$npcName:21000106[gender:0]$</font> was guarding the place."
set key[id=1111143102005854] name "<font color=\"#ffd200\">$npcName:21000106[gender:0]$</font>?? Hmm... From what \
    you say, that one doesn't sound like a fence... Someone the fences hired, maybe...? Hmm... There's no proof, but \
    something shady does seem to be going on in $dungeonTitle:21005001$."
set key[id=1111143102005855] name "Otherwise, why would every floor have devices to keep outsiders out? I'd better \
    gather the merchants' guild and work out a proper plan!"
file Xml/string/kr/titlename.xml kms:Xml/string/kr/titlename.xml 1714c546e1d2948c
set key[id=10000867] name "Guest of the Dolls"
file Xml/string/kr/itemname.xml kms:Xml/string/kr/itemname.xml 8c56a83382e644a3
set key[id=20001786] name "(Premium) Hyper White Potion"
file Xml/string/kr/itemnameplural.xml kms:Xml/string/kr/itemnameplural.xml a4eb65ca9faa967f
set key[id=20001786] name "(Premium) Hyper White Potions"
file Xml/string/kr/koritemdescription.xml kms:Xml/string/kr/koritemdescription.xml 669a7f4ea48c36b2
set key[id=20001786] mainDescription "<font size='14'>5 Sec Cooldown</font>\\n<font size='24'>Restores 3600 \
    HP</font>"
set key[id=20001786] tooltipDescription "A powerful potion made with a new technique. It goes down in one gulp, so \
    it works fast. Drinking it immediately <font color='#00aaef'>restores 3600 HP</font>. One drink fills you up, so \
    you can drink another after 5 sec."
# KR-only event system mails with no English row in any pack (the Race Against Time start mails 170928001 and
# 180524004, and the rock-paper-scissors login gifts 171228005 and 190214001): our own English; the item links are
# the ones the rows have.
file Xml/string/kr/systemmailcontentkr.xml kms:Xml/string/kr/systemmailcontentkr.xml de7a6c87e4d434b5
row mail[id=170928001] <mail id="170928001" sender="MapleStory 2 Team" subject="The Race Against Time event begins!" \
    content="Hello, this is Ruby, your event helper!&#10;&#10;Remember the Race Against Time pre-opening event we \
    ran from September 14 until the maintenance on the 28th?&#10;&#10;Well, the real event starts now!&#10;&#10;Just \
    like the pre-opening event, this Race Against Time rewards you for clearing all kinds of missions over 7 \
    days!&#10;&#10;The final reward is 1,000 Event Merets!&#10;The Gift Box of Time now gives 10 Shining Moon \
    Fragments!&#10;You can trade Shining Moon Fragments for all kinds of items at the Moon Rabbit's shop and at \
    Peddler Tenten's shop, both at the Stardust Fishing Spot!&#10;&#10;Race Against Time matters more than \
    ever!&#10;Here is how to take part once more:&#10;&#10;1. On the character you want to race with, claim the \
    Hourglass of Transcendence attached to this mail.&#10;Only the character that uses the hourglass can run the \
    Race Against Time! Some quests along the way are tough, so think it over before you use it.&#10;&#10;2. Clear \
    the missions and claim every reward before the 7 days that start when you use the hourglass run out!&#10;The \
    event lasts until the maintenance on October 26, but once you use the hourglass, the 7 days cannot be \
    stopped!&#10;TIP: use the hourglass when you can clear 7 days of missions within the event period!&#10;The event \
    ends with the maintenance on October 26 even if you have missions left, so clear all 7 days of missions before \
    then!&#10;&#10;3. Beat the clock to the finish line and claim the final reward of 1,000 Event Merets!&#10;&#10;* \
    The Hourglass of Transcendence, the Gift Box of Time and the 1,000 Event Merets can be used until the regular \
    maintenance on Thursday, October 26. Be sure to use them before then.&#10;&#10;We look forward to seeing you run \
    again!&#10;Thank you." />
row mail[id=180524004] <mail id="180524004" sender="MapleStory 2 Team" subject="The Race Against Time event begins!" \
    content="Hello, this is Ruby, your event helper!&#10;&#10;Do you remember the Race Against Time?&#10;Racing to \
    clear every mission in 7 days brings back such fond memories.&#10;&#10;So, shall we run once more?&#10;The final \
    reward is an adorable Chow Chow pet.&#10;Don't miss the Rainbow Coins you get for each mission you \
    clear.&#10;&#10;How to take part&#10;&#10;1. On the character you want to race with, claim the Hourglass of \
    Transcendence attached to this mail.&#10;Note: the event runs on the character that uses the Hourglass of \
    Transcendence.&#10;Think carefully about which character to race with and when it is best to use the Hourglass \
    of Transcendence.&#10;&#10;2. Clear the missions and claim every reward before the 7 days that start when you \
    use the hourglass run out.&#10;The event lasts until the maintenance on June 21, but once you use the hourglass, \
    the 7 days cannot be stopped!&#10;TIP: use the hourglass when you can clear 7 days of missions within the event \
    period!&#10;The event ends with the maintenance on June 21 even if you have missions left, so clear all 7 days \
    of missions before then!&#10;&#10;3. Beat the clock to the finish line and claim the final reward!&#10;&#10;* \
    The Hourglass of Transcendence and the Rainbow Coins can be used until the regular maintenance on Thursday, June \
    21. Be sure to use them before then.&#10;&#10;We look forward to seeing you run again!&#10;Thank you." />
row mail[id=171228005] <mail id="171228005" sender="MapleStory 2 Team" subject="[Rock-Paper-Scissors] Your login \
    gift has arrived." content="Hello, this is MapleStory 2.&#10;&#10;A Rock-Paper-Scissors event has come to Maple \
    World, where you can face off in exciting matches!&#10;As a login gift, we are sending you [15 \
    Rock-Paper-Scissors Match Tickets].&#10;You need a Rock-Paper-Scissors Match Ticket for each match, so keep that \
    in mind!&#10;&#10;Now, here is how to play Rock-Paper-Scissors!&#10;&#10;First, use the Rock-Paper-Scissors menu \
    in the Adventure tab to post your own match and take on challengers,&#10;or second, walk up to another \
    adventurer who is posting a match and challenge them.&#10;&#10;You get a gift every day after your 3rd, 6th and \
    9th game,&#10;and a very, very special gift from the Fanfare Baby Angel awaits adventurers who keep \
    playing!&#10;&#10;Enjoy the games, and be sure to collect your gifts!&#10;&#10;* Rock-Paper-Scissors Match \
    Tickets can be used until the maintenance on Thursday, February 8, 2018. Be sure to use them before \
    then.&#10;&#10;Thank you.&#10;" />
row mail[id=190214001] <mail id="190214001" sender="MapleStory 2 Team" subject="[Rock-Paper-Scissors] Your login \
    gift has arrived." content="Hello, this is MapleStory 2.&#10;&#10;Adventurers, are you making it through the \
    cold winter?&#10;The Winter Rock-Paper-Scissors event is here, perfect for warming up frozen hands!&#10;As a \
    login gift, we are sending you [$item:20302404$ x15].&#10;You need $item:20302404$ for each match, so keep that \
    in mind!&#10;&#10;Now, here is how to play Rock-Paper-Scissors!&#10;&#10;First, use the Rock-Paper-Scissors menu \
    in the Adventure tab to post your own match and take on challengers,&#10;or second, walk up to another \
    adventurer who is posting a match and challenge them.&#10;&#10;You get a gift every day after your 3rd, 6th and \
    9th game,&#10;and adventurers who keep playing even get a chance at $item:40400080$!&#10;&#10;Enjoy the games, \
    and be sure to collect your gifts!&#10;&#10;* $item:20302404$ can be used until the maintenance on Thursday, \
    March 14, 2019. Be sure to use it before then.&#10;&#10;Thank you." />
