set key[id=312150014003145] name "Find a female friend wearing a level 30 or higher 'Rabbit Headband'!\nIf you \
    don't give up looking, you'll meet one soon. "
set key[id=312150014003146] name "You cleared today's mission!\nHere's the <font \
    color=\"#ffd200\">$item:30001100$</font> I promised!\nTake the <font color=\"#ffd200\">$item:30001100$</font> \
    to Bobby's event shop \nand you can buy great reward items. "
set key[id=312150014003147] name "Welcome, $MyPCName$!\nHow about a game of tag on this sunny day? \nFind the \
    Friend of the Day! \nOnce you find the Friend of the Day, come to me and I'll give you a Cherry Blossom Coin! \
    "
set key[id=312150014003148] name "Today's friend is... \nFind a Knight friend with the 'Maple-holic' title, level \
    40 or higher!\nYou should be able to meet one somewhere in Maple World. "
set key[id=312150014003149] name "Find a Knight friend with the 'Maple-holic' title, level 40 or higher!\nIf you \
    don't give up looking, you'll meet one soon. "
set key[id=312150014003150] name "You cleared today's mission!\nHere's the <font \
    color=\"#ffd200\">$item:30001100$</font> I promised!\nTake the <font color=\"#ffd200\">$item:30001100$</font> \
    to Bobby's event shop \nand you can buy great reward items. "
set key[id=312150014003151] name "Welcome, $MyPCName$!\nHow about a game of tag on this sunny day? \nFind the \
