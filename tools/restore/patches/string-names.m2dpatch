set key[id=11601088] tooltipDescription "<font color='#ff8ae5' size='14'>[Beast's Wrath Enhancement]\\nThe Beast's \
    Wrath effect is doubled.\\n\\n[Resonance with Green Lapenshard]\\nGrants immunity to Eupheria's curse in \
    Emerald Prison. This effect activates only when both Beast's Wrath and Beast's Wrath Enhancement are \
    active.</font>"
set key[id=11601088] guideDescription "\\n<font color='#7A7A7A'>Gear made from the remains of Behemoth, the giant \
    beast that terrorized the snowfields. It was made with technology from the distant past, so the hide, horns \
    and bones are merely joined together with little processing, yet it is said to be more than enough to serve \
    its purpose. Behemoth's hide is closer to steel, its horn compares to a battering ram that topples fortresses, \
    and the beast's wrath soaked into the bone tears apart any magic. But be careful. Equipping this gear means, \
    in a word, becoming Behemoth. It means you must forever satisfy an endless craving for life.</font>"
set key[id=11601089] tooltipDescription "<font color='#ff8ae5' size='14'>[Beast's Wrath Enhancement]\\nThe Beast's \
    Wrath effect is doubled.\\n\\n[Resonance with Green Lapenshard]\\nGrants immunity to Eupheria's curse in \
    Emerald Prison. This effect activates only when both Beast's Wrath and Beast's Wrath Enhancement are \
    active.</font>"
