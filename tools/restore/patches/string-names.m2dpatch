set key[id=104223414001901] name "For the new year, go talk to <font \
    color=\"#ffd200\">$npc:11000119[gender:0]$</font> in $map:02000001$!\nThey're close by, but they've always \
    wondered how you're doing, $MyPCName$.\nThey'd be thrilled if you visited."
set key[id=104223414001902] name "For the new year, go talk to <font \
    color=\"#ffd200\">$npc:11000119[gender:0]$</font> in $map:02000001$!\nThey're close by, but they've always \
    wondered how you're doing, $MyPCName$.\nThey'd be thrilled if you visited."
set key[id=104223414001903] name "Welcome back!\nWhat did you talk about with $npc:11000119[gender:0]$?\nYou \
    didn't bring up Knight Captain Allon again, did you?"
set key[id=104223414001904] name "Welcome, $MyPCName$!\nThe Year of the Rooster has begun! Let's have a great \
    2017!"
