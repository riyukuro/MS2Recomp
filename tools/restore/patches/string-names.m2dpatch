set key[id=11820144] guideDescription "A skin item that can be worn together with game items."
set key[id=11820383] tooltipDescription "A devoted adventurer's cape."
set key[id=11820383] guideDescription "A skin item that can be worn together with game items.\\n<font \
    color=\"#FF5F5F\">* The Lumistone in the socket and the base option and set option effects only take effect \
    when equipped in the Skin tab."
set key[id=11850283] tooltipDescription "A bag with a lovely heart shape."
set key[id=11850284] tooltipDescription "A cape with the holy aura of baby angels blowing fanfare."
set key[id=11900114] guideDescription "\\n<font color='#7A7A7A'>Gear refined from the weapons of the Terunkalib \
    commanders who had become Lapentouched. While purifying the influence of the Black Shard, it was improved and \
