set key[id=316160602004939] name "Ah~! You're here?"
set key[id=316160602004940] name "Oh! The Captain of the Guard was looking for you!\nYou'd better go see him right \
    away."
set key[id=316160602004941] name "Oh! The Captain of the Guard was looking for you!\nYou'd better go see him right \
    away."
