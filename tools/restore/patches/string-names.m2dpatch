set key[id=40410031] tooltipDescription "When you ride it, you rise 1.2m per second, up to 12m. Pressing a \
    direction key while it is active moves you forward 6.5m at a time. It cannot be used indoors or in some \
    areas."
set key[id=40410031] guideDescription "Double-click it in your inventory or register it in a quick slot to mount \
    and dismount."
set key[id=40410031] mainDescription "Summon Potato Hot Dog"
set key[id=40500005] tooltipDescription "Sparkling stardust you can get by dismantling Lumistones."
set key[id=40500005] guideDescription "The mysterious power in each fine particle can upgrade Lumistones."
set key[id=40500006] tooltipDescription "Sparkling stardust you can get by dismantling Lumistones."
set key[id=40500006] guideDescription "The mysterious power in each fine particle can upgrade Lumistones."
set key[id=50201154] tooltipDescription "A reward for completing a web event. A framed portrait of the Black Mage \
    wearing a hood."
set key[id=50201155] tooltipDescription "A reward for completing an epic quest. A framed portrait of the Black \
    Mage with the hood off and red eyes glowing."
set key[id=50600310] tooltipDescription "You can ride it comfortably as a pizza delivery motorcycle."
set key[id=50600310] guideDescription "Double-click it in your inventory or register it in a quick slot to mount \
    and dismount. After mounting, hold the basic attack key, or move while holding it, to use a special action."
set key[id=50600310] mainDescription "You can run very fast."
set key[id=50600311] tooltipDescription "Something smells around here. The faster you run, the worse it gets."
set key[id=50600311] guideDescription "Double-click it in your inventory or register it in a quick slot to mount \
    and dismount. After mounting, hold the basic attack key, or move while holding it, to use a special action."
set key[id=50600311] mainDescription "You can run very fast."
set key[id=50600335] tooltipDescription "A Glutton who believes it is a guardian of light. Watching the \
    adventurers' deeds freed it from the rule of darkness, gave it a self, and set it on the path of light. As a \
    first step, it offers its back so adventurers can travel the world in comfort."
set key[id=50740048] tooltipDescription "A souvenir that only one who defeated $npc:23000101$ can have."
set key[id=50770012] tooltipDescription "A special souvenir that only one who challenged $npc:44100001$ can get."
set key[id=61020153] tooltipDescription "<font color='#9FC93C'>Convenience Features\\n - Auto Tombstone Revive\\n \
    - Auto Potion Recovery\\n - Auto Item Pickup\\n<font size='3'> </font>\\n</font>An item that stores a pet's \
    summon information. Normally it stays in another dimension in item form, and comes out when the character \
    summons it. "
set key[id=61020153] guideDescription "When you summon a pet, you receive the effects of its stats. However, pets \
    cannot be summoned in some special areas."
