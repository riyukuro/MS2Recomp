set quest[questID=90000300] desc "Open the skill window, equip the newly learned skill $skill:10300031$ to a quick \
    slot, then use $skill:10300031$."
set quest[questID=90000300] manual "Use $skill:10300031$"
set quest[questID=90000301] name "Angry Claws"
set quest[questID=90000301] desc "Open the skill window, equip the newly learned skill $skill:10300001$ to a quick \
    slot, then use $skill:10300001$."
set quest[questID=90000301] manual "Use $skill:10300001$"
set quest[questID=90000310] name "Exploding Light"
set quest[questID=90000310] desc "Open the skill window, equip the newly learned skill $skill:10400011$ to a quick \
    slot, then use $skill:10400011$."
set quest[questID=90000310] manual "Use $skill:10400011$"
set quest[questID=90000311] name "Holy Light"
set quest[questID=90000311] desc "Open the skill window, equip the newly learned skill $skill:10400001$ to a quick \
    slot, then use $skill:10400001$."
set quest[questID=90000311] manual "Use $skill:10400001$"
set quest[questID=90000320] name "Arrow Cutting the Wind"
set quest[questID=90000320] desc "Open the skill window, equip the newly learned skill $skill:10500011$ to a quick \
    slot, then use $skill:10500011$."
set quest[questID=90000320] manual "Use $skill:10500011$"
set quest[questID=90000321] name "Shoot Like a Bee!"
set quest[questID=90000321] desc "Open the skill window, equip the newly learned skill $skill:10500001$ to a quick \
    slot, then use $skill:10500001$."
set quest[questID=90000321] manual "Use $skill:10500001$"
set quest[questID=90000330] name "Blazing Flames"
set quest[questID=90000330] desc "Open the skill window, equip the newly learned skill $skill:10600021$ to a quick \
    slot, then use $skill:10600021$."
set quest[questID=90000330] manual "Use $skill:10600021$"
set quest[questID=90000331] name "Rapid-Fire Cannon"
set quest[questID=90000331] desc "Open the skill window, equip the newly learned skill $skill:10600001$ to a quick \
    slot, then use $skill:10600001$."
set quest[questID=90000331] manual "Use $skill:10600001$"
set quest[questID=90000340] name "Basics of Poison"
set quest[questID=90000340] desc "Open the skill window, equip the newly learned skill $skill:10700011$ to a quick \
    slot, then use $skill:10700011$."
set quest[questID=90000340] manual "Use $skill:10700011$"
set quest[questID=90000341] name "Faster Than Light"
set quest[questID=90000341] desc "Open the skill window, equip the newly learned skill $skill:10700001$ to a quick \
    slot, then use $skill:10700001$."
set quest[questID=90000341] manual "Use $skill:10700001$"
set quest[questID=90000350] name "Scattered Shuriken"
set quest[questID=90000350] desc "Open the skill window, equip the newly learned skill $skill:10800021$ to a quick \
    slot, then use $skill:10800021$."
set quest[questID=90000350] manual "Use $skill:10800021$"
set quest[questID=90000351] name "Shuriken Reversal"
set quest[questID=90000351] desc "Open the skill window, equip the newly learned skill $skill:10800001$ to a quick \
    slot, then use $skill:10800001$."
set quest[questID=90000351] manual "Use $skill:10800001$"
set quest[questID=90000360] name "Boom Boom Boogie!"
set quest[questID=90000360] desc "As $npc:11000324$ taught me, press the Dynamic Action button next to the chat \
    input window and click any emotion you like."
set quest[questID=90000370] name "A Cycle of Debt"
set quest[questID=90000370] desc "$npc:11000609$ was an errand runner for Raymon, who secretly traded \
    $item:20000046$ with the Black Star Society. \nThen one day, Raymon vanished without a trace without paying \
    the Black Star Society for the $item:20000046$, and he was left holding all the debt. \nChased by the Black \
    Star Society, $npcName:11000609$ wants to explain the situation to $npc:11000610$ of the Black Star Society, \
    someone he knows well, and ask for the payment to be postponed until Raymon is found.\nBut if \
    $npcName:11000609$ goes down to the Land of Darkness himself, he will be dragged off before he can explain a \
    thing, so I'll go to the Land of Darkness in his place, meet $npcName:11000610$, and tell him about his sad \
    plight."
set quest[questID=90000370] complete "Go to $map:03000014$ in the Land of Darkness and meet $npc:11000610$"
set quest[questID=90000371] name "Dangerous Labor"
set quest[questID=90000371] desc "$npc:11000610$ flatly says the Black Star Society shows no mercy. How cold.\nAnd \
    hearing him say he will chase $npc:11000609$ to the ends of the earth and drag him back, they really are no \
    ordinary bad guys.\nLet's find $item:20000102$ in place of poor $npc:11000609$."
set quest[questID=90000371] manual "Pick $item:20000102$ from the Paduran poison herbs in $map:03000014$"
set quest[questID=90000371] complete "Meet $npc:11000610$ in $map:03000014$"
set quest[questID=90000372] name "Wandering Spirit"
set quest[questID=90000372] desc "$npc:11000610$ says this much won't wipe out the debt and demands something \
    harder. I am to defeat the beasts that glare with madness in the darkness of $map:03000014$ and come back with \
    $item:30000331$!\nThere seems to be no choice if I want to clear $npc:11000609$'s debt. \nLet's defeat the \
    monsters of $map:03000014$ and look for $item:30000331$!"
set quest[questID=90000372] manual "Defeat monsters in $map:03000014$ and find $item:30000331$"
set quest[questID=90000372] complete "Meet $npc:11000610$ in $map:03000014$"
set quest[questID=90000373] name "Breaking the Shackles"
set quest[questID=90000373] desc "At last $npc:11000610$ has cleared $npc:11000609$'s debt! I should hurry and \
    tell $npcName:11000609$ this happy news."
set quest[questID=90000373] complete "Meet $npc:11000609$ in $map:02000146$"
set quest[questID=90000390] name "A Confession of Conscience"
set quest[questID=90000390] desc "$npc:11000511$ in $map:02000203$ says he is looking for the person who lost a \
    large amount of $item:40100023$."
set quest[questID=90000400] name "The Dreaming Maid"
set quest[questID=90000400] desc "$npc:11000160$ in $map:02000001$ says Dreamnaze is giving out information about \
    maids as a job promotion event, and suggests I go see $npc:11000700$.\nThis looks like a chance to learn about \
    maids in detail."
set quest[questID=90000460] name "Shining Crystal"
set quest[questID=90000460] desc "$npcName:11001674$ says that to leave $map:02000100$ and work on a bigger stage, \
    I must grow stronger than I am now. It seems the boss also found the Ashen Wolf's skill lacking, and an order \
    came down to teach me how to grow stronger."
set quest[questID=90000470] name "How Does the Strong Grow Stronger?"
set quest[questID=90000470] desc "The boss still seems unsatisfied with the Ashen Wolf's skill. An order has come \
    down to teach me how to grow stronger."
set quest[questID=90000480] name "Shining Crystal"
set quest[questID=90000480] desc "$npc:11001716$ keeps stressing that even though we have come down from Wavelight \
    Mountain, we must never neglect our training. $npcName:11001707$ says it could be bad if I don't listen to my \
    senior's words, and offers to teach me how to grow stronger."
set quest[questID=90000490] name "How Does the Strong Grow Stronger?"
set quest[questID=90000490] desc "It seems $npc:11001716$ told $npc:11001707$ that if I grow stronger, I can \
    search for information, train, and find more clues to recover my memory. \n$npc:11001707$ is calling me, \
    saying he will teach me how to grow stronger."
set quest[questID=90000501] name "Temptation of the Bait"
set quest[questID=90000501] desc "$npc:11001861$, who sells fishing supplies in $map:52000058$, hands me some \
    $item:20000342$ bait as if doing me a favor and urges me to catch a Starcandy Crab.\n\nStarcandy Crabs can \
    only be caught with $item:20000342$ bait.\n$item:20000342$ bait can be bought in bulk from $npc:11001861$."
set quest[questID=90000501] manual "Use $item:20000342$ bait|Catch a Starcandy Crab with $item:20000342$ bait in \
    $map:63000044$"
set quest[questID=90000501] complete "Talk to $npc:11001861$ in $map:63000044$"
set quest[questID=90000510] name "The Angler's Way"
set quest[questID=90000510] desc "$npc:11001861$, who sells fishing supplies in $map:52000058$, says the water is \
    full of fish with the tide running high, and urges me to fish before the tide turns."
set quest[questID=90000510] manual "Catch fish in $map:63000044$"
set quest[questID=90000510] complete "Talk to $npc:11001861$ in $map:63000044$"
set quest[questID=90000511] name "The Art of Fishing"
set quest[questID=90000511] desc "$npc:11001861$, who sells fishing supplies in $map:52000058$, hands me a \
    $item:32000020$ as if doing me a favor and tells me to try its outstanding performance that an ordinary \
    fishing rod can't match."
set quest[questID=90000511] manual "Catch fish with the $item:32000020$ in $map:63000044$"
set quest[questID=90000511] complete "Talk to $npc:11001861$ in $map:63000044$"
set quest[questID=90000520] name "An Angler's Curiosity... "
set quest[questID=90000520] desc "$map:52000058$ has turned murky from an unknown source of \
    pollution!\n$npc:11001861$ says he wants to see the strange fish that have never been seen in it before, and \
    suggests we try fishing together."
set quest[questID=90000520] manual "Catch a strange fish in the polluted $map:52000058$"
set quest[questID=90000521] name "Mystery of the Sea of Fire"
set quest[questID=90000521] desc "The volcano exploded in an instant... \nThe true form of $map:52000058$ was a \
    volcano boiling up from deep in the sea. And... from the bubbling lava, some unidentified strange creature \
    leaps out...  "
set quest[questID=90000521] manual "Catch a strange fish in $map:52000059$, where lava is boiling"
set quest[questID=90000540] name "Melody at the Fingertips"
set quest[questID=90000540] desc "$npc:11001866$ in $map:52000060$ also suggests trying a new instrument."
set quest[questID=90000540] manual "Practice playing the guitar from sheet music in $map:52000060$"
set quest[questID=90000550] name "A Dreamlike Performance"
set quest[questID=90000550] desc "$npc:11001866$ was standing in $map:52000061$ with a flustered face, not knowing \
    what to do!\nIt's the day of the ensemble concert, but the pianist, who is practically the star, hasn't shown \
    up and hasn't even sent word... \nWe can't let the concert be delayed forever. \nLet's steady our nerves and \
    step onto the stage."
set quest[questID=90000550] manual "Perform the Moonlight Ensemble in $map:52000061$"
set quest[questID=90000620] name "Forest and Sea"
set quest[questID=90000620] desc "She says that because of the unusual geological structure of $map:63000046$, you \
    can mine $item:33000024$ from the forest, which is hard to find in $map:02000076$, and $item:33000025$ found \
    along the beach."
set quest[questID=90000620] manual "Mine $item:33000024$ in $map:63000046$|Mine $item:33000025$ in $map:63000046$"
set quest[questID=90000630] name "Requests Without End"
set quest[questID=90000630] desc "$npc:11001867$, whom I met in $map:63000046$, asks for help, saying she received \
    far too many jewelry orders at once and is hopelessly short of materials."
set quest[questID=90000630] manual "Mine $item:33000023$ in $map:63000046$"
set quest[questID=90000631] name "A Trick for Mining"
set quest[questID=90000631] desc "$npc:11001867$ grumbles that at this pace she can't make the delivery date she \
    promised, and that she could work much faster if she had $item:20000343$."
set quest[questID=90000632] name "Fluffy, Swaying Tail Fur"
set quest[questID=90000632] desc "$npc:11001870$, who was working in the barn, says all the $item:20000343$ is \
    gone, but they can be made."
set quest[questID=90000632] manual "Gather $item:33000041$ in the barn of $map:63000046$"
set quest[questID=90000633] name "Transformation of the Tail Fur"
set quest[questID=90000633] desc "$npc:11001870$ tells me to make $item:20000343$ myself from $item:33000041$."
set quest[questID=90000633] manual "Craft $item:20000343$"
set quest[questID=90000634] name "Lightning-Fast Mining"
set quest[questID=90000634] desc "$npc:11001867$ says another guild member happened to drop off a spare \
    $item:20000343$, and asks me to use the $item:20000343$ I made to finish helping gather the jewelry \
    materials."
set quest[questID=90000634] manual "Use $item:20000343$|Mine $item:33000023$ in $map:63000046$"
set quest[questID=90000691] name "Growing Up Fast"
set quest[questID=90000691] desc "$npc:11001877$ says the critters in the $item:50400159$ seem hungry and tells me \
    to feed them.\n\nGo near the [$item:50400159$] with the green cube, press the action key, and give them feed."
set quest[questID=90000691] manual "Feed the $item:50400159$ set up in my home"
set quest[questID=90000691] complete "Talk to $npc:11001877$ in my home"
set quest[questID=90000693] name "Flapping Chickens"
set quest[questID=90000693] desc "$npc:11001877$ says the feathers of the chickens in the $item:50400159$ are a \
    useful material for making cloth, and that some practice is needed to pluck them without damaging the \
    feathers.\n\nGo near the [$item:50400159$] with the green cube, press the action key, and harvest the \
    produce.\nPress the shortcut key [B] to switch to build mode, and install an additional [$item:50400159$] to \
    harvest produce faster."
set quest[questID=90000693] manual "Harvest $item:33000026$ from the $item:50400159$ set up in my home"
set quest[questID=90000693] complete "Talk to $npc:11001877$ in my home"
set quest[questID=90000700] name "A New Member of the Family"
set quest[questID=90000700] desc "$npc:11001877$ says I should try raising other livestock too, and gives me a \
    $item:50400160$.\n\nIn my home, press the shortcut key [B] to switch to build mode, search for \
    [$item:50400160$] among the livestock material items, and then continue the quest."
set quest[questID=90000700] manual "Install a $item:50400160$ in my home"
set quest[questID=90000700] complete "Talk to $npc:11001877$ in my home"
set quest[questID=90000710] name "The World of Livestock Skills"
set quest[questID=90000710] desc "$npc:11001877$ suggests making $item:20000350$ so that harvesting becomes much \
    easier, and hands me $item:33000001$, the material for it.\n\nOpen the [Life Skills > Crafting > Blacksmith] \
    window from the [Life] menu at the lower right and try crafting.\n\nIf you have no materials or too few, find \
    a copper ore vein in $map:02000002$ and mine it yourself.\n"
set quest[questID=90000710] manual "Craft $item:20000350$ from $item:33000001$"
set quest[questID=90000710] complete "Talk to $npc:11001877$ in my home"
set quest[questID=90000711] name "A New Technique in Livestock Farming"
set quest[questID=90000711] desc "$npc:11001877$ tells me to try the effect of $item:20000350$.\nUse \
    $item:20000350$ to harvest $item:33000027$.\n\nGo near the [$item:50400160$] with the green cube, press the \
    action key, and harvest the produce."
set quest[questID=90000711] manual "Use $item:20000350$|Harvest $item:33000027$ from the $item:50400160$ set up in \
    my home"
set quest[questID=90000711] complete "Talk to $npc:11001877$ in my home"
set quest[questID=90000740] name "A New Fragrance"
set quest[questID=90000740] desc "$npc:11003140$ in $map:63000052$ asks for help gathering $item:33000167$ and \
    $item:33000168$, which were thought extinct until a dried root was found by chance and cultivation succeeded."
set quest[questID=90000740] manual "Gather $item:33000167$ in $map:63000052$|Gather $item:33000168$ in \
    $map:63000052$"
set quest[questID=90000740] complete "Talk to $npc:11003140$ in $map:63000052$"
set quest[questID=90000750] name "The Alchemist's Order"
set quest[questID=90000750] desc "A mysterious $npc:11003143$ suddenly appeared in $map:63000052$!\nHe ordered a \
    large amount of $item:33000166$ to make medicine for the Guardians wounded in $map:02000146$, then vanished \
    like the wind.\nLeaving the checking of his identity to $npcName:11003140$, let's help the fairies and gather \
    $item:33000166$ in $map:63000052$."
set quest[questID=90000750] manual "Gather $item:33000166$ in $map:63000052$"
set quest[questID=90000750] complete "Talk to $npc:11003140$ in $map:63000052$"
set quest[questID=90000751] name "The Garden Cook"
set quest[questID=90000751] desc "$npc:11003140$ in $map:63000052$ tells me to bring $item:33000169$ to \
    $npcName:11003141$, who is cooking for the fairies on the garden hill, and pass along a request to make \
    $item:20000444$."
set quest[questID=90000751] manual "Pick $item:33000169$ in $map:63000052$"
set quest[questID=90000751] complete "Talk to $npc:11003141$ in $map:63000052$"
set quest[questID=90000752] name "Secret Recipe"
set quest[questID=90000752] desc "$npcTitle:11003141$, who is cooking for the fairies on the hill in \
    $map:63000052$, says he will share the recipe and tells me to make the $item:20000444$ that $npc:11003140$ \
    asked for myself."
set quest[questID=90000752] manual "Make $item:20000444$ from the $item:33000169$ picked in $map:63000052$"
set quest[questID=90000752] complete "Talk to $npc:11003140$ in $map:63000052$"
set quest[questID=90000753] name "Chewy Dried Persimmons"
set quest[questID=90000753] desc "$npc:11003140$ in $map:63000052$ tells me to eat $item:20000444$ and then gather \
    $item:33000166$.\n\nIf you run short of $item:33000169$, the cooking ingredient, you can get more from the \
    persimmon trees in $map:63000052$.\nYou can make more $item:20000444$ from the [Life Skills] menu at the lower \
    right."
set quest[questID=90000753] manual "Eat $item:20000444$|Gather $item:33000166$ in $map:63000052$"
set quest[questID=90000753] complete "Talk to $npc:11003140$ in $map:63000052$"
set quest[questID=90000761] name "Caring Hands"
set quest[questID=90000761] desc "One day, without any warning, a mysterious blond boy, $npcName:11003142$, showed \
    up at my house! \nHe tells me to fertilize the $item:50400191$ he gave me as a gift of friendship."
set quest[questID=90000761] manual "Fertilize the $item:50400191$ set up in my home"
set quest[questID=90000761] complete "Talk to $npc:11003142$ in my home"
set quest[questID=90000763] name "A Time of Plenty"
set quest[questID=90000763] desc "One day, without any warning, a mysterious blond boy, $npcName:11003142$, showed \
    up at my house! \nHe tells me to harvest $item:33000118$ from the $item:50400191$ he gave me as a gift of \
    friendship. "
set quest[questID=90000763] manual "Harvest $item:33000118$ from the $item:50400191$ set up in my home"
set quest[questID=90000763] complete "Talk to $npc:11003142$ in my home"
set quest[questID=90000770] name "Rolling in by the Vine"
set quest[questID=90000770] desc "The mysterious blond boy $npcName:11003142$ has come back as a friend! \nThis \
    time he gives me a $item:50400192$ as a gift of friendship and tells me to grow it."
set quest[questID=90000770] manual "Install a $item:50400192$ in my home"
set quest[questID=90000770] complete "Talk to $npc:11003142$ in my home"
set quest[questID=90000780] name "The Alchemist's Elixir"
set quest[questID=90000780] desc "A stranger who followed $npcName:11003142$ visited my home. \nHe introduces \
    himself as $npc:11003143$ and teaches me an alchemy recipe for brewing a potion that helps with \
    cultivation.\n\n$item:33000099$, the alchemy ingredient for $item:20000445$, can also be obtained through \
    gathering. "
set quest[questID=90000780] manual "Make $item:20000445$ using $item:33000099$ as the alchemy ingredient"
set quest[questID=90000780] complete "Talk to $npc:11003143$ in my home"
set quest[questID=90000781] name "Pumpkin Feast"
set quest[questID=90000781] desc "$npc:11003143$ tells me to eat $item:20000445$ and, while the nutrient effect \
    lasts, harvest the $item:33000120$ I am growing at home.\n\n$item:33000099$, the alchemy ingredient for \
    $item:20000445$, can also be obtained through gathering. \n"
set quest[questID=90000781] manual "Eat $item:20000445$|Harvest $item:33000120$ at my home"
set quest[questID=90000781] complete "Talk to $npc:11003142$ in my home"
set quest[questID=90000815] name "News from the Forge"
set quest[questID=90000815] desc "I heard from $npc:11000003$ in $map:02000001$ that $npc:11003416$ has found a \
    material for making stronger equipment.\\nLet's go to $npcName:11003416$ in $map:02000203$ and hear the \
    story."
set quest[questID=90000815] complete "Meet $npcName:11003416$ in $map:02000203$"
set quest[questID=90000816] name "A New Transcendent Power"
set quest[questID=90000816] desc "I heard from $npcName:11003416$ in $map:02000203$ that materials for making a \
    new Transcendence crystal drop in $dungeonTitle:29005001$.\\nWhile picking up the $item:30001025$ that \
    $npcName:11003416$ left in storage, let's go to $npc:11000327$ in $map:02000001$ and ask a bit more about \
    $dungeonTitle:29005001$ and $item:20001881$."
set quest[questID=90000816] complete "Talk to $npcName:11000327$ in $map:02000001$"
set quest[questID=92000000] name "Field Quest Dummy Quest"
set quest[questID=92000000] desc "Work planned"
set quest[questID=92000000] manual "Work planned"
set quest[questID=92000000] complete "Receive a radio call from $npcName:11003535$"
set quest[questID=92000020] name "A City Taken Over by Pigs"
set quest[questID=92000020] desc "$npcName:21000015$ have seized the roads and facilities of $map:02000147$ \
    without permission, crippling the city's functions and forcing all residents to flee.\n\nWe must wipe out the \
    $npcName:21000015$ in $map:02000147$ and restore order to the area."
set quest[questID=92000020] manual "Wipe out $npcName:21000015$"
set quest[questID=92000020] complete "Receive a radio call from $npcName:11003535$"
set quest[questID=92000040] name "Mighty Nose Blasts"
set quest[questID=92000040] desc "The $npcName:21000015$ that have rapidly multiplied in $map:02000148$, the main \
    producer of the crude oil supplied across Maple World, blow powerful snorts whenever they get angry, putting \
    out the fires of the oil drilling towers and wrecking the facilities.\n\nIf the supply of crude oil, a \
    precious natural resource, drops, it could badly affect all of Maple World.\n\nLet's help keep oil production \
    and supply running smoothly by driving off the $npcName:21000015$ that disrupt the drilling."
set quest[questID=92000040] manual "Wipe out $npcName:21000015$"
set quest[questID=92000040] complete "Receive a radio call from $npcName:11003535$"
set quest[questID=92000070] name "Stinky Mine Layers"
set quest[questID=92000070] desc "The $npcName:21000024$ are burying stinky mines anywhere along the roads of \
    $map:02000138$, and the pollution in $map:02000138$ is serious.\n\nAs the number of $npcName:21000024$ has \
    shot up lately, more residents are slipping on the stinky mines and getting hurt, and flies drawn by the smell \
    of the buried mines are ruining sanitation throughout the village.\n\nLet's help make the village clean again \
    by wiping out the $npcName:21000024$ from $map:02000138$."
set quest[questID=92000070] manual "Wipe out $npcName:21000024$"
set quest[questID=92000070] complete "Receive a radio call from $npcName:11003535$"
set quest[questID=92000130] name "Stopping the Pollution"
set quest[questID=92000130] desc "The Jellimes that recently appeared in $map:02000084$ ate polluted toxic waste \
    and have spread into other areas, and the pollutants they discharge are contaminating the surrounding land and \
    rivers.\n\nFor some reason, Jellimes that ate a lot of toxic waste have mutated and turned aggressive, \
    attacking the residents.\n\nLet's help stop the pollution from spreading to nearby areas and keep the \
    residents from harm by driving off the $npcName:21000387$ and $npcName:21000388$ that are increasing in \
    $map:02000084$."
set quest[questID=92000130] manual "Drive off $npcName:21000387$|Drive off $npcName:21000388$"
set quest[questID=92000130] complete "Receive a radio call from $npcName:11003535$"
set quest[questID=92000190] name "Spore-Infected Trees"
set quest[questID=92000190] desc "After the aerial raid on Tria, the $npcName:21000340$ affected by the power of \
    darkness spread malignant spores across $map:02000135$, and the $npcName:21000081$ and $npcName:21000082$ \
    infected by the spores have turned savage.\n\nLet's drive off the $npcName:21000340$ spreading the malignant \
    spores and the $npcName:21000081$ and $npcName:21000082$ that turned violent from the infection."
set quest[questID=92000190] manual "Drive off $npcName:21000340$|Drive off $npcName:21000081$|Drive off \
    $npcName:21000082$"
set quest[questID=92000190] complete "Receive a radio call from $npcName:11003535$"
set quest[questID=92000810] name "Horns Harder Than Stone"
set quest[questID=92000810] desc "$npcName:21000027$ are grinding their horns against the pillars of \
    $map:02000044$ to sharpen them, causing the pillars of the canyon to collapse in a great disaster.\n\nLet's \
    protect $map:02000044$ from collapsing by thinning out the $npcName:21000027$."
set quest[questID=92000810] manual "Drive off $npcName:21000027$\n"
set quest[questID=92000810] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000820] name "Untamed Wilds"
set quest[questID=92000820] desc "The $npcName:21000066$ and $npcName:21000064$ that were tamed and used in battle \
    escaped in great numbers after the aerial raid on Tria and are attacking adventurers visiting \
    $map:02000171$.\n\nLet's drive out the $npcName:21000066$ and $npcName:21000064$ and help keep the development \
    of $map:02000171$ going."
set quest[questID=92000820] manual "Drive off $npcName:21000066$|Drive off $npcName:21000064$"
set quest[questID=92000820] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000830] name "Lawless Land"
set quest[questID=92000830] desc "A man called $npcName:21000312$ appeared in $map:02000093$ and began picking \
    fights with the residents. Before long the $npcName:21000311$ and $npcName:21000310$ multiplied and took over \
    $map:02000093$.\n\nClaiming they will exert influence over all of Perion, they are plundering the residents of \
    $map:02000093$ and driving out adventurers to expand their power further.\n\nLet's defeat $npcName:21000312$ \
    and stop the Red Dragon Jawbreaker Gang's attempt to expand its power."
set quest[questID=92000830] manual "Drive off $npcName:21000312$"
set quest[questID=92000830] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000850] name "Beast Tamer"
set quest[questID=92000850] desc "It has been quite a while since the $npcName:21000066$ that scavenged through \
    trash and ate corpses began attacking adventurers, but the cause is unknown.\n\nIntelligence recently revealed \
    that the $npcName:21000334$ are taming the $npcName:21000066$ to be savage and attack the settlers in order to \
    obstruct the development of the region.\n\nLet's hunt down and drive out the $npcName:21000334$ in \
    $map:02000169$."
set quest[questID=92000850] manual "Hunt down $npcName:21000334$"
set quest[questID=92000850] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000860] name "The Enchanter"
set quest[questID=92000860] desc "$map:02000061$ has clean drinking water and could become the center of Perion's \
    development.\n\n$npcName:21000369$ use hypnosis to make animals less intelligent than themselves savage, \
    obstructing the development of the region.\n\nLet's hunt down the $npcName:21000369$, the root of the trouble \
    obstructing the development of $map:02000061$."
set quest[questID=92000860] manual "Hunt down $npcName:21000369$"
set quest[questID=92000860] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000870] name "Fang Breaker"
set quest[questID=92000870] desc "The $npcName:21000301$ have been increasing in number, holding the upper hand \
    over other animals with their powerful, sharp fangs.\n\nBecause of the growing numbers of $npcName:21000301$, \
    adventurers are often ambushed and badly wounded.\n\nEspecially in $map:02000133$, Perion's holy ground, many \
    adventurers and residents visit, so the number of people ambushed by the $npcName:21000301$ grows by the \
    day.\n\nWe must reduce the damage by hunting down the $npcName:21000301$ in $map:02000133$."
set quest[questID=92000870] manual "\nHunt down $npcName:21000301$"
set quest[questID=92000870] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000880] name "All This Water Is Mine!"
set quest[questID=92000880] desc "With the continuing dry season across all of Perion, water is shrinking \
    fast.\n\nIn this situation, the greedy $npcName:21000069$, which have a habit of storing water in their \
    bodies, have multiplied in great numbers and are sucking up even the groundwater of $map:02000049$ to store in \
    themselves. \n\nWhen developing a region, drinking water that can be supplied right there comes \
    first.\n\nLet's hunt down the $npcName:21000069$ hoarding the water and stop the water shortage from getting \
    worse."
set quest[questID=92000880] manual "Hunt down $npcName:21000069$"
set quest[questID=92000880] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000890] name "Wicked Sorcery"
set quest[questID=92000890] desc "Let's drive the $npcName:21000334$ out of $map:02000094$. They are the culprits \
    who approached the jawbreaker gang that studied martial arts and trained body and mind in $map:02000094$, \
    corrupted their minds, and made them attack good people. This will stop the damage from spreading any \
    further."
set quest[questID=92000890] manual "Take down $npcName:21000334$"
set quest[questID=92000890] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000910] name "Construction Saboteur"
set quest[questID=92000910] desc "The bone bridge laid for developing the Perion region kept breaking, and on \
    checking the cause, it turned out that when their hard bodies itch, the $npcName:21000267$ roll against the \
    bone bridge, \ncausing it to collapse.\n\nLet's hunt down the $npcName:21000267$ that disrupt construction in \
    $map:02000045$."
set quest[questID=92000910] manual "Hunt down $npcName:21000267$"
set quest[questID=92000910] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=92000920] name "Hands That Dig Out the Lava"
set quest[questID=92000920] desc "$map:02000046$, where lava of tremendous heat erupts, has a steady lava \
    temperature and is an ideal place to extract lava energy.\n\nTo go ahead with the development for lava energy \
    extraction, hunting down the $npcName:21000299$, who hold the area with sheer numbers, is essential.\n\nLet's \
    hunt down the $npcName:21000299$ so a lava energy extraction facility can be newly built in $map:02000046$. "
set quest[questID=92000920] manual "Hunt down $npcName:21000299$"
set quest[questID=92000920] complete "Receive a radio call from $npcName:11003534$"
set quest[questID=93000034] name "Judgment for Dundun"
set quest[questID=93000034] desc "A monster stained by darkness, $npcName:23000013$, is said to have been found in \
    $map:02000084$.\n$npcName:23000013$, born from exposure to industrial waste and sparks, loves anything flashy \
    and sparkling. For now it cannot get out of $map:02000084$, but if $npcName:23000013$ leaves this area and \
    starts collecting shiny things, Maple World will be in danger.\nLet's take it down before $npcName:23000013$ \
    moves around hunting for shiny things and spreads darkness."
set quest[questID=93000034] manual "Go to $map:02000084$ and defeat the monster stained by darkness, \
    $npcName:23000013$"
set quest[questID=93000034] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000034] descFameUI "Dundun, creature of darkness, bewitched by all that is flashy and \
    sparkling.\nBy the Knights' judgment, I command your banishment from this world."
set quest[questID=93000035] name "Forgive the Turtle Stained by Darkness"
set quest[questID=93000035] desc "The sacred beast Turtle, who came to protest the pollution of the sea, has been \
    stained by darkness.\nHe resists the erosion of darkness with all his strength, but his resistance cannot last \
    long.\nThe pollution that has begun cannot be stopped, but we can prevent the tragedy of him attacking the \
    residents and stop the power of darkness from spreading."
set quest[questID=93000035] manual "Go to $map:02000111$ and defeat $npcName:23000018$"
set quest[questID=93000035] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000035] descFameUI "God of Light, I will send this sacred beast of the sea to your side\nand \
    win back peace for this land and sea..."
set quest[questID=93000036] name "I Will Purge the Legion of Darkness with Light"
set quest[questID=93000036] desc "We still have no clear information about the Shadow Legion, \nbut judging from \
    the last invasion, there seem to be exceptionally strong warriors among them.\nTo weaken the forces of \
    darkness, we want to deal a heavy blow to their strength.\nThey say a monster with great power appears in \
    $map:02000115$. Could it belong to the Shadow Legion?"
set quest[questID=93000036] manual "Go to $map:02000115$ and defeat $npcName:23000001$"
set quest[questID=93000036] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000036] descFameUI "Black warrior who belongs to the Legion of Darkness,\nsoon your existence \
    shall be cast out of the world of light..."
set quest[questID=93000037] name "The End of the Fallen Wings"
set quest[questID=93000037] desc "$npcName:23000019$ and $npcName:23000020$, once a loving couple, had their egg \
    taken by foolish humans and became incarnations of hatred and vengeance.\nTheir darkened fury is so powerful \
    that even after being sealed, they keep creating more $npcName:23000019$ and $npcName:23000020$, and \
    $npcName:23000019$'s rage is said to be especially strong.\nWhile the Lumi Knights keep his power of darkness \
    from spreading, let's keep his vengeance from turning on good people. "
set quest[questID=93000037] manual "Go to $map:02000085$ and defeat $npcName:23000019$"
set quest[questID=93000037] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000037] descFameUI "God of Light, take up the fate of this griffon, whose life ended in \
    tragedy,\nsave the remaining light, and guide him to rest."
set quest[questID=93000038] name "There Is No Salvation for a Soulless Weapon"
set quest[questID=93000038] desc "$npcName:23000054$ is an early version of Dr. Katronic's Mark 52 Project, the \
    master of robot technology.\nDr. Katronic vanished after the Mark 52 Project failed, and who is building \
    $npcName:23000054$, and with what technology and equipment, is unknown.\nStrictly speaking, a robot not \
    stained by darkness is not the Lumi Knights' concern, but if we don't help, $npcName:11003537$ seems likely to \
    suffer something terrible at the hands of $npcName:11003535$, so let's destroy it quickly."
set quest[questID=93000038] manual "Go to $map:02000145$ and defeat $npcName:23000054$"
set quest[questID=93000038] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000038] descFameUI "The chance of salvation for a soul is eternal.\nBut there is no fair \
    judgment for a weapon that holds darkness."
set quest[questID=93000039] name "Judgment of Light at the End of That Mask"
set quest[questID=93000039] desc "The $npcName:22409035$ stained by darkness is luring Mumus and tormenting \
    people.\nIt seems the mask he wore to hide his appearance was cursed with dark sorcery. \nLet's save \
    $npcName:22409035$ before he falls completely into darkness, and win back the Mumus' freedom."
set quest[questID=93000039] manual "Go to $map:02000103$ and defeat $npcName:23000035$"
set quest[questID=93000039] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000039] descFameUI "Evil heart that wears the mask of darkness and turns its back on the \
    world,\nI shall now send a hand of salvation for you. "
set quest[questID=93000040] name "Darkness, Come Out of That Stone"
set quest[questID=93000040] desc "The $npcName:23000099$ in $map:02000021$ is said to have been stained by \
    darkness and fallen.\n$npcName:34000103$ is originally a good being and is not swayed by ordinary dark energy, \
    so something is suspicious. It seems someone is practicing to control $npcName:34000103$.\nWe can't tell who \
    is behind it yet, but for now let's defeat the $npcName:23000099$ stained by darkness."
set quest[questID=93000040] manual "Go to $map:02000021$ and defeat $npcName:23000099$"
set quest[questID=93000040] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000040] descFameUI "In the peaceful land of warriors, someone is playing with darkness \
    to\ncontrol the Vayars. We must cut the link between that person and the Vayars."
set quest[questID=93000041] name "Rest for the Hound of Hell"
set quest[questID=93000041] desc "The Cerberus tribe $npcName:23000047$, sealed because of their rough and \
    ferocious nature, has appeared.\nLet's defeat the $npcName:23000047$ stained by darkness."
set quest[questID=93000041] manual "Go to $map:02000214$ and defeat $npcName:23000047$"
set quest[questID=93000041] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000041] descFameUI "To the guardian of hell, born to a cursed duty,\nwe must give a chance to \
    serve the world of light through rebirth. "
set quest[questID=93000042] name "Brothers of Dark Power"
set quest[questID=93000042] desc "Monsters stained by darkness are appearing all over Maple World, but the most \
    threatening of them is the wicked Baphomet Brothers.\nThey hold a limitless power of darkness, and since they \
    keep reappearing no matter how often they are defeated, \nthey seem to share their dark power and revive each \
    other. \nIf left alone, they might create a second and third Land of Darkness with that power. \n"
set quest[questID=93000042] manual "Go to $map:02000260$ and defeat $npcName:23000026$"
set quest[questID=93000042] complete "Go to $map:02000422$ and talk to $npcName:11003537$"
set quest[questID=93000042] descFameUI "If the brothers of darkness join forces to threaten the world,\nwe have no \
    choice but to show equal strength."
set quest[questID=93000128] name "Maple Alliance Air Support"
set quest[questID=93000128] desc "The Sky Fortress has developed a new weapon to protect Maple World.\nThis weapon \
    provides fire support from the air to the ground, and when used, a powerful napalm shell is said to fall on \
    the ground.\nIt has passed its safety test, but its power has not yet been measured.\nLet's go down to the \
    ground and test the weapon."
set quest[questID=93000128] manual "Use $item:20000717$"
set quest[questID=93000128] complete "Go to $map:02000422$ and talk to $npcName:11003533$"
set quest[questID=93000128] descFameUI "Sky Fortress, ground force support equipment test mission issued.\nItem : \
    150mm Union Glide Cannon # Maple Alliance standard weapon"
set quest[questID=93000129] name "Lumi Knights Air Support"
set quest[questID=93000129] desc "The Sky Fortress has developed a new weapon to protect Maple World.\nThis weapon \
    provides fire support from the air to the ground, and when used, a laser cannon is said to fire at a specific \
    target.\nIt has passed its safety test, but its power has not yet been measured.\nLet's go down to the ground \
    and test the weapon."
set quest[questID=93000129] manual "Use $item:20000714$"
set quest[questID=93000129] complete "Go to $map:02000422$ and talk to $npcName:11003533$"
set quest[questID=93000129] descFameUI "Sky Fortress, ground force support equipment test mission issued.\nItem : \
    Arcane Storm # Lumi Knights local strike magic device"
set quest[questID=93000130] name "Dark Wind Air Support"
set quest[questID=93000130] desc "The Sky Fortress has developed a new weapon to protect Maple World.\nThis weapon \
    provides fire support from the air to the ground, and when used, a projectile that keeps attacking enemies is \
    said to fall on the ground.\nIt has passed its safety test, but its power has not yet been measured.\nLet's go \
    down to the ground and test the weapon."
set quest[questID=93000130] manual "Use $item:20000713$"
set quest[questID=93000130] complete "Go to $map:02000422$ and talk to $npcName:11003533$"
set quest[questID=93000130] descFameUI "Sky Fortress, ground force support equipment test mission issued.\nItem : \
    Shadow Grinder # Dark Wind stronghold suppression projectile"
set quest[questID=93000131] name "Tria Royal Guard Air Support"
set quest[questID=93000131] desc "The Sky Fortress has developed a new technology to protect Maple World.\nWhen \
    this item is used, a healing light that heals everyone shines down on a specific area for a set time.\nIt has \
    passed its safety test, but its power has not yet been measured.\nLet's go down to the ground and test the \
    item."
set quest[questID=93000131] manual "Use $item:20000715$"
set quest[questID=93000131] complete "Go to $map:02000422$ and talk to $npcName:11003533$"
set quest[questID=93000131] descFameUI "Sky Fortress, ground force support equipment test mission issued.\nItem : \
    Sanctuary Flare # Royal Guard emergency healing zone shell"
set quest[questID=93000132] name "Green Hood Vigilantes Air Support"
set quest[questID=93000132] desc "The Sky Fortress has developed a new technology to protect Maple World.\nWhen \
    this item is used, a buff that raises everyone's combat power is applied to a specific area.\nIt has passed \
    its safety test, but its power has not yet been measured.\nLet's go down to the ground and test the item."
set quest[questID=93000132] manual "Use $item:20000716$"
set quest[questID=93000132] complete "Go to $map:02000422$ and talk to $npcName:11003533$"
set quest[questID=93000132] descFameUI "Sky Fortress, ground force support equipment test mission issued.\nItem : \
    Nature's Call # Green Hood healing yeast generator "
set quest[questID=94000184] name "Gigantica of the Waste Landfill"
set quest[questID=94000184] desc "The $npcName:23001006$ found in $map:02020051$ is a fearsome monster that causes \
    earthquakes. It is a major obstacle to the expedition, destroying Green Hood facilities and polluting the \
    surrounding area.\n\nThe $npcName:23001006$, which moves underground, is also hard to find.\n\nLet's go to \
    $map:02020051$ and take down the $npcName:23001006$ to ease the Green Hood's worries."
set quest[questID=94000184] manual "Subdue $npcName:23001006$"
set quest[questID=94000184] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000184] descFameUI "They say the $npcName:23001006$ is causing earthquakes in $map:02020051$ \
    and team members are being injured one after another. Let's subdue it before the damage grows."
set quest[questID=94000187] name "Damage from Gigantica"
set quest[questID=94000187] desc "Big and small earthquakes across Kritias are injuring expedition members and \
    destroying expedition equipment.\n\nInvestigation found that the $npcName:23001006$ that appeared and settled \
    in $map:02020051$ is causing the earthquakes. The $npcName:23001006$ is so powerful that the expedition \
    members don't dare face it.\n\nThe $npcName:23001006$ is a very powerful monster. Facing the Gigantica alone \
    is reckless. Let's join forces with other adventurers and defeat the $npcName:23001006$."
set quest[questID=94000187] manual "Subdue $npcName:23001006$"
set quest[questID=94000187] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000187] descFameUI "They say the $npcName:23001006$ is causing earthquakes in $map:02020051$ \
    and team members are being injured one after another. Let's subdue it before the damage grows."
set quest[questID=94000198] name "Rampage of Gigantica"
set quest[questID=94000198] desc "The earthquakes the $npcName:23001006$ causes are damaging even the Sky \
    Fortress. We can't leave it like this.\n\nLet's go to $map:02020051$ and defeat the $npcName:23001006$."
set quest[questID=94000198] manual "Subdue $npcName:23001006$"
set quest[questID=94000198] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000198] descFameUI "They say the $npcName:23001006$ is causing earthquakes in the waste \
    landfill and team members are being injured one after another. Let's subdue it before the damage grows."
set quest[questID=94000201] name "Collecting Gigantica Combat Data"
set quest[questID=94000201] desc "The Green Hood is studying what the $npcName:23001006$ is doing in Kritias and \
    for what purpose. For that, combat data is needed.\n\nTo collect combat data, let's fight the \
    $npcName:23001006$ in $map:02020051$."
set quest[questID=94000201] manual "Subdue $npcName:23001006$"
set quest[questID=94000201] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000201] descFameUI "We must collect the $npcName:23001006$'s combat data to find out why it \
    came here and how it behaves."
set quest[questID=94000211] name "Figuring Out Gigantica's Attack Patterns"
set quest[questID=94000211] desc "A new attack pattern of the $npcName:23001006$ has been found. \
    $npcName:23001006$ seems to develop its own attack patterns. The $npcName:23001006$ seems to use far more \
    complex technology than we thought.\n\nTo collect more data, let's defeat the $npcName:23001006$ in \
    $map:02020051$."
set quest[questID=94000211] manual "Subdue $npcName:23001006$"
set quest[questID=94000211] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000211] descFameUI "Only by figuring out the $npcName:23001006$'s new attack patterns can we \
    predict its next attack. We must collect combat data by fighting the $npcName:23001006$."
set quest[questID=94000216] name "Analyzing Gigantica's AI Patterns"
set quest[questID=94000216] desc "We plan to analyze the $npcName:23001006$'s AI patterns, hack them, and find \
    weaknesses. \nFor that we must fight the $npcName:23001006$.\n\nLet's go to $map:02020051$ and fight the \
    $npcName:23001006$."
set quest[questID=94000216] manual "Subdue $npcName:23001006$"
set quest[questID=94000216] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000216] descFameUI "The research team says it is analyzing the $npcName:23001006$'s AI \
    patterns, hacking them, and finding weaknesses. To advance the research, we must collect the \
    $npcName:23001006$'s combat data."
set quest[questID=94000218] name "Analyzing Gigantica's Exoskeleton"
set quest[questID=94000218] desc "If we analyze the metal that makes up the $npcName:23001006$'s outer skeleton, \
    we can cause cracks with the Sky Fortress's sonic vibration cannon.\n\nLet's collect data to find the \
    molecular properties of the outer skeleton. Real combat is the best way to collect data.\n\nLet's go to \
    $map:02020051$ and fight the $npcName:23001006$."
set quest[questID=94000218] manual "Subdue $npcName:23001006$"
set quest[questID=94000218] complete "Go to $map:02020041$ and talk to $npcName:11004315$"
set quest[questID=94000218] descFameUI "If we find the sound waves that can vibrate the molecular structure of the \
    $npcName:23001006$'s exoskeleton, we might be able to cause cracks.\nTo do that, let's first fight it and \
    collect information about its exoskeleton."

