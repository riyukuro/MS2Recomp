set key[id=713172114003471] name "Tell <font color=\"#ffd200\">$npc:11000252[gender:0]$</font> in <font \
    color=\"#ffd200\">$map:02000100$</font> how you feel.\nIf your hearts connect, <font \
    color=\"#ffd200\">$item:30001182$</font> will appear as proof!\nTake $item:30001182$ to <font \
    color=\"#ffd200\">$npcName:11004101$</font> in <font color=\"#ffd200\">$map:63000062$</font>\nand you can buy \
    some fun items. Good luck!"
set key[id=713172114003472] name "Hm, a young one who came all the way here must have something important.\nWhat \
    is it?"
set key[id=713172114003473] name "I love you."
set key[id=713172114003474] name "(I can't bring myself to confess, so I lie and say I came for an interview.)"
set key[id=713172114003475] name "Nice words, but... what exactly do you love?\nMy money? My company? My honor? \
    Which is it?"
set key[id=713172114003476] name "I just like you, Chairman."
set key[id=713172114003477] name "I want money."
set key[id=713172114003478] name "You like me? Then you can do anything I tell you to, right? "
set key[id=713172114003479] name "I'm confident."
set key[id=713172114003480] name "Never mind. I'd like to cancel."
set key[id=713172114003481] name "Good! Then sing this era's masterpiece, <font color=\"#ffd200\">Praise \
    Goldus</font>. \nBig and strong!"
set key[id=713172114003482] name "My love, your love, Goldus~"
set key[id=713172114003483] name "Gol~ Gol~ Gol~dus"
set key[id=713172114003484] name "Yes~ Keep singing!"
set key[id=713172114003485] name "Don't spend your life sick and wheezing!"
set key[id=713172114003486] name "Can't live without Goldus~ Really can't live~"
set key[id=713172114003487] name "Good~ Good!"
set key[id=713172114003488] name "Let's live for the mighty hospital!"
set key[id=713172114003489] name "Let's live for mighty prosperity!"
set key[id=713172114003490] name "Let's live for mighty woof woof!"
set key[id=713172114003491] name "You've got the basics down. I like you, young one!"
set key[id=713172114003492] name "(Thank you.)"
set key[id=713172114003493] name "Showing up before me without knowing even one Praise Goldus!\nAre you out of \
    your mind? Want a scolding? Huh!"
set key[id=713172114003494] name "Please give me one more chance."
set key[id=713172114003495] name "This is petty, so forget it."
set key[id=713172114003496] name "At least you're honest. But you can't have money just because you want it. \nIf \
    you want to learn how to earn money, I can help you.\nNow then, shall we test whether you're qualified?"
set key[id=713172114003497] name "I'm confident."
set key[id=713172114003498] name "Never mind. I'd like to cancel."
set key[id=713172114003499] name "Then why on earth did you come here...?"
set key[id=713172114003500] name "(No choice... I go back to basics and confess my love again.)"
set key[id=713172114003501] name "<font color=\"#ffd200\">$npc:11000252[gender:0]$</font> pushes up his glasses \
    and grins.\nIt seems you've connected with him...!"
set key[id=713172114003502] name "Hello, $MyPCName$! \nHave you heard about the heartbreaking couple in \
    $map:63000062$?\nThe only way for them to meet is to wait for the <font color=\"#ffd200\">seventh moonlit \
    night</font>...\nTo make that amazing miracle happen, shall we fill this world with love?"
set key[id=713172114003503] name "A brave confession of love can sometimes create a miracle.\nWhy don't you try \
    being the star of that miracle, $MyPCName$?"
set key[id=713172114003504] name "That's a great idea!"
set key[id=713172114003505] name "No, thanks."
set key[id=713172114003506] name "Great! Right now, go to <font color=\"#ffd200\">$map:02000001$</font> and tell \
    <font color=\"#ffd200\">$npc:11000160[gender:1]$</font>\nhow you feel, and make a miracle happen.\nIf your \
    hearts connect, <font color=\"#ffd200\">$item:30001182$</font> will appear as proof!"
set key[id=713172114003507] name "Take <font color=\"#ffd200\">$item:30001182$</font> to $npc:11004101$ in \
    $map:63000062$,\nand you should be able to buy some fun items.\nGood luck, $MyPCName$!"
