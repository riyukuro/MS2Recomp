set key[id=22004001] tooltipDescription "A Christmas special capsule. Use it to get one of the various items in \
    the capsule machine."
set key[id=22004001] guideDescription "Double-click it in your inventory to use it.\\n\\n<font \
    color='#FFFFFF'>Main items you can get</font>\\n<font color='#FFFFFF'> - </font><font color='#FFD533'>Winter \
    Tale Snowflake Skin</font>\\n<font color='#FFFFFF'> - </font><font color='#FFD533'>Audrey Tutu \
    Skin</font>\\n<font color='#FFFFFF'> - </font><font color='#FFD533'>Olympus Skin</font>\\n<font \
    color='#FFFFFF'> - </font><font color='#C888FF'>2-Player Action Pass: First Snow Day</font>\\n<font \
    color='#FFFFFF'> - </font><font color='#C888FF'>Couple Effect Badge Set: Mistletoe Kiss</font>\\n<font \
    color='#FFFFFF'> - </font><font color='#C888FF'>Effect Badge: Rudolph</font>\\n<font color='#FFFFFF'> - \
    </font><font color='#45D1FF'>Damage Font Badge: Snowflake</font>\\n<font color='#FFFFFF'> - </font><font \
    color='#45D1FF'>Tombstone Badge: Cookie House</font>\\n<font color='#FFFFFF'> - </font><font \
