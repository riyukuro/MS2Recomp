set quest[questID=80000520] name "Become a Dancing Hero"
set quest[questID=80000520] desc "The mysterious magpie who gathers love, $npc:11004101$, promised a big reward of \
    $item:30001182$ for completing a special mission.\n\nThis week's weekly mission is to join the dance \
    party!!\nJoin the Love Dance Party 10 times in $map:63000062$."
set quest[questID=80000520] manual "Join the Love Dance Party in $map:63000062$"
set quest[questID=80000520] complete "Talk to $npc:11004101$ in $map:63000062$"
set quest[questID=80000521] name "Reel in Fish, Reel in Love"
set quest[questID=80000521] desc "The mysterious magpie who gathers love, $npc:11004101$, promised a big reward of \
    $item:30001182$ for completing a special mission.\n\nThis week's weekly mission is fishing!\nThe fish of the \
    Milky Way Garden are said to be happy and plump from feasting on the love that overflows when the moonlight is \
    filled with it.\nGo fishing in the Milky Way Garden and see the happy fish for yourself."
set quest[questID=80000521] manual "Catch a whopper in $map:63000062$|Catch a Zappy Heart Ray in \
    $map:63000062$|Catch a Flower Path Axolotl in $map:63000062$"
set quest[questID=80000521] complete "Talk to $npc:11004101$ in $map:63000062$"
set quest[questID=80000522] name "Lose Yourself in the Melody of Love"
set quest[questID=80000522] desc "The mysterious magpie who gathers love, $npc:11004101$, promised a big reward of \
    $item:30001182$ for completing a special mission.\n\nThis week's weekly mission is music!\nPlay instruments to \
    your heart's content so the energy of love flowing through the Milky Way Garden can flow even more freely."
set quest[questID=80000522] manual "Play an instrument in $map:63000062$|Play with party members in \
    $map:63000062$"
set quest[questID=80000522] complete "Talk to $npc:11004101$ in $map:63000062$"
set quest[questID=80000523] name "That Special Day, Love Signal"
set quest[questID=80000523] desc "The mysterious magpie who gathers love, $npc:11004101$, promised a big reward of \
    $item:30001182$ for completing a special mission.\n\nThis week's weekly mission is finding someone!\nFind a \
    character wearing $item:11401061$ and meet them."
set quest[questID=80000523] manual "Find a character wearing $item:11401061$"
set quest[questID=80000523] complete "Talk to $npc:11004101$ in $map:63000062$"
set quest[questID=80000530] name "A Beautiful Night! Dance Together"
set quest[questID=80000530] desc "The Island of Love has finally opened! The mysterious crow who lives there, \
    $npc:11004102$, says a special gift is being prepared for those who made the miracle of love happen.\nWhile \
    the gift is being prepared, join the Love Dance Party and come back."
set quest[questID=80000530] manual "Join the Love Dance Party in $map:63000062$"
set quest[questID=80000530] complete "Talk to $npc:11004102$ in $map:63000062$"
