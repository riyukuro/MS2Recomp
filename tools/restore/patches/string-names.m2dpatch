set key[id=810164114002938] name "$MyPCName$! \nTake on the Barbosa weekly mission!\nThe Barbosa weekly mission \
    can be completed only once a week, and when you finish it \nI'll give you 30 <font \
    color=\"#ffd200\">$item:30000881$</font> as a reward!"
set key[id=810164114002939] name "The Barbosa weekly mission is\n<font color=\"#ffd200\">to defeat 5 field bosses \
    or adventure dungeon bosses and complete today's mission 10 times</font>!\nComplete the mission and be sure to \
    collect your <font color=\"#ffd200\">$item:30000881$</font>!"
set key[id=810164114002940] name "The Barbosa weekly mission is\n<font color=\"#ffd200\">to defeat 5 field bosses \
    or adventure dungeon bosses and complete today's mission 10 times</font>!\nComplete the mission and be sure to \
    collect your <font color=\"#ffd200\">$item:30000881$</font>!"
set key[id=810164114002941] name "You cleared this week's Barbosa weekly mission!\nHere are the 30 <font \
    color=\"#ffd200\">$item:30000881$</font> I promised.\nA weekly mission that gives you 30 <font \
    color=\"#ffd200\">$item:30000881$</font> at once! \nIf you're aiming for a high-tier key, you can't afford to \
    miss the weekly mission, right?"
set key[id=902202014001136] name "$MyPCName$, it's terrible! \nUndead rabbit monsters in <font \
    color=\"#ffd200\">$map:02000280$</font> attacked a wagon carrying chewy maple rice cakes,\nand the villagers \
    preparing for the Harvest Festival are in a panic."
set key[id=902202014001137] name "Worst of all, they've contaminated those chewy, delicious maple rice cakes, so \
    adventurers who've been to $map:02000280$\nhave fallen ill and it's chaos. "
set key[id=902202014001138] name "Please, $MyPCName$, go to <font color=\"#ffd200\">$map:02000280$</font>, punish \
    the <font color=\"#ffd200\">$npcName:21090187$, $npcName:21090188$, $npcName:21090189$</font>\nthat \
    contaminated the maple rice cakes, and bring back <font color=\"#ffd200\">$item:20000335$</font>\nso no more \
    adventurers get sick.\nPlease. "
set key[id=902202014001139] name "Please, $MyPCName$, go to <font color=\"#ffd200\">$map:02000280$</font>, punish \
    the <font color=\"#ffd200\">$npcName:21090187$, $npcName:21090188$, $npcName:21090189$</font>\nthat \
    contaminated the maple rice cakes, and bring back <font color=\"#ffd200\">$item:20000335$</font>\nso no more \
    adventurers get sick.\nPlease. "
set key[id=902202014001140] name "Wow! You recovered this many! \nI'm so glad I asked you, $MyPCName$.\nYou're the \
    best!"
