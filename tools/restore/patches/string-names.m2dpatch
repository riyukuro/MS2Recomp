set key[id=1219125317003033] name "Merry Christmas, $MyPCName$!\nFor the merry Christmas season, they say Papa \
    Santa has planted a special \nChristmas tree somewhere in Maple World."
set key[id=1219125317003034] name "Where can I find the special Christmas tree?"
set key[id=1219125317003035] name "Open the <font color=\"#ffd200\">Meret Market</font> and go to the <font \
    color=\"#ffd200\">Special Sale</font> tab, and you can buy <font color=\"#ffd200\">Papa Santa's Christmas \
    Tree</font> for free.\nUse that item and you can enter the place where <font \
    color=\"#ffd200\">$map:80000011$</font> is!"
set key[id=1219125317003036] name "Oops... In the <font color=\"#ffd200\">Special Sale</font> tab, you can buy the \
    <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> up to 3 times a day per account.\nAnd when other \
    friends use their <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> to move to where <font \
    color=\"#ffd200\">$map:80000011$</font> is, you can come along with them too."
set key[id=1219125317003037] name "Now enjoy a merry and happy Christmas season \nwith Papa Santa's special \
    Christmas tree!"
set key[id=1219125317003038] name "Open the <font color=\"#ffd200\">Meret Market</font> and go to the <font \
    color=\"#ffd200\">Special Sale</font> tab, and you can buy <font color=\"#ffd200\">Papa Santa's Christmas \
    Tree</font> for free.\nUse that item and you can enter the place where <font \
    color=\"#ffd200\">$map:80000011$</font> is!"
set key[id=1219125317003039] name "Oops... In the <font color=\"#ffd200\">Special Sale</font> tab, you can buy the \
    <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> up to 3 times a day per account.\nAnd when other \
    friends use their <font color=\"#ffd200\">Papa Santa's Christmas Tree</font> to move to where <font \
    color=\"#ffd200\">$map:80000011$</font> is, you can come along with them too."
set key[id=1219125317003040] name "You found Papa Santa's special Christmas tree!\nUntil the Christmas season \
    ends, diligently collect $item:20301210$ and get special Christmas gifts!"
set key[id=1219205414002970] name "Welcome, $MyPCName$!\nHave you heard that a huge number of treasure chests were \
