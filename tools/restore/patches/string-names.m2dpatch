set quest[questID=90000110] desc "$npc:11000045$, the Ranger job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000120] name "Shining Crystal"
set quest[questID=90000120] desc "$npc:11000046$, the Heavy Gunner job-change instructor, says he will teach me \
    how to grow stronger.\n"
set quest[questID=90000130] name "Shining Crystal"
set quest[questID=90000130] desc "$npc:11000050$, the Thief job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000140] name "Shining Crystal"
set quest[questID=90000140] desc "$npc:11000051$, the Assassin job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000180] name "Pollen Allergy"
set quest[questID=90000180] desc "They say $item:30000125$ works wonders on a pollen allergy, but $npc:11000408$ \
    can't even collect the honey because of his allergy. I'd better help the old man before I go.\nLet's hurry and \
    pick $item:30000125$ from the wildflowers."
set quest[questID=90000190] name "Help!"
set quest[questID=90000190] desc "The path here has become dangerous because of $npc:99000041$. Let's help \
    $npc:11000409$ and defeat the $npc:99000041$."
set quest[questID=90000191] name "Safe Passage"
set quest[questID=90000191] desc "$npc:11000409$ is worried about $npc:11000410$, who is all alone. Let's hurry \
    through the portal to $map:63000010$ and find where $npc:11000410$ is."
set quest[questID=90000192] name "We Have to Stop the Pigs"
set quest[questID=90000192] desc "$npc:11000410$ is working hard to make the path safe. Let's hurry and help \
    $npc:11000410$ defeat the $npc:99000042$. Using skills should make it even easier to defeat them!"
set quest[questID=90000200] name "How Does the Strong Grow Stronger?"
set quest[questID=90000200] desc "$npc:11000040$, the Knight job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000210] name "How Does the Strong Grow Stronger?"
set quest[questID=90000210] desc "$npc:11000041$, the Berserker job-change instructor, says he will teach me how \
    to grow stronger.\n"
set quest[questID=90000220] name "How Does the Strong Grow Stronger?"
set quest[questID=90000220] desc "$npc:11000042$, the Wizard job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000230] name "How Does the Strong Grow Stronger?"
set quest[questID=90000230] desc "$npc:11000043$, the Priest job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000240] name "How Does the Strong Grow Stronger?"
set quest[questID=90000240] desc "$npc:11000045$, the Ranger job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000250] name "How Does the Strong Grow Stronger?"
set quest[questID=90000250] desc "$npc:11000046$, the Heavy Gunner job-change instructor, says he will teach me \
    how to grow stronger.\n"
set quest[questID=90000260] name "How Does the Strong Grow Stronger?"
set quest[questID=90000260] desc "$npc:11000050$, the Thief job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000270] name "How Does the Strong Grow Stronger?"
set quest[questID=90000270] desc "$npc:11000051$, the Assassin job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000280] name "Whirlwind Swordplay"
set quest[questID=90000280] desc "Open the skill window, equip the newly learned skill $skill:10100011$ to a quick \
    slot, then use $skill:10100011$."
set quest[questID=90000280] manual "Use Tornado Slash"
set quest[questID=90000281] name "Blade Through the Air"
set quest[questID=90000281] desc "Open the skill window, equip the newly learned skill $skill:10100001$ to a quick \
    slot, then use $skill:10100001$."
set quest[questID=90000281] manual "Use $skill:10100001$"
set quest[questID=90000290] name "Sweep Them All Away"
set quest[questID=90000290] desc "Open the skill window, equip the newly learned skill $skill:10200011$ to a quick \
    slot, then use $skill:10200011$."
set quest[questID=90000290] manual "Use $skill:10200011$"
