set key[id=11500918] tooltipDescription "<font color='#ff8ae5' size='14'>[Acceleration Enhancement]\\nThe \
    Acceleration effect is doubled.\\n\\n[Resonance with Red Lapenshard]\\nGrants immunity to Ishura's curse \
    effect in Terminus Ends. This effect activates only when both Acceleration and Acceleration Enhancement are \
    active.</font>"
set key[id=11500918] guideDescription "\\n<font color='#7A7A7A'>Unidentified gear pulled into the Maple World \
    along with a time rift of unknown cause. According to the analysis of the time traveler Endy, this gear exists \
    in the same phase on the past, present and future time axes, and because of this its appearance is formed to \
    match the current level of understanding. Of course, no one in the entire Maple World could understand this \
    analysis exactly, but the parts of the report that sounded good were that the gear performs extremely well, is \
    light and sturdy, and that the energy waves peculiar to outer-space material keep the time axis from \
    shifting.</font>"
set key[id=11500919] tooltipDescription "<font color='#ff8ae5' size='14'>[Acceleration Enhancement]\\nThe \
    Acceleration effect is doubled.\\n\\n[Resonance with Red Lapenshard]\\nGrants immunity to Ishura's curse \
    effect in Terminus Ends. This effect activates only when both Acceleration and Acceleration Enhancement are \
    active.</font>"
