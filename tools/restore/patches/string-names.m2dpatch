set key[id=316160602004946] name "Phew... It's another hectic day... When will the war with the darkness ever \
    end...\nIf you have time, would you lend a hand to us Guardians here?"
set key[id=316160602004947] name "Phew... It's another hectic day... When will the war with the darkness ever \
    end...\nIf you have time, would you lend a hand to us Guardians here?"
set key[id=316160602004948] name "Whew... I don't even have time to catch my breath... "
