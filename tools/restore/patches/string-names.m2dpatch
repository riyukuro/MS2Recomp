set key[id=315202702004920] name "Oh! $MyPCName$!\n$npc:11000169[gender:0]$ was looking for you... Go see him."
set key[id=315202702004921] name "Oh! $MyPCName$! You came at just the right time.\nI have something to tell you."
set key[id=315202702004922] name "Oh! $MyPCName$!\n$npc:11000119[gender:0]$ was looking for you... Go see him."
set key[id=315202702004923] name "Oh! $MyPCName$!\n$npc:11000119[gender:0]$ was looking for you... Go see him."
