set key[id=212201214002127] name "You gathered this much info!\nYou really are the best, $MyPCName$! "
set key[id=213004414002476] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002477] name "I heard a bear won the vote for the girl people most want chocolate from!\nThey \
    said she's a gentle girl, but her beast instincts can't settle down easily...\nCould you go see if <font \
    color=\"#ffd200\">$npc:22000022$</font> in <font color=\"#ffd200\">$map:02000117$</font> is running wild?\nFor \
    you, who cherish memories, I'll give a sp-e-cial gift! A Number One Coin."
set key[id=213004414002478] name "I heard a bear won the vote for the girl people most want chocolate from!\nThey \
    said she's a gentle girl, but her beast instincts can't settle down easily...\nCould you go see if <font \
    color=\"#ffd200\">$npc:22000022$</font> in <font color=\"#ffd200\">$map:02000117$</font> is running wild?\nFor \
    you, who cherish memories, I'll give a sp-e-cial gift! A Number One Coin."
set key[id=213004414002479] name "Oh, you're back! \n$npc:22000022$... how was she? "
set key[id=213004414002480] name "It was running wild, so I gave it a bonk on the head."
set key[id=213004414002481] name "Its cry was very charming."
set key[id=213004414002482] name "I knew it! She definitely only put on a <font color=\"#ffd200\">pretty \
    act</font> for the photo!\nThank you for the news, $MyPCName$!"
set key[id=213004414002483] name "Its cry? Roaaaar...! Th-this? \nWhat unique taste you have... well, I'll respect \
    it! "
set key[id=213004414002484] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002485] name "Remember the super popular guy adventurers picked as <font color=\"#ffd200\">the \
    man they most want candy from</font>?\nThat guy with the charming poker face... What is he up to now?\nIf you \
    meet <font color=\"#ffd200\">$npc:11000617[gender:0]$</font> in <font \
    color=\"#ffd200\">$map:02000118$</font>,\nI'll give a sp-e-cial gift to you, who cherish memories! A Number \
    One Coin."
set key[id=213004414002486] name "Remember the super popular guy adventurers picked as <font color=\"#ffd200\">the \
    man they most want candy from</font>?\nThat guy with the charming poker face... What is he up to now?\nIf you \
    meet <font color=\"#ffd200\">$npc:11000617[gender:0]$</font> in <font \
    color=\"#ffd200\">$map:02000118$</font>,\nI'll give a sp-e-cial gift to you, who cherish memories! A Number \
    One Coin."
set key[id=213004414002487] name "Oh, you're back! \n$npc:11000617[gender:0]$... was he still charming? "
set key[id=213004414002488] name "He was still hesitating."
set key[id=213004414002489] name "He really seems to be the best-looking man in the world."
set key[id=213004414002490] name "Oh my... I knew it. Always the same. So cool...!\nThank you for the news, \
    $MyPCName$!"
set key[id=213004414002491] name "Ohoho, you're joking...! There are so many handsome men in the world...! \nOops, \
    keep it a secret from $npc:11000617[gender:0]$! "
set key[id=213004414002492] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002493] name "Do you know <font color=\"#ffd200\">$npc:11000076[gender:0]$</font>, the right \
    hand of Empress $npcName:11000075[gender:1]$?\nHe carries out the Empress's orders in $map:02000146$. He's \
    really popular for his warm good looks...\nCould you meet the dashing $npc:11000076[gender:0]$ in <font \
    color=\"#ffd200\">$map:02000146$</font>\nand pass on my greetings? I'll give you a Number One Coin in return."
set key[id=213004414002494] name "Do you know <font color=\"#ffd200\">$npc:11000076[gender:0]$</font>, the right \
    hand of Empress $npcName:11000075[gender:1]$?\nHe carries out the Empress's orders in $map:02000146$. He's \
    really popular for his warm good looks...\nCould you meet the dashing $npc:11000076[gender:0]$ in <font \
    color=\"#ffd200\">$map:02000146$</font>\nand pass on my greetings? I'll give you a Number One Coin in return."
set key[id=213004414002495] name "Oh, you're back! \n$npc:11000076[gender:0]$... does he look healthy? "
set key[id=213004414002496] name "Why are you so shy about it?"
set key[id=213004414002497] name "He really has the warm good looks you described."
set key[id=213004414002498] name "Hehe, I don't know either. Just thinking about him makes me happy for no \
    reason~\nThank you for the news, $MyPCName$!"
set key[id=213004414002499] name "Right? You think so too, $MyPCName$? \nI think $npcName:11000076[gender:0]$ is \
    the best-looking, but my brother says no...\nOh! Keep this a <font color=\"#ffd200\">secret</font> from my \
    brother and $npcName:11000076[gender:0]$!"
set key[id=213004414002500] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002501] name "I heard there's a chic, cold-mannered guy on Carcar Island!\nA cool city guy in \
    neat clothes... I really like that type. \nPlease go meet <font \
    color=\"#ffd200\">$npc:11001374[gender:0]$</font> in <font color=\"#ffd200\">$map:02010016$</font>.\nIf you do \
    me this favor, I'll give you a Number One Coin as a gift."
set key[id=213004414002502] name "I heard there's a chic, cold-mannered guy on Carcar Island!\nA cool city guy in \
    neat clothes... I really like that type. \nPlease go meet <font \
    color=\"#ffd200\">$npc:11001374[gender:0]$</font> in <font color=\"#ffd200\">$map:02010016$</font>.\nIf you do \
    me this favor, I'll give you a Number One Coin as a gift."
set key[id=213004414002503] name "Oh, you're back! \nSo, is $npc:11001374[gender:0]$... as handsome as the rumors \
    say? "
set key[id=213004414002504] name "He's really handsome. I bet he can rap, too."
set key[id=213004414002505] name "He's handsome, but I think I'm better looking."
set key[id=213004414002506] name "$MyPCName$... I sometimes think you're a little unusual....\nA-anyway, thank you \
    for bringing me the news. "
set key[id=213004414002507] name "Oh.......\nYes. Thank you. "
set key[id=213004414002508] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002509] name "Do you know <font color=\"#ffd200\">$npc:11000514[gender:1]$</font>, the ruler \
    of $map:02000124$?\nI hear her charisma is off the charts, but I haven't met her yet. \nCould you meet \
    $npc:11000514[gender:1]$ in <font color=\"#ffd200\">$map:02000124$</font> and tell me how\nscary she is? I'll \
    give you a Number One Coin as a gift."
set key[id=213004414002510] name "Do you know <font color=\"#ffd200\">$npc:11000514[gender:1]$</font>, the ruler \
    of $map:02000124$?\nI hear her charisma is off the charts, but I haven't met her yet. \nCould you meet \
    $npc:11000514[gender:1]$ in <font color=\"#ffd200\">$map:02000124$</font> and tell me how\nscary she is? I'll \
    give you a Number One Coin as a gift."
set key[id=213004414002511] name "Oh, you're back! \n$npc:11000514[gender:1]$... Did you meet her? How was it?"
set key[id=213004414002512] name "She's really scary. Never meet her."
set key[id=213004414002513] name "She's not scary at all. You could even talk to her casually."
set key[id=213004414002514] name "Ugh... I knew it. I'll have to be careful...!\nThanks for telling me, \
    $MyPCName$!"
set key[id=213004414002515] name "Really...? Then I'll do just that, trusting only you, $MyPCName$!\nThank you! "
set key[id=213004414002516] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002517] name "If you go to <font color=\"#ffd200\">$map:02000216$</font>, there's a dazzlingly \
    beautiful woman up high.\nThat aloof lady is rumored to be connected to the Black Star Society. Is that \
    true?\nCould you meet <font color=\"#ffd200\">$npc:11000515[gender:1]$</font> in $map:02000216$ and ask \
    her?\nIf you do me this favor, I'll give you a Number One Coin as a gift!"
set key[id=213004414002518] name "If you go to <font color=\"#ffd200\">$map:02000216$</font>, there's a dazzlingly \
    beautiful woman up high.\nThat aloof lady is rumored to be connected to the <font color=\"#ffd200\">Black Star \
    Society</font>. Is that true?\nCould you meet <font color=\"#ffd200\">$npc:11000515[gender:1]$</font> in \
    $map:02000216$ and ask her?\nIf you do me this favor, I'll give you a Number One Coin as a gift!"
set key[id=213004414002519] name "Oh, you're back! \nIs <font color=\"#ffd200\">$npc:11000515[gender:1]$</font> \
    really connected to the <font color=\"#ffd200\">Black Star Society</font>?"
set key[id=213004414002520] name "I think there's definitely a connection."
set key[id=213004414002521] name "I think I should join the Black Star Society."
set key[id=213004414002522] name "Wow... I knew it! A woman with dangerous beauty, fatally charming...! \nThanks \
    for telling me, $MyPCName$!"
set key[id=213004414002523] name "If you ever get hold of a membership application, please share the info with me, \
    too. \nOh, and keep it a secret from my brother! "
set key[id=213004414002524] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002525] name "If you go to <font color=\"#ffd200\">$map:02000064$</font>, there are Bunny Gals \
    who belong to the Bunny Bunny Gang.\nAmong them is a lively girl who calls herself the mascot. \nMeet <font \
    color=\"#ffd200\">$npc:11000711[gender:1]$</font> in $map:02000064$ and feel her vitamin-like charm.\nFor you, \
    fully recharged, I'll give a sp-e-cial gift! A Number One Coin."
set key[id=213004414002526] name "If you go to <font color=\"#ffd200\">$map:02000064$</font>, there are Bunny Gals \
    who belong to the Bunny Bunny Gang.\nAmong them is a lively girl who calls herself the mascot. \nMeet <font \
    color=\"#ffd200\">$npc:11000711[gender:1]$</font> in $map:02000064$ and feel her vitamin-like charm.\nFor you, \
    fully recharged, I'll give a sp-e-cial gift! A Number One Coin."
set key[id=213004414002527] name "Oh, you're back! \n$npc:11000711[gender:1]$ is such a charming girl, isn't she?"
set key[id=213004414002528] name "She was so bright and lively that just looking at her made me happy."
set key[id=213004414002529] name "She's so bright I can't keep up."
set key[id=213004414002530] name "Right? She's a friend I'd really like to learn from! \nThank you for going all \
    that way, $MyPCName$!"
set key[id=213004414002531] name "Oh, come on. So many people find joy thanks to the lively, upbeat <font \
    color=\"#ffd200\">Bunny Bunny Gang</font>. \nPlease be kind to our <font \
    color=\"#ffd200\">$npc:11000711[gender:1]$</font>, too, $MyPCName$! "
set key[id=213004414002532] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002533] name "Have you ever been to <font color=\"#ffd200\">$map:02000076$</font>? It's such a \
    peaceful, beautiful town,\nguarded by the vigilantes led by the brave and thoughtful <font \
    color=\"#ffd200\">$npcName:11000015[gender:1]$</font>.\nWould you meet <font \
    color=\"#ffd200\">$npc:11000015[gender:1]$</font> in $map:02000076$ and ask the secret to her beauty?\nI'll \
    give you a Number One Coin as a gift."
set key[id=213004414002534] name "Have you ever been to <font color=\"#ffd200\">$map:02000076$</font>? It's such a \
    peaceful, beautiful town,\nguarded by the Green Hood vigilantes led by the brave and thoughtful <font \
    color=\"#ffd200\">$npcName:11000015[gender:1]$</font>.\nWould you meet <font \
    color=\"#ffd200\">$npc:11000015[gender:1]$</font> in $map:02000076$ and ask the secret to her beauty?\nI'll \
    give you a Number One Coin as a gift."
set key[id=213004414002535] name "You're back, $MyPCName$!\nWhat is $npc:11000015[gender:1]$'s secret to beauty?"
set key[id=213004414002536] name "She didn't seem to want to tell me."
set key[id=213004414002537] name "I think I'm prettier, so ask me instead."
set key[id=213004414002538] name "Well, beauty is something you're born with. She probably had nothing to \
    say.\nThank you for going, $MyPCName$!"
set key[id=213004414002539] name "$MyPCName$...\nNext time we hold an event with a <font \
    color=\"#ffd200\">mirror</font> as a prize, I'll be sure to call you. Cheer up."
set key[id=213004414002540] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002541] name "If you ask who the prettiest man on Victoria Island is,\nmany people answer \
    <font color=\"#ffd200\">$npc:11000406[gender:0]$</font>. \nI hear there's a $npc:11000406[gender:0]$ fan \
    meeting in <font color=\"#ffd200\">$map:02000137$</font>. Want to go?\nBring me back an autograph and I'll \
    give you a Number One Coin as a gift."
set key[id=213004414002542] name "If you ask who the prettiest man on Victoria Island is,\nmany people answer \
    <font color=\"#ffd200\">$npc:11000406[gender:0]$</font>. \nI hear there's a $npc:11000406[gender:0]$ fan \
    meeting in <font color=\"#ffd200\">$map:02000137$</font>. Want to go?\nBring me back an autograph and I'll \
    give you a Number One Coin as a gift."
set key[id=213004414002543] name "Oh, you're back! \nDid you get <font \
    color=\"#ffd200\">$npc:11000406[gender:0]$</font>'s autograph?"
set key[id=213004414002544] name "I couldn't get one because I didn't bring a pen."
set key[id=213004414002545] name "He was too busy showing off his face to give autographs."
set key[id=213004414002546] name "Oh no...! I forgot to give you a pen!\nSniff... Still, thank you for trying so \
    hard for me... "
set key[id=213004414002547] name "Hmph, is that so? He must not be very good with fans. \nNext time I'll have to \
    go see him myself! "
set key[id=213004414002548] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002549] name "Do you know <font color=\"#ffd200\">$npc:11000119[gender:0]$</font>, the dashing \
    man who guards <font color=\"#ffd200\">$map:02000001$</font>?\nRumor has it his head is so flat you could put \
    a kettle on it...\nCould you meet $npc:11000119[gender:0]$ in $map:02000001$ and check\nwhether the rumor is \
    true? I'll give you a Number One Coin as a gift."
set key[id=213004414002550] name "Do you know <font color=\"#ffd200\">$npc:11000119[gender:0]$</font>, the dashing \
    man who guards <font color=\"#ffd200\">$map:02000001$</font>?\nRumor has it his head is so flat you could put \
    a kettle on it...\nCould you meet $npc:11000119[gender:0]$ in $map:02000001$ and check\nwhether the rumor is \
    true? I'll give you a Number One Coin as a gift."
set key[id=213004414002551] name "You're back, $MyPCName$! \nSo? Is $npc:11000119[gender:0]$'s head really that \
    flat?"
set key[id=213004414002552] name "It was square, just like a toy."
set key[id=213004414002553] name "He wears a helmet, so I couldn't tell."
set key[id=213004414002554] name "Wow... So the rumor was true after all.\nThanks for telling me, $MyPCName$!"
set key[id=213004414002555] name "Ugh... I see. I'll have to wait for a time when he's not wearing his \
    helmet!\nThanks for telling me, $MyPCName$!"
set key[id=213004414002556] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! \nWhy not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002557] name "I hear <font color=\"#ffd200\">$npc:11000252[gender:0]$</font>, the head of the \
    Goldus Group and the richest man in <font color=\"#ffd200\">$map:02000100$</font>,\nmakes people sing a song \
    praising his name in the entrance exam. \nCould you go to $map:02000158$ in $map:02000100$ and see if that \
    rumor is true?\nIf you meet <font color=\"#ffd200\">$npc:11000252[gender:0]$</font> there, I'll give you a \
    Number One Coin."
set key[id=213004414002558] name "I hear <font color=\"#ffd200\">$npc:11000252[gender:0]$</font>, the head of the \
    Goldus Group and the richest man in <font color=\"#ffd200\">$map:02000100$</font>,\nmakes people sing a song \
    praising his name in the entrance exam. \nCould you go to $map:02000158$ in $map:02000100$ and see if that \
    rumor is true?\nIf you meet <font color=\"#ffd200\">$npc:11000252[gender:0]$</font> there, I'll give you a \
    Number One Coin."
set key[id=213004414002559] name "Oh, you're back! \nDon't tell me the rumor was true? "
set key[id=213004414002560] name "Gol~ Gol~ Gol~dus..."
set key[id=213004414002561] name "The song turned out to be pretty good, actually."
set key[id=213004414002562] name "Oh no, $MyPCName$!\nDon't sing that song, I'm sorry! "
set key[id=213004414002563] name "Gasp! $MyPCName$, don't tell me you got a job at the Goldus Group? \nPlease \
    don't burn with that much company pride..."
set key[id=213004414002564] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! Why not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002565] name "I heard there's a famously handsome boy on Carcar Island!\nHe has a kind face \
    but a cold way of speaking... and yet people keep calling him cute...\nPlease go meet <font \
    color=\"#ffd200\">$npc:11001430[gender:0]$</font> in <font color=\"#ffd200\">$map:02010047$</font>.\nIf you do \
    me this favor, I'll give you a Number One Coin as a gift."
set key[id=213004414002566] name "I heard there's a famously handsome boy on Carcar Island!\nHe has a kind face \
    but a cold way of speaking... and yet people keep calling him cute...\nPlease go meet <font \
    color=\"#ffd200\">$npc:11001430[gender:0]$</font> in <font color=\"#ffd200\">$map:02010047$</font>.\nIf you do \
    me this favor, I'll give you a Number One Coin as a gift."
set key[id=213004414002567] name "You're back, $MyPCName$!\nSo? Is $npc:11001430[gender:0]$... really that \
    handsome?"
set key[id=213004414002568] name "He's handsome, but he talks so coldly that I couldn't warm up to him."
set key[id=213004414002569] name "We agreed to be friends, so don't you dare go after him."
set key[id=213004414002570] name "Oh, come on. They say he's like that at first, but once you get close you'll see \
    he has a warm heart.\n$MyPCName$, go visit often and be <font color=\"#ffd200\">friends with the handsome \
    $npcName:11001430[gender:0]$</font>!"
set key[id=213004414002571] name "...He didn't make you run an <font color=\"#ffd200\">errand</font> right after \
    agreeing to be friends, did he? I hear he does that sometimes.\n$MyPCName$, next time you visit, ask him \
    whether he remembers you two are friends. "
set key[id=213004414002572] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! Why not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002573] name "Have you been to <font color=\"#ffd200\">$map:02000123$</font> in <font \
    color=\"#ffd200\">$map:02000001$</font>?\nThere's a rumor that <font \
    color=\"#ffd200\">$npc:11000185[gender:1]$</font>, who knows every piece of real estate in Maple World inside \
    out,  \nis actually the richest person in the world. Would you meet $npcName:11000185[gender:1]$\nand ask how \
    to get rich? I'll give you a Number One Coin as a gift."
set key[id=213004414002574] name "Have you been to <font color=\"#ffd200\">$map:02000123$</font> in <font \
    color=\"#ffd200\">$map:02000001$</font>?\nThere's a rumor that <font \
    color=\"#ffd200\">$npc:11000185[gender:1]$</font>, who knows every piece of real estate in Maple World inside \
    out,  \nis actually the richest person in the world. Would you meet $npcName:11000185[gender:1]$\nand ask how \
    to get rich? I'll give you a Number One Coin as a gift."
set key[id=213004414002575] name "You're back, $MyPCName$!\nDid $npc:11000185[gender:1]$ tell you how to get \
    rich?"
set key[id=213004414002576] name "She was so picky that I couldn't ask her anything."
set key[id=213004414002577] name "She told me she isn't rich."
set key[id=213004414002578] name "That's right. $npcName:11000185[gender:1]$ is a bit picky. She'd never tell \
    you\nhow to get rich so easily~ Still, thank you for going!"
set key[id=213004414002579] name "That can't be... I looked into it, and her salary is supposedly higher than a \
    top athlete's...\nI'll have to ask her myself next time. Thank you, $MyPCName$!"
set key[id=213004414002580] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nI enjoyed reading them so much! Why not join in on a <font color=\"#ffd200\">fun trip</font> \
    too, $MyPCName$? "
set key[id=213004414002581] name "I heard there's a story tying a giant turtle to the adventurers.\nAn old man who \
    knows the story well is said to be at the seaside...\nWould you meet <font \
    color=\"#ffd200\">$npc:11000874[gender:0]$</font> in <font color=\"#ffd200\">$map:02000111$</font>?\nListen to \
    the story and tell me, and I'll give you a Number One Coin."
set key[id=213004414002582] name "I heard there's a story tying a giant turtle to the adventurers.\nAn old man who \
    knows the story well is said to be at the seaside...\nWould you meet <font \
    color=\"#ffd200\">$npc:11000874[gender:0]$</font> in <font color=\"#ffd200\">$map:02000111$</font>?\nListen to \
    the story and tell me, and I'll give you a Number One Coin."
set key[id=213004414002583] name "Did you go see $npc:11000874[gender:0]$?\nNow tell me the story, too! "
set key[id=213004414002584] name "(Pass on $npc:11000874[gender:0]$'s story exactly as told.)"
set key[id=213004414002585] name "I don't remember it very well."
set key[id=213004414002586] name "Oh, what a thrilling story...!\nI'll have to visit that place next time. Thank \
    you, $MyPCName$!"
set key[id=213004414002587] name "Hmph...! You're so mean, $MyPCName$! "
set key[id=213004414002596] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002597] name "$MyPCName$, have you ever seen the announcer lady on TV?\nShe looks so pretty \
    and smart, I want to be just like her!\nYou can meet her by turning on a <font \
    color=\"#ffd200\">$item:50400002$</font>. "
set key[id=213004414002598] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400002$</font> installed, you can meet her. \nTurn on the TV and say hello to the \
    announcer, and I'll give you a Number One Coin."
set key[id=213004414002599] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400002$</font> installed, you can meet her. \nTurn on the TV and say hello to the \
    announcer, and I'll give you a Number One Coin."
set key[id=213004414002600] name "You're back, $MyPCName$!\nDid you turn on the <font \
    color=\"#ffd200\">$item:50400002$</font>? The announcer lady is so pretty, isn't she? "
set key[id=213004414002601] name "I think she has an elegant, beautiful look."
set key[id=213004414002602] name "To my eyes, you're prettier..."
set key[id=213004414002603] name "Right? I want to become someone that smart and pretty someday, too!"
set key[id=213004414002604] name "Wow~ you have an eye for people, $MyPCName$!\nThank you!"
set key[id=213004414002605] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002606] name "$MyPCName$, don't you get bored eating alone? \nSome houses have a piece of \
    furniture called $item:50400125$,\nand they say a friend named Nana eats with you. Isn't that amazing? "
set key[id=213004414002607] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400125$</font> installed, you can say hello to that little friend. \nThey seem so \
    sweet, so why not go meet them?\nWhen you get back, I'll give you a Number One Coin."
set key[id=213004414002608] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400125$</font> installed, you can say hello to that little friend. \nThey seem so \
    sweet, so why not go meet them?\nWhen you get back, I'll give you a Number One Coin."
set key[id=213004414002609] name "You're back, $MyPCName$!\nWas that friend Nana really in the $item:50400125$? "
set key[id=213004414002610] name "She was a lovely friend who eats a balanced diet."
set key[id=213004414002611] name "She was eating way too hard, all by herself."
set key[id=213004414002612] name "I see! Next time I meet her, I'll greet her warmly, too. "
set key[id=213004414002613] name "Is that so? Hmm... It would be nicer to eat happily together.\nNext time I meet \
    her, I'll pass along what you said, $MyPCName$!"
set key[id=213004414002614] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002615] name "When you go to meet people, what matters most? \nFor me, it's a clean face! If \
    you wash up neatly and greet people with a bright face,\nI think the meeting feels fresh and \
    pleasant.\nWashing at the newly released <font color=\"#ffd200\">$item:50400053$</font> feels so, so \
    refreshing~"
set key[id=213004414002616] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400053$</font> installed, you can use it. \nWash your face nice and clean and come \
    back, and I'll give you a Number One Coin."
set key[id=213004414002617] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400053$</font> installed, you can use it. \nWash your face nice and clean and come \
    back, and I'll give you a Number One Coin."
set key[id=213004414002618] name "You're back, $MyPCName$!\nMmm~! You look so neat and tidy. It looks great!"
set key[id=213004414002619] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002620] name "$MyPCName$, can't you practice biking on indoor exercise equipment? \nI saw an \
    ad on a home shopping channel for the newly released <font color=\"#ffd200\">$item:50400098$</font>,\nand I \
    ordered one because I wanted to ride a bike when I go meet people.\nBut my brother says you can't practice \
    biking on indoor equipment."
set key[id=213004414002621] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400098$</font> installed, you can try it out... \nCould you use it and tell me how \
    it was? If it doesn't help with practice, I'm thinking of returning it.\nIf you do me this favor, I'll give \
    you a Number One Coin."
set key[id=213004414002622] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400098$</font> installed, you can try it out... \nCould you use it and tell me how \
    it was?\nIf you do me this favor, I'll give you a Number One Coin."
set key[id=213004414002623] name "You're back, $MyPCName$!\nSo? Is my brother right that it doesn't help with bike \
    practice?"
set key[id=213004414002624] name "(Console her by saying it doesn't seem to work.)"
set key[id=213004414002625] name "I think it can build up your leg muscles."
set key[id=213004414002626] name "Ugh, then I'd better think about returning it.\nThanks for letting me know, \
    $MyPCName$!"
set key[id=213004414002627] name "Right? I knew there'd be some way to use it.\nThanks for letting me know, \
    $MyPCName$!"
set key[id=213004414002628] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002629] name "When you go to meet people, I think it's really important to go with a light \
    body and mind. \nThat way you can focus only on the conversation with the person in front of you.  \nIn that \
    sense, the newly released <font color=\"#ffd200\">$item:50400054$</font> is\nmy best partner. A clear face, a \
    bright smile!"
set key[id=213004414002630] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400054$</font> installed, you can use it.\nTry using the <font \
    color=\"#ffd200\">$item:50400054$</font> yourself, $MyPCName$.\nTell me what you think after using it, and \
    I'll give you a Number One Coin."
set key[id=213004414002631] name "In your house, $MyPCName$, or anyone else's, anywhere\nthat has a <font \
    color=\"#ffd200\">$item:50400054$</font> installed, you can use it.\nTry using the <font \
    color=\"#ffd200\">$item:50400054$</font> yourself, $MyPCName$.\nTell me what you think after using it, and \
    I'll give you a Number One Coin."
set key[id=213004414002632] name "You're back, $MyPCName$!\nYour face looks so light it could float away! It looks \
    great!"
set key[id=213004414002633] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002634] name "When visiting someone far away, it's important to check \nthe exact location \
    beforehand. For that, a <font color=\"#ffd200\">telescope</font> is the best.\nCould you use a telescope \
    anywhere, just once? \nWhen you get back, I'll give you a Number One Coin."
set key[id=213004414002635] name "When visiting someone far away, it's important to check \nthe exact location \
    beforehand. For that, a <font color=\"#ffd200\">telescope</font> is the best.\nCould you use a telescope \
    anywhere, just once? \nWhen you get back, I'll give you a Number One Coin."
set key[id=213004414002636] name "You're back, $MyPCName$!\nTelescopes are handy, aren't they? Do use one now and \
    then!"
set key[id=213004414002637] name "Hello, $MyPCName$! For the <font color=\"#ffd200\">Number One Festival</font>, \
    the Maple Daily ran\nspecial articles on <font color=\"#ffd200\">the talk of the town</font> and the stories \
    around them.\nIt's a fun trip to go meet people, so why not\njoin in too, $MyPCName$?"
set key[id=213004414002638] name "There was an interesting part in the Maple Daily article. \nWhen they asked \
    readers to pick the person they were glad to meet, some people \npicked not a person but a <font \
    color=\"#ffd200\">golden treasure chest</font>. "
set key[id=213004414002639] name "Finding rare treasures in a well-hidden <font color=\"#ffd200\">golden treasure \
    chest</font> \nmight be even more fun than meeting people.\nTry finding the hidden golden treasure chests. If \
    you succeed in finding 3,\nI'll give you a Number One Coin."
set key[id=213004414002640] name "Finding rare treasures in a well-hidden <font color=\"#ffd200\">golden treasure \
    chest</font> \nmight be even more fun than meeting people.\nTry finding the hidden golden treasure chests. If \
    you succeed in finding 3,\nI'll give you a Number One Coin."
set key[id=213004414002641] name "You're back, $MyPCName$!\nThey must have been hard to find. Thanks for all your \
    hard work! "
set key[id=225220514000019] name "Hello~ $MyPCName$! The petals flutter~ spring has arrived.\nBut I hear that \
    beings who envy spring are after the <font color=\"#ffd200\">$item:30000525$</font>!\nThey're the <font \
    color=\"#ffd200\">elite monsters that appear all over the field</font>."
set key[id=225220514000020] name "We'll only stop the cold from returning if we take back the stolen \
    $item:30000525$...!\n$MyPCName$, could you defeat those wicked monsters and\ncollect <font \
    color=\"#ffd200\">10</font> of <font color=\"#ffd200\">$item:30000525$</font> and bring them to me?"
set key[id=225220514000021] name "Defeat the elite monsters that appear all over the field and\nbring me <font \
    color=\"#ffd200\">10</font> of <font color=\"#ffd200\">$item:30000525$</font>, and I'll give you a \
    gift.\nPlease protect this warm spring! "
set key[id=225220514000022] name "Thank you, $MyPCName$! \nI was worried the cold would return... but a warm \
    spring breeze is blowing now.\nAs thanks, please accept this <font color=\"#ffd200\">$item:20300167$</font>! "
set key[id=302172914002642] name "Welcome, $MyPCName$!\nMaple World is buzzing with the 'Clash! Solo Squad VS \
    Couple Squad' event!"
set key[id=302172914002643] name "If you defeat the <font color=\"#ffd200\">couple side's field bosses</font> and \
    prove you're worthy of the Solo Squad,\nI'll give you the Solo Squad commemorative T-shirt!\nBut I can't give \
    the Solo Squad commemorative T-shirt to adventurers who have completed the \n'Worthy of a Couple' quest, so be \
    careful!"
set key[id=302172914002644] name "If you defeat the <font color=\"#ffd200\">couple side's field bosses</font> and \
    prove you're worthy of the Solo Squad,\nI'll give you the Solo Squad commemorative T-shirt!\nBut I can't give \
    the Solo Squad commemorative T-shirt to adventurers who have completed the \n'Worthy of a Couple' quest, so be \
    careful!"
set key[id=302172914002645] name "Invincible solos, united as one, as always!"
set key[id=302172914002646] name "Welcome, $MyPCName$!\nThe 'Clash! Solo Squad VS Couple Squad' event has set \
    Maple World abuzz!\nWon't you take part?"
set key[id=302172914002647] name "If you defeat the <font color=\"#ffd200\">solo side's field bosses</font> and \
    prove you're worthy of the Couple Squad,\nI'll give you the Couple Squad commemorative T-shirt!\nBut I can't \
    give the Couple Squad commemorative T-shirt to adventurers who have completed the \n'Worthy of a Solo' quest, \
    so be careful!"
set key[id=302172914002648] name "If you defeat the <font color=\"#ffd200\">solo side's field bosses</font> and \
    prove you're worthy of the Couple Squad,\nI'll give you the Couple Squad commemorative T-shirt!\nBut I can't \
    give the Couple Squad commemorative T-shirt to adventurers who have completed the \n'Worthy of a Solo' quest, \
    so be careful!"
set key[id=302172914002649] name "Life is all about love-love and heart-heart, after all!"
set key[id=302172914002650] name "Hello, $MyPCName$!\nThe sweet White Day mission is underway!\nCouples and solos, \
    let's do it together!"
set key[id=302172914002651] name "During the event, try to <font color=\"#ffd200\">defeat a field boss of level 20 \
    or higher</font>.\nAdventurers who complete the mission get \nsparkly, cute heart-shaped partitions along with \
    the gifts Ruby prepared!"
set key[id=302172914002652] name "During the event, try to <font color=\"#ffd200\">defeat a field boss of level 20 \
    or higher</font>.\nAdventurers who complete the mission get \nsparkly, cute heart-shaped partitions along with \
    the gifts Ruby prepared!"
set key[id=302172914002653] name "Mission clear!\nThat's you, $MyPCName$! You cleared it cleanly!"
set key[id=304215214000023] name "Hello~ $MyPCName$!\nWith spring here, I'm looking for a <font \
    color=\"#ffd200\">kind hero</font> as warm as the spring breeze. \nIf people help each other and smile \
    together, it'll always be warm and cozy like spring, right? "
set key[id=304215214000024] name "Bring me <font color=\"#ffd200\">6</font> of <font \
    color=\"#ffd200\">$item:30000526$</font> and I'll give you a gift.\nYou can get $item:30000526$ if, in <font \
    color=\"#ffd200\">Challenge/Chaos Mode</font> dungeons that other adventurers find hard,\nyou <font \
    color=\"#ffd200\">help them</font> and clear the dungeon together."
set key[id=304215214000025] name "Bring me <font color=\"#ffd200\">6</font> of <font \
    color=\"#ffd200\">$item:30000526$</font> and I'll give you a gift.\nYou can get $item:30000526$ if, in <font \
    color=\"#ffd200\">Challenge/Chaos Mode</font> dungeons that other adventurers find hard,\nyou <font \
    color=\"#ffd200\">help them</font> and clear the dungeon together."
set key[id=304215214000026] name "You brought <font color=\"#ffd200\">6</font> of <font \
    color=\"#ffd200\">$item:30000526$</font>!\nI'll give this gift to you, $MyPCName$, a kind hero with a heart as \
    warm as spring. "
set key[id=312150014003139] name "Welcome, $MyPCName$!\nHow about a game of tag on this sunny day? \nFind the \
    Friend of the Day! \nOnce you find the Friend of the Day, come to me and I'll give you a Cherry Blossom Coin! \
    "
set key[id=312150014003140] name "Today's friend is... \nFind a friend wearing a level 20 or higher 'Fanfare Baby \
    Angel'!\nYou should be able to meet one somewhere in Maple World. "
set key[id=312150014003141] name "Find a friend wearing a level 20 or higher 'Fanfare Baby Angel'!\nIf you don't \
    give up looking, you'll meet one soon. "
set key[id=312150014003142] name "You cleared today's mission!\nHere's the <font \
    color=\"#ffd200\">$item:30001100$</font> I promised!\nTake the <font color=\"#ffd200\">$item:30001100$</font> \
    to Bobby's event shop \nand you can buy great reward items. "
set key[id=312150014003143] name "Welcome, $MyPCName$!\nHow about a game of tag on this sunny day? \nFind the \
    Friend of the Day! \nOnce you find the Friend of the Day, come to me and I'll give you a Cherry Blossom Coin! \
    "
set key[id=312150014003144] name "Today's friend is... \nFind a female friend wearing a level 30 or higher 'Rabbit \
