row mail[id=50001000] <mail id="50001000" sender="MapleStory 2 Team" subject="[Elite Weapon Support] Job Change \
    Gift: Lv. 10 Weapon Package" content="Congratulations on your job change!&#10;Here is the Lv. 10 weapon box for \
