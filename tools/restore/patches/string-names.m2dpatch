set quest[questID=80000493] name "It Hurts, It Hurts So Much"
set quest[questID=80000493] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001003$ asks you to calm down the central figure of a tragedy born of too much love... \
    \n$npc:22000022$, who suffered stress from the varied reactions of adventurers after the truth came out that \
    she is a woman!\nAs a side effect, she has become very violent and attacks everything that comes near without \
    mercy.\nGo to $map:02000117$ and calm down the violent $npc:22000022$."
set quest[questID=80000493] manual "Calm down the violent $npc:22000022$ in $map:02000117$"
set quest[questID=80000493] complete "Talk to $npc:11001003$ in $map:02000064$ or $map:63000062$"
set quest[questID=80000500] name "Daily Mission: Find Love for Me"
set quest[questID=80000500] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001002$ suggests going where lots of people gather to look for your destined one.\nHead to the \
    event grounds hosted by $npc:11001899$, where many people gather.\n\nPlaces where events hosted by \
    $npc:11001899$ are held: $map:61000001$, $map:61000002$, $map:61000007$, $map:61000006$, $map:61000004$, \
    $map:61000003$, $map:61000008$"
set quest[questID=80000500] manual "Join an event hosted by $npc:11001899$"
set quest[questID=80000500] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000062$"
