set key[id=315202702004913] name "Sigh... $npcName:11000003[gender:0]$ over there looks really \
    upset...\n$MyPCName$, could you go calm him down?"
set key[id=315202702004914] name "Sigh... $npcName:11000003[gender:0]$ over there looks really \
    upset...\n$MyPCName$, could you go calm him down?"
set key[id=315202702004915] name "Argh! Seriously!\nJust watch me, I won't sit still! Argh!"
set key[id=315202702004916] name "Hm? Sniff sniff... What is this? This suspicious smell?\nThat \
    $npc:11000169[gender:0]$ seems to know something... Go and find out."
set key[id=315202702004917] name "Hm? Sniff sniff... What is this? This suspicious smell?\nThat \
