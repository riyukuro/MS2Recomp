set quest[questID=80000075] name "The Old Man Who Remembers That Day"
set quest[questID=80000075] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \nGo to \
    $map:02000111$ to hear from $npc:11000874$, an old man who vividly remembers the story of a giant turtle and \
    the adventurers long ago."
set quest[questID=80000075] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000076] name "Chunbae's Past"
set quest[questID=80000076] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \nIf you \
    wonder about the story behind GM Chunbae's name, go to a person called $npc:11000456$... Go to $map:02000070$ \
    in $map:02000062$ and hear what happened."
set quest[questID=80000076] manual "Talk to $npc:11000456$ at $map:02000070$ in $map:02000062$"
set quest[questID=80000076] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000077] name "Announcers Are Love"
set quest[questID=80000077] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \
    \n$npc:11001002$'s dream is to become a smart, pretty person like the announcer you can meet by turning on the \
    $item:50400002$. Turn on the $item:50400002$ and see her."
set quest[questID=80000077] manual "Turn on the $item:50400002$"
set quest[questID=80000077] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000078] name "Let's Have a Meal"
set quest[questID=80000078] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \nGood \
    news for people who feel lonely eating alone! If you put the furniture called $item:50400125$ in your house, \
    you can eat with a friend named Nana anytime. Go meet that curious piece of furniture and Nana, the friend who \
    guards it."
set quest[questID=80000078] manual "Examine the $item:50400125$"
set quest[questID=80000078] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000079] name "Meet Fresh"
set quest[questID=80000079] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \
    \n$npc:11001002$ believes the most important thing when meeting people is to wash clean and meet them \
    refreshed. Wash up in the $item:50400053$ and feel fresh."
set quest[questID=80000079] manual "Use the $item:50400053$"
set quest[questID=80000079] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000080] name "Meet Strong"
set quest[questID=80000080] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \
    \n$npc:11001002$ wants to ride a bicycle to meet people, but lacks the skill, so she bought a $item:50400098$ \
    from a home shopping channel to practice. But she looks gloomy after her brother $npc:11001003$ said indoor \
    exercise equipment can't be used to practice cycling. Ride the $item:50400098$ and tell her in a review \
    whether it can be used for cycling practice."
set quest[questID=80000080] manual "Use the $item:50400098$"
set quest[questID=80000080] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000081] name "Meet Light"
set quest[questID=80000081] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \
    \n$npc:11001002$ believes you need a light body and mind to focus on the person in front of you when meeting \
    them. She says the $item:50400054$ is the best partner for that... Try the $item:50400054$ yourself to see \
    whether she's right."
set quest[questID=80000081] manual "Use the $item:50400054$"
set quest[questID=80000081] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000082] name "Where Is That Person?"
set quest[questID=80000082] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \
    \n$npc:11001002$ says nothing beats a telescope for checking in advance where someone far away is. As she \
    says, try using a telescope. "
set quest[questID=80000082] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000083] name "Box, I Miss You"
set quest[questID=80000083] desc "$npc:11001002$ read the Maple Daily's first-anniversary special on the people \
    who made headlines in Maple World, and suggests recalling the past year while going to meet people. \nSome \
    people are said to be happier to run into a golden treasure chest than to meet people. Find the hidden golden \
    treasure chests and join in the fun. "
set quest[questID=80000083] manual "Open 3 golden treasure chests"
set quest[questID=80000083] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:63000032$"
set quest[questID=80000084] name "A Hero's Kindness Continues"
set quest[questID=80000084] desc "If you help other adventurers who struggle with Challenge/Chaos mode dungeons \
    and clear the dungeon, you can get $item:30000558$.\nThey say a hero who gets 4 $item:30000558$ receives a \
    gift, so give it a try."
set quest[questID=80000084] manual "Collect 4 $item:30000558$"
set quest[questID=80000085] name "A Hero's Challenge Continues"
set quest[questID=80000085] desc "If you help other adventurers who struggle with Challenge/Chaos mode dungeons \
    and clear the dungeon, you can get $item:30000558$.\nThey say a hero who gets 4 $item:30000558$ receives a \
    gift, so give it a try."
set quest[questID=80000085] manual "Collect 4 $item:30000558$"
set quest[questID=80000086] name "Gift from the Allicari Merchant Society"
set quest[questID=80000086] desc "Answer the Allicari Merchant Society's quiz correctly to win a special gift \
    they've prepared. \nIt's said to be a very useful gift for hunting monsters, so give it a try! "
set quest[questID=80000087] name "Maple Rice Cakes in Danger"
