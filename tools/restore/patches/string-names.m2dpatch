set key[id=20001697] mainDescription "<font size='18'>Engagement Item</font>"
set key[id=20001697] tooltipDescription "You need this item to get <font color='#00aaef'>engaged</font>. Both the \
    one who proposes and the one who is proposed to must have it."
set key[id=20001697] guideDescription "<font color='#6e6e6e'>A golden maple leaf that holds the precious promise \
    of two people who want to spend every day ahead together. You can propose when both you and a character on \
    your friend list have one.\\nIf the proposal succeeds, you are engaged for 7 days. Finish a wedding within \
    that time to become a married couple. \\nTo get married, visit $map:84000001$ and book a wedding hall with a \
    wedding planner.</font>"
set key[id=20001698] mainDescription "Opens a portal to a photo shoot map"
set key[id=20001698] tooltipDescription "A photo shoot ticket the bride or groom can use in the wedding hall from \
    the officiant's pronouncement until the hall closes. Using it opens an entrance portal where you stand on your \
    channel, and anyone can go through it to the photo shoot map. Small print at the bottom reads \
    'Congratulations! Snap this happy moment!' After the photos, the portal takes you back to the wedding hall."
set key[id=20001698] guideDescription "Double-click it in your inventory to open a portal to the photo shoot map."
set key[id=20001699] mainDescription "Opens a portal to a photo shoot map"
set key[id=20001699] tooltipDescription "A photo shoot ticket the bride or groom can use in the wedding hall from \
    the officiant's pronouncement until the hall closes. Using it opens an entrance portal where you stand on your \
    channel, and anyone can go through it to the photo shoot map. Small print at the bottom reads \
    'Congratulations! Snap this happy moment!' After the photos, the portal takes you back to the wedding hall."
