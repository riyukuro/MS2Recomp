set key[id=31001999] tooltipDescription "A re-roller that changes the stats of an item anew."
set key[id=31001999] guideDescription "Double-click to use the re-roller.\\n\\n<font color=\"#FFFFFF\">Can only be \
    used on Exceptional grade capes, belts, earrings, necklaces, and rings. Using it changes only the bonus option \
    values.</font>\\n\\n<font color=\"#FF5F5F\">Changing options with a re-roller does not increase the bonus \
    option change count.\\nIt cannot be used on items with no bonus options or items that do not show a bonus \
    option change count.\\nChanging options with a re-roller can give the same values.</font>"
set key[id=31002154] tooltipDescription "A re-roller that changes the stats of an item anew."
set key[id=31002154] guideDescription "Double-click to use the re-roller.\\n\\n<font color=\"#FFFFFF\">Can only be \
    used on Exceptional grade hats, tops, bottoms, outfits, gloves, and shoes of level 50 or higher. Using it \
    changes the type and value of the bonus options.</font>\\n\\n<font color=\"#FF5F5F\">Changing options with a \
    re-roller does not increase the bonus option change count.\\nIt cannot be used on items with no bonus \
    options.\\nChanging options with a re-roller can give the same values.</font>"
set key[id=37000053] tooltipDescription "An unknown transcendence crystal that can transcend armor. Bring it to \
    the transcendence blacksmith Perfa to add even stronger power to your equipment through the power of \
    transcendence."
set key[id=37000053] guideDescription "Click the 'Transcend' button at the bottom of the inventory window to \
    transcend. It can be used on hats, tops, bottoms, gloves, and shoes. It can only be used on armor with a \
    required level of 50 to 71. The options granted may differ by armor part. Transcending needs additional \
    materials, which you can check in the transcendence UI. The crystal is used up when you attempt transcendence. \
    The higher the crystal's grade, the more likely higher values are to be added."
set key[id=37000053] mainDescription "Unknown Transcendence available"
