set quest[questID=80000369] name "The True Dungeon Master"
set quest[questID=80000369] desc "If you clear an event dungeon together with an adventurer who needs help (fewer \
    than 20 dungeon clears), you can get '$item:30000868$'.\n\nEvent dungeons:\n- Raid dungeons: Rubelisk, Rune \
    Temple, Beyond Link Tris, Frost Shrine, Madrakan Spire\n- Chaos Raid dungeons: Rubelisk, Ludibrium Clock \
    Tower, Rune Temple, Beyond Link Tris, Madrakan Spire"
set quest[questID=80000369] manual "Collect 3 $item:30000868$"
set quest[questID=80000369] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000370] name "Plump Pink Bean Keeps Floating in My Mind!!"
set quest[questID=80000370] desc "Find and investigate Pink Bean balloons all over Maple World!\nComplete 10 \
    investigations a day, and $npc:11001002$ will give you '$item:20000622$', which grants 300,000 EXP the moment \
    you use it.\n\nGet 10 $item:20000622$ to automatically earn the 'Pink Bean Is Plump!' emblem. As the emblem \
    reward, you can get the 'Pink Pink Bean' speech bubble badge.	\n\n* Pink Bean balloons appear in every field \
    every 10 minutes and last for 5 minutes."
set quest[questID=80000370] manual "Investigate Pink Bean balloons"
set quest[questID=80000370] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000371] name "GM Chally Is in Danger!!"
set quest[questID=80000371] desc "Rescue GM Chally, who met with an accident while filming 'Maple World Now' in \
    $map:02000409$!\nSmash the $npc:29000307$ tombstone in $map:02000409$ to rescue $npc:29000307$.\n\n* \
    '$map:02000409$', a Reverse Raid dungeon, requires level 50 to enter and can only be entered on weekends."
set quest[questID=80000371] manual "Smash the $npc:29000307$ tombstone"
set quest[questID=80000371] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000393] name "Hide Well or Your Hair Will Show~"
set quest[questID=80000393] desc "Find and pet the Human Merets all over Maple World!\n\n* Human Merets appear in \
    every field every 10 minutes and last for 5 minutes."
set quest[questID=80000393] manual "Pet a Human Meret"
set quest[questID=80000393] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000394] name "Santa Papa's Special Tree"
set quest[questID=80000394] desc "You heard that, for the Christmas season, Santa Papa's special Christmas tree \
    has grown somewhere in Maple World.\nThey say you can enter the place with the special Christmas tree by using \
    the [Santa Papa's Christmas Tree] item, which you can buy for free in the 'Special Sale' tab of the Meret \
    Market.\nSanta Papa's special Christmas tree! \nGo and see it for yourself!"
set quest[questID=80000394] manual "Enter the Christmas tree map using [Santa Papa's Christmas Tree] from the \
    'Special Sale' tab of the Meret Market"
set quest[questID=80000394] complete "Talk to $npc:11001002$ in $map:02000064$"
