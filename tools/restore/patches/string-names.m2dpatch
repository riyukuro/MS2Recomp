set key[id=20303244] tooltipDescription "A box containing a Fire Prism weapon enchanted to +5, with a weapon that \
    fits your class."
set key[id=20303244] guideDescription "Double-click it in your inventory to receive the items.\\n\\n<font \
    color=\"#FF5F5F\">* All items in the box are character-bound, and when you open the box, the equipment options \
    are decided at a set chance.</font>"
set key[id=20303247] tooltipDescription "A raffle ticket that gives you a chance to win the 5th anniversary Mekong \
    Cushion."
set key[id=20303247] guideDescription "\\nHow to get a Mekong Cushion<font color='#FFFFFF'>\\n- Keep this raffle \
