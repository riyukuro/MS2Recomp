set key[id=20001798] tooltipDescription "A special magnet lure that can only be used in $map:02000557$. If you \
    fish in $map:02000557$, you have a set chance to get $item:30001515$."
set key[id=20001798] guideDescription "\\n$item:20001798$ How to Get<font color='#FFFFFF'>\\n- Get it by mail when \
    you log in during the event\\n- Buy it at Bax the Treasure Collector's shop in \
    $map:02000557$</font>\\n\\n<font color=\"#FF5F5F\">You cannot use two or more lures at the same time. Using \
    one removes the effect of the current lure.</font>\\n\\nUse the World Map or Event Map shortcut button to get \
    to $map:02000557$ quickly and easily."
set key[id=20001798] mainDescription "<font size='14'>Duration 30 Min</font>\\n<font size='20'>Gives a chance to \
    hook items</font>"
set key[id=20001800] tooltipDescription "A special magnet lure that can only be used in $map:02000557$. If you \
    fish in $map:02000557$, you have a set chance to get $item:30001521$."
