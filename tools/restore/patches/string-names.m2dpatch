set key[id=20210017] mainDescription "Learn the Warm Christmas action"
set key[id=20210017] tooltipDescription "A pass that lets you learn a 2-person dynamic action when used."
set key[id=20210017] guideDescription "Double-click it to learn a special 2-person action. After learning it, \
    right-click the character you want to act with > click the 2-Person Action button > choose the 2-person \
    dynamic action you want to request the action. You can only request a 2-person action from characters within 3 \
    m, and you can act together only if the other player accepts. After they accept, move next to the other \
    character and do the action.\\nSome actions may differ depending on the other character's gender."
