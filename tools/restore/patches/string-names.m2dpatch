set key[id=59200395] tooltipDescription "A box that gives Lv 70 character-bound Georg Kai Legendary accessories. \
    Use it to get all of the earrings, cape, necklace, ring and belt."
set key[id=59200395] guideDescription "Double-click the item in your inventory to get the items.\\n\\n<font \
    color=\"#FF5F5F\">* Everything in the box is character-bound, and when you open the box, the equipment options \
    are set at random.</font>"
set key[id=59400077] tooltipDescription "A small capsule holding $item:60000053$. It is a cute, playful red \
    panda.  $item:60000053$ offers various functions to make the game more convenient.\\n\\n<font \
    color='#ffffff'>Auto tombstone revive\\nAuto potion recovery\\nAuto item pickup\\n28-slot pet \
    bag\\n\\n</font>"
set key[id=59400077] guideDescription "Double-click the capsule item in your inventory to get a pet. <font \
    color='#FF5F5F'>\\n\\n* Becomes character-bound when you get the pet</font>"
set key[id=60000038] tooltipDescription "<font color='#9FC93C'>Convenience Functions\\n - Auto tombstone revive\\n \
    - Auto potion recovery\\n - Auto item pickup\\n - 14-slot pet bag\\n<font size='3'> </font>\\n</font>A bright, \
    lovable kitten. It is lively and loves to run around."
set key[id=60000038] guideDescription "Pets cannot be summoned in events, battlefields or arenas."
set key[id=60000039] tooltipDescription "<font color='#9FC93C'>Convenience Functions\\n - Auto tombstone revive\\n \
    - Auto potion recovery\\n - Auto item pickup\\n - 14-slot pet bag\\n<font size='3'> </font>\\n</font>A kitten \
    who finds everything a bother and dislikes noise. Mary's son: he doesn't look like her, but he has a similar \
    personality."
set key[id=60000039] guideDescription "Pets cannot be summoned in events, battlefields or arenas."
set key[id=60000040] tooltipDescription "<font color='#9FC93C'>Convenience Functions\\n - Auto tombstone revive\\n \
    - Auto potion recovery\\n - Auto item pickup\\n - 14-slot pet bag\\n<font size='3'> </font>\\n</font>A kitten \
    with an indifferent, chic personality. It hates untidiness so much that it sometimes nags its owner."
set key[id=60000040] guideDescription "Pets cannot be summoned in events, battlefields or arenas."
set key[id=60000062] tooltipDescription "<font color='#9FC93C'>Convenience Functions\\n - Auto tombstone revive\\n \
    - Auto potion recovery\\n - Auto item pickup\\n - 14-slot pet bag\\n<font size='3'> </font>\\n</font>A plush \
    doll in the shape of Mabinogi's Nao."
set key[id=60000062] guideDescription "Pets cannot be summoned in events, battlefields or arenas."
set key[id=70100007] mainDescription "Makes certain parts invisible"
set key[id=70100007] tooltipDescription "Lets you make any part of your worn equipment and accessories invisible."
set key[id=70100007] guideDescription "Drag and drop the badge from your inventory onto the badge tab of the \
    character info window, or right-click it to equip it, and a settings button appears. Only one transparency \
    badge can be equipped, and a weapon's appearance cannot be made invisible."
set key[id=70150000] mainDescription "<font size='14'>A meta badge that has no effect yet</font>"
set key[id=70150000] tooltipDescription "<font color='#ffffff'>Meta badge that can evolve\\n - Combine with 480 \
    Meta Cores to evolve into a Silver badge that raises physical/magic attack by 1%\\n - Combine with 1200 Meta \
    Cores to evolve into a Gold badge that raises physical/magic attack by 2%\\n</font>"
set key[id=70150000] guideDescription "\\nHow to get $item:20302626$<font color='#FFFFFF'>\\n- Chance to get it \
    while defeating monsters, playing instruments or fishing\\n- Up to 60 per day</font>"
set key[id=70150001] mainDescription "<font size='14'>Takes effect when worn</font>\\n<font \
    size='24'>Physical/magic attack +1%</font>"
set key[id=70150001] tooltipDescription "<font color='#ffffff'>Meta badge that can evolve\\n - Combine with 1200 \
    Meta Cores to evolve into a Gold badge that raises physical/magic attack by 2%\\n</font>"
set key[id=70150001] guideDescription "\\nHow to get $item:20302626$<font color='#FFFFFF'>\\n- Chance to get it \
    while defeating monsters, playing instruments or fishing\\n- Up to 60 per day</font>"
set key[id=70200093] mainDescription "Changes the chat bubble design"
set key[id=70200093] tooltipDescription "A badge that swaps your chat bubble design."
set key[id=70200093] guideDescription "Drag and drop the badge from your inventory onto the badge tab of the \
    character info window, or right-click it to equip it, and your character's chat bubble design changes. Only \
    one chat bubble badge can be equipped."
