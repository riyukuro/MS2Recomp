set key[id=20303221] tooltipDescription "A watering can for watering the spring blossom tree planted in Queenstown \
    so it grows well. You can water it only 5 times a day."
set key[id=20303221] guideDescription "\\nHow to get $item:20301391$<font color='#FFFFFF'>\\n- Get 1 per day by \
    mail when you log in</font>"
set key[id=20303222] tooltipDescription "A gift box filled with the blessing of the spring blossom tree."
set key[id=20303222] guideDescription "Double-click it in your inventory to receive the items. Can be obtained by \
    interacting with the spring blossom tree in Queenstown on 'Blessing Day of the Spring Blossom Tree'."
set key[id=20303223] tooltipDescription "A box containing 10 petal coins, modeled after fragrant spring petals."
