set key[id=726145417004050] name "Tell <font color=\"#ffd200\">$npc:11000015[gender:1]$</font> in <font \
    color=\"#ffd200\">$map:02000076$</font> how you feel.\nIf your hearts connect, you'll get <font \
    color=\"#ffd200\">$item:30001182$</font> as proof!\nIf you take $item:30001182$ to <font \
    color=\"#ffd200\">$npcName:11004101$</font> in <font color=\"#ffd200\">$map:63000062$</font>,\nyou can buy \
    some fun items. Good luck!"
set key[id=726145417004051] name "Did you want to say something to me?"
set key[id=726145417004052] name "I love you."
set key[id=726145417004053] name "(Flatter him: so cool, so good with a bow, the strongest in the universe.)"
set key[id=726145417004054] name "Oh, yes. Thank you."
set key[id=726145417004055] name "(Flatter him: so cool, so good with a bow, the strongest in the universe.)"
set key[id=726145417004056] name "Please accept my love."
set key[id=726145417004057] name "That's... too kind of you. \nI'm only doing my <font \
    color=\"#ffd200\">best</font> every day as a member of the <font color=\"#ffd200\">vigilantes</font>."
set key[id=726145417004058] name "I'd like to join your fan club."
set key[id=726145417004059] name "Ah, that's... it may be a bit of a hassle,\nbut please get <font \
    color=\"#ffd200\">permission</font> from <font color=\"#ffd200\">$npcName:11000547[gender:1]$</font> first."
set key[id=726145417004060] name "What on earth are you talking about?"
set key[id=726145417004061] name "$npcName:11000547[gender:1]$ asked me, as a <font color=\"#ffd200\">heartfelt \
    wish</font>, to hear her out for <font color=\"#ffd200\">one month</font>.\nIf anyone confesses to me this \
    month or says they want to join my fan club,\nshe asked me to <font color=\"#ffd200\">send them to her \
    first</font>. "
set key[id=726145417004062] name "I made a <font color=\"#ffd200\">promise</font>... so I have to keep it. \nIt's \
    a favor I'm able to grant. "
set key[id=726145417004063] name "(It doesn't look like this month will work. Step back.)"
set key[id=726145417004064] name "Yes, thank you for understanding."
set key[id=726145417004065] name "Sure."
set key[id=726145417004066] name "(<font color=\"#ffd200\">$npc:11000015[gender:1]$</font> smiles gently.\nHave we \
    connected...?)"
set key[id=726145417004067] name "Hello, $MyPCName$! \nHave you heard about the heartbreaking couple in \
    $map:63000062$?\nThe only way for them to meet is to wait for the <font color=\"#ffd200\">seventh moonlit \
    night</font>...\nTo make that amazing miracle happen, shall we fill this world with love?"
set key[id=726145417004068] name "Love connections are felt even among many people... \nHow about looking for your \
    destined one in a place full of people?\nJoin <font color=\"#ffd200\">the event hosted by \
    $npc:11001899[gender:0]$</font> and come back, and I'll give you <font \
    color=\"#ffd200\">$item:30001182$</font>."
set key[id=726145417004069] name "Sure."
set key[id=726145417004070] name "What's the event hosted by <font \
    color=\"#ffd200\">$npc:11001899[gender:0]$</font>?"
set key[id=726145417004071] name "Take <font color=\"#ffd200\">$item:30001182$</font> to $npc:11004101$ in \
    $map:63000062$,\nand you should be able to buy some fun items.\nGood luck, $MyPCName$!"
set key[id=726145417004072] name "They're <font color=\"#ffd200\">$map:61000001$, $map:61000002$, $map:61000007$, \
    $map:61000006$, \n$map:61000004$, $map:61000003$, $map:61000008$</font>!\n$npc:11001899[gender:0]$ works very \
    hard on these events every day!\nWhen it's time, a join message will pop up at the bottom of the screen!"
set key[id=726145417004073] name "Take <font color=\"#ffd200\">$item:30001182$</font> to $npc:11004101$ in \
    $map:63000062$,\nand you should be able to buy some fun items.\nGood luck, $MyPCName$!"
set key[id=726145417004074] name "How about looking for your destined one in a place full of people?\nJoin <font \
    color=\"#ffd200\">the event hosted by $npc:11001899[gender:0]$</font> and I'll give you <font \
    color=\"#ffd200\">$item:30001182$</font>.\nIf you take <font color=\"#ffd200\">$item:30001182$</font> to \
    $npc:11004101$ in $map:63000062$,\nyou can buy some fun items!"
set key[id=726145417004075] name "Thanks to you, $MyPCName$, it feels like there's a little more love in this \
    world!\nGood work today, too!"
set key[id=726145417004144] name "Greetings, $MyPCName$.\nI hear you're going to help $npc:11004099[gender:0]$ and \
    $npc:11004100[gender:1]$? \nYou don't walk past other people's suffering. You really are a kind soul.\n"
set key[id=726145417004145] name "Helping kind people is a trait of us magpies, you might say. Ahem.\nCarry out \
    the task I give you and come back, and I'll give you <font color=\"#ffd200\">$item:30001182$</font>.\nI'll \
    give you plenty of time, so enjoy the scenery of $map:63000062$ as you go."
set key[id=726145417004146] name "This week's task is... \n<font color=\"#ffd200\">Complete the Love Dance Party \
    10 times</font>.\nYou know how it's done, don't you? "
set key[id=726145417004147] name "Yes, I know."
set key[id=726145417004148] name "I don't. Could you explain it?"
set key[id=726145417004149] name "The <font color=\"#ffd200\">'Love Dance Party'</font> can only be held right \
    here in <font color=\"#ffd200\">$map:63000062$</font>,\nso don't go off anywhere else by mistake!\nYou have \
    until the seventh moon rises, so take your time~"
set key[id=726145417004150] name "Tap the <font color=\"#ffd200\">'Adventure'</font> icon at the bottom of the \
    screen. The <font color=\"#ffd200\">'Love Dance Party'</font> menu is at the top.\nPress the <font \
    color=\"#ffd200\">Request Couple Dance</font> button there and wait for a dance partner. \nWhen your partner \
    arrives, just dance together. Pretty easy, huh?\n"
set key[id=726145417004151] name "The <font color=\"#ffd200\">'Love Dance Party'</font> can only be held right \
    here in <font color=\"#ffd200\">$map:63000062$</font>,\nso don't go off anywhere else.\nYou have until the \
    seventh moon rises, so take your time~"
set key[id=726145417004152] name "This week's task is <font color=\"#ffd200\">Complete the Love Dance Party 10 \
    times</font>.\nThe <font color=\"#ffd200\">'Love Dance Party'</font> can only be held right here in <font \
    color=\"#ffd200\">$map:63000062$</font>,\nso don't go off anywhere else, and be sure to do it right here~"
set key[id=726145417004153] name "It was a joy to watch you dance so hard. Here, the gift I promised. \nLook \
    forward to my task next week, too."
set key[id=726145417004154] name "Greetings, $MyPCName$.\nI, the <font color=\"#ffd200\">kind magpie</font>, have \
    prepared a <font color=\"#ffd200\">task</font> for kind people again this week.\nAre you ready for my gift \
    again this week? \n"
set key[id=726145417004155] name "<font color=\"#ffd200\">$map:63000062$</font> is a place where mysterious water \
    flows, so it's wonderful for <font color=\"#ffd200\">fishing</font>.\nWhat's more, there are <font \
    color=\"#ffd200\">extraordinary fish</font> that live only here.\nHow about enjoying some fishing here and \
    having a special experience?"
set key[id=726145417004156] name "This week's task is... \n<font color=\"#ffd200\">Reel in 7 Big Catches</font> in \
    <font color=\"#ffd200\">$map:63000062$</font>, and catch\n<font color=\"#ffd200\">10 Zappy Heart Rays</font> \
    and <font color=\"#ffd200\">3 Flowerpath Axolotls</font>."
set key[id=726145417004157] name "Go <font color=\"#ffd200\">fishing</font> in <font \
    color=\"#ffd200\">$map:63000062$</font> and meet some <font color=\"#ffd200\">special fish</font>, too.\nWhen \
    you finish this task, I'll give you plenty of <font color=\"#ffd200\">$item:30001182$</font>.\nYou have until \
    the seventh moon rises, so take your time~"
set key[id=726145417004158] name "This week's task is to <font color=\"#ffd200\">Reel in 7 Big Catches</font> in \
    <font color=\"#ffd200\">$map:63000062$</font>, and catch\n<font color=\"#ffd200\">10 Zappy Heart Rays</font> \
    and <font color=\"#ffd200\">3 Flowerpath Axolotls</font>.\nDon't go off anywhere else, and be sure to do it \
    right here~"
set key[id=726145417004159] name "It was a joy to watch you fish so hard. Here, the gift I promised. \nLook \
    forward to my task next week, too."
set key[id=726145417004160] name "Greetings, $MyPCName$.\nI, the <font color=\"#ffd200\">kind magpie</font>, have \
    prepared a <font color=\"#ffd200\">task</font> for kind people again this week.\nAre you ready for my gift \
    again this week? \n"
set key[id=726145417004161] name "$map:63000062$... isn't it truly beautiful? \nA beautiful place shines even \
    brighter when there's beautiful music.\nWon't you fill this lovely place with the melody of love?"
set key[id=726145417004162] name "This week's task is... \n<font color=\"#ffd200\">Perform for 30 minutes in \
    $map:63000062$</font>, and\n<font color=\"#ffd200\">Play in an ensemble 7 times in $map:63000062$</font>."
set key[id=726145417004163] name "Work together with others to keep music flowing in <font \
    color=\"#ffd200\">$map:63000062$</font>.\nWhen you finish this task, I'll give you plenty of <font \
    color=\"#ffd200\">$item:30001182$</font>.\nYou have until the seventh moon rises, so take your time~"
set key[id=726145417004164] name "This week's task is <font color=\"#ffd200\">Perform for 30 minutes in \
    $map:63000062$</font>, and\n<font color=\"#ffd200\">Play in an ensemble 7 times in \
    $map:63000062$</font>.\nDon't go off anywhere else, and be sure to do it right here~"
set key[id=726145417004165] name "You worked hard, and it was wonderful to see. Here is my last gift. \nAnything \
    of mine that catches your eye, I'll trade for these <font color=\"#ffd200\">$item:30001182$</font>."
set key[id=726145417004171] name "Hee hee~ $MyPCName$! We meet again!\nThanks to you, the bridge to the <font \
    color=\"#ffd200\">Island of Love</font> is complete!\nI really praise your efforts!"
set key[id=726145417004172] name "But this island can only be open for <font color=\"#ffd200\">just one \
    day</font>.\nOf course I feel for $npcName:11004099[gender:0]$ and $npcName:11004100[gender:1]$, who'll be \
    parted again tomorrow,\nbut <font color=\"#ffd200\">$MyPCName$</font>, who worked so hard to fill the world \
    with love, must feel awful too..."
set key[id=726145417004173] name "So I've prepared a little gift. Love doubles when you share it!\n<font \
    color=\"#ffd200\">Complete</font> the <font color=\"#ffd200\">Love Dance Party 3 times</font> and come back to \
    me. \nI'll be waiting with a <font color=\"#ffd200\">gift</font> that'll surprise you."
set key[id=726145417004174] name "<font color=\"#ffd200\">Complete</font> the <font color=\"#ffd200\">Love Dance \
    Party 3 times</font> and come back to me. \nI'll be waiting with a <font color=\"#ffd200\">gift</font> that'll \
    surprise you."
set key[id=726145417004175] name "This time I'll give you the headband $npcName:11004099[gender:0]$ and \
    $npcName:11004100[gender:1]$ wore on their date.\nIf you wear it with someone precious, it'll make a lovely \
    <font color=\"#ffd200\">couple item</font>!\nCome find me again <font color=\"#ffd200\">next week</font> when \
    this place opens!"
set key[id=726145417004176] name "Hee hee~ This week, too, the bridge to the <font color=\"#ffd200\">Island of \
    Love</font> is complete!\nAnd thanks to you, some truly <font color=\"#ffd200\">amazing news</font> has come \
    in!\nI'm so glad I get to be the one to tell you!"
set key[id=726145417004177] name "The Island of Love isn't really a place that opens easily. \n$MyPCName$, you \
    gathered the world's love here and made a <font color=\"#ffd200\">miracle</font>.\nOf course, \
    $npcName:11004099[gender:0]$ and $npcName:11004100[gender:1]$'s <font color=\"#ffd200\">longing for each \
    other</font> was very strong, too."
set key[id=726145417004178] name "Anyway, the stars who saw this miracle decided to forgive \
    $npcName:11004099[gender:0]$ and $npcName:11004100[gender:1]$.\nBut to keep the <font \
    color=\"#ffd200\">moon</font> from growing too bright with the power of love, \nthey say this place will be \
    <font color=\"#ffd200\">closed</font> so that no one can enter. "
set key[id=726145417004179] name "So now we have to say goodbye to this place, too.\nWhile I wrap the last gift \
    for you who made the miracle,\ncould you <font color=\"#ffd200\">complete</font> the <font \
    color=\"#ffd200\">Love Dance Party 3 times</font>?\nI'll be waiting here."
set key[id=726145417004180] name "While I wrap the last gift for you who made the miracle,\ncould you <font \
    color=\"#ffd200\">complete</font> the <font color=\"#ffd200\">Love Dance Party 3 times</font>?\nI'll be \
    waiting here."
set key[id=726145417004181] name "Today is the <font color=\"#ffd200\">last</font> time I'll get to see you dance \
    here.\nBut I'll be anywhere there's <font color=\"#ffd200\">love</font>,\nand if you're there, we'll meet \
    again.\nBecause a <font color=\"#ffd200\">goodbye</font> isn't a farewell forever, it's a <font \
    color=\"#ffd200\">promise to meet again</font>."
set key[id=726145417004182] name "Here. It's a pretty <font color=\"#ffd200\">couple tee</font> that \
    $npcName:11004099[gender:0]$ and $npcName:11004100[gender:1]$ designed themselves.\nTry wearing it with <font \
    color=\"#ffd200\">your other half</font>, who'll share a love lovelier than $npcName:11004099[gender:0]$ and \
    $npcName:11004100[gender:1]$!"
set key[id=810164114002942] name "$MyPCName$! \nTake on the Barbosa weekly mission!\nThe Barbosa weekly mission \
    can be completed only once a week, and when you finish it \nI'll give you 30 <font \
    color=\"#ffd200\">$item:30000881$</font> as a reward!"
set key[id=810164114002943] name "The Barbosa weekly mission is\n<font color=\"#ffd200\">to defeat 5 field bosses \
    or adventure dungeon bosses and complete today's mission 10 times</font>!\nComplete the mission and be sure to \
    collect your <font color=\"#ffd200\">$item:30000881$</font>!"
set key[id=810164114002944] name "The Barbosa weekly mission is\n<font color=\"#ffd200\">to defeat 5 field bosses \
    or adventure dungeon bosses and complete today's mission 10 times</font>!\nComplete the mission and be sure to \
    collect your <font color=\"#ffd200\">$item:30000881$</font>!"
set key[id=810164114002945] name "You cleared this week's Barbosa weekly mission!\nHere are the 30 <font \
    color=\"#ffd200\">$item:30000881$</font> I promised.\nA weekly mission that gives you 30 <font \
    color=\"#ffd200\">$item:30000881$</font> at once! \nIf you're aiming for a high-tier key, you can't afford to \
    miss the weekly mission, right?"
set key[id=810164114002946] name "$MyPCName$! \nTake on the Barbosa weekly mission!\nThe Barbosa weekly mission \
    can be completed only once a week, and when you finish it \nI'll give you 30 <font \
    color=\"#ffd200\">$item:30000881$</font> as a reward!"
set key[id=810164114002947] name "The Barbosa weekly mission is\n<font color=\"#ffd200\">to defeat 5 field bosses \
    or adventure dungeon bosses and complete today's mission 10 times</font>!\nComplete the mission and be sure to \
    collect your <font color=\"#ffd200\">$item:30000881$</font>!"
