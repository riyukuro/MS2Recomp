set key[id=20303165] mainDescription "<font size='14'>2 Min Cooldown</font>\\n<font size='24'>Summon \
    Spouse</font>"
set key[id=20303165] tooltipDescription "A scroll with mystic power. It opens a teleport gate that summons your \
    spouse from far away."
set key[id=20303165] guideDescription "Double-click it in your inventory to send your online spouse a summon \
    request. Cannot be used in dungeons, event maps or houses."
set key[id=20303166] mainDescription "Free wedding hall booking"
set key[id=20303166] tooltipDescription "Use this coupon to book a House Wedding hall for free. It cannot be used \
    to change a booking."
set key[id=20303166] guideDescription "To book a wedding hall with $item:20303166$, keep it in your inventory and \
    visit the wedding planner $npc:11004707$, $npc:11004708$ or $npc:11004709$ in $map:84000001$. You and your \
    partner must both be on the same map to book.\\n\\n<font color='#FFFFFF'>Halls you can book\\n- \
    $map:84000011$\\n- $map:84000012$</font>"
set key[id=20303167] mainDescription "Free wedding hall booking"
set key[id=20303167] tooltipDescription "Use this coupon to book a Party Wedding hall for free. It cannot be used \
    to change a booking."
set key[id=20303167] guideDescription "To book a wedding hall with $item:20303167$, keep it in your inventory and \
    visit the wedding planner $npc:11004708$ or $npc:11004709$ in $map:84000001$. You and your partner must both \
    be on the same map to book.\\n\\n<font color='#FFFFFF'>Halls you can book\\n- $map:84000013$\\n- \
    $map:84000014$</font>"
set key[id=20303168] mainDescription "Free wedding hall booking"
set key[id=20303168] tooltipDescription "Use this coupon to book a Luxury Wedding hall for free. It cannot be used \
    to change a booking."
set key[id=20303168] guideDescription "To book a wedding hall with $item:20303168$, keep it in your inventory and \
    visit the wedding planner $npc:11004709$ in $map:84000001$. You and your partner must both be on the same map \
    to book.\\n\\n<font color='#FFFFFF'>Halls you can book\\n- $map:84000015$\\n- $map:84000016$</font>"
set key[id=20303170] tooltipDescription "A box a married couple gets for clearing a mission together."
set key[id=20303183] tooltipDescription "A box of special outfits to make your wedding shine even brighter."
set key[id=20303183] guideDescription "Double-click it in your inventory to get the item for your character's \
    gender. <font color='#FFFFFF'>\\n* You keep getting it while your intimacy stays at level 5.<font \
    color='#FFFFFF'></font>"
set key[id=20700015] tooltipDescription "Double-click the badge chest to enter the name of the character to share \
    the couple effect badge with. The one who opens the chest finds a badge in their inventory, and the other gets \
    theirs by mail. When both wear the badge within 1.5 m of each other, the effect appears."
set key[id=20700015] guideDescription "The couple effect works only between the two characters who shared the \
    badges. It lasts while you stay still and fades 5 sec after you move. The badges are bound to the character, \
    so take care when you open the chest."
set key[id=20800040] mainDescription "World chat to announce your wedding"
set key[id=20800040] tooltipDescription "A special world chat coupon you can use once your wedding is booked. Chat \
    with it to announce your wedding time in a special world chat message with a colored background and a cute \
    icon. While the wedding is open, clicking your message takes players to the wedding. They cannot enter once \
    the hall is full, and the bride and groom cannot enter the hall by clicking it. "
set key[id=20800040] guideDescription "Use it from the super world chat menu at the bottom left of the chat \
    window, or double-click it. Chatting uses up the coupon. "
