set key[id=713172114003510] name "Tell <font color=\"#ffd200\">$npc:11000160[gender:1]$</font> in <font \
    color=\"#ffd200\">$map:02000001$</font> how you feel.\nIf your hearts connect, <font \
    color=\"#ffd200\">$item:30001182$</font> will appear as proof!\nTake $item:30001182$ to <font \
