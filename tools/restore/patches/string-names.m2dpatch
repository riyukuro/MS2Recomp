set key[id=40400138] mainDescription "Summon Fly, Maple Leaf"
set key[id=40400138] tooltipDescription "Ride an orange maple leaf to rise 0.5m per second, up to 4m. Press a \
    direction key while active to move forward 7m at a time. Cannot be used indoors or in some areas."
set key[id=40400138] guideDescription "Double-click it in your inventory or register it in a quick slot to mount \
    and dismount."
set key[id=50201069] tooltipDescription "A cake made especially to celebrate the 4th anniversary of MapleStory 2."
set key[id=50400335] tooltipDescription "A candle made especially to celebrate the 4th anniversary of MapleStory \
    2."
set key[id=50610022] mainDescription "Lets you run very fast."
set key[id=50610022] tooltipDescription "A kickboard made with the latest technology. It turns smoothly."
set key[id=50610022] guideDescription "Double-click it in your inventory or register it in a quick slot to mount \
    and dismount. While riding, hold the basic attack key, or move while holding it, to use a special motion."
set key[id=59200183] tooltipDescription "A package containing the Wanderer's Robe outfit."
set key[id=59200183] guideDescription "Double-click the package item in your inventory to get the items."
set key[id=59200230] tooltipDescription "A package containing the Military Suit set."
set key[id=59200230] guideDescription "Double-click the package item in your inventory to get the items."
set key[id=59200262] tooltipDescription "A package containing the Crew outfit."
set key[id=59200262] guideDescription "Double-click the package item in your inventory to get the items."
set key[id=59200373] tooltipDescription "Contains a +5 enchanted Fire Prism weapon for your class."
set key[id=59200373] guideDescription "Double-click it in your inventory to receive the items.\\n\\n<font \
    color=\"#FF5F5F\">* All items in the box are character-bound, and when you open the box, the equipment options \
    are decided at a set chance.</font>"
set key[id=70100009] mainDescription "Hide specific parts"
set key[id=70100009] tooltipDescription "Makes any part of your equipped gear and decorations transparent."
set key[id=70100009] guideDescription "Drag the badge from your inventory to the Badge tab of the character info \
    window, or right-click it to equip it, and a settings button appears. Only one Transparency Badge can be \
    equipped, and weapon appearance cannot be made transparent."
set key[id=70150006] mainDescription "<font size='14'>A Meta Badge that has no effect yet</font>"
set key[id=70150006] tooltipDescription "<font color='#ffffff'>Evolvable Meta Badge\\n - Combine with 480 Meta \
