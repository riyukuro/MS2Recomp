set key[id=726145417003907] name "Tell <font color=\"#ffd200\">$npc:11000119[gender:0]$</font> in <font \
    color=\"#ffd200\">$map:02000001$</font> how you feel.\nIf your hearts connect, <font \
    color=\"#ffd200\">$item:30001182$</font> will appear as proof!\nTake $item:30001182$ to <font \
    color=\"#ffd200\">$npcName:11004101$</font> in <font color=\"#ffd200\">$map:63000062$</font>\nand you can buy \
    some fun items. Good luck!"
set key[id=726145417003908] name "What is it?"
set key[id=726145417003909] name "I love you."
set key[id=726145417003910] name "(I can't bring myself to confess, so I talk about something else.)"
set key[id=726145417003911] name "Haha, those words feel good to hear, but they're not easy to say.\nThank you for \
    saying them to me."
set key[id=726145417003912] name "Are you accepting my confession?"
set key[id=726145417003913] name "Actually, I was lying."
set key[id=726145417003914] name "In my heart... there is already <font color=\"#ffd200\">someone who has a place \
    there</font>.\nI'll gladly accept your feelings, but I have nothing to give you.\nI'm sorry. "
set key[id=726145417003915] name "Actually, I was lying."
set key[id=726145417003916] name "Ha ha, all right. It's fine. Let's say that's the case.\nThank you anyway."
set key[id=726145417003917] name "($npcName:11000119[gender:0]$... Kind of a cool guy.)"
set key[id=726145417003918] name "It seems you have something else you want to say, young one.\nDon't hesitate, \
    just say it. I'll listen."
set key[id=726145417003919] name "This is embarrassing, but... I love you."
set key[id=726145417003920] name "<font color=\"#ffd200\">$npc:11000119[gender:0]$</font> pounds his chest and \
    laughs.\nIt seems you've connected with him...!"
set key[id=726145417003921] name "Hello, $MyPCName$! \nHave you heard about the heartbreaking couple in \
    $map:63000062$?\nThe only way for them to meet is to wait for the <font color=\"#ffd200\">seventh moonlit \
    night</font>...\nTo make that amazing miracle happen, shall we fill this world with love?"
set key[id=726145417003922] name "A brave confession of love can sometimes create a miracle.\nWhy don't you try \
    being the star of that miracle, $MyPCName$?"
set key[id=726145417003923] name "That's a great idea!"
set key[id=726145417003924] name "No, thanks."
set key[id=726145417003925] name "Great! Right now, go to <font color=\"#ffd200\">$map:02000100$</font> and tell \
    <font color=\"#ffd200\">$npc:11000252[gender:0]$</font>\nhow you feel, and make a miracle happen.\nIf your \
    hearts connect, <font color=\"#ffd200\">$item:30001182$</font> will appear as proof!"
