set key[id=211134614002067] name "Welcome back!\nWere they snappy with you again?\nThey're the type to say things \
    like that and then brag about you behind your back, so don't mind it!"
set key[id=211134614002068] name "Welcome, $MyPCName$!\nCould you help me out a bit today?"
set key[id=211134614002069] name "I'm preparing a gift, but I'm short on <font \
    color=\"#ffd200\">$item:33000076$</font>.\nI can't get any more chicken feathers today...\nPlease use \
    $item:33000026$ to make <font color=\"#ffd200\">$item:33000076$</font> for me."
