set key[id=1110104017002968] name "$MyPCName$! Shall I give you a riddle?\nWho is the kindest woman in \
    $map:02000001$?\nFind her and say hello, and I'll give you a gift!"
set key[id=1110104017002969] name "You need a hint?\nAw... it's too easy... think about it carefully!"
set key[id=1110104017002970] name "That wasn't too hard, was it?\n$npc:11000160[gender:1]$ has a heart as lovely \
    as her face!"
set key[id=1110104017002971] name "$MyPCName$! Shall I give you a riddle?\nWho is the most hardworking man in \
    $map:02000001$?\nFind him and say hello, and I'll give you a gift!"
set key[id=1110104017002972] name "You need a hint?\nAw... it's too easy... think about it carefully!"
set key[id=1110104017002973] name "That wasn't too hard, was it?\nMr. $npcName:11000012[gender:0]$ is great at \
    working hard, but...\nhe has so much work that I worry he'll collapse."
set key[id=1110104017002974] name "$MyPCName$! Shall I give you a riddle?\nWho is the most intellectual woman in \
    $map:02000001$?\nFind her and say hello, and I'll give you a gift!"
set key[id=1110104017002975] name "You need a hint?\nAw... it's too easy... think about it carefully!"
set key[id=1110104017002976] name "That wasn't too hard, was it?\nThey say nobody can keep up with how much \
    $npc:11000005[gender:1]$ reads."
set key[id=1110104017002977] name "$MyPCName$! Shall I give you a riddle?\nWho is the most dependable man in \
    $map:02000001$?\nFind him and say hello, and I'll give you a gift!"
set key[id=1110104017002978] name "You need a hint?\nAw... it's too easy... think about it carefully!"
set key[id=1110104017002979] name "That wasn't too hard, was it?\nThey say everyone can rest easy thanks to \
    $npc:11000119[gender:0]$."
set key[id=1110104017002983] name "$MyPCName$! Shall I give you a riddle?\nWho is the most diligent man in \
    $map:02000064$?\nFind him and say hello, and I'll give you a gift!"
set key[id=1110104017002984] name "You need a hint?\nAw... it's too easy... think about it carefully!"
set key[id=1110104017002985] name "That wasn't too hard, was it?\nLet's all be people who quietly and diligently \
    do our jobs, like $npc:11000172[gender:0]$."
set key[id=1110104017002986] name "Hmm... I'm thinking of making a monster encyclopedia while I'm here.\nI'd love \
    your help, $MyPCName$...\nCould you <font color=\"#ffd200\">defeat various plant-type monsters</font> across \
    Maple World and bring back the information?"
set key[id=1110104017002987] name "Hmm... I'm thinking of making a monster encyclopedia while I'm here.\nI'd love \
    your help, $MyPCName$...\nCould you <font color=\"#ffd200\">defeat various plant-type monsters</font> across \
    Maple World and bring back the information?"
set key[id=1110104017002988] name "You brought back this much information!\nAs expected, $MyPCName$ is the best! "
