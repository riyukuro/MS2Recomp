set key[id=20700013] tooltipDescription "Double-click the Buddy Effect Badge Chest to enter the name of the \
    character you want to share a Buddy Effect Badge with. The character who opens the chest finds their badge in \
    the inventory, and the character sharing it finds theirs in the mail. When both characters wear the badge and \
    stand within 1.5m of each other, the effect appears."
set key[id=20700013] guideDescription "The buddy effect only works between characters who share badges with each \
    other. Once triggered, the effect lasts while you stay still, and fades after 5 seconds if you move. Badges \
    are character-bound, so be careful when opening the chest."
