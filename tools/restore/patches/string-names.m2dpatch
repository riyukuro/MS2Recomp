set key[id=126211317003131] name "Here's the $item:20301339$ I promised~ It feels like spring has already \
    come!\nWhich item do you like best, $MyPCName$?\nI like every item in the box so much that Bobby can't decide \
    which to use first."
set key[id=213141917003132] name "Welcome, $MyPCName$!\nMaple World is buzzing with the 'Solo VS Couple Squad \
    Clash' event!"
set key[id=213141917003133] name "If you <font color=\"#ffd200\">defeat the field bosses of the couple side</font> \
