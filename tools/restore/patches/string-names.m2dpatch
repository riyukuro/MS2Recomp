set key[id=11200107] guideDescription "\\n<font color='#7A7A7A'>One of Lanemone's research results. An accessory \
    made with Blue Stone, an artificial gem created by analyzing the structure of the Prism Stone. Since Blue \
    Stone was discovered, research on beginner equipment has been very active.</font>"
set key[id=11200108] tooltipDescription "Equipment found in a rift in space and time. Chaotic energy swirls around \
