set key[id=20210036] mainDescription "Learn the Hug action"
set key[id=20210036] tooltipDescription "A pass that teaches you a 2-person dynamic action when used."
set key[id=20210036] guideDescription "Double-click it to learn a special 2-person action. After learning it, \
    right-click the character you want to act with, click the 2-Person Action button, and choose the 2-person \
    dynamic action you want to request it. You can only request a 2-person action from a character within 3m, and \
    you can act together only if the requested player accepts. After they accept, move next to the other character \
    to perform the action.\\nSome actions may differ depending on the other character's gender."
