set quest[questID=80000366] name "Find the Zakum Balloons, Zakum!"
set quest[questID=80000366] desc "Find and investigate Zakum balloons all over Maple World!\nComplete 10 \
    investigations a day, and $npc:11001002$ will give you \n10 '$item:20000596$'.\n\nGet 100 $item:20000596$ to \
    automatically earn the 'I Want to Eat Zakum' emblem. As the emblem reward, you can get \nthe 'Speak Up, Zakum' \
    speech bubble badge.	\n\n* Zakum balloons appear in every field every 10 minutes and last for 5 minutes."
set quest[questID=80000366] manual "Investigate Zakum balloons"
