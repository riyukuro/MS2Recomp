# System mails that no pack has in English: our own English for the 55 mails that are not dated event
# mails (housing, wedding, dungeon rank rewards and the like), with each row's own format fields and line breaks.
file Xml/string/kr/systemmailcontentkr.xml kms:Xml/string/kr/systemmailcontentkr.xml de7a6c87e4d434b5
set mail[id=30000001] sender "Property Manager"
set mail[id=30000001] subject "Your recovered items have arrived."
set mail[id=30000001] content "Your recovered items have arrived.\nPlease clear some inventory space and collect \
    them."
set mail[id=40000001] sender "Divorce Lawyer Haindeul"
set mail[id=40000001] subject "Your divorce request has been submitted."
set mail[id=40000001] content "You have filed for divorce from {0}. \nThe divorce cooling-off period lasts until \
    {1}. If {0} agrees to the divorce within this period, the divorce fee will be refunded. \nIf the other party \
    does not agree, the marriage stays in effect until the cooling-off period ends. \nWhen the cooling-off period \
    ends, the divorce becomes final, and all couple benefits and activity records, including affinity, are reset. \
    \nOnce the divorce is complete, you cannot propose or marry for 48 hours."
set mail[id=40000002] sender "Divorce Lawyer Haindeul"
set mail[id=40000002] subject "You have received a divorce request."
set mail[id=40000002] content "{0} has filed for divorce. \nThe divorce cooling-off period lasts until {1}. If you \
    agree to the divorce within this period, it becomes final at once and the divorce fee paid by {0} will be \
    refunded. \nIf you do not agree, the marriage stays in effect until the cooling-off period ends. \nWhen the \
    cooling-off period ends, the divorce becomes final, and all couple benefits and activity records, including \
    affinity, are reset. \nOnce the divorce is complete, you cannot propose or marry for 48 hours."
set mail[id=40000003] sender "Divorce Lawyer Haindeul"
set mail[id=40000003] subject "Your divorce is complete."
set mail[id=40000003] content "Your partner agreed to the divorce, and it is now complete. \nBecause your partner \
    agreed, the divorce fee you paid will be refunded. \nYou cannot propose or marry for the next 48 hours."
set mail[id=40000004] sender "Divorce Lawyer Haindeul"
set mail[id=40000004] subject "Your divorce is complete."
set mail[id=40000004] content "Your divorce is complete. \nYou cannot propose or marry for the next 48 hours."
set mail[id=40000005] sender "Divorce Lawyer Haindeul"
set mail[id=40000005] subject "The cooling-off period has ended and your divorce is complete."
set mail[id=40000005] content "The divorce cooling-off period has ended, and your divorce is complete.\nYou cannot \
    propose or marry for the next 48 hours."
set mail[id=40000006] sender "System Administrator"
set mail[id=40000006] subject "Your engagement has been canceled."
set mail[id=40000006] content "Your engagement was canceled because no wedding was held within the engagement \
    period.\nTo marry, you will need to propose to your partner again from the start.\nBuy [$item:20001697$] at \
    [$map:84000001$], and you can propose while standing in the same map as your partner."
set mail[id=40000007] sender "Divorce Lawyer Haindeul"
set mail[id=40000007] subject "Your divorce request has been canceled."
set mail[id=40000007] content "Your divorce request has been canceled.\nYour marriage remains in effect.\n\nThe \
    fee {0} paid when filing for divorce will not be refunded."
set mail[id=40000008] sender "Wedding Planner"
set mail[id=40000008] subject "Your wedding hall has been reserved."
set mail[id=40000008] content "Your wedding hall reservation is complete.\nWe are sending you a reservation bonus \
    item, so please check the attachment.\n\nNow, go and plan a happy and beautiful wedding!"
set mail[id=40000009] sender "Wedding Planner"
set mail[id=40000009] subject "Your wedding hall reservation has been changed."
set mail[id=40000009] content "We are writing to let you know that your wedding hall reservation has been \
    changed.\nAs the reservation has changed, we are also upgrading your reservation bonus. \nPlease check the \
    attached item.\n\nNow, go and plan a happy and beautiful wedding!\n\n(If you changed to a wedding hall of the \
    same grade, no additional bonus will be given.)"
set mail[id=40000010] sender "Wedding Planner"
set mail[id=40000010] subject "Your wedding is complete."
set mail[id=40000010] content "Your wedding is complete, and the wedding hall is sending you a wedding gift. \
    \nPlease check the attached item.\n\nWe wish you both a happy married life. May your path be strewn with \
    flowers!"
set mail[id=40000011] sender "Divorce Lawyer Mia"
set mail[id=40000011] subject "Your divorce is complete."
set mail[id=40000011] content "Your amicable divorce is complete. \nYou cannot propose or marry for the next 48 \
    hours."
set mail[id=40000012] sender "System Administrator"
set mail[id=40000012] subject "Your merets used for the wedding reservation have been returned."
set mail[id=40000012] content "Your wedding could not be held properly at the hall you reserved, so it was \
    canceled automatically.\nThe merets you used to reserve the wedding hall have been returned."
set mail[id=40000013] sender "Wedding Planner"
set mail[id=40000013] subject "Here is a coupon for a free wedding hall reservation."
set mail[id=40000013] content "Your wedding hall reservation has been canceled as requested.\nBecause your partner \
    agreed to the cancellation, we are sending you a coupon for a free reservation of a wedding hall of the same \
    grade as the one you reserved.\nThe coupon is valid for 30 days after it is issued, so please be sure to make \
    your reservation within that time."
set mail[id=40000014] sender "System Administrator"
set mail[id=40000014] subject "Here is a coupon for a free wedding hall reservation."
set mail[id=40000014] content "Your wedding could not be held properly at the hall you reserved, so it was \
    canceled automatically.\nWe are sending you a free reservation coupon for a wedding hall.\nCarry the coupon to \
    the Wedding Planner and reserve a wedding hall of the same grade as the one you reserved, and you can pay with \
    the coupon.\nThe coupon is valid for 30 days after it is issued, so please be sure to make your reservation \
    within that time."
set mail[id=50000011] subject "[Internet Cafe Time Event] 60-Minute Login Gift Arrived"
set mail[id=50000011] content "Your Internet Cafe login time event gift has arrived.\nLog in from an Internet cafe \
    every day and receive gifts!\n\n(Note) Items attached to this mail will be deleted along with the mail if you \
    do not move them to your inventory within 30 days, so please collect them soon.\n\nCollected items can be \
    moved freely to other characters on your account through the Vault NPC in major cities such as Tria.\n\nThank \
    you."
set mail[id=50000012] subject "[Internet Cafe Time Event] 90-Minute  Login Gift Arrived"
