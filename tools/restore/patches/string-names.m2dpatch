set key[id=20000969] tooltipDescription "A key that opens the Beginner's Cherry Blossom Box. \\nCombine it with 75 \
    Cherry Blossom Essences to make an Intermediate Cherry Blossom Box Key."
set key[id=20000969] guideDescription "Double-click the item in your inventory to upgrade it to the next tier."
set key[id=20000971] tooltipDescription "A key that opens the Intermediate Cherry Blossom Box. \\nCombine it with \
    105 Cherry Blossom Essences to make an Expert Cherry Blossom Box Key."
set key[id=20000971] guideDescription "Double-click the item in your inventory to upgrade it to the next tier."
set key[id=20001135] mainDescription "<font size='14'>5 Sec Cooldown</font>\\n<font size='24'>Restores 1200 \
    HP</font>"
set key[id=20001135] tooltipDescription "A golden apple that stays fresh even in the cold of winter. A special \
    fruit that is perfect to share on a peaceful Christmas."
set key[id=20001135] guideDescription "Eating it restores 1200 HP.\\nAfter eating one, you can eat again after 5 \
    sec."
set key[id=20001136] mainDescription "<font size='14'>28 Sec Duration</font>\\n<font size='24'>Restores 2240 \
    HP</font>"
set key[id=20001136] tooltipDescription "A sweet hot chocolate that is nice to drink on a chilly winter day. A \
    special drink that suits a warm Christmas."
set key[id=20001136] guideDescription "Drinking it restores 80 HP per second for 28 sec."
set key[id=20001302] mainDescription "<font size='14'>5 Sec Cooldown</font>\\n<font size='24'>Restores 1200 \
    HP</font>"
set key[id=20001302] tooltipDescription "A handmade candy carefully crafted in a pink heart shape."
set key[id=20001302] guideDescription "Eating it restores 1200 HP.\\nAfter eating one, you can eat again after 5 \
    sec."
set key[id=20001322] tooltipDescription "A potion brimming with the energy of growth."
set key[id=20001322] guideDescription "Drink it to level up to Lv. 60 right away. You also complete all Epic \
    quests up to Lv. 59. <font color='#FF5F5F'>\\n\\n* If you level up with this potion, you cannot get the mesos \
    and items given for completing Epic quests.</font>"
set key[id=20001446] tooltipDescription "A special title given to those who uncovered the secret hidden in \
    Critias."
set key[id=20001446] guideDescription "Double-click it to get a special title."
set key[id=20001696] mainDescription "<font size='14'>1 Min Cooldown | 60 Min Duration</font>\\n<font \
    size='24'>Increases Max HP</font>"
set key[id=20001696] tooltipDescription "A potion smuggled out of the secret lab in $map:02000100$. Lately it is \
    also brewed by alchemy from various gathered herbs. Drinking it <font color='#00aaef'>increases max HP by 5% \
    for 60 minutes</font>. A special ingredient is added so that <font color='#00aaef'>the effect is not lost on \
    death.</font>"
set key[id=20001758] mainDescription "<font size='14'>3 Min Cooldown | 10 Sec Duration</font>\\n<font \
    size='24'>Activates Wind's Swiftness</font>"
set key[id=20001758] tooltipDescription "A potion that makes your body light as the wind when taken."
set key[id=20001758] guideDescription "Drinking it increases movement speed by 65% for 10 sec. The effect does not \
    trigger on battlefields or in the arena. The effect is not lost on death."
set key[id=20001880] mainDescription "<font size='14'>5 Sec Cooldown</font>\\n<font size='24'>Restores 50% \
    HP</font>"
set key[id=20001880] tooltipDescription "A rare elixir said to grant immortality. Drinking it <font \
    color='#00aaef'>instantly restores 50% HP</font>. After one drink you feel full, so you can drink again after \
    5 sec."
set key[id=20001881] tooltipDescription "A small fragment of Meradium ore. It is not known where Meradium ore \
    mainly appears, but it is said it can occasionally be found on floor 4 of the Abandoned Mine."
set key[id=20001881] guideDescription "Used as a material to craft Legendary grade Transcendence Crystals at the \
    Life Skill Forge. "
set key[id=20001882] mainDescription "SP cost reduced by 50%"
set key[id=20001882] tooltipDescription "An orb that grants wisdom to the dolls. SP cost is reduced by 50% as soon \
    as you get it."
set key[id=20001883] mainDescription "Movement speed increased by 50%"
set key[id=20001883] tooltipDescription "A cape that grants agility to the dolls. Movement speed is increased by \
    50% as soon as you get it."
set key[id=20001884] mainDescription "Skill range increased by 50%"
set key[id=20001884] tooltipDescription "A sword that grants strength to the dolls. Skill range is increased by \
    50% as soon as you get it."
