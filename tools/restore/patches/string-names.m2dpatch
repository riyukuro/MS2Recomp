set quest[questID=80000480] name "The Secret to a Lasting Love"
set quest[questID=80000480] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001003$ says it might help to hear the love stories scattered across the world... \
    \n$npc:11001003$ recommends the love story of the longest-married couple in Maple World.\nGo to $map:02000129$ \
    and listen to Grandma $npc:11000705$'s story."
set quest[questID=80000480] complete "Go to $map:02000129$ and listen to Grandma $npc:11000705$'s story"
set quest[questID=80000481] name "Tragic Lovers"
set quest[questID=80000481] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001003$ says it might help to hear the love stories scattered across the world... \
    \n$npc:11001003$ recommends the tale of lovers passed down in the snowfields.\nGo to $map:02000001$ and listen \
    to $npc:11000004$'s story."
set quest[questID=80000481] complete "Go to $map:02000001$ and listen to $npc:11000004$'s story"
set quest[questID=80000482] name "Where Love Blossoms"
set quest[questID=80000482] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001003$ says it might help to hear the love stories scattered across the world... \
    \n$npc:11001003$ recommends hearing proposal tips from the owner of a famous proposal spot.\nListen to the \
    story of $npc:11000242$ at $map:02000135$."
set quest[questID=80000482] complete "Meet $npc:11000242$ at $map:02000135$ and hear their story"
set quest[questID=80000483] name "Love Rides the Beat"
set quest[questID=80000483] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001003$ says that writing a love song for couples would make love overflow in this \
    world.\nCommission the lyrics of a love song from $npc:11000412$ in $map:02000086$, an artist on the rise \
    these days."
set quest[questID=80000483] complete "Commission the lyrics of a love song from $npc:11000412$ in $map:02000086$"
set quest[questID=80000484] name "Idols Aren't Made by Just Anyone"
set quest[questID=80000484] desc "Let's fill this world with love to create the miracle of the seventh moonlit \
    night!\n$npc:11001003$ says that confessing your feelings to someone is the shortcut to calling forth a \
    miracle of love... \nWhy not confess your love to the people of Maple World in person and become the star of \
    the miracle?\nToday, confess your love to $npc:11000406$ in $map:02000137$."
set quest[questID=80000484] complete "Confess your love to $npc:11000406$ in $map:02000137$"
