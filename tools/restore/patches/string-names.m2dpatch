set key[id=11701514] guideDescription "<font color='#ff8ae5' size='14'>[Mystic Enchant]\\nEnchanting increases the \
    'Max Weapon Attack' option.</font>\\n\\n<font color='#7A7A7A'>Equipment obtained from the Phantom Dungeon \
    opened by a rift in space and time. Chaotic energy swirls around it as if the power of the rift dwells within, \
    and a dangerous, powerful aura radiates from it.</font>"
