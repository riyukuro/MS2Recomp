# The 690 quests a player can get (in questdata, locale KR or none, test quests out) whose title or texts no pack
# has in English (the GMS rows of these ids hold only placeholder ids): our own English for each Korean name, desc,
# manual, complete and descFameUI, with the rows' own format fields and line breaks.
file Xml/string/kr/questdescription_final.xml kms:Xml/string/kr/questdescription_final.xml 157fd88e98c59ac6
set quest[questID=10001000] desc "$npc:11000021$'s youngest grandson $npc:11000054$ pestered to be taken to the \
    Levee and then suddenly vanished.\nWhere could $npc:11000054$ be? \nLet's find $npc:11000148$ in \
    $map:63000001$ and ask about $npc:11000054$'s whereabouts."
set quest[questID=10001003] name "What I Want to Know"
set quest[questID=10001003] desc "$npc:11000003$ traveled a long way over hills and rivers to reach Tria, and \
    seems furious at the news that the Levee was cancelled. Hearing $npc:11000003$ out, the sudden cancellation \
    seems fishy. Could there be some other reason after all? Shall we quietly ask the armory guard in \
    $map:02000001$ that $npc:11000003$ pointed out? "
set quest[questID=10001003] complete "Find out why the Levee was cancelled in $map:02000001$"
set quest[questID=10001004] name "Their Inside Story"
set quest[questID=10001004] desc "$npc:11000492$, the royal steward at $map:02000140$...\nThe one who handled all \
    the Levee preparations might be able to explain in more detail why it was cancelled.\nFirst, let's head to \
    $map:02000140$."
set quest[questID=10001004] complete "Meet $npc:11000492$ at $map:02000140$"
set quest[questID=10001005] name "Those Who Leave"
set quest[questID=10001005] desc "$npc:11000179$ thinks highly of $npc:11000492$, and it seems to be about more \
    than just $npc:11000492$ introducing $npc:11000179$ to a new client.\nEven amid the frantic rush, \
    $npc:11000492$ repeats the same words dozens of times and never loses his smile for anyone. From that alone, \
    it is easy to guess that not only $npcName:11000179$ but most people remember him as quite a good person.\nIf \
    I go to $map:02000033$ and do $npcName:11000179$ the favor of checking out for him, will I be remembered as a \
    good person like $npc:11000492$?   "
set quest[questID=10001005] manual "Get the key from $npc:11000179$"
set quest[questID=10001005] complete "Meet $npc:11000390$ at $map:02000033$ in $map:02000001$"
set quest[questID=10001020] name "A Trainee's Worry"
set quest[questID=10001020] desc "Royal Guard trainee $npc:11000169$ is suffering alone over the weapons that \
    vanished without a trace from the armory he guards. \nHe has hardly ever left his post, and the armory lock is \
    still fastened tight, so who took the weapons, and how?\nAs $npc:11000169$ says, the stolen weapons might be \
    traded as fenced goods, so let's visit the equipment merchant $npc:11000004$ in $map:02000001$ and find out \
    whether any such weapons have been sold."
set quest[questID=10001020] complete "Meet $npc:11000004$ in $map:02000001$"
set quest[questID=10001021] name "Toward Golden Tower"
set quest[questID=10001021] desc "In the end, $npc:11000170$ confessed to buying iron ore from $npc:11000173$. \
    Even if the iron ore $npcName:11000170$ bought has nothing to do with the armory theft... the notorious fence \
    $npcName:11000173$ may know something about the stolen weapons.\nFor now, take the iron ore sales flyer \
    $npc:11000170$ gave you and head to $map:02000083$, where the entrance to $map:02000141$ is said to be!"
set quest[questID=10001021] manual "Get $item:30000103$ from $npc:11000170$"
set quest[questID=10001021] complete "Find $map:02000083$"
set quest[questID=10001022] name "Source of the Iron Ore"
set quest[questID=10001022] desc "Among the $item:30000018$ I found, $npc:11000365$ gave me the trade record of \
    $npc:11000173$ buying iron ore from $npcName:11000171$.\n$npc:11000171$ runs a junkyard in $map:02000084$! \
    Where would a mere junk dealer get so much iron ore? First, let's meet $npc:11000171$ in $map:02000084$."
set quest[questID=10001022] manual "Get $item:30000105$ from $npc:11000365$"
set quest[questID=10001022] complete "Meet $npc:11000171$ in $map:02000084$"
set quest[questID=10001023] name "Whereabouts of the Delivery Truck"
set quest[questID=10001023] desc "$npc:11000171$ said the Goldus delivery truck that carried off the iron ore came \
    from $map:02000001$.\nIf $npcName:11000171$ is telling the truth, $npc:11000012$ in $map:02000001$ may know \
    where the truck was headed.\nLet's go to $map:02000001$ and meet $npc:11000012$."
set quest[questID=10001023] complete "Meet $npc:11000012$ in $map:02000001$"
set quest[questID=10001024] name "A Suspicious Delivery"
set quest[questID=10001024] desc "After leafing through the shipping log for quite a while, $npc:11000012$ finally \
    found the record.\nThe truck's destination was 125 Royal Road in $map:02000064$!\nWho could have received the \
    iron ore?\nLet's go to $map:02000064$!"
set quest[questID=10001024] complete "Find 125 Royal Road in $map:02000064$"
set quest[questID=10001025] name "The Truth About the Armory Theft"
set quest[questID=10001025] desc "A suspicious ledger found in $map:02000020$... \nIt looks like a record of royal \
    goods being traded... \nFirst, let's take the ledger back to $map:02000001$ and meet $npc:11000169$."
set quest[questID=10001025] manual "Take the suspicious ledger from the desk in $map:02000020$"
set quest[questID=10001025] complete "Return to $npc:11000169$ in $map:02000001$"
set quest[questID=10001026] name "To Nelf's House!"
set quest[questID=10001026] desc "The address of $npc:11000492$'s house that $npc:11000012$ found in the address \
    book was 674 Flower Park in $map:02000119$.\nLet's look for the house with the repaired red roof in the Flower \
    Park district. "
set quest[questID=10001026] complete "Find and enter $map:02000122$ in $map:02000119$"
set quest[questID=10001027] name "A Mysterious Memo"
set quest[questID=10001027] desc "Can we really find a clue to trace Nelf's movements inside \
    $map:02000122$?\nSearch every corner of $map:02000122$ in $map:02000119$ and find a clue that can trace Nelf's \
    whereabouts."
set quest[questID=10001027] manual "Find a clue to Nelf's whereabouts in $map:02000122$ in $map:02000119$"
set quest[questID=10001027] complete "Find $map:52000037$ in $map:02000043$ as written in the memo"
set quest[questID=10001028] name "What Nelf Left Behind"
set quest[questID=10001028] desc "I made it to $map:52000037$ in $map:02000043$, marked on the crumpled memo... \
    but sadly, $npc:11000492$ was already dead.\nThen an unidentified person appeared at just that moment, opened \
    a secret door in the cave, and disappeared. If I follow that highly suspicious figure, could I find a clue to \
    all of this?\nCollect yourself, and follow the unidentified person deep into the cave."
set quest[questID=10001028] manual "Follow the unidentified person who vanished through the secret door in \
    $map:52000037$ and find a clue"
set quest[questID=10001028] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=10001029] name "A New Clue"
set quest[questID=10001029] desc "After hearing about $npc:11000492$'s death and the mysterious notebook found \
    nearby, $npc:11000169$ asked you to report your findings so far directly to $npc:11000119$.\nLet's meet \
    $npcName:11000119$ in $map:02000001$. "
set quest[questID=10001029] manual "Get the mysterious notebook back from $npc:11000169$ in $map:02000001$"
set quest[questID=10001029] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10001030] name "Monkey Mischief"
set quest[questID=10001030] desc "It seems $npc:21000055$ from $map:02000017$ often wander into $map:02000064$ and \
    cause trouble, stealing residents' belongings and messing up their homes.\nThe $item:30000019$ of \
    $npc:11000172$ was probably also taken by $npc:21000055$ from $map:02000017$. The $npc:21000055$ are said to \
    hide things they cannot eat among the tree branches in the forest, so let's shake the trees in $map:02000017$ \
    and look for the $item:30000019$!"
set quest[questID=10001030] manual "Find the $item:30000019$ among the tree branches in $map:02000017$"
set quest[questID=10001030] complete "Return the $item:30000019$ to $npc:11000172$ in $map:02000064$"
set quest[questID=10001031] name "Just Between Us"
set quest[questID=10001031] desc "$npc:11000172$ in $map:02000064$ reluctantly changed his mind and opened the \
    door of $map:02000020$.\nI should look around $map:02000020$ and get out quickly."
set quest[questID=10001031] manual "Enter $map:02000020$ from $map:02000064$"
set quest[questID=10001031] complete "Meet $npc:11000172$ in $map:02000064$"
set quest[questID=10001040] name "The Last Letter"
set quest[questID=10001040] desc "Hearing $npc:11000012$ out, I vaguely recall how $npc:11000492$ used to look \
    after his mother so warmly.\nA son's last letter to his mother...\nI am not sure I can look the mother of \
    $npc:11000492$ in the eye as she receives a letter from a son she can never see again,\nbut thinking of a \
    mother waiting for her son, I should hurry as fast as I can.\nTake the $item:30000025$ from $npc:11000012$ to \
    $map:02000076$ and meet $npc:11000178$."
set quest[questID=10001040] manual "Get $item:30000025$ from $npc:11000012$"
set quest[questID=10001040] complete "Deliver the letter to $npc:11000178$ in $map:02000076$"
set quest[questID=10001060] name "Tires Worth Money"
set quest[questID=10001060] desc "$npc:11000395$ is a resident of the $map:02000084$ slums who earns one day's \
    food with one day's work. Hearing that carrying heavy scrap tires every day has left his whole body too weak \
    to even stand, I would feel heavy-hearted just walking past.\nLet's move the scrap tires piled up around \
    $npc:11000395$ in $map:02000084$ over to the junkyard area where $npc:11000171$ and the laborers are working. \
    "
set quest[questID=10001060] manual "Move the scrap tires to the junkyard in $map:02000084$"
set quest[questID=10001060] complete "Meet $npc:11000180$ in $map:02000084$"
set quest[questID=10001080] name "An Unfortunate Family"
set quest[questID=10001080] desc "It was odd to see frozen ground and ice sculptures in the middle of green \
    meadows, but to think those ice sculptures were real people frozen solid... \nAmong the frozen people on the \
    ice field at the center of $map:02000085$, find $npc:11000186$'s older sister $npc:11000188$ and thaw her with \
    the warmth of the $item:30000028$.\nFirst, break off a branch of the red maple tree next to $npc:11000186$ and \
    head down to the ice field."
set quest[questID=10001080] manual "Break off the $item:30000028$ next to $npc:11000186$|Find $npc:11000188$ among \
    the victims frozen at the center of $map:02000085$ and thaw her "
set quest[questID=10001080] complete "Meet $npc:11000186$ in $map:02000085$"
set quest[questID=10001081] name "Sister Is Back"
set quest[questID=10001081] desc "Considering how long she was frozen, $npc:11000188$ coming back to life seems a \
    miracle.\nI should meet $npc:11000188$ and warmly hold her hand.\nLet's go inside $map:02000150$."
set quest[questID=10001081] complete "Meet $npc:11000188$ in $map:02000150$"
set quest[questID=10001150] name "Trash Is Money Too"
set quest[questID=10001150] desc "$npc:11000396$, a resident of the $map:02000084$ slums, looks too weak to even \
    stand after going hungry for days. For the exhausted man, let's collect the $item:30000120$ scattered all over \
    $map:02000084$ and bring them over."
set quest[questID=10001150] manual "Collect $item:30000120$ in $map:02000084$"
set quest[questID=10001150] complete "Meet $npc:11000396$ in $map:02000084$"
set quest[questID=10001160] name "Whose Notebook Is It?"
set quest[questID=10001160] desc "A notebook with the Barota Company logo, found in the luggage near the dead \
    $npc:11000492$... \nCan this solve the questions surrounding $npc:11000492$'s death?\nFirst, let's head to \
    $map:02000139$, where the Barota Company headquarters is."
set quest[questID=10001160] manual "Get $item:30000114$ from $npc:11000119$"
set quest[questID=10001160] complete "Find the Barota Company headquarters in $map:02000139$"
set quest[questID=10001170] name "The Notebook's Secret"
set quest[questID=10001170] desc "$npc:11000097$ was certain it was the notebook of Barota Company chief Raymon, \
    but upon checking its contents, he panicked and dropped it.\nWhat on earth was written in that notebook to \
    cause such a reaction?"
set quest[questID=10001170] manual "Get $item:30000114$ from $npc:11000097$"
set quest[questID=10001170] complete "Talk with $npc:11000208$ in $map:02000139$"
set quest[questID=10001171] name "A Forbidden Trade"
set quest[questID=10001171] desc "Is $item:20000046$ really among the goods stored by the Barota Company? \nLet's \
    find the Barota Company warehouse in $map:02000139$ and look over the goods kept around it.\nThe warehouse is \
    at the end of the road leading down from right in front of $npc:11000208$."
set quest[questID=10001171] manual "Find $item:20000046$ around the Barota Company warehouse in $map:02000139$"
set quest[questID=10001171] complete "Return to $npc:11000208$ in $map:02000139$"
set quest[questID=10001172] name "Request for Support"
set quest[questID=10001172] desc "Raymon has been missing for days... What was his connection with Nelf?\nGo to \
    $map:02000152$ in $map:02000100$ and meet the Dark Wind captain $npc:11000044$."
set quest[questID=10001172] manual "Get $item:30000114$ from $npc:11000208$"
set quest[questID=10001172] complete "Meet $npc:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=10001180] name "Back-Breaking Work"
set quest[questID=10001180] desc "Carrying $item:30000048$ off a ship is dangerous even for a veteran laborer who \
    has worked in $map:02000139$ for years. One moment of carelessness can hurt your back.\nBut I cannot just \
    ignore a request from someone in pain... I should help move the red container $item:30000048$ to the pier.\nOn \
    the pier where containers are stacked in rows, put the cargo boxes $npc:11000207$ asked about where the red \
    containers are placed!"
set quest[questID=10001180] manual "Move the $item:30000048$ on the ship docked at $map:02000139$ to the pier"
set quest[questID=10001180] complete "Meet $npc:11000207$ in $map:02000139$"
set quest[questID=10001190] name "The Troubled Oil Pipes"
set quest[questID=10001190] desc "Oil seems to be a very important resource across all of Kerning City \
    life.\nBefore the problem grows, I should hurry and remove the rust from the rusty pipes among the oil pipes \
    in $map:02000148$ and repair them."
set quest[questID=10001190] manual "Repair the rusty pipes in $map:02000148$"
set quest[questID=10001190] complete "Meet $npc:11000543$ in $map:02000148$"
set quest[questID=10001200] name "Where Did Raymon Go?"
set quest[questID=10001200] desc "$npc:11000044$ gave you a mission to secretly infiltrate the Black Star Society \
    and find out whether they know where $npc:11000526$ is.\nA covert mission that Dark Wind cannot officially \
    undertake... \nCan it succeed?\nFirst, head to $map:02000138$ and find out where the Black Star Society's base \
    is."
set quest[questID=10001200] complete "Ask around for the Black Star Society's base in $map:02000138$"
set quest[questID=10001201] name "Secret Club"
set quest[questID=10001201] desc "$map:02000149$?\nA secret arcade run covertly by the Black Star Society... \
    \nLet's go find $map:02000149$."
set quest[questID=10001201] complete "Find $map:02000149$ in $map:02000138$"
set quest[questID=10001202] name "Everything You Know"
set quest[questID=10001202] desc "To make $npc:11000212$ talk, who blusters that you are bad for business, it \
    seems the only way is to disrupt his arcade business.\nChase out every customer inside the arcade until \
    $npc:11000212$ talks!"
set quest[questID=10001202] manual "Chase out all the customers inside $map:02000149$"
set quest[questID=10001202] complete "Talk with $npc:11000212$ in $map:02000149$"
set quest[questID=10001203] name "Black Office"
set quest[questID=10001203] desc "$npc:11000212$, the manager of $map:02000149$, gave you the Black Star Society \
    recruit password, Code Black 365, and told you how to get from $map:02000149$ to $map:02000156$.\nThey say the \
    small iron door you find after leaving $map:02000149$, going ten squares southeast and then eleven squares \
    northeast, is the entrance to $map:02000156$...\nFirst, let's find $map:02000156$ in $map:02000138$."
set quest[questID=10001203] manual "Find the entrance to $map:02000156$ in $map:02000138$"
set quest[questID=10001203] complete "Meet $npc:11000251$ at $map:02000156$"
set quest[questID=10001210] name "Nothing Is Free"
set quest[questID=10001210] desc "What on earth is so special about $item:20000015$... \nIf giving back what you \
    receive is the rule of this alley, I have no choice but to follow it... \nLet's defeat the monsters in the \
    $map:02000138$ alley and bring back the $item:20000015$."
set quest[questID=10001210] manual "Defeat the monsters in the $map:02000138$ alley and find $item:20000015$"
set quest[questID=10001210] complete "Meet $npc:11000211$ in $map:02000138$"
set quest[questID=10001220] name "Resolve"
set quest[questID=10001220] desc "$npc:11000044$ told you to pass an order to $npc:11000215$ to step up the wanted \
    notice for $npc:11000064$."
set quest[questID=10001220] complete "Meet $npc:11000215$ at $map:02000153$ in $map:02000100$"
set quest[questID=10001221] name "The Hunt Begins"
set quest[questID=10001221] desc "$npc:11000215$ in $map:02000153$ asked for help posting wanted flyers for \
    $npc:11000064$ on the bulletin boards of each district. "
set quest[questID=10001221] manual "Get $item:30000038$ from $npc:11000215$"
set quest[questID=10001221] complete "Find $npc:11000343$ in $map:02000138$"
set quest[questID=10001222] name "Wanted Duty, Part One"
set quest[questID=10001222] desc "Post the wanted flyer for $npc:11000064$ on the $npc:11000343$ in \
    $map:02000138$.\nIf you lost the $item:30000038$, go back to $npc:11000215$ in $map:02000153$ and ask."
set quest[questID=10001222] manual "Prepare the wanted flyer for $npc:11000064$|Post the wanted flyer for \
    $npc:11000064$ on the $npc:11000343$ in $map:02000138$"
set quest[questID=10001222] complete "Find $npc:11000343$ in $map:02000137$"
set quest[questID=10001223] name "Wanted Duty, Part Two"
set quest[questID=10001223] desc "Post the wanted flyer for $npc:11000064$ on the $npc:11000343$ in \
    $map:02000137$.\nIf you lost the $item:30000038$, go back to $npc:11000215$ in $map:02000153$ and ask."
set quest[questID=10001223] manual "Prepare the wanted flyer for $npc:11000064$|Post the wanted flyer for \
    $npc:11000064$ on the $npc:11000343$ in $map:02000137$"
set quest[questID=10001223] complete "Find $npc:11000343$ in $map:02000135$"
set quest[questID=10001224] name "Wanted Duty, Part Three"
set quest[questID=10001224] desc "Post the wanted flyer for $npc:11000064$ on the $npc:11000343$ in \
    $map:02000135$.\nIf you lost the $item:30000038$, go back to $npc:11000215$ in $map:02000153$ and ask."
set quest[questID=10001224] manual "Prepare the wanted flyer for $npc:11000064$|Post the wanted flyer for \
    $npc:11000064$ on the $npc:11000343$ in $map:02000135$"
set quest[questID=10001224] complete "Find $npc:11000343$ in $map:02000146$"
set quest[questID=10001225] name "Wanted Duty, Final"
set quest[questID=10001225] desc "Post the wanted flyer for $npc:11000064$ on the $npc:11000343$ in \
    $map:02000146$.\nIf you lost the $item:30000038$, go back to $npc:11000215$ in $map:02000153$ and ask."
set quest[questID=10001225] manual "Prepare the wanted flyer for $npc:11000064$|Post the wanted flyer for \
    $npc:11000064$ on the $npc:11000343$ in $map:02000146$"
set quest[questID=10001225] complete "Meet $npc:11000260$ in $map:02000146$"
set quest[questID=10001260] name "God of Sales"
set quest[questID=10001260] desc "$npc:11000311$ in $map:02000166$ says that if you go to $map:02000136$ and bring \
    back a bulk order from $npc:11000220$ for the materials needed to build Rockefeller Tower, he will tell you \
    everything he saw."
set quest[questID=10001260] complete "Meet $npc:11000220$ in $map:02000136$"
set quest[questID=10001261] name "Sales Results"
set quest[questID=10001261] desc "$npc:11000220$ in $map:02000136$ handed you an order form listing the \
    construction materials needed to build Rockefeller Tower.\nReturn to $npc:11000311$ in $map:02000166$!"
set quest[questID=10001261] manual "Get $item:30000175$ from $npc:11000220$"
set quest[questID=10001261] complete "Meet $npc:11000311$ in $map:02000166$"
set quest[questID=10001280] name "Dutiful Monica"
set quest[questID=10001280] desc "I cannot brush off the request of $npc:11000221$, a shy girl with round \
    eyes.\nIt is an easy favor, so let's find $npc:11000222$ in $map:02000136$ and deliver the lunchbox."
set quest[questID=10001280] manual "Get $item:30000044$ from $npc:11000221$"
set quest[questID=10001280] complete "Deliver the lunchbox to $npc:11000222$ in $map:02000136$"
set quest[questID=10001360] name "For Our Comrades"
set quest[questID=10001360] desc "$npc:11000260$ resented $npc:11000064$ and poured out the hardships of being a \
    Shadow Gate Guardian.\nHelp the Guardians and defeat the monsters that crossed over from the Land of Darkness \
    around the Shadow Door in $map:02000146$."
set quest[questID=10001360] manual "Defeat the monsters around the Shadow Door"
set quest[questID=10001360] complete "Meet $npc:11000260$ in $map:02000146$"
set quest[questID=10001370] name "Emergency"
set quest[questID=10001370] desc "It is an emergency. \nGo to $map:02000026$ in $map:02000146$ and meet \
    $npc:11000122$!"
set quest[questID=10001370] complete "Go find $npc:11000122$ at $map:02000026$"
set quest[questID=10001371] name "The Trampled Mushroom Patch"
set quest[questID=10001371] desc "As the power of the Land of Darkness grows stronger, the mushroom patch near the \
    lab has been completely tainted by shadow energy.\nCan we really get any $item:20000045$ usable as medicine \
    ingredients?\nBeware of the Shadow Poison you can catch from ground tainted by shadow energy, and gather \
    $item:20000045$ from the mushroom patch near the lab and all around $map:02000146$!"
set quest[questID=10001371] manual "Gather $item:20000045$ in $map:02000146$"
set quest[questID=10001371] complete "Return to $npc:11000122$ at $map:02000026$"
set quest[questID=10001372] name "The Miracle Medicine"
set quest[questID=10001372] desc "Put the $item:20000045$ into the mixer at $map:02000026$ in $map:02000146$ and \
    run it to make $item:20000016$."
set quest[questID=10001372] manual "Make $item:20000016$ with the mixer at $map:02000026$"
set quest[questID=10001372] complete "Meet $npc:11000261$ in $map:02000146$"
set quest[questID=10001380] name "The Assistant's Duty"
set quest[questID=10001380] desc "$npc:11000121$ says that to uncover the source of the shadow energy, together \
    with $npc:11000122$ they will break through the barrier sealing the Shadow Door in $map:02000146$ and study \
    the DNA of the monsters that crossed over from the Land of Darkness. \nDefeat the monsters around the Shadow \
    Door in $map:02000146$, collect $item:20000047$, and bring them to $npc:11000121$!"
set quest[questID=10001380] manual "Defeat the monsters around the Shadow Door in $map:02000146$ and collect \
    $item:20000047$"
set quest[questID=10001380] complete "Meet $npc:11000121$ in $map:02000146$"
set quest[questID=10001390] name "Find the Spy"
set quest[questID=10001390] desc "If we gather every last shard of the shattered Blue Lapenta, it can be \
    restored... so the way to bring peace back to this world has not vanished entirely.\nFind the spy \
    $npc:21000178$ disguised as Dark Wind near the Shadow Door in $map:02000146$ and get the $item:30000058$ \
    back!"
set quest[questID=10001390] manual "Find the spy disguised as Dark Wind in $map:02000146$ and recover the \
    $item:30000058$"
set quest[questID=10001390] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=10001403] desc "The Red Cape, a mysterious figure who threatens the world with Devlin at its \
    side!\nIts true identity is Bella Vidblame... \nthe daughter of Royal Prime Minister $npc:11000074$ and the \
    twin younger sister of $npc:11000058$... and now she has returned as a servant of evil, ruled by shadow \
    energy.\nIt is the moment when a painful memory no one wanted to bring back, like a taboo, descends on \
    $map:02000001$!\n"
set quest[questID=10001411] name "Tight-Lipped"
set quest[questID=10001480] desc "$npcName:11000293$, the owner of the log burrow, is about to leave because \
    monsters have gnawed the bark and dug into his nest... but he is in tears at the thought of leaving the \
    $item:20000052$ behind.\nI do not know how sticky the spider webs $npc:11000293$ so loathes really are, but \
    for $npc:11000293$, who lost his nest and was driven out, let's find the $item:20000052$ inside the wooden \
    barrel and bring it to him.  "
set quest[questID=10001500] name "Steadfast, Unchanging"
set quest[questID=10001500] desc "$npc:11000097$ seems to be struggling hard to protect the Barota Company, left \
    in shambles by chief $npc:11000526$'s corruption.\nIt would be good to grant $npcName:11000097$'s request and \
    lend him even a little help."
set quest[questID=10001500] complete "Meet $npc:11000426$ in $map:02000085$"
set quest[questID=10001501] name "Fear of Wolves"
set quest[questID=10001501] desc "$npc:11000426$ said he cannot just hand over the $item:30000072$, and demanded \
    that you catch all the wolves in $map:02000085$ that he is afraid of."
set quest[questID=10001501] manual "Defeat the $npc:21000063$ in $map:02000085$"
set quest[questID=10001501] complete "Meet $npc:11000426$ in $map:02000085$"
set quest[questID=10001502] name "With the Golden Carp"
set quest[questID=10001502] desc "$npc:11000426$ handed over the $item:30000256$ as promised. Thinking of \
    $npc:11000097$ waiting anxiously, it would be best to return to $map:02000139$ quickly."
set quest[questID=10001502] manual "Get $item:30000256$ from $npc:11000426$ in $map:02000085$"
set quest[questID=10001502] complete "Meet $npc:11000097$ in $map:02000139$"
set quest[questID=10001600] desc "$npc:11000341$ says that for $map:02000178$ to settle steadily in \
    $map:02000171$, it is important to win the hearts of the Koropu tribe.\nTo win them over, let's grant \
    $npc:11000341$'s request to get rid of the monsters harassing the Koropu tribe in $map:02000171$!"
set quest[questID=10001630] desc "$npc:11000203$ living in $map:02000059$ was convinced that $npc:21000041$ had \
    stolen his axe. According to him, $npc:21000041$ steal woodcutters' axes, stick them into their own bodies, \
    and wander around as $npc:21000045$... Why on earth would they harm themselves like this?\nFirst, it seems \
    best to check whether $npc:21000045$ really stole $npcName:11000203$'s axe. Let's go to $map:02000058$, where \
    $npc:21000045$ often appear. "
set quest[questID=10001633] name "A Kindhearted Girl"
set quest[questID=10001634] name "The Girl's Request"
set quest[questID=10001640] name "The Harbor Rogues"
set quest[questID=10001640] desc "$npc:11000207$ in $map:02000139$ asked you to defeat the monsters that go around \
    smashing the harbor's cargo.\nCutting off the bond formed by helping him once would be too cold.\nLet's grant \
    $npcName:11000207$'s request!"
set quest[questID=10001640] manual "Defeat the monsters in $map:02000139$"
set quest[questID=10001640] complete "Meet $npc:11000207$ in $map:02000139$"
set quest[questID=10001660] name "Suspicious Iron Ore"
set quest[questID=10001660] desc "$npc:11000004$ said the reason he bought iron ore from $npc:11000170$ in a \
    hurry, without thinking it through, is that iron ore is hard to come by these days.\nWhere did \
    $npcName:11000170$ get such hard-to-find iron ore that he could sell it so cheaply to a merchant? \nAs \
    $npc:11000004$ suggested, could it be iron ore made by melting down finished weapons?\nIf so, might the stolen \
    weapons also have been melted down into iron ore?     \nFirst, let's go to $map:02000140$ and find out where \
    $npc:11000170$ is."
set quest[questID=10001660] complete "Find out where $npc:11000170$ is in $map:02000140$"
set quest[questID=10001661] name "Find Broker Ralph!"
set quest[questID=10001661] desc "The street hip-hop boys we met in $map:02000083$ showed off their rhythm, gave a \
    warning, and told us $map:02000141$ lies northeast of $map:02000083$.\nJust how dangerous is that place to \
    cause such a fuss?\nLet's find the entrance to $map:02000141$ at the far northeast end of $map:02000083$!"
set quest[questID=10001661] complete "Find and enter $map:02000141$ at the far northeast end of $map:02000083$ and \
    meet $npc:11000173$"
set quest[questID=10001662] name "Ralph's Taunt"
set quest[questID=10001662] desc "Clinging to $npc:11000173$ any longer will likely gain us little.\nAt a time \
    like this, bulldozing through and searching every corner of $map:02000141$ may be the answer. Along the way we \
    might find a useful clue or meet an ally who can help us.\nLet's wander around $map:02000141$ defeating \
    $npc:11000173$'s henchmen.\n$map:02000141$ is located in $map:02000083$."
set quest[questID=10001662] manual "Defeat $npc:11000173$'s henchmen in $map:02000141$"
set quest[questID=10001662] complete "Talk to the person hiding in the sewer of $map:02000141$"
set quest[questID=10001663] name "Traces of Fenced Goods"
set quest[questID=10001663] desc "Tired of living on the run from $npc:11000173$, $npc:11000365$ plans to steal \
    $npc:11000173$'s fenced goods documents and hand them to the Royal Guard or Dark Wind in exchange for his own \
    safety.\nI do not know his full story, but among the $item:30000018$ that $npcName:11000365$ asked us to find, \
    there is probably a trade record showing who he bought the iron ore from and resold it to.\nOpen the safes set \
    into the walls of each room in $map:02000141$, find the $item:30000018$ stored inside, and bring them to \
    $npc:11000365$.\n$map:02000141$ is located in $map:02000083$."
set quest[questID=10001663] manual "Open Ralph's secret safes in $map:02000141$ and find the $item:30000018$"
set quest[questID=10001663] complete "Meet $npc:11000365$ in $map:02000141$"
set quest[questID=10001690] name "The Dignity of Wolf Pelts"
set quest[questID=10001710] name "Water Tank Inspection Period"
set quest[questID=10001710] desc "$npc:11000393$ of the $map:02000083$ district came to do the regular water tank \
    inspection, but could not take a single step because of the monsters' rampage, and is said to be on his two \
    hundred and fifty-first deep breath.\nIn $npc:11000393$'s place, inspect the water tanks on the rooftops of \
    the buildings in $map:02000083$ and collect the $item:30000117$."
set quest[questID=10001710] manual "Inspect the water tanks in $map:02000083$ and collect the $item:30000117$"
set quest[questID=10001710] complete "Meet $npc:11000393$ in $map:02000083$"
set quest[questID=10001720] name "The Mart Raid"
set quest[questID=10001720] desc "Monsters roaming $map:02000083$ turned into robbers and raided $map:02000121$. \
    The staff of $map:02000121$ barely escaped with their lives from the sudden onslaught, but if the cash in the \
    register is all stolen, the mart owner will suspect them of being in league with the robbers.\nTo keep the \
    kind, powerless staff from being wronged, go to $map:02000121$ and recover the registers and all the cash the \
    robbers took!"
set quest[questID=10001720] manual "Recover the cash in $map:02000121$"
set quest[questID=10001720] complete "Meet $npc:11000394$ in $map:02000083$"
set quest[questID=10001740] name "The Source of the Stench"
set quest[questID=10001740] desc "$npc:11000399$, who came to $map:02000092$ to find out why the water hardened, \
    is suffering from the nose-piercing stench.\nThe cause of the stench is the great vine moss and the \
    $npc:21000387$ believed to have grown from the wastewater flowing in from $map:02000084$!!\nFind and remove \
    the great vine moss growing around where the wastewater flows into $map:02000092$, and defeat the \
    $npc:21000387$!"
set quest[questID=10001740] manual "Defeat the $npc:21000387$ around the polluted area of $map:02000092$|Remove \
    the great vine moss around the polluted area of $map:02000092$"
set quest[questID=10001740] complete "Meet $npc:11000399$ in $map:02000092$"
set quest[questID=10001741] name "Dad Is the Superintendent"
set quest[questID=10001741] desc "$npc:11000174$ is worried because her dad, who manages $map:02000092$, has not \
    come home for days.\nFind $npc:11000400$, $npc:11000174$'s dad, and tell him his daughter is worried and he \
    should go home. "
set quest[questID=10001741] complete "Meet $npc:11000400$ in $map:02000092$"
set quest[questID=10001742] name "The Hardening Water"
set quest[questID=10001742] desc "There was a reason $npc:11000400$ could not go home for days.\nThe water \
    upstream of $map:02000092$ is slowly hardening from the center outward! A field survey is needed to find the \
    cause of this anomaly, but the nonstop monsters make it impossible to even approach.\nGet rid of the monsters \
    rampaging on the hardened water upstream of $map:02000092$."
set quest[questID=10001742] manual "Defeat the monsters on the hardened water upstream of $map:02000092$"
set quest[questID=10001742] complete "Meet $npc:11000400$ in $map:02000092$"
set quest[questID=10001750] desc "$npc:11000402$ and $npc:11000403$ fell into the venom leaking from \
    $map:02000043$ and were poisoned!\nThey need the $item:20000060$ of $npc:21000078$ to neutralize the \
    poison.\nDefeat the $npc:21000078$ that sometimes appear on the grasslands of $map:02000043$ and collect the \
    $item:20000060$."
set quest[questID=10001780] name "Back in Place"
set quest[questID=10001780] desc "$npc:11000148$, who manages the village warehouse in $map:63000001$, tried to \
    load the $item:30000130$ produced in $map:63000001$ onto a ship bound for the mainland, but a sudden problem \
    with the departure means the $item:30000130$ must be carried back in front of $map:63000004$.\nLet's help move \
    the $item:30000130$ in front of $map:63000004$, at least until $npc:11000148$'s back gets better!"
set quest[questID=10001780] manual "Move the $item:30000130$ around $npc:11000148$ in front of the village \
    warehouse in $map:63000001$"
set quest[questID=10001810] name "Missing My Granddaughter"
set quest[questID=10001810] desc "$npc:11000419$, a doctor at the $map:02000100$ hospital, handed over a photo of \
    $npc:11000424$'s granddaughter, who went missing while leaving the hospital after treatment not long ago, and \
    asked you to give it to $npc:11000424$.\nFor $npc:11000424$, who spends every day in tears missing his beloved \
    granddaughter who vanished one day, the photo must be more precious than anything.\nFind $npc:11000424$ in \
    $map:02000100$ and deliver the photo of his granddaughter."
set quest[questID=10001810] manual "Get $item:30000134$ from $npc:11000419$"
set quest[questID=10001810] complete "Meet $npc:11000424$ in $map:02000100$"
set quest[questID=10001811] name "The Monster Girl's Secret"
set quest[questID=10001811] desc "$npc:11000424$ carefully asked you to check whether the mysterious monster girl \
    who sometimes appears in $map:02000147$ might be his granddaughter's doll.\nSince even one item $npc:22090165$ \
    was carrying would tell right away whether it is his granddaughter's doll, bring something $npc:22090165$ has \
    and show it to $npc:11000424$."
set quest[questID=10001811] manual "(Elite) Bring $npc:22090165$'s item"
set quest[questID=10001811] complete "Meet $npc:11000424$ in $map:02000100$"
set quest[questID=10001870] name "The Only Clue"
set quest[questID=10001870] desc "$npc:11000492$ recalled the address written in $npc:11000170$'s peddler notebook \
    and told you to go to $map:02000092$ and search for $npc:11000170$'s whereabouts.\nNothing ventured, nothing \
    gained.\nFirst, let's go to $map:02000092$ and look for $npc:11000170$!"
set quest[questID=10001870] complete "Find $npc:11000170$ in $map:02000092$"
set quest[questID=10001880] name "Delivery Champion"
set quest[questID=10001880] desc "While looking through the shipping log, $npc:11000012$ asked you to deliver a \
    parcel to $npc:11000492$ in $map:02000140$.\nIf it helps find the whereabouts of the delivery truck that \
    carried the iron ore even a little sooner, this is nothing.\nTake the parcel from $npc:11000012$ and go to \
    $map:02000140$."
set quest[questID=10001880] manual "Get the parcel from $npc:11000012$"
set quest[questID=10001880] complete "Meet $npc:11000492$ at $map:02000140$"
set quest[questID=10001881] name "Words of Thanks"
set quest[questID=10001881] desc "$npc:11000492$ did not forget to thank $npc:11000012$ too.\nHis attitude of \
    being thankful for even small things and considerate of others seems to be what moves people's hearts.\nGo to \
    $npc:11000012$ in $map:02000001$ and pass on $npc:11000492$'s greetings."
set quest[questID=10001881] complete "Meet $npc:11000012$ in $map:02000001$"
set quest[questID=10001890] name "Broken Trust"
set quest[questID=10001890] desc "While $npc:11000169$ reports the armory theft and $npc:11000492$'s corruption to \
    $npc:11000119$, he asked you to keep watch over $npc:11000492$ so he does not run off.\nGo to $map:02000140$ \
    and watch $npc:11000492$'s movements."
set quest[questID=10001890] complete "Go to $map:02000140$"
set quest[questID=10001891] name "Growing Suspicion"
set quest[questID=10001891] desc "The door of $map:02000140$, where $npc:11000492$ always greeted people with a \
    bright smile, was shut tight.\nWhere did $npc:11000492$ go...?\nThe part-timer $npc:11000373$, who always \
    stands at the taxi stop in plain view of $map:02000140$ handing out flyers, might have seen something."
set quest[questID=10001891] complete "Meet $npc:11000373$ in $map:02000001$"
set quest[questID=10001892] name "The Vanished Nelf"
set quest[questID=10001892] desc "$npc:11000373$ said he saw $npc:11000492$, who hardly ever leaves $map:02000140$ \
    empty, leave saying he had to stop by home.\nAsk $npc:11000012$ for $npc:11000492$'s home address."
set quest[questID=10001892] complete "Meet $npc:11000012$ in $map:02000001$"
set quest[questID=10001900] name "The First Step of the Search"
set quest[questID=10001900] desc "While $npc:11000044$ gathers the Dark Wind members to form a search party to \
    find evidence of $npc:11000526$'s corruption, he asked you to go to $map:02000157$, meet $npc:11000065$, and \
    get permission to search the Barota Company.\nWhatever the job, you must button the first button \
    right!\nReport everything to $npc:11000065$ and get permission to search the Barota Company."
set quest[questID=10001900] complete "Meet $npc:11000065$ in $map:02000157$"
set quest[questID=10001901] name "Search Warrant"
set quest[questID=10001901] desc "$npc:11000065$ issued the $item:30000165$, with a request that the matter be \
    wrapped up by exposing only chief $npc:11000526$'s personal corruption, so that the whole Barota Company does \
    not collapse over this. \nReturn to $map:02000152$ and meet $npc:11000044$."
set quest[questID=10001901] manual "Get $item:30000165$ from $npc:11000065$"
set quest[questID=10001901] complete "Meet $npc:11000044$ in $map:02000152$"
set quest[questID=10001902] name "Contraband Crackdown"
set quest[questID=10001902] desc "$npc:11000044$ said a tip came in that $map:02000209$ is selling the banned junk \
    food $item:20000015$ together with $item:20000046$, and ordered you to check the distribution route.\nIf, as \
    $npc:11000044$ suspects, $npc:11000526$ is connected to the distribution of $item:20000015$, we might get an \
    unexpected lead on his whereabouts.\nFind the $item:20000015$ at $map:02000209$ in $map:02000147$, then meet \
    $npc:11000491$."
set quest[questID=10001902] manual "Inspect the display shelves at $map:02000209$ in $map:02000147$|Obtain \
    $item:20000015$"
set quest[questID=10001902] complete "Meet $npc:11000491$ at $map:02000209$ in $map:02000147$"
set quest[questID=10001903] name "A New Lead"
set quest[questID=10001903] desc "As promised, $npc:11000491$ told you about the distribution route of \
    $item:20000015$, and mentioned that the Black Star Society may have been involved in how $npc:11000526$ hid \
    his whereabouts.\nIt is merely $npc:11000491$'s guess with no evidence yet, but it might be the decisive clue \
    to finding $npc:11000526$.\nFirst, return to $map:02000152$ and meet $npc:11000044$."
set quest[questID=10001903] complete "Meet $npc:11000044$ in $map:02000152$"
set quest[questID=10002000] name "Business Rights Rivalry"
set quest[questID=10002000] desc "$npc:11000491$ says he needs the support of $npc:11000245$ to win the oil \
    development rights for $map:02000148$.\n$npc:11000245$ does not open his heart easily... How can we get his \
    referral signature on the $item:30000166$?\nFirst, go to $map:02000148$ and meet $npc:11000245$."
set quest[questID=10002000] complete "Meet $npc:11000245$ in $map:02000148$"
set quest[questID=10002001] name "The Labor of Persuasion"
set quest[questID=10002001] desc "$npc:11000245$ in $map:02000148$ advised that if you want his recommendation for \
    the business rights, you must first win over the laborers working at $map:02000148$.\nBuild friendships by \
    helping out the laborers $npc:11000353$, $npc:11000533$ and $npc:11000543$ of $map:02000148$, who toil all day \
    under the blazing sun."
set quest[questID=10002001] manual "Help $npc:11000543$ with [The Troubled Oil Pipes]|Help $npc:11000353$ with \
    [The Cobras Are Angry]|Help $npc:11000533$ with [Wretched Arsonists]"
set quest[questID=10002001] complete "Meet $npc:11000245$ in $map:02000148$"
set quest[questID=10002002] name "True Fruits"
set quest[questID=10002002] desc "$npc:11000245$ signed in the referrer box and returned the \
    $item:30000167$.\nDeliver the $item:30000167$ to $npc:11000491$ at $map:02000209$."
set quest[questID=10002002] manual "Get $item:30000167$ from $npc:11000245$"
set quest[questID=10002002] complete "Meet $npc:11000491$ at $map:02000209$ in $map:02000147$"
set quest[questID=10002010] name "Wretched Arsonists"
set quest[questID=10002010] desc "$npc:11000533$ in $map:02000148$ is at his wits' end over the monsters that \
    pierce the oil pipes and set them on fire.\nIf the monsters were even slightly fewer, $npc:11000533$ and the \
    laborers here could work much more easily, so let's defeat the troublemaking monsters of $map:02000148$. "
set quest[questID=10002010] manual "Defeat the monsters in $map:02000148$"
set quest[questID=10002010] complete "Meet $npc:11000533$ in $map:02000148$"
set quest[questID=10002020] name "Find the Gold Bars!"
set quest[questID=10002020] desc "$npc:11000251$, the Black Star Society godfather, said he would accept you into \
    the organization if you find all the gold bars the organization's traitor squirreled away.\nYou must quickly \
    find the gold bar bags hidden around $map:02000138$, or defeat the monsters that made off with the gold and \
    take the $item:30000168$ they carry.\nTo find $npc:11000526$, you must be recognized and earn trust as a \
    member of the Black Star Society.\nMove fast."
set quest[questID=10002020] manual "Find and gather $item:30000168$ in $map:02000138$"
set quest[questID=10002020] complete "Meet $npc:11000251$ at $map:02000156$"
set quest[questID=10002021] name "Investigating the Incident"
set quest[questID=10002021] desc "$npc:11000251$ ordered you to find out what happened at $map:02000144$.\nLet's \
    go to $map:02000144$."
set quest[questID=10002021] complete "Go to $map:02000144$"
set quest[questID=10002022] name "Legwork at the Scene"
set quest[questID=10002022] desc "$npc:11000213$, whom you met at the entrance of $map:02000144$, kept repeating \
    how horrible it was and told you to ask $npc:11000534$ for the details of the incident.\nLet's meet \
    $npc:11000534$, who is examining the scene at $map:02000144$."
set quest[questID=10002022] complete "Meet $npc:11000534$ in $map:02000144$"
set quest[questID=10002023] name "Incident Report"
set quest[questID=10002023] desc "$npc:11000534$ said the ID found near the body bore the name \
    $npc:11000526$.\n$npc:11000526$... did I mishear?\nThen does that mean $npc:11000526$ died in \
    $map:02000144$... \nIt is hard to believe, but let's report what we learned at $map:02000144$ to \
    $npc:11000251$.\nReturn to $map:02000156$."
set quest[questID=10002023] complete "Meet $npc:11000251$ at $map:02000156$ in $map:02000138$"
set quest[questID=10002030] name "Raymon's Death"
set quest[questID=10002030] desc "I met $npc:11000524$, whom I had met in $map:02000139$, again at \
    $map:02000144$.\nTo boost his record as Dark Wind, it seems he had been privately tracking $npc:11000526$'s \
    whereabouts after the search of the Barota Company ended.\nAnd then he happened upon the scene at \
    $map:02000144$... Whether heaven is helping him as he says, I cannot tell, but what matters now is that all \
    the circumstances strongly suggest the person who died alone in this secluded back alley is \
    $npc:11000526$.\nTake the $item:30000036$ you got from $npc:11000524$ to $npc:11000044$ at $map:02000153$."
set quest[questID=10002030] manual "Get $item:30000036$ from $npc:11000524$ at $map:02000144$"
set quest[questID=10002030] complete "Meet $npc:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=10002031] name "The Blocked Road"
set quest[questID=10002031] desc "After much thought, $npc:11000044$ declared that with $npc:11000526$'s death the \
    investigation, from the armory theft through $npc:11000492$'s corruption and death, would be closed.\nReturn \
    to $map:02000001$ and report the closing of the investigation to $npc:11000119$."
set quest[questID=10002031] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10002040] name "Vigilante Support Mission"
set quest[questID=10002040] desc "$npc:11000119$ said an urgent request for support came from the vigilantes at \
    $map:02000076$, and told you to set out ahead of the Royal Guard reinforcements, assess the situation, and \
    help $npc:11000015$.\nSet out for $map:02000076$."
set quest[questID=10002040] complete "Meet $npc:11000015$ in $map:02000076$"
set quest[questID=10002041] name "Save the Northeast Outpost!"
set quest[questID=10002041] desc "$npc:11000015$ says the vigilantes' northeast outpost in $map:02000054$ was \
    ambushed by mysterious monsters, and asks you to defend it together with the vigilantes.\nGo to \
    $map:02000054$, defeat the bats with demon wings that attacked the northeast outpost, and help the \
    vigilantes!"
set quest[questID=10002041] manual "Wake the knocked-out vigilantes around the northeast outpost in \
    $map:02000054$|Defeat the $npc:21000191$ around the northeast outpost in $map:02000054$"
set quest[questID=10002041] complete "Meet $npc:11000547$ in $map:02000054$"
set quest[questID=10002042] name "A Strange Object"
set quest[questID=10002042] desc "$npc:11000547$ at the northeast outpost in $map:02000054$ asks you to deliver to \
    $npc:11000015$ the $item:30000172$ he took in a bloody fight with the boss who led the $npc:21000191$ in their \
    raid on the outpost.\nReturn to $map:02000076$!"
set quest[questID=10002042] manual "Get $item:30000172$ from $npc:11000547$"
set quest[questID=10002042] complete "Meet $npc:11000015$ in $map:02000076$"
set quest[questID=10002043] name "The Blacksmith of Nerman"
set quest[questID=10002043] desc "$npc:11000015$ asked you to deliver the $item:30000172$ that $npc:11000547$ \
    passed along to the blacksmith $npc:11000508$ in $map:02000203$. Go to $map:02000203$."
set quest[questID=10002043] manual "Get $item:30000172$ from $npc:11000015$"
set quest[questID=10002043] complete "Meet $npc:11000508$ in $map:02000203$"
set quest[questID=10002050] name "A Special Order"
set quest[questID=10002050] desc "$npc:11000508$ in $map:02000203$ asked you to deliver the $item:30000173$ to \
    $npc:11000015$."
set quest[questID=10002050] manual "Find the $item:30000173$ on the workbench behind $npc:11000508$ in \
    $map:02000203$"
set quest[questID=10002050] complete "Meet $npc:11000015$ in $map:02000076$"
set quest[questID=10002051] name "The Captain's Heart"
set quest[questID=10002051] desc "$npc:11000015$ asked you to deliver the $item:30000173$ that $npc:11000508$ gave \
    you to $npc:11000119$ in $map:02000001$. Return to $map:02000001$."
set quest[questID=10002051] manual "Get $item:30000173$ from $npc:11000015$"
set quest[questID=10002051] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10002052] name "At the Front Line"
set quest[questID=10002052] desc "$npc:11000119$ brought good news and frightening news: the vigilantes guarding \
    the $map:02000115$ outpost, who had been cut off when the ground split in an earthquake, have made contact, \
    but a merciless $npc:23000001$ is appearing there.\nIt is a joy and a relief that the comrades $npc:11000015$ \
    missed are safe, but the appearance of a terrifying being that threatens the safety of $map:02000001$ is no \
    cause for cheer.\nLet's deliver the $item:30000173$ to the vigilantes at the $map:02000115$ outpost. Find the \
    narrowest gap in the broken ground of $map:02000115$ and fly across."
set quest[questID=10002052] manual "Get $item:30000173$ from $npc:11000119$"
set quest[questID=10002052] complete "Meet a vigilante on the broken ground of $map:02000115$"
set quest[questID=10002053] name "For Victory"
set quest[questID=10002053] desc "$npc:11000548$ at the $map:02000115$ outpost asked you to use the \
    $item:30000173$ to repair the broken crossbows."
set quest[questID=10002053] manual "Get $item:30000173$ from $npc:11000548$|Repair the broken crossbows on the \
    broken ground of $map:02000115$"
set quest[questID=10002053] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10002064] desc "$npc:11000551$ in $map:02000238$ asked you to return to $map:02000001$, hand the \
    $item:30000174$ to $npc:11000119$, and request reinforcements."
set quest[questID=10002070] name "A New Turn"
set quest[questID=10002070] desc "$npc:11000119$ said he received word from $npc:11000044$ that circumstances \
    suggest $npc:11000529$ of $map:02000100$ is connected to the theft of the Levee's goods, and told you to help \
    with his investigation."
set quest[questID=10002070] complete "Meet $npc:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=10002071] name "So I Heard Through Rumors"
set quest[questID=10002071] desc "$npc:11000044$ told you to question the residents of $map:02000100$ about anyone \
    who has seen or knows of the Humblis, and to find their hideout."
set quest[questID=10002071] complete "Meet $npc:11000232$ in $map:02000100$"
set quest[questID=10002072] name "Witness Statement"
set quest[questID=10002072] desc "$npc:11000232$, a resident of $map:02000100$, told you what he has heard about \
    the Humblis, and said $npc:11000233$ probably knows more."
set quest[questID=10002072] complete "Meet $npc:11000233$ in $map:02000100$"
set quest[questID=10002073] name "The Lawless Thugs, Humblis"
set quest[questID=10002073] desc "$npc:11000233$, a resident of $map:02000100$, says his twin younger sister, who \
    works as a maid in $map:02000137$, told him she saw the Humblis bullying students in school uniforms with her \
    own eyes.\nGo to $map:02000137$ and keep asking about the Humblis."
set quest[questID=10002073] complete "Learn more about the Humblis in $map:02000137$"
set quest[questID=10002074] name "The Hidden Truth"
set quest[questID=10002074] desc "In $map:02000137$ I met students who suffered at the hands of the Humblis. \
    Seeing them frozen stiff, straight-backed from how badly they were beaten, the Humblis seem far nastier than I \
    thought.\nThey said they would come back to $npc:11000219$, so the culprit may still be somewhere \
    nearby.\nLook around $map:02000137$ and search for the Humblis."
set quest[questID=10002074] complete "Search for the Humblis in $map:02000137$"
set quest[questID=10002075] name "The Humblis Hideout"
set quest[questID=10002075] desc "$npc:11000218$, whom I met while searching for the Humblis in $map:02000137$, \
    told a story completely different from what I had learned. The students being punished in front of the railway \
    were actually the delinquents who had been bullying $npc:11000218$, and the Humblis were righteous champions \
    who had helped $npc:11000218$...!!\nBy luck, $npc:11000218$ slipped up and revealed that $map:02000208$ is \
    somewhere in the abandoned building in $map:02000166$. \nGo to $map:02000166$ and find the abandoned building \
    slated for demolition. "
set quest[questID=10002075] complete "Meet $npc:11000565$ at $map:02000208$ in $map:02000166$"
set quest[questID=10002076] name "Clearly Innocent"
set quest[questID=10002076] desc "$npc:11000529$, whom I met at $map:02000208$, told me why he left Dark Wind and \
    about his past with $npc:11000044$.\nThe $npc:11000064$ that $npc:11000529$ firmly believes in...\nWhat is the \
    truth about him?\nGo to $map:02000152$ and report your findings to $npc:11000044$."
set quest[questID=10002076] complete "Meet $npc:11000044$ in $map:02000152$"
set quest[questID=10002080] name "The Traceless Raid"
set quest[questID=10002080] desc "$npc:11000529$, whom I met at $map:02000208$, advised that if you truly want the \
    real truth, it is better to retrace where the box came from before going straight to report to \
    $npc:11000044$.\nBefore acting rashly, it seems wise to check whether any suspicious people have been seen \
    recently in $map:02000166$."
set quest[questID=10002080] complete "Meet $npc:11000311$ in $map:02000166$"
set quest[questID=10002081] name "The Trap"
set quest[questID=10002081] desc "Was $npc:11000529$ right that it is all a conspiracy and a trap? \
    \n$npc:11000311$, the construction merchant in $map:02000166$, relayed what he overheard suspicious people \
    whispering near the abandoned building shrouded in darkness.\nI should go to $map:02000208$ in $map:02000166$ \
    and tell $npc:11000529$ about this."
set quest[questID=10002081] complete "Meet $npc:11000529$ at $map:02000208$ in $map:02000166$"
set quest[questID=10002090] name "Between Watching and Guarding"
set quest[questID=10002090] desc "$npc:11000044$ says he fears losing Win Steelton's only daughter, \
    $npc:11000069$, to $npc:11000064$ as well.\nThe horrible memory he says he witnessed that day seems to have \
    left him with a trauma he cannot erase.\nGo to $map:02000147$, find the\nDark Wind member guarding the area \
    around $map:02000205$, and check that $npc:11000069$'s daily life is trouble-free."
set quest[questID=10002090] manual "Get $item:30000176$ from $npc:11000044$"
set quest[questID=10002090] complete "Meet $npc:11000258$ in $map:02000147$"
set quest[questID=10002091] name "Her Daily Life"
set quest[questID=10002091] desc "$npc:11000258$ asked you to check whether $npc:11000069$, who has not been \
    leaving the house, is doing well and has nothing wrong."
set quest[questID=10002091] complete "Go to $map:02000205$ in $map:02000147$"
set quest[questID=10002092] name "The Unseen Truth"
set quest[questID=10002092] desc "$npc:11000069$ seemed wary of strangers visiting and wished to be left in \
    peace."
set quest[questID=10002092] complete "Meet $npc:11000044$ in $map:02000152$"
set quest[questID=10002250] name "Missing Mother"
set quest[questID=10002250] desc "$npc:11000221$ in $map:02000136$ said that $npc:11000242$ in $map:02000135$ told \
    $npc:11000221$ that her mother might be alive in the Land of Darkness, and asked you to visit and find out the \
    details."
set quest[questID=10002250] complete "Meet $npc:11000242$ in $map:02000135$"
set quest[questID=10002251] name "Shadow World Research"
set quest[questID=10002251] desc "$npc:11000242$ in $map:02000135$ told you about the $item:39000010$ that his \
    regular customer $npc:11000384$ happened to get hold of, and said you should meet him."
set quest[questID=10002251] complete "Meet $npc:11000384$ in $map:02000135$"
set quest[questID=10002252] name "Seeking the Shadow Door"
set quest[questID=10002252] desc "$npc:11000384$ in $map:02000135$ said he sold the $item:39000010$ to \
    $npc:11000609$ and told you to go to $map:02000146$."
set quest[questID=10002252] complete "Meet $npc:11000609$ in $map:02000146$"
set quest[questID=10002271] desc "$npc:11000064$ expects that $npc:11000044$ will slip into the Land of Darkness \
    through an invisible passage in $map:02000146$, and asks you to search $map:02000308$."
set quest[questID=10002273] desc "$npc:11000064$ expects that $npc:11000044$ will someday return stronger, and \
    asks you to tell the Guardians that $npc:11000044$ has vanished completely into the Land of Darkness."
set quest[questID=10002274] desc "$npc:11000076$ tells you to report to $npc:11000075$ that $npc:11000044$ has \
    vanished completely into the Land of Darkness."
set quest[questID=10002290] name "Secret Orders"
set quest[questID=10002290] desc "$npc:11000076$ told you that special agents of the Secret Knights are carrying \
    out secret missions in the Land of Darkness, and invited you to join them.\nA dangerous but meaningful life \
    suits someone who wants to be a hero better than a safe but pointless one.\nThe Land of Darkness, where the \
    great evil threatening this world is said to sleep...! No matter how dangerous it is, let's not be afraid in \
    advance!"
set quest[questID=10002290] manual "Get $item:30000217$ from $npc:11000076$"
set quest[questID=10002290] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002291] name "Welcome to Hell"
set quest[questID=10002291] desc "$npc:11000804$ told you to go outside $map:03009001$ and defeat $npc:40000024$ \
    on your honor.\nDo I really have to prove myself like that? ...But if I turn back now, I will be branded a \
    coward.\nDefeat $npc:40000024$ with your head held high and protect your pride!"
set quest[questID=10002291] manual "Defeat $npc:40000024$ at $map:03000014$ in the Land of Darkness"
set quest[questID=10002291] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002292] name "Shadow Report"
set quest[questID=10002292] desc "I went to the trouble of defeating $npc:40000024$ and came back, only to hear \
    all this talk about skill...?\nI do not know how skilled $npc:11000804$ really is, but I feel a stubborn urge \
    to someday get an apology out of him for looking down on me.\nBusiness is business, and personal is \
    personal!\nFirst, let's carry out the assigned mission."
set quest[questID=10002292] manual "Get $item:30000218$ from $npc:11000804$ at $map:03009001$ in the Land of \
    Darkness"
set quest[questID=10002292] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=10002300] name "Covert and Great"
set quest[questID=10002300] desc "$npc:11000076$ in $map:02000146$ said there is a new mission to carry out in the \
    Land of Darkness, and told you to go to $map:03009001$ and meet $npc:11000804$. "
set quest[questID=10002300] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002301] name "The Investigation Resumes"
set quest[questID=10002301] desc "$npc:11000804$ at $map:03009001$ said you must use $npc:11000070$ to learn \
    where,\nand how $item:20000046$ is made and distributed, and gave you a mission to approach $npc:11000070$ as \
    if you\ncame to buy $item:20000046$ and find out its source and distribution route."
set quest[questID=10002301] complete "Meet $npc:11000070$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002302] name "A Dangerous Deal"
set quest[questID=10002302] desc "$npc:11000070$ demanded $item:30000194$ as the condition for the $item:20000046$ \
    deal.\nUnlike Karma, $item:30000194$ is just a useless chip of stone... What does he plan to do with a pile of \
    them...? First, let's get some $item:30000194$, which are known to drop one or two at a time from hunting the \
    monsters that roam the Land of Darkness."
set quest[questID=10002302] manual "Defeat monsters in the Land of Darkness and get $item:30000194$"
set quest[questID=10002302] complete "Meet $npc:11000070$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002303] name "Undercover Investigation"
set quest[questID=10002303] desc "$npc:11000070$ introduced $npc:11000610$, the supplier of $item:20000046$, and \
    said he would keep the $item:30000194$ as a referral fee.\nIt feels like being fleeced, but to gather more \
    information it seems best to let it slide this once.\nGo outside the shelter and meet $npc:11000610$."
set quest[questID=10002303] complete "Meet $npc:11000610$ at $map:03000014$ in the Land of Darkness"
set quest[questID=10002304] name "Seeking the Source!"
set quest[questID=10002304] desc "$npc:11000610$ said that if you want to get $item:20000046$, you should go to \
    $map:03000134$ and meet\n$npc:11000806$, the first developer of $item:20000046$."
set quest[questID=10002304] complete "Meet $npc:11000806$ at $map:03000134$ in the Land of Darkness"
set quest[questID=10002305] name "Lepen's Scheme"
set quest[questID=10002305] desc "$npc:11000806$, stressed by the tyranny of the $npc:40000023$, agreed to deal \
    with the $npc:40000023$ in a way that was not quite agreeing.\nHis thoroughness in always leaving himself an \
    escape hatch in case things go wrong seems to be the source of his strength to survive here.  "
set quest[questID=10002305] manual "Defeat $npc:40000023$ at $map:03000134$ in the Land of Darkness"
set quest[questID=10002305] complete "Meet $npc:11000806$ at $map:03000134$ in the Land of Darkness"
set quest[questID=10002306] name "Investigation Report"
set quest[questID=10002306] desc "$npc:11000806$ in $map:03000134$ seems to take great pride in being the first to \
    develop $item:20000046$. But... for the safety and peace of Maple World, he would have been far better off \
    making digestives in a corner of the Goldus pharmaceutical factory.\nWe must take drastic measures so that \
    $npc:11000806$'s grand and vicious dream of ruling and controlling people with his drug never comes true."
set quest[questID=10002306] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002307] name "The Papa Powder Production Site"
set quest[questID=10002307] desc "$npc:11000804$ said the illegal distribution of $item:20000046$ must be torn out \
    by the root, and gave you a mission to clear out $map:03009021$ and return.\nFind and enter $map:03009021$ \
    underground in $map:03000134$, defeat the guards watching over it, and collect all the $item:30000216$ used as \
    raw material for making $item:20000046$."
set quest[questID=10002307] manual "Defeat the monsters in $map:03009021$|Collect $item:30000216$"
set quest[questID=10002307] complete "Meet $npc:11000805$ at $map:03009021$ in the Land of Darkness"
set quest[questID=10002308] name "Trust Beyond Repair"
set quest[questID=10002308] desc "$npc:11000805$, whom I met at $map:03009021$, acted as if he would not deal with \
    anyone who is not the Lumina Liberation Army.\nWho is the Lumina Liberation Army...? Why is $npc:11000805$ \
    acting this way...?\nFirst, return to $map:03009001$ and report to $npc:11000804$ in detail about what \
    happened at $map:03009021$."
set quest[questID=10002308] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002310] name "The Lumina Liberation Army"
set quest[questID=10002310] desc "$npc:11000804$ said $npc:11000564$ at $map:03009001$ is known as the Land of \
    Darkness's information broker, and told you to find out whether he knows anything about the Lumina Liberation \
    Army."
set quest[questID=10002310] complete "Meet $npc:11000564$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002311] name "Find the Password"
set quest[questID=10002311] desc "$npc:11000564$ told you the Lumina Liberation Army's last gathering place was \
    the Solar Energy Test Center in $map:03000134$.\nThe Solar Energy Test Center... is the building with solar \
    panels\non its roof among the buildings along the road from $map:03000134$ to $map:03000092$.\nGo there and \
    look for clues or traces that could lead to the Lumina Liberation Army."
set quest[questID=10002311] manual "Find a clue to track the Lumina Liberation Army in $map:03000134$"
set quest[questID=10002311] complete "Meet $npc:11000613$ at $map:03009022$ in the Land of Darkness"
set quest[questID=10002312] name "Their Own Rules"
set quest[questID=10002312] desc "$npc:11000613$ at $map:03009022$ in the Land of Darkness says he will give you a \
    chance to help the Liberation Army's efforts, and tells you to meet $npc:11000615$."
set quest[questID=10002312] complete "Meet $npc:11000615$ at $map:03009022$ in the Land of Darkness"
set quest[questID=10002313] name "A Sad Parting"
set quest[questID=10002313] desc "$npc:11000615$ at $map:03009022$ in the Land of Darkness tells you to find \
    $npc:11000614$, who has been running around day and night searching for his separated younger sister, and lend \
    a hand."
set quest[questID=10002313] complete "Meet $npc:11000614$ at $map:03000135$ in the Land of Darkness"
set quest[questID=10002314] name "The Rabbit's Lure"
set quest[questID=10002314] desc "$npc:11000614$ at $map:03000135$ in the Land of Darkness says the clock rabbits \
    $npc:40000022$, who lured him and his sister into the Land of Darkness and kidnapped them, carry \
    $item:30000211$, and that obtaining and examining them might give a clue to finding his sister.\nDefeat the \
    $npc:40000022$ and get the $item:30000211$!"
set quest[questID=10002314] manual "Defeat the $npc:40000022$ in $map:03000135$ and obtain $item:30000211$"
set quest[questID=10002314] complete "Meet $npc:11000614$ at $map:03000135$ in the Land of Darkness"
set quest[questID=10002315] name "An Unexpected Bond"
set quest[questID=10002315] desc "$npc:11000614$ at $map:03000135$ in the Land of Darkness told you what happened \
    in the Tower of Slaves and the story of how he formed a bond with $npc:11000064$.\n$npc:11000064$ was \
    imprisoned in the Tower of Slaves... What happened to him?\nGo to $map:03009001$ and report to \
    $npc:11000804$."
set quest[questID=10002315] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002316] name "The Original Mission"
set quest[questID=10002316] desc "$npc:11000804$ at $map:03009001$ in the Land of Darkness tells you to return to \
    Maple World and report everything, including the Lumina Liberation Army and news of $npc:11000064$, to \
    $npc:11000076$ in $map:02000146$."
set quest[questID=10002316] complete "Meet $npc:11000076$ at $map:02000146$ in Maple World"
set quest[questID=10002320] name "The Operation Begins"
set quest[questID=10002320] desc "$npc:11000613$ says that through the $item:30000211$ carried by the \
    $npc:40000022$ he learned that $npc:11000614$'s sister is imprisoned in $map:03009023$, and that he has \
    planned what is called the '$map:03009023$ Rescue Operation'."
set quest[questID=10002320] manual "Get $item:30000213$ from $npc:11000804$ at $map:03009022$"
set quest[questID=10002320] complete "Deliver $item:30000213$ to $npc:11000614$ at $map:03000135$"
set quest[questID=10002321] name "Quiet and Quick"
set quest[questID=10002321] desc "$npc:11000614$ says he has confirmed the orders given to him, and tells you to \
    deliver the $item:30000213$ to $npc:11000616$ in $map:03000136$."
set quest[questID=10002321] manual "Get $item:30000213$ from $npc:11000614$ at $map:03000135$"
set quest[questID=10002321] complete "Deliver $item:30000213$ to $npc:11000616$ at $map:03000136$"
set quest[questID=10002322] name "The Real Thing"
set quest[questID=10002322] desc "$npc:11000616$ in $map:03000136$ asks you to get the $item:30000214$ and \
    $item:30000215$ needed to prepare for the $map:03009023$ Rescue Operation.\nThe $item:30000214$ can be taken \
    from the $npc:40000020$ roaming $map:03000136$, and the $item:30000215$ can be taken from the yellow drums \
    found all over $map:03000136$."
set quest[questID=10002322] manual "Defeat $npc:40000020$ and obtain $item:30000214$|Find Boatan oil in the yellow \
    drums in $map:03000136$"
set quest[questID=10002322] complete "Meet $npc:11000616$ in $map:03000136$"
set quest[questID=10002323] name "If Only We Could Block That Road"
set quest[questID=10002323] desc "$npc:11000616$ in $map:03000136$ asks you to take the $item:30000214$ and, as \
    part of the $map:03009023$ Rescue Operation, set them at the passages in $map:03000146$\nleading to other \
    areas."
set quest[questID=10002323] manual "Set the $item:30000214$ at the passage from $map:03000146$ leading to \
    $map:03000136$|Set the $item:30000214$ at the passage from $map:03000146$ leading to $map:03000145$"
set quest[questID=10002323] complete "Meet $npc:11000616$ in $map:03000136$"
set quest[questID=10002324] name "Ready to Go"
set quest[questID=10002324] desc "$npc:11000616$ in $map:03000136$ tells you to return to $map:03009022$ and let \
    $npc:11000613$ know the operation preparations are complete."
set quest[questID=10002324] complete "Meet $npc:11000613$ at $map:03009022$ in $map:03000135$"
set quest[questID=10002325] name "The Great Shadow Rescue!"
set quest[questID=10002325] desc "$npc:11000613$ tells you to go to $map:03009023$ and, together with the Lumina \
    Liberation Army, save the people wrongly imprisoned there."
set quest[questID=10002325] manual "Get $item:30000251$ in $map:03009023$ and free the imprisoned people|Rescue \
    $npc:11000807$ in $map:03009023$|Clear out the monsters in $map:03009023$"
set quest[questID=10002325] complete "Meet $npc:11000614$ in $map:03000135$"
set quest[questID=10002326] name "Her Sister Is Back"
set quest[questID=10002326] desc "$npc:11000614$ at $map:03000135$ is overjoyed that he safely rescued his beloved \
    sister $npc:11000807$, whom he had longed for day and night.\nLet's meet $npc:11000807$ before she returns to \
    Maple World."
set quest[questID=10002326] complete "Meet $npc:11000807$ at $map:03009024$ in $map:03000135$"
set quest[questID=10002327] name "In That Place... "
set quest[questID=10002327] desc "$npc:11000807$ told you of the terrible things she endured in the Tower of \
    Slaves before she was rescued.\nThe person who remains in her memory, with yellow hair... old goggles... and a \
    torn red cape... the description reminds you of $npc:11000064$, who was said to have been taken to \
    $map:02000213$."
set quest[questID=10002327] complete "Meet $npc:11000613$ at $map:03009022$ in $map:03000135$"
set quest[questID=10002328] name "Another Bond"
set quest[questID=10002328] desc "$npc:11000613$ says the Lumina Liberation Army will help the Guardians' \
    activities, but only for work that benefits the good, ordinary residents of Maple World\nand requires no one's \
    sacrifice."
set quest[questID=10002328] complete "Meet $npc:11000804$ at $map:03009001$ in the Land of Darkness"
set quest[questID=10002329] name "Joining Hands"
set quest[questID=10002329] desc "$npcName:11000804$ tells you to return to $map:02000146$ and ask $npc:11000076$ \
    for the Guardians' support so that the survivors rescued in the $map:03009023$ Rescue Operation can return to \
    their normal lives."
set quest[questID=10002329] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=10002330] name "The End of That Road"
set quest[questID=10002330] desc "$npc:11000872$ says investigating the venom that flows around the Land of \
    Darkness may reveal many things, and that he will thoroughly explore the Poison Cave found in \
    $map:03000014$.\nAs $npc:11000872$ says, there is no telling what you may meet inside the Poison Cave, so do \
    not let your guard down for a moment and explore to the end.\nDo not forget to prepare $item:20000060$ in case \
    of emergency."
set quest[questID=10002330] manual "Explore the Poison Cave to the end"
set quest[questID=10002330] complete "Meet $npc:11000872$ at $map:03000014$ in the Land of Darkness"
set quest[questID=10002331] name "Another Secret Agent"
set quest[questID=10002331] desc "$npc:11000804$ is worried that $npc:11000872$, who is carrying out a secret \
    mission in the Land of Darkness alongside him, left a long time ago and has not returned.\nLet's look for \
    $npc:11000872$ in $map:03000014$."
set quest[questID=10002331] complete "Meet $npc:11000872$ at $map:03000014$ in the Land of Darkness"
set quest[questID=10002353] desc "$npc:11000869$ warns that returning to the past is not impossible, but it would \
    disturb the order of time and might open a world more terrifying than the Land of Darkness."
set quest[questID=10002354] name "Unknowable Intentions"
set quest[questID=10002354] desc "$npc:11000058$ wonders what would happen if the order of time collapsed. What \
    thoughts are hidden behind that question?"
set quest[questID=10002354] complete "Meet $npc:11000058$ at $map:02000190$ in $map:02000119$"
set quest[questID=10002611] name "Following Young Bella"
set quest[questID=10002720] desc "$npc:11000031$ in $map:2000023$ told the story of how, long ago, a stalk of \
    darkness grown from a Seed of Darkness coiled around $map:2000023$ and led it to death, and says the same \
    power of darkness has been felt lately.\nHas a Seed of Darkness sprouted and taken root somewhere...?\nFirst, \
    it would be good to lend a hand by defeating the Harvi monsters, carrying deep darkness, that crossed over \
    from the Land of Darkness through the Shadow Door, and help clear away the aura of darkness threatening the \
    world. \nLet's meet $npcName:11000037$, who is collecting Harvi flowers in $map:2000023$ to help the purifying \
    fairies."
set quest[questID=10002870] name "Angry Tiger"
set quest[questID=10002870] desc "$npc:11000160$ in $map:02000001$ asked you to calm down the furious \
    $npcName:11000003$."
set quest[questID=10002870] complete "Meet $npcName:11000003$ in $map:02000001$"
set quest[questID=10002871] name "A Suspicious Feeling"
set quest[questID=10002871] desc "Let's meet $npc:11000169$ in $map:02000001$."
set quest[questID=10002871] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=10002872] name "An Urgent Call"
set quest[questID=10002872] desc "They say $npc:11000169$ in $map:02000001$ is looking for me.\nLet's meet him."
set quest[questID=10002872] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=10002873] name "A Royal Guard Summons"
set quest[questID=10002873] desc "They say $npc:11000119$ in $map:02000001$ is looking for me.\nLet's meet him."
set quest[questID=10002873] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10002874] name "To Dark Wind Headquarters"
set quest[questID=10002874] desc "They say the Dark Wind captain $npcName:11000044$ is looking for me.\nGo to \
    $map:02000152$ in $map:02000100$."
set quest[questID=10002874] complete "Meet $npcName:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=10002875] name "Dark Wind Orders"
set quest[questID=10002875] desc "They say the Dark Wind captain $npcName:11000044$ is looking for me.\nGo to \
    $map:02000152$ in $map:02000100$."
set quest[questID=10002875] complete "Meet $npcName:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=10002876] name "Of One Mind"
set quest[questID=10002876] desc "They say $npc:11000119$ in $map:02000001$ is looking for me.\nLet's meet him."
set quest[questID=10002876] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10002877] name "Daily Life at the Forge"
set quest[questID=10002877] desc "They say $npcName:11000508$ in $map:02000203$ is looking for me.\nLet's meet \
    her."
set quest[questID=10002877] complete "Meet $npcName:11000508$ in $map:02000203$"
set quest[questID=10002878] name "Welcome News"
set quest[questID=10002878] desc "They say $npc:11000119$ in $map:02000001$ is looking for me.\nLet's meet him."
set quest[questID=10002878] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=10002879] name "A Lonely Secret"
set quest[questID=10002879] desc "They say the Dark Wind captain $npcName:11000044$ is looking for me.\nGo to \
    $map:02000152$ in $map:02000100$."
set quest[questID=10002879] complete "Meet $npcName:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=10002880] name "People on the Front Line"
set quest[questID=10002880] desc "Go and meet $npc:11000260$ in $map:02000146$."
set quest[questID=10002880] complete "Meet $npc:11000260$ in $map:02000146$"
set quest[questID=10002881] name "A Special Summons"
set quest[questID=10002881] desc "They say $npc:11000076$ in $map:02000146$ is looking for me.\nLet's go and see \
    him."
set quest[questID=10002881] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=10002882] name "Secret Mission"
set quest[questID=10002882] desc "They say $npc:11000076$ in $map:02000146$ is looking for me.\nLet's go and see \
    him."
set quest[questID=10002882] complete "Meet $npc:11000076$ in $map:02000146$"
set quest[questID=10002883] name "Shelter in the Dark"
set quest[questID=10002883] desc "Go and meet $npcName:11000804$ in $map:03009001$ in the Land of Darkness."
set quest[questID=10002883] complete "Meet $npcName:11000804$ in $map:03009001$ in the Land of Darkness"
set quest[questID=10002884] name "Word from the Liberation Army"
set quest[questID=10002884] desc "Go and find $npcName:11000613$ in $map:03009022$ in $map:03000135$ in the Land \
    of Darkness."
set quest[questID=10002884] complete "Meet $npcName:11000613$ in $map:03009022$ in $map:03000135$ in the Land of \
    Darkness"
set quest[questID=10002908] name "News from the Inn"
set quest[questID=10002908] desc "Master $npcName:11001229$ is looking for me. \nLet's head to $map:52000018$."
set quest[questID=10002908] complete "Meet Master $npcName:11001229$ in $map:52000018$ in $map:02000001$"
set quest[questID=10002910] name "Anxious Steps"
set quest[questID=10002910] desc "Master $npcName:11001229$ is looking for me. \nLet's head to $map:52000018$."
set quest[questID=10002910] complete "Meet Master $npcName:11001229$ in $map:52000018$ in $map:02000001$"
set quest[questID=10002911] name "A Secret Message"
set quest[questID=10002911] desc "They say $npc:11000005$ in $map:02000031$ is looking for me."
set quest[questID=10002911] complete "Meet $npc:11000005$ in $map:02000031$"
set quest[questID=10002912] name "Her Interpretation, Part One"
set quest[questID=10002912] desc "They say $npcName:11001280$, who is staying in $map:02000361$, is looking for \
    me."
set quest[questID=10002912] complete "Meet $npcName:11001280$ in $map:02000361$ in $map:02000076$"
set quest[questID=10002920] name "Watch Their Movements"
set quest[questID=10002920] desc "Dark Wind member $npc:11000215$ has ordered me to keep watch on the Barota \
    Company in $map:02000139$."
set quest[questID=10002920] complete "Go to $map:02000139$ and watch the Barota Company's movements"
set quest[questID=10002921] name "Preparing for the Mission"
set quest[questID=10002921] desc "$npc:11000208$ says word came that I must return to $map:02000153$ at once, and \
    tells me to hurry."
set quest[questID=10002921] complete "Return to $map:02000153$"
set quest[questID=10002990] name "You Were a Fearless One!"
set quest[questID=10003020] name "Rumors in the Back Alleys"
set quest[questID=10003020] desc "$npcName:11000515$ sensed something odd in the restless mood of the back alleys \
    lately, and looked into it. It turns out that on the Empress's orders, the leaders of every faction held a \
    secret meeting in $map:02000001$.\nMeet $npc:11000050$ in $map:02000188$ in $map:02000001$ and find out why \
    the secret meeting was held."
set quest[questID=10003021] name "The Legendary Temple"
set quest[questID=10003021] desc "$npc:11000050$ tells me how everyone joined forces to form the Starlight \
    Expedition to stop the Runeblade traitor $npcName:11001231$.\nThe place where they will chase \
    $npcName:11001231$ is the Rune Temple, where the ancient $npc:23000078$ is said to sleep!\nGo to \
    $map:02000112$ and look for the entrance to the Rune Temple."
set quest[questID=10003021] complete "Find the entrance to the Rune Temple in $map:02000112$"
set quest[questID=10003030] name "A Legend Washed Ashore"
set quest[questID=10003030] desc "$npcName:11000003$ says a rumor is going around that the leaders of every \
    faction held a secret meeting in $map:02000001$.\nMeet $npc:11000119$ in $map:02000001$ and find out why the \
    secret meeting was held."
set quest[questID=10003031] name "The Veiled Temple"
set quest[questID=10003031] desc "$npc:11000119$ tells me how everyone joined forces to form the Starlight \
    Expedition to stop the Runeblade traitor $npcName:11001231$.\nThe place where they will chase \
    $npcName:11001231$ is the Rune Temple, where the ancient $npc:23000078$ is said to sleep!\nGo to \
    $map:02000112$ and look for the entrance to the Rune Temple."
set quest[questID=10003031] complete "Find the entrance to the Rune Temple in $map:02000112$"
set quest[questID=10003040] name "Cold Yet Warm"
set quest[questID=10003040] desc "$npcName:11001675$ asks to meet in secret at $map:52000044$ in $map:02000100$... \
    She seems tense, which is not like her... \nWhat could be going on?"
set quest[questID=10003041] name "The Truth of the Plot"
set quest[questID=10003041] desc "While talking with $npcName:11001733$ in $map:52000044$, Black Star Society \
    members burst in! \nCan we shake them off and reach the garage safely?"
set quest[questID=10003041] manual "Escape from the Black Star Society members together with $npcName:11001733$ at \
    $map:52000044$ in $map:02000100$"
set quest[questID=10003042] name "Searching for Them"
set quest[questID=10003042] desc "After shaking off the members who chased us all the way to $map:52000044$, I \
    heard from $npcName:11000779$ that the people of the back alleys are being held in $map:52000045$.\nTake the \
    vehicle parked at $map:52000044$ in $map:02000100$ and head to $map:52000045$!"
set quest[questID=10003042] manual "Take the vehicle parked at $map:52000044$ in $map:02000100$ and head to \
    $map:52000045$"
set quest[questID=10003042] complete "Meet $npcName:11000779$ at $map:52000046$ in $map:02000138$"
set quest[questID=10003044] name "Limit of Patience"
set quest[questID=10003044] desc "I met $npcName:11000251$ in $map:52000047$, which I entered through a secret \
    passage near the entrance of $map:02000156$ in $map:02000138$!!\nWith a shameless face that shows not a hint \
    of guilt, he taunts me, saying the lives of the back-alley people mean nothing.\nI cannot contain the anger \
    boiling up at his shamelessness."
set quest[questID=10003044] manual "Take down the Black Star Society, led by $npcName:11000251$, at their \
    headquarters in $map:52000047$"
set quest[questID=10003044] complete "Meet $npcName:11000779$ at $map:52000046$ in $map:02000138$"
set quest[questID=10003045] name "News from a Benefactor"
set quest[questID=10003045] desc "A note, probably from the unknown friend I owed my life to in $map:52000045$... \
    It holds a clue to the whereabouts of the back-alley people I have been searching for so long.\nGo to \
    $map:02000275$ and find out more."
set quest[questID=10003045] complete "Head to $map:02000275$"
set quest[questID=10003050] name "Glad Yet Awkward"
set quest[questID=10003050] desc "$npcName:11000003$ greets me with an oddly cheerful hello.\nThis guy... does he \
    know my situation...?"
set quest[questID=10003050] complete "Talk with $npcName:11000003$ in $map:02000001$"
set quest[questID=10003051] name "Sincere Advice"
set quest[questID=10003051] desc "$npcName:11000003$'s sharp advice snapped me out of it.\nIf I only run away \
    because it hurts and scares me, nothing will ever be solved. \nLet's go back to $map:52000039$ in \
    $map:03000145$ and find out for sure what the real truth is."
set quest[questID=10003051] manual "Go back to $map:52000039$ in $map:03000145$ and confirm the truth"
set quest[questID=10003051] complete "Assess the situation in $map:02000138$"
set quest[questID=10003052] name "I Can't Stop!"
set quest[questID=10003052] desc "Each time I collapsed, an unknown figure I met in a place where dream and \
    reality blurred seems to have pushed me out of the Beyond Link.\nBut I cannot give up like this. Who is that \
    one, and who am I... I have to find out. \nLet's go back to $map:52000039$ in $map:03000145$.\n"
set quest[questID=10003052] manual "Return to $map:03000145$ and investigate the Beyond Link again"
set quest[questID=10003052] complete "Examine $npcName:11001759$ in $map:52000040$\n"
set quest[questID=10003053] name "The Master's Footsteps"
set quest[questID=10003053] desc "In $map:52000040$ I caught a glimpse of $npc:11001556$, as if in passing... \
    \nLet's follow those footsteps into the Beyond Link capsule."
set quest[questID=10003053] manual "Follow the truth through the Beyond Capsule in $map:52000040$"
set quest[questID=10003054] name "Return"
set quest[questID=10003054] desc "$npcName:11001557$, whom I met again in $map:52000049$, said I may rejoin \
    Guidance as one of its members. \nLet's go with $npcName:11001557$ to Guidance's new home, $map:52000050$."
set quest[questID=10003054] manual "Go to $map:52000050$ together with $npcName:11001557$"
set quest[questID=10003054] complete "Meet $npcName:11001558$ at $map:52000050$ in $map:02000101$"
set quest[questID=10003055] name "Following the Path of Training"
set quest[questID=10003055] desc "I met $npcName:11001558$ again at $map:52000050$, Guidance's new temporary home \
    in $map:02000101$! \nA long time has passed, but he has not changed. "
set quest[questID=10003055] manual "Hear from $npcName:11001558$ what has happened in the meantime at \
    $map:52000050$ in $map:02000101$"
set quest[questID=10003055] complete "Talk with $npcName:11001557$ at $map:52000050$ in $map:02000101$"
set quest[questID=10003056] name "In Search of the Holy Ground"
set quest[questID=10003056] desc "Birds that flew into $map:52000050$ revealed that the entrance to the final \
    destination of the Munakra training path is in $map:02000192$.\nThis is a chance to find the divine artifact \
    and repay a little of the debt of heart I owe Guidance.\nFollow $npcName:11001557$ and $npcName:11001558$ to \
    $map:02000192$."
set quest[questID=10003056] complete "Find the entrance to the Guide's Sanctuary in $map:02000192$"
set quest[questID=10003057] name "The Guide's Lantern"
set quest[questID=10003057] desc "I think I have found the entrance to the Guide's Sanctuary in $map:02000192$.\nI \
    seem to hear the voices of $npcName:11001558$ and $npcName:11001557$ from inside... \nLet's go in!"
set quest[questID=10003057] manual "Explore the Guide's Sanctuary and find the divine artifact"
set quest[questID=10003057] complete "Talk with $npcName:11001556$ at $map:52000053$, deep inside the Guide's \
    Sanctuary"
set quest[questID=10003058] name "Omen of Fate"
set quest[questID=10003058] desc "$npc:11001556$, whom I met again in $map:52000053$, told me to recover my \
    strength in $map:52000050$, and sent me along with $npcName:11001557$ and $npcName:11001558$ to \
    $map:52000050$.\nThey said that if I examine the glowing stone there, I will learn what to do next... \n"
set quest[questID=10003058] manual "Find and examine the glowing stone at $map:52000050$ in $map:02000101$"
set quest[questID=10003058] complete "Examine the Animar energy at $map:52000050$ in $map:02000101$"
set quest[questID=10003059] name "Setting Out Along That Path"
set quest[questID=10003059] desc "Before leaving for $map:02000275$ as the omen foretold, I should pass word about \
    the people taken away by $npcName:11001559$'s henchmen to the mysterious figure I met in \
    $map:52000045$.\nLet's ask the birds chirping in $map:52000050$."
set quest[questID=10003059] manual "Ask the birds at $map:52000050$ in $map:02000101$ to carry the news"
set quest[questID=10003059] complete "Head to $map:02000275$"
set quest[questID=10003060] name "Boroboro's Rescue Diary"
set quest[questID=10003060] desc "$npcName:11000424$ in $map:02000100$ says she keeps hearing a child crying \
    somewhere far away, maybe just a trick of her ears. \nIs it the grief of losing her granddaughter weighing on \
    her heart... Who could be crying in her ears?\nLet's follow the sound of the crying."
set quest[questID=10003060] manual "Clear the $dungeonTitle:21001001$ dungeon"
set quest[questID=10003060] complete "Talk with $npcName:11000751$ inside $map:02000290$"
set quest[questID=10003061] name "Return to Nature"
set quest[questID=10003061] desc "$npcName:11000233$ in $map:02000100$ winces in pain from the foul smell drifting \
    out of $dungeonTitle:25001001$ in $map:02000167$.\nWhat on earth happened to the beautiful garden?"
set quest[questID=10003061] manual "Clear the $dungeonTitle:25001001$ dungeon"
set quest[questID=10003061] complete "Talk with $npc:11001117$ in $dungeonTitle:25001001$"
set quest[questID=10003063] name "Wings of Freedom"
set quest[questID=10003063] desc "$npc:11000007$ is helping out the Guardians in $map:02000146$!\nWith a troubled \
    face, he says all the chickens at the poultry farm of Mr. $npcName:11001835$, who has looked after him since \
    he was little, have vanished. Since he cannot leave his post, he asks me to go to $map:02000087$ and help \
    $npcName:11001835$ in his place."
set quest[questID=10003063] manual "Clear the $dungeonTitle:25002001$ dungeon"
set quest[questID=10003063] complete "Talk with $npc:11000007$ in $map:02000146$"
set quest[questID=10003064] name "The Savage Guard"
set quest[questID=10003064] desc "$npcName:11000009$, who is serving the Guardians in $map:02000146$, passes on \
    grim rumors from $map:02000023$ and urges me to defeat $npc:23000039$, the savage guard terrorizing the \
    fairies of $map:02000023$."
set quest[questID=10003064] manual "Clear the $dungeonTitle:20012001$ dungeon"
set quest[questID=10003064] complete "Talk with $npcName:11000009$ in $map:02000146$"
set quest[questID=10003065] name "A Dangerous Game of Hide-and-Seek"
set quest[questID=10003065] desc "$npc:11000007$ is helping out the Guardians in $map:02000146$!\nHe reports that \
    the children who were playing in the $map:02000023$ forest have not come home for over half a day, and asks me \
    to head straight to $dungeonTitle:25004001$, find the children and send them home safely."
set quest[questID=10003065] manual "Clear the $dungeonTitle:25004001$ dungeon"
set quest[questID=10003065] complete "Talk with $npc:11001887$ at the end of the $dungeonTitle:25004001$ dungeon"
set quest[questID=10003413] desc "Inside the powerful magical barrier, $npcName:11004744$ looks like he has a lot \
    to say. \nEven after long years of bondage, his eyes still hunger for the truth. \n\nIf I must kill someone \
    who is bound and can do nothing, it need not be done right now. \nSomehow I find myself listening to his \
    story. "
set quest[questID=10003416] name "A Crossroads of Choice"
set quest[questID=10003416] desc "The reason I must learn the truth is not just to satisfy my curiosity. \nI \
    cannot execute $npcName:11004744$ solely on $npc:11004778$'s orders. \n\nTaking someone's life carries \
    weight.\nI must know the truth and then choose. That is the courtesy owed to death. \n\nI must, without fail, \
    uncover the truth. \n\n(If you leave the map, you can re-enter through $npcName:11004795$ in \
    $map:02000146$)\n"
set quest[questID=10003416] manual "Talk with $npcName:11004795$ in $map:52000199$"
set quest[questID=10003416] complete "Talk with $npcName:11004795$ in $map:52000199$"
set quest[questID=10003417] name "Another Truth"
set quest[questID=10003417] desc "I can sense by instinct that I am close to the truth.\nThe truth I heard from \
    $npc:11004778$, or the truth I heard from $npcName:11004744$.\n\nAnd here is yet another person speaking of \
    the truth.\n\n(If you leave the map, you can re-enter through $npcName:11004795$ in $map:02000146$)"
set quest[questID=10003417] manual "Listen to $npcName:11004798$'s story to the end in $map:52000199$\n<font \
    color=\"#909090\">If you leave the map, you can re-enter through $npcName:11004795$ in $map:02000146$</font>"
set quest[questID=10003417] complete "Look closely at $npcName:11004811$ once more in $map:02000146$"
set quest[questID=10003418] name "The Face of Power"
set quest[questID=10003418] desc "This turmoil that began with the dark matter reaches back to the distant past. \
    \n\n$npc:11001812$ and $npcName:11003894$, who along with $npcName:11004744$ are said to have tried to seal \
    the Lapenta even at the cost of their lives.\n$npc:11004778$ calls them traitors who threaten the Empress's \
    safety and are creating dark matter in $map:02000001$. \nYet the accounts of $npc:11001812$ and \
    $npcName:11004744$ held together in their own way, and in their eyes I could see the grim resolve of those \
    speaking the truth. \n$npc:11004778$ is the loyal Prime Minister who has guarded Empress Ereb's safety in the \
    royal court for many long years. \n\nI should talk to $npc:11004778$ about the two truths. \n\n(If you leave \
    the map, you can re-enter through $npcName:11004826$ at $map:52000189$ in $map:02000001$)\n"
set quest[questID=10003418] manual "Break down the door of $map:52000190$ in $map:02000001$ and try to escape the \
    dungeon"
set quest[questID=10003418] complete "Examine $npcName:11004800$ and gather your thoughts"
set quest[questID=10003419] name "Hours of Anguish"
set quest[questID=10003419] desc "Faced with two truths that cannot coexist, I should have remembered that one can \
    be buried in the shadow of a lie. \n\nIf the accounts of the two men who contradicted $npc:11004778$ about the \
    past, $npc:11004778$ and $npcName:11004744$, are true, then I should have doubted $npc:11004778$, who tried to \
    kill $npcName:11004744$. \n\nWhen I told $npc:11004778$ what I had learned, fear flashed across his eyes. \
    \n\nAnd then he locked me up here.\nI have to escape. \n\n(If you leave the map, you can re-enter through \
    $npcName:11004826$ at $map:52000189$)\n"
set quest[questID=10003419] manual "Examine $npcName:11004800$ again and gather your thoughts"
set quest[questID=10003419] complete "Examine $npcName:11004800$ again and gather your thoughts"
set quest[questID=10003420] name "An Unexpected Meeting"
set quest[questID=10003420] desc "Much of what I have believed until now is wavering. \nAs $npcName:11003894$ \
    said, I must choose between truth and falsehood. \n\nAnd I have gained a big clue. \nIt is the bare face of \
    $npc:11004778$, the fear I saw in the eyes of one hiding a lie.\n\nWas the reason $npc:11004778$ tried to kill \
    $npcName:11004744$ to hide the truth?\nI have to escape from here, but I cannot think of a way. \n\n(If you \
    leave the map, you can re-enter through $npcName:11004826$ at $map:52000189$)"
set quest[questID=10003420] manual "Talk with Empress $npcName:11004786$, who appeared in $map:52000190$ in \
    $map:02000001$"
set quest[questID=10003420] complete "Talk with Empress $npcName:11004786$, who appeared in $map:52000190$ in \
    $map:02000001$"
set quest[questID=10003421] name "Between Lies and Truth"
set quest[questID=10003421] desc "I was locked up alone in $map:52000190$ when I saw the faint silhouette of \
    someone in a hood.\nAs the faint silhouette drew closer and pulled back the hood in front of me, I saw that it \
    was $npc:11000075$.\n\n$npc:11000074$ had been reporting a distorted truth to \
    $npc:11000075$.\n\n$npc:11000075$ had been told that I was swayed by $npcName:11004788$, who was consumed by \
    the power of darkness, but did not seem to fully believe it.\nDoubting $npcName:11004778$'s report, she may \
    have come to $map:52000198$ in person. \n\nWhile I was telling her what I had learned, smoke seemed to rise \
    from somewhere, and soon flames shot up.\n\n(If you leave the map, you can re-enter through $npcName:11004826$ \
    at $map:52000189$)"
set quest[questID=10003421] manual "Confess everything you have learned so far to Empress $npcName:11004786$, who \
    appeared in $map:52000190$ in $map:02000001$"
set quest[questID=10003421] complete "Confess everything you have learned so far to Empress $npcName:11004786$, \
    who appeared in $map:52000190$ in $map:02000001$"
set quest[questID=10003422] name "Into the Flames"
set quest[questID=10003422] desc "The fire is taking over the underground prison in an instant. \nI have to \
    escape!\n\nBut if I leave like this, what will become of $npcName:11004744$... \nI cannot leave him behind."
set quest[questID=10003422] manual "Try to rescue $npcName:11004788$ on the lowest floor of $map:52000198$ in \
    $map:02000001$"
set quest[questID=10003422] complete "Talk with $npcName:11004788$ in $map:52000198$ in $map:02000001$"
set quest[questID=10003423] name "Along the Secret Passage"
set quest[questID=10003423] desc "Just when I thought all hope was lost as the fire spread in every direction, \
    $npc:11000075$ led us to $map:52000192$, which only the royal family knows.\nIt is no exaggeration to say that \
    since ancient times the royals have lived under constant threat to their lives. \nI had heard that escape \
    routes like $map:52000192$ were built here and there in the palace, but to see one in person... "
set quest[questID=10003423] manual "Escape safely through $map:52000192$ in $map:02000001$"
set quest[questID=10003423] complete "Talk with $npc:11004786$ in $map:02000119$"
set quest[questID=10003424] name "In Search of Clues"
set quest[questID=10003424] desc "I barely escaped alive from the flames.\nThen $npc:11000075$ began to press me \
    about the conflicting truths.\nBut everyone wants the truth as much as the Empress does. \n\nThe Empress has \
    summoned everyone connected with this affair.\nSoon everyone who speaks of the truth of the past will gather \
    in $map:52000193$. \n"
set quest[questID=10003424] manual "Look for clues $npc:11000074$ may have left in $map:02000190$ in \
    $map:02000119$"
set quest[questID=10003424] complete "Meet $npc:11004786$ in $map:52000197$ in $map:02000001$"
set quest[questID=10003425] name "The Battle of Truths"
set quest[questID=10003425] desc "The battle of truths began among $npcName:11004780$, $npcName:11004787$ and \
    $npcName:11000075$, gathered in $map:52000193$.\n$npcName:11004780$ is surely hiding something. \nHis claim \
    that the present state of affairs comes from his own indecision, and that he should have executed \
    $npcName:11004787$ sooner, does not add up. Did he not order him killed in the first place? \n\nThe Empress \
    then said she knows that $npc:11001812$ gave their life to complete the seal on the Lapenta. She also \
    understood that $npcName:11004744$, tainted by darkness, tried to harm the Empress. This is completely \
    different from $npcName:11004787$'s claim. It seems all of it came from $npcName:11004780$. \
    \n\n$npcName:11004780$ surely does not know that I hold a clue. \nThe $item:30001480$ I found at his \
    house.\n\nThe Empress said she never doubted $npcName:11004780$'s loyalty, yet she seemed to be pressing him. \
    \nBut $npcName:11004780$ spoke only of his own loyalty and did not seem able to speak of the truth."
set quest[questID=10003425] manual "Talk with $npc:11004786$ in $map:52000197$ in $map:02000001$"
set quest[questID=10003425] complete "Talk with $npc:11004786$ in $map:52000197$ in $map:02000001$"
set quest[questID=10003426] name "The Empress's Wrath"
set quest[questID=10003426] desc "Between $npcName:11004780$, who insists on his loyalty, and $npcName:11004787$, \
    who claims otherwise, the truth seemed to sink into a maze.\n\nThe Empress may have wanted to give \
    $npcName:11004780$ a chance to confess. \nBut the chance has passed, and $npcName:11004780$ is in danger. \nTo \
    think that the words of the man who had to be more loyal than anyone and guard the royal family were lies... \
    \nWith what heart does $npcName:11004780$ mean to bear the countless incidents born of that lie, and those \
    truths? "
set quest[questID=10003426] manual "Talk with $npc:11004786$ in $map:52000197$ in $map:02000001$"
set quest[questID=10003426] complete "Talk with $npc:11004786$ in $map:52000197$ in $map:02000001$"
set quest[questID=10003427] name "Rift in Time and Space"
set quest[questID=10003427] desc "The truth behind the sealing of the Lapenta has come to light. \
    $npcName:11004787$'s claim was true. \n$npcName:11004780$ may truly have made that choice to protect the \
    Empress. But protecting someone does not mean letting them be deceived by lies and seek their own safety. \
    \n\nEmpress $npcName:11004825$ felt extreme anger.\nIt was not simply anger at $npcName:11004780$, but a deep, \
    dark anger at herself, who was deceived by lies and betrayed the heroes who must have been waiting for her \
    help at the Lapenta seal... and at her own helplessness in failing to save the many people tormented by the \
    being born of it all. \n\nThat anger was no ordinary anger. \nThe power within the Empress burst out, and she \
    lost consciousness. \nAnd then... $npcName:11004801$ appeared."
set quest[questID=10003427] manual "Look closely at $npc:11004801$ in $map:52000194$ in $map:02000001$"
set quest[questID=10003427] complete "Look closely at $npc:11004801$ in $map:52000194$ in $map:02000001$"
set quest[questID=10003428] name "Hero, Once Again"
set quest[questID=10003428] desc "It all began with a small rift. \nThe $npc:11004727$ that appeared all over \
    $map:02000001$ and unsettled people...\nThe astonishing hypothesis that they began with $npc:11000075$, the \
    symbol of light.\nAnd now, $npc:11004801$ has appeared before my eyes. \nMust we now fear destruction caused \
    by the Empress, who was this world's light?"
set quest[questID=10003428] manual "Talk with $npc:11004783$ in $map:52000194$ in $map:02000001$"
set quest[questID=10003428] complete "Talk with $npc:11004783$ in $map:52000194$ in $map:02000001$"
set quest[questID=10003429] name "In Search of a Path"
set quest[questID=10003429] desc "$npcName:11004787$ and $npcName:11004783$ worry about the $npc:11004801$ that \
    appeared the moment the Empress lost consciousness. \n\nBeyond it lies a clue to keeping Maple World at \
    peace.\nBut they say that going there recklessly may leave no way back. \nI could become a lost soul who can \
    never find a way home from inside $npc:11004801$."
set quest[questID=10003429] manual "Talk with $npc:11004789$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003429] complete "Talk with $npc:11004789$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003430] name "Tangled Time"
set quest[questID=10003430] desc "$npcName:11004783$ and $npcName:11004789$ are gathering their energy toward the \
    rift in time and space.\nThey are making a way for me to come back. \nI should trust them, go beyond \
    $npc:11004801$, and do whatever I can for the peace of Maple World.\n\nSomehow I feel a strong trust in them. \
    "
set quest[questID=10003430] manual "Talk with $npc:11004789$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003430] complete "Talk with $npc:11004789$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003431] name "Ambush of Phantoms"
set quest[questID=10003431] desc "I crossed $npc:11004801$.\nWhat I meet here is certainly something I have seen \
    before. \nBut something is different. The mere presence of those beings makes the air feel heavy. \nI should \
    find out what this aura is. \n\n(If you leave the map, you can re-enter through the central portal of \
    $map:52000201$)"
set quest[questID=10003431] manual "Identify the unknown beings inside $map:52000202$"
set quest[questID=10003431] complete "Talk with $npc:11004784$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003432] name "Wavering Shards of Light"
set quest[questID=10003432] desc "After a melee with the beings I met beyond $npc:11004801$, I came back and \
    reported to $npcName:11004787$ and $npcName:11004783$, who said strange fragments were stuck to my body. \n\nI \
    had been too busy fighting to notice that crystal-like fragments of unknown origin were stuck all over my \
    armor. \n\nWhat are these fragments from beyond the rift? \n$npcName:11004783$ says light of a chaotic \
    wavelength dances within the fragments. \nIt seems to be a material holding considerable energy."
set quest[questID=10003432] manual "Talk with $npc:11004784$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003432] complete "Talk with $npc:11004784$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003433] name "A New Material"
set quest[questID=10003433] desc "$npcName:11004783$ and $npcName:11004787$ seem to keep guarding $map:52000194$ \
    to hold the unstable rift in a stable state.\n\nThey say this new material brought from beyond the rift needs \
    a detailed study. Go to $map:02000487$ and hear the details about this material."
set quest[questID=10003433] manual "Talk with $npc:11004784$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003433] complete "Talk with $npc:11004784$ in $map:52000201$ in $map:02000001$"
set quest[questID=10003440] name "To the Frontier Foundation"
set quest[questID=10003440] desc "I met $npcName:11003883$ in $map:02000487$. \nDoes she know about this material? \
    \nFor now, this material is the only clue that can save the fallen Empress. "
set quest[questID=10003440] manual "Meet $npc:11003883$ in $map:02000487$"
set quest[questID=10003440] complete "Meet $npc:11003883$ in $map:02000487$"
set quest[questID=10003441] name "The Prism Lab"
set quest[questID=10003441] desc "$npcName:11003883$ told me to take this material to $map:52000196$, a space set \
    up separately to research it. \nThis material from beyond $npcName:11004801$ is surely no ordinary thing.\n\nI \
    expected as much. What secret could be hidden in this material? "
set quest[questID=10003441] manual "Meet $npc:11004816$ at $map:52000196$ in $map:02000487$"
set quest[questID=10003441] complete "Meet $npc:11004816$ at $map:52000196$ in $map:02000487$"
set quest[questID=10003442] name "New Things Are Always Thrilling"
set quest[questID=10003442] desc "$npcName:11004816$ in $map:52000196$ showed great interest in this material \
    brought from $npcName:11004801$. She saw it as the perfect chance to prove a hypothesis she had set up. \n\nTo \
    confirm the true nature of the power of $item:40100055$ and the range that power can affect, I must go back \
    beyond the rift. To soak up the energy there, let's dunk myself in the water in the middle of \
    $npcName:11004801$ and come back."
set quest[questID=10003442] manual "Soak yourself in the mysterious water in $map:02000554$ and take in plenty of \
    its energy"
set quest[questID=10003442] complete "Meet $npc:11004816$ at $map:52000196$ in $map:02000487$"
set quest[questID=10003443] name "Break Your Limits"
set quest[questID=10003443] desc "$npc:11004802$ explained that the power of $item:40100055$ can be used to \
    perform a Limit Break.\n\nUsing $item:40100055$, you can break through the limits of a material and draw out \
    power even stronger than existing enchants.\n\nThe only gear that can be Limit Broken is the weapon called a \
    Fire Prism, which can be collected in the Phantom Dungeons, and it must already be enchanted to level 15 or \
    higher.\n\nThe monsters that appear in the Phantom Dungeons connected to $npcName:11004801$ are phantoms of \
    monsters I have met before, but I must keep challenging them, as they grow stronger beyond how strong I have \
    become.\n\n$item:40100055$ and $item:40100056$ can be collected by dismantling Fire Prism gear, so for a Limit \
    Break, I must keep challenging the Phantom Dungeons.\n\nThis is all we know so far, but it is best to keep \
    challenging, build up strength, and prepare for whatever else may come.\nTo prepare for another crisis that \
    will come someday... "
set quest[questID=10003443] manual "Meet $npc:11004816$ at $map:52000196$ in $map:02000487$"
set quest[questID=10003443] complete "Meet $npc:11004816$ at $map:52000196$ in $map:02000487$"
set quest[questID=10003444] name "A Mysterious Orb"
set quest[questID=10003444] desc "A summons from $npcName:11004793$, saying the rift's power has grown even \
    stronger.\nWhat on earth has happened?\n\nIt would be best to meet $npcName:11004782$ in $map:52000201$.\n"
set quest[questID=10003444] manual "Meet $npcName:11004782$ in $map:52000201$"
set quest[questID=10003444] complete "Meet $npcName:11004782$ in $map:52000201$"
set quest[questID=10003445] name "Into Time and Space Once More"
set quest[questID=10003445] desc "I rushed to $map:52000201$ at the summons of $npcName:11004793$.\nThe aura \
    pouring out of $map:52000202$ in the center was clearly different from before.\nAnd the orbs that sometimes \
    get flung out of it...\n\nAccording to $npcName:11004828$, when an orb was smashed, something amazing was \
    found inside...\nNew gear, of all things!"
set quest[questID=10003445] manual "Meet $npcName:11004828$ in $map:52000201$"
set quest[questID=10003445] complete "Meet $npcName:11004828$ in $map:52000201$"
set quest[questID=10003446] name "A Being in the Rift"
set quest[questID=10003446] desc "$npcName:11004828$ says that scattering things like this outside must mean it is \
    luring us.\nHe says we should enter the rift once more and confirm the truth.\n\nWhen I entered the rift and \
    looked toward the center, something unexpected happened...!\n"
set quest[questID=10003446] manual "Examine $npcName:11004829$ in $map:52000202$"
set quest[questID=10003446] complete "Examine $npcName:11004829$ in $map:52000202$"
set quest[questID=10003447] name "To Grow Stronger"
set quest[questID=10003447] desc "The black mass I met in the rift vanished after saying it would give me \
    something good if I played with it.\nTo say its piece and then vanish like that...?\n\nBack in my bedroom, I \
    told $npcName:11004828$ what happened in the rift,\nand with a look that said he understood something, he told \
    me to go spend time with that thing regularly...\n"
set quest[questID=10003447] manual "Meet $npcName:11004828$ in $map:52000201$"
set quest[questID=10003447] complete "Meet $npcName:11004828$ in $map:52000201$"
set quest[questID=10003448] name "The Time of Prophecy"
set quest[questID=10003448] desc "If it makes me stronger, I'll do anything!\nBlack mass, blue mass, whoever it \
    is, I'll play with them all from now on.\n\nMeanwhile, $npcName:11001812$..."
set quest[questID=10003448] manual "Meet $npcName:11001812$ in $map:52000199$"
set quest[questID=10003448] complete "Meet $npcName:11001812$ in $map:52000199$"
set quest[questID=20001010] name "The Cobras Are Furious"
set quest[questID=20001010] desc "Pull the levers around $npc:11000353$ in $map:02000148$ and take care of the \
    $npc:99000038$ that appear!"
set quest[questID=20001010] manual "Defeat the $npc:99000038$ in the holes"
set quest[questID=20001020] name "The Old Man and the Time Capsule"
set quest[questID=20001020] desc "Dig up the flowers around the cherry blossom tree to find $item:30000095$ for \
    $npc:11000225$ in $map:02000147$."
set quest[questID=20001020] manual "Dig up the flowers around the cherry blossom tree"
set quest[questID=20001021] name "Monkeys Love Capsules"
set quest[questID=20001021] desc "Judging by what Steve the guard in $map:02000147$ said, it seems $npc:99000039$ \
    dug up the capsule and climbed up the tree."
set quest[questID=20001021] manual "Take the time capsule from $npc:99000039$, who fled up the cherry blossom \
    tree"
set quest[questID=20001390] name "A Secret Rendezvous"
set quest[questID=20001390] desc "A mysterious order I found by chance. \nIts contents record an incident \
    happening in $map:03000145$.  \nTo learn the details of the incident, go and find $npc:11000910$ in \
    $map:03000145$."
set quest[questID=20001390] complete "Find $npc:11000910$ in $map:03000145$"
set quest[questID=20001391] name "Dr. Rokel's Plot"
set quest[questID=20001391] desc "$npc:11000910$ tells me about the plot unfolding inside $map:03000145$. \nTo \
    stop Dr. Rokel's dangerous research, find $npc:11000911$ in $map:03000145$ and ask for help."
set quest[questID=20001391] complete "Meet $npc:11000911$ in $map:03000145$"
set quest[questID=20001400] name "Fail to Survive!"
set quest[questID=20001400] desc "$npc:11000911$ says the incubators producing Shadow Cells must be shut down. \
    \nShut down the incubators producing Shadow Cells before Dr. Rokel collects the cultured cells. "
set quest[questID=20001400] manual "Stop the incubators that produce Shadow Cells"
set quest[questID=20001400] complete "Talk with $npc:11000911$ in $map:03000145$"
set quest[questID=20001401] name "Even a Dead Fire Needs Another Look"
set quest[questID=20001401] desc "$npc:11000911$ says the cell incubators were barely stopped, but it is too early \
    to relax. Hunt the mutant monsters of \n$map:03000145$ that have already been exposed to the Shadow Cell \
    virus. "
set quest[questID=20001401] manual "Hunt the mutant monsters infected with the virus"
set quest[questID=20001401] complete "Talk with $npc:11000911$ in $map:03000145$"
set quest[questID=20001410] name "Dangerous People"
set quest[questID=20001410] desc "$npc:11000912$ says the health of the slaves captured and brainwashed in \
    $map:03000145$ is getting worse. \nSearching the $npc:40000019$ guarding the cages will yield \
    $item:30000264$,\nso get $item:30000264$ and free the slaves locked in the cages. "
set quest[questID=20001410] manual "Get $item:30000264$, open the cage doors and free the slaves locked inside"
set quest[questID=20001410] complete "Talk with $npc:11000912$ in $map:03000145$"
set quest[questID=20001550] name "Young at Heart"
set quest[questID=20001810] desc "Kakarin of the Land of Darkness got information about $item:30000353$ from a \
    broker in Kerning City and raided $map:02000273$. The robot $npc:11000850$, which recorded the whole scene, \
    stopped moving when its energy ran out while saving the incident data. Following the last record saved just \
    before $npc:11000850$'s system reset, retrieve $item:30000353$ kept in the energy storage capsule."
set quest[questID=20001870] name "Wash Away My Sins"
set quest[questID=20001870] desc "On a full-moon night, $npc:11001077$ unknowingly hummed the Cerberus song the \
    Demon King's minion used to wake the demon dog. In the end the fierce demon dog $npc:23000045$ sleeping in \
    $map:02000044$ awoke, and $npc:11001077$ was crushed by guilt over the disaster brought on by this careless \
    act. \nLet's defeat the fierce demon dog $npc:23000045$ awakened in $map:02000044$, so that $npc:11001077$, \
    now a half-dazed wanderer, can ease the sin weighing on the heart! "
set quest[questID=20001870] manual "(Boss) Defeat the fierce demon dog $npc:23000045$"
set quest[questID=20001890] name "Please Talk Some Sense Into My Daughter"
set quest[questID=20001890] desc "$npc:11001115$ lives in $map:02000167$. She is deeply worried because her only \
    daughter $npc:11001116$ does nothing all day, moping and lingering around the polluted garden. \
    \n$npc:11001115$ asks me to meet $npc:11001116$ and tell her to come home soon."
set quest[questID=20001891] name "Why the Heart Aches"
set quest[questID=20001891] desc "$npc:11001116$ received seeds that bloom into bright red tulips from an old \
    woman who sells seeds and planted them in the garden, but contrary to her expectations, the seeds gave birth \
    to deadly poisonous monsters. $npc:11001116$ says it all came from her own carelessness, and out of guilt she \
    cannot go home. \nLet's defeat the $npc:24001101$ and $npc:24001102$ in $map:02000328$!"
set quest[questID=20001891] manual "Defeat the monsters in $map:02000328$"
set quest[questID=20001900] name "The Polluted Garden"
set quest[questID=20001900] desc "After $map:02000328$ regained its original beauty, the people of $map:02000167$ \
    visited the garden for a while. But as time passed, the plants in the garden began to lose their vitality and \
    became polluted again, and $npc:11001116$ was heartbroken once more. \n$npc:11001116$ suspects the giant \
    man-eating flower $npc:24001103$ that appeared in the garden. \nGo to $map:02000328$ once more and defeat \
    $npc:24001103$. "
set quest[questID=20001900] manual "Go to $map:02000328$ and defeat $npc:24001103$"
set quest[questID=20001920] name "Keep What Must Be Kept!"
set quest[questID=20001920] desc "$npc:11001129$ is furious at the people who feel not the slightest \
    responsibility for environmental pollution. If everyone just cooperated a little, but thanks to reckless \
    dumping, $map:02000139$ is turning more and more into a garbage dump. \nLet's clean up the trash strewn around \
    $map:02000139$."
set quest[questID=20001920] manual "Clean up the trash strewn around $map:02000139$"
set quest[questID=20001920] complete "Talk with $npc:11001129$ in $map:02000139$"
set quest[questID=20001930] name "Found It!"
set quest[questID=20001930] desc "$npc:11001130$ found $item:30000385$, a rare herb that is hard to come by, but \
    the joy was short-lived. \nHe says he went into $map:52000037$ to gather $item:30000385$ without knowing \
    better and nearly died. \nLet's go into $map:52000037$ in $npc:11001130$'s place and gather $item:30000385$."
set quest[questID=20001930] manual "Go inside $map:52000037$ and gather $item:30000385$"
set quest[questID=20001940] name "The Monster with a Chill"
set quest[questID=20001940] desc "$npc:11001131$ was dispatched to investigate $map:02000085$, where abnormal \
    weather has created ice that does not melt in only some areas. After studying the surroundings for a long \
    time, $npc:11001131$ found that the cold breath of $npc:21099190$ is the culprit behind the unmelting ice, and \
    asks me to defeat $npc:21099190$. "
set quest[questID=20001940] manual "Hunt $npc:21099190$ in $map:02000085$"
set quest[questID=20001940] complete "Talk with $npc:11001131$ in $map:02000085$"
set quest[questID=20001950] name "Someone Is Here!"
set quest[questID=20001950] desc "A woman's voice rings out from the middle of $map:02000085$. Going near the \
    sound, I find it is a cry for help coming from inside $map:02000330$. \n$npc:11001138$, trapped inside the \
    warehouse, says the warehouse door was locked from outside and she is stuck inside with others. $npc:11001138$ \
    tells me to find $npc:11001133$, who has the key to the locked warehouse door. \nLet's look for $npc:11001133$ \
    in $map:02000085$. \n"
set quest[questID=20001950] complete "Find $npc:11001133$ in $map:02000085$"
set quest[questID=20001951] name "The Lost Key"
set quest[questID=20001951] desc "$npc:11001133$ was heading back with the key to open the locked warehouse door \
    when monsters suddenly attacked and $item:30000386$ was lost.\nLet's hunt the $npc:21000063$, $npc:21000302$, \
    $npc:21000016$ and $npc:21099190$ in $map:02000085$ and get the lost $item:30000386$ back."
set quest[questID=20001951] manual "Hunt the monsters in $map:02000085$ and find $item:30000386$"
set quest[questID=20001951] complete "Talk with $npc:11001133$ in $map:02000085$"
set quest[questID=20001952] name "The Fresh Air I Missed"
set quest[questID=20001952] desc "$npc:11001133$ says every minute counts, and asks me to hurry, open the locked \
    door with $item:30000386$ and rescue the people trapped inside. \nEnter $map:02000330$ and rescue the people \
    trapped there. "
set quest[questID=20001952] complete "Talk with $npc:11001138$ in $map:02000330$"
set quest[questID=20001960] name "Rare Leather"
set quest[questID=20001960] desc "$npc:11001139$, who wanders the land searching for rare leather, had a dry \
    spell, but at last found a rare leather that suits their taste. Lacking the confidence to tan it personally \
    against such fierce monsters, $npc:11001139$ asks me to bring $item:30000387$ from $npc:21000026$ \
    and\n$item:30000388$ from $npc:21000067$ in $map:02000054$. "
set quest[questID=20001960] manual "Hunt $npc:21000026$ in $map:02000054$ and bring back $item:30000387$|Hunt \
    $npc:21000067$ in $map:02000054$ and bring back $item:30000388$"
set quest[questID=20001960] complete "Talk with $npc:11001139$ in $map:02000054$"
set quest[questID=20001970] name "That Place of Adventure and Mystery!"
set quest[questID=20001970] desc "$npc:11000471$ says they saw a strange sight in $map:02000136$ not long ago. If \
    you wander around here, a hat flashing with blue light appears like magic, and it seems like a door to a new \
    dimension. They cannot just walk in without knowing what will happen, but surely it is full of mysterious and \
    fun things. $npc:11000471$ asks me to go into the world inside the hat when the blue-glowing hat appears \
    someday, and tell the tale afterward.\nWhat kind of place could it be? Let's explore it!"
set quest[questID=20001970] manual "Explore the world inside the hat that glows with blue light"
set quest[questID=20001980] name "Bad Guys and Bad Guys"
set quest[questID=20001980] desc "$npc:11000220$ takes pride that once $map:02000136$ is finished, it will be the \
    finest landmark in the area. But that is only when it is 'finished'. Recently, violent monsters have taken \
    over the Rockefeller Tower site, damaging property and setting fires everywhere, so construction is falling \
    further behind.\nTo keep construction on track, defeat the $npc:21000282$ and $npc:21099049$ occupying \
    $map:02000136$!"
set quest[questID=20001980] manual "Defeat the monsters occupying $map:02000136$"
set quest[questID=20001980] complete "Talk with $npc:11000220$ in $map:02000136$"
set quest[questID=20002110] name "Limited Editions Are a Must"
set quest[questID=20002110] desc "$npc:11001374$ was told by Oliver to buy the latest limited-edition sports car, \
    but with monsters occupying $map:02010016$, there is no courage to move. Take the $item:30000480$ that \
    $npc:11001374$ handed over and find $npc:11001375$ in $map:02010016$."
set quest[questID=20002110] complete "Talk with $npc:11001375$ at the special booth in $map:02010016$"
set quest[questID=20002111] name "Oliver's Trusted Blank Check"
set quest[questID=20002111] desc "$npc:11001375$ says that with $item:30000480$, the car can be handed over with \
    no checks or contract procedures at all,\nand readily gives me $item:30000481$ to take along. "
set quest[questID=20002111] manual "Reassemble the latest limited-edition sports car displayed at the special \
    booth and take it"
set quest[questID=20002120] name "Hit Me Instead, You Brutes"
set quest[questID=20002120] desc "$npc:11001375$ asks me to drive off all the monsters that raided \
    $map:02010016$.\nDefeat the $npc:21000525$, $npc:21000528$ and $npc:21000531$."
set quest[questID=20002120] manual "Drive off the monsters that raided $map:02010016$"
set quest[questID=20002121] name "Cars Are Love"
set quest[questID=20002121] desc "$npcName:11001375$ values the displayed cars more than themself. \nBefore \
    monsters storm $map:02010016$ yet again, they ask me to hurry and store the displayed cars safely inside \
    container boxes. "
set quest[questID=20002121] manual "Store the cars displayed in $map:02010016$ inside container boxes"
set quest[questID=20002160] name "On a Player's Honor"
set quest[questID=20002160] desc "$npc:11001378$ in $map:02010020$ says monsters stole the glove engraved with \
    their own name, the only one of its kind in the world. \nHunt the $npc:21000419$ and \n$npc:21000420$ in \
    $map:02010020$ and get $item:30000484$ back."
set quest[questID=20002160] manual "Hunt the monsters in $map:02010020$ and bring back $item:30000484$"
set quest[questID=20002170] name "A Taste of the Hot Fist"
set quest[questID=20002170] desc "$npc:11001379$ is at wits' end because of the monsters that suddenly raided \
    $map:02010020$. \nHelp $npc:11001379$ and drive off the $npc:21000419$ and \n$npc:21000420$."
set quest[questID=20002170] manual "Wipe out the monsters that raided $map:02010020$"
set quest[questID=20002190] name "Dungeon: Vanishing Travelers"
set quest[questID=20002190] desc "$dungeonTitle:25009001$ \n(Entrance map: $map:02010023$)\n\n$npc:11001399$ is \
    busy investigating the recently discovered pyramid in $map:02010023$. The pyramid, unseen for ages, was found \
    after a huge sandstorm swept the desert not long ago. Scouts set out to investigate it, but days have passed \
    with no word, and they say something must surely have happened inside.    \nEnter $map:02010070$ and find out \
    whether the missing scouts are alive."
set quest[questID=20002190] manual "Enter $map:02010070$ and find out whether the missing scouts are alive"
set quest[questID=20002190] complete "Report to $npc:11001399$"
set quest[questID=20002200] name "Dungeon: The End of Greed"
set quest[questID=20002200] desc "$dungeonTitle:25009001$ \n(Entrance map: $map:02010023$)\n\n$npc:11001399$ \
    reported the danger of $map:02010070$ to headquarters, but says echoes of phantoms are still heard among \
    travelers visiting the ruins, which worries them. $npc:11001314$ said that to seal $npc:24001904$ completely, \
    I must obtain $npc:24001904$'s keepsake and lay them to rest. \nDefeat $npc:24001904$ in $map:02010070$ and \
    get $item:30000495$."
set quest[questID=20002200] manual "Defeat $npc:24001904$ in $map:02010070$ and bring back $item:30000495$"
set quest[questID=20002210] name "Dungeon: The Derailed Train"
set quest[questID=20002210] desc "$dungeonTitle:21015001$ \n(Entrance map: $map:02010009$)\nParty recommended (4 \
    players)\nThis quest can only be done in Normal mode.\n\n$npc:11001458$ says they boarded the Black Knoff, \
    which carries goods, but fell off when the train suddenly switched tracks. $npcName:11001458$ says the Ludely \
    Monorail stops only once, and asks me to use that moment to board the moving Black Knoff and find out what is \
    going on inside. "
set quest[questID=20002210] manual "Board the Black Knoff and find out what is going on inside"
set quest[questID=20002210] complete "Report the situation to $npc:11001458$"
set quest[questID=20002221] name "Dungeon: Time for Talk Is Over"
set quest[questID=20002221] desc "$dungeonTitle:21015001$ \n(Entrance map: $map:02010009$)\nParty recommended (4 \
    players)\nThis quest can only be done in Normal mode.\n\nThe unknown assailants who seized the Black Knoff \
    have raided it again. $npc:11001458$ is fuming that targeting the Black Knoff not once but twice means the \
    Black Star Society is being disrespected.\n$npcName:11001458$ says they learned about the ringleaders of the \
    assailants from a member who had been held aboard the Black Knoff, and asks me to defeat $npc:24001508$, \
    $npcName:24001506$ and $npcName:24001507$."
set quest[questID=20002221] manual "Defeat $npc:24001508$ in $map:02000335$|Defeat $npcName:24001506$ in \
    $map:02000336$|Defeat $npcName:24001507$ in $map:02000337$"
set quest[questID=20002222] name "An Unknown Foreboding"
set quest[questID=20002222] desc "$npc:11001473$, whom I met in the Nazkar Central Hall, is worried because their \
    colleague $npcName:11001474$, who went into the Nazkar Temple to investigate, has not come back after half a \
    day.\n$npcName:11001473$ says they must return before dark, and asks me to go into Nazkar, look for \
    $npcName:11001474$, and pass on the message to hurry back. "
set quest[questID=20002223] name "Dungeon: The One Who Wakes the Dark"
set quest[questID=20002223] desc "$dungeonTitle:20016002$ \n(Entrance map: $map:02010030$)\nParty recommended (10 \
    players)\n\n$npc:11001474$, whom I met in $map:02010030$, is terrified and trembling. They say they saw a huge \
    unknown shadow enter $map:02010051$. \n$npcName:11001474$ is sure something suspicious is going on there, and \
    asks me to hurry into $map:02010051$ and find out what the black shadow really is."
set quest[questID=20002223] manual "Enter $map:02010030$ and\nconfirm what the black shadow is"
set quest[questID=20002224] name "News of the Master"
set quest[questID=20002224] desc "$npcName:11000001$ says $npcName:11001232$ is looking for me in $map:02000361$ \
    and tells me to go see her."
set quest[questID=20002230] name "An Important Clue"
set quest[questID=20002230] desc "$npcName:11001232$ brings word that $npcName:11001229$ is returning. \
    $npcName:11001229$ is at $map:52000021$, where they went before, since there is something urgent to find. \
    Let's go to $map:52000021$ to meet $npcName:11001229$."
set quest[questID=20002230] manual "Go to $map:52000021$ at $map:02000082$ in $map:02000059$ and meet \
    $npcName:11001229$"
set quest[questID=20002231] name "The Ancient Tome"
set quest[questID=20002231] desc "$npcName:11001232$ brings word that $npcName:11001230$ has left for Ellinia to \
    decipher the ancient tome. $npcName:11001230$ sent word that since the ancient tome cannot be teleported with \
    the power of runes, they must travel by sea, and that they plan to head straight to $map:02000023$ via \
    $map:02000063$. Let's go on and hear the next plan from $npcName:11001229$."
set quest[questID=20002231] complete "Hear the next plan from $npcName:11001229$ in $map:02000361$"
set quest[questID=20002232] name "The Plan Begins"
set quest[questID=20002232] desc "$npcName:11001229$ says that while they go to $map:02000063$ with \
    $npcName:11001232$ to meet $npcName:11001230$ and the expedition, I should go to $map:02000023$ and meet \
    $npcName:11000031$. \nFind $npcName:11000031$, report on $npcName:11001231$'s situation and the 'Ultimate \
    Secret Art', ask for understanding in advance, and then ask for help."
set quest[questID=20002232] complete "Meet $npc:11000031$ in $map:02000023$ and ask for help"
set quest[questID=20002233] name "Arriving a Step Too Late"
set quest[questID=20002233] desc "$npcName:11000031$ heard that the Runeblades and the expedition would arrive at \
    $map:02000063$, and worries that pirates are running rampant in $map:02000063$, so the comrades may not return \
    safely. $npcName:11000031$ orders me to go to $map:02000063$, find out whether my comrades are alive, and \
    bring everyone back to $map:02000023$. \nGo to $map:02000063$ and find out whether the Runeblade comrades are \
    alive."
set quest[questID=20002233] manual "Go to $map:02000063$ and find out whether my comrades are alive"
set quest[questID=20002234] name "The Wounded"
set quest[questID=20002234] desc "The ship that $npcName:11001230$ and the expedition arrived on was thrown into \
    chaos by a pirate raid the moment it reached $map:02000063$, and wounded expedition members lie everywhere. \
    \n$npcName:11001232$ says to leave the wounded $npcName:11001233$ and the cleanup of the wrecked expedition \
    ship to her, and to help $npcName:11001229$ wipe out the pirates' stronghold and recover the plundered ancient \
    tome and goods.\nHead for the pirates' stronghold in the cave outside the Chelisca coast!"
set quest[questID=20002234] complete "Find the pirate stronghold in the cave outside $map:02000063$"
set quest[questID=20002235] name "A Continuing Trial"
set quest[questID=20002235] desc "$npcName:11001230$ says that rather than their own wounds, the urgent matter is \
    helping $npcName:11001229$ and the expedition fighting the pirates nearby. \nTogether with the expedition, \
    wipe out all the pirates at their stronghold and recover the plundered ancient tome."
set quest[questID=20002235] manual "Wipe out the pirates at the pirate stronghold"
set quest[questID=20002235] complete "Talk with $npcName:11001229$ at the pirate stronghold"
set quest[questID=20002236] name "A Certain Earnestness"
set quest[questID=20002236] desc "$npcName:11001229$ orders me to go straight to $map:02000023$, tell \
    $npc:11000031$ what is happening here, and ask for help. Hurry back to $map:02000023$ and meet \
    $npcName:11000031$."
set quest[questID=20002237] name "Warm Consideration"
set quest[questID=20002237] desc "$npcName:11000031$ says I look very tired and tells me to rest and recover first \
    while the Runeblade comrades and the expedition return to $map:02000023$. Go and find $npc:11000029$ in \
    $map:02000023$."
set quest[questID=20002237] complete "Meet $npcName:11000029$, the general store merchant in $map:02000023$"
set quest[questID=20002238] name "Crisis Into Hope"
set quest[questID=20002238] desc "Laurie reports that the wounded Runeblade comrades and expedition members have \
    just arrived in $map:02000023$. $npcName:11000031$ and $npcName:11000032$ are tending to the Runeblades, whose \
    wounds are deeper than expected, in $map:02000179$. Let's go to $map:02000179$ to meet my master \
    $npcName:11001229$ and my comrades."
set quest[questID=20002239] name "A Step That Cannot Wait"
set quest[questID=20002239] desc "$npcName:11000031$ says that to decipher the ancient tome and stop \
    $npcName:11001231$, more troops will be needed. \n$npcName:11000031$ says that while my comrades get treatment \
    and a short rest, I should meet $npc:11000075$ and ask for an emergency call-up. To meet $npc:11000075$, I \
    must first find $npc:11000119$ and get permission to enter the royal court.\nGo to $map:02000001$ and meet \
    $npc:11000119$."
set quest[questID=20002240] desc "Upon hearing that $npcName:11000031$'s orders must be delivered to \
    $npc:11000075$, $npcName:11000119$ grants permission to enter the royal palace. \nGo inside $map:02000025$, \
    meet $npcName:11000075$ and deliver $npcName:11000031$'s orders."
set quest[questID=20002240] complete "Deliver $npcName:11000031$'s orders to $npc:11000075$"
set quest[questID=20002241] name "A Special Summons"
set quest[questID=20002241] desc "After reading $npcName:11000031$'s message, $npc:11000075$ realizes the \
    situation is more urgent than expected and says she will issue a summons to the representatives of each \
    guardian faction. $npcName:11000075$ tells me to go to $map:52000026$ and wait there until the representatives \
    gather. \nThe entrance to $map:52000026$ can be found near the entrance toward $map:02000119$ in the northwest \
    of $map:02000001$. Let's go there."
set quest[questID=20002241] complete "Meet the Empress in $map:02000025$"
set quest[questID=20002242] name "A Difficult Harmony"
set quest[questID=20002242] desc "$npcName:11000601$ says it is important to persuade the Thieves and Assassins, \
    who were the most negative about the expedition's request, and that if I win the heart of $npcName:11000006$, \
    who leads the Humblis, the Assassins can join too. \nAs Luanna advised, head to $map:02000208$ and meet \
    $npcName:11000006$."
set quest[questID=20002243] name "Proof"
set quest[questID=20002243] desc "$npcName:11000006$ explains the urgent situation: a Humblis agent who secretly \
    infiltrated the Black Star Society to expose the ties between $npc:11000065$ and $npcName:11000251$ is trapped \
    in the underground sewers. \nGo to $map:02000100$, find the entrance to $map:52000027$, help $npc:11000051$ on \
    the mission and rescue the stranded Humblis member."
set quest[questID=20002243] manual "Go to $map:52000027$ from $map:02000100$ and help $npc:11000051$ complete the \
    mission"
set quest[questID=20002243] complete "Talk with $npcName:11000006$ at $map:02000208$ in $map:02000166$"
set quest[questID=20002244] name "A Promise Holding Hope"
set quest[questID=20002244] desc "In return for safely rescuing the Humblis member, $npcName:11000006$ promises to \
    select the finest Assassins and send them to $map:02000023$ to join the Starlight Expedition.\nReturn to \
    $map:02000179$ in $map:02000023$ and report this to my master $npcName:11001229$."
set quest[questID=20002245] name "A Truth Slowly Revealed"
set quest[questID=20002245] desc "$npcName:11000031$ says they have finished deciphering one of the ancient tomes \
    brought from Kalib Island. $npcName:11000031$ says they have worked out where the clue to the true nature of \
    the 'Ultimate Secret Art' is kept. The coordinates the book points to are $map:02000129$.\nGo to \
    $map:02000129$, look for any clues left by the ancient Runeblade ancestors, and return to $map:52000028$."
set quest[questID=20002250] name "The Source of True Power"
set quest[questID=20002251] name "Duel of Fate"
set quest[questID=20002251] desc "$npcName:11001230$ says they will gather the expedition, finish the final \
    checks, and join later as the rear guard, and asks me to follow $npcName:11001229$, who leaves first with the \
    vanguard, and assist them well. \nFollow $npcName:11001229$ to $map:02000112$, find the entrance to \
    $map:52000029$ and head in."
set quest[questID=20002251] manual "Go to $map:02000112$ and find the entrance to $map:52000029$ and enter"
set quest[questID=20002260] name "Unbearable Betrayal"
set quest[questID=20002260] desc "$npcName:11000031$ cannot hide pity for $npcName:11001229$ and unease about the \
    vanished $npcName:11001231$. For now, it would be best to stay by the side of the comrade who must be hurting \
    more than anyone.\n$npcName:11000031$ says they will make their own plans for the next move, so I should meet \
    $npcName:11001230$ and offer comfort. "
set quest[questID=20002260] complete "Talk with $npcName:11001230$"
set quest[questID=20002261] name "Dreaming of a Thread of Hope..."
set quest[questID=20002261] desc "$npcName:11001232$ tells me that since returning from the Land of Darkness, \
    $npcName:11001229$ had been making a gift for their disciple in spare moments.\nFind the box neatly placed \
    under the tree in $map:02000179$ and open it."
set quest[questID=20002261] manual "Find Ishura's gift at $map:02000179$ in $map:02000023$"
set quest[questID=20002262] name "Kerning City in Flames"
set quest[questID=20002262] desc "Unidentified creatures have suddenly invaded Kerning City!\n$npcName:11000044$ \
    has called up all Dark Wind forces to restore order\nand issued the emergency protocol, 'Black Mushroom'.\nIn \
    $map:52000067$, follow $npcName:11000044$'s\norders and fend off the invasion by the unidentified \
    creatures.\n\n<font color=\"#909090\">(If you reconnect, you can re-enter through dialogue while the quest is \
    in progress.)</font>"
set quest[questID=20002262] manual "Complete every Kerning City defense mission \n<font color=\"#909090\">Re-entry \
    possible through dialogue while the quest is in progress</font>"
set quest[questID=20002262] complete "Talk with $npcName:11000044$ in $map:02000152$"
set quest[questID=20002387] name "Link of Connection"
set quest[questID=20002387] complete "Talk with $npcName:11003180$"
set quest[questID=30000010] name "The Precious Logbook"
set quest[questID=30000010] desc "$npc:11000444$ was swept ashore at $map:02000062$ when an unexplained storm \
    suddenly struck during a voyage.\nThe logbook he has carefully kept for ten years is in danger of being washed \
    away.\nSince he hurt his leg, let's fetch $item:30000150$ from the sea off $map:02000062$ in his place."
set quest[questID=30000010] manual "Find $item:30000150$ in the sea off $map:02000062$"
set quest[questID=30000011] desc "The storm wrecked his ship, his entire fortune, and $npc:11000444$ also lost \
    $item:30000151$.\nHis sad crying is pitiful, so go to $map:02000068$, meet $npc:11000019$ and ask whether \
    $item:30000151$ can be reissued.\n$map:02000068$ is in $map:02000062$."
set quest[questID=30000011] complete "Meet $npc:11000019$ inside the $map:02000068$ building"
set quest[questID=30000340] name "Christmas Magic 1"
set quest[questID=30000340] desc "It is Christmas Eve!\nDefeat a field boss and receive a present infused with \
    Christmas magic from $npc:11001002$!\n\nVarious field bosses of Maple World:\n$npcName:23000013$, \
    $npcName:23000018$, $npcName:23000001$, $npcName:23000019$, $npcName:23000054$,\n$npcName:23000020$, \
    $npcName:23000035$, $npcName:23000099$, $npcName:23000017$, \n$npcName:23000047$, $npcName:23000024$, \
    $npcName:23000034$, $npcName:23000045$, \n$npcName:23000026$, $npcName:23000012$, $npcName:23000057$, \
    $npcName:23000009$, $npcName:23000029$ "
set quest[questID=30000340] manual "Defeat a field boss"
set quest[questID=30000340] complete "Talk with $npcName:11001002$ in $map:02000064$ or $map:63000072$"
set quest[questID=30000341] name "Christmas Magic 2"
set quest[questID=30000341] desc "It is Christmas!\nDefeat a field boss and receive a present infused with \
    Christmas magic from $npc:11001002$!\n\nVarious field bosses of Maple World:\n$npcName:23000013$, \
    $npcName:23000018$, $npcName:23000001$, $npcName:23000019$, $npcName:23000054$,\n$npcName:23000020$, \
    $npcName:23000035$, $npcName:23000099$, $npcName:23000017$, \n$npcName:23000047$, $npcName:23000024$, \
    $npcName:23000034$, $npcName:23000045$, \n$npcName:23000026$, $npcName:23000012$, $npcName:23000057$, \
    $npcName:23000009$, $npcName:23000029$ "
set quest[questID=30000341] manual "Defeat a field boss"
set quest[questID=30000341] complete "Talk with $npcName:11001002$ in $map:02000064$ or $map:63000072$"
set quest[questID=30000390] name "Gather marjoram herbs 10 times in Alchemy Garden or other areas"
set quest[questID=30000390] manual "Gather marjoram herbs 10 times in Alchemy Garden or other areas"
set quest[questID=30000390] complete "Gather marjoram herbs 10 times in Alchemy Garden or other areas"
set quest[questID=30000400] name "Climb walls for 300m"
set quest[questID=30000400] manual "Climb walls for 300m"
set quest[questID=30000400] complete "Climb walls for 300m"
set quest[questID=30000410] name "Capture 5 pets "
set quest[questID=30000410] manual "Capture 5 pets "
set quest[questID=30000410] complete "Capture 5 pets "
set quest[questID=30000414] desc "With spring here, $npc:11003878$ is preparing a spring event.\nSaying they plan \
    to go on a spring picnic once the flowers bloom,\nthey ask me to plant the seeds in the seed pouch in \
    $map:02000115$.\nLet's go plant the seeds so $npcName:11003878$ can enjoy a pleasant spring picnic."
set quest[questID=30000414] manual "Plant seeds in $map:02000115$"
set quest[questID=30000414] complete "Talk with $npcName:11003878$ in $map:02000425$"
set quest[questID=30000415] desc "With spring here, $npc:11003878$ is preparing a spring event.\nSaying they plan \
    to go on a spring picnic once the flowers bloom,\nthey ask me to plant the seeds in the seed pouch in \
    $map:02000111$.\nLet's go plant the seeds so $npcName:11003878$ can enjoy a pleasant spring picnic."
set quest[questID=30000415] manual "Plant seeds in $map:02000111$"
set quest[questID=30000415] complete "Talk with $npcName:11003878$ in $map:02000425$"
set quest[questID=30000416] desc "With spring here, $npc:11003878$ is preparing a spring event.\nSaying they plan \
    to go on a spring picnic once the flowers bloom,\nthey ask me to plant the seeds in the seed pouch in \
    $map:02000088$.\nLet's go plant the seeds so $npcName:11003878$ can enjoy a pleasant spring picnic."
set quest[questID=30000416] manual "Plant seeds in $map:02000088$"
set quest[questID=30000416] complete "Talk with $npcName:11003878$ in $map:02000425$"
set quest[questID=30000417] desc "With spring here, $npc:11003878$ is preparing a spring event.\nSaying they plan \
    to go on a spring picnic once the flowers bloom,\nthey ask me to plant the seeds in the seed pouch in \
    $map:02000103$.\nLet's go plant the seeds so $npcName:11003878$ can enjoy a pleasant spring picnic."
set quest[questID=30000417] manual "Plant seeds in $map:02000103$"
set quest[questID=30000417] complete "Talk with $npcName:11003878$ in $map:02000425$"
set quest[questID=30000418] desc "Enjoy a spring picnic with $npc:11003878$ in $map:02000115$!"
set quest[questID=30000418] complete "Talk with $npc:11003878$ in $map:02000115$"
set quest[questID=30000419] desc "Enjoy a spring picnic with $npc:11003878$ in $map:02000111$!"
set quest[questID=30000419] complete "Talk with $npc:11003878$ in $map:02000111$"
set quest[questID=30000420] name "Spring Picnic: Trinian Road"
set quest[questID=30000420] desc "Enjoy a spring picnic with $npc:11003878$ in $map:02000088$!"
set quest[questID=30000420] complete "Talk with $npc:11003878$ in $map:02000088$"
set quest[questID=30000421] desc "Enjoy a spring picnic with $npc:11003878$ in $map:02000103$!"
set quest[questID=30000421] complete "Talk with $npc:11003878$ in $map:02000103$"
set quest[questID=30000422] desc "The fairy $npcName:11004846$ says she lost her shoes again. This time she asked \
    for help through $npc:11200005$.\nSurely one of the many $item:30001102$ lying around in the bushes must be \
    $npcName:11004846$'s?\nGrab whatever I find and ask $npcName:11200005$ to appraise it.\nSearch any suspicious \
    bushes you find near $map:02000023$"
set quest[questID=30000422] manual "Collect 10 $item:30001102$"
set quest[questID=30000422] complete "Talk with $npc:11200005$ at the guild home"
set quest[questID=30000423] name "Ruby's Cherry Blossom Welcome: Bug Extermination"
set quest[questID=30000423] desc "$npcName:11001002$ asks me to take care of the bugs gnawing at the cherry \
    blossom trees. Let's help $npcName:11001002$ for a successful Cherry Blossom Festival!"
set quest[questID=30000423] manual "Defeat 200 insect-type monsters"
set quest[questID=30000423] complete "Talk with $npc:11001002$"
set quest[questID=30000424] name "Ruby's Cherry Blossom Welcome: MC Kay's Event"
set quest[questID=30000424] desc "At MC Kay's request, $npcName:11001002$ asks me to take part in the event. Join \
    MC Kay's event and enjoy the Cherry Blossom Festival"
set quest[questID=30000424] manual "Take part in MC Kay's event once"
set quest[questID=30000424] complete "Talk with $npc:11001002$"
set quest[questID=30000425] name "Ruby's Cherry Blossom Welcome: The Giant Mechanical Bug"
set quest[questID=30000425] desc "I'm asked to defeat Gigantica, a giant bug-type machine found in Kritias. Defeat \
    Gigantica and protect the peaceful Cherry Blossom Festival"
set quest[questID=30000425] manual "Defeat Gigantica once"
set quest[questID=30000425] complete "Talk with $npc:11001002$"
set quest[questID=30001009] name "Natural Tonic"
set quest[questID=30001009] desc "I met $npc:11000712$ in $map:02000172$.\n$npcName:11000712$ is upset that Dad \
    has been ailing from an unknown illness for a while and cannot play with them, and is secretly worried about \
    him. \n$npcName:11000712$ wants to get $item:30000205$, which Dad often eats as a health food, and give it to \
    him. \n$item:30000205$ can be obtained from $npc:21090069$. It may have been an easy snack for Dad, but \
    $npcName:11000712$ is simply afraid of $npc:21090069$. \nGet $item:30000205$ from the $npc:21090069$ in \
    $map:02000172$ and bring it to $npcName:11000712$."
set quest[questID=30001009] manual "Get $item:30000205$ from $npc:21090069$ in $map:02000172$"
set quest[questID=30001010] name "The Legendary Cure-All"
set quest[questID=30001010] desc "$npc:11000713$ ate $item:30000205$ but his condition has not improved. \
    $npcName:11000713$ asks me to get $item:30000206$, the cure-all seen in an old book handed down in a \
    relative's house.\n$npcName:11000713$ asked for $item:30000206$ from the $npc:29000001$ that lives hidden \
    throughout the thickets of $map:02000172$."
set quest[questID=30001010] manual "Get $item:30000206$ from the $npc:29000001$ that appear when you rummage \
    through the thickets in $map:02000172$"
set quest[questID=30001011] name "Plenty of Ingredients?!"
set quest[questID=30001011] desc "The little kid $npc:11001145$, whom I met in $map:02000257$, loves the snacks \
    Mom makes. \nBut lately $npc:11001145$'s mom has been too busy with work to prepare $npc:11001145$'s snacks... \
    \n$npc:11001145$, who really craved the $item:30000395$ Mom used to make, came to $map:02000257$ to make \
    $item:30000395$ on their own.\nBut the $npc:11001146$ that $npc:11001145$ brought lists only the names of the \
    4 ingredients needed to make $item:30000395$, not how many are needed. $npc:11001145$ says to just get plenty \
    of the 4 ingredients, 10 each...?!"
set quest[questID=30001011] manual "Get $item:30000390$ from $npc:21000031$|Get $item:30000392$ from \
    $npc:21000009$|Get $item:30000391$ from the chocolate spring|Gather $item:30000393$ from the red tree"
set quest[questID=30001012] name "A Half Recipe"
set quest[questID=30001012] desc "No matter how I think about it, it is suspicious that $npcName:11001146$ lists \
    only ingredient names and no exact cooking method. \nRead carefully the $npcName:11001146$ that $npc:11001145$ \
    brought."
set quest[questID=30001012] manual "Read the $npc:11001146$ next to $npc:11001145$"
set quest[questID=30001012] complete "Tell $npc:11001145$ in $map:02000257$"
set quest[questID=30001013] name "Shall We Make Candy? "
set quest[questID=30001013] desc "Now that the ingredients are gathered and the method is known, $npc:11001145$, \
    who said they would make it themself, asks for help again.\n$npc:11001145$ says they made it just as the \
    recipe says, but the $npc:11001146$ keeps spitting out the ingredients. Surely something is wrong \
    somewhere?\nFollowing the cooking method found on the back of $npc:11001147$, use the $npcName:11001146$ to \
    make $item:30000395$."
set quest[questID=30001013] manual "Use $npcName:11001147$ to make $item:30000395$ just as written in \
    $npcName:11001146$"
set quest[questID=30001013] complete "Give $item:30000395$ to $npc:11001145$ in $map:02000257$"
set quest[questID=40001000] name "Warehouse Tidying Can Wait"
set quest[questID=40001000] desc "$npc:11000148$ agreed to tidy the warehouse together with $npc:11000104$.\nBut \
    with a sore back, $npc:11000148$ says the tidying will have to wait.\nSince I am going to $npc:11000104$ to \
    tell them where $npc:11000054$ went, I should pass this news along too."
set quest[questID=40001001] name "A Helping Hand"
set quest[questID=40001001] desc "$npc:11000105$ spotted a man collapsed on the sand while going to buy a tropical \
    juice.\nIn the confusion, they say they passed by without thinking to help.\nLet's help the man collapsed on \
    the sand in $npc:11000105$'s place."
set quest[questID=40001002] name "The Balloon Belongs to Tivo"
set quest[questID=40001002] desc "$npc:11000114$, who caught a drifting balloon, wants to return it to its \
    owner.\nTake $item:30000171$ to $npc:11000389$ in place of $npc:11000114$, who has to meet their sister."
set quest[questID=40001002] manual "Get $item:30000171$ from $npc:11000114$ in $map:2000115$"
set quest[questID=40001010] name "Drink Delivery"
set quest[questID=40001010] desc "$npc:11000080$ ordered $item:30000195$ and vanished!\nThey must have gone off \
    somewhere while $npc:11000704$ was making the juice. \nBring $item:30000195$ to $npc:11000080$ before the ice \
    in the juice melts."
set quest[questID=40001010] manual "Get $item:30000195$ from $npc:11000704$ in $map:2000062$"
set quest[questID=40001020] name "Righting the Cart"
set quest[questID=40001020] desc "A cart toppled by the force of the earthquake.\n$npc:11000618$ is trying to \
    stand it back up, but it does not seem easy.\nHelp $npc:11000618$ and set the cart upright."
set quest[questID=40001020] manual "Right the cart in front of $npc:11000618$ in $map:2000114$"
set quest[questID=40001021] name "Dear, Where Are You Going?"
set quest[questID=40001021] desc "$npc:11000619$, wife of $npc:11000618$, went off to find someone to help set the \
    cart upright. \n$npc:11000618$ wishes she would stop searching and come back, but she keeps wandering, which \
    is frustrating.\nMeet $npc:11000619$ and tell her to go back to her husband."
set quest[questID=40001030] name "Emergency Repairs"
set quest[questID=40001030] desc "The earthquake cut the roads and wrecked the facilities.\n$npc:11000622$ set out \
    on recovery work before the residents' complaints pour in.\nHe wants to fix the ladders first, but the \
    $item:30000196$ needed for repairs were taken by $npc:21000007$.\nHelp $npc:11000622$, who can only stamp his \
    feet in frustration."
set quest[questID=40001030] manual "Take back $item:30000196$ from the $npc:21000007$ in $map:2000115$"
set quest[questID=40001040] name "Paul's Message"
set quest[questID=40001040] desc "Survey equipment has arrived to find the cause of the earthquake, but with the \
    Royal Guard short-handed, it is unclear when it can be used.\n$npc:11000617$, who went ahead to the survey \
    site, may be waiting endlessly for the equipment, so tell them to survey by eye for now."
set quest[questID=40001041] name "Tension and Trembling"
set quest[questID=40001041] desc "I thought the earthquake was over, but the ground is still \
    shaking.\n$npc:11000617$, sent by higher-ups to survey the aftershocks, is too scared to step forward in front \
    of the shaking ground.\nSurvey the shaking ground in place of $npcName:11000617$."
set quest[questID=40001041] manual "Inspect the shaking ground in $map:2000118$"
set quest[questID=40001050] name "Ingredients for the Banquet"
set quest[questID=40001050] desc "To prepare food in time for the banquet, the ingredients must be sent to \
    $map:2000001$ quickly.\nBring $item:30000070$ to $npc:11000157$, who is packing up to head to $map:2000001$."
set quest[questID=40001050] manual "Get $item:30000070$ from $npc:11000159$ in $map:2000118$"
set quest[questID=40001060] desc "Someone must have put a book they were reading on the wrong shelf. \
    $npc:11000670$ seems unhappy with its new home.\nTake $item:30000082$ off the shelf at the library entrance \
    and move it to the shelf where it belongs. Oh, and the original shelf is locked, so take the key from \
    $npc:21000216$.\nMaybe whoever was reading the book shelved it anywhere because the shelf was locked?"
set quest[questID=40001060] manual "Take $item:30000082$ off the shelf at the library entrance|Defeat \
    $npc:21000216$ and get $item:30000102$"
set quest[questID=40001060] complete "Open the locked bookshelf in $map:2000019$"
set quest[questID=40001080] name "The Missing Cookware"
set quest[questID=40001080] desc "Mischievous monsters stole $npc:11000705$'s cookware and hid it near the water's \
    edge in $map:02000129$.\nFind $item:30000204$ in place of $npc:11000705$, who is slow on their feet."
set quest[questID=40001080] manual "Find $item:30000204$ in the grass near the water's edge in $map:02000129$"
set quest[questID=40001130] name "A Message of Delay"
set quest[questID=40001130] desc "For some reason, the Royal Guard dispatched to $map:02000118$ is suffering a \
    food shortage. They say they even asked $npc:11000546$ to bring food......\n$npcName:11000546$, who normally \
    does not handle food, must stop by the village to get some and will arrive at the Royal Guard base later than \
    planned. Pass this news on to $npc:11000157$.\nOh, and defeat the monsters in $map:02000118$ so \
    $npcName:11000546$ can reach the Royal Guard base even a little sooner."
set quest[questID=40001130] manual "Defeat the monsters in $map:02000118$"
set quest[questID=40001150] name "The Axe Comb Thief"
set quest[questID=40001150] desc "$npc:11000795$ is worried that the stock of $item:30000244$, which has not even \
    been sold, has dwindled.\nThey may have to cover the shortfall out of their own pocket. \nSomeone saw \
    $npc:21000013$ stealing $item:30000244$, so take $item:30000244$ back from $npc:21000013$ and bring it to \
    $npc:11000795$."
set quest[questID=40001150] manual "Defeat $npc:21000013$ in $map:02000147$ and get $item:30000244$"
set quest[questID=40001150] complete "Bring $item:30000244$ to $npc:11000795$ in $map:02000209$"
set quest[questID=40001160] name "Buy Drinks at the Mart"
set quest[questID=40001160] desc "$npc:11000352$ says that patrolling the park under the hot sun makes one thirsty \
    fast.\nFor $npcName:11000352$, who can hardly leave the park even for a moment, stop by $map:02000209$ and buy \
    $item:30000245$.\nOh, if you tell the mart clerk it is an errand for $npcName:11000352$, no payment is \
    needed."
set quest[questID=40001160] manual "Take $item:30000245$ from the refrigerator in $map:02000209$"
set quest[questID=40001160] complete "Talk with $npc:11000795$ in $map:02000209$"
set quest[questID=40001161] name "Time to Settle Up"
set quest[questID=40001161] desc "$npc:11000795$ says $npc:11000352$'s unpaid tab has grown too big, and the boss \
    ordered no more credit until it is settled.\nLeaving the distressed $npcName:11000795$ behind, let's carry \
    this sad news to $npcName:11000352$ in $map:02000147$."
set quest[questID=40001161] complete "Meet $npc:11000352$ in $map:02000147$"
set quest[questID=40001170] name "A Swarm of Flies"
set quest[questID=40001170] desc "The fruit stand in $map:02000138$ has swarms of flies instead of customers. The \
    flies buzzing around the fruit drive away even the customers who come.\nFruit seller $npc:11000867$ is in \
    tears, sure that the flies have made a nest under the sewer.\nTake $item:30000246$ from $npc:11000867$ and \
    sprinkle $item:30000246$ under the sewer cover to drive the flies away."
set quest[questID=40001170] manual "Get $item:30000246$ from $npc:11000867$ in $map:02000138$|Sprinkle \
    $item:30000246$ under the sewer cover in $map:02000138$"
set quest[questID=40001170] complete "Meet and talk with $npc:11000867$ in $map:02000138$"
set quest[questID=40001180] name "Hush Money"
set quest[questID=40001180] desc "$npc:11000211$ says that a stranger asked them to hide a bag of unknown contents \
    and they readily agreed. They could not refuse when offered a huge sum of mesos as thanks.\nBut after doing \
    the favor, they feel uneasy somehow. What is more, some monsters even saw $npc:11000211$ hiding the bag. \
    $npc:11000211$ asks me to keep the monsters quiet so no rumors spread!\nI do not like it, but let's grant the \
    request for the anxious $npc:11000211$."
set quest[questID=40001180] manual "Defeat the monsters in $map:02000138$"
set quest[questID=40001180] complete "Talk with $npc:11000211$ in $map:02000138$"
set quest[questID=40001181] name "A Bad Feeling Is Never Wrong"
set quest[questID=40001181] desc "Did the fear come true? $npc:11000211$ says they lied to the Black Star Society, \
    who bluntly asked where the bag was, and got a thorough beating.\n$npc:11000867$ has medicine good for \
    bruises, so let's meet $npc:11000867$ for the sake of $npc:11000211$, who aches all over and can barely move."
set quest[questID=40001181] complete "Meet and talk with $npc:11000867$ in $map:02000138$"
set quest[questID=40001182] name "Even Cow Dung Is Needed for Medicine"
set quest[questID=40001182] desc "$npc:11000867$ says the medicine must be made fresh and asks me to get the \
    needed ingredients.\nThe ingredient $npc:11000867$ mentioned is none other than the head ornament of \
    $npc:21000161$!\nGet $item:30000247$ from the $npc:21000161$ in $map:02000138$ and bring it to \
    $npc:11000867$."
set quest[questID=40001182] manual "Defeat $npc:21000161$ in $map:02000138$ and get $item:30000247$"
set quest[questID=40001182] complete "Bring $item:30000247$ to $npc:11000867$ in $map:02000138$"
set quest[questID=40001183] name "Good Medicine Tastes Bitter"
set quest[questID=40001183] desc "The last ingredient needed for $npc:11000867$'s remedy is \
    $item:30000248$!\n$npc:11000867$ says the $item:30000248$ that could not be sold was thrown into the trash \
    can, and that digging through it should turn up as much $item:30000248$ as the medicine needs.\nIt is not a \
    pleasant job, but dig through the trash cans in $map:02000138$ to find $item:30000248$ and bring it to \
    $npc:11000867$."
set quest[questID=40001183] manual "Dig through the trash cans in $map:02000138$ to find $item:30000248$"
set quest[questID=40001183] complete "Bring $item:30000248$ to $npc:11000867$ in $map:02000138$"
set quest[questID=40001200] name "Put Out the Fire Hazard"
set quest[questID=40001200] desc "Gas canisters lie all around $map:02000136$, yet $npc:21000282$ keeps throwing \
    bombs here and there.\n$npc:11000222$ is anxious that $npc:21000282$ might cause a big fire or \
    explosion.\nEase $npc:11000222$'s worries by driving the $npc:21000282$ away from $map:02000136$."
set quest[questID=40001200] manual "Defeat the $npc:21000282$ in $map:02000136$"
set quest[questID=40001200] complete "Talk to $npc:11000222$ in $map:02000136$"
set quest[questID=40001240] name "The Noisy Alarm"
set quest[questID=40001240] desc "At daybreak, it falls to $npc:21000159$ to wake the sleepers. For ages, it has \
    announced the morning with its elegant, clear voice.\nBut lately a loud ringing noise has been blaring every \
    morning, and it drowns out the cock-a-doodle-doo of $npc:21000159$. \n$npc:11000996$'s pride is wounded! \
    Insisting that $npc:21000159$ is the only alarm clock in this district, it asks you to take the winding key \
    away from $npc:21000280$."
set quest[questID=40001240] manual "Take $item:30000307$ from $npc:21000280$ in $map:02000180$"
set quest[questID=40001240] complete "Bring $item:30000307$ to $npc:11000996$ in $map:02000180$"
set quest[questID=40001241] name "Getting the Winding Key Back"
set quest[questID=40001241] desc "$npc:11000997$ says someone has taken the clock winding key from $npc:21000280$ \
    and asks you to get it back.\nIt seems impossible to take either side, $npc:21000159$ or $npc:21000280$.\nFor \
    now, it is best to put things back the way they were. Find $item:30000308$ on the ground and return it to \
    $npc:11000997$."
set quest[questID=40001241] manual "Pick up $item:30000308$ from the grass in $map:02000180$"
set quest[questID=40001241] complete "Bring $item:30000308$ to $npc:11000997$ in $map:02000180$"
set quest[questID=40001242] name "The Alarm Rings Again"
set quest[questID=40001242] desc "$npc:11000996$ is puzzled, saying the alarm of $npc:21000280$ has started \
    ringing again.\nAfter some hesitation, you explain what happened, and $npc:11000996$ is furious about the \
    betrayal. It says all will be forgiven if you teach $npc:21000280$ a lesson..."
set quest[questID=40001243] name "Throwing Away the Winding Key"
set quest[questID=40001243] desc "$npc:11000996$ cannot stand to keep $item:30000307$ any longer and asks you to \
    throw it far away.\nIt says to climb the tree next to it and toss it from there..."
set quest[questID=40001243] manual "Climb the tree next to $npc:11000996$ and throw $item:30000330$ far away"
set quest[questID=40001250] name "Wanting to Look Alike"
set quest[questID=40001250] desc "$npc:11000979$ is shunned by friends because of its different color.\nWanting to \
    be black like the others, it decides to eat $item:30000309$.\nGather $item:30000309$ for $npc:11000979$."
set quest[questID=40001250] manual "Gather $item:30000309$ from the mushroom patch in $map:02000042$"
set quest[questID=40001250] complete "Bring $item:30000309$ to $npc:11000979$ in $map:02000042$"
set quest[questID=40001251] name "A Reckless Attempt"
set quest[questID=40001251] desc "$npc:11000979$ eats $item:30000309$ right away.\nIt retches, feeling queasy, and \
    unable to bear the stomachache that follows, it begs for an antidote.\nFind $item:30000310$ and feed the fairy \
    water to $npc:11000979$."
set quest[questID=40001251] manual "Find $item:30000310$ in the pond below the waterfall in $map:02000042$"
set quest[questID=40001251] complete "Bring $item:30000310$ to $npc:11000979$ in $map:02000042$"
set quest[questID=40001252] name "Live as You Are"
set quest[questID=40001252] desc "$npc:11000979$ calmed down after drinking the fairy water.\nWill Grimong's \
    attempts to change its color go on?"
set quest[questID=40001260] name "Peddlers Hate the Rain"
set quest[questID=40001260] desc "$npc:11000980$ ducked under a roof to get out of the rain.\nThere is an umbrella \
    in $map:02000239$, but taking the bundle along might get it soaked, and leaving it behind might lose it, so it \
    is stuck. On top of that, $item:30000311$ is lost, which makes things worse.\nFind $item:30000311$ on behalf \
    of $npc:11000980$ and bring $item:30000312$ from $map:02000239$."
set quest[questID=40001260] manual "Get $item:30000311$ from the monsters in $map:02000042$|Find $item:30000312$ \
    in $map:02000239$"
set quest[questID=40001260] complete "Bring $item:30000311$ and $item:30000312$ to $npc:11000980$ in \
    $map:02000042$"
set quest[questID=40001280] name "The Corn Thief"
set quest[questID=40001280] desc "$npc:11001006$ grows corn in a small vegetable patch.\nIt is not much, but it is \
    plenty for $npc:11001006$ and $npc:11001007$, mother and daughter.\nHowever, monsters have been raiding the \
    corn lately, and it has become a headache.\nTake back the $item:30000325$ the monsters stole and bring it to \
    $npc:11001006$."
set quest[questID=40001280] manual "Defeat monsters in $map:02000038$ and collect $item:30000325$"
set quest[questID=40001280] complete "Bring $item:30000325$ to $npc:11001006$ in $map:02000038$"
set quest[questID=40001290] desc "What lies beyond the rainbow? $npc:11001007$ is curious about the world past the \
    rainbow.\nBut $npc:11001007$'s mother warned never to even loiter near the entrance to that place.\nThat only \
    makes curiosity stronger. Take a look at $map:02000305$ and come back to tell $npc:11001007$."
set quest[questID=40001290] manual "Find $npc:11001008$ in $map:02000305$"
set quest[questID=40001300] name "Can't Go Back Empty-Handed"
set quest[questID=40001300] desc "$npc:11001009$ came all this way after hearing a rumor that climbing the \
    beanstalk leads to a place overflowing with treasure.\nBut the beanstalk led somewhere far from any \
    treasure.\n$npc:11001009$ says people will laugh if it returns empty-handed. It must bring something back, and \
    has set its eyes on $item:30000326$."
set quest[questID=40001300] manual "Hunt $npc:21000201$ in $map:02000131$ and collect $item:30000326$"
set quest[questID=40001300] complete "Bring $item:30000326$ to $npc:11001009$ in $map:02000131$"
set quest[questID=40001310] name "Intern Thurman"
set quest[questID=40001310] desc "$npc:11001010$ of Cash Mart came to $map:02000063$ to do business with the \
    pirates, but says the pirates took all the goods it brought.\nReturning empty-handed will surely mean getting \
    fired. Help poor $npc:11001010$ by getting back the goods the pirates took."
set quest[questID=40001310] manual "Get back $item:30000327$ from the monsters in $map:02000063$"
set quest[questID=40001310] complete "Bring $item:30000327$ to $npc:11001010$ in $map:02000063$"
set quest[questID=40001320] name "Noisy Neighbors"
set quest[questID=40001320] desc "$npc:11001011$ moved to $map:02000182$ after being told it was a quiet beach \
    house with a nice view.\nAll there is to see is cliffs, and what you hear is not the sound of waves but \
    pirates yelling and bombs going off!\nHaving found out too late that the contract cannot be undone, it lives \
    on in resignation.\nBut you cannot just keep putting up with it forever! Let's at least try to quiet the \
    noise."
set quest[questID=40001330] name "A New Home"
set quest[questID=40001330] desc "$npc:11001012$ came here after hearing that time had stopped in the Ludibrium \
    region.\nWith time stopped, it says nobody will age or grow old any more, so it plans to settle down \
    here.\nBut it worries about its safety because of the monsters..."
set quest[questID=40001340] name "I'm a Magical Girl"
set quest[questID=40001340] desc "$npc:11001015$, a self-proclaimed magical girl, came to $map:02000214$ to save \
    people who were cursed into monsters! It is too much to fight the monsters alone, so she asks you to rescue \
    the souls dwelling in them."
set quest[questID=40001340] complete "Talk to the magical girl $npc:11001015$ in $map:02000214$"
set quest[questID=40001350] name "The Witch's Loyal Hound"
set quest[questID=40001350] desc "The witch $npc:21400746$ was pushed away by the fairies for wielding dark magic \
    and lived in the dark. She awakened the beast $npc:23000047$, sealed away by three Sages, and made it her \
    loyal hound.\nBut contrary to the fairies' fears, $npc:21400746$ and $npc:23000047$ never showed \
    themselves.\n$npc:11001015$, the self-proclaimed magical girl, followed their trail all the way to \
    $map:02000214$. She burns with the will to defeat the dark witch and the legendary beast, seal their souls, \
    and help bring peace to Maple World."
set quest[questID=40001350] manual "(Boss) Defeat $npc:23000047$ in $map:02000214$"
set quest[questID=40001350] complete "Talk to the magical girl $npc:11001015$ in $map:02000214$"
set quest[questID=40001360] name "Not Easy to Quit"
set quest[questID=40001360] desc "$npc:11001063$ says the rough, harsh daily life is hard to get used to, after \
    experiencing the pirate life it had long admired.\nIt wants to leave the pirate crew and quit, but since the \
    crew will not let it go easily, it tried to escape in secret. But it cannot move easily, afraid of being \
    caught by comrades all over $map:02000067$..."
set quest[questID=40001370] name "A Mysterious Test"
set quest[questID=40001370] desc "$npc:11001064$ says it came here as a member of $map:02000068$.\nIt is on a \
    secret mission but cannot manage alone, so it asks for help.\nYou have no idea what it is up to, but it asked \
    for help, so let's lend a hand.\n"
set quest[questID=40001370] manual "Receive $item:30000364$ from $npc:11001064$|Set up filming equipment all \
    around $map:02000183$"
set quest[questID=40001371] name "The Real Mission"
set quest[questID=40001371] desc "$npc:11001064$ says it is collecting planks that washed up and lie scattered on \
    the sand.\nIt does not say clearly what they are for, but it seems important. After all, you must not skip \
    even a single plank hidden out of sight, it says."
set quest[questID=40001371] manual "Pick up planks lying around $map:02000183$"
set quest[questID=40001371] complete "Bring $item:30000365$ to $npc:11001064$"
set quest[questID=40001380] name "Petty Desire"
set quest[questID=40001380] desc "$npc:11001065$ says it stays inside the castle, afraid of the monsters \
    outside.\nOne day, an old woman visiting the castle proposed a bet. After winning it, she cast a spell on the \
    people in the castle and turned them into monsters.\nWhen leaving, the old woman told how to break the spell: \
    gather fresh roses blooming in the garden, make a wreath, and place it on a monster..."
set quest[questID=40001380] manual "Defeat the monsters in the garden of $map:02000132$"
set quest[questID=40001390] name "The Source of Summoning"
set quest[questID=40001390] desc "$npc:11000304$ covets the $item:30000366$ that $npc:22090007$ carries, hoping to \
    master summoning magic.\nWhen $npc:22090007$ appears in $map:02000132$, take $item:30000366$ and bring it to \
    $npc:11000304$."
set quest[questID=40001390] manual "(Elite) Defeat $npc:22090007$ and get $item:30000366$"
set quest[questID=40001390] complete "Bring $item:30000366$ to $npc:11000304$"
set quest[questID=40001400] name "Lives Matter Most"
set quest[questID=40001400] desc "$map:02000038$ is thick with trees, so lumberjacks visit often, but monsters, \
    especially $npc:22000024$, make it a place of many accidents.\nAccording to $npc:11000001$, the lumberjacks \
    often demanded that vigilantes be sent to defeat $npc:22000024$. But some argued that logging in \
    $map:02000038$ should be banned to protect the forest, so their demands could not be granted easily..."
set quest[questID=40001410] name "Their Playing Is Noise"
set quest[questID=40001410] desc "$npc:11000869$ cannot concentrate on research because of the noise made by the \
    monsters $npc:21000169$, $npc:21000172$ and $npc:21000174$ in $map:02000142$. Beautiful music helps focus, but \
    the sounds they make are just noise...\nTake the instruments from the monsters and help $npc:11000869$ with \
    the research."
set quest[questID=40001410] manual "Take $item:30000367$ from $npc:21000169$|Take $item:30000368$ from \
    $npc:21000174$|Take $item:30000369$ from $npc:21000172$"
set quest[questID=40001420] name "Rails Without a Train"
set quest[questID=40001420] desc "$npc:11001066$ stands in a daze, as if waiting for something.\nThere was a time \
    when the $map:02000184$ tour train, packed with laughing, chattering children, ran along these rails.\nBut now \
    no children visit $map:02000184$, and the train has been scrapped...\n$npc:11001066$ believes monsters \
    occupying $map:02000184$ are to blame. If only the monsters were gone, $map:02000184$ could come back to life, \
    it says."
set quest[questID=40001420] manual "Defeat the monsters in $map:02000184$"
set quest[questID=40001430] name "A Suspicious Gift Box"
set quest[questID=40001430] desc "$npc:11001067$ welcomes you to $map:02000184$.\nIt says gifts were prepared for \
    every visitor and tells you to look for the gift boxes placed all around $map:02000184$.\nWhat could be inside \
    the gift boxes?"
set quest[questID=40001440] name "Mixed-Up Times"
set quest[questID=40001440] desc "$npc:11000847$ compares $map:02000184$ with $map:02000255$,\nand suspects that \
    time and space are mixed up all over the Ludibrium region. \nTo turn suspicion into certainty, it wants to \
    confirm whether the robots in $map:02000255$ were made in the future, and asks you to get memory chips that \
    reveal when a robot was produced."
set quest[questID=40001440] manual "Get $item:30000370$ from $npc:21000243$|Get $item:30000371$ from \
    $npc:21000240$"
set quest[questID=40001450] name "For a Safe Show"
set quest[questID=40001450] desc "$npc:11001068$ worries because the rock band 'Oil and Water' is about to \
    perform, but the venue is not yet in order.\nUnruly spectators could cause accidents, so it asks you to find \
    the $item:30000372$ stolen by monsters and set it up in front of the venue."
set quest[questID=40001450] manual "Get back $item:30000372$ from the monsters in $map:02000231$ and set it up in \
    front of the venue"
set quest[questID=40001460] name "A Glutton's Dream"
set quest[questID=40001460] desc "$npc:11000053$ is delighted to have finally found the greatest paradise on \
    earth, and looks ready to eat all of $map:02000257$.\nIt wants to taste the candy-like trees and soak in the \
    sweet-scented pond, but the monsters are in the way...\n"
set quest[questID=40001460] manual "Defeat the monsters in $map:02000257$"
set quest[questID=40001470] name "My Dream Come True"
set quest[questID=40001470] desc "$npc:11000784$ is amazed that $map:02000018$ is the place seen in a \
    dream.\n$npc:11000784$ wonders whether it is still asleep and lost in a dream.\nWhatever the truth is, it \
    cannot stand monsters swarming its dream,\nand asks you to clear the monsters from its pretty, lovely place."
set quest[questID=40001470] manual "Defeat the monsters in $map:02000018$"
set quest[questID=40001480] name "Dangerous Intruders"
set quest[questID=40001480] desc "$npc:11000849$ says it is from another time. It tried time travel and came here, \
    but accidentally brought the monsters from where it used to be. It does not want to cause chaos here, and asks \
    you to defeat the monsters..."
set quest[questID=40001480] manual "Defeat the monsters in $map:02000258$"
set quest[questID=40001490] name "Drive Out the Jawbreaker Gang"
set quest[questID=40001490] desc "A construction site has appeared in the $map:02000051$ area, where nature is \
    well preserved.\nThe residents of Perion strongly objected, but those behind the construction reportedly sent \
    in the Jawbreaker Gang to subdue the residents.\n$npc:11001072$ asks you to drive the Jawbreaker Gang, who \
    harassed its parents and the residents, out of town..."
set quest[questID=40001490] manual "Defeat $npc:21000308$ and $npc:21000309$ in $map:02000094$"
set quest[questID=40001500] name "How to Honor a Hero"
set quest[questID=40001500] desc "Back when the Demon King was sealed, 'Ten' was one of the four heroes who fought \
    alongside $npc:11000075$, and came from the Kaka tribe. $npc:11000887$, a descendant of the Kaka tribe, is \
    full of complaints that while the three surviving heroes are honored as guardians of Lapenta, 'Ten', who gave \
    up his life, got no special treatment. \nTo restore the honor of Ten and the Kaka tribe, it decided to propose \
    a memorial park for Ten and collected signatures, but the petitions left on the ground were blown away by the \
    wind and fell into the hands of monsters. Get the petitions back and deliver them to $npc:11000887$."
set quest[questID=40001500] manual "Defeat monsters in $map:02000133$ and get $item:30000373$"
set quest[questID=40001500] complete "Bring $item:30000373$ to $npc:11000887$ in $map:02000133$"
set quest[questID=40001510] name "The Hero's Resting Place"
set quest[questID=40001510] desc "The warrior 'Ten' is said to have sat on a rock to cool off after \
    battles.\n$npc:11000500$ is proud of having helped 'Ten', a hero of the Kaka tribe and of all Maple World.\nIt \
    says it will remain a resting place for heroes alone, and cannot allow others to sit on the rock.\nIt \
    especially cannot forgive monsters that kick the rock..."
set quest[questID=40001510] manual "Defeat the monsters in $map:02000061$"
set quest[questID=40001520] name "Side Effects of Yakayama Fruit"
set quest[questID=40001520] desc "$npc:11000790$ tells the story of the Foremagasi tribe, wiped out by the curse \
    of the Mountain Hag.\nIt says it is the last survivor of the Foremagasi tribe, and ate Yakayama fruit to speed \
    up aging and hide its identity.\nAs a side effect, its body itches often. When that happens, rubbing with the \
    mane of $npc:21000111$ makes the itch go away..."
set quest[questID=40001520] manual "Get $item:30000374$ from $npc:21000111$ in $map:02000044$"
set quest[questID=40001530] name "Qualified Martial Artist"
set quest[questID=40001530] desc "$npc:11001073$ says $map:02000097$, the closest place to the sky, is the ideal \
    place for training.\nTo speak with it, you must be a martial artist of its own rank, it says, and it will talk \
    with you once you defeat the monsters in $map:02000097$."
set quest[questID=40001530] manual "Defeat the monsters in $map:02000097$"
set quest[questID=40001540] name "The Exhibited Paintings"
set quest[questID=40001540] desc "$npc:11001074$ is propping up the paintings that fell on the floor. Here, the \
    children's drawings are put in frames or set on easels for display.\nBut mischievous monsters keep hanging the \
    frames crooked and knocking over the easels.\nIt cannot leave things like that, so it keeps straightening the \
    frames and standing the easels up, but it is quite a chore.\nTeach the monsters a lesson so they stop their \
    mischief."
set quest[questID=40001540] manual "Defeat the monsters in $map:02000266$"
set quest[questID=40001550] name "Memory Chips for the Black Market"
set quest[questID=40001550] desc "Dr. Katronic developed a budget maid robot to make robot goods widespread. But a \
    virus planted by someone made some of the robots aggressive, and the lab was shut down after their \
    attacks.\nSince then, some people have taken an interest in the maid robots' aggressiveness, and the memory \
    chips holding the robots' AI are sold on the black market at high prices.\nHelp $npc:11001075$, who came to \
    $map:02000265$ to get $item:30000375$."
set quest[questID=40001550] manual "Defeat monsters in $map:02000265$ and get $item:30000375$"
set quest[questID=40001550] complete "Bring $item:30000375$ to $npc:11001075$ in $map:02000265$"
set quest[questID=40001560] name "Finding the Lost Wallet"
set quest[questID=40001560] desc "$npc:11000244$ suddenly screams.\nIt lost a wallet stuffed with cash.\nIt says \
    the robots hovering around must have picked its pocket..."
set quest[questID=40001560] manual "Get back $item:30000376$ from the monsters in $map:02000279$"
set quest[questID=40001560] complete "Bring $item:30000376$ to $npc:11000244$ in $map:02000279$"
set quest[questID=40001580] name "Dungeon: Hens in Danger"
set quest[questID=40001580] desc "$dungeonTitle:25002001$\n(Entrance map: $map:02000087$)\n\nThe Monkey Gang, \
    startled by the giant snail $npc:24001006$, worships it like a god.\nTo win the favor of $npc:24001006$, the \
    Monkey Gang is preparing chicken dishes as an offering.\nHelp $npc:11001141$, who is in a fix because all of \
    its hens have vanished,\nby defeating the Monkey Gang and rescuing the hens locked in the coop.\n"
set quest[questID=40001580] manual "Open the coop door and rescue all the hens"
set quest[questID=40001590] name "Dungeon: The Hens Vanish Again"
set quest[questID=40001590] desc "$dungeonTitle:25002001$\n(Entrance map: $map:02000087$)\n\nThe hens of \
    $npc:11001141$ have vanished again.\n$npc:24001006$ seems to have no real interest in chicken dishes,\nbut the \
    Monkey Gang still tries to cook chicken and offer it up.\nRescue the hens that were kidnapped once more and \
    return them to $npc:11001141$."
set quest[questID=40001590] manual "Open the coop door and rescue all the hens"
set quest[questID=40001620] name "The Start of Ruin Preservation"
set quest[questID=40001620] desc "$map:02000130$ is badly damaged, but its tall stacked walls and the shape of the \
    town remain intact.\n$npc:11001143$ is taken with the grandeur of $map:02000130$ and decides to devote itself \
    to preserving the ruins.\n$npc:11001143$ judged that the most urgent task is to get rid of the monsters \
    destroying the ruins.\nHelp out and do your part in preserving the ruins."
set quest[questID=40001620] manual "Defeat the monsters in $map:02000130$"
set quest[questID=40001640] name "Weapons Without a Master"
set quest[questID=40001640] desc "$npc:11001148$ is a greedy collector who will search all over Maple World, \
    through fire and water, to find outstanding weapons.\n$npc:11001148$ covets the various weapons stored in a \
    fortress long abandoned and now without a master. $npc:11001148$ wonders whether weapons left unmaintained for \
    so long still work, and asks you to test-fire the cannon in $map:02000021$."
set quest[questID=40001640] manual "Operate the old cannon in $map:02000021$|Collect $item:30000396$"
set quest[questID=40001950] name "Introduction to Fishing"
set quest[questID=40001950] desc "According to $npc:11000003$, $npc:11000781$ in $map:02000002$ is giving out \
    fishing rods for free. There is no telling when $npc:11000781$ might change its mind, so hurry and go get \
    one."
set quest[questID=40001960] name "The First Feel of a Catch"
set quest[questID=40001960] desc "$npc:11000781$ explains in more detail how to catch fish. Especially for a kind \
    of fish you are catching for the first time, it is important to keep the float at the right height.\nRemember \
    $npc:11000781$'s advice and try catching fish."
set quest[questID=40001960] manual "Catch a fish by fishing"
set quest[questID=40001970] name "Fish That Live Elsewhere"
set quest[questID=40001970] desc "$npc:11000781$ says the kinds of fish you can catch differ depending on where \
    they live. \nFollow the suggestion of $npc:11000781$ and try catching fish that live in poison."
set quest[questID=40001970] manual "Catch a fish in the poison in $map:02000002$"
set quest[questID=40001980] name "Dungeon: Why the Water Never Dries Up"
set quest[questID=40001980] desc "$dungeonTitle:21010001$ \n(Entrance map: $map:02010084$)\nParty recommended (4 \
    players)\n\nThe villagers regularly offer sacrifices to the ruler of the underground cave so the stream \
    running through the village never dries up. Nobody has ever seen the ruler or knows much about it, but they \
    obey without question, afraid the stream from underground might be cut off.\nBut now they have no livestock \
    left to offer and are at their wits' end... They say catching monsters to offer would save them from the \
    crisis, so go hunting in their place."
set quest[questID=40001990] name "Dungeon: Why They Can't Settle Down"
set quest[questID=40001990] desc "$dungeonTitle:21010001$ \n(Entrance map: $map:02010084$)\nParty recommended (4 \
    players)\n\n$npc:24001309$ thought the villagers had deliberately sent a hero to put it in its place. Furious, \
    it demanded even more sacrifices from the villagers, they say.\n$npc:11001437$ and the villagers ask you to \
    teach $npc:24001309$ a proper lesson so it stops threatening them. They look so pitiful trembling with fear, \
    so help them again this time."
set quest[questID=40002000] name "Dungeon: The Bug Den"
set quest[questID=40002000] desc "$dungeonTitle:20017001$ \n(Entrance map: $map:02010019$)\nParty recommended (4 \
    players)\n\n$map:02010019$ took over the villagers' small swimming pool. It left the old pool abandoned and is \
    building a state-of-the-art water park next to it.\nTime passed, and the water left standing in the neglected \
    pool rotted and gave off a terrible stench. Eventually the stench drifted into the newly built water \
    park...\nSo $map:02010019$ decided to clean $map:02010050$. But the place is already a home to bugs. Cleaning \
    is impossible without getting rid of them."
set quest[questID=40002010] name "Dungeon: The Bugs United"
set quest[questID=40002010] desc "$dungeonTitle:20017001$ \n(Entrance map: $map:02010019$)\nParty recommended (4 \
    players)\n\nThey expected that once $npc:23190066$ was defeated, the crowd following it would lose heart and \
    leave, but instead the bugs have banded together, and it seems bugs from other regions have joined them.\nYou \
    doubt that fighting bugs is the only answer, but grant the request of $npc:11001444$."
set quest[questID=40002170] name "The Noisy Pioneer Merchant"
set quest[questID=40002170] desc "$npc:11001310$ came to $map:02010002$ on a mission. $npc:11001369$, who keeps \
    pestering it noisily, seems to be getting on its nerves. Talk to $npc:11001369$ and find out what it wants to \
    do."
set quest[questID=40002540] name "You Too Shall Become Light"
set quest[questID=40002570] name "Looking for Someone to Help"
set quest[questID=40002570] desc "$npcName:11000221$ is looking for someone to help. Meet $npcName:11000221$ and \
    ask what kind of help is needed."
set quest[questID=40002570] complete "Talk to $npcName:11000221$ in $map:02000136$"
set quest[questID=40002580] name "Without Anyone Knowing"
set quest[questID=40002580] desc "A message came telling you to check the secret orders left on the shabby desk in \
    $map:03000135$. Who sent it, and what does it say?"
set quest[questID=40002580] complete "Examine $npcName:11000909$ in $map:03000135$"
set quest[questID=40002590] name "The Mission Continues"
set quest[questID=40002590] desc "$npcName:11000614$ is waiting in $map:03000135$. What mission awaits..."
set quest[questID=40002590] complete "Talk to $npcName:11000614$ in $map:03000135$"
set quest[questID=40002600] name "Wei Hong's Scheme"
set quest[questID=40002600] desc "While everyone is disappointed that the Levee was canceled, one person is \
    smiling: $npcName:11000251$.\nAccording to $npcName:11001690$, $npcName:11000251$ has courted the royal \
    official in charge in order to siphon off, or buy cheaply, the goods made useless by the cancellation of the \
    Levee."
set quest[questID=40002600] complete "Talk to $npcName:11001690$ in $map:52000034$"
set quest[questID=40002601] name "Nelph, the Two-Faced"
set quest[questID=40002601] desc "Now that you know $npcName:11000492$ is involved in the armory theft, it has \
    become hard to siphon off the Levee goods any more. How can you calm $npcName:11000251$, who must be furious \
    that the plan fell apart..."
set quest[questID=40002601] complete "Talk to $npcName:11001674$ in $map:52000034$"
set quest[questID=40002602] name "Nelph's Whereabouts"
set quest[questID=40002602] desc "Because of the armory theft staged by $npcName:11000492$, the Black Star \
    Society's plan to siphon off the Levee goods came to nothing. If $npcName:11000492$ is not caught and made to \
    kneel before $npcName:11000251$, there is no telling where $npcName:11000251$'s anger will turn. Hurry and \
    track down $npcName:11000492$."
set quest[questID=40002602] complete "Talk to $npcName:11001674$ in $map:52000034$"
set quest[questID=40002603] name "The Black House"
set quest[questID=40002603] desc "$npcName:11001677$ says it was hard to stand guard because it was so noisy while \
    $map:52000034$ was under construction. It does not know why, but it says it is a relief that the construction \
    has stopped. Go to the place $npcName:11001677$ told you about."
set quest[questID=40002603] complete "Talk to $npcName:11001690$ in $map:52000034$"
set quest[questID=40002604] name "What Nelf Left Behind"
set quest[questID=40002604] desc "You made it to $map:52000037$ in $map:02000043$, marked on the crumpled memo... \
    but sadly, $npc:11000492$ was dead. Why is $npc:11000492$ dead in a place like this? What on earth happened to \
    it?\nPerhaps there are clues nearby that can answer the unresolved questions about the corruption and the \
    death?\nCollect yourself and look carefully around $npc:11000492$."
set quest[questID=40002604] manual "Find clues around $npc:11000492$ in $map:52000037$"
set quest[questID=40002604] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=40002605] name "A New Clue"
set quest[questID=40002605] desc "After hearing about $npc:11000492$'s death and the mysterious notebook found \
    nearby, $npc:11000169$ asked you to report your findings so far directly to $npc:11000119$.\nLet's meet \
    $npcName:11000119$ in $map:02000001$. "
set quest[questID=40002605] manual "Get the mysterious notebook back from $npc:11000169$ in $map:02000001$"
set quest[questID=40002605] complete "Meet $npc:11000119$ in $map:02000001$"
set quest[questID=40002606] name "Jabeth's Summons"
set quest[questID=40002606] desc "$npc:11001682$ was waiting for the Ashen Wolf in $map:52000034$. What was it so \
    eager to say?"
set quest[questID=40002606] complete "Talk to $npcName:11001682$ in $map:52000034$"
set quest[questID=40002610] name "A Thorn in the Eye"
set quest[questID=40002610] desc "It is no secret in $map:02000100$ that the Black Star Society distributes \
    $item:20000046$ and $item:20000015$. What is more, nobody is making an issue of it. Only Dark Wind disapproves \
    and picks a fight..."
set quest[questID=40002610] complete "Talk to $npcName:11001674$ in $map:52000034$"
set quest[questID=40002611] name "A Secret Member of the Black Star Society"
set quest[questID=40002611] desc "$npcName:11001674$ passes the boss's orders to the Ashen Wolf. It says that if \
    you sense anything unusual while going in and out of Dark Wind, report it to the Black Star Society at once."
set quest[questID=40002611] complete "Talk to $npcName:11001682$ in $map:52000034$"
set quest[questID=40002612] name "A Target for Surveillance"
set quest[questID=40002612] desc "$npcName:11000251$ hands a notebook to the Ashen Wolf. It seems to have belonged \
    to a Dark Wind member. What could be written in it?"
set quest[questID=40002612] manual "Double-click $item:39000050$ in your inventory to check its contents"
set quest[questID=40002612] complete "Talk to $npcName:11000251$ in $map:02000156$"
set quest[questID=40002613] name "Dark Wind Orders"
set quest[questID=40002613] desc "They say the Dark Wind captain $npcName:11000044$ is looking for me.\nGo to \
    $map:02000152$ in $map:02000100$."
set quest[questID=40002613] complete "Meet $npcName:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=40002614] name "A Routine Summons"
set quest[questID=40002614] desc "Every so often, $npc:11001682$ summons the Ashen Wolf to $map:52000034$. It does \
    not seem to have anything in particular to say..."
set quest[questID=40002614] complete "Talk to $npcName:11001682$ in $map:52000034$"
set quest[questID=40002620] name "Jacy's Summons"
set quest[questID=40002620] desc "$npcName:11000515$ welcomes the Ashen Wolf who came to $map:02000216$.\nWhat did \
    it want to say when it called you?"
set quest[questID=40002620] complete "Talk to $npcName:11000515$ in $map:02000216$"
set quest[questID=40002621] name "What She Wants to Say"
set quest[questID=40002621] desc "$npcName:11000515$ expresses doubt that Humblis was named as the culprit of the \
    theft of the Levee goods."
set quest[questID=40002621] complete "Talk to $npcName:11000515$ in $map:02000216$"
set quest[questID=40002622] name "A Lonely Secret"
set quest[questID=40002622] desc "They say the Dark Wind captain $npcName:11000044$ is looking for me.\nGo to \
    $map:02000152$ in $map:02000100$."
set quest[questID=40002622] complete "Meet $npcName:11000044$ at $map:02000152$ in $map:02000100$"
set quest[questID=40002630] name "New Orders"
set quest[questID=40002630] desc "A building managed by Beyond Link has been found in the Land of Darkness. Join \
    the group of $npcName:11001678$ and $npcName:11001686$ and investigate the building."
set quest[questID=40002630] manual "Go to $map:52000038$ in $map:03000134$ and remove the threats"
set quest[questID=40002630] complete "Talk to $npcName:11001686$ in $map:52000038$"
set quest[questID=40002631] name "A Suspicious Warehouse"
set quest[questID=40002631] desc "$npcName:11001678$ finds it suspicious that an apparently abandoned warehouse \
    has such a well-equipped security system. What information can be found here? And what information does \
    $npcName:11000251$ want?"
set quest[questID=40002631] manual "Check $npcName:11001691$"
set quest[questID=40002631] complete "Talk to $npcName:11001686$ in $map:52000038$"
set quest[questID=40002632] name "A Meaningless Clue"
set quest[questID=40002632] desc "While examining parts of the warehouse's guard robot, $npcName:11001678$ spots a \
    familiar place name among the text written on a part. Can you get what you want if you go there?"
set quest[questID=40002632] complete "Talk to $npcName:11001686$ in $map:52000038$"
set quest[questID=40002633] name "Where I Am Not"
set quest[questID=40002633] desc "Word came from the Black Star Society to investigate $map:52000039$. \
    $npcName:11001679$ and $npcName:11001687$ have already set out, so hurry to $map:52000039$."
set quest[questID=40002633] manual "Go to $map:52000039$ in $map:03000145$ and remove the threats"
set quest[questID=40002633] complete "Talk to $npcName:11001687$ in $map:52000039$"
set quest[questID=40002634] name "Comradeship Shines in a Crisis"
set quest[questID=40002634] desc "$npcName:11001679$ is said to be in danger. $npcName:11001687$ urgently says to \
    go rescue $npcName:11001679$..."
set quest[questID=40002634] manual "Rescue $npcName:11001679$ from danger"
set quest[questID=40002634] complete "Talk to $npcName:11001679$ in $map:52000039$"
set quest[questID=40002635] name "The Full Investigation"
set quest[questID=40002635] desc "It seems all the threats in $map:52000039$ have been cleared. Time to \
    investigate the inside in earnest."
set quest[questID=40002635] manual "Check $npcName:11001692$"
set quest[questID=40002635] complete "Talk to $npcName:11001680$ in $map:52000039$"
set quest[questID=40002636] name "A Matter You Can't Step Into"
set quest[questID=40002636] desc "$npcName:11000515$ says $npcName:11000251$ is looking for you and tells you to \
    head to $map:02000156$."
set quest[questID=40002636] complete "Talk to $npcName:11000251$ in $map:02000156$"
set quest[questID=40002640] name "The One Blocking the Way"
set quest[questID=40002640] desc "You have arrived at $map:63000038$, where the people of the back alleys were \
    taken. Worried about whether they are alive, hurry and go rescue them."
set quest[questID=40002640] manual "Defeat $npcName:24002802$ in $map:63000038$"
set quest[questID=40002641] name "Searching for the People of the Back Alleys"
set quest[questID=40002641] desc "According to $npcName:11001782$, the people of the back alleys are locked up in \
    $map:63000039$. Hurry there and set them free."
set quest[questID=40002641] manual "Rescue the people of the back alleys locked up in $map:63000039$"
set quest[questID=40002641] complete "Talk to $npcName:11001736$ in $map:52000046$ in $map:02000138$"
set quest[questID=40002650] name "A Sacrifice for Me"
set quest[questID=40002650] desc "To stop putting Guidance in danger any longer, and to learn who I am, I can no \
    longer turn away from Beyond Link and Kandura. Without hesitating, let's go into $map:63000038$."
set quest[questID=40002650] manual "Face off against $npcName:24002801$ in $map:63000038$"
set quest[questID=40002651] name "Another Sacrifice"
set quest[questID=40002651] desc "Leave behind $npcName:11001789$, who was wounded in my place, and face \
    $npcName:11001780$."
set quest[questID=40002651] manual "Watch the final moments of $npcName:11001780$ in $map:63000038$"
set quest[questID=40002652] name "A New Family"
set quest[questID=40002652] desc "$npcName:11001791$ says there is something it wants to show you. Follow it and \
    move to $map:63000040$."
set quest[questID=40002652] manual "Read all the data on $npcName:11001794$ in $map:63000040$"
set quest[questID=50000010] name "Form a Party with Your Spouse and Defeat Humanoid Monsters Together"
set quest[questID=50000020] name "Form a Party with Your Spouse and Defeat Monsters in $map:02000264$ Together"
set quest[questID=50000030] name "Form a Party with Your Spouse and Defeat Monsters in $map:03000092$ Together"
set quest[questID=50000040] name "Form a Party with Your Spouse and Attack Monsters Together by Throwing a Tent in \
    $map:02010023$ or Elsewhere"
set quest[questID=50000050] name "Form a Party with Your Spouse and Attack Monsters Together by Pushing a Trash \
    Can in $map:02000147$ or Elsewhere"
set quest[questID=50000060] name "Form a Party with Your Spouse and Attack Monsters Together by Smashing Down a \
    Perion House in $map:02000267$ or Elsewhere"
set quest[questID=50000067] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000064$"
set quest[questID=50000068] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000001$"
set quest[questID=50000069] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000062$"
set quest[questID=50000070] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000076$"
set quest[questID=50000071] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000023$"
set quest[questID=50000072] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000051$"
set quest[questID=50000073] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:02000100$"
set quest[questID=50000074] name "Form a Party with Your Spouse and Each Say 'Hello' to Passersby in \
    $map:84000001$"
set quest[questID=50000075] name "Form a Party with Your Spouse and Stay in $map:02000001$ Together for 5 Minutes"
set quest[questID=50000076] name "Form a Party with Your Spouse and Stay in $map:02000062$ Together for 5 Minutes"
set quest[questID=50000077] name "Form a Party with Your Spouse and Stay in $map:02000076$ Together for 5 Minutes"
set quest[questID=50000078] name "Form a Party with Your Spouse and Stay in $map:02000023$ Together for 5 Minutes"
set quest[questID=50000079] name "Form a Party with Your Spouse and Stay in $map:02000051$ Together for 5 Minutes"
set quest[questID=50000080] name "Form a Party with Your Spouse and Stay in $map:02000100$ Together for 5 Minutes"
set quest[questID=50000090] name "Form a Party with Your Spouse and Each Catch a Fish in Poison by Fishing"
set quest[questID=50000100] name "Form a Party with Your Spouse and Each Hang on a Ladder for 1 Minute"
set quest[questID=50000110] name "Form a Party with Your Spouse and Play Music Together in $map:02000062$ for 5 \
    Minutes"
set quest[questID=50000120] name "Form a Party with Your Spouse and Defeat $npc:22000003$, $npc:22090166$, \
    $npc:22000001$ and $npc:22000034$"
set quest[questID=50001000] name "Merin Is Missing"
set quest[questID=50001000] desc "$npc:11001167$ is wandering all over $map:02000101$ looking for younger sibling \
    $npc:11001166$.\n$npc:11001166$ loves hanging out with friends and seems to have gone into the dangerous \
    $map:02000331$...\nFind $npc:11001166$ and bring it back to safety."
set quest[questID=50001000] complete "Find $npc:11001166$ in $map:02000101$ and talk to it"
set quest[questID=50001001] name "Dungeon: Help for the Children "
set quest[questID=50001001] desc "$dungeonTitle:25004001$ \n(Entrance map: $map:2000101$)\n\nJust as \
    $npcName:11001167$ expected, $npcName:11001166$ sneaked into $map:2000331$ with friends. It sensed the \
    presence of a prickly wizard said to attack anyone who enters the forest, ran away, and has been hiding and \
    trembling in the south of $map:2000101$. \nGo into $map:2000331$ with $npcName:11001166$, who worries that its \
    friends are still in $map:2000331$, and help the friends."
set quest[questID=50001001] manual "Defeat the monsters hiding in $map:02000331$|Help all the children in danger \
    in $map:02000331$"
set quest[questID=50001010] name "Dungeon: Escape Helper"
set quest[questID=50001010] desc "$dungeonTitle:25004001$ \n(Entrance map: $map:2000101$)\n\n$npc:11001166$ and \
    friends sneaked into $map:02000331$ to play hide and seek, and were caught by the wizard again.\nOnce more, \
    help these carefree, adorable kids escape from $map:2000331$ safely."
set quest[questID=50001010] manual "Help all the children in danger in $map:02000331$"
set quest[questID=50001020] desc "$npc:11001191$ of Maple TV is filming a documentary on ecological anomalies \
    around Maple World. \nThe filming sites were chosen as $map:2000045$, $map:2000003$, $map:2000010$, \
    $map:2000255$ and $map:2000007$, and the cameras are all installed, but the crew members sent to retrieve the \
    footage have not returned, which is worrying. Above all, $npc:11001195$, who went to a site first of all, has \
    not come back for days... Go to $map:2000045$ and find him. "
set quest[questID=50001021] name "Dungeon: The Fate of Baseless Confidence"
set quest[questID=50001021] desc " \n(Entrance map: $map:2000045$)\n\n$npc:11001195$ fell for $npc:11001191$ at \
    first sight after a chance meeting and came out to the site to retrieve the filming tapes for her. But an \
    unexpected variable was waiting at the site...\nit cannot bring itself to tell $npcName:11001191$ that \
    retrieving the tapes failed, and has been standing here for days, fretting. Retrieve $item:30000414$ for it."
set quest[questID=50001021] manual "Investigate the camera set up in $map:2000347$ and retrieve $item:30000414$"
set quest[questID=50001022] name "Dungeon: The Groom-to-Be's Dream"
set quest[questID=50001022] desc " \n(Entrance map: $map:2000003$)\n\n$npc:11001194$ is about to be married. Every \
    day is a battle with the flood of work, and now a crisis at the filming site keeps it from leaving work, \
    leaving it in sorrow. \nExtend a helping hand to $npcName:11001194$, who wants to keep a promise to its \
    fiancee at least today."
set quest[questID=50001022] manual "Investigate the camera set up in $map:2000346$ and retrieve $item:30000415$"
set quest[questID=50001023] name "Dungeon: A Complicated World, Let's Live Easy"
set quest[questID=50001023] desc " \n(Entrance map: $map:2000010$)\n\n$npc:11001196$ came to the filming site with \
    a face full of complaints. Short-staffed or not, sending a sick middle-aged employee out on fieldwork is \
    heartless, it says. \nFind $item:30000416$ and bring it to $npc:11001196$, who has no strength even to stand. \
    "
set quest[questID=50001023] manual "Investigate the camera set up in $map:2000348$ and retrieve $item:30000416$"
set quest[questID=50001024] name "Dungeon: The Gloomy Junior Writer"
set quest[questID=50001024] desc " \n(Entrance map: $map:2000255$)\nParty recommended (4 \
    players)\n\n$npc:11001192$ says Maple TV used to be a dream job, but now it is so hard that it fears seeing it \
    in dreams.  \nHelp $npcName:11001192$, who is sad and cannot return to the station after failing to retrieve \
    the filming tapes."
set quest[questID=50001024] manual "Investigate the camera set up in $map:2000344$ and retrieve $item:30000417$"
set quest[questID=50001025] name "Dungeon: For My Colleague"
set quest[questID=50001025] desc " \n(Entrance map: $map:2000007$)\nParty recommended (4 \
    players)\n\n$npc:11001193$ felt for $npcName:11001191$, who joined the company at the same time and struggles \
    on alone, and has been actively helping with the documentary shoot. Retrieving the tapes was supposed to be an \
    easy job to finish quickly before moving on to other work, but the plan fell apart, and it is at a loss. \
    \nRetrieve the filming tape for $npcName:11001193$, who cannot stop muttering to itself, perhaps from the \
    shock. "
set quest[questID=50001025] manual "Investigate the camera set up in $map:2000345$ and retrieve $item:30000418$"
set quest[questID=50001070] name "Dungeon: The Frozen Heart"
set quest[questID=50001070] desc "$dungeonTitle:25010001$ \n(Entrance map: $map:2010026$)\n\n$npc:11001433$ of \
    $map:02010033$ is looking for the girl $npcName:24001807$, whom it met on the day of a sandstorm. Inside \
    $map:02010026$, $npcName:11001433$ felt a nostalgic presence at a door leaking cold wind, but could not go in \
    because of a monster attack. In its place, look for traces of the girl in the place called $map:02010052$."
set quest[questID=50001070] manual "Find traces of $npc:24001807$ in $map:02010052$ inside $map:02010026$"
set quest[questID=50001070] complete "Ask $npc:11001434$ about $map:02010052$"
set quest[questID=50001080] name "Dungeon: Secret of the Snow Leopard Tribe"
set quest[questID=50001080] desc "$dungeonTitle:25010001$ \n(Entrance map: $map:2010026$)\n\n$npc:11001434$ of \
    $map:02010026$ is researching the mysterious Snow Leopard tribe, who lose their human form and memories the \
    more they awaken to their sacred power. Grant the request of $npcName:11001434$ to find $item:30000478$, a \
    valuable resource for studying the Snow Leopard tribe, in $map:02010052$ and bring it back."
set quest[questID=50001080] complete "Report to $npc:11001434$"
set quest[questID=50001090] name "Operation: Persuade the Captain"
set quest[questID=50001090] desc "$npcName:11001084$ is a meerkat scout working independently in $map:02010047$. \
    Together with captain $npcName:11001080$ and partner $npcName:11001355$, it is investigating the secret of the \
    black shadow that appears here from time to time. \nIt seems it worked hard and uncovered its identity, but \
    captain $npcName:11001080$ insists on being cautious and keeps proposing other theories. $npcName:11001084$ is \
    curious what on earth $npcName:11001080$ is thinking and asks you to find out. "
set quest[questID=50001090] complete "Pass the opinions of $npc:11001084$ and $npcName:11001355$ on to \
    $npc:11001080$"
set quest[questID=50001091] name "Dungeon: Return of the Moon Shadow"
set quest[questID=50001091] desc "$dungeonTitle:21014001$ \n(Entrance map: $map:2010047$)\nParty recommended (4 \
    players)\n\n$npc:11001080$ believes the shadow that appears on nights of the crescent moon, or on days of \
    solar and lunar eclipses, is the sorcerer $npcName:24002005$ from ancient records. The reason it hides this \
    from $npcName:11001084$ and $npcName:11001355$ is that it fears those curious two would insist on rushing to \
    the site themselves... \nIn place of the frightened $npc:11001080$, go all the way into $map:02010054$ and \
    investigate the shadow's identity."
set quest[questID=50001091] manual "Investigate $map:02010054$ to the very end"
set quest[questID=50001091] complete "Report the situation in $map:02010054$ to $npcName:11001080$"
set quest[questID=50001100] name "Dungeon: Stop the Moon Shadow"
set quest[questID=50001100] desc "$dungeonTitle:21014001$ \n(Entrance map: $map:2010047$)\nParty recommended (4 \
    players)\n\n$npc:11001080$ warns that if $npc:24002005$ starts moving again, it could pose a great danger to \
    this world. $npcName:24002005$ disturbed the world with the power of black magic and tried to steal the power \
    of dragons, so it must be attacked steadily and weakened before its power grows stronger.\nDefeat \
    $npcName:24002005$, who dreams of revival in $map:02010054$."
set quest[questID=50001100] complete "Report the situation in $map:02010054$ to $npc:11001080$"
set quest[questID=50001270] name "A Heartfelt Wish"
set quest[questID=50001270] desc "$npc:11001396$ tried to help $npc:11001392$ and failed, then went to confront \
    $npc:11001397$, who had made the elixir, and was scolded for using medicine in haste on a child. Reflecting on \
    its hasty act, $npcName:11001396$ wants to check first whether the newly made medicine is safe. Meet \
    $npc:11001443$ in $map:02010063$ as requested. "
set quest[questID=50001270] manual "Receive $item:30000520$ from $npcName:11001396$"
set quest[questID=50001270] complete "Meet $npc:11001443$ in $map:02010063$ and consult"
set quest[questID=50001271] name "The Doctor's Diagnosis"
set quest[questID=50001271] desc "$npc:11001443$ examines $item:30000520$ carefully and prescribes that it should \
    be fine to use on a child. However, $npc:11001392$ and her older brother $npcName:11001391$ are weak and will \
    likely resist the medicine, so it is best to mix it into their food. Go meet the kind-hearted $npc:11001388$, \
    said to be the best cook in $map:02010063$."
set quest[questID=50001271] complete "Meet $npc:11001388$ in $map:02010063$"
set quest[questID=50001272] name "With a Family's Heart"
set quest[questID=50001272] desc "After hearing the story, $npc:11001388$ gladly prepares food for the siblings. \
    Wanting to be a family to the siblings, sick in body and heart, $npcName:11001388$ carefully prepared \
    $item:30000521$. Deliver it to $npcName:11001391$, the older brother of $npcName:11001392$."
set quest[questID=50001272] manual "Receive $item:30000521$ from $npcName:11001388$"
set quest[questID=50001272] complete "Deliver $item:30000521$ to $npcName:11001391$"
set quest[questID=50001273] name "Trust Repaid"
set quest[questID=50001273] desc "$npc:11001392$ says she feels much better after eating $item:30000521$, and asks \
    you to thank $npcName:11001396$ for keeping the promise made to her. She looks strong and clever but is \
    soft-hearted. Pass $npcName:11001392$'s condition and greetings on to $npc:11001396$."
set quest[questID=50001273] manual "Talk to $npc:11001392$ and check on her condition"
set quest[questID=50001273] complete "Pass $npc:11001392$'s words on to $npc:11001396$"
set quest[questID=50001280] name "The Chatty Auntie"
set quest[questID=50001280] desc "$npc:11001536$ is pacing around $map:02000006$. She is the older sister of \
    $npc:11000167$, a merchant of $map:02000285$, and says she is in a tough spot because of a request she \
    received from $npc:11000270$ while visiting a merchants' gathering in $map:02000036$. Grant the request of \
    $npc:11001536$ to persuade $npc:11000270$, who is always frowning, to drop the matter."
set quest[questID=50001280] complete "Meet $npc:11000270$ in $map:02000286$"
set quest[questID=50001281] name "No More Lack of Sleep"
set quest[questID=50001281] desc "$npc:11000270$ says the reason it always frowns is lack of sleep, because its \
    timid daughter cannot sleep deeply at night and has frightening dreams. $npc:11000270$ had asked for the noisy \
    monsters of $map:02000006$ to be defeated so that the daughter could sleep soundly, and is troubled after \
    hearing the circumstances of $npc:11001536$... \nDefeat the monsters in $map:02000006$ so that she and her \
    daughter can sleep peacefully tonight."
set quest[questID=50001290] name "Rumors of a Mysterious Herb"
set quest[questID=50001290] desc "$npc:11000230$ is a young man working hard at $map:02000288$ in $map:02000036$. \
    He looks cheerful, but in truth he is searching for medicine to cure his younger sibling's incurable illness. \
    \nSome time ago, customers told $npc:11000230$ a rumor that a place called $map:02000074$, somewhere in \
    $map:02000006$, is a herbalist's secret place where a herb effective against every disease grows. He asks you \
    to look for the herb in $map:02000074$."
set quest[questID=50001290] manual "Look for the herb in $map:02000074$"
set quest[questID=50001302] name "Preparing for Adventure"
set quest[questID=50001302] desc "$npc:11000119$ says that now that you have unlocked a new power, 'Traits', you \
    can grow in a greater variety of ways. It advises you to try many things to train yourself, and says checking \
    the 'Maple Guide' will show what is worth doing at your current level. Saying that upgrading skills will let \
    you use stronger power, it gave you $item:40100022$ as a gift."
set quest[questID=50001302] complete "Talk to $npc:11000119$ in $map:52000033$ and receive a gift"
set quest[questID=50001380] name "The Royal Guard Captain's Summons"
set quest[questID=50001380] desc "$npc:11000119$ is looking for you, saying it has something to tell you. Go meet \
    it in $map:02000001$."
set quest[questID=50001380] complete "Go find $npc:11000119$ in $map:02000001$"
set quest[questID=50001381] name "Attack of the Deep Shadow"
set quest[questID=50001381] desc "$npc:11000119$ tells you that a suspicious door of darkness has risen from the \
    broken ground of $map:02000118$. Beyond that door lies a twisted space of darkness leading who knows where. \
    According to the Royal Guard members who went in to investigate and luckily came back alive, the inside was \
    filled with pitch-black darkness like another world, with monsters of tremendous strength. So the Royal Guard \
    decided to ask capable adventurers to explore the place under the name 'Shadow Expedition' and find out what \
    is inside. "
set quest[questID=50001382] name "Into the Shadows"
set quest[questID=50001382] desc "$npc:11001700$, dispatched to the broken ground of $map:02000118$, says that to \
    survive in the deep darkness, it is important to understand and make good use of the rules that apply only \
    inside and the traits exclusive to the expedition. With the real challenge right before you, it gives words of \
    encouragement and asks you to do your best exploring the place. "
set quest[questID=50001390] name "The Disciples Gather Again"
set quest[questID=50001390] desc "$npc:11001677$ says the senior brothers went into a cute treehouse down the path \
    to the right.\nGo to $map:52000041$ to meet $npcName:11001715$ and $npcName:11001707$."
set quest[questID=50001390] complete "Meet the senior brothers in $map:52000041$, east of $map:02000001$"
set quest[questID=50001391] name "The Inquiry Begins"
set quest[questID=50001391] desc "$npc:11001707$ says to first look for information about the sacred treasure in \
    $map:02000001$. \n$npc:11001716$ cannot move because of nursing duties, so search for information in her \
    place.\n$npc:11001707$ says it has seen a guide in front of the royal palace, so first go to $npc:11000160$ \
    and get some information."
set quest[questID=50001391] complete "Talk to $npc:11000160$ in $map:02000001$"
set quest[questID=50001392] name "The Flustered Guide"
set quest[questID=50001392] desc "$npc:11000160$ says that nearly all relics should be kept in the royal palace of \
    $map:02000001$, but with the Levee canceled, the royal staff are all in a frenzy and nobody can answer \
    properly. However, if it is a relic related to the beastfolk, $npc:11000003$, a beastfolk who knows a lot \
    about $map:02000001$, may know something...\nGo meet $npc:11000003$ as $npc:11000160$ directed."
set quest[questID=50001392] complete "Find $npc:11000003$ in $map:02000001$ and talk"
set quest[questID=50001400] name "Word from Tinchai"
set quest[questID=50001400] desc "$npc:11000012$ passes on the message sent by $npc:11001707$.\n$npc:11001707$ has \
    something to say, so go meet it at $map:52000041$."
set quest[questID=50001400] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001401] name "Guidance's Old Disciple"
set quest[questID=50001401] desc "It turns out $map:52000041$ was set up by the tiger beastfolk Taig Furian, who \
    once lived as a trainee at Guidance together with $npc:11001716$ and $npc:11001707$.\n$npc:11001707$ says it \
    will ask Taig Furian to help gather information about the sacred treasure. To find a tiger beastfolk said to \
    have a sturdy, agile build and a hearty personality, wouldn't it be quicker to ask another tiger beastfolk? \
    First go to $npc:11000003$ and ask about Taig Furian."
set quest[questID=50001401] complete "Meet $npc:11000003$ in $map:02000001$ and ask if it knows Taig Furian"
set quest[questID=50001402] name "Taig Furian"
set quest[questID=50001402] desc "$npc:11000003$ says that it is Taig Furian, who trained at Guidance in the past. \
    It looks nothing like the description $npc:11001707$ gave...\nSurprised to hear that $npc:11001716$ and \
    $npc:11001707$ have come to $map:02000001$, and after hearing about the incident at Billowlight Mountain, \
    $npc:11000003$ says it will help us. First, it wants to meet $npc:11001707$... \nJoin their reunion at \
    $map:52000041$."
set quest[questID=50001402] manual "Join the reunion of Taig Furian and the senior brothers at $map:52000041$ in \
    $map:02000001$"
set quest[questID=50001402] complete "Meet $npc:11001716$ at $map:52000041$"
set quest[questID=50001410] name "Find the Clues"
set quest[questID=50001410] desc "$npc:11001003$ stormed out of the room. Because of that, $npc:11001707$ could \
    not ask $npc:11000003$ to gather information about Guidance's sacred treasure together.\nGo to $npc:11000003$ \
    in place of $npc:11001707$ and ask for help gathering information."
set quest[questID=50001410] complete "Meet $npc:11000003$ in $map:02000001$ and ask around for information"
set quest[questID=50001411] name "What Nelf Left Behind"
set quest[questID=50001411] desc "$npc:11000492$, the one who could have told about Guidance's sacred treasure and \
    the whole story of the armory theft, lies collapsed.\nSadly, it seems nothing more can be heard from \
    $npc:11000492$.\nLook around $npc:11000492$ to see if anything could be a clue."
set quest[questID=50001411] manual "Find clues around $npc:11000492$ in $map:52000037$"
set quest[questID=50001411] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=50001412] name "A New Clue"
set quest[questID=50001412] desc "Go to $npc:11000119$, show the notebook found in $npc:11000492$'s bag, report \
    the results of the investigation so far, and ask for help gathering information about the sacred treasure."
set quest[questID=50001412] complete "Report the incident to $npc:11000119$ in $map:02000001$"
set quest[questID=50001420] name "The Chief Disciple's Summons"
set quest[questID=50001420] desc "$npc:11000012$ passes on the message sent by $npc:11001707$.\n$npc:11001707$ \
    says to run over quickly if you do not want to incur the wrath of $npc:11001716$... Hurry to $map:52000041$ to \
    meet the senior brothers."
set quest[questID=50001420] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001421] name "Progress Report"
set quest[questID=50001421] desc "$npc:11001716$ asks about the investigation so far. If you tell the story of \
    getting caught up in complicated incidents, $npcName:11001716$, who has an aversion to humans, will surely \
    dislike it. So you reported only briefly, and the look on its face is unconvinced. "
set quest[questID=50001421] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001430] name "Word from Tinchai"
set quest[questID=50001430] desc "$npc:11000012$ passes on the message sent by $npc:11001707$.\n$npc:11001707$ has \
    something to say, so go meet it at $map:52000041$."
set quest[questID=50001430] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001431] name "The Special Warehouse"
set quest[questID=50001431] desc "According to $npc:11001707$, who investigated with an informant, the Black Star \
    Society, which runs $map:02000216$, has a special secret warehouse where only special customers can preview \
    goods and buy them.\nA big-spending customer happens to be around these days, so the Black Star Society's \
    security is lax, and you might gather clues about something related to Guidance's sacred treasure there... \
    \nFirst go to $map:02000216$ and meet $npc:11001730$."
set quest[questID=50001431] complete "Meet and talk to $npc:11001730$ in $map:02000216$"
set quest[questID=50001432] name "Infiltration Investigation"
set quest[questID=50001432] desc "$npc:11001730$, who was watching the Black Star Society's $map:52000042$, says \
    it locked the only remaining guard in the restroom, so now is the perfect chance to investigate \
    $map:52000042$. \nThe entrance to $map:52000042$ is on the first floor of the white building with a black roof \
    next to the water tank where $npc:11001730$ is. "
set quest[questID=50001432] manual "Enter $map:52000042$ on the first floor of the white building with a black \
    roof next to the water tank where $npc:11001730$ is, and find clues"
set quest[questID=50001432] complete "Meet and talk to $npc:11001730$ in $map:02000216$"
set quest[questID=50001433] name "Seeds of Suspicion"
set quest[questID=50001433] desc "What you found was $item:30000562$. Reading it aloud for $npc:11001730$, who \
    cannot read, and checking it together, you find that among the ledger entries, a place called Beyond Link, \
    known as a humanoid engineering research institute, is suspicious. Somehow it does not feel unfamiliar \
    either...\nFirst go to $map:52000041$ and discuss it with the senior brothers."
set quest[questID=50001433] complete "Talk to $npc:11001716$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001440] name "Word from Tinchai"
set quest[questID=50001440] desc "$npc:11000012$ passes on the message sent by $npc:11001707$.\n$npc:11001707$ has \
    something to say, so go meet it at $map:52000041$."
set quest[questID=50001440] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001441] name "A Suspicious Research Institute"
set quest[questID=50001441] desc "$npc:11001707$ says that from checking the contents of $item:30000562$ and the \
    flow of goods, two things in the investigation are especially suspicious. One is Chairman Goldus, who is \
    smuggling the relics he bought somewhere else, and the other is Beyond Link, which claims to research \
    engineering technology yet keeps buying up relics.\n$npc:11001707$ will handle the investigation of \
    $npc:11000252$, so I should investigate Beyond Link.\nGo to $map:03000145$ and meet $npc:11001731$."
set quest[questID=50001441] complete "Meet $npc:11001731$ in $map:03000145$"
set quest[questID=50001442] name "What Is Hidden There"
set quest[questID=50001442] desc "$npc:11001731$, who was observing a building under Beyond Link in \
    $map:03000145$, says there is one place it alone has not been able to investigate, and tells you to \
    investigate it. Go into $map:52000039$. "
set quest[questID=50001442] complete "Infiltrate $map:52000039$ and investigate it to the end"
set quest[questID=50001443] name "The Secret File"
set quest[questID=50001443] desc "You passed through $map:52000039$ and entered $map:52000040$. Operating the \
    $npc:11001692$ there let you open a secret file. Check its contents."
set quest[questID=50001443] manual "Read the information on the $npc:11001692$ in $map:52000040$"
set quest[questID=50001443] complete "Recheck your access rights at $npc:11001732$ in $map:52000040$"
set quest[questID=50001444] name "Lost Child"
set quest[questID=50001444] desc " 'Lost Child'... \nAfter beating back the attacking black shadows, your vision \
    swam... and when you came to, you were in $map:52000017$, a place you had been to before.\nYou ask \
    $npc:11001723$ in front of you about the secret file and a few words dredged up from the far side of hazy \
    memory, but instead of a clear answer, it only repeats that you should forget everything. What exactly is \
    $npc:11001723$, and when will your blurry memories of the past fully return?"
set quest[questID=50001444] manual "Talk to $npc:11001723$ in $map:52000017$"
set quest[questID=50001444] complete "Talk to $npc:11001724$ in $map:52000040$"
set quest[questID=50001445] name "Another Crossing of Paths"
set quest[questID=50001445] desc "$npc:11001724$ and its group, met for the second time at a delicate moment, \
    demand an explanation they can accept, or information worth more than that. \nIf this drags on, there is no \
    telling what may happen next... You quickly told them as much as you could of what you know about Beyond Link, \
    up to the limit of what you can share, and cleared up the misunderstanding.\nHurry back to $map:52000041$ and \
    meet the senior brothers."
set quest[questID=50001445] manual "Talk to $npc:11001724$ in $map:52000040$, clear up the misunderstanding that \
    has built up, and leave the place"
set quest[questID=50001445] complete "Meet $npc:11001716$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001446] name "The Cautious Disciples"
set quest[questID=50001446] desc "When you tell $npc:11001707$ the contents of the secret file read at Beyond \
    Link, it falls into deep thought, saying it will sort the clues and reach a conclusion. \nYou feel uneasy at \
    not being able to tell the senior brothers everything, but it is best to hide that feeling as much as \
    possible. Go talk to $npcName:11001716$, who seems to have something to say."
set quest[questID=50001446] manual "Talk to $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001446] complete "Talk to $npc:11001716$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001450] name "Tinchai's Discovery"
set quest[questID=50001450] desc "$npc:11000012$ passes on the message sent by $npc:11001707$.\n$npc:11001707$ has \
    something to say, so go meet it at $map:52000041$."
set quest[questID=50001450] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001451] name "The Words You Wanted to Hear"
set quest[questID=50001451] desc "Before setting out to find the sacred space said to be in $map:02000039$, \
    $npcName:11001716$ says it confirmed that Beyond Link is an organization run by Kandura. $npcName:11001716$ \
    asks whether you have found out or remembered anything more in the meantime. After some thought, you avoided \
    answering.\nGet ready, go to $map:02000039$ and look for the entrance leading to the sacred space."
set quest[questID=50001451] manual "Find and enter the entrance to the sacred space in $map:02000039$"
set quest[questID=50001451] complete "Meet $npc:11001707$ in $map:52000043$"
set quest[questID=50001452] name "The Snow-Dusted Ground"
set quest[questID=50001452] desc "$map:52000043$ resembles $map:63000025$ and gives a oddly nostalgic feeling. \
    $npc:11001707$ says something can surely be found here. As she says, search $map:52000043$."
set quest[questID=50001452] manual "Search all around $map:52000043$ and find the sacred being"
set quest[questID=50001452] complete "Show what you found to Tinchai in $map:52000043$"
set quest[questID=50001453] name "Attack of the Shadows"
set quest[questID=50001453] desc "$npc:11001707$ explains that the Master once called this incense burner the \
    'Light of Munakra', and said that although it is not a sacred treasure, it serves as a guide in the search for \
    light. With the Master gone, $npc:11001707$ says that whoever inherited the Master's Animar can light it by \
    infusing the Light of Munakra with Animar power. As she says, light the Light of Munakra."
set quest[questID=50001453] manual "Awaken the sacred incense burner, the Light of Munakra, in \
    $map:52000043$|Defeat all the enemies that appeared in $map:52000043$"
set quest[questID=50001453] complete "Talk to $npc:11001716$ in $map:52000043$"
set quest[questID=50001454] name "The Chief Disciple's Wrath"
set quest[questID=50001454] desc "$npc:11001707$ says that although $npcName:11001716$ seems rather on edge, you \
    should understand, and that it would be best to take the Light of Munakra back to your quarters and talk \
    slowly. But the incense burner was already gone.\n$npcName:11001716$ flies into a rage and demands to know why \
    you hid this information from them despite its connection to Beyond Link and $npc:23000081$. $npc:11001716$ \
    harshly says it no longer wants to see you and tells you to vanish from its sight.\nStep outside for a moment \
    to calm down, then go back to $map:52000041$ and meet the senior brothers."
set quest[questID=50001454] manual "Talk to the senior brothers in $map:52000043$"
set quest[questID=50001454] complete "Meet $npc:11001707$ at $map:52000041$ in $map:02000001$"
set quest[questID=50001460] name "A Royal Guard in Peril"
set quest[questID=50001460] desc "$npc:11001838$ is terrified and asks for help. \nIt begs you to defeat the \
    fearsome creatures blocking the road...\nThe pitiful look in its eyes shows it is truly afraid. Think of it as \
    saving a life, and grant its request."
set quest[questID=50001460] manual "Defeat $npc:21000001$"
set quest[questID=50001460] complete "Talk to $npc:11001838$"
set quest[questID=50001461] name "Jodie's Gift"
set quest[questID=50001461] desc "$npc:11001838$ is deeply grateful and hands you a gift. It failed the recruit \
    training camp and could not become a full Royal Guard member, and escorting the Amherst transport ship is its \
    last chance. Cheer it on so it does well."
set quest[questID=50001461] complete "Talk to $npc:11001838$"
set quest[questID=50001462] name "How to Get to Tria"
set quest[questID=50001462] desc "$npc:11001838$ asks you to say if there is anything it can help with. When you \
    ask how to get to $map:02000001$, it says that recent storms, big and small, make it impossible by small boat, \
    so it would be best to ride the boat of the Levee congratulatory envoy at $map:63000001$. \nMeet \
    $npcTitle:11000052$ $npcName:11000052$ to learn how to get on the boat."
set quest[questID=50001462] manual "Move to $map:63000001$ and go to $map:63000003$"
set quest[questID=50001462] complete "Talk to $npc:11000052$"
set quest[questID=50001470] name "Amherst's Pride"
set quest[questID=50001470] desc "When you ask $npc:11000052$ to let you on the boat, it answers with a displeased \
    look that the Levee congratulatory envoy is charged with going to $map:02000001$ and spreading word of \
    $map:63000001$ far and wide, and that it has prepared hard as well. It says there may not be enough room on \
    the prepared boat, so talk to the boatman $npcName:11000016$... "
set quest[questID=50001470] complete "Talk to $npc:11000016$"
set quest[questID=50001471] name "The Village Chief's Wish"
set quest[questID=50001471] desc "When you ask $npc:11000016$ whether there is room on the boat, it says the \
    village chief must want something, and that granting the chief's request could make things easy. Go to the \
    chief and say you will grant the request."
set quest[questID=50001471] complete "Talk to $npc:11000052$"
set quest[questID=50001472] name "The Beautiful Egg"
set quest[questID=50001472] desc "$npc:11000052$ wants to introduce the famously rare egg of the Hardbill as a \
    specialty of $map:63000001$. But the Hardbill is extremely hard to find...\n$npc:11000052$ asks you to search \
    for the egg with the feel of a treasure hunt, and promises to put you on the boat without fail if you \
    succeed.\nGo out to the pier and meet $npc:11000021$, a local who at least knows a little about the Hardbill."
set quest[questID=50001472] complete "Ask $npc:11000021$ about the Hardbill"
set quest[questID=50001473] name "Rumors of the Hardbill"
set quest[questID=50001473] desc "$npc:11000021$ cautions that the Hardbill is very hard to find, and tells a \
    story handed down in the village. \nTo find the Hardbill, said to live in high places with clear water, follow \
    the path behind $map:63000003$ up to the waterfall on the back mountain."
set quest[questID=50001473] complete "Talk to $npc:11001839$, who is searching for traces of the Hardbill in the \
    high places of $map:63000001$"
set quest[questID=50001474] name "Searching for the Egg"
set quest[questID=50001474] desc "$npc:11001838$ says it saw a strange bird appear on the cliff, do something, and \
    fly off high. But it is afraid of heights and cannot climb any further... Climb up the cliff and see what is \
    there."
set quest[questID=50001474] manual "Look for the egg in the Hardbill's nest on top of the cliff"
set quest[questID=50001474] complete "Talk to $npc:11001839$"
set quest[questID=50001475] name "The Envoy Departs"
set quest[questID=50001475] desc "$npc:11001838$ is overjoyed and says all that is left is to bring \
    $item:30000598$ to $npc:11000052$. It is scared, so it tells you to go down first... \nReturn to \
    $map:63000003$ and meet $npc:11000052$."
set quest[questID=50001475] complete "Bring $item:30000598$ to $npc:11000052$"
set quest[questID=50001480] name "A New Start"
set quest[questID=50001480] desc "$npc:11000096$, whom you met right after getting off the boat, says \
    $npc:11001839$ ran up the stairs after leaving word to come to $map:02000068$. But it does not know where \
    $map:02000068$ is...\nTalk to $npc:11000022$, a man who looks like a resident of this town."
set quest[questID=50001480] complete "Talk to $npc:11000022$"
set quest[questID=50001481] name "The Broken Road"
set quest[questID=50001481] desc "$npc:11000022$ is glad to hear the name $npcName:11001839$. As it turns out, the \
    two have been friends since childhood. It says $npcName:11001839$ is timid but diligent in everything, and \
    must make it safely to $map:02000001$, though that will not be easy, and tells you to go to $map:02000068$ to \
    hear the details. \nMeet $npc:11000019$ in $map:02000068$."
set quest[questID=50001481] complete "Talk to $npc:11000019$ at $map:02000068$ in $map:02000062$"
set quest[questID=50001482] name "Terry's Proposal"
set quest[questID=50001482] desc "Many people came to $map:02000062$ to head to $map:02000001$ before the Levee. \
    But an earthquake broke the Royal Road, and many are stranded... Talk to the troubled $npc:11000019$ and find \
    a way."
set quest[questID=50001482] complete "Talk again to the worried $npc:11000019$"
set quest[questID=50001483] name "A Shortcut to Tria"
set quest[questID=50001483] desc "The mountain path in the northwest of $map:02000062$ leads to $map:02000001$, \
    but strange poisonous plants began growing there and sleep pollen began drifting around, so it was closed for \
    safety. Still, it is without doubt the only choice for reaching $map:02000001$ in time for the Levee...\nMeet \
    $npc:11000024$, who guards the entrance to $map:63000041$ in the northwest of $map:02000062$."
set quest[questID=50001483] complete "Talk to $npc:11000024$, who guards the entrance to $map:63000041$ in the \
    northwest of $map:02000062$"
set quest[questID=50001484] name "What Was Met on That Road"
set quest[questID=50001484] desc "$npc:11000024$, standing guard in front of $map:63000041$ in the northwest of \
    $map:02000062$, tells you that $npcName:11001838$ is already waiting inside with the group from \
    $map:63000001$. Enter $map:63000041$ and head with $npcName:11001838$ toward $map:02000001$, where the Levee \
    will be held."
set quest[questID=50001484] manual "As $npc:11000024$ told you, enter $map:63000041$ in the northwest of \
    $map:02000062$ and move to $map:02000001$ with $npc:11001838$"
set quest[questID=50001484] complete "Talk to $npc:11001853$ in $map:63000042$"
set quest[questID=50001490] name "Incident Report"
set quest[questID=50001490] desc "$npcName:11001841$ lies groaning in bed. It collapsed right after meeting \
    $npcName:11001851$ and seems to remember little of her. But it says it obtained information that many attacks \
    like this have happened near $map:02000001$... To report the incident in detail, go meet $npc:11000119$ in \
    place of the patient $npcName:11001841$."
set quest[questID=50001490] complete "Report the attack to $npc:11000119$ in $map:02000001$"
set quest[questID=50001491] name "The Royal Guard Captain's Silence"
set quest[questID=50001491] desc "Having heard the report, $npc:11000119$ takes an overbearing attitude and even \
    warns you not to meddle in this rashly. It reacts as if $npcName:11001841$'s formal enlistment is out of the \
    question too... \nGo back to $npc:11001841$ and tell it the result."
set quest[questID=50001491] complete "Meet $npc:11001841$ in $map:63000042$"
set quest[questID=50001492] name "Dubious Incidents"
set quest[questID=50001492] desc "$npcName:11001841$ says there are many dubious points, after hearing strange \
    talk among people around during the hospital stay. $npc:11001842$, a fellow trainee of $npcName:11001841$ whom \
    you met in $map:63000041$, also has something to tell...\nMeet $npc:11001842$ in $map:63000042$."
set quest[questID=50001492] complete "Meet $npc:11001842$ in $map:63000042$"
set quest[questID=50001493] name "Memories of That Day"
set quest[questID=50001493] desc "$npc:11001843$ says $npc:11000119$ has acted differently than usual since the \
    incident, such as ordering the Royal Guard members to keep quiet. Though it cannot accept this, military \
    orders must be followed, and strangely, memories of that day seem to be fading fast, says $npc:11001843$. Go \
    back to $npc:11001841$, who worries about it, and tell about the talk you had."
set quest[questID=50001493] complete "Talk to $npc:11001841$ in $map:63000042$"
set quest[questID=50001494] name "Following the Rumors"
set quest[questID=50001494] desc "Someone is trying to cover up the truth. In place of the Royal Guards, who are \
    bound by military orders and cannot investigate freely, it seems necessary to begin investigating \
    slowly.\nFirst, start by finding someone well informed about the Royal Guard and the royal family and learning \
    the real reason the Levee was canceled. Find $npc:11000169$, who $npcName:11001841$ said 'hears a lot of \
    information coming and going', and ask if it knows anything."
set quest[questID=50001494] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=50001499] name "Deepening Worries"
set quest[questID=50001499] desc "It seems $npc:11000169$ has a worry. Meet $npc:11000169$ in $map:02000001$."
set quest[questID=50001499] complete "Meet $npc:11000169$ in $map:02000001$"
set quest[questID=50001500] name "The Sacred Rock Spirit"
set quest[questID=50001500] desc "$npc:11000119$ received word that wicked dark sorcerers in $map:02000055$ are \
    trying to corrupt the sacred rock spirit, and, since the Royal Guard has no spare strength, asked you to scout \
    the place on their behalf."
set quest[questID=50001500] manual "Check the situation in $map:02000055$ and deal with it"
set quest[questID=50001501] name "A Request from the Dark Wind Commander"
set quest[questID=50001501] desc "$npc:11000601$ says that among the Guardians stationed in $map:02000146$, \
    someone from the Dark Wind faction asked for help, and tells you to meet $npc:11000266$."
set quest[questID=50001502] name "The Fugitive of Sunset Tower"
set quest[questID=50001502] desc "$npc:11000266$ says there was a report that a robot that looks like \
    $npc:23100055$, developed in the past as a lethal weapon of war, has appeared in $map:02000099$, and asks you \
    to look into the situation there."
set quest[questID=50001502] manual "Check the situation in $map:02000099$ and deal with it"
set quest[questID=50001503] name "The Black Shadow on the Watchtower"
set quest[questID=50001503] desc "$npc:11000601$ says farmers are suffering damage from an enormous herd of pigs \
    that invaded near $map:02000091$, and asks you to help $npc:11000015$ of $map:02000076$, who is running an \
    extermination operation there."
set quest[questID=50001503] manual "Hold out to the end against the pig herd's assault in $map:02000334$"
set quest[questID=50001504] name "The Royal Guard Captain's Request"
set quest[questID=50001504] desc "$npc:11000119$ is looking for you, saying it has something to tell you. Go meet \
    it in $map:02000001$."
set quest[questID=50001504] complete "Go find $npc:11000119$ in $map:02000001$"
set quest[questID=50001505] desc "$npc:11000119$ reports that $npc:23100021$, the chief of the sacred Griffin \
    race, has lost its reason and is turning the area around its mountain into a sea of fire, and is attacking \
    without discrimination even the Pigmingo tribe people trying to calm it. It says it does not want to add to \
    the worries of $npc:11000075$, who is deep in thought, and asks you to check what is happening in \
    $map:02000316$. "
set quest[questID=50001505] manual "Subdue the enraged $npc:23100021$ in $map:02000316$"
set quest[questID=50001506] name "Call of the Guard Captain"
set quest[questID=50001506] desc "$npc:11000119$ is looking for you, saying it has something to tell you. Go meet \
    it in $map:02000001$."
set quest[questID=50001506] complete "Go find $npc:11000119$ in $map:02000001$"
set quest[questID=50001507] name "Source of the Flames"
set quest[questID=50001507] desc "Fires of unknown cause are breaking out all over Victoria Island. The place \
    believed to be their source is a lava spring called $map:02000079$. $npc:11000119$ says he wants someone with \
    a good nose for clues and strong fighting skills to look into the matter. Let's go and investigate \
    $map:02000079$ as he asked."
set quest[questID=50001507] manual "Investigate $map:02000079$, the suspected source of the fires, all the way \
    through"
set quest[questID=50001508] name "A Journalist with Principles"
set quest[questID=50001508] desc "$npc:11000566$ wants to expose the human rights problem in $map:02000100$. Word \
    is that $npc:11001191$ of Maple TV is a PD with principles. Since he can't step forward in public, he asks me \
    to tell her that the protesters in front of the $map:02000100$ City Hall have a story worth covering. "
set quest[questID=50001509] name "A Favor to Survive"
set quest[questID=50001509] desc "After a conflict with the head of the Culture Bureau, $npc:11001191$ was moved \
    to the Entertainment Bureau. The actor booked for her new show can't be reached, and she is in a real bind. In \
    her trouble she asks if I'd work as an actor for pay... Let's head to the filming location, $map:02000380$."
set quest[questID=50001509] manual "Take part in the filming at $map:02000380$"
set quest[questID=50001509] complete "After filming, meet $npc:11001191$ at $map:02000164$"
set quest[questID=50100530] name "Ambush by the Vanguard"
set quest[questID=50100530] desc "In the shadow of the lifted veil,\nstood none other than the giant castle of \
    $npcName:11001698$.\nWorse, the army of $npcName:11001698$ is pouring in.\nBefore this army leaves the region \
    and invades the surroundings,\nwe must hold back its advance as much as we can\nand ask the Maple Alliance for \
    support!\nLet's fight off the vanguard of $npcName:11001698$ with all our might together with \
    $npcName:11003089$."
set quest[questID=50100530] manual "Hold off the vanguard of $npcName:11001698$ together with $npcName:11003089$"
set quest[questID=50100530] complete "Talk to $npcName:11003089$ in $map:52000099$"
set quest[questID=60001010] name "A Treasury of Knowledge"
set quest[questID=60001010] desc "Master $npc:11001246$ wanted to win the help of the royal court of \
    $map:2000001$, but $npc:11000075$ refused, and he couldn't even meet a single high official.\nWhat \
    $npc:11001231$ is searching for is the Wisdom of Baz, a legacy of our ancestors. Master $npc:11001246$ says \
    that if we follow the Wisdom of Baz, we will meet $npc:11001231$ someday. \nPerhaps we can find information \
    about the Wisdom of Baz in $map:2000031$, with its long history?\nIt would be good to go to $map:2000031$ and \
    meet $npc:11000005$."
set quest[questID=60001010] complete "Go to $map:2000031$ and get information about the Wisdom of Baz"
set quest[questID=60001011] name "Expert in Relic Restoration"
set quest[questID=60001011] desc "$npc:11000005$ says an old document contains something similar to the Wisdom of \
    Baz, but there is no telling whether it really is. \nWorse, most of the document is damaged.\n$npc:11000005$ \
    says that if the job is left to $npc:11001261$, the document can be restored. $npc:11001261$ went to \
    $map:52000019$ in $map:2000014$ to look for special materials. \nIt would be good to meet $npc:11001261$ and \
    ask for the restoration."
set quest[questID=60001011] complete "Enter $map:52000019$ in $map:2000014$ and meet $npc:11001261$"
set quest[questID=60001012] name "Watch Out, the Wriggler Pit!"
set quest[questID=60001012] desc "$npc:11001261$ is gathering special materials found only in the habitat of \
    $map:52000019$ and asks me to assist with the work. \n$npc:29000068$ live all over $map:52000019$, so let's \
    help $npc:11001261$ finish gathering the materials safely."
set quest[questID=60001012] manual "Stay by the side of $npc:11001277$ until the work is safely done"
set quest[questID=60001012] complete "Talk to $npc:11001261$"
set quest[questID=60001013] name "The Guest in Room 215"
set quest[questID=60001013] desc "According to the innkeeper $npc:11000390$, Master $npc:11001246$ is staying at \
    $map:52000018$.\nIt would be good to hurry and meet Master $npc:11001246$."
set quest[questID=60001013] manual "Find $map:52000018$"
set quest[questID=60001013] complete "Talk to Master $npc:11001246$ at $map:52000018$"
set quest[questID=60001014] name "Thanks for the Help"
set quest[questID=60001014] desc "As thanks for the help with the work, $npc:11001261$ promised to restore the \
    document. \nIt will take a long time, but at least we have our first lead on the Wisdom of Baz. It would be \
    good to return to $map:52000018$ and tell Master $npc:11001246$."
set quest[questID=60001014] complete "Talk to Master $npc:11001246$ at $map:52000018$"
set quest[questID=60001020] name "The Barota Company's Second Trade Item"
set quest[questID=60001020] desc "Master $npc:11001246$ says it would be good to seek the cooperation of the \
    Barota Company, the largest peddler organization on Victoria Island, to gather information about the Wisdom of \
    Baz and Holstadt.\nAs the master says, let's first meet $npc:11000484$ in $map:2000033$ and ask about the \
    Barota Company."
set quest[questID=60001020] complete "Talk to $npc:11000484$"
set quest[questID=60001021] name "Information Request"
set quest[questID=60001021] desc "$npc:11000484$ says that high-quality information is managed at $map:52000020$ \
    in $map:2000139$ and provided to customers who want it.\nThey say $npc:11001262$ at $map:52000020$ can provide \
    any information we want, so let's meet $npc:11001262$ first."
set quest[questID=60001021] complete "Go to $map:52000020$ in $map:2000139$ and request information"
set quest[questID=60001022] name "A Mysterious Ambush"
set quest[questID=60001022] desc "While talking with $npc:11001262$, he says he heard something suspicious near \
    the entrance.\nAccording to $npc:11001262$, people who obstruct the Barota Company's business have appeared \
    recently, and he is worried that it might be them.\nIt would be good to investigate near the entrance of \
    $map:52000020$ and ease his worries."
set quest[questID=60001022] manual "Investigate near the entrance of $map:52000020$"
set quest[questID=60001023] name "The Ones Behind the Company"
set quest[questID=60001023] desc "$npc:11001262$ says the ones behind this incident belong to the force that has \
    kept obstructing the Barota Company's business. From the way $npcName:11001262$ acted, he seems to have some \
    idea who they are... but he suddenly went silent.\nAnyway, we have been promised $npcName:11001262$'s \
    cooperation, so we should return to $map:52000018$ first and report the situation to Master $npc:11001246$."
set quest[questID=60001023] complete "Talk to Master $npc:11001246$ at $map:52000018$"
set quest[questID=60001030] name "Chasing the Traitor"
set quest[questID=60001030] desc "According to the information sent by $npc:11001262$, $map:52000021$ was found in \
    $map:2000082$.\nMaster $npc:11001246$ says we must move quickly and asks to meet at $map:52000021$. \nIt is \
    the first trace of $npc:11001231$ since we arrived on Victoria Island. \nWe should hurry to $map:52000021$."
set quest[questID=60001030] manual "Investigate $map:52000021$ in $map:2000082$"
set quest[questID=60001030] complete "Talk to Master $npc:11001279$ at $map:52000021$"
set quest[questID=60001031] name "What Happened in the Prison"
set quest[questID=60001031] desc "$npc:11001264$ says he traced $npc:11001231$'s whereabouts from $map:2000062$ in \
    southern Victoria Island, and learned that a man resembling $npc:11001231$ headed for $map:2000124$.\nBut \
    while chasing $npc:11001231$, there is something he couldn't confirm that still bothers him. To check whether \
    the rumor $npc:11001264$ mentioned is true, it would be good to go to $map:2000124$ and investigate, whether \
    by meeting $npcTitle:11000514$ or by talking to a prisoner.\nHe says $map:2000124$ can be reached by boat via \
    $npc:11000585$ at $map:2000062$."
set quest[questID=60001031] manual "Meet $npcTitle:11000514$ at $map:2000124$|Meet the prisoners of $map:2000124$ \
    and get information|Meet the prisoners of $map:2000124$ and get information|Meet the prisoners of \
    $map:2000124$ and get information"
set quest[questID=60001031] complete "Go see $npc:11000651$"
set quest[questID=60001032] name "Unknown Movements"
set quest[questID=60001032] desc "Putting together what $npc:11000649$ said, a plan seems to be underway at \
    $map:2000146$ under the lead of someone suspected to be $npc:11001231$.\nIs the person $npc:11000649$ \
    mentioned really $npc:11001231$?\nNothing is certain. \nFor now, it would be good to tell Master \
    $npc:11001246$ about this."
set quest[questID=60001032] complete "Talk to Master $npc:11001246$ at $map:52000018$"
set quest[questID=60001040] name "The Restored Document"
set quest[questID=60001040] desc "$npc:11000005$ says the restoration of the document entrusted to $npc:11001261$ \
    is complete. \nBut an unexpected problem has come up: everything written in the document is a cryptic verse \
    that is hard to make sense of.\nFirst we should go to Master $npc:11001246$ and tell him. \n"
set quest[questID=60001040] complete "Talk to Master $npc:11001246$ at $map:52000018$"
set quest[questID=60001041] name "Traces of the Traitor"
set quest[questID=60001041] desc "$npc:11001262$ sent word that traces of $npc:11001231$ were found at \
    \n$map:52000022$ in $map:3000014$. However, it seems $npc:11001231$ has already moved elsewhere. \nMaster \
    $npc:11001246$ says that, along with the information from $map:2000124$, $npc:11001231$'s movements are full \
    of questions in many ways, and he will investigate in person.\nHe asked to meet at $map:52000022$ in \
    $map:3000014$, the Land of Darkness, so we should hurry.\nThere is said to be a gate to the Land of Darkness \
    in $map:2000146$, so going through there should lead to $map:3000014$."
set quest[questID=60001041] manual "Investigate $map:52000022$ in $map:3000014$"
set quest[questID=60001041] complete "Talk to Master $npc:11001281$ at $map:52000022$"
set quest[questID=60001042] name "A New Mission"
set quest[questID=60001042] desc "$npc:11001268$ says that because of what happened at $map:52000021$, \
    $npc:11001265$ is not yet in shape to be fully active.\nAs Master $npc:11001246$ asked, it seems best to first \
    go to $map:2000361$ in $map:2000076$ and meet $npc:11001265$."
set quest[questID=60001042] manual "Go to $map:2000361$ in $map:2000076$ and meet $npc:11001265$"
set quest[questID=60001042] complete "Go to $map:2000361$ in $map:2000076$ and meet $npc:11001265$"
set quest[questID=60001050] name "Seeking the First Ruins of Baz"
set quest[questID=60001050] desc "$npc:11001265$ says the interpretation of the first verse recorded in \
    $item:30000442$ is complete.\nAccording to $npc:11001265$'s interpretation, $map:2000363$, where the knowledge \
    left by our ancestors sleeps, lies in $map:2000058$. Let's hurry and find $map:2000363$ in $map:2000058$."
set quest[questID=60001050] manual "Enter $map:2000363$ in $map:2000058$ and investigate the ruins"
set quest[questID=60001051] name "Seeking the Second Ruins of Baz"
set quest[questID=60001051] desc "$npc:11001265$ says the interpretation of the second verse recorded in \
    $item:30000442$ is complete.\nAccording to $npc:11001265$'s interpretation, $map:2000364$, where the knowledge \
    left by our ancestors sleeps, lies in $map:2000090$. Let's hurry and find $map:2000364$ in $map:2000090$."
set quest[questID=60001051] manual "Enter $map:2000364$ in $map:2000090$ and investigate the ruins"
set quest[questID=60001052] name "Seeking the Third Ruins of Baz"
set quest[questID=60001052] desc "$npc:11001265$ says the interpretation of the second verse recorded in \
    $item:30000442$ is complete.\nAccording to $npc:11001265$'s interpretation, $map:2000366$, where the knowledge \
    left by our ancestors sleeps, lies in $map:2000067$. Let's hurry and find $map:2000366$ in $map:2000067$."
set quest[questID=60001052] manual "Enter $map:2000366$ in $map:2000067$ and investigate the ruins"
set quest[questID=60001060] name "News from the Master"
set quest[questID=60001060] desc "$npc:11001265$ says a letter arrived from Master $npc:11001246$, who left for \
    the Land of Darkness chasing $npc:11001231$.\nIt is news from Master $npc:11001246$, with whom contact had \
    been lost. \nIt would be good to hurry and see what he has to say."
set quest[questID=60001070] name "A Practitioner's Duty"
set quest[questID=60001070] desc "Master $npc:11001246$ said that training to grow stronger is not just about \
    tempering one's body. It is the first guidance I have received from Master $npc:11001246$ in a long while, \
    since the training on Kalib Island. It would be good to listen closely to what he will teach."
set quest[questID=60001070] complete "Listen to Master $npc:11001246$'s first lesson"
set quest[questID=60001080] name "The Path of Learning"
set quest[questID=60001080] desc "Master $npc:11001246$ checked whether I have been neglecting the lesson he gave \
    last time. So as not to disappoint Master $npc:11001246$, it would be good to hurry and listen to Master \
    $npc:11001246$'s teachings."
set quest[questID=60001080] complete "Listen to Master $npc:11001246$'s second lesson"
set quest[questID=60001090] name "Bomar Rides Floaty"
set quest[questID=60001090] desc "$npcName:11001275$ says Floaty, the airship developed by Makan, has passed its \
    test successfully. \nHe also said that Bomar boarded Floaty, bound for Rizab Rock Island in Carcar \
    Island.\n\n$npc:11001275$ says $npcName:11001403$ is probably preparing Floaty's setup for its return to \
    Barbosa Coast, and asks me to deliver the airship operation manual so he doesn't make a mistake.\nFirst, it \
    would be good to ride Floaty to $map:02010043$ and meet $npcName:11001403$."
set quest[questID=60001090] complete "Ride Floaty across to $map:02010043$ and deliver $item:30000486$ to \
    $npcName:11001403$"
set quest[questID=60001091] name "The Woman of the Desert"
set quest[questID=60001091] desc "According to $npcName:11001403$, $npcName:11001405$ left for $map:02010084$ to \
    meet a woman named $npcName:11001404$.\nIf I meet $npcName:11001404$ at $map:02010084$, I should be able to \
    learn where $npcName:11001405$ is."
set quest[questID=60001091] complete "Meet $npcName:11001404$ at $map:02010084$ and ask where $npcName:11001405$ \
    is"
set quest[questID=60001092] name "To Rudelly City"
set quest[questID=60001092] desc "$npcName:11001404$ says $npcName:11001405$ did come looking for her at \
    $map:02010084$, but something urgent came up and he hurried off to $map:02010002$. \nAccording to \
    $npcName:11001404$, he left not long ago, so this time we should be able to find $npcName:11001405$ if we go \
    to $map:02010002$."
set quest[questID=60001100] name "A Rumored Strange Disease"
set quest[questID=60001100] desc "$npc:11001443$ says patients of a strange disease that broke out in the village \
    recently have been gathered and quarantined in $map:02010005$. \n$npcName:11001443$'s diagnosis is that it is \
    not particularly suspected to be contagious, but it is hardly an ordinary disease, as it gives an uncanny \
    feeling, like magic or a curse. \nPerhaps for that reason, some villagers who slander the illness as a curse \
    are openly doing nasty things to $map:02010005$... \nLet's go to $map:02010005$, check on the patients, and \
    see if there is anything we can do to help."
set quest[questID=60001100] complete "Look around $map:02010005$ in $map:02010063$"
set quest[questID=60001101] name "The Girls' Promise"
set quest[questID=60001101] desc "$npcName:11001392$ says she was frightened because the villagers pointed fingers \
    at everyone in $map:02010005$, calling them cursed.\nBecause of that, everyone avoided meeting the patients, \
    but $npcName:11001396$ was different.\n$npcName:11001396$, known as $npcTitle:11001396$ for her extraordinary \
    mind, promised with a pinky swear to find a way to cure the illness.\nBut days have passed without any word, \
    and she is worried that even $npcName:11001396$ may have abandoned them...\nAccording to $npcName:11001392$, \
    $npcName:11001396$'s parent $npc:11001390$ is in $map:02010063$, so let's ask him for news of \
    $npcName:11001396$."
set quest[questID=60001101] complete "Ask $npc:11001390$ for news of $npcName:11001396$"
set quest[questID=60001102] name "Looking for Nabila"
set quest[questID=60001102] desc "$npcName:11001390$ says $npcName:11001396$ left for $map:02010023$. \nHe had \
    thought $npcName:11001396$ was away from home because of her hobby of observing and studying ruins, so \
    $npcName:11001390$ seems quite surprised to hear about the promise between his daughter and \
    $npcName:11001392$.\n$npcName:11001390$ is always on edge because she is so headstrong, even if she causes no \
    trouble, and he worries about his daughter setting out to solve an illness that even the village doctor \
    $npcName:11001443$ cannot cure.\nAnd what if his only daughter is going around without eating?\nLet's deliver \
    to $npcName:11001396$ the lunch box that holds $npcName:11001390$'s heart, as he worries about his daughter \
    day and night."
set quest[questID=60001102] complete "Meet $npcName:11001396$ and deliver Yol's lunch box"
set quest[questID=60001103] name "A Lead Found in the Ruins"
set quest[questID=60001103] desc "After steadily observing the vast ruins spread across $map:02010023$, \
    $npcName:11001396$ saw that the $npc:21000674$ appearing around the ruins carry suspicious tablet \
    fragments.\nShe suspects they may be behind the strange disease that has swept the village... If we can get \
    that tablet fragment, she says, she could sort out the whole story as well as her own hypothesis.\nLet's get \
    the mysterious tablet fragment from the $npc:21000674$ that appear in $map:02010023$."
set quest[questID=60001103] manual "Get a mysterious tablet fragment from $npcName:21000674$"
set quest[questID=60001103] complete "Talk to $npcName:11001396$"
set quest[questID=60001104] name "A Lead Becomes a Miracle"
set quest[questID=60001104] desc "$npcName:11001396$ says she must ask a Moropapa tribe member named \
    $npcName:11001397$ to read the tablet.\nAccording to $npcName:11001396$, she has already told \
    $npcName:11001397$ about her promise with $npcName:11001392$, and $npcName:11001397$ said he will carry out \
    his own research on the illness $npcName:11001392$ suffers from.\nLet's find $npcName:11001397$, who is \
    somewhere near $map:02010023$, and ask him to interpret the tablet."
set quest[questID=60001104] manual "Receive the tablet fragment from $npcName:11001396$|Meet $npcName:11001397$ \
    and ask him to interpret the tablet fragment"
set quest[questID=60001104] complete "Deliver the Elixir of Akamoro to $npcName:11001396$"
set quest[questID=60001105] name "A Miraculous Day"
set quest[questID=60001105] desc "$npcName:11001396$ is delighted that $item:30000504$ will surely let her keep \
    her promise to $npcName:11001392$.\n$npcName:11001396$ says she needs time to organize her records of the \
    ruins, and asks me to quickly bring this happy news and the elixir to $npcName:11001392$. \nLet's hurry back \
    to $map:02010005$ in $map:02010063$ and deliver $item:30000504$ to $npcName:11001392$."
set quest[questID=60001105] complete "Deliver the Elixir of Akamoro to $npcName:11001392$"
set quest[questID=60001106] name "A Shattered Promise"
set quest[questID=60001106] desc "$npcName:11001391$, the older brother of $npcName:11001392$, says that, as \
    expected, all the promises people make are lies. Their parents ran away, the villagers pointed fingers saying \
    they were cursed, and now even the person his sister trusted has broken a promise, which fills him with great \
    anger.\nIt is a pity, but we have to tell $npcName:11001396$ about this."
set quest[questID=60001106] complete "Tell $npcName:11001396$ the news about $npcName:11001392$"
set quest[questID=60001110] name "Endless Practice"
set quest[questID=60001110] desc "$npc:11001320$ in $map:02000001$ advises that one cannot become a good musician \
    by neglecting practice, and to keep practicing steadily.\nIf you have no instrument or sheet music for \
    playing, you can buy them at $npc:11001320$'s shop.\n(I hope it's not just $npc:11001320$'s sales \
    pitch....)\n\nComplete the Level 25 Performance Guide [Performance Guide: Beginner] chapter quest to get the \
    instrument and sheet music needed for playing for free."
set quest[questID=60001110] manual "Play one full piece of sheet music in $map:02000001$"
set quest[questID=60001111] name "Sharing a Talent"
set quest[questID=60001111] desc "$npc:11001320$ in $map:02000001$ praises my skill at playing and says to let \
    even more people hear my beautiful performance."
set quest[questID=60001112] name "Pursuing Practical Gain"
set quest[questID=60001112] desc "$npc:11000781$ in $map:02000002$ asks me to help dig up $item:33000001$ from the \
    ore vein behind the fishing spot in $map:02000002$."
set quest[questID=60001112] manual "Try mining $item:33000001$ from the ore vein behind the fishing spot in \
    $map:02000002$"
set quest[questID=60001113] name "Fishing for Music"
set quest[questID=60001113] desc "$npc:11000781$ asks for a performance so wonderful that the fish gather to its \
    beautiful melody."
set quest[questID=60001113] manual "Play one full piece of sheet music in $map:02000002$"
set quest[questID=60001114] name "Dancing Fish"
set quest[questID=60001114] desc "$npc:11000781$ says even more fish seem to be gathering to the beautiful melody, \
    and tells me to cast a line for a while and relax.\n\nComplete the Level 20 Fishing Guide [Fishing Guide: \
    Beginner] chapter quest to get the fishing rod needed for fishing for free."
set quest[questID=60001114] manual "Fish in $map:02000002$"
set quest[questID=60001115] name "End of the Break"
set quest[questID=60001115] desc "$npc:11000781$ in $map:02000002$ says to drop by now and then, play a tune, and \
    fish for a while before leaving."
set quest[questID=60001120] name "A Mighty Shout"
set quest[questID=60001120] desc "The furious shout of $npcTitle:11000003$ spreads all over $map:02000001$.\nWhat \
    could be the matter?"
set quest[questID=60001121] name "A New Bait"
set quest[questID=60001121] desc "$npc:11000003$ in $map:02000001$ says he needs $item:33000026$ dropped by the \
    chickens raised at home.\n\nGo back to my home, adopt a chicken, and try harvesting $item:33000026$."
set quest[questID=60001121] manual "Try harvesting $item:33000026$ from the chickens raised at my home"
set quest[questID=60001122] name "Taking the Bait"
set quest[questID=60001122] desc "$npc:11000003$ tosses me the bait he used to use and taunts me, saying that if I \
    catch a fish in $map:02000001$, then he is a cat, not a tiger.\nLet's show our real fishing skill in \
    $map:02000001$.\n\nIf your fishing proficiency is too low to fish in $map:02000001$, fish in nearby \
    $map:02000002$ to raise your proficiency.\n\nRoary's secret know-how : \n'If you complete the Level 32 Fishing \
    Guide [Fishing Guide: Advanced] chapter quest, you can quickly raise your fishing proficiency to Novice Stage \
    2!'"
set quest[questID=60001122] manual "Fish in $map:02000001$"
set quest[questID=60001123] name "Grumbling Friendship"
set quest[questID=60001123] desc "Proud $npc:11000003$ softens his anger when I promise not to spread word that he \
    lost the bet, and urges me to place the $item:50200010$ he gave as a gift in my home.\nIt may not suit my home \
    at all, but setting it up once to calm him down seems better than watching the hot-tempered \
    $npcTitle:11000003$ get worked up and shout his head off again."
set quest[questID=60001123] manual "Place $item:50200010$ in my home"
set quest[questID=60001130] name "Holding a Festival"
set quest[questID=60001130] desc "$npc:11000059$ in $map:02000001$ announces in an expectant voice that a festival \
    will be held in $map:02000064$ before long."
set quest[questID=60001131] name "The Value of Sweat"
set quest[questID=60001131] desc "$npc:11000711$ in $map:02000064$ has asked me to help gather materials needed to \
    build the festival stage.\n\nIf your mining proficiency is too low, mine $item:33000001$ in $map:02000002$ to \
    raise your proficiency enough."
set quest[questID=60001131] manual "Try mining $item:33000002$ in $map:02000064$"
set quest[questID=60001132] name "Mint, If It's You... "
set quest[questID=60001132] desc "$npc:11000711$ in $map:02000064$ asks whether I could make $item:33000064$ for \
    the Bunny Bunny troupe.\n\nOpen the [Life Skills > Crafting > Blacksmith] window from the [Life] menu at the \
    lower right and try crafting.\nIf your crafting proficiency is too low, keep crafting items you can make at \
    your current proficiency to raise it enough.\n"
set quest[questID=60001132] manual "Craft $item:33000064$"
set quest[questID=60001133] name "Melody of My Heart"
set quest[questID=60001133] desc "As thanks for making $item:33000064$, $npc:11000711$ says he will lend me, for a \
    few days, the instrument the Bunny Bunny troupe members use for practice, and tells me to try it out."
set quest[questID=60001133] manual "Play one full piece of sheet music"
set quest[questID=60001140] name "I'm in a Band Now"
set quest[questID=60001140] desc "$npc:11000711$ in $map:02000064$ says music is a good bridge that connects \
    people's hearts, and tells me to gather with friends and play together."
set quest[questID=60001140] manual "Gather with at least two people and play together"
set quest[questID=60110247] name "MC K's Request"
set quest[questID=60110247] desc "$npc:11000168$, the famous MC of Maple World, says he left behind documents he \
    was supposed to get from Ruby and asks me to help him look for them.\n\nSearch the box next to $npc:11000168$ \
    in $map:2000064$ and find K's documents"
set quest[questID=60110248] name "Story of the Shadow Researcher"
set quest[questID=60110248] desc "$npc:11004067$ in $map:2000026$ has something to ask me to look into and asks me \
    to come to $map:2000026$.\nLet's find out why I am being called."
set quest[questID=60110248] manual "Meet $npc:11004067$ at $map:2000026$ in $map:2000146$"
set quest[questID=60110248] complete "Meet $npc:11004067$ at $map:2000026$ in $map:2000146$"
set quest[questID=60110249] name "Investigating the Spring of Darkness"
set quest[questID=60110249] desc "There are signs that another shadow presence is suspected in \
    $dungeonTitle:29071001$.\n$npc:11004067$ says that now, while we can reach the Spring of Darkness, I should go \
    to the spring and investigate the rumors of a shadow presence."
set quest[questID=60110249] manual "Clear the dungeon $dungeonTitle:29071001$"
set quest[questID=60110249] complete "Meet $npc:11004067$ at $map:2000026$ in $map:2000146$"
set quest[questID=70000025] name "Reach Level 70"
set quest[questID=90000010] name "Style Change!"
set quest[questID=90000010] desc "I heard about $map:02000107$ from $npc:11000373$, a part-timer handing out \
    advertising flyers in $map:02000001$.\nLet's go to $map:02000107$, meet $npc:11000462$, and find out in more \
    detail how to change my style."
set quest[questID=90000020] name "A Thoughtless Young Lady"
set quest[questID=90000020] desc "$npc:11000154$, whom I met in $map:02000107$, doesn't like the hairstyle she \
    just got at the beauty shop and wants it redone. She asks me to tell her older brother $npc:11000331$ to come \
    to $map:52000008$ with money.\nShe seems quite impatient, telling me to take a taxi all the way to \
    $map:02000001$... Shall I call a taxi as she says and go?"
set quest[questID=90000030] name "Valuables Go in the Vault"
set quest[questID=90000030] desc "As $npc:11000325$ asked, go to $npc:11000011$ and ask whether he is keeping \
    $npcName:11000325$'s ring safely! $npc:11000011$ is in $map:02000034$."
set quest[questID=90000040] name "Aftermath of a Terrible Earthquake"
set quest[questID=90000040] desc "The aftermath of the earthquake seems really terrible. Let's look through the \
    telescope next to $npc:11000112$ to see just how deep the ground has split."
set quest[questID=90000040] complete "Look at $map:02000115$ through the telescope and talk to $npc:11000112$ "
set quest[questID=90000050] name "Ingredients for the Feast"
set quest[questID=90000050] desc "The chicken meant for the Levee banquet food has fallen down the cliff. Let's go \
    down the cliff and bring back $item:20000063$. \nUsing the $skill:20000011$ skill when going up and down the \
    cliff should make it much easier to carry back."
set quest[questID=90000050] manual "Find $item:20000063$ on the raised ground behind $npc:11000159$"
set quest[questID=90000060] name "Maple Apartments Move-in Event"
set quest[questID=90000060] desc "Goldus Construction and $map:02000123$ have prepared a promotion to mark their \
    partnership. Goldus Construction, which pursues nothing but the highest quality, is building the new 'Maple \
    Apartments', and to celebrate the opening, move-in tickets are being given away for free!\nI can't miss a \
    golden chance like this! \nLet's hurry to $map:02000123$ in $map:02000001$ and meet $npc:11000600$!"
set quest[questID=90000070] name "Shining Crystal"
set quest[questID=90000070] desc "$npc:11000040$, the Knight job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000080] name "Shining Crystal"
set quest[questID=90000080] desc "$npc:11000041$, the Berserker job-change instructor, says he will teach me how \
    to grow stronger.\n"
set quest[questID=90000090] name "Shining Crystal"
set quest[questID=90000090] desc "$npc:11000042$, the Wizard job-change instructor, says he will teach me how to \
    grow stronger.\n"
set quest[questID=90000100] name "Shining Crystal"
set quest[questID=90000100] desc "$npc:11000043$, the Priest job-change instructor, says he will teach me how to \
    grow stronger.\n"
