set key[id=726145417003968] name "Tell <font color=\"#ffd200\">$npc:11000160[gender:1]$</font> in <font \
    color=\"#ffd200\">$map:02000001$</font> how you feel.\nIf your hearts connect, <font \
    color=\"#ffd200\">$item:30001182$</font> will appear as proof!\nTake $item:30001182$ to <font \
    color=\"#ffd200\">$npcName:11004101$</font> in <font color=\"#ffd200\">$map:63000062$</font>\nand you can buy \
    some fun items. Good luck!"
set key[id=726145417003969] name "Hello~ What can I do for you?"
set key[id=726145417003970] name "I love you."
set key[id=726145417003971] name "Oh my. Thank you for the confession, but I can't accept it.\nI'm just too busy \
    to have time~"
set key[id=726145417003972] name "I just meant that I like you."
set key[id=726145417003973] name "(Look sad.)"
set key[id=726145417003974] name "Hehe, all right. Let's greet each other warmly when we cross paths.\nI love \
    everyone who comes to $map:02000001$, after all."
set key[id=726145417003975] name "Something feels off, but okay."
set key[id=726145417003976] name "Oh my... $MyPCName$, are you crying? \nCrying because you didn't get an answer \
    you liked makes you a loser. "
set key[id=726145417003977] name "I'm not a loser!"
set key[id=726145417003978] name "Then accept my feelings!"
set key[id=726145417003979] name "Come on~ You have to pick your battles.\nWhen something isn't going to work, \
    it's best to give up quickly, $MyPCName$~"
set key[id=726145417003980] name "(Stop making a fool of myself and back off.)"
set key[id=726145417003981] name "(Cling on just one more time.)"
set key[id=726145417003982] name "Hehe. All right.\nI love everyone who comes to $map:02000001$."
set key[id=726145417003983] name "Got it."
set key[id=726145417003984] name "<font color=\"#ffd200\">$npc:11000160[gender:1]$</font> gives a little wink and \
    smiles.\nIt seems you've connected with her...!"
set key[id=726145417003985] name "Hello, $MyPCName$! \nHave you heard about the heartbreaking couple in \
    $map:63000062$?\nThe only way for them to meet is to wait for the <font color=\"#ffd200\">seventh moonlit \
    night</font>...\nTo make that amazing miracle happen, shall we fill this world with love?"
set key[id=726145417003986] name "A brave confession of love can sometimes create a miracle.\nWhy don't you try \
    being the star of that miracle, $MyPCName$?"
set key[id=726145417003987] name "That's a great idea!"
set key[id=726145417003988] name "No, thanks."
set key[id=726145417003989] name "Great! Right now, go to <font color=\"#ffd200\">$map:02000124$</font> and tell \
