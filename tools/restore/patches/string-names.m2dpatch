set key[id=30001192] tooltipDescription "Soft, well-made scalded dough. Add $item:30001193$ or $item:30001194$ to \
    make tasty songpyeon."
set key[id=30001192] guideDescription "\\nHow to get $item:30001192$<font color='#FFFFFF'>\\n- Get 1 per day by \
    mail when you log in\\n- Get more by staying logged in for 60, 90, and 120 minutes\\n- In $map:02000064$, take \
    the quest from $npc:11001002$ and complete it to get it</font>"
set key[id=30001193] tooltipDescription "Mugwort trimmed with the secret method of the Full Moon Mill, giving off \
    a faint, pleasant scent. Knead it into $item:30001192$ to make $item:20301892$."
set key[id=30001193] guideDescription "Double-click it to use it. Spend 1 to make 1 $item:20301892$."
set key[id=30001194] tooltipDescription "Honey gathered and aged at the Full Moon Mill. The moon rabbits love it. \
    Honestly, anyone would love a sweetness like this. Knead it into $item:30001192$ to make $item:20301893$."
set key[id=30001194] guideDescription "Double-click it to use it. Spend 1 to make 1 $item:20301893$."
set key[id=30001195] tooltipDescription "$item:30001195$ you can get by carefully searching the pretty flower \
    balloons here and there. In $map:02000064$, bring it to $npcName:11004248$ and it will be trimmed so it can be \
    used as a songpyeon ingredient."
