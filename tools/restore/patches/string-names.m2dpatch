set quest[questID=80000180] name "Ruby Prepared a Gift!"
set quest[questID=80000180] desc "If you want the $item:20300589$ that $npc:11001002$ prepared,\ntalk to \
    $npc:11001002$ once more.\n\n$item:20300589$ can be moved to another character of the adventurer, but the \
    Mystic weapon obtained from the box is bound to the character and can only be used for 30 days after it is \
    obtained."
set quest[questID=80000181] name "Venture into Random Dungeons!"
set quest[questID=80000181] desc "A brief study of dungeons with $npc:11001003$!\nClear $map:02000380$ or one of \
    the level 50 adventure dungeons! \n\nDungeon bosses to defeat:\n$npc:24001601$, $npc:24001309$, \
    $npc:24002201$, $npc:24001904$, $npc:24001807$, \n$npc:23100006$, $npc:23100033$, $npc:24002005$, \
    \n$npc:23100056$, $npc:23190066$, $npc:24002701$,\nRunaway Train Black Knoff's $npc:24001507$,\nRampaging \
    Train Black Knoff's $npc:24002109$.\n\n* Chaos Raid dungeons are excluded.\n"
set quest[questID=80000181] manual "Defeat an adventure dungeon boss"
set quest[questID=80000201] name "On Jewelcrafting and Smithing"
set quest[questID=80000201] desc "Reach level 4 in Jewelcrafting and Smithing, the crafting life skills!\nYou can \
    get the ox mount '$item:50600155$' and '$item:30000613$'."
set quest[questID=80000201] manual "Reach Jewelcrafting mastery level 4|Reach Smithing mastery level 4"
set quest[questID=80000202] name "Why Are Protection Stones Important?"
set quest[questID=80000202] desc "Collect $item:30000611$, $item:30000612$ and \
    $item:30000613$.\n\n'$item:30000611$' can be obtained through the Mysterious Protection Stone pre-attendance \
    check,\n'$item:30000612$' by completing the 'Brief Study of Dungeons' quest,\nand '$item:30000613$' by \
    reaching level 4 in Jewelcrafting and Smithing.\n\nThe reward '$item:20300590$' can be moved to another \
    character of the adventurer, but the Miracle weapon obtained from the box is bound to the character and can be \
    used permanently."
set quest[questID=80000202] manual "Get $item:30000611$|Get $item:30000612$|Get $item:30000613$"
set quest[questID=80000203] name "The Christmas Adventure Begins!"
set quest[questID=80000203] desc "Clear $map:02000380$ or one of the level 50 adventure dungeons!\n\nDungeon \
    bosses to defeat:\n$npc:24001601$, $npc:24001309$, $npc:24002201$, $npc:24001904$, $npc:24001807$, \
