    '$npc:23000012$', '$npc:23000009$', '$npc:23000029$' "
set quest[questID=80000571] manual "Get the letter '$item:30001318$'|Get the letter '$item:30001319$'|Get the \
    letter '$item:30001320$'"
set quest[questID=80000571] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000572] name "Today Is Mekong Day!!"
set quest[questID=80000572] desc "A surprise event, only until 11 AM on February 25, 2019!\n\nOh my? It's February \
    22!!!\nFor Mekong Day, a GM has shown up in Maple World~!!!\n\nFind the GM whose title is [Real], complete the \
    quest and get a fun reward."
set quest[questID=80000572] manual "Find the real GM in Maple World"
set quest[questID=80000572] complete "Talk to $npc:11001002$ in $map:02000064$"
set quest[questID=80000573] name "I'm Going to Trick You!"
set quest[questID=80000573] desc "An April Fools' surprise event, only until April 2, 2019!\n\nIt's April Fools' \
    Day!\nThat urge to fool or prank someone? Ruby knows it all~!\n\nEat the Growth Pill you received by mail and \
    give your friends a surprise.\nAdventurers who complete the quest get a gift that suits April Fools' \
    perfectly!"
set quest[questID=80000573] manual "Eat a Growth Pill in Maple World"
set quest[questID=80000573] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:02020041$"
set quest[questID=80000580] name "Hey! Don't Go Soft!"
set quest[questID=80000580] desc "A surprise event, only until April 14, 2019!\n\nOut of nowhere, Director \
    $npcName:11004313$ starts telling you that thinking you can only be happy with someone else is itself a sign \
    of weakness. Feeling lonely when you are alone comes from a very weak spirit, he says, and he urges you to \
    join the Guard Corps' special training.\nYou have no idea why you should, but he is promising you something, \
    so it is probably best to do as the Director says.\nFirst, defeat one of the many field bosses of Maple World, \
    then go find the Director's subordinate, $npc:11000158$, in $map:02000118$.\n\nField bosses of Maple \
    World:\n'$npcName:23000013$', '$npcName:23000018$', '$npcName:23000001$', '$npcName:23000019$', \
    \n'$npcName:23000054$', '$npcName:23000020$', '$npcName:23000035$', '$npcName:23000099$', \
    '$npcName:23000017$', '$npcName:23000047$', '$npcName:23000024$', '$npcName:23000034$', '$npcName:23000045$', \
    '$npcName:23000057$', '$npcName:23000026$', '$npcName:23000012$', '$npcName:23000009$', '$npcName:23000029$' "
set quest[questID=80000580] manual "Defeat field bosses"
set quest[questID=80000580] complete "Go find $npc:11000158$ in $map:02000118$"
set quest[questID=80000581] name "Even I Think I'm Cool"
set quest[questID=80000581] desc "The Director's subordinate $npc:11000158$ says the second training is to run on \
    $item:50400096$ and clear your mind of idle thoughts.\nYou have no idea what that is supposed to mean, but you \
    are being promised something, so it is probably best to do as you are told.\nUse $item:50400096$ in your own \
    home or someone else's, then go find the Director's subordinate $npc:11000157$ in $map:02000118$."
set quest[questID=80000581] manual "Use $item:50400096$ in your own home or someone else's"
set quest[questID=80000581] complete "Go find $npc:11000157$ in $map:02000118$"
set quest[questID=80000582] name "True Romance Is Solitary"
set quest[questID=80000582] desc "The Director's subordinate $npc:11000157$ says that true romance is enjoying \
    solitude and exploring yourself, and tells you to play a piece of any sheet music..\nThe third training is to \
    lose yourself in a world with only you and the music... You do not understand a word of it, but it is already \
    the third training, so it is probably best to keep going.\nPlay any sheet music, then go find the Director's \
    subordinate $npc:11000617$ in $map:02000118$."
set quest[questID=80000582] manual "Play any sheet music"
set quest[questID=80000582] complete "Go find $npc:11000617$ in $map:02000118$"
set quest[questID=80000583] name "The Perfect Black Flavor"
set quest[questID=80000583] desc "The Director's subordinate $npc:11000617$ says the final training is to eat \
    $item:20001312$, and even sang you a strange song. It was embarrassing for both singer and listener, but you \
    could certainly feel the Director's sensibility.\nOnce this training is done, you will get a gift, so it is \
    best to close your eyes and do as you are told.\nEat the $item:20001312$ you received as rewards for the \
    training so far, then receive the Director's gift.\n(If you have no $item:20001312$ left, talk to \
    $npc:11000617$ to get more.)"
set quest[questID=80000583] manual "Eat $item:20001312$"
set quest[questID=80000583] complete "Talk to $npc:11000617$ in $map:02000118$"
set quest[questID=80000584] name "Pinwheel Materials"
set quest[questID=80000584] desc "Defeat the bosses below to collect the pinwheel materials $item:30001377$, \
    $item:30001378$ and $item:30001379$!\n\n'$npc:23000013$', '$npc:23000018$', '$npc:23000001$', \
    '$npc:23000019$', \n'$npc:23000054$', '$npc:23000020$', '$npc:23000035$', '$npc:23000099$', '$npc:23000017$', \
    '$npc:23000047$', '$npc:23000024$', '$npc:23000034$', '$npc:23000045$', '$npc:23000057$', '$npc:23000026$', \
    '$npc:23000012$', '$npc:23000009$', '$npc:23000029$' "
set quest[questID=80000584] manual "Get $item:30001377$|Get $item:30001378$|Get $item:30001379$"
set quest[questID=80000584] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:02020041$"
set quest[questID=80000585] name "I'll Give a Pinwheel, You Give a Gift"
set quest[questID=80000585] desc "Complete the quests Ruby gives you to collect 20 $item:30001380$!"
set quest[questID=80000585] manual "Collect $item:30001380$"
set quest[questID=80000585] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:02020041$"
set quest[questID=80000590] name "A Teacher's Grace"
set quest[questID=80000590] desc "$npc:11001002$ hints that at one of the places you can reach through the \
    dimensional gate that appeared on the hill in $map:63000079$, you can meet a wonderful teacher. If you show \
    your gratitude to this rarely smiling teacher, you might see his handsome, ever-fresh and always thrilling \
    smile...\nGo to $map:63000081$ and show your feelings with /like to make the wonderful teacher smile.\nType \
    /like, /excited or /happy in the chat window, or press the F9 key."
set quest[questID=80000590] manual "Show your feelings with /like in $map:63000081$"
set quest[questID=80000590] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000591] name "Happy Merry Plunge"
set quest[questID=80000591] desc "$npc:11001002$ says she heard cheerful music at one of the places you can reach \
    through the dimensional gate on the hill in $map:63000079$, and it sounds like a festival is going on. She \
    then says something odd about how the highlight of a winter festival is, of course, jumping into icy \
    water...\nGo to $map:63000088$ and enjoy the festival with the winter festival highlight, the icy water \
    plunge."
set quest[questID=80000591] manual "Enjoy the Christmas festival with an icy water plunge in $map:63000088$"
set quest[questID=80000591] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000592] name "Master of Rock Climbing"
set quest[questID=80000592] desc "$npc:11001002$ says she heard that in $map:63000079$, adventurers with strong \
    arms who climb the walls can find treasure, and urges you to give it a try.\nIs the rumor $npcName:11001002$ \
    heard really true? Carrying the dream of a possible jackpot, go climb and move along the walls in \
    $map:63000079$."
set quest[questID=80000592] manual "Climb and move along the walls in $map:63000079$"
set quest[questID=80000592] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000593] name "A Cold Secret"
set quest[questID=80000593] desc "$npc:11001002$ says that at one of the places you can reach through the \
    dimensional gate on the hill in $map:63000079$, a very cold wind is blowing, and time there seems to be stuck \
    even further in the past than $map:63000079$ is now. Unlike other places, there seems to be one more hidden \
    space...\nCross $map:63000084$ and set off to find the story hidden in $map:63000085$."
set quest[questID=80000593] manual "Cross $map:63000084$, go to $map:63000085$ and linger there, leaving \
    footprints in the snow"
set quest[questID=80000593] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000594] name "I Want to See You, Ghost!"
set quest[questID=80000594] desc "$npc:11001002$ says she sensed an eerie energy at one of the places you can \
    reach through the dimensional gate on the hill in $map:63000079$. It seemed like a ghost, she says. Could her \
    hunch be right...?\nGo to $map:63000087$ and jump around noisily to find out whether there really is a ghost."
set quest[questID=80000594] manual "Jump around and look for a ghost in $map:63000087$"
set quest[questID=80000594] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000595] name "Romantic Fishing in the Starlight"
set quest[questID=80000595] desc "$npc:11001002$ says she sensed a very bright light and a very unfamiliar energy \
    at one of the places you can reach through the dimensional gate on the hill in $map:63000079$. Has a visitor \
    arrived in $map:63000086$, which is beautiful and filled with bright starlight...?\nGo to $map:63000086$, look \
    around and do some fishing."
set quest[questID=80000595] manual "Catch fish in $map:63000086$"
set quest[questID=80000595] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000596] name "Practice in Silence"
set quest[questID=80000596] desc "$npc:11001002$ says one of the places you can reach through the dimensional gate \
    on the hill in $map:63000079$ has stunning scenery and even beastfolk training there, which left quite an \
    impression, and recommends exploring every corner.\nBut you must not disturb the beastfolk's training, so she \
    says to crawl around carefully...\nQuietly crawl around $map:63000082$ and take in the view."
set quest[questID=80000596] manual "Go to $map:63000082$ and quietly crawl around to see every corner"
set quest[questID=80000596] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000597] name "Racing Through the Snow"
set quest[questID=80000597] desc "$npc:11001002$ says that at one of the places you can reach through the \
    dimensional gate on the hill in $map:63000079$, a very cold wind is blowing, and time there seems to be stuck \
    even further in the past than $map:63000079$ is now. There must be a deep story behind it, she says...\nRide a \
    mount through the snow in $map:63000084$ and explore it quickly."
set quest[questID=80000597] manual "Ride a mount and quickly explore $map:63000084$"
set quest[questID=80000597] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000598] name "Restaurant Hopping"
set quest[questID=80000598] desc "$npc:11001002$ says a wonderful aroma drifts from one of the places you can \
    reach through the dimensional gate on the hill in $map:63000079$. Famed as a superb restaurant, it is said to \
    be a feast not only for the stomach but also for the eyes, thanks to its handsome owner-chef...\nGo to \
    $map:63000083$, take a seat and soak in the atmosphere."
set quest[questID=80000598] manual "Take a seat in $map:63000083$ and soak in the atmosphere"
set quest[questID=80000598] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000599] name "Catch the Claws"
set quest[questID=80000599] desc "$npc:11001002$ tells you that the claws of the wild $npc:21000059$ roaming \
    $map:63000080$ are a delicacy that sells for a high price. But finding a plump claw is as hard as plucking a \
    star from the sky...  \nFor the sake of $npcName:11001002$, who wants to taste them just once, go to \
    $map:63000080$ and hunt $npc:21000059$. "
set quest[questID=80000599] manual "Hunt $npc:21000059$ in $map:63000080$"
set quest[questID=80000599] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000600] name "I'm Much Stronger Now"
set quest[questID=80000600] desc "Coming to $map:63000079$ reminds $npc:11001002$ of the days when she was a \
    low-level beginner adventurer, and she proudly says that even monsters that were so hard to catch back then \
    can now be taken down easily.\nFind the $npc:22300105$ that was scary back then but would be a breeze now, go \
    to $map:2000083$, subdue it and feel proud."
set quest[questID=80000600] manual " Go to $map:2000083$, subdue $npc:22300105$ and feel proud"
set quest[questID=80000600] complete "Talk to $npc:11001002$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000601] name "Weekly Mission: Rapid Growth"
set quest[questID=80000601] desc "$npc:11001003$ tells you about the special dungeons open during the event and \
    says you can grow quickly through them.\nClear $dungeonTitle:29007001$ and $dungeonTitle:29007002$ 30 times in \
    total this week and receive items for fast growth.\nNote that the daily and weekly reward counts for the two \
    dungeons are shared across your account."
set quest[questID=80000601] manual "Clear $dungeonTitle:29007001$ or $dungeonTitle:29007002$ 30 times"
set quest[questID=80000601] complete "Talk to $npc:11001003$ in $map:63000079$, $map:02000064$ or $map:02020041$"
set quest[questID=80000602] name "Rumors of the Golden Scroll"
set quest[questID=80000602] desc "Lend an ear to the thrilling rumors Ruby has to tell."
set quest[questID=80000602] manual "Talk to $npc:11001002$ in $map:02000064$ or $map:02020041$"
set quest[questID=80000602] complete "Talk to $npc:11001002$ in $map:02000064$ or $map:02020041$"
set quest[questID=80000603] name "The Fan Club Girls' Story"
set quest[questID=80000603] desc "Today's story features...\n\nA girl who has fallen head over heels for \
    $npc:11000406$ in $map:02000137$!\n\nShe likes $npc:11000406$ so much she cannot stand it...!\nShe sent in her \
    story to spread the word about how cool $npcName:11000406$ is.\n\nGo to $map:02000137$ and interview the fan \
    club vice president, $npcName:11000490$."
set quest[questID=80000603] manual "Go to $map:02000137$ and interview $npcName:11000490$"
set quest[questID=80000603] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000604] name "$npc:11000169$'s Story"
set quest[questID=80000604] desc "She stands in the most eye-catching spot in $map:02000001$, \
    $npcName:11000160$.\n\nIt seems there is a Guard Corps guard who secretly adores her... He has completely \
    fallen for her gentle, sharp way of speaking and her kindness.\n\nBut as the lowest-ranking guard, is it okay \
    for him to confess to her...? He is agonizing over it.\n\nIt would be best to meet him soon and encourage him \
    through an interview."
set quest[questID=80000604] manual "Go to $map:02000001$ and interview $npc:11000169$"
set quest[questID=80000604] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000605] name "$npcName:11003257$'s Story"
set quest[questID=80000605] desc "$npcName:11003257$ in $map:02000023$ has sent in a story.\n\nWrapped in layer \
    upon layer like a top secret, its contents are... that Cheshire the cat is a big fan of foxtail grass!\n\nBut \
    it is far too embarrassing to tell others, so Cheshire wants to be interviewed by someone \
    trustworthy...\n\nHurry to Cheshire to confirm this astonishing fact."
set quest[questID=80000605] manual "Go to $map:02000023$ and interview $npcName:11003257$"
set quest[questID=80000605] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000606] name "Dark Wind Faction Officer $npcName:11003535$'s Story"
set quest[questID=80000606] desc "$npcName:11003535$ in $map:02020041$ has sent in an unexpected story.\n\nIt is \
    that he loves cats so much that he does not know what to do.\nBut because of his image, most people around him \
    do not know...\n\nWas $npcName:11003535$ really someone who cared about his image? Hmm...\n\nWith a nagging \
    feeling, go find $npcName:11003535$.\nIs it really $npcName:11003535$ who sent this story?\n "
set quest[questID=80000606] manual "Go to $map:02020041$ and interview $npcName:11003535$"
set quest[questID=80000606] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000607] name "$npc:11000324$'s Story"
set quest[questID=80000607] desc "Coach $npcName:11000324$ teaches delicate expression of feelings.\nHe is said to \
    be passionately courting Bunny Girl $npcName:11000711$, the number one cutie in Maple World.\n\nBut... for \
    some reason $npcName:11000711$ will not accept his feelings...\n\n$npcName:11000324$ says that explaining why \
    he likes $npcName:11000711$ would take days and nights, and wants the interview done as soon as \
    possible!\n\nHonestly... you are not keen, ugh.\nGo find him and hear him out."
set quest[questID=80000607] manual "Go to $map:02000001$ and interview $npc:11000324$"
set quest[questID=80000607] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000608] name "An Adventurer's Story"
set quest[questID=80000608] desc "...!!!\nThis is... the story I sent in, isn't it?\n\nAfter failing enchant after \
    enchant in a row... I was furious and sent in an entry, and it seems to have been chosen.\n\nAn interview with \
    myself... hmm.\n\nWell, I can probably just jot something down and bring it to $npcName:11001002$.\nMaple \
    World is overflowing with people who hate $npcName:11000508$ and $npcName:11000510$!\n\nIt does not have to be \
    me, after all.\n\n"
set quest[questID=80000608] manual "Go to $map:02000001$ and interview $npc:11000324$"
set quest[questID=80000608] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000609] name "$npc:11000514$'s Story"
set quest[questID=80000609] desc "This story's main character was an unexpected figure!\nIt is none other than the \
    cold and fearsome $npc:11000514$!\n\nShe says she cannot stand the sinners of the world... that \
    is,\nprisoners!\n\nShe reportedly did not dislike prisoners this much at first.\n\nWhy did $npcName:11000514$ \
    end up like this?\nIt would be best to go and interview her."
set quest[questID=80000609] manual "Go to $map:02000124$ and interview $npc:11000514$"
set quest[questID=80000609] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000610] name "Bunny Girl $npcName:11000711$'s Story"
set quest[questID=80000610] desc "$npcName:11000711$, who says she has made an enemy for the first time in her \
    life, has sent in a story.\n \nSomeone that angelic $npcName:11000711$ dislikes...?\nWhatever the reason, it \
    is definitely that person's fault! Ahem.\n\nWho is the person Mint has come to dislike, and what did they do \
    wrong?\nGo to $npcName:11000711$ and have an interview."
set quest[questID=80000610] manual "Go to $map:02000064$ and interview $npcName:11000711$"
set quest[questID=80000610] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000611] name "$npc:11000015$'s Story"
set quest[questID=80000611] desc "Hates bugs...?\nThe main character of this story was an unexpected figure, \
    $npc:11000015$.\n\nShe is the idol of countless vigilante members thanks to her sense of justice and \
    leadership. And what she hates is... bugs, of all things?!\n\n$map:02000076$ is surrounded by lush green. \
    There must be plenty of bugs there...\n\n$npcName:11000015$, are you all right?!\n\nHurry to \
    $npcName:11000015$ and hear her story!"
set quest[questID=80000611] manual "Go to $map:02000076$ and interview $npc:11000015$"
set quest[questID=80000611] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000612] name "$npcName:11000009$'s Story"
set quest[questID=80000612] desc "This story's main character is the brave warrior of $map:02000051$, \
    $npcName:11000009$!\n\nThe story is that this brave $npcName:11000009$ hates the dark.\n\nBrave... \
    brave?\nSurely he does not hate the dark because it is scary.\n\nHow did the man who leads $map:02000051$ come \
    to hate the dark?\n\nFor now, go find him in $map:02020041$ with $npcName:11000136$.\nSomehow you feel it will \
    make a good interview."
set quest[questID=80000612] manual "Go to $map:02020041$ and interview $npcName:11000009$"
set quest[questID=80000612] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000613] name "Our Idol! A Shining Star!"
set quest[questID=80000613] desc "You came to $map:02000137$ for the interview.\nIt was filled with the voices of \
    girls cheering for $npcName:11000406$.\n\nThe story's author, $npcName:11000490$, says she has something on \
    her mind...\nIt seems $npcName:11000406$, who lost in the Queen Bean Rumble contestant vote this time, looks \
    upset.\n\nBut they do not have the courage to tell him their feelings in person... so they ask for my \
    help.\n\nOn behalf of the fan club girls, pass their feelings on to $npcName:11000406$."
set quest[questID=80000613] manual "Pass the fans' feelings on to $npcName:11000406$ in $map:02000137$"
set quest[questID=80000613] complete "Talk to $npcName:11000490$ in $map:02000137$"
set quest[questID=80000614] name "The Dazzling Girl"
set quest[questID=80000614] desc "No matter how many times you call, $npc:11000169$ does not answer.\nHearts are \
    already popping out of his eyes.\n\nWhen asked why he does not confess when he likes her that much,\nhe says \
    he simply cannot find the courage.\n\nYou cannot just sit still at a time like this!\nIt would be best to go \
    to $npcName:11000160$ on behalf of $npcName:11000169$ and sound out her feelings."
set quest[questID=80000614] manual "Ask $npc:11000160$ in $map:02000001$ what she thinks of $npcName:11000169$"
set quest[questID=80000614] complete "Talk to $npc:11000169$ in $map:02000001$"
set quest[questID=80000615] name "Shh! I'm a Cat!"
set quest[questID=80000615] desc "You went to $map:02000023$ for the interview.\n$npcName:11003257$ was taking a \
    leisurely nap.\n\nSo cute, as expected...\n\nWhen you bring up foxtail grass, Cheshire instantly \
    sulks.\nCheshire says he badly misses the foxtail grass he hid away from others' eyes...\n\nHow can you just \
    stand by and watch that?\nHurry and bring Cheshire some foxtail grass!"
set quest[questID=80000615] manual "Bring $item:30001438$ from Cheshire's secret spot in $map:02000023$"
set quest[questID=80000615] complete "Talk to $npc:11003257$ in $map:02000023$"
set quest[questID=80000616] name "The Most Perfect Animal"
set quest[questID=80000616] desc "When you talk to $npcName:11003535$ in $map:02020041$ and bring up the story, he \
    reacts as if it is rather amusing...\n\nJust as $npcName:11003535$ grins and is about to tell the \
    truth!\n$npcName:11003533$ suddenly appears and says they should talk for a moment.\n\nYou have an interview \
    to do... but should you hear this out briefly?\nWhat could it be about?\n"
set quest[questID=80000616] manual "Talk to $npcName:11003535$ in $map:02020041$"
set quest[questID=80000616] complete "Talk to $npcName:11003535$ in $map:02020041$"
set quest[questID=80000617] name "Fresh! Cool! Sweet!"
set quest[questID=80000617] desc "$npcName:11000324$ is scribbling something.\n\nWhen asked what he was doing, he \
    denies it, saying he was doing nothing...\nWhat could he really have been doing?\n\nWhen you say you came for \
    the interview, only then does he ask you to hear him out. This feels a bit worrying?!\n\nFor now, let's hear \
    what $npcName:11000324$ has to say."
set quest[questID=80000617] manual "Talk to $npc:11000324$ in $map:02000001$"
set quest[questID=80000617] complete "Talk to $npc:11000324$ in $map:02000001$"
set quest[questID=80000618] name "Those Who Sin Must Be Punished"
set quest[questID=80000618] desc "You went to $map:02000124$, tense all over.\n\nWhen you ask the frosty \
    $npc:11000514$ why she hates prisoners,\nshe tells you about something that happened in the \
    past...\n\nSomehow... it is weak!\n\nWhen you ask if there is another reason, she says she can never say it \
    herself and tells you to see for yourself.\n\nCheck the manhole cover below to find out the real reason."
set quest[questID=80000618] manual "Open the manhole cover in $map:02000124$ and confirm the truth"
set quest[questID=80000618] complete "Talk to $npc:11000514$ in $map:02000124$"
set quest[questID=80000619] name "I Really Hate Cold Jokes!"
set quest[questID=80000619] desc "When you speak to her for the interview, $npcName:11000711$ is delighted that \
    someone has finally come to hear her troubles.\n\nWhat on earth happened?\n\nWhen asked, she says \
    $npcName:11000324$ sends her strange letters every single day... and that it is very distressing.\n\nIt would \
    be best to hear from $npcName:11000711$ what the letters say."
set quest[questID=80000619] manual "Talk to Bunny Girl $npcName:11000711$ in $map:02000064$"
set quest[questID=80000619] complete "Talk to Bunny Girl $npcName:11000711$ in $map:02000064$"
set quest[questID=80000620] name "Crawling and Flying Things"
set quest[questID=80000620] desc "$npcName:11000015$ is surprised that you are the interviewer.\n\nWhen asked how \
    she came to hate bugs, she says it is because of a childhood trauma. And $map:02000076$ has so many bugs that \
    she has had quite a hard time!\n\n$npcName:11000015$ says she uses a powerful bug repellent. You are quite \
    curious what this repellent really is...\n\nShe says she just ran out, and asks whether you could get some \
    from $npcName:11000961$ for her.\n\nHurry and go to $npcName:11000961$.\n\n"
set quest[questID=80000620] manual "Get $item:30001439$ from $npc:11000961$ in $map:02000076$"
set quest[questID=80000620] complete "Talk to $npc:11000015$ in $map:02000076$"
set quest[questID=80000621] name "Tonight I'm Afraid of the Dark"
set quest[questID=80000621] desc "$npcName:11000009$ is restless and does not listen even when spoken to.\nJust as \
    you wonder what is going on, $npcName:11000136$ next to him tells you something unexpected.\n\nShe says she \
    wrote the story on behalf of $npcName:11000009$.\n\nWhen asked why, she says Rolling Thunder, who hates the \
    dark, always carries a certain item...\nand $npcName:11000042$ saw it, took it for an experiment, and has not \
    returned it for days.\n\n$npcName:11000136$ says they will not even listen to her, and asks you to persuade \
    $npcName:11000042$.\n\nIt would be best to go to $npcName:11000042$ at once."
set quest[questID=80000621] manual "Go to $npcName:11000042$ in $map:02020041$ and get $item:30001440$ back"
set quest[questID=80000621] complete "Talk to $npcName:11000009$ in $map:02020041$"
set quest[questID=80000622] name "TV Writer Iluna's Show Planning"
set quest[questID=80000622] desc "$npcName:11001002$'s friend, the TV writer $npcName:11004726$, is said to be \
    planning a new show!\n\nFor the planning, she is collecting stories from people all over Maple World... \
    \n$npcName:11001002$ says she has a favor to ask about exactly that.\n\nGo to $map:02000064$ and talk to \
    $npcName:11001002$."
set quest[questID=80000622] manual "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000622] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000623] name "A Souvenir for the Challenge"
set quest[questID=80000623] desc "A new round has appeared in the Queen Bean Rumble!\nSee for yourself who the new \
    opponent, chosen by user vote, is. "
set quest[questID=80000623] manual "Take on the Queen Bean Rumble"
set quest[questID=80000623] complete "Go to $map:02000064$ and talk to $npc:11001002$"
set quest[questID=80000630] name "The Witch's Gift"
set quest[questID=80000630] desc "$npc:50400341$ has been offered to you by a witch you have never met before, \
    quite unexpectedly!!\nIs it really okay to raise this...?"
set quest[questID=80000630] manual "Hear about $npc:50400341$ from $npc:11004717$ in $map:02000064$"
set quest[questID=80000630] complete "Hear about $npc:50400341$ from $npc:11004717$ in $map:02000064$"
set quest[questID=80000631] name "Oh My! You Startled Me!"
set quest[questID=80000631] desc "Let's place $item:50400341$ in your home!\nYou can find $item:50400341$ by \
    pressing the 'Startled Cat' tab on the left of the 'Start Building' menu.\nIf you have already placed one, \
    remove it and place it again."
set quest[questID=80000631] manual "Place $item:50400341$ in your home"
set quest[questID=80000631] complete "Place $item:50400341$ in your home"
