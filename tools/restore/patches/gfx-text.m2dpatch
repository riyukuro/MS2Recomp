patch gfx-text
made-for KMS2 KR Live client Data/Resource/Gfx.m2d and GfxDebug.m2d (byte-identical copies; both are patched)
# Own English for Korean baked into UI gfx files, limited to what a player sees:
# - text <id>: DefineEditText initial texts that are shown as authored (the field has no instance name, or no
#   AS3 code writes its text); fields whose text the AS3 sets before display keep their sample text.
# - string <hash>: constant-pool strings that the AS3 assigns to a text field or a list label; a hash is the
#   first 16 hex digits of the SHA-256 of the original UTF-8 string, so no original text is held here.
# Not changed: UI layer names and shop tab samples (used as keys), the input restrict pattern, and sample data
# behind CommonPath.flash (runs only in the Flash authoring tool).

string 2637feaf6f3a29de "Face Accessory"
