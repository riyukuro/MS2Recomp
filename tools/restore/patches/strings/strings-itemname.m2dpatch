patch strings-itemname
made-for KMS2 KR Live client Data/Xml.m2d
# string/kr/itemname.xml: rows the pack left in Korean take the English text of the same row from the pack's own
# English table(s); rows without an English row stay as they are.
file Xml/string/kr/itemname.xml kms:Xml/string/kr/itemname.xml 8c56a83382e644a3
need kms:Xml/string/en/itemname.xml 78d816d57960c4f4
# Rows whose English row in the pack belongs to another item with the same id (the global client reused it):
# a check of the names, icons and texts found another item. They are not copied; string-names gives the ones
# players see our own English.
keep key id 11850044,11850045,20301868,50201049,50201050,50201051,50201052,50201053,59200183
copy-text key id class,name kms:Xml/string/en/itemname.xml
