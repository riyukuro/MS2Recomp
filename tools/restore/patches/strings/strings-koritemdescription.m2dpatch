patch strings-koritemdescription
made-for KMS2 KR Live client Data/Xml.m2d
# string/kr/koritemdescription.xml: rows the pack left in Korean take the English text of the same row from the pack's
# own English table(s); rows without an English row stay as they are.
file Xml/string/kr/koritemdescription.xml kms:Xml/string/kr/koritemdescription.xml 669a7f4ea48c36b2
need kms:Xml/string/en/koritemdescription.xml bcd9d9384bad0cc4
copy-text key id functionDescription,guideDescription,mainDescription,tooltipDescription \
    kms:Xml/string/en/koritemdescription.xml
