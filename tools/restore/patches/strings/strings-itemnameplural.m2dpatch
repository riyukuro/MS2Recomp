patch strings-itemnameplural
made-for KMS2 KR Live client Data/Xml.m2d
# string/kr/itemnameplural.xml: rows the pack left in Korean take the English text of the same row from the pack's own
# English table(s); rows without an English row stay as they are.
file Xml/string/kr/itemnameplural.xml kms:Xml/string/kr/itemnameplural.xml a4eb65ca9faa967f
need kms:Xml/string/en/itemnameplural.xml a06c05e6e35b9370
# Rows whose English row in the pack belongs to another item with the same id (the global client reused it):
# a check of the names, icons and texts found another item. They are not copied; string-names gives the ones
# players see our own English.
keep key id 11050047,11150043,11150054,11150059,11300379,11300380,11300393,11300394,11301148,11301415,11301482,\
    11400135,11400136,11500141,11500142,11600235,11600236,11600237,11600238,11700221,11700222,11700237,11700238,\
    11850044,11850045,13100156,13100201,13100301,13100302,13100323,13200152,13200196,13200296,13200300,13200318,\
    13300151,13300195,13300295,13300299,13300317,13400149,13400193,13400294,13400298,13400316,14000128,14000160,\
    14000257,14000261,14000279,14100137,14100169,14100266,14100270,14100288,15000156,15000200,15000300,15000304,\
    15000322,15100148,15100192,15100292,15100296,15100314,15200155,15200199,15200299,15200303,15200321,15300149,\
    15300195,15300295,15300299,15300317,15400171,15400216,15400257,15400286,15500208,15500526,15600197,15600527,\
    20000964,20000969,20000971,20000985,20210017,20210035,20300291,20300302,20300303,20300320,20300321,20300647,\
    20301281,20301388,20301431,20301632,20301695,20301696,20301787,20301788,20301789,20301790,20301868,20301963,\
    20302930,30000597,30000857,30000858,30001099,30001102,30001103,30001215,34000072,40400055,40400061,40400078,\
    40400092,40400093,40400132,50201049,50201050,50201051,50201052,50201053,50600196,50600211,50600212,50600234,\
    50600249,50600271,50600274,50600275,50600276,50600277,50600333,50600334,50610010,59200183,59200286,70200050,\
    70200093,70300078,70300082,70600024,70600025,70600026
copy-text key id class,name kms:Xml/string/en/itemnameplural.xml
# The kept rows, and the KR-only feature groups' rows still in Korean, get the English plural of the item's
# English name in the name table.
plural-of key id Xml/string/kr/itemname.xml feature=Wedding feature=ItemKR
