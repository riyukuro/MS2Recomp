patch triggers
made-for KMS2 KR Live client Data/Xml.m2d
# Map triggers: the cutscene, speech balloon, objective and caption lines the pack has as inline Korean text
# (no string id, and the GMS pack has the same Korean lines). Our own English; speaker ids, timing, align and
# links stay. Rows are addressed by position ([#=N]), which the file pin keeps valid.
file Xml/trigger/02000498_bf/main.xml kms:Xml/trigger/02000498_bf/main.xml eee9dbff94d83601
set state[#=3]/onEnter[#=1]/action[#=3] arg2 "You have entered a new dimensional rift of Darkscream."
set state[#=6]/onEnter[#=1]/action[#=3] arg2 "Move closer."
file Xml/trigger/02000498_bf/stage_01.xml kms:Xml/trigger/02000498_bf/stage_01.xml 1b5b26ad5ac0276f
set state[#=3]/onEnter[#=1]/action[#=1] arg2 "You will soon be guided to a new dimension."
file Xml/trigger/02020015_bf/02020015_main.xml kms:Xml/trigger/02020015_bf/02020015_main.xml cea1d303b67ca70e
set state[#=5]/onEnter[#=1]/action[#=1] arg2 "The platforms will vanish in 20 seconds."
file Xml/trigger/52010068_qd/main.xml kms:Xml/trigger/52010068_qd/main.xml 8107e4d2ca340ce1
set state[#=12]/onEnter[#=1]/action[#=2] arg2 "It cost us dearly, but we won our victory against \
    $npc:11001698$.\\nWe made them pay for attacking Maple World."
set state[#=14]/onEnter[#=1]/action[#=1] arg2 "$npc:11001698$ did escape unharmed, \\nbut she did not flee of her \
    own will."
set state[#=16]/onEnter[#=1]/action[#=1] arg2 "If anything, $npc:11001698$ lost her own fortress in this battle."
set state[#=44]/onEnter[#=1]/action[#=1] arg2 "$npc:11001698$ took to the sky on her dragon.\\nAnd that was the \
    end of Madrakan Fortress."
set state[#=46]/onEnter[#=1]/action[#=1] arg2 "$npc:11001698$ will surely return.\\nAnd she may once again take \
    from us what we hold dear."
set state[#=48]/onEnter[#=1]/action[#=1] arg2 "Even so, if I can, I want to find a way that doesn't mean fighting \
    $npc:11001698$.\\nA spiral of revenge would only end up destroying everything on both sides."
set state[#=50]/onEnter[#=1]/action[#=1] arg2 "And I firmly believe the Terunkalibs are alive, somehow.\\nJust as \
    they saved me, I want to believe they found a way to save themselves."
set state[#=52]/onEnter[#=1]/action[#=1] arg2 "So I swore to do my very best searching the Black Shard's blast \
    site, the 'Eye of Lapenta',\\nand investigating the Lapenshards."
file Xml/trigger/52020001_qd/main.xml kms:Xml/trigger/52020001_qd/main.xml a06d43353a143874
set state[#=9]/onEnter[#=1]/action[#=1] arg2 "There is little time.\\nDefeat the bombing Ego Weapons and \
    infiltrate Kritias."
set state[#=12]/onExit[#=1]/action[#=1] arg3 "I have to hurry!"
set state[#=19]/onExit[#=1]/action[#=2] arg3 "Should I try that switch?"
set state[#=36]/onEnter[#=1]/action[#=6] arg2 "Mission failed. Please try again."
file Xml/trigger/52020001_qd/main_2.xml kms:Xml/trigger/52020001_qd/main_2.xml 4109d04fb44f6fa8
set state[#=2]/onExit[#=1]/action[#=1] arg2 "The bombardment is getting heavier. Hurry and move!"
set state[#=17]/onEnter[#=1]/action[#=6] arg2 "Mission failed. Please try again."
file Xml/trigger/52020001_qd/main_3.xml kms:Xml/trigger/52020001_qd/main_3.xml 4b94881e3c6c1b9a
set state[#=6]/onEnter[#=1]/action[#=5] arg2 "Arkeon has grown huge and is deflecting every attack."
set state[#=16]/onEnter[#=1]/action[#=6] arg2 "Mission failed. Please try again."
file Xml/trigger/52020001_qd/main_3_2.xml kms:Xml/trigger/52020001_qd/main_3_2.xml ca2c8e430ac4bf4b
set state[#=2]/onEnter[#=1]/action[#=1] arg2 "You can't fight it any longer.\\nUse the turret to move elsewhere."
set state[#=3]/onEnter[#=1]/action[#=1] arg2 "You can't fight it any longer.\\nUse the turret to move elsewhere."
file Xml/trigger/52020001_qd/main_4.xml kms:Xml/trigger/52020001_qd/main_4.xml 3679c5233b9771a0
set state[#=10]/onEnter[#=1]/action[#=1] arg3 "All right! I'll ride this thing and charge right in!!"
set state[#=14]/onEnter[#=1]/action[#=1] arg2 "Not enough power to break into Kritias."
set state[#=15]/onEnter[#=1]/action[#=1] arg2 "Defeat enemies to charge energy.\\nCharge to 100% within the time \
    limit and break into Kritias!"
set state[#=18]/onEnter[#=1]/action[#=7] arg2 "Mission failed. Please try again."
file Xml/trigger/52020001_qd/main_5.xml kms:Xml/trigger/52020001_qd/main_5.xml 089e9737d2850c99
set state[#=2]/onEnter[#=1]/action[#=1][name=ShadowExpedition] title "Output Energy"
set state[#=4]/onEnter[#=1]/action[#=1] arg2 "Energy is 50% charged."
set state[#=6]/onEnter[#=1]/action[#=1] arg2 "Energy is 100% charged."
set state[#=7]/onEnter[#=1]/action[#=1] arg2 "Charging at full power shortly."
set state[#=12]/onEnter[#=1]/action[#=1] arg3 "All set! Charge into Kritias!"
file Xml/trigger/52020002_qd/main.xml kms:Xml/trigger/52020002_qd/main.xml 6e12dc7a0870d1a7
set state[#=8]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Hello there! Here I am.\\nThis cutscene is \
    still in production, so please wait."
file Xml/trigger/52020003_qd/main.xml kms:Xml/trigger/52020003_qd/main.xml 491414f584748c10
set state[#=6]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "It's bigger than I thought..."
set state[#=8]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Wait... is someone there?"
set state[#=9]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Hahaha!"
set state[#=10]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Not completely stupid, then.\\nYou noticed I \
    was here."
set state[#=11]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "The Black Star...? What are you doing here?"
set state[#=12]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "None of your business. We're both busy, so \
    let's not drag this out~\\nIf you found anything, hand it over nice and quiet."
set state[#=13]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "I've got nothing like that... but I've got \
    plenty I want to hear.\\nTell me what you were up to here."
set state[#=14]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "No time for that. We're very busy.\\nBoys! \
    Take 'em down!"
set state[#=15]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Prepare yourself!"
set state[#=16]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "I'll teach you a lesson!"
set state[#=26]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "I thought I heard a big racket..."
set state[#=27]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Did something happen?"
file Xml/trigger/52020004_qd/main.xml kms:Xml/trigger/52020004_qd/main.xml c49073e8e168fa52
set state[#=15]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "This place... It's been quite a while since I \
    was last here."
set state[#=16]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "I see. ...I thought I'd never have reason to \
    return."
set state[#=17]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "What are your orders for me?"
set state[#=18]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Wait for me."
set state[#=19]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Huh..."
set state[#=20]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "This cutscene will be improved, so please \
    wait.\\nMore lines will be added here."
set state[#=26]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "What on earth... is going on here?"
set state[#=27]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "...You really have to ask?"
set state[#=28]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "It's chaos, thanks to someone's \
    carelessness."
set state[#=29]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Get over here, now! Hurry!"
set state[#=42]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Hmm..."
set state[#=43]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Either there are no clues, or there are and \
    we just can't see them.\\nSo frustrating."
set state[#=44]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Then why don't we frustrated folks have a \
    little talk?"
set state[#=45]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "If we share what we know, we'll all reach our \
    goal faster."
set state[#=46]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "The royal family of Kritias.\\nTheir trail is \
    what you're after, isn't it?"
set state[#=47]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Everyone who came in here is probably looking \
    for them.\\nThe Black Star Society too."
set state[#=48]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Who will reach the goal first, I wonder... \
    Aren't you curious?\\nOf course, I think I already know the answer."
set state[#=49]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "(The Black Star Society... This is getting \
    more complicated than I thought.)"
set state[#=50]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Are you sure the answer you have in mind is \
    the right one, old man?"
set state[#=51]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "I bet it's wrong."
set state[#=52]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "We worked hard to get this far too. We can't \
    leave empty-handed."
set state[#=53]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Our entrance was a bit plain, wasn't \
    it?\\nWe'll get a cooler entrance later, so keep that in mind."
set state[#=54]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "So many uninvited guests... It's getting \
    noisy.\\nNoise just doesn't agree with me."
set state[#=55]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "$npc:11003660$, clean this up."
set state[#=56]/onEnter[#=1]/action[#=2][name=ShowCaption] desc "Black Star Society special forces leader, \
    $npc:11003659$'s right hand"
set state[#=57]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Yes, boss."
set state[#=58]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Let's run."
set state[#=59]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "What are you saying all of a sudden..."
set state[#=59]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Now that $npcName:11003660$ has stepped in, \
    this place will become an inferno.\\nNo time. Hurry."
set state[#=60]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "That way. Hurry...!"
set state[#=61]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "All talk, the lot of you. I'll wipe you out \
    clean."
set state[#=63]/onEnter[#=1]/action[#=1] arg2 "Just as Jaiden and I were escaping,\\nwe heard a tremendous noise."
set state[#=64]/onEnter[#=1]/action[#=1] arg2 "The basement, surely built sturdy for royal \
    emergencies,\\ncollapsed in an instant with a deafening roar."
set state[#=65]/onEnter[#=1]/action[#=1] arg2 "I had to run.\\nThinking of nothing but staying alive."
file Xml/trigger/52020005_qd/main.xml kms:Xml/trigger/52020005_qd/main.xml 9cbf888a544c9de3
set state[#=13]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Hey. Open your eyes.\\nAre you awake?"
set state[#=14]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Hmm, the wounds don't look serious."
set state[#=15]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Then, to wake you up quickly...\\n(That \
    ringing sound... is that a sword being drawn...?)"
set state[#=16]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Stab them with that sword and they'll wake up \
    in the next world."
set state[#=17]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "If that is this one's fate, it must be \
    accepted...\\nSuch is the beautiful order of the world."
set state[#=18]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "(If I don't get up fast, my life may be in \
    danger. Get up!)"
set state[#=19]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "...You're awake."
set state[#=24]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "This cutscene is under construction."
set state[#=25]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Indeed. Under construction."
set state[#=26]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Please wait."
set state[#=27]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Indeed. Please wait a little."
set state[#=28]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "It will be finished by January."
file Xml/trigger/52020006_qd/main.xml kms:Xml/trigger/52020006_qd/main.xml e3b3ea834356e801
set state[#=11]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Scene to be expanded"
set state[#=12]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Please wait a little longer"
set state[#=13]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Sorry"
set state[#=20]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Then let's bet on who sweeps those things \
    away first."
set state[#=21]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "It's a placeholder scene, so the monsters \
    will be weak."
set state[#=22]/onEnter[#=1]/action[#=4][name=AddCinematicTalk] msg "Here I go!"
set state[#=30]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Looks like I win. Well, see you!"
set state[#=31]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Now it's time to go beyond that..."
set state[#=32]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "You're safe, $MyPCName$."
file Xml/trigger/52020008_qd/52020008_main.xml kms:Xml/trigger/52020008_qd/52020008_main.xml dcb470eaa012cc13
set state[#=3]/onEnter[#=1]/action[#=1] arg3 "I'll take good care of the princess, so why not surrender now?"
set state[#=4]/onEnter[#=1]/action[#=2] arg3 "I have no wish to be served by someone so unlovely!!"
set state[#=5]/onEnter[#=1]/action[#=2] arg3 "That one's a member of the Black Star Society! Be careful!"
set state[#=6]/onEnter[#=1]/action[#=2] arg3 "Doesn't the Maple Alliance have dark motives too? \\nI won't let \
    anyone use the power of Kritias!"
set state[#=7]/onEnter[#=1]/action[#=2] arg3 "She's got a point, doesn't she?\\nThere's no true good or evil in \
    this world~"
set state[#=8]/onEnter[#=1]/action[#=2] arg3 "So what will you do now?"
set state[#=9]/onEnter[#=1]/action[#=1] arg3 "Lady Eone, get ready!"
set state[#=12]/onEnter[#=1]/action[#=2] arg3 "Oh my, is today the regular meetup?"
set state[#=13]/onEnter[#=1]/action[#=7] arg3 "Ugh... what a pain."
set state[#=14]/onEnter[#=1]/action[#=3] arg3 "Where'd the princess go now?! This is driving me crazy!!"
set state[#=15]/onEnter[#=1]/action[#=6] arg3 "The princess is ours. Boys, take care of them!"
set state[#=16]/onEnter[#=1]/action[#=4] arg3 "Let's move, quick!"
set state[#=17]/onEnter[#=1]/action[#=2] arg3 "Did it shoot up into the sky?? I need to see what's on top of the \
    tower!!"
set state[#=19]/onEnter[#=1]/action[#=1] arg2 "Track down Seriha."
file Xml/trigger/52020009_qd/event.xml kms:Xml/trigger/52020009_qd/event.xml 46710fafe1ac3556
set state[#=4]/onEnter[#=1]/action[#=4][name=AddBalloonTalk] msg "My name... I can't remember my name..."
set state[#=5]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Someone, please find my name!"
set state[#=6]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "No! That's not the book with my name in it!"
set state[#=7]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "That book is about the king's secret weapon!"
set state[#=8]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "The giant weapon of $map:02020010$?"
set state[#=9]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "My name wouldn't be written in a book like \
    that!"
set state[#=10]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "That book! It's my diary!"
set state[#=11]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Yes... I remember now. My name..."
set state[#=13]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "My name is $npcName:11003602$."
set state[#=14]/onEnter[#=1]/action[#=4][name=AddBalloonTalk] msg "The Observer of Kritias."
file Xml/trigger/52020010_qd/clock_a.xml kms:Xml/trigger/52020010_qd/clock_a.xml 308a5904183459a0
set state[#=4]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Mom! Can I eat this bread?"
set state[#=5]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "No! Dinner's almost ready."
set state[#=6]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Aww... Dad, can't I have this?"
set state[#=7]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Heh... you rascal. Just one, then?"
set state[#=7]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Honey!"
set state[#=8]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "More importantly, how's that work of yours \
    going?"
set state[#=8]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Yay! Hooray!"
set state[#=9]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Of course! There's nothing the kingdom's finest \
    engineer can't do!"
set state[#=10]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "But you know, the closer it gets to done, the \
    worse I feel."
set state[#=11]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "What on earth is the king thinking..."
file Xml/trigger/52020010_qd/clock_b.xml kms:Xml/trigger/52020010_qd/clock_b.xml 56ebd2a304bef15d
set state[#=4]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Wow! Boom boom!"
set state[#=5]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Honey... What are we going to do?"
set state[#=6]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "I never thought it would come to this..."
set state[#=6]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "We can't get away, can we?"
set state[#=7]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Boom! Boom!"
set state[#=7]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "What was it all for..."
set state[#=8]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Honey!"
set state[#=9]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "My wife, my daughter... I'm sorry, all of \
    you..."
set state[#=10]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Honey..."
file Xml/trigger/52020010_qd/clock_c.xml kms:Xml/trigger/52020010_qd/clock_c.xml c4d33de68068a971
set state[#=4]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Mommy, I'm scared..."
set state[#=5]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Don't cry... It'll be all right soon..."
set state[#=6]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Honey? Where did you go?!"
set state[#=7]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Honey!!!"
set state[#=7]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Mommy... Daddy... I'm scared..."
file Xml/trigger/52020010_qd/clock_d.xml kms:Xml/trigger/52020010_qd/clock_d.xml 59d6b7b350f407e8
set state[#=4]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Where on earth is it?"
set state[#=5]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "I'm sure there was a device somewhere in the \
    bookshelves..."
set state[#=6]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Why can't I remember at a time like this!!!"
set state[#=7]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Was it here?"
set state[#=8]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "No... Come to think of it, it's no use..."
set state[#=9]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "It's a fate I can't escape anyway..."
set state[#=13]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Where on earth is it?"
set state[#=14]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "I'm sure there was a device somewhere in the \
    bookshelves..."
set state[#=15]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Why can't I remember at a time like this!!!"
set state[#=16]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Was it here?"
set state[#=17]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "No... Come to think of it, it's no use..."
set state[#=18]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "It's a fate I can't escape anyway..."
file Xml/trigger/52020010_qd/main_b.xml kms:Xml/trigger/52020010_qd/main_b.xml 3012d45c0384a3b2
set state[#=5]/onEnter[#=1]/action[#=4][name=AddCinematicTalk] msg "Why isn't anything happening?"
set state[#=6]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Should I give it a whack?"
set state[#=7]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Ugh.... So noisy!"
set state[#=9]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Was it you?! Are you the one who woke me?!"
set state[#=10]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "How dare you disturb my time! You won't get \
    away with this!"
