file Xml/trigger/52020019_qd/main.xml kms:Xml/trigger/52020019_qd/main.xml c4e1562da8231032
set state[#=4]/onEnter[#=1]/action[#=1][name=ShowCaption] desc "$npcName:11003614$'s second trial ground."
set state[#=6]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Now, begin."
set state[#=8]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Oho.... You certainly know how to show some \
    spirit."
set state[#=9]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Then, before we begin...."
set state[#=10]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Allow me to formally introduce myself."
set state[#=11]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "My name is $npcName:11003598$."
set state[#=12]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Third Knight of Kritias. $npcName:11003598$ \
    of Dreams."
set state[#=12]/onEnter[#=1]/action[#=2][name=ShowCaption] desc "Knight of Dreams"
set state[#=15]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Now then, let's see what you're capable of."
set state[#=19]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Stop!"
set state[#=21]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "That's enough."
set state[#=22]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Oh dear, just when things were getting \
    interesting. What a shame."
set state[#=23]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Well, there's always next time, so I'll stop \
    here for now."
set state[#=25]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Let's go back, $npcName:11003598$."
set state[#=26]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Yes. As you command."
