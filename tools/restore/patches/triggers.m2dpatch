set state[#=4]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "What on earth happened?"
set state[#=6]/onEnter[#=1]/action[#=4][name=AddCinematicTalk] msg "Wait! This place is...?!"
file Xml/trigger/52020020_qd/main_b.xml kms:Xml/trigger/52020020_qd/main_b.xml 53988a8298733ebb
set state[#=3]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "The audience ceremony is about to begin?"
set state[#=4]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Then this place is $map:02000001$?"
set state[#=5]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "But the audience ceremony should have been \
    canceled..."
set state[#=8]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "Oh! You're awake?"
