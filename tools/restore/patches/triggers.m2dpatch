file Xml/trigger/52020022_qd/main.xml kms:Xml/trigger/52020022_qd/main.xml e9ef45de344f2e54
set state[#=8]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Is there really anything here?"
set state[#=9]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Isn't that rumor about something here just \
    false info?"
set state[#=10]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "No. There is a cutscene, but it's getting \
    expanded.\\nThey say it updates before the January deadline."
set state[#=11]/onEnter[#=1]/action[#=5][name=AddCinematicTalk] msg "So please wait a little longer..."
set state[#=20]/onEnter[#=1]/action[#=4][name=AddCinematicTalk] msg "A cutscene will be added."
set state[#=26]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Cutscene to be expanded in January"
set state[#=27]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Mostly dialogue to be expanded"
file Xml/trigger/52020024_qd/52020024_main.xml kms:Xml/trigger/52020024_qd/52020024_main.xml 78d8b136c6cdab3f
set state[#=3]/onEnter[#=1]/action[#=1] arg2 "Search the room."
set state[#=4]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "I need to find the fragment fusion device's \
    power"
set state[#=5]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Whoa... no way..."
set state[#=7]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "Doesn't look like it's here"
set state[#=11]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "Let's go to the center!"
set state[#=11]/onEnter[#=1]/action[#=3] arg2 "Fusion device power activated."
set state[#=15]/onEnter[#=1]/action[#=1] arg3 "Very good!"
set state[#=16]/onEnter[#=1]/action[#=2] arg3 "Fragments, blah blah~ yada yada~"
set state[#=17]/onEnter[#=1]/action[#=2] arg3 "Wh-what's happening?"
set state[#=18]/onEnter[#=1]/action[#=1] arg3 "Aaaargh!!!"
file Xml/trigger/52020025_qd/52020025_main.xml kms:Xml/trigger/52020025_qd/52020025_main.xml b2b89a3bd07673be
set state[#=2]/onEnter[#=1]/action[#=1] arg3 "Aaaaargh!!!"
set state[#=4]/onEnter[#=1]/action[#=4] arg3 "Huh??"
set state[#=5]/onEnter[#=1]/action[#=2] arg3 "Run!!"
set state[#=7]/onEnter[#=1]/action[#=5] arg2 "Run from the terrifying monster"
