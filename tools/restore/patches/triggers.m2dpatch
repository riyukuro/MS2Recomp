set state[#=4]/onEnter[#=1]/action[#=1] arg3 "Hahaha!! I'm back!"
set state[#=5]/onEnter[#=1]/action[#=1] arg3 "K-Katvan? How?!"
set state[#=6]/onEnter[#=1]/action[#=3] arg3 "Not bad! Then how about this?"
set state[#=8]/onEnter[#=1]/action[#=2] arg3 "J-Jordy?!"
set state[#=8]/onEnter[#=1]/action[#=3] arg3 "Jordy... you were alive?"
set state[#=8]/onEnter[#=1]/action[#=4] arg3 "Hehe... It's been a while. I missed you."
set state[#=8]/onEnter[#=1]/action[#=5] arg3 "But... why did you let me die?"
set state[#=8]/onEnter[#=1]/action[#=6] arg3 "Th-that's not how it was!!"
set state[#=8]/onEnter[#=1]/action[#=7] arg3 "I... curse you... I won't let you be!!"
set state[#=8]/onEnter[#=1]/action[#=8] arg3 "N-no, stop it!! Jordy!!"
set state[#=12]/onEnter[#=1]/action[#=4] arg3 "Jordy!! Please stop!!"
set state[#=14]/onEnter[#=1]/action[#=4] arg3 "I can't... take any more...."
set state[#=19]/onEnter[#=1]/action[#=1] arg3 "Hahahaha! Do you feel it? How far above you I stand!!"
set state[#=19]/onEnter[#=1]/action[#=2] arg3 "Huff... Please stop!!"
set state[#=19]/onEnter[#=1]/action[#=3] arg3 "On this stage of dreams, no one can defeat me!"
set state[#=19]/onEnter[#=1]/action[#=4] arg3 "Now then, shall we finish this?"
