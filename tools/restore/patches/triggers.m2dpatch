file Xml/trigger/52020017_qd/main.xml kms:Xml/trigger/52020017_qd/main.xml 2397d086bcafd6c5
set state[#=4]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Ahh.... At last I've found the lead for my \
    play."
set state[#=6]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Yes. You. You're the lead."
set state[#=7]/onEnter[#=1]/action[#=2][name=AddCinematicTalk] msg "Oh, I haven't told you the lead's role."
set state[#=8]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "The lead's role in this play is..."
set state[#=9]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "to die right here."
