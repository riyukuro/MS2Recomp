set state[#=3]/onEnter[#=1]/action[#=1] arg3 "What is this place?!"
set state[#=3]/onEnter[#=1]/action[#=2] arg3 "I can sense Michael's presence!\\nI have to hurry!!"
set state[#=5]/onEnter[#=1]/action[#=3] arg3 "Shall I take a look?"
