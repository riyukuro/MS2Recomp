file Xml/trigger/52020018_qd/main.xml kms:Xml/trigger/52020018_qd/main.xml b1a573c090617c82
set state[#=3]/onEnter[#=1]/action[#=1] arg2 "I didn't mean it......."
set state[#=4]/onEnter[#=1]/action[#=3][name=AddCinematicTalk] msg "Oho... Do you want to make excuses?"
set state[#=5]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "I'm disappointed, $MyPCName$."
set state[#=6]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "I trusted you and relied on you..."
set state[#=7]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "You abandoned me, so I'll curse you forever, \
    $MyPCName$."
set state[#=8]/onEnter[#=1]/action[#=1][name=AddCinematicTalk] msg "No... That's not true..."
set state[#=9]/onEnter[#=1]/action[#=1][name=AddBalloonTalk] msg "A curse! A curse!"
set state[#=9]/onEnter[#=1]/action[#=2][name=AddBalloonTalk] msg "We'll curse you forever!"
set state[#=9]/onEnter[#=1]/action[#=3][name=AddBalloonTalk] msg "Die."
set state[#=9]/onEnter[#=1]/action[#=4][name=AddBalloonTalk] msg "Stay here with us forever."
set state[#=9]/onEnter[#=1]/action[#=5][name=AddBalloonTalk] msg "This isn't real!!!"
set state[#=12]/onEnter[#=1]/action[#=4] arg2 "Defeat the marionettes and get out of here."
