//------------------------------------------------------------------------------------------------
// MS2: switch the display to uiWidth x uiHeight, 32 bpp (fullscreen device creation); false (mode unchanged) if
// ChangeDisplaySettingsA fails
// MS2: 0x1427d5c10, the game toggles it from a UIScene debug key
void NiDX9Renderer::SetMS2DeviceLost(bool bLost)
{
    m_bMS2Unknown_851 = bLost;
    m_bDeviceLost = bLost;
}

//------------------------------------------------------------------------------------------------
// MS2: the dtor's pre-pack cleanup as a separate member (0x1427d4ae0)
void NiDX9Renderer::PurgePrePackData()
{
    NiTListIterator kPrepackIter = m_kPrePackMeshes.GetHeadPos();
    while (kPrepackIter)
    {
        PrePackMesh* pkObject = m_kPrePackMeshes.GetNext(kPrepackIter);
        pkObject->m_spMesh = NULL;
    }
    m_kPrePackMeshes.RemoveAll();

    kPrepackIter = m_kPrePackTextures.GetHeadPos();
    while (kPrepackIter)
    {
        PrePackTexture* pkObject = m_kPrePackTextures.GetNext(kPrepackIter);
        pkObject->m_spTexture = NULL;
        pkObject->m_spSrcPixelData = NULL;
    }
    m_kPrePackTextures.RemoveAll();
}

//------------------------------------------------------------------------------------------------
bool NiDX9Renderer::ChangeDisplayMode(unsigned int uiWidth, unsigned int uiHeight)
{
    DWORD uiOldWidth = m_kMS2DisplayMode.dmPelsWidth;
    if (uiOldWidth == uiWidth && m_kMS2DisplayMode.dmPelsHeight == uiHeight)
        return true;

    DWORD uiOldHeight = m_kMS2DisplayMode.dmPelsHeight;
    m_kMS2DisplayMode.dmPelsWidth = uiWidth;
    m_kMS2DisplayMode.dmPelsHeight = uiHeight;
    m_bMS2DisplayModeChanged = true;
    m_kMS2DisplayMode.dmBitsPerPel = 32;
    m_kMS2DisplayMode.dmFields = DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT;
    if (ChangeDisplaySettingsA(&m_kMS2DisplayMode, CDS_UPDATEREGISTRY) != DISP_CHANGE_SUCCESSFUL)
    {
        m_kMS2DisplayMode.dmPelsWidth = uiOldWidth;
        m_kMS2DisplayMode.dmPelsHeight = uiOldHeight;
        return false;
    }
    return true;
}

//------------------------------------------------------------------------------------------------
// MS2: back to the desktop mode saved by Initialize
void NiDX9Renderer::RestoreDisplayMode()
{
    if (m_bMS2DisplayModeChanged)
    {
        if (m_kMS2DisplayMode.dmPelsWidth != m_kMS2DesktopMode.dmPelsWidth ||
            m_kMS2DisplayMode.dmPelsHeight != m_kMS2DesktopMode.dmPelsHeight)
        {
            ChangeDisplayMode(m_kMS2DesktopMode.dmPelsWidth, m_kMS2DesktopMode.dmPelsHeight);
        }
        m_bMS2DisplayModeChanged = false;
    }
.
