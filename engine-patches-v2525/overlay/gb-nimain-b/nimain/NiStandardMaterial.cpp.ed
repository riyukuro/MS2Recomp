//--------------------------------------------------------------------------------------------------
bool NiStandardMaterial::HandleCalculateHeightFog(Context& kContext,
    NiMaterialResource* pkWorldPos)
{
    NiMaterialNode* pkHeightFogNode = GetAttachableNodeFromLibrary(
        "CalculateHeightFog");
    kContext.m_spConfigurator->AddNode(pkHeightFogNode);

    NiMaterialResource* pkHeightFogOut =
        kContext.m_spOutputs->AddInputResource("float", "Color", "",
        "HeightFogOut");
    kContext.m_spConfigurator->AddBinding(
        pkHeightFogNode->GetOutputResourceByVariableName("HeightFogOut"),
        pkHeightFogOut);

    kContext.m_spConfigurator->AddBinding(pkWorldPos,
        pkHeightFogNode->GetInputResourceByVariableName("WorldPosition"));

    NiMaterialResource* pkUpperZ = AddOutputGlobal(kContext.m_spUniforms,
        "gfHeightFogUpperZ", NiShaderAttributeDesc::ATTRIB_TYPE_FLOAT);
    NiMaterialResource* pkLowerZ = AddOutputGlobal(kContext.m_spUniforms,
        "gfHeightFogLowerZ", NiShaderAttributeDesc::ATTRIB_TYPE_FLOAT);
    NiMaterialResource* pkPercent = AddOutputGlobal(kContext.m_spUniforms,
        "gfHeightFogPercent", NiShaderAttributeDesc::ATTRIB_TYPE_FLOAT);

    kContext.m_spConfigurator->AddBinding(pkUpperZ,
        pkHeightFogNode->GetInputResourceByVariableName("UpperZ"));
    kContext.m_spConfigurator->AddBinding(pkLowerZ,
        pkHeightFogNode->GetInputResourceByVariableName("LowerZ"));
    kContext.m_spConfigurator->AddBinding(pkPercent,
        pkHeightFogNode->GetInputResourceByVariableName("Weight"));
