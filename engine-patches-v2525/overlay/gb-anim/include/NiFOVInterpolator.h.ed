class NIANIMATION_ENTRY NiFOVInterpolator : public NiFloatInterpolator
{
    NiDeclareRTTI;
    NiDeclareClone(NiFOVInterpolator);
    NiDeclareStream;
    NiDeclareViewerStrings;

public:
