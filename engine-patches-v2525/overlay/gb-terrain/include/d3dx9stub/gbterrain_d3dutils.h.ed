// gb-terrain local prelude (never committed). SDK NiD3DUtils.h:31 uses x86 inline asm in
// FastFloatToInt, which x64 cl rejects; the studio's x64 replacement is unknown (layer
// request in docs/tu/gb-terrain.md). NiTerrain bodies do not call it.
#pragma once
#define NID3DUTILS_H
#include <windows.h>
static inline int FastFloatToInt(float fValue) { return (int)fValue; }
static inline DWORD F2DW(float fValue) { return *((DWORD*)&fValue); }

