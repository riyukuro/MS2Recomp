//--------------------------------------------------------------------------------------------------
// MS2: out-of-line SetAtGrow for m_kViewArray.Add (see the declaration above)
template <> inline
unsigned int NiTArray<NiBaseRendererOptionsView*,
    NiTMallocInterface<NiBaseRendererOptionsView*> >::SetAtGrow(
    unsigned int uiIndex, NiBaseRendererOptionsView* const& element)
{
    EE_ASSERT(uiIndex <= USHRT_MAX);
    unsigned short usIndex = (unsigned short)(uiIndex & 0xFFFF);

    if (usIndex >= m_usMaxSize)
    {
        SetSize(usIndex + m_usGrowBy);
    }

    SetAt(usIndex, element);
    return usIndex;
.
